# Tessera V1 issuer infrastructure (DESIGN.md "Shape"). Applied by a later, separate step; never by the builder.
terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.70"
    }
  }
}

provider "aws" {
  region = var.region
}
