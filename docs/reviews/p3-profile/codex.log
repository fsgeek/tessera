    86	        if 0<n<=21: return digits[:n]+'.'+digits[n:]
    87	        if -6<n<=0: return '0.'+'0'*(-n)+digits
    88	        return digits[0]+('.'+digits[1:] if k>1 else '')+'e'+('+' if n-1>=0 else '-')+str(abs(n-1))
    89	
    90	def parse_json(raw,canonical=False,no_numbers=False,max_depth=64, numbers=True):
    91	    try: text=raw.decode('utf-8',errors='strict')
    92	    except UnicodeError: raise Fault('JSON_ENCODING') from None
    93	    try:
    94	        obj=json.loads(text,object_pairs_hook=Pairs,parse_int=Literal,parse_float=Literal,
    95	                       parse_constant=lambda _: (_ for _ in ()).throw(Fault('JSON_SYNTAX')))
    96	    except (ValueError,RecursionError): raise Fault('JSON_SYNTAX') from None
    97	    def visit(v,depth=0):
    98	        if isinstance(v,(Pairs,list)):
    99	            demand(depth+1<=max_depth,'JSON_DEPTH')
   100	            for x in ( [v for _,v in v] if isinstance(v,Pairs) else v): visit(x,depth+1)
   101	    visit(obj)
   102	    def walk(v):
   103	        yield v
   104	        if isinstance(v,Pairs):
   105	            for key,val in v: yield key; yield from walk(val)
   106	        elif isinstance(v,list):
   107	            for val in v: yield from walk(val)
   108	    values=list(walk(obj))
   109	    for val in values:
   110	        if isinstance(val,Pairs): demand(len({k for k,_ in val})==len(val),'JSON_DUPLICATE_NAME')
   111	    for val in values:
   112	        if isinstance(val,str) and not isinstance(val,Literal):
   113	            demand(all(not (0xd800<=ord(c)<=0xdfff or 0xfdd0<=ord(c)<=0xfdef or ord(c)&0xffff in (0xfffe,0xffff))
   114	                       and unicodedata.category(c)!='Cn' for c in val) and unicodedata.normalize('NFC',val)==val,'JSON_STRING')
   115	    def convert(v):
   116	        if isinstance(v,Literal):
   117	            if not numbers: return v
   118	            demand(not no_numbers,'JSON_NUMBER')
   119	            # Decimal accepts huge exponents poorly; zero is handled without constructing it.
   120	            mantissa=re.split('[eE]',v)[0]
   121	            zero=all(c in '-.0' for c in mantissa)
   122	            demand(not (zero and v.startswith('-')),'JSON_NUMBER')
   123	            if zero: return Number(0.0)
   124	            try:
   125	                exact=decimal.Decimal(v); f=float(v)
   126	                demand(math.isfinite(f) and decimal.Decimal(es(f))==exact,'JSON_NUMBER')
   127	                return Number(f)
   128	            except (decimal.InvalidOperation,OverflowError,ValueError): raise Fault('JSON_NUMBER') from None
   129	        if isinstance(v,Pairs): return {k:convert(x) for k,x in v}
   130	        if isinstance(v,list): return [convert(x) for x in v]
   131	        return v
   132	    obj=convert(obj)
   133	    if canonical: demand(jcs(obj)==raw,'JSON_NONCANONICAL')
   134	    return obj
   135	
   136	def jcs(v):
   137	    def dump(v):
   138	        if isinstance(v,Literal):
   139	            try:
   140	                f=float(v); demand(math.isfinite(f),'JSON_NONCANONICAL'); return es(f)
   141	            except (ValueError,OverflowError): raise Fault('JSON_NONCANONICAL') from None
   142	        if isinstance(v,Number): return es(v.value)
   143	        if v is None: return 'null'
   144	        if v is True: return 'true'
   145	        if v is False: return 'false'
   146	        if isinstance(v,str): return json.dumps(v,ensure_ascii=False,separators=(',',':'))
   147	        if isinstance(v,list): return '['+','.join(dump(x) for x in v)+']'
   148	        if isinstance(v,dict): return '{'+','.join(dump(k)+':'+dump(v[k]) for k in sorted(v,key=lambda k:k.encode('utf-16be')))+'}'
   149	        raise TypeError('not a JSON value')
   150	    return dump(v).encode('utf-8')
   151	
   152	class Cursor:
   153	    def __init__(self,data,code='TRUNCATED'): self.data=data; self.pos=0; self.code=code
   154	    def take(self,n):
   155	        demand(n>=0 and n<=len(self.data)-self.pos,self.code)
   156	        out=self.data[self.pos:self.pos+n]; self.pos+=n; return out
   157	    def uint(self,n): return int.from_bytes(self.take(n),'big')
   158	    def end(self,code='TRAILING'): demand(self.pos==len(self.data),code)
   159	
   160	def tag(c,expected):
   161	    t=c.take(c.uint(1))
   162	    demand(t in {t.encode() for t in TAGS},'TAG_UNKNOWN')
   163	    demand(t==expected.encode(),'TAG_MISMATCH')
   164	
   165	def frame(t,payload): return bytes([len(t)])+t.encode()+b'\x00\x01'+len(payload).to_bytes(4,'big')+payload
   166	
   167	def schema(obj,expected): demand(isinstance(obj,dict) and set(obj)==set(expected),'SCHEMA')
   168	def schema_alg(a): demand(isinstance(a,str) and re.fullmatch(r'[A-Z0-9][A-Z0-9-]{0,63}',a),'SCHEMA')
   169	
   170	def read_frame(raw,expected):
   171	    c=Cursor(raw); tag(c,expected); demand(c.uint(2)==1,'CV_UNKNOWN'); n=c.uint(4)
   172	    demand(n<=2**24,'LENGTH_CAP'); payload=c.take(n); c.end()
   173	    obj=parse_json(payload,canonical=True)
   174	    if expected=='tessera-v1/manifest':
   175	        schema(obj,['alg','issuer','key_fp','sset','ver']); schema_alg(obj['alg'])
   176	        demand(domain(obj['issuer']) and fp(obj['key_fp'],'kms') and obj['ver']=='map-v1','SCHEMA')
   177	        demand(isinstance(obj['sset'],list) and len(obj['sset'])==1 and fp(obj['sset'][0],'gpg'),'SCHEMA')
   178	    else:
   179	        schema(obj,['common','signer']); schema(obj['signer'],['key_fp']); demand(fp(obj['signer']['key_fp']),'SCHEMA')
   180	        co=obj['common']; schema(co,['alg','binding_forms','content','declared_issue_time','issuer','manifest_sha256','preamble_sha256','profile','spec','vectors_sha256'])
   181	        schema_alg(co['alg']); schema(co['spec'],['id','sha256'])
   182	        demand(domain(co['issuer']) and co['profile']==PROFILE,'SCHEMA'); utc(co['declared_issue_time'])
   183	        demand(isinstance(co['spec']['id'],str) and re.fullmatch(r'[a-z0-9][a-z0-9._/-]{0,127}',co['spec']['id']),'SCHEMA')
   184	        for value in [co['manifest_sha256'],co['preamble_sha256'],co['vectors_sha256'],co['spec']['sha256']]: demand(isinstance(value,str) and HEX.fullmatch(value),'SCHEMA')
   185	        forms=co['binding_forms']; demand(isinstance(forms,list) and bool(forms) and all(isinstance(f,str) and re.fullmatch(r'[A-Z][A-Z0-9_]{0,31}',f) for f in forms),'SCHEMA')
   186	        demand(forms==sorted(set(forms)),'SCHEMA')
   187	    return obj
   188	
   189	def subpackets(raw):
   190	    c=Cursor(raw,'SIG_FORMAT'); out=[]
   191	    while c.pos<len(raw):
   192	        o=c.uint(1)
   193	        if o<192: n=o
   194	        elif o<255: n=((o-192)<<8)+c.uint(1)+192
   195	        else:
   196	            n=c.uint(4); demand(n>=16320,'SIG_FORMAT')
   197	        demand(n>=1,'SIG_FORMAT'); p=c.take(n); out.append((p[0]&127,bool(p[0]&128),p[1:]))
   198	    return out
   199	
   200	@dataclass
   201	class Signature:
   202	    hashed: list
   203	    unhashed: list
   204	    prefix: bytes
   205	    r: int
   206	    s: int
   207	    trailer: bytes
   208	
   209	def registered_codecs(catalog_alg):
   210	    """Profile §8: only the installed hybrid catalog registers its supplement."""
   211	    return BASELINE_CODECS | (frozenset((HYBRID_ALG,)) if catalog_alg==HYBRID_ALG else frozenset())
   212	
   213	def signature_rule(alg,slot,registry=BASELINE_CODECS):
   214	    if alg not in registry: return 'opaque',65536
   215	    if alg==HYBRID_ALG and slot=='kms': return 'R',3309
   216	    if alg in (ALG,HYBRID_ALG): return 'O',1024
   217	    return 'opaque',65536
   218	
   219	def parse_signature(raw,alg=ALG,slot='kms',registry=BASELINE_CODECS):
   220	    rule,cap=signature_rule(alg,slot,registry)
   221	    demand(len(raw)>0,'SIG_EMPTY'); demand(len(raw)<=cap,'LENGTH_CAP')
   222	    if rule=='opaque': return None
   223	    if rule=='R':
   224	        # HS §2: codec is length-only; sigDecode belongs to verification.
   225	        demand(len(raw)==3309,'SIG_FORMAT'); return raw
   226	    c=Cursor(raw); first=c.uint(1); demand(first in (0x88,0x89),'SIG_PACKET')
   227	    n=c.uint(1 if first==0x88 else 2); demand(first==0x88 or n>255,'SIG_PACKET')
   228	    body=c.take(n); c.end(); b=Cursor(body,'SIG_FORMAT'); demand(b.take(4)==b'\x04\x00\x13\x08','SIG_FORMAT')
   229	    hlen=b.uint(2); h=b.take(hlen); header=body[:6+hlen]
   230	    hashed=subpackets(h); unhashed=subpackets(b.take(b.uint(2))); prefix=b.take(2)
   231	    def mpi():
   232	        bits=b.uint(2); demand(1<=bits<=256,'SIG_FORMAT'); value=int.from_bytes(b.take((bits+7)//8),'big'); demand(value.bit_length()==bits,'SIG_FORMAT'); return value
   233	    r=mpi(); s=mpi(); b.end('SIG_FORMAT')
   234	    return Signature(hashed,unhashed,prefix,r,s,header+b'\x04\xff'+len(header).to_bytes(4,'big'))
   235	
   236	def sig_policy(sig):
   237	    # Rule R has no OpenPGP policy/trailer. FIPS gates run at verification,
   238	    # mapping to SIG_INVALID or POSSESSION_INVALID, never SIG_POLICY.
   239	    if isinstance(sig,bytes): return
   240	    demand(sig is not None,'SIG_POLICY')
   241	    creation=[d for t,_,d in sig.hashed if t==2]
   242	    demand(len(creation)==1 and len(creation[0])==4,'SIG_POLICY')
   243	    ids=[d for t,_,d in sig.hashed if t==16]; fps=[d for t,_,d in sig.hashed if t==33]
   244	    demand(len(ids)<=1 and all(len(d)==8 for d in ids),'SIG_POLICY')
   245	    demand(len(fps)<=1 and all(len(d)==21 and d[0]==4 for d in fps),'SIG_POLICY')
   246	    demand(not ids or not fps or ids[0]==fps[0][-8:],'SIG_POLICY')
   247	    for t,critical,_ in sig.hashed: demand(t!=3 and (t in (2,16,33) or not critical),'SIG_POLICY')
   248	    demand(1<=sig.r<N and 1<=sig.s<N,'SIG_POLICY')
   249	
   250	def point(raw):
   251	    demand(len(raw)==65 and raw[0]==4,'KEY_FORMAT')
   252	    x=int.from_bytes(raw[1:33],'big'); y=int.from_bytes(raw[33:],'big')
   253	    demand(x<P and y<P and (y*y-(x*x*x-3*x+B))%P==0,'KEY_FORMAT')
   254	    try: return ec.EllipticCurvePublicNumbers(x,y,ec.SECP256R1()).public_key()
   255	    except ValueError: raise Fault('KEY_FORMAT') from None
   256	
   257	def public_key(raw,slot,alg=ALG):
   258	    if slot=='kms':
   259	        if alg==HYBRID_ALG:
   260	            # HS §3 / RFC 9881 §§2,4: exact DER, absent parameters, zero
   261	            # unused bits. Every 1952-byte pkDecode input is well formed.
   262	            demand(len(raw)==1974 and raw[:22]==MLDSA65_SPKI,'KEY_FORMAT')
   263	            return mldsa.MLDSA65PublicKey.from_public_bytes(raw[22:])
   264	        demand(len(raw)==91 and raw[:26]==SPKI,'KEY_FORMAT'); return point(raw[26:])
   265	    demand(len(raw)==82 and raw[0]==4 and raw[5:17]==GPG_PREFIX,'KEY_FORMAT'); return point(raw[17:])
   266	
   267	def mldsa65_encoding_valid(sig):
   268	    """FIPS 204 Algorithms 21, 27, 8; verification gates, not rule-R codec."""
   269	    if len(sig)!=3309: return False
   270	    # HintBitUnpack: counts bounded and nondecreasing; strict order within
   271	    # each polynomial (including no duplicates); unused indices all zero.
   272	    hints=sig[3248:]; start=0
   273	    for end in hints[55:]:
   274	        if not start<=end<=55: return False
   275	        indices=hints[start:end]
   276	        if any(a>=b for a,b in zip(indices,indices[1:])): return False
   277	        start=end
   278	    if any(hints[start:55]): return False
   279	    # BitUnpack(z, gamma1-1, gamma1), 20 little-endian bits/coefficient.
   280	    # ML-DSA-65: gamma1=2^19, beta=196; strict infinity-norm bound.
   281	    bits=int.from_bytes(sig[48:3248],'little')
   282	    for _ in range(5*256):
   283	        coefficient=(1<<19)-(bits&((1<<20)-1))
   284	        if abs(coefficient)>=(1<<19)-196: return False
   285	        bits>>=20
   286	    return True
   287	
   288	def signature_verifies(document,sig,key):
   289	    if isinstance(sig,bytes):
   290	        if not mldsa65_encoding_valid(sig): return False
   291	        try:
   292	            # Algorithm 3 applies 00 00 itself: pass exact F, not mu or M'.
   293	            key.verify(sig,document,context=b''); return True
   294	        except (InvalidSignature,ValueError): return False
   295	    digest=sha(document+sig.trailer)
   296	    if digest[:2]!=sig.prefix: return False
   297	    try: key.verify(utils.encode_dss_signature(sig.r,sig.s),digest,ec.ECDSA(utils.Prehashed(hashes.SHA256()))); return True
   298	    except (InvalidSignature,ValueError): return False
   299	
   300	def read_anchor(raw,registry=BASELINE_CODECS):
   301	    c=Cursor(raw); tag(c,'tessera-v1/receipt-anchor-sig'); demand(c.uint(1)==2,'ANCHOR_COUNT'); out=[]
   302	    for slot in ('kms','gpg'):
   303	        n=c.uint(4); demand(n<=2**24+64,'LENGTH_CAP'); f=c.take(n); obj=read_frame(f,'tessera-v1/attest')
   304	        n=c.uint(4); demand(n>0,'SIG_EMPTY'); demand(n<=signature_rule(obj['common']['alg'],slot,registry)[1],'LENGTH_CAP')
   305	        s=c.take(n); parsed=parse_signature(s,obj['common']['alg'],slot,registry); out.append((f,obj,s,parsed))
   306	    c.end(); return out
     1	"""Build the issuer's Lambda package (infra variable lambda_zip): tessera_issue, tessera_verify, cryptography for
     2	Lambda's Linux, the frozen objects, the SHA-1DC detector and the Lambda's own install.json.
     3	
     4	    python package.py OUT.zip                       # bootstrap package: no install.json, so pre-ship refuses
     5	    python package.py OUT.zip --install-json FILE   # deployable package
     6	
     7	The install record is per-installation (profile 15.9 R2): deploy the bootstrap package, invoke the poller with
     8	{"tessera": "install-facts"}, save the answer as FILE, and build again with it. boto3 comes from the Lambda runtime,
     9	whose version is pinned in infra (runtime_management_config) so that the Unicode module digest cannot change under
    10	a deployed record. Needs uv (for the Linux wheel) and a built verifier (service/verifier/install.sh)."""
    11	import argparse
    12	import hashlib
    13	import json
    14	import shutil
    15	import subprocess
    16	import sys
    17	import tempfile
    18	import zipfile
    19	from pathlib import Path
    20	
    21	HERE = Path(__file__).resolve().parent
    22	VERIFIER = HERE.parent / "verifier"
    23	FROZEN = HERE.parent.parent / "formal" / "freeze-v1" / "objects"
    24	LAMBDA_BINARY = "/var/task/tessera-verify/bin/sha1dcsum"         # = lambda_app.SHA1DC_BINARY (a test checks)
    25	WHEEL = ["cryptography==50.0.2"]                                 # = pyproject; the only third-party dependency
    26	PLATFORM = "x86_64-manylinux_2_34"                               # Amazon Linux 2023 (glibc 2.34), x86_64 Lambda
    27	FIELDS = {"format", "python", "unicode_version", "unicode_module_sha256", "sha1dc_upstream_commit", "sha1dc_binary",
    28	          "sha1dc_binary_sha256"}
    29	
    30	
    31	def die(msg):
    32	    raise SystemExit("package: " + msg)
    33	
    34	
    35	def sha256(path):
    36	    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    37	
    38	
    39	def pinned_binary():
    40	    """The detector install.sh built and pinned, after re-checking the pin."""
    41	    rec = json.loads((VERIFIER / "install.json").read_text())
    42	    binary = Path(rec["sha1dc_binary"])
    43	    if not binary.is_file() or sha256(binary) != rec["sha1dc_binary_sha256"]:
    44	        die("SHA-1DC binary missing or not the pinned build; run service/verifier/install.sh")
    45	    return binary, rec
    46	
    47	
    48	def check_install_record(path):
    49	    """A Lambda install record: the install.json fields exactly, this package's binary path and digest, and the
    50	    verifier's pinned versions. The Unicode digest can only be checked by the verifier at startup, on Lambda."""
    51	    try:
    52	        rec = json.loads(Path(path).read_text())
    53	    except (OSError, ValueError) as e:
    54	        die(f"install record unreadable: {e}")
    55	    _, local = pinned_binary()
    56	    if not isinstance(rec, dict) or set(rec) != FIELDS or rec["format"] != "tessera-v1-install/1":
    57	        die("install record: wrong fields or format")
    58	    if rec["sha1dc_binary"] != LAMBDA_BINARY or rec["sha1dc_binary_sha256"] != local["sha1dc_binary_sha256"]:
    59	        die("install record: not this package's SHA-1DC binary")
    60	    for k in ("python", "unicode_version", "sha1dc_upstream_commit"):
    61	        if rec[k] != local[k]:
    62	            die(f"install record: {k} {rec[k]!r} differs from the verifier's {local[k]!r}")
    63	    return rec
    64	
    65	
    66	def write_zip(stage, out):
    67	    """Deterministic: sorted entries, fixed time, modes 644/755. -> SHA-256 of the zip."""
    68	    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    69	        for f in sorted(p for p in Path(stage).rglob("*") if p.is_file()):
    70	            info = zipfile.ZipInfo(f.relative_to(stage).as_posix(), (1980, 1, 1, 0, 0, 0))
    71	            info.external_attr = (0o100755 if f.stat().st_mode & 0o111 else 0o100644) << 16
    72	            info.compress_type = zipfile.ZIP_DEFLATED
    73	            z.writestr(info, f.read_bytes())
    74	    return sha256(out)
    75	
    76	
    77	def build(out, install_json=None):
    78	    binary, _ = pinned_binary()
    79	    rec = check_install_record(install_json) if install_json else None
    80	    ignore = shutil.ignore_patterns("__pycache__", "*.pyc", "*.egg-info")
    81	    with tempfile.TemporaryDirectory() as tmp:
    82	        stage = Path(tmp) / "stage"
    83	        subprocess.run(["uv", "pip", "install", "--quiet", "--target", str(stage), "--python-version", "3.14",
    84	                        "--python-platform", PLATFORM, "--only-binary", ":all:", *WHEEL], check=True)
    85	        shutil.copytree(HERE / "tessera_issue", stage / "tessera_issue", ignore=ignore)
    86	        shutil.copytree(VERIFIER / "tessera_verify", stage / "tessera_verify", ignore=ignore)
    87	        shutil.copytree(FROZEN, stage / "freeze-v1" / "objects", ignore=ignore)
    88	        dest = stage / LAMBDA_BINARY.removeprefix("/var/task/")
    89	        dest.parent.mkdir(parents=True)
    90	        shutil.copyfile(binary, dest)
    91	        dest.chmod(0o755)
    92	        if rec:
    93	            (dest.parent.parent / "install.json").write_text(json.dumps(rec, indent=1, sort_keys=True) + "\n")
    94	        digest = write_zip(stage, out)
    95	    return digest
    96	
    97	
    98	def main(argv=None):
    99	    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   100	    ap.add_argument("out")
   101	    ap.add_argument("--install-json")
   102	    a = ap.parse_args(argv)
   103	    digest = build(Path(a.out), a.install_json)
   104	    kind = "deployable" if a.install_json else "BOOTSTRAP (no install.json: pre-ship refuses until rebuilt)"
   105	    print(f"{a.out}: {kind}\nsha256 {digest}")
   106	
   107	
   108	if __name__ == "__main__":
   109	    sys.exit(main())
[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "tessera-verify"
version = "0.0.0"
description = "Tessera V1 service verifier (tessera-v1-strict)"
requires-python = "==3.14.*"
dependencies = ["cryptography==50.0.2"]

[project.scripts]
tessera-verify = "tessera_verify.cli:main"

[tool.setuptools]
packages = ["tessera_verify"]
{
 "field": "F1 exact library and version, and the exact calls",
 "requirements_pin": "cryptography==50.0.2",
 "cryptography": "50.0.2",
 "openssl": "OpenSSL 4.0.3 29 Sep 2026",
 "python": "3.14",
 "calls": {
  "mldsa65_key": "mldsa.MLDSA65PublicKey.from_public_bytes(raw[22:])",
  "mldsa65_verify": "key.verify(sig,document,context=b'')",
  "p256_key": "ec.EllipticCurvePublicNumbers(x,y,ec.SECP256R1()).public_key()",
  "p256_verify": "key.verify(utils.encode_dss_signature(sig.r,sig.s),digest,ec.ECDSA(utils.Prehashed(hashes.SHA256())))"
 },
 "source": "service/verifier/tessera_verify/codec.py",
 "note": "A change to any of these values or call strings makes test_p3_profile.py::TestF1Library fail; the profile must then be re-recorded and its vectors re-run."
}
     1	"""Minimal pure-Python P-256 affine arithmetic, used ONLY to construct test inputs (non-canonical encodings,
     2	invalid-curve points, and the ECDSA key-substitution key). Never used to decide acceptance."""
     3	P = 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff
     4	A = P - 3
     5	B = 0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b
     6	N = 0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551
     7	G = (0x6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296,
     8	     0x4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5)
     9	
    10	
    11	def on_curve(pt, b=B):
    12	    x, y = pt
    13	    return (y * y - (x * x * x + A * x + b)) % P == 0
    14	
    15	
    16	def add(p1, p2):
    17	    if p1 is None: return p2
    18	    if p2 is None: return p1
    19	    (x1, y1), (x2, y2) = p1, p2
    20	    if x1 == x2 and (y1 + y2) % P == 0: return None
    21	    if p1 == p2: lam = (3 * x1 * x1 + A) * pow(2 * y1, -1, P) % P
    22	    else: lam = (y2 - y1) * pow(x2 - x1, -1, P) % P
    23	    x3 = (lam * lam - x1 - x2) % P
    24	    return (x3, (lam * (x1 - x3) - y1) % P)
    25	
    26	
    27	def mul(k, pt):
    28	    out = None
    29	    while k:
    30	        if k & 1: out = add(out, pt)
    31	        pt = add(pt, pt); k >>= 1
    32	    return out
    33	
    34	
    35	def neg(pt): return (pt[0], (-pt[1]) % P)
    36	
    37	
    38	def sqrt(v):
    39	    """P = 3 mod 4: v^((P+1)/4) is a root iff v is a square."""
    40	    r = pow(v, (P + 1) // 4, P)
    41	    return r if r * r % P == v % P else None
    42	
    43	
    44	def lift_x(x, b=B):
    45	    y = sqrt((x * x * x + A * x + b) % P)
    46	    return None if y is None else (x, y)
    47	
    48	
    49	def dsks_keys(e, r, s):
    50	    """Keys Q with x(s^-1 (e G + r Q)) = r, computed from public (e, r, s) only:
    51	    Q = r^-1 (s R - e G) for each R with x(R) = r. Returns both candidates (one is the signer's key)."""
    52	    R = lift_x(r)
    53	    assert R is not None
    54	    rinv = pow(r, -1, N)
    55	    eg = neg(mul(e % N, G))
    56	    return [mul(rinv, add(mul(s, Rc), eg)) for Rc in (R, neg(R))]

