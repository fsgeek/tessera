def enc(raw): return base64.b64encode(raw).decode()
def varuint(n):
    out=b''
    while n>=128: out+=bytes([(n&127)|128]); n>>=7
    return out+bytes([n])
def varbytes(raw): return varuint(len(raw))+raw
def pointbytes(key):
