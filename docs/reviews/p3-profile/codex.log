    51	def run_sig(v, keys, docs):
    52	    """The verifier's per-slot pipeline for one signature: codec (rows 3.1/9.3), policy (9.1/9.4), key (5.1),
    53	    verification (9.2/9.5). Returns 'ACCEPT', the Fault code, or 'SIG_INVALID' (POSSESSION_INVALID for a
    54	    possession proof: same function, different row)."""
    55	    alg, slot = v['alg'], v['slot']
    56	    try:
    57	        parsed = parse_signature(bytes.fromhex(v['sig_hex']), alg, slot, registered_codecs(alg))
    58	        sig_policy(parsed)
    59	    except Fault as e:
    60	        return e.code
    61	    k = keys[v['key']]
    62	    key = public_key(bytes.fromhex(k['hex']), k['slot'], k['alg'])
    63	    return 'ACCEPT' if signature_verifies(bytes.fromhex(docs[v['document']]), parsed, key) else 'SIG_INVALID'
    64	
    65	
    66	def run_key(v):
    67	    try:
    68	        public_key(bytes.fromhex(v['key_hex']), v['slot'], v['alg'])
    69	        return 'ACCEPT'
    70	    except Fault as e:
    71	        return e.code
