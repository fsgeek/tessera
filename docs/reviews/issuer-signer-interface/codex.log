   755	def _capture_snapshot(iss, rec, a, now):
   756	    """Capture, validate and stamp the DNSSEC snapshot for attempt a. -> True when stored (proofs updated in rec,
   757	    not yet committed); False after committing a 'snapshot-rejected' event (recapture next tick)."""
   758	    body = iss.dns.capture(now)
   759	    problem = _validate_snapshot_now(iss, body, now)
   760	    if problem:
   761	        g = lifecycle_guard(rec)
   762	        _event(rec, now, "snapshot-rejected", a["id"], problem)
   763	        _commit(iss, rec, g)
   764	        return False
   765	    env = encode_snapshot_envelope(body)
   766	    raw = ots.stamp(sha256(env), iss.calendars, iss.nonce())
   767	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.body", body)
   768	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.ots", raw)
   769	    a["proofs"]["snapshot"] = {"stamped_at": now}
   770	    return True
