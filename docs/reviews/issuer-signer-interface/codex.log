   633	def st_frames(iss, rec, now):
   634	    w = iss.window
   635	    if not rec.get("cur"):                           # Start: attempt 1 (a lifecycle transition; the poller's only)
   636	        g = lifecycle_guard(rec)
   637	        if now > w.sign_until:
   638	            return _end_request(iss, rec, g, "REFUSED", "SIGNING_CLOSED", now)
   639	        if _content(iss, rec) is None:               # ILI-08: checked BEFORE any attempt exists
   640	            return _end_request(iss, rec, g, "FAILED", "CONTENT_UNAVAILABLE", now)
   641	        rec.update(attempts=[new_attempt(1, now)], cur=1)
   642	        _event(rec, now, "allocated", "a1")
   643	        _commit(iss, rec, g)
   644	    a = current(rec)
   645	    if now > w.sign_until:                           # this attempt would be signed after the stop
   646	        return _end_attempt(iss, rec, DISCARDED, "SIGNING_CLOSED", now)
   647	    content = _content(iss, rec)
   648	    if content is None:                              # ILI-08: lost after allocation: recover, or no attempt can be built
   649	        content = _recover_content(iss, rec)
   650	        if content is None:
   651	            return _end_attempt(iss, rec, DISCARDED, "CONTENT_UNAVAILABLE", now, no_successor="CONTENT_UNAVAILABLE")
