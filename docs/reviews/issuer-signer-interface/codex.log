   773	def _try_snapshot(iss, rec, a, now):
   774	    """Capture and stamp the attempt's DNSSEC snapshot if it has none. ILC-I2-05: a rejected or failed capture is
   775	    recorded and retried later; it never holds up the receipt's evidence. -> True when a snapshot is now held."""
   776	    if "snapshot" in a["proofs"]:
   777	        return True
   778	    g = lifecycle_guard(rec)
   779	    try:
   780	        if not _capture_snapshot(iss, rec, a, now):
   781	            return False
   782	    except (OutOfBudget, Superseded):
   783	        raise
   784	    except Exception as e:  # noqa: BLE001  a capture failure is retried; it is not a lifecycle event
   785	        iss.note("snapshot capture failed, retried:", rec["rid"][:12], type(e).__name__, e)
   786	        return False
   787	    a.pop("snapshot_failure", None)
   788	    _event(rec, now, "stamped", a["id"], "snapshot")
   789	    _commit(iss, rec, g)
   790	    return True
