   706	def _seal(iss, rec, a, now):
   707	    """Profile 4 steps 4-6: verify each signature on the exact bytes, freeze, build A_sig, check it (A9.5: the
   708	    signatures are frozen before the attempt is stamped)."""
   709	    rid, aid = rec["rid"], a["id"]
   710	    get = lambda n: iss.results.get("work", rid, f"{aid}/{n}")  # noqa: E731
   711	    sigs = {}
   712	    for job, j in a["jobs"].items():
   713	        s, f = get(sig_name(job, j["sig_sha256"])), get(j["frame"])
   714	        if (s is None or sha256hex(s) != j["sig_sha256"] or not iss.signers[j["slot"]].verify(f, s)
   715	                or not iss.requests.siglog_has(j["request_id"], j["sig_sha256"])):     # IS-01
   716	            g = lifecycle_guard(rec)
   717	            j["sig_sha256"] = None                     # lost or corrupt: ask again with the same id
   718	            j["sent_at"] = 0
   719	            return _commit(iss, rec, g)
   720	        sigs[job] = s
   721	    a_sig = encode_anchor(get("f_kms"), sigs["s_kms"], get("f_gpg"), sigs["s_gpg"])
   722	    try:
   723	        for (f, obj, s, _), slot in zip(read_anchor(a_sig, registered_codecs(ALG)), ("kms", "gpg")):
   724	            if not iss.signers[slot].verify(f, s) or obj["common"]["manifest_sha256"] != sha256hex(get("manifest")):
   725	                raise StageError("A_sig check")
   726	        read_frame(get("manifest"), "tessera-v1/manifest")
   727	    except Fault as e:
   728	        raise StageError("A_sig decode: " + e.code) from None
   729	    iss.results.put("work", rid, f"{aid}/a_sig", a_sig)
   730	    g = lifecycle_guard(rec)
   731	    a["receipt_id"] = sha256hex(a_sig)
   732	    rec["stage"] = "stamp"
   733	    _event(rec, now, "a_sig", aid, a["receipt_id"])
   734	    _commit(iss, rec, g)
