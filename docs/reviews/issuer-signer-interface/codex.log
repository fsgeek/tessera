   795	    if tip < iss.window.h_git + 5:                     # chain-order pre-commitment (profile 4, 6.3)
   796	        return
   797	    a = current(rec)
   798	    proofs = a["proofs"]
   799	    if "receipt" not in proofs:                        # A9.5: a fresh stamp of this attempt's own A_sig
   800	        raw = ots.stamp(sha256(iss.results.get("work", rec["rid"], f"{a['id']}/a_sig")), iss.calendars, iss.nonce())
   801	        iss.results.put("work", rec["rid"], f"{a['id']}/receipt.ots", raw)       # immutable once committed
   802	        g = lifecycle_guard(rec)
   803	        proofs["receipt"] = {"stamped_at": now, "tip": tip}
   804	        _event(rec, now, "stamped", a["id"], "receipt")
   805	        _commit(iss, rec, g)
   806	    _try_snapshot(iss, rec, a, now)                   # ILC-I2-05: evidence does not wait for it
   807	    g = lifecycle_guard(rec)
   808	    rec["stage"] = "evidence"
   809	    _commit(iss, rec, g)
