    30	class FakeSqs:
    31	    """At-least-once queues with visibility timeouts and receive counts, on the given clock."""
    32	
    33	    def __init__(self, clock):
    34	        self.clock, self.queues, self._ids = clock, {}, itertools.count(1)
    35	        self.fail_delete = False
    36	        self.fail_send = False
    37	
    38	    def _q(self, url):
    39	        return self.queues.setdefault(url, {})
    40	
    41	    def send_message(self, QueueUrl, MessageBody):
    42	        if self.fail_send:
    43	            raise ClientError("ServiceUnavailable")
    44	        if len(MessageBody.encode()) > SQS_MAX_BYTES:
    45	            raise ClientError("InvalidParameterValue")
    46	        mid = f"m{next(self._ids)}"
    47	        self._q(QueueUrl)[mid] = {"body": MessageBody, "visible_at": 0, "receives": 0, "handle": None}
    48	        return {"MessageId": mid}
    49	
    50	    def receive_message(self, QueueUrl, MaxNumberOfMessages=1, WaitTimeSeconds=0, VisibilityTimeout=30,
    51	                        MessageSystemAttributeNames=()):
    52	        now, out = self.clock(), []
    53	        for mid, m in self._q(QueueUrl).items():
    54	            if len(out) >= MaxNumberOfMessages:
    55	                break
    56	            if m["visible_at"] <= now:
    57	                m["visible_at"], m["receives"] = now + VisibilityTimeout, m["receives"] + 1
    58	                m["handle"] = f"{mid}:{next(self._ids)}"
    59	                msg = {"MessageId": mid, "ReceiptHandle": m["handle"], "Body": m["body"]}
    60	                if "ApproximateReceiveCount" in MessageSystemAttributeNames:
    61	                    msg["Attributes"] = {"ApproximateReceiveCount": str(m["receives"])}
    62	                out.append(msg)
    63	        return {"Messages": out} if out else {}
    64	
    65	    def delete_message(self, QueueUrl, ReceiptHandle):
    66	        if self.fail_delete:
    67	            raise ClientError("ServiceUnavailable")
    68	        mid = ReceiptHandle.split(":")[0]
    69	        m = self._q(QueueUrl).get(mid)
    70	        if m is not None and m["handle"] == ReceiptHandle:
    71	            del self._q(QueueUrl)[mid]
    72	
    73	    def bodies(self, url):
    74	        return [json.loads(m["body"]) for m in self._q(url).values()]
    75	
    76	    def take(self, url):
    77	        """All messages on a queue as JSON, removing them (what a consumer that deletes would see)."""
    78	        out = self.bodies(url)
    79	        self._q(url).clear()
    80	        return out
