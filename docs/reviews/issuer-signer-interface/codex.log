   677	def st_signing(iss, rec, now):
   678	    a = current(rec)
   679	    jobs = a["jobs"]
   680	    g = lifecycle_guard(rec)
   681	    if not all(j["sig_sha256"] for j in jobs.values()) and _reconcile(iss, rec, a):
   682	        _event(rec, now, "reconciled", a["id"])      # IS-08: verified and logged, but its record update was lost.
   683	        _commit(iss, rec, g)                         # ILI-04: recovered BEFORE deciding that signing is still needed
   684	    if all(j["sig_sha256"] for j in jobs.values()):
   685	        return _seal(iss, rec, a, now)               # a complete set is sealed whatever the signing window
   686	    if now > iss.window.sign_until:                  # still needs signing after the stop (never a stamped attempt)
   687	        return _end_attempt(iss, rec, DISCARDED, "SIGNING_CLOSED", now)
   688	    g = lifecycle_guard(rec)
   689	    resend = [(k, j) for k, j in jobs.items() if not j["sig_sha256"] and now - j["sent_at"] >= iss.signer_retry_s]
   690	    if not resend:
   691	        return
   692	    for k, j in resend:
   693	        j.update(sent_at=now, attempts=j["attempts"] + 1)
   694	        iss.requests.sigreq_put(j["request_id"], {"rid": rec["rid"], "attempt": a["id"], "job": k, "slot": j["slot"],
   695	                                                  "frame_sha256": j["frame_sha256"]}, now + RETENTION_S)
   696	    _event(rec, now, "resend", a["id"], [k for k, _ in resend])
   697	    _commit(iss, rec, g)
   698	    slots = set()
   699	    for k, j in resend:                               # E-02: the same request id; a late first answer still counts
   700	        _send(iss, rec, a, k)
   701	        slots.add(j["slot"])
   702	    for s in slots:
   703	        iss.signers[s].wake()
