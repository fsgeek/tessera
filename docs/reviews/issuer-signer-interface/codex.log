   418	        # oldest first across slots; equal sent times interleave the slots (each batch's own order, then slot), so a
   419	        # tie never favours one slot
   420	        received.sort(key=lambda r: (r[0][0], r[2], r[1]))
   421	        for k, (age, _, _, slot, signer, handle, body) in enumerate(received):
   422	            if k and over():
   423	                return n                       # the rest become visible again after the visibility timeout
   424	            try:
   425	                _take(iss, slot, signer, body, receives=age[2])
   426	                signer.ack(handle)
