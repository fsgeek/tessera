   617	def _recover_content(iss, rec):
   618	    """ILI-08: the submitted bytes are inside every built attestation frame (common.content). Recover them from an
   619	    earlier attempt's frame that decodes and hashes to the request's content digest, and store them again."""
   620	    for a in rec["attempts"][:-1]:
   621	        for name in ("f_kms", "f_gpg"):
   622	            frame = iss.results.get("work", rec["rid"], f"{a['id']}/{name}")
   623	            try:
   624	                data = b64d(read_frame(frame, "tessera-v1/attest")["common"]["content"]) if frame else None
   625	            except (Fault, KeyError, TypeError, ValueError):
   626	                data = None
   627	            if data is not None and sha256hex(data) == rec["content_sha256"]:
   628	                iss.results.put("content", rec["rid"], content_name(rec["content_sha256"]), data)
   629	                return data
   630	    return None
