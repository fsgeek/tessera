    31	class InMemoryQueue(Queue):
    32	    """At-least-once queue with a visibility timeout, like SQS: a received message is hidden until it is deleted or
    33	    its visibility timeout passes (measured on the given clock)."""
    34	
    35	    def __init__(self, clock, visibility_s=300, max_bytes=SQS_MAX_BYTES):
    36	        self.clock, self.visibility_s, self.max_bytes = clock, visibility_s, max_bytes
    37	        self.msgs = {}                       # id -> {"body", "visible_at", "handle"}
    38	        self._ids = itertools.count(1)
    39	
    40	    def send(self, body):
    41	        if len(body.encode()) > self.max_bytes:          # as SQS does (IS-09): the stand-in must not hide it
    42	            raise ValueError(f"message of {len(body.encode())} bytes exceeds {self.max_bytes}")
    43	        n = next(self._ids)
    44	        mid = f"m{n}"
    45	        self.msgs[mid] = {"body": body, "visible_at": 0, "handle": None, "sent": self.clock(), "seq": n,
    46	                          "receives": 0}
    47	        return mid
    48	
    49	    def receive(self, max_messages=10, wait_s=0):
    50	        now, out = self.clock(), []
    51	        for mid, m in self.msgs.items():
    52	            if len(out) >= max_messages:
    53	                break
    54	            if m["visible_at"] <= now:
    55	                m["visible_at"] = now + self.visibility_s
    56	                m["handle"] = f"{mid}:{next(self._ids)}"
    57	                m["receives"] += 1
