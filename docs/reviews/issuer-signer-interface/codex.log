   584	def _send(iss, rec, a, job):
   585	    j = a["jobs"][job]
   586	    frame = iss.results.get("work", rec["rid"], f"{a['id']}/{j['frame']}")
   587	
   588	    def stash(data):                                   # IS-09: immutable, digest-named, deleted with the request
   589	        # The name is exactly the frame's SHA-256: both signers refuse any other frames/<rid>/<name> (their RE_REF).
   590	        # Digest naming already separates attempts, whose frames differ; identical bytes share one object.
   591	        name = sha256hex(data)
   592	        iss.results.put("frames", rec["rid"], name, data)
   593	        return iss.results.ref("frames", rec["rid"], name)
   594	    # IS-03: every signer refuses after the window's signing stop. The former per-request bound (acceptance + 24 h)
   595	    # is withdrawn with the 24-hour rule; an attempt's own signing has no other deadline.
   596	    iss.signers[j["slot"]].send(j["request_id"], frame, sign_by=iss.window.sign_until, stash=stash)
