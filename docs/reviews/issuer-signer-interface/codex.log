   654	    manifest = encode_manifest(w.kms_fp, w.gpg_fp)
   655	    common = common_metadata(b64e(content), declared, manifest, iss.frozen.catalog)
   656	    frames = {"manifest": manifest, "f_kms": encode_attest(common, w.kms_fp), "f_gpg": encode_attest(common, w.gpg_fp)}
   657	    for name, data in frames.items():
   658	        iss.results.put("work", rec["rid"], f"{aid}/{name}", data)
   659	    jobs = {}
   660	    for job, slot, fname in JOBS:
   661	        srid = request_id(f"{rec['rid']}/{aid}", slot, frames[fname])
   662	        jobs[job] = {"slot": slot, "frame": fname, "frame_sha256": sha256hex(frames[fname]), "request_id": srid,
   663	                     "sent_at": now, "attempts": 1, "sig_sha256": None}
   664	        iss.requests.sigreq_put(srid, {"rid": rec["rid"], "attempt": aid, "job": job, "slot": slot,
   665	                                       "frame_sha256": jobs[job]["frame_sha256"]}, now + RETENTION_S)
