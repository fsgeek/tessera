   813	def conjunct_failed(sel, declared):
   814	    """The three-conjunct temporal predicate of A2.1/A2.2 on a selected presentation (the verifier's rows 12.1-12.3,
   815	    all three; rows 12.2 and 12.3 alone are not the predicate). -> the first failing conjunct's code, or None."""
   816	    if not declared - EPS <= sel.time:
   817	        return "TIME_BEFORE_DECLARED_EPSILON"
   818	    if not sel.time <= declared + DELTA:
   819	        return "TIME_AFTER_DECLARED_DELTA"
   820	    if not sel.confirmed <= declared + DELTA:
   821	        return "CONFIRMATION_LATE"
   822	    return None
