    93	    def receive(self, max_messages=10, wait_s=0):
    94	        from tessera_issue.queues import Message      # the issuer's message shape (ILC-I6 age key, ILC-I9 receives)
    95	        r = self.sqs.receive_message(QueueUrl=self.url, MaxNumberOfMessages=max_messages, VisibilityTimeout=60,
    96	                                     MessageSystemAttributeNames=("ApproximateReceiveCount",))
    97	        return [Message(m["MessageId"], m["Body"], m["ReceiptHandle"], None, 0,
    98	                        int(m["Attributes"]["ApproximateReceiveCount"]))
    99	                for m in r.get("Messages", [])]
