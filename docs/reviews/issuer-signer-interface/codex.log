   737	def _validate_snapshot_now(iss, body, now):
   738	    """Issuer pre-stamp check with the verifier's DNSSEC code: wildcard-free, every chain group valid now, and the
   739	    TXT value equal to the window's assertion."""
   740	    try:
   741	        snap = parse_snapshot(body)
   742	        if snap.wildcard:
   743	            return "DNS_WILDCARD"
   744	        config = check_config(iss.window.trust_base, {}, rfc3339(now))
   745	        bad = [a.reason or a.status for a in validate_snapshot(snap, config, now) if a.status != "pass"]
   746	        if bad:
   747	            return bad[0]
   748	        if snap.txt is None or txt_value([r.data for r in snap.txt.rr])["_raw"] != iss.window.assertion:
   749	            return "DNS_VALUE_DIFFERS"
   750	    except Fault as e:
   751	        return e.code
   752	    return None
