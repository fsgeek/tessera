   538	def _record_signature(iss, rid, aid, job, sig_sha256, srid, now, rec=None):
   539	    """IS-08: merge one verified signature into its attempt, re-reading on a guarded-write conflict. `rec`: the record
   540	    as already read by the caller (ILC-I8: saves a read; the guarded save still detects any change since)."""
