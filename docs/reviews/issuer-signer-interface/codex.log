   318	    if rec is not None and rec["state"] == "ACCEPTED":
   319	        return False                                   # not ended (an obligation written before a lost commit)
   320	    seen = iss.clock()                                 # read after the record: no earlier than the end's commit
   321	    expired = rec is None or seen >= rec["ended_at"] + RETENTION_S
   322	    namespaces = END_NS + ("result",) if (expired or rec["state"] != "COMPLETE") else END_NS
   323	    if doc.get("end_done") and not expired:
   324	        return False
   325	    if doc.get("fence_until") is None:                 # CF-02: start the writers' lease, durably
   326	        doc = dict(doc, rid=rid, fence_until=seen + WRITE_LEASE_S)
   327	        iss.requests.cleanup_put(rid, doc)
   328	    for ns in namespaces:
   329	        iss.results.mark_due(ns, rid)                  # due now: the lifecycle backstop may expire them from here on
   330	        iss.results.delete(ns, rid)
   331	    left = [ns for ns in namespaces if iss.results.names(ns, rid)]
   332	    if left:
   333	        raise StageError("objects left after deletion: " + ",".join(left))
   334	    if seen < doc["fence_until"]:
   335	        return False                                   # CF-02: a late writer may still store; delete again later
   336	    if expired or "result" in namespaces:
