    10	The API is read-only for the issuance lifecycle (docs/decisions/2026-10-29-issuance-lifecycle.md step 1): it never
    11	starts, latches, expires, discards, ends or allocates an attempt; the poller alone does (pipeline.py). Its only writes
    12	are the record's creation at submission and the upload bookkeeping before any attempt exists (IS-05). status and
    13	receipt write nothing."""
    14	import re
    15	from dataclasses import dataclass, field
    16	
    17	from .lifecycle import attempt_reasons, public_attempt
    18	from .service import RETENTION_S
    19	from .util import MIB, dumps, rfc3339, sha256hex
    20	
    21	UUID_RE = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\Z")
    22	RECEIPT_URL_TTL_S = 300               # the longest a minted receipt URL may live (IS-06)
    23	REFUSAL_STATUS = {"TOO_LARGE": 413, "BAD_REQUEST": 400, "OUTSIDE_WINDOW": 403, "CLOSING": 403,
    24	                  "SIGNING_UNAVAILABLE": 403}
    25	
    26	
    27	@dataclass
    28	class Response:
    29	    status: int
    30	    body: object                       # dict (JSON) or bytes (a receipt)
    31	    headers: dict = field(default_factory=dict)
    32	
    33	    def json(self):
    34	        return self.body if isinstance(self.body, dict) else None
    35	
    36	
    37	def cred_digest(credential):
    38	    return sha256hex(("tessera-v1-credential\n" + credential).encode())
    39	
    40	
    41	def record_id(credential, key):
    42	    return sha256hex(f"{cred_digest(credential)}\n{key}".encode())
    43	
    44	
    45	def content_name(digest):
    46	    return "content-" + digest
    47	
    48	
    49	def _expired(rec, now):
    50	    return rec["ended_at"] is not None and now >= rec["ended_at"] + RETENTION_S
    51	
    52	
    53	def view(rec, now):
    54	    """The public status. Design step 9: `fail_after` is withdrawn (there is no request deadline); an ACCEPTED request
    55	    shows its current attempt i of N and, while that attempt is open and unlatched, its boundary B with the note
    56	    that the twelve-day budget is nominal. A refusal lists each attempt's ending."""
    57	    if _expired(rec, now):
    58	        return {"request_key": rec["key"], "state": "EXPIRED"}
    59	    v = {"request_key": rec["key"], "state": rec["state"], "accepted_at": rfc3339(rec["created_at"])}
    60	    if rec["state"] == "ACCEPTED":
    61	        v["attempt"] = public_attempt(rec)
    62	    if rec["reason"]:
    63	        v["reason"] = rec["reason"]
    64	    if rec["state"] == "REFUSED" and rec.get("attempts"):
    65	        v["attempts"] = attempt_reasons(rec)
    66	    if rec["ended_at"] is not None:
    67	        v["ended_at"] = rfc3339(rec["ended_at"])
    68	        v["available_until"] = rfc3339(rec["ended_at"] + RETENTION_S)
    69	    if rec.get("receipt_sha256"):
    70	        v["receipt_sha256"] = rec["receipt_sha256"]
    71	    return v
    72	
    73	
    74	def _original_status(rec):
    75	    return REFUSAL_STATUS.get(rec["reason"], 403) if rec["state"] == "REFUSED" else 202
    76	
    77	
    78	def _new_record(rid, credential, key, digest, length, now):
    79	    return {"rid": rid, "cred": cred_digest(credential), "key": key, "state": None, "reason": None, "stage": None,
    80	            "content_sha256": digest, "content_len": length, "created_at": now, "ended_at": None,
    81	            "expires_at": None, "cur": 0, "attempts": [], "receipt_sha256": None, "events": []}
    82	
    83	
    84	def _existing(iss, rec, digest, body=None):
    85	    if iss.requests.tombstone_get(rec["rid"]) is None:              # IS-04: repair a missing tombstone
    86	        iss.requests.tombstone_put(rec["rid"], iss.tombstone_until)
    87	    if rec["content_sha256"] != digest:
    88	        return Response(409, {"error": "KEY_CONTENT_MISMATCH", "request_key": rec["key"]})
    89	    now = iss.clock()                                          # CF3-03: after the reads and the tombstone repair
    90	    if _expired(rec, now):
    91	        return Response(410, view(rec, now))
    92	    if rec["state"] == "ACCEPTED" and rec["stage"] == "upload" and body is not None:
    93	        rec = _finish_upload(iss, rec, body) or rec           # IS-05: a retry completes an interrupted upload
    94	        now = iss.clock()
    95	    return Response(_original_status(rec), view(rec, now))
