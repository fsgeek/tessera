   557	def _reconcile(iss, rec, a):
   558	    """IS-08: adopt a stored signature (its digest-named object exists only once it was verified on the job's frame,
   559	    ILC-I9) instead of asking the signer again. ILC-I8: a stored signature WITHOUT its log record (handling stopped
   560	    between the object and the log) is logged here, then adopted (IS-01 order: logged before used), so an interrupted
   561	    handling continues from durable state; the frame is not read again. (_seal verifies every signature on its exact
   562	    bytes before A_sig is built.) -> True if a job was satisfied."""
   563	    names, found, aid = iss.results.names("work", rec["rid"]), False, a["id"]
   564	    for job, j in a["jobs"].items():
   565	        if j["sig_sha256"]:
   566	            continue
   567	        for name in names:
   568	            if not name.startswith(f"{aid}/sig-{job}-"):
   569	                continue
   570	            sig = iss.results.get("work", rec["rid"], name)
   571	            h = sha256hex(sig) if sig is not None else None
   572	            if not (h and name == f"{aid}/" + sig_name(job, h)):
   573	                continue
   574	            if not iss.requests.siglog_has(j["request_id"], h):
   575	                iss.requests.siglog_add({"at": rfc3339(iss.clock()), "slot": j["slot"], "request_id": j["request_id"],
   576	                                         "status": "SIGNED", "reason": None, "frame_sha256": j["frame_sha256"],
   577	                                         "signature_sha256": h, "disposition": "used", "attempt": aid,
   578	                                         "recovered": True})
