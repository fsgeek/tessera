   542	        rec = rec if (k == 0 and rec is not None) else iss.requests.get(rid)
   543	        a = current(rec) if rec else None
   544	        if (rec is None or rec["state"] != "ACCEPTED" or a is None or a["id"] != aid or a["state"] != OPEN
   545	                or rec["stage"] != "signing" or job not in a["jobs"]):
   546	            return "not-waiting"
   547	        if a["jobs"][job]["sig_sha256"]:
   548	            return "duplicate"
   549	        g = lifecycle_guard(rec)
   550	        a["jobs"][job]["sig_sha256"] = sig_sha256
   551	        _event(rec, now, "signed", aid, job, srid)
   552	        if iss.requests.save(rec, g):
   553	            return "used"
   554	    return "save-conflict"                             # left in storage and the log; reconciled before any resend
