   105	class FakeS3:
   106	    def __init__(self):
   107	        self.objects, self.calls = {}, []
   108	        self.transient = 0                     # this many get_object calls raise a non-404 error first
   109	
   110	    def put(self, bucket, key, data):
   111	        self.objects[(bucket, key)] = bytes(data)
   112	
   113	    def get_object(self, Bucket, Key):
   114	        self.calls.append((Bucket, Key))
   115	        if self.transient:
   116	            self.transient -= 1
   117	            raise ClientError("SlowDown")
   118	        data = self.objects.get((Bucket, Key))
   119	        if data is None:
   120	            raise ClientError("NoSuchKey")
   121	        return {"Body": io.BytesIO(data), "ContentLength": len(data)}
