   428	            except OutOfBudget as e:
   429	                iss.note("drain out of time:", slot, e)
   430	                return n
   431	            except Exception as e:  # noqa: BLE001  not acknowledged: the queue delivers it again
   432	                iss.note("response", slot, "not taken:", type(e).__name__, e)
