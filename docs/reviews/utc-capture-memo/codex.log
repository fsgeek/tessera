print('uint32 max + 7200:',datetime.fromtimestamp(2**32-1+7200,timezone.utc).isoformat())
# Interpret the three rows as ordered branches; test every append across a finite domain.
windows=[(a,b) for a in range(5) for b in range(a,5)]
def overlaps(x,y):return max(x[0],y[0])<=min(x[1],y[1])
entries=[(w,k) for w in windows for k in ('honest','other')]
def verdict(e,listed,a):
 if e in listed:return 'PASS'
 if any(overlaps(e[0],l[0]) for l in listed) or e[0][0]<=a:return 'INVALID'
 return 'UNVERIFIABLE'
count=0
