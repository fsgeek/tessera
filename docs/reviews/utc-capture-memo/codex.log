from itertools import product
# Exhaustive finite arithmetic check: ordered mining times, arbitrary header times.
checked=0
for r in product(range(4), repeat=6):
 if any(a>b for a,b in zip(r,r[1:])):continue
 for t in product(range(4),repeat=6):
  if any(t[i]>=r[i]-1 for i in range(6)):
   assert r[0]<=max(t)+1
   checked+=1
print('U inequality checks:',checked,'; violations: 0 (finite arithmetic only, not Bitcoin conformance)')
