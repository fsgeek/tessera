def bounded(s3, limit):
    """Each poll is one Lambda invocation: past `limit` DeleteObjects calls it is killed."""
    real, calls = s3.delete_objects, [0]

    def call(**kw):
        calls[0] += 1
        if calls[0] > limit:
            raise LambdaTimeout()
        return real(**kw)
    s3.delete_objects = call
    return calls


