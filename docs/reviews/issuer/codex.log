    24	class InMemoryQueue(Queue):
    25	    """At-least-once queue with a visibility timeout, like SQS: a received message is hidden until it is deleted or
    26	    its visibility timeout passes (measured on the given clock)."""
    27	
    28	    def __init__(self, clock, visibility_s=300):
    29	        self.clock, self.visibility_s = clock, visibility_s
    30	        self.msgs = {}                       # id -> {"body", "visible_at", "handle"}
    31	        self._ids = itertools.count(1)
    32	
    33	    def send(self, body):
    34	        mid = f"m{next(self._ids)}"
    35	        self.msgs[mid] = {"body": body, "visible_at": 0, "handle": None}
    36	        return mid
    37	
    38	    def receive(self, max_messages=10, wait_s=0):
    39	        now, out = self.clock(), []
    40	        for mid, m in self.msgs.items():
    41	            if len(out) >= max_messages:
    42	                break
    43	            if m["visible_at"] <= now:
    44	                m["visible_at"] = now + self.visibility_s
    45	                m["handle"] = f"{mid}:{next(self._ids)}"
    46	                out.append(Message(mid, m["body"], m["handle"]))
    47	        return out
    48	
    49	    def delete(self, handle):
    50	        mid = handle.split(":")[0]
    51	        m = self.msgs.get(mid)
    52	        if m is not None and m["handle"] == handle:
    53	            del self.msgs[mid]
    54	
    55	    def __len__(self):
    56	        return len(self.msgs)
    57	
