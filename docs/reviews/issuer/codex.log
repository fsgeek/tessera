    46	            raise ValueError(slot)
    47	        public_key(key_bytes, slot, ALG)                 # KEY_FORMAT gate
    48	        self.slot, self.key_bytes = slot, key_bytes
    49	        self.fp = fp_kms(key_bytes) if slot == "kms" else fp_gpg(key_bytes)
    50	        self.requests, self.responses, self._wake = requests, responses, wake
    51	
    52	    def send(self, rid, frame):
    53	        self.requests.send(json.dumps({"request_id": rid, "frame_b64": b64e(frame)}, sort_keys=True))
    54	
    55	    def wake(self):
    56	        if self._wake is not None:
    57	            self._wake(self.slot)
    58	
    59	    def receive(self, max_messages=10):
    60	        out = []
    61	        for m in self.responses.receive(max_messages):
    62	            try:
    63	                body = json.loads(m.body)
    64	                if not isinstance(body, dict):
    65	                    raise ValueError
    66	            except ValueError:
    67	                body = {"_unparseable": m.body[:200]}
    68	            out.append((m.handle, body))
    69	        return out
