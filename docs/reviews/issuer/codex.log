    41	# ------------------------------------------------------------------------------------------------ the poller
    42	def poll(iss):
    43	    """One scheduled tick. -> summary dict."""
    44	    out = {"drained": drain(iss), "advanced": {}}
    45	    for rec in iss.requests.active():
    46	        before = rec["stage"]
    47	        try:
    48	            advance(iss, rec)
    49	        except PreShipUnavailable as e:
    50	            iss.note("pre-ship unavailable, request kept:", rec["rid"][:12], e)
    51	        except Exception as e:  # noqa: BLE001  one request's fault never stops the others; retried next tick
    52	            iss.note("stage", before, "error, request kept:", rec["rid"][:12], type(e).__name__, e)
    53	        out["advanced"][rec["rid"]] = (before, rec["stage"] or rec["state"])
    54	    return out
    55	
    56	
    57	def _save(iss, rec):
    58	    if not iss.requests.save(rec):
    59	        raise StageError("record changed concurrently; retried next tick")
    60	
    61	
    62	def _event(rec, now, *what):
    63	    rec["events"] = (rec.get("events") or [])[-40:] + [[now, *what]]
    64	
    65	
    66	def _end(iss, rec, state, reason, now):
    67	    rec.update(state=state, reason=reason, stage=None, ended_at=now, expires_at=now + RETENTION_S)
    68	    _event(rec, now, state, reason)
    69	    _save(iss, rec)
    70	    iss.results.delete("content", rec["rid"])           # the receipt carries the content; nothing else keeps it
    71	    iss.results.delete("work", rec["rid"])
    72	
    73	
    74	def advance(iss, rec):
    75	    now = iss.clock()
    76	    if now >= rec["created_at"] + DEADLINE_S:
    77	        return _end(iss, rec, "FAILED", "NOT_COMPLETE_WITHIN_24H", now)
    78	    try:
    79	        STAGES[rec["stage"]](iss, rec, now)
    80	    except StageError as e:
    81	        iss.note("stage", rec["stage"], "deferred:", e)
    82	
    83	
    84	# ------------------------------------------------------------------------------------------------ E-02 drain
    85	def drain(iss, max_batches=50):
    86	    """Read every slot's response queue. Every response is logged (request id, slot, status, frame hash when the
    87	    id is known, signature hash) whether or not it is used, and then deleted from the queue."""
    88	    n = 0
    89	    for slot, signer in iss.signers.items():
    90	        for _ in range(max_batches):
    91	            batch = signer.receive(10)
    92	            if not batch:
    93	                break
    94	            for handle, body in batch:
    95	                _take(iss, slot, signer, body)
    96	                signer.ack(handle)
    97	                n += 1
    98	    return n
    99	
   100	
   101	def _take(iss, slot, signer, body):
   102	    now = iss.clock()
   103	    srid = body.get("request_id")
   104	    idx = iss.requests.sigreq_get(srid) if isinstance(srid, str) else None
   105	    sig = None
   106	    if body.get("status") == "SIGNED":
   107	        try:
   108	            sig = b64d(body.get("sig_b64", ""))
   109	        except (ValueError, TypeError):
   110	            sig = None
   111	    entry = {"at": rfc3339(now), "slot": slot, "request_id": srid, "status": body.get("status"),
   112	             "reason": body.get("reason"), "frame_sha256": idx["frame_sha256"] if idx else None,
   113	             "signature_sha256": sha256hex(sig) if sig is not None else None, "disposition": None}
   114	    if idx is None or idx.get("slot") != slot:
   115	        entry["disposition"] = "unrequested"
   116	    else:
   117	        rec = iss.requests.get(idx["rid"])
   118	        job = rec["jobs"].get(idx["job"]) if rec else None
   119	        if rec is None or rec["state"] != "ACCEPTED" or rec["stage"] != "signing" or job is None:
   120	            entry["disposition"] = "not-waiting"
   121	        elif job.get("sig_sha256"):
   122	            entry["disposition"] = "duplicate"
   123	        elif body.get("status") == "REFUSED":
   124	            entry["disposition"] = "refused"
   125	            iss.requests.siglog_add(entry)
   126	            return _end(iss, rec, "FAILED", "SIGNER_REFUSED:" + str(body.get("reason")), now)
   127	        elif sig is None:
   128	            entry["disposition"] = "malformed"
   129	        else:
   130	            frame = iss.results.get("work", rec["rid"], job["frame"])
   131	            if frame is None or sha256hex(frame) != job["frame_sha256"] or not signer.verify(frame, sig):
   132	                entry["disposition"] = "bad-signature"
   133	            else:
   134	                iss.results.put("work", rec["rid"], "sig-" + idx["job"], sig)
   135	                job["sig_sha256"] = sha256hex(sig)
   136	                _event(rec, now, "signed", idx["job"], srid)
   137	                if iss.requests.save(rec):
   138	                    entry["disposition"] = "used"
   139	                else:
   140	                    entry["disposition"] = "save-conflict"
   141	    iss.requests.siglog_add(entry)
   142	
