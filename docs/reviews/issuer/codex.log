    50	def build(objects_dir, start="2026-11-02T00:00:00Z", window_days=30, wire=False, seed="stand-in"):
    51	    """wire=True puts the real protocol clients (HttpCalendar, ExplorerHeaders over two explorers, LiveDns) in
    52	    front of the stand-ins, so the issuer reaches them only through the calendar, explorer and resolver protocols."""
    53	    clock = FakeClock(ts(start))
    54	    world = World(clock, seed)
