    59	class SqsQueue(Queue):
    60	    """SQS through an injected boto3-style client (`boto3.client("sqs")`)."""
    61	
    62	    def __init__(self, client, url):
    63	        self.client, self.url = client, url
    64	
    65	    def send(self, body):
    66	        return self.client.send_message(QueueUrl=self.url, MessageBody=body)["MessageId"]
    67	
    68	    def receive(self, max_messages=10, wait_s=0):
    69	        r = self.client.receive_message(QueueUrl=self.url, MaxNumberOfMessages=max(1, min(10, max_messages)),
    70	                                        WaitTimeSeconds=wait_s)
    71	        return [Message(m["MessageId"], m["Body"], m["ReceiptHandle"]) for m in r.get("Messages", [])]
    72	
    73	    def delete(self, handle):
    74	        self.client.delete_message(QueueUrl=self.url, ReceiptHandle=handle)
     1	"""Lambda entry points: api_handler (API Gateway REST proxy; the API key id is the client credential) and
     2	poller_handler (EventBridge schedule, every 10 minutes; reserved concurrency 1). from_env() builds the issuer from
     3	environment variables set by infra/; boto3 is imported only here.
     4	
     5	Environment: REQUEST_TABLE, RESULT_BUCKET, FREEZE_DIR (packaged frozen objects), WINDOW_OBJECT (default
     6	config/window.json in RESULT_BUCKET), KMS_REQUEST_QUEUE_URL, KMS_RESPONSE_QUEUE_URL, GPG_REQUEST_QUEUE_URL,
     7	GPG_RESPONSE_QUEUE_URL, KMS_WAKE_TOPIC_ARN, GPG_WAKE_TOPIC_ARN (optional), OTS_CALENDARS, EXPLORERS (comma lists),
     8	DNS_RESOLVER, CLOSING, SIGNING_AVAILABLE ("true"/"false"), TESSERA_VERIFY_INSTALL_JSON (the packaged verifier's
     9	install record, for the pre-ship checks)."""
    10	import base64
    11	import json
    12	import os
    13	
    14	from . import api, freeze, pipeline, window as window_mod
    15	from .aws import DynamoRequestStore, S3ResultStore, SnsWake
    16	from .chain import ExplorerHeaders
    17	from .dns import LiveDns, udp_tcp_transport
    18	from .ots import HttpCalendar, urllib_transport
    19	from .preship import PreShip
    20	from .queues import SqsQueue
    21	from .service import Issuer
    22	from .signers import SlotSigner
    23	
    24	_ISSUER = None
    25	
    26	
    27	def from_env(env=None, session=None):
    28	    env = os.environ if env is None else env
    29	    if session is None:
    30	        import boto3
    31	        session = boto3.session.Session()
    32	    ddb, s3, sqs, sns = (session.client(n) for n in ("dynamodb", "s3", "sqs", "sns"))
    33	    results = S3ResultStore(s3, env["RESULT_BUCKET"])
    34	    win = window_mod.load_json(results.get_config(env.get("WINDOW_OBJECT", "window.json")).decode())
    35	    frozen = freeze.load(env["FREEZE_DIR"])
    36	    wake = SnsWake(sns, {"kms": env.get("KMS_WAKE_TOPIC_ARN"), "gpg": env.get("GPG_WAKE_TOPIC_ARN")})
    37	    signers = {"kms": SlotSigner("kms", win.kms_key, SqsQueue(sqs, env["KMS_REQUEST_QUEUE_URL"]),
    38	                                 SqsQueue(sqs, env["KMS_RESPONSE_QUEUE_URL"]), wake),
    39	               "gpg": SlotSigner("gpg", win.gpg_key, SqsQueue(sqs, env["GPG_REQUEST_QUEUE_URL"]),
    40	                                 SqsQueue(sqs, env["GPG_RESPONSE_QUEUE_URL"]), wake)}
    41	    http = urllib_transport()
    42	    return Issuer(window=win, frozen=frozen, requests=DynamoRequestStore(ddb, env["REQUEST_TABLE"]), results=results,
    43	                  signers=signers,
    44	                  calendars=[HttpCalendar(u, http) for u in env["OTS_CALENDARS"].split(",") if u],
    45	                  headers=ExplorerHeaders([u for u in env["EXPLORERS"].split(",") if u], http),
    46	                  dns=LiveDns(udp_tcp_transport(env.get("DNS_RESOLVER", "1.1.1.1"))),
    47	                  preship=PreShip(frozen, win.trust_base, env.get("TESSERA_VERIFY_INSTALL_JSON")),
    48	                  closing=env.get("CLOSING", "false") == "true",
    49	                  signing_available=env.get("SIGNING_AVAILABLE", "true") == "true")
    50	
    51	
    52	def _issuer():
    53	    global _ISSUER
    54	    if _ISSUER is None:
    55	        _ISSUER = from_env()
    56	    return _ISSUER
    57	
    58	
    59	def handle_api_event(iss, event):
    60	    """API Gateway REST proxy event -> proxy response. Plain function; api_handler binds the issuer."""
    61	    method = event.get("httpMethod")
    62	    resource = event.get("resource") or ""
    63	    headers = {k.lower(): v for k, v in (event.get("headers") or {}).items()}
    64	    cred = ((event.get("requestContext") or {}).get("identity") or {}).get("apiKeyId")
    65	    key = (event.get("pathParameters") or {}).get("key")
    66	    if method == "POST" and resource == "/v1/requests":
    67	        raw = event.get("body") or ""
    68	        try:
    69	            body = base64.b64decode(raw, validate=True) if event.get("isBase64Encoded") else raw.encode("utf-8")
    70	        except ValueError:
    71	            body = None
    72	        if body is None:
    73	            resp = api.Response(400, {"state": "REFUSED", "reason": "BAD_REQUEST"})
    74	        else:
    75	            resp = api.submit(iss, cred, headers.get("tessera-request-key"), body)
    76	    elif method == "GET" and resource == "/v1/requests/{key}":
    77	        resp = api.status(iss, cred, key)
    78	    elif method == "GET" and resource == "/v1/requests/{key}/receipt":
    79	        resp = api.receipt(iss, cred, key)
    80	    else:
    81	        resp = api.Response(404, {"error": "NOT_FOUND"})
    82	    status, hdrs, data = api.encode(resp)
    83	    return {"statusCode": status, "headers": hdrs, "body": data.decode("utf-8"), "isBase64Encoded": False}
    84	
    85	
    86	def api_handler(event, context):
    87	    return handle_api_event(_issuer(), event)
    88	
    89	
    90	def poller_handler(event, context):
    91	    out = pipeline.poll(_issuer())
    92	    return json.loads(json.dumps(out, default=str))

