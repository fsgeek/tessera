    33	    results = S3ResultStore(s3, env["RESULT_BUCKET"])
    34	    win = window_mod.load_json(results.get_config(env.get("WINDOW_OBJECT", "window.json")).decode())
    35	    frozen = freeze.load(env["FREEZE_DIR"])
