    41	    def run_until_done(self, rid, max_ticks=200, **kw):
    42	        for _ in range(max_ticks):
    43	            rec = self.iss.requests.get(rid)
    44	            if rec["state"] != "ACCEPTED":
    45	                return rec
    46	            self.tick(**kw)
    47	        return self.iss.requests.get(rid)
