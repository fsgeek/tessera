    30	    def tick(self, run_signers=True, mine=True, step=600):
    31	        """One poller period: signers answer what is queued, the poller runs, ten minutes pass, a block is mined."""
    32	        if run_signers:
    33	            for w in self.workers.values():
    34	                w.process()
