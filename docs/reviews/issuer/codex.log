     2	import itertools
     3	from dataclasses import dataclass
     4	
     5	
     6	@dataclass
     7	class Message:
     8	    id: str
     9	    body: str
    10	    handle: str
    11	
    12	
    13	class Queue:
    14	    def send(self, body):
    15	        raise NotImplementedError
    16	
    17	    def receive(self, max_messages=10, wait_s=0):
    18	        raise NotImplementedError
