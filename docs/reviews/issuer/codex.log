   144	# ------------------------------------------------------------------------------------------------ stages
   145	def st_frames(iss, rec, now):
   146	    w = iss.window
   147	    if now > w.sign_until:
   148	        return _end(iss, rec, "FAILED", "SIGNING_STOPPED", now)
   149	    content = iss.results.get("content", rec["rid"], content_name(rec["content_sha256"]))
   150	    if content is None or sha256hex(content) != rec["content_sha256"]:
   151	        return _end(iss, rec, "FAILED", "CONTENT_UNAVAILABLE", now)
   152	    declared = rfc3339(now)
   153	    manifest = encode_manifest(w.kms_fp, w.gpg_fp)
   154	    common = common_metadata(b64e(content), declared, manifest, iss.frozen.catalog)
   155	    frames = {"manifest": manifest, "f_kms": encode_attest(common, w.kms_fp), "f_gpg": encode_attest(common, w.gpg_fp)}
   156	    for name, data in frames.items():
   157	        iss.results.put("work", rec["rid"], name, data)
   158	    jobs = {}
   159	    for job, slot, fname in JOBS:
   160	        srid = request_id(rec["rid"], slot, frames[fname])
   161	        jobs[job] = {"slot": slot, "frame": fname, "frame_sha256": sha256hex(frames[fname]), "request_id": srid,
   162	                     "sent_at": now, "attempts": 1, "sig_sha256": None}
   163	        iss.requests.sigreq_put(srid, {"rid": rec["rid"], "job": job, "slot": slot,
   164	                                       "frame_sha256": jobs[job]["frame_sha256"]}, now + RETENTION_S)
   165	    rec.update(stage="signing", jobs=jobs, declared_issue_time=declared)
   166	    _event(rec, now, "frames", declared)
   167	    _save(iss, rec)                                  # durable before anything is sent
   168	    for job, slot, fname in JOBS:
   169	        iss.signers[slot].send(jobs[job]["request_id"], frames[fname])
   170	    for slot in iss.signers:
   171	        iss.signers[slot].wake()                     # E-01: started on demand, once per batch
   172	
   173	
   174	def st_signing(iss, rec, now):
   175	    jobs = rec["jobs"]
   176	    if all(j["sig_sha256"] for j in jobs.values()):
   177	        return _seal(iss, rec, now)
   178	    if now > iss.window.sign_until:
   179	        return _end(iss, rec, "FAILED", "SIGNING_STOPPED", now)
   180	    resend = [(k, j) for k, j in jobs.items() if not j["sig_sha256"] and now - j["sent_at"] >= iss.signer_retry_s]
   181	    if not resend:
   182	        return
   183	    for k, j in resend:
   184	        j.update(sent_at=now, attempts=j["attempts"] + 1)
   185	    _event(rec, now, "resend", [k for k, _ in resend])
   186	    _save(iss, rec)
   187	    slots = set()
   188	    for k, j in resend:                               # E-02: the same request id; a late first answer still counts
   189	        iss.signers[j["slot"]].send(j["request_id"], iss.results.get("work", rec["rid"], j["frame"]))
   190	        slots.add(j["slot"])
   191	    for s in slots:
   192	        iss.signers[s].wake()
   193	
   194	
   195	def _seal(iss, rec, now):
   196	    """Profile 4 steps 4-6: verify each signature on the exact bytes, freeze, build A_sig, check it."""
   197	    rid, get = rec["rid"], (lambda n: iss.results.get("work", rec["rid"], n))
   198	    sigs = {}
   199	    for job, j in rec["jobs"].items():
   200	        s, f = get("sig-" + job), get(j["frame"])
   201	        if s is None or sha256hex(s) != j["sig_sha256"] or not iss.signers[j["slot"]].verify(f, s):
   202	            j["sig_sha256"] = None                     # lost or corrupt: ask again with the same id
   203	            j["sent_at"] = 0
   204	            _save(iss, rec)
   205	            return
   206	        sigs[job] = s
   207	    a_sig = encode_anchor(get("f_kms"), sigs["s_kms"], get("f_gpg"), sigs["s_gpg"])
   208	    try:
   209	        for (f, obj, s, _), slot in zip(read_anchor(a_sig, registered_codecs(ALG)), ("kms", "gpg")):
   210	            if not iss.signers[slot].verify(f, s) or obj["common"]["manifest_sha256"] != sha256hex(get("manifest")):
   211	                raise StageError("A_sig check")
   212	        read_frame(get("manifest"), "tessera-v1/manifest")
   213	    except Fault as e:
   214	        raise StageError("A_sig decode: " + e.code) from None
   215	    iss.results.put("work", rid, "a_sig", a_sig)
   216	    rec.update(stage="stamp", receipt_id=sha256hex(a_sig))
   217	    _event(rec, now, "a_sig", rec["receipt_id"])
   218	    _save(iss, rec)
   219	
