    78	class StandInSigner:
    79	    """A local policy signer with a TEST key. Policy as the deployed slot-2 signer: tag must be attest or manifest;
    80	    an attestation must name this slot's key; the gpg slot refuses a declared_issue_time more than epsilon from
    81	    its clock (A9:401-405). `process()` handles what is queued now; tests call it (or not) to model a signer that
    82	    is slow, down or late."""
    83	
    84	    def __init__(self, slot, key, requests, responses, clock):
    85	        self.slot, self.key, self.requests, self.responses, self.clock = slot, key, requests, responses, clock
    86	        self.key_bytes = key.spki if slot == "kms" else key.pgp_body
    87	        self.fp = key.fp_kms if slot == "kms" else key.fp_gpg
    88	        self.signed = []                       # (request_id, frame sha256, signature sha256)
    89	
    90	    def _refuse(self, rid, reason, detail=""):
    91	        return {"request_id": rid, "status": "REFUSED", "reason": reason, "detail": detail,
    92	                "signer": {"clock": rfc3339(self.clock()), "slot": self.slot}}
    93	
    94	    def handle(self, req):
    95	        rid = req.get("request_id")
    96	        try:
    97	            frame = b64d(req["frame_b64"])
    98	        except (KeyError, ValueError, TypeError):
    99	            return self._refuse(rid, "BAD_REQUEST")
   100	        try:
   101	            obj = read_frame(frame, "tessera-v1/attest")
   102	            if obj["signer"]["key_fp"] != self.fp:
   103	                return self._refuse(rid, "KEY_FP_MISMATCH")
   104	            if self.slot == "gpg" and abs(ts(obj["common"]["declared_issue_time"]) - self.clock()) > EPS:
   105	                return self._refuse(rid, "DECLARED_TIME_OUTSIDE_EPSILON")
   106	        except Fault:
   107	            try:
   108	                read_frame(frame, "tessera-v1/manifest")
   109	            except Fault as e:
   110	                return self._refuse(rid, e.code)
   111	        if self.slot == "kms":
   112	            sig = self.key.sign(frame)
   113	        else:
   114	            from .testkeys import pgp_sign
   115	            sig = pgp_sign(frame, self.key, self.clock())
   116	        self.signed.append((rid, sha256hex(frame), sha256hex(sig)))
   117	        return {"request_id": rid, "status": "SIGNED", "sig_b64": b64e(sig),
   118	                "signer": {"clock": rfc3339(self.clock()), "slot": self.slot}}
   119	
   120	    def process(self, limit=None):
   121	        n = 0
   122	        while limit is None or n < limit:
   123	            msgs = self.requests.receive(1)
   124	            if not msgs:
   125	                break
   126	            m = msgs[0]
   127	            try:
   128	                req = json.loads(m.body)
   129	            except ValueError:
   130	                req = {}
   131	            self.responses.send(json.dumps(self.handle(req), sort_keys=True))
   132	            self.requests.delete(m.handle)
   133	            n += 1
   134	        return n
