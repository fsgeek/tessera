     1	"""The two policy signers behind one interface (DESIGN.md "Signers"): the issuer enqueues a frame on the slot's
     2	request queue and reads signed responses from the slot's response queue. The issuer holds no signing credential.
     3	
     4	Wire protocol (the deployed slot-2 policy signer's): request {"request_id", "frame_b64"}; response {"request_id",
     5	"status": "SIGNED" | "REFUSED", "sig_b64"?, "reason"?, "detail"?, "signer": {...}?}.
     6	
     7	E-01: `wake()` starts a signer on demand (optional hook per slot, called once per enqueued batch).
     8	E-02: request ids are derived from (request, frame hash), so a retry reuses the id and a late answer to the first
     9	attempt satisfies it; the caller records every response with frame and signature hashes (pipeline.drain).
    10	
    11	StandInSigner is the local signer process: it reads the same queues and signs with TEST keys."""
    12	import json
    13	
    14	from tessera_verify.codec import (Fault, parse_signature, public_key, registered_codecs, sig_policy,
    15	                                  signature_verifies, read_frame)
    16	
    17	from .encode import fp_gpg, fp_kms
    18	from .util import ALG, EPS, b64d, b64e, rfc3339, sha256hex, ts
    19	
    20	SLOTS = ("kms", "gpg")
    21	REGISTRY = registered_codecs(ALG)
    22	
    23	
    24	def request_id(request_id_scope, slot, frame):
    25	    """E-02: one id per (request, slot, frame); a retry of the same frame for the same request reuses it. The slot is
    26	    in the derivation because the manifest frame goes to both slots."""
    27	    return "req-" + sha256hex(f"{request_id_scope}\n{slot}\n{sha256hex(frame)}".encode())[:40]
    28	
    29	
    30	def verify_slot_signature(slot, key_bytes, frame, sig):
    31	    """Rule R (kms) or rule O (gpg) codec and policy, then the signature over the exact frame bytes, with the
    32	    service verifier's own functions."""
    33	    try:
    34	        parsed = parse_signature(sig, ALG, slot, REGISTRY)
    35	        sig_policy(parsed)
    36	        return signature_verifies(frame, parsed, public_key(key_bytes, slot, ALG))
    37	    except Fault:
    38	        return False
    39	
