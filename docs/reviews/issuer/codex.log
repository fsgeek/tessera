    32	def load(objects_dir):
    33	    d = Path(objects_dir)
    34	    raw = {n: (d / n).read_bytes() for n in FILES}
    35	    parse_catalog(raw["catalog.json"])          # closed, canonical, the frozen constants
    36	    cat = json.loads(raw["catalog.json"])
