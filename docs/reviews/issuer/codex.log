    78	class StandInSigner:
    79	    """A local policy signer with a TEST key. Policy as the deployed slot-2 signer: tag must be attest or manifest;
    80	    an attestation must name this slot's key; the gpg slot refuses a declared_issue_time more than epsilon from
    81	    its clock (A9:401-405). `process()` handles what is queued now; tests call it (or not) to model a signer that
    82	    is slow, down or late."""
    83	
    84	    def __init__(self, slot, key, requests, responses, clock):
    85	        self.slot, self.key, self.requests, self.responses, self.clock = slot, key, requests, responses, clock
    86	        self.key_bytes = key.spki if slot == "kms" else key.pgp_body
    87	        self.fp = key.fp_kms if slot == "kms" else key.fp_gpg
    88	        self.signed = []                       # (request_id, frame sha256, signature sha256)
    89	
    90	    def _refuse(self, rid, reason, detail=""):
    91	        return {"request_id": rid, "status": "REFUSED", "reason": reason, "detail": detail,
    92	                "signer": {"clock": rfc3339(self.clock()), "slot": self.slot}}
    93	
    94	    def handle(self, req):
    95	        rid = req.get("request_id")
    96	        try:
