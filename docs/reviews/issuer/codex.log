   239	def st_stamp(iss, rec, now):
   240	    tip = iss.headers.tip()
   241	    if tip < iss.window.h_git + 5:                     # chain-order pre-commitment (profile 4, 6.3)
   242	        return
   243	    proofs = rec["proofs"]
   244	    if "receipt" not in proofs:
   245	        raw = ots.stamp(sha256(iss.results.get("work", rec["rid"], "a_sig")), iss.calendars, iss.nonce())
   246	        iss.results.put("work", rec["rid"], "receipt.ots", raw)
   247	        proofs["receipt"] = {"stamped_at": now, "tip": tip}
   248	        _event(rec, now, "stamped", "receipt")
   249	        _save(iss, rec)
   250	    if "snapshot" not in proofs:
   251	        body = iss.dns.capture(now)
   252	        problem = _validate_snapshot_now(iss, body, now)
   253	        if problem:
   254	            _event(rec, now, "snapshot-rejected", problem)
   255	            _save(iss, rec)
   256	            return                                     # recapture next tick
   257	        env = encode_snapshot_envelope(body)
   258	        raw = ots.stamp(sha256(env), iss.calendars, iss.nonce())
   259	        iss.results.put("work", rec["rid"], "snapshot.body", body)
   260	        iss.results.put("work", rec["rid"], "snapshot.ots", raw)
   261	        proofs["snapshot"] = {"stamped_at": now, "tip": tip}
   262	        _event(rec, now, "stamped", "snapshot")
   263	    rec["stage"] = "confirm"
   264	    _save(iss, rec)
   265	
   266	
   267	def st_confirm(iss, rec, now):
   268	    tip = iss.headers.tip()
   269	    ready = True
   270	    for name in ("receipt", "snapshot"):
   271	        raw = iss.results.get("work", rec["rid"], name + ".ots")
   272	        new, changed = ots.upgrade(raw, iss.calendars)
   273	        if changed:
   274	            iss.results.put("work", rec["rid"], name + ".ots", new)
   275	        ok, h = ots.k6_ready(new, tip)
   276	        rec["proofs"][name]["h"] = h
   277	        ready = ready and ok
   278	    if ready:
   279	        if not rec["proofs"]["receipt"]["h"] > iss.window.h_git + 5:
   280	            return _end(iss, rec, "FAILED", "GIT_NOT_PRECOMMITTED", now)
   281	        rec["stage"] = "headers"
   282	        _event(rec, now, "confirmed", rec["proofs"]["receipt"]["h"], rec["proofs"]["snapshot"]["h"])
   283	    _save(iss, rec)
   284	
   285	
   286	def st_headers(iss, rec, now):
   287	    heights = set()
   288	    for raw in (iss.results.get("work", rec["rid"], "receipt.ots"), iss.results.get("work", rec["rid"], "snapshot.ots"),
   289	                iss.window.git["ots"]):
   290	        h = ots.lowest_btc_height(raw)
   291	        heights.update(range(h, h + 6))
   292	    hdrs = iss.headers.headers(sorted(heights))
   293	    iss.results.put("work", rec["rid"], "headers.json", json.dumps({str(h): v.hex() for h, v in hdrs.items()}).encode())
   294	    rec["stage"] = "assemble"
   295	    _save(iss, rec)
   296	
   297	
   298	def assemble(iss, rec, hdrs):
   299	    """The canonical JCS container of profile 15.1."""
   300	    get, w, fz = (lambda n: iss.results.get("work", rec["rid"], n)), iss.window, iss.frozen
   301	    receipt_ots = get("receipt.ots")
   302	    selected, _ = select(parse_ots(receipt_ots), hdrs, {h: pin_of(v) for h, v in hdrs.items()})
   303	    if selected is None:
   304	        raise StageError("receipt proof does not qualify under the fetched headers")
   305	    txid = ots.txid_of(selected.paths[0])
   306	    from .util import ts
   307	    delay = max(0, selected.time - ts(rec["declared_issue_time"]))
   308	    layer = {
   309	        "a_sig": b64e(get("a_sig")),
   310	        "dependency_manifest": b64e(fz.dependency_manifest),
   311	        "dns": {"ots": b64e(get("snapshot.ots")), "snapshot_body": b64e(get("snapshot.body"))},
   312	        "git": {"blob": b64e(w.git["blob"]), "commit": b64e(w.git["commit"]), "object_format": "sha1",
   313	                "ots": b64e(w.git["ots"]), "trees": [b64e(t) for t in w.git["trees"]]},
   314	        "headers": {str(h): v.hex() for h, v in sorted(hdrs.items())},
   315	        "issuer_record": {"observed_anchor_delay_s": str(delay), "policy_version": POLICY_VERSION},
   316	        "keys": {"gpg": b64e(w.gpg_key), "kms": b64e(w.kms_key)},
   317	        "manifest": b64e(get("manifest")),
   318	        "possession": {"gpg": b64e(get("sig-p_gpg")), "kms": b64e(get("sig-p_kms"))},
   319	        "preamble": b64e(fz.preamble),
   320	        "receipt_anchor": {"ots": b64e(receipt_ots), "txid": txid},
   321	        "spec": b64e(fz.spec),
   322	        "vectors": b64e(fz.vectors),
   323	    }
   324	    return jcs({"layers": [layer], "profile": PROFILE})
   325	
   326	
   327	def st_assemble(iss, rec, now):
   328	    hdrs = {int(h): bytes.fromhex(v) for h, v in json.loads(iss.results.get("work", rec["rid"], "headers.json")).items()}
   329	    bundle = assemble(iss, rec, hdrs)
   330	    stable, _ = iss.preship.check(bundle, hdrs, now)
   331	    if stable["verdict"] == "VALID_STRICT" and stable["reason"] == "OK":
   332	        iss.results.put("result", rec["rid"], "receipt.json", bundle)
   333	        rec["receipt_sha256"] = sha256hex(bundle)
   334	        rec["T"] = stable["T"]
   335	        return _end(iss, rec, "COMPLETE", None, now)
   336	    if stable["reason"] in SNAPSHOT_REASONS:            # profile 4: re-capture the snapshot before shipping
   337	        rec["proofs"].pop("snapshot", None)
   338	        rec["stage"] = "stamp"
   339	        _event(rec, now, "preship-recapture", stable["reason"])
   340	        return _save(iss, rec)
   341	    return _end(iss, rec, "FAILED", "PRESHIP:" + stable["verdict"] + "/" + stable["reason"], now)
   342	
   343	
   344	STAGES = {"frames": st_frames, "signing": st_signing, "stamp": st_stamp, "confirm": st_confirm,
   345	          "headers": st_headers, "assemble": st_assemble}

