   221	def _validate_snapshot_now(iss, body, now):
   222	    """Issuer pre-stamp check with the verifier's DNSSEC code: wildcard-free, every chain group valid now, and the
   223	    TXT value equal to the window's assertion."""
   224	    try:
   225	        snap = parse_snapshot(body)
   226	        if snap.wildcard:
   227	            return "DNS_WILDCARD"
   228	        config = check_config(iss.window.trust_base, {}, rfc3339(now))
   229	        bad = [a.reason or a.status for a in validate_snapshot(snap, config, now) if a.status != "pass"]
   230	        if bad:
   231	            return bad[0]
   232	        if snap.txt is None or txt_value([r.data for r in snap.txt.rr])["_raw"] != iss.window.assertion:
   233	            return "DNS_VALUE_DIFFERS"
   234	    except Fault as e:
   235	        return e.code
   236	    return None
   237	
