     1	"""The stage pipeline and the scheduled poller (DESIGN.md "Pipeline"). Each poll first drains every signer response
     2	queue (E-02), then advances each ACCEPTED request by at most one stage:
     3	
     4	  frames    fix the manifest and common metadata (declared_issue_time = now), build both frames, enqueue the four
     5	            signing jobs (attestation and possession, both slots) with request ids derived from (request, frame)
     6	  signing   wait for all four; re-send unanswered jobs with the same id; then verify each on its exact bytes,
     7	            freeze them, build A_sig and check it with the verifier's decoders           (profile 4 steps 2-6)
     8	  stamp     after the git assertion's proof has k = 6 (tip >= h_git + 5): one stamp of SHA-256(A_sig); capture,
     9	            validate (verifier DNSSEC code, now) and stamp the DNSSEC snapshot envelope
    10	  confirm   upgrade both proofs until each has k = 6 at the tip
    11	  headers   fetch headers h..h+5 for the lowest attestation of each of the three proofs
    12	  assemble  build the canonical container and run the pre-ship checks (verifier library); VALID_STRICT ships,
    13	            a snapshot-rule failure re-captures the snapshot, anything else is FAILED
    14	
    15	Ending rules: 24 h after acceptance without COMPLETE -> FAILED; frames or signing after the signing stop (96 h
    16	before not-after) -> FAILED. A request is never shipped late or incomplete."""
    17	import json
    18	
    19	from tessera_verify.anchors import parse_ots, select
    20	from tessera_verify.codec import Fault, read_anchor, read_frame, registered_codecs
    21	from tessera_verify.dnssec import parse_snapshot, txt_value, validate_snapshot
    22	
    23	from . import ots
    24	from .api import content_name
    25	from .chain import pin_of
    26	from .encode import common_metadata, encode_anchor, encode_attest, encode_manifest, encode_snapshot_envelope
    27	from .preship import PreShipUnavailable, check_config
    28	from .service import DEADLINE_S, RETENTION_S
    29	from .signers import request_id
    30	from .util import ALG, POLICY_VERSION, b64d, b64e, jcs, rfc3339, sha256, sha256hex, PROFILE
    31	
    32	JOBS = (("s_kms", "kms", "f_kms"), ("p_kms", "kms", "manifest"), ("s_gpg", "gpg", "f_gpg"), ("p_gpg", "gpg", "manifest"))
    33	SNAPSHOT_REASONS = {"SNAPSHOT_TIME", "SNAPSHOT_NOT_ANCHORED", "SNAPSHOT_STAMP_MISMATCH", "DNS_WILDCARD",
    34	                    "RRSIG_NOT_VALID_AT_EVAL_TIME", "DNS_EVIDENCE_MISSING", "TRUST_HORIZON"}
