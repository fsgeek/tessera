    43	                  signers=signers,
    44	                  calendars=[HttpCalendar(u, http) for u in env["OTS_CALENDARS"].split(",") if u],
    45	                  headers=ExplorerHeaders([u for u in env["EXPLORERS"].split(",") if u], http),
    46	                  dns=LiveDns(udp_tcp_transport(env.get("DNS_RESOLVER", "1.1.1.1"))),
    47	                  preship=PreShip(frozen, win.trust_base, env.get("TESSERA_VERIFY_INSTALL_JSON")),
