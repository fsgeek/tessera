    return str(uuid.uuid4())
"""Regression tests for the Codex confirmation review (docs/reviews/issuer/CODEX-CONFIRM.md, CF-01..CF-04; CF-05 is
the strengthened IS-05 test in test_review_fixes.py). Races are driven by a controllable clock and by hooks that
interleave a concurrent actor at a chosen point; nothing sleeps."""
import re
import uuid
from pathlib import Path

import pytest

from tessera_issue import api, local, pipeline
from tessera_issue.aws import S3ResultStore
from tessera_issue.service import DEADLINE_S, RETENTION_S, WRITE_LEASE_S

from conftest import FROZEN
from fakes import FakeS3
from helpers import submit


class LambdaTimeout(BaseException):
    """The invocation is killed: nothing in the issuer can catch it."""


def blobs(loc, rid, ns=None):
    res = loc.iss.results
    if isinstance(res, S3ResultStore):
        return [k for b, k in res.c.objects if k.split("/")[1] == rid and (ns is None or k.startswith(ns + "/"))]
    return [k for k in res.blobs if k[1] == rid and (ns is None or k[0] == ns)]


def s3_loc():
    loc = local.build(FROZEN)
    loc.iss.results = S3ResultStore(FakeS3(), "bucket")
    loc.workers["kms"].fetch = loc.workers["gpg"].fetch = loc.iss.results.get_ref
    return loc


def at_assemble(loc, key, before=1):
    """-> (rid, deadline) with the request about to be assembled, the clock `before` seconds before its deadline."""
    _, rid = submit(loc, key)
    for _ in range(100):
        rec = loc.iss.requests.get(rid)
        if rec["stage"] == "assemble":
            break
        loc.tick()
    assert rec["stage"] == "assemble"
    deadline = rec["created_at"] + DEADLINE_S
    loc.clock.t = deadline - before
    return rid, deadline


def assert_failed_late(loc, key, rid, deadline):
    rec = loc.iss.requests.get(rid)
    assert rec["state"] == "FAILED" and rec["reason"] == "NOT_COMPLETE_WITHIN_24H", (rec["state"], rec["reason"])
    assert rec["ended_at"] >= deadline                       # never backdated
    assert api.status(loc.iss, "cred-A", key).body["state"] == "FAILED"
    assert api.receipt(loc.iss, "cred-A", key).status == 409
    pipeline.poll(loc.iss)
    assert not blobs(loc, rid, "result")


# ------------------------------------------------------------------------------------------------ CF-01
def test_CF01_slow_cleanup_obligation_write_cannot_carry_completion_past_the_deadline(loc, key):
    rid, deadline = at_assemble(loc, key)
    store = loc.iss.requests
    real = store.cleanup_put

    def slow(r, doc):                                        # persisting the obligation takes two seconds
        loc.clock.advance(2)
        return real(r, doc)
    store.cleanup_put = slow
    pipeline.poll(loc.iss)
    store.cleanup_put = real
    assert_failed_late(loc, key, rid, deadline)


def test_CF01_slow_terminal_write_cannot_carry_completion_past_the_deadline(loc, key):
    rid, deadline = at_assemble(loc, key)
    store = loc.iss.requests
    real, delayed = store.save, []

"""Pre-ship checks (profile 4 and 15.7): the assembled bundle is verified with the service verifier's own logic,
called as a library, under the issuer's check configuration: the window's root KSK and repository-key entries plus
pins for exactly the headers the issuer fetched and checked. Anything but VALID_STRICT / OK is not shipped.

The SHA-1DC detector the verifier needs is configured from the verifier's per-installation record (install.json,
profile 15.9 R2); without a functional detector the check refuses to run (PreShipUnavailable), never passes."""
from tessera_verify import install_record
from tessera_verify.codec import Fault
from tessera_verify.policy import parse_trust
from tessera_verify.verify import verify_bundle

from .chain import pin_of
from .util import D, PROFILE, jcs, rfc3339


class PreShipUnavailable(Exception):
    pass


def trust_object(trust_base, pins, as_of):
    return {"as_of": as_of, "format": "tessera-v1-trust/1",
            "header_pins": {str(h): v for h, v in sorted(pins.items())} or {"0": "0" * 64},
            "issuer_domain": D, "previous_sha256": "0" * 64, "profile": PROFILE,
            "repository_keys": trust_base["repository_keys"], "root_ksks": trust_base["root_ksks"], "version": "1"}


def check_config(trust_base, pins, as_of):
    """The parsed configuration (service verifier parser), or raises Fault."""
    return parse_trust(jcs(trust_object(trust_base, pins, as_of)))


class PreShip:
    def __init__(self, frozen, trust_base, install_record_path=None):
        self.frozen, self.trust_base, self.path = frozen, trust_base, install_record_path
        self._ready = False

    def _setup(self):
        if not self._ready:
            try:
                install_record.load_and_apply(self.path)
            except Fault as e:
                raise PreShipUnavailable(e.code) from None
            self._ready = True

    def check(self, bundle, headers, now):
        """-> (stable six, utc_assessment). headers: {height: 80 bytes} the issuer fetched and checked."""
        self._setup()
        latest = max(int.from_bytes(h[68:72], "little") for h in headers.values())
        config = check_config(self.trust_base, {h: pin_of(v) for h, v in headers.items()}, rfc3339(max(now, latest)))
        try:
            return verify_bundle(bundle, config, self.frozen.parsed_catalog, utc=True)
        except Fault as e:                      # e.g. SHA1DC_UNAVAILABLE raised by the engine itself
            raise PreShipUnavailable(e.code) from None
     1	# V1 service contract and failure model
     2	
     3	> **Status: OWNER DRAFT, 2026-10-19** (Claude Opus 5.5, owner instance). It restates what A9.1 and A10 already
     4	> registered. It changes no registered sentence; if it disagrees with A9 or A10, they win and this page is wrong.
     5	> Revised the same day after a full Codex review (`docs/reviews/v1-contract/CODEX-REVIEW.md`, VC-01 to VC-25, all
     6	> applied; `DISPOSITION.md`). Purpose: one page that the formal models, the conformance cases, the service and the
     7	> testers are all checked against, so that when two of them disagree we can see whether the contract, the model or
     8	> the code is at fault (the author's method, travelog 2026-10-19).
     9	
    10	## 1. What a client gets
    11	
    12	The client sends bytes. Tessera returns a **receipt**: a bundle that anyone can check later, without Tessera
    13	running and without our help.
    14	
    15	## 2. Guarantees
    16	
    17	**Conditions.** Every guarantee assumes the registered cryptographic, key-use, authority, chain-history and
    18	distribution assumptions (A9:32–52, A9:128–136). In particular: nobody misused the service's signing capability,
    19	SHA-256 and OpenTimestamps hold, and the checker's verifier release is authentic.
    20	
    21	When those hold, a checker who has the receipt, the published verifier and its trust configuration can establish:
    22	
    23	| # | Guarantee | Source |
    24	|---|---|---|
    25	| G1 | **Exact bytes.** The receipt binds these exact bytes. Change one bit and the check fails. | C1 |
    26	| G2 | **Presented to Tessera.** The bytes were presented to the Tessera V1 service at some issuance. | C2 |
    27	| G3 | **Both signatures.** Both of the service's keys signed. A missing, stripped or swapped signature fails. | C3 |
    28	| G4 | **The keys were Tessera's.** DNSSEC (`_tessera-v1.wamason.com`, at the snapshot's own anchored time) and a signed git commit (at its own evidence time) named the keys for the service's domain. The git commit was in the Bitcoin chain at least 6 blocks before the receipt. | C4, A10.6 |
    29	| G5 | **Existed by a block.** The signed bytes and both signatures existed before a specific Bitcoin block: the lowest-height qualifying block in the presented proof, confirmed 6 deep. | C5, A10.1, A10.5 |
    30	| G6 | **A real-time bound, under an unchecked assumption.** A-UTC says at least one of that block and its 5 successors has a time stamp at most 2 hours behind when it was made. If A-UTC holds, the bytes existed before U (the latest of those 6 times, plus 2 hours). U is reported separately and never changes the verdict. | A10.1.1 |
    31	| G7 | **Window, two checks only.** The declared issue time is not before the keys' window opened, and the chain time T is not after it closed. This does not prove the signing happened inside the window. | C4, A10.2 |
    32	| G8 | **No Tessera needed.** The verdict depends only on the inputs above. | C6 |
