FROZEN=Path('/home/tony/projects/tessera/formal/freeze-v1/objects')

def build(): return local.build(FROZEN)
def test_admission_read_crosses_window():
    loc=build(); key=str(uuid.uuid4()); loc.clock.t=loc.iss.window.accept_until-1
    real=loc.iss.requests.get
    def slow(rid):
        loc.clock.advance(2)
        return real(rid)
    loc.iss.requests.get=slow
    r=api.submit(loc.iss,'cred-A',key,b'hello')
    assert r.status==202
    assert loc.clock()>loc.iss.window.accept_until
    print('late admission',r.status,loc.clock()-loc.iss.window.accept_until)

def test_repeat_read_crosses_retention():
    loc=build(); key=str(uuid.uuid4()); _,rid=submit(loc,key); rec=loc.run_until_done(rid)
    expiry=rec['ended_at']+RETENTION_S; loc.clock.t=expiry-1
    real=loc.iss.requests.get
    def slow(r):
        loc.clock.advance(2); return real(r)
    loc.iss.requests.get=slow
    r=api.submit(loc.iss,'cred-A',key,b'hello Tessera')
    # content must match helper
    print('repeat',r.status,r.body)

def test_confirmation_backdates_end_within_lease():
    loc=build(); key=str(uuid.uuid4()); rid,deadline=at_assemble(loc,key,before=WRITE_LEASE_S+1)
    real=loc.iss.requests.save; commits=[]
    def slow(rec):
        if rec.get('confirmed_at') is not None:
            loc.clock.advance(WRITE_LEASE_S); commits.append(loc.clock())
        return real(rec)
    loc.iss.requests.save=slow; pipeline.poll(loc.iss)
    rec=loc.iss.requests.get(rid)
    assert rec['ended_at']==commits[0]-WRITE_LEASE_S
    loc.clock.t=rec['ended_at']+RETENTION_S
    assert api.receipt(loc.iss,'cred-A',key).status==410
    assert loc.clock()<commits[0]+RETENTION_S
    print('end backdated',commits[0]-rec['ended_at'])

def test_confirmation_remote_commit_outlives_lease():
    loc=build(); key=str(uuid.uuid4()); rid,deadline=at_assemble(loc,key,before=WRITE_LEASE_S+1)
    real=loc.iss.requests.save
    def remote(rec):
        if rec.get('confirmed_at') is not None: loc.clock.advance(WRITE_LEASE_S+2)
        return real(rec)
    loc.iss.requests.save=remote; pipeline.poll(loc.iss)
    assert loc.clock()>deadline
    assert api.status(loc.iss,'cred-A',key).body['state']=='COMPLETE'
    print('late confirmed COMPLETE',loc.clock()-deadline)

def test_presign_internal_delay():
    loc=s3_loc(); key=str(uuid.uuid4()); _,rid=submit(loc,key); rec=loc.run_until_done(rid)
    expiry=rec['ended_at']+RETENTION_S; loc.clock.t=expiry-1
    real=loc.iss.results.c.generate_presigned_url; minted=[]
    def slow(*a,**kw):
        loc.clock.advance(2); minted.append(loc.clock()); return real(*a,**kw)
    loc.iss.results.c.generate_presigned_url=slow
    assert api.receipt(loc.iss,'cred-A',key).status==303
    assert minted[0]>expiry
    print('minted after expiry',minted[0]-expiry)
