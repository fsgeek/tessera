   184	class S3ResultStore(ResultStore):
   185	    """Receipt URLs (IS-06): short-lived (<= 300 s) pre-signed GETs, minted per request after the API's credential check."""
   186	
   187	    def __init__(self, client, bucket):
   188	        self.c, self.b = client, bucket
   189	
   190	    @staticmethod
   191	    def key(ns, rid, name):
   192	        if ns not in NAMESPACES:
   193	            raise ValueError(ns)
   194	        return f"{ns}/{rid}/{name}"
   195	
   196	    def put(self, ns, rid, name, data):
   197	        self.c.put_object(Bucket=self.b, Key=self.key(ns, rid, name), Body=bytes(data), ServerSideEncryption="AES256")
   198	
   199	    def get(self, ns, rid, name):
   200	        try:
   201	            return self.c.get_object(Bucket=self.b, Key=self.key(ns, rid, name))["Body"].read()
   202	        except Exception as e:  # noqa: BLE001
   203	            if _not_found(e):
   204	                return None
   205	            raise
   206	
   207	    DELETE_ROUNDS = 20                                # CF-04: listing pages (<= 1000 keys each) per call
   208	
   209	    def delete(self, ns, rid):
   210	        """Delete everything under (ns, rid). Raises on any per-object error S3 reports inside a successful
   211	        DeleteObjects response, and after DELETE_ROUNDS pages, so one obligation can never hold the poller (CF-04);
   212	        the caller keeps the obligation and the next poll continues."""
   213	        prefix = self.key(ns, rid, "")
   214	        for _ in range(self.DELETE_ROUNDS):           # list from the start each round: deleting never skips keys
   215	            keys = [{"Key": o["Key"]} for o in self.c.list_objects_v2(Bucket=self.b, Prefix=prefix).get("Contents", [])]
   216	            if not keys:
   217	                return
   218	            r = self.c.delete_objects(Bucket=self.b, Delete={"Objects": keys, "Quiet": True}) or {}
   219	            errors = r.get("Errors") or []
   220	            if errors:
   221	                e = errors[0]
   222	                raise OSError(f"S3 could not delete {len(errors)} object(s) under {prefix}: "
   223	                              f"{e.get('Key')} {e.get('Code')} {e.get('Message', '')}".rstrip())
   224	        raise OSError(f"deletion under {prefix} not finished after {self.DELETE_ROUNDS} rounds; continued next poll")
   225	
   226	    def names(self, ns, rid):
   227	        prefix, out, token = self.key(ns, rid, ""), [], None
   228	        while True:
   229	            kw = {"Bucket": self.b, "Prefix": prefix}
   230	            if token:
   231	                kw["ContinuationToken"] = token
   232	            r = self.c.list_objects_v2(**kw)
   233	            out += [o["Key"][len(prefix):] for o in r.get("Contents", [])]
   234	            token = r.get("NextContinuationToken")
   235	            if not token:
   236	                return sorted(out)
   237	
   238	    def size(self, ns, rid, name):
   239	        try:
   240	            return int(self.c.head_object(Bucket=self.b, Key=self.key(ns, rid, name))["ContentLength"])
   241	        except Exception as e:  # noqa: BLE001
   242	            if _not_found(e):
   243	                return None
   244	            raise
   245	
   246	    def presign(self, ns, rid, name, expires_in, now):
   247	        return self.c.generate_presigned_url(
   248	            "get_object", Params={"Bucket": self.b, "Key": self.key(ns, rid, name)}, ExpiresIn=int(expires_in))
   249	
   250	    def get_config(self, name):
   251	        return self.c.get_object(Bucket=self.b, Key="config/" + name)["Body"].read()
