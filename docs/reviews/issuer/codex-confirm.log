import sys,uuid
from pathlib import Path
sys.path.insert(0,str(Path('tests').resolve()))
from tessera_issue import api,local,pipeline
from tessera_issue.service import DEADLINE_S,RETENTION_S
from conftest import FROZEN
from helpers import submit

def until(loc,rid,stage):
    for _ in range(100):
        rec=loc.iss.requests.get(rid)
        if rec['stage']==stage: return rec
        loc.tick()
    raise AssertionError(stage)

loc=local.build(FROZEN); key=str(uuid.uuid4()); _,rid=submit(loc,key)
rec=until(loc,rid,'assemble'); deadline=rec['created_at']+DEADLINE_S
loc.clock.t=deadline-1
orig=loc.iss.requests.cleanup_put
calls=[]
def slow_obligation(rid,doc):
    if not calls:
        calls.append(1); loc.clock.advance(2)
    return orig(rid,doc)
loc.iss.requests.cleanup_put=slow_obligation
pipeline.poll(loc.iss)
rec=loc.iss.requests.get(rid)
print('DEADLINE_AFTER_CLEANUP_WRITE',{'state':rec['state'],'ended_relative_to_deadline':rec['ended_at']-deadline,'visible_relative_to_deadline':loc.clock()-deadline})

loc=local.build(FROZEN); key=str(uuid.uuid4()); _,rid=submit(loc,key)
rec=loc.run_until_done(rid); expiry=rec['ended_at']+RETENTION_S
loc.clock.t=expiry-1
orig=loc.iss.results.size
minted=[]
def slow_head(*a):
    out=orig(*a); loc.clock.advance(2); return out
loc.iss.results.size=slow_head
orig_mint=loc.iss.results.presign
def mint(*a):
    minted.append(loc.clock()); return orig_mint(*a)
loc.iss.results.presign=mint
response=api.receipt(loc.iss,'cred-A',key)
print('MINT_AFTER_EXPIRY',{'response':response.status,'minted_relative_to_expiry':[t-expiry for t in minted],'current_status':api.status(loc.iss,'cred-A',key).body['state']})

loc=local.build(FROZEN); key=str(uuid.uuid4()); store=loc.iss.requests; res=loc.iss.results
orig_put=res.put
def no_upload(*a): raise OSError('first upload failed')
res.put=no_upload
try: submit(loc,key,b'private upload')
except OSError: pass
rid=api.record_id('cred-A',key); rec=store.get(rid)
loc.clock.t=rec['created_at']+pipeline.UPLOAD_GRACE_S-1
started=[]
def delayed_upload(ns,r,name,data):
    if ns=='content' and not started:
        started.append(1); loc.clock.advance(2)
        pipeline.poll(loc.iss)
        print('UPLOAD_DURING_TERMINATION',{'state':store.get(rid)['state'],'obligations':store.cleanup_list()})
        orig_put(ns,r,name,data)
        raise OSError('request terminated after S3 committed its write')
    return orig_put(ns,r,name,data)
res.put=delayed_upload
try: submit(loc,key,b'private upload')
except OSError: pass
res.put=orig_put
