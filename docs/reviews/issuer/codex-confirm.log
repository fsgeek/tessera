   333	def relying_party_trust(window, headers, as_of):
   334	    """The relying party's TEST trust configuration: the window's entries plus pins for the given headers."""
   335	    from .preship import trust_object
   336	    return jcs(trust_object(window.trust_base, {h: pin_of(v) for h, v in headers.items()}, as_of))
