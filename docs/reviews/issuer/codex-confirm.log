    29	class StandInChain(HeaderSource):
    30	    """Blocks are mined explicitly (mine()); each block's nTime is the clock, strictly increasing. Calendars
    31	    attached with attach() have their pending commitments included in the next block."""
    32	
    33	    def __init__(self, clock, base_height=950000):
    34	        self.clock, self.base = clock, base_height
    35	        self.blocks = {base_height: {"time": clock() - 600, "txs": [sha256d(b"TEST coinbase %d" % base_height)]}}
    36	        self.tip_h = base_height
    37	        self.calendars = []
    38	
    39	    def attach(self, cal):
    40	        self.calendars.append(cal)
    41	
    42	    def mine(self, n=1):
    43	        for _ in range(n):
    44	            h = self.tip_h + 1
    45	            t = max(self.clock(), self.blocks[self.tip_h]["time"] + 1)
    46	            txs = [sha256d(b"TEST coinbase %d" % h)]
    47	            for cal in self.calendars:
    48	                txs += cal.include(h)
    49	            self.blocks[h] = {"time": t, "txs": txs}
    50	            self.tip_h = h
    51	        return self.tip_h
    52	
    53	    def tip(self):
    54	        return self.tip_h
    55	
    56	    def _levels(self, h):
    57	        level = list(self.blocks[h]["txs"])
    58	        levels = [level]
    59	        while len(level) > 1:
    60	            if len(level) % 2:
    61	                level = level + [level[-1]]
    62	            level = [sha256d(level[i] + level[i + 1]) for i in range(0, len(level), 2)]
    63	            levels.append(level)
    64	        return levels
    65	
    66	    def merkle_path(self, h, txid):
    67	        """Conventional suffix (profile 15.2): (append | prepend 32 bytes, sha256, sha256) per level."""
    68	        levels = self._levels(h)
    69	        idx, ops = levels[0].index(txid), []
    70	        for level in levels[:-1]:
    71	            lv = level + [level[-1]] if len(level) % 2 else level
    72	            ops.append((0xF0, lv[idx + 1]) if idx % 2 == 0 else (0xF1, lv[idx - 1]))
    73	            ops += [(0x08, b""), (0x08, b"")]
    74	            idx //= 2
    75	        return ops
    76	
    77	    def header(self, h):
    78	        b = self.blocks[h]
    79	        if "header" not in b:                        # a mined block never changes
    80	            prev = sha256d(self.header(h - 1)) if h - 1 in self.blocks else sha256d(b"TEST pre-chain")
    81	            root = self._levels(h)[-1][0]
    82	            b["header"] = (struct.pack("<i", 0x20000000) + prev + root + struct.pack("<I", b["time"] % U32)
    83	                           + struct.pack("<I", 0x17030ECD) + struct.pack("<I", h & 0xFFFFFFFF))
    84	        return b["header"]
    85	
    86	    def headers(self, heights):
    87	        out = {}
    88	        for h in sorted(heights):
    89	            if h not in self.blocks:
    90	                raise KeyError(f"no block {h}")
    91	            out[h] = self.header(h)
    92	        return out
    93	
    94	    def serve_esplora(self, method, url, body):
    95	        """Esplora-style explorer API for chain.ExplorerHeaders."""
    96	        path = url.split("://", 1)[-1].split("/", 1)[1]
    97	        parts = path.split("/")
    98	        if parts[-3:] == ["blocks", "tip", "height"]:
    99	            return 200, str(self.tip_h).encode()
   100	        if "block-height" in parts:
   101	            h = int(parts[-1])
   102	            return (200, pin_of(self.header(h)).encode()) if h in self.blocks else (404, b"")
   103	        if parts[-1] == "header":
   104	            for h in self.blocks:
   105	                if pin_of(self.header(h)) == parts[-2]:
   106	                    return 200, self.header(h).hex().encode()
   107	            return 404, b""
   108	        return 404, b""
