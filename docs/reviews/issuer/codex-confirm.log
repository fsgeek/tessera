   339	def make_test_release(trust_bytes, catalog_obj, release_key):
   340	    """A `tessera-v1-test-release/1` record (the verifier's TEST harness interface, never a release) and the key
   341	    file. -> (release bytes, key bytes)."""
   342	    cat = dict(catalog_obj, TEST="frozen catalog provisioned for an issuer stand-in run; TEST authority only")
   343	    body = {"catalog": cat, "catalog_sha256": hashlib.sha256(jcs_ascii(cat)).hexdigest(),
   344	            "format": "tessera-v1-test-release/1", "trust_config_sha256": sha256hex(trust_bytes)}
   345	    rs = release_key.sign_raw(jcs_ascii(body))
   346	    spki_sha = sha256hex(release_key.spki)
   347	    rel = {"release": body, "signature": {"alg": "ECDSA-P256-SHA256", "r_s_hex": rs.hex(), "signer_spki_sha256": spki_sha}}
   348	    key = {"TEST": "TEST release key of the issuer stand-in run", "spki_b64": b64e(release_key.spki),
   349	           "spki_sha256": spki_sha}
