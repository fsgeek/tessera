   173	class ZoneKey:
   174	    """A TEST DNSSEC key, algorithm 13 (ECDSA P-256 SHA-256)."""
   175	
   176	    def __init__(self, seed, ksk):
   177	        self.k = P256Key("dns:" + seed)
   178	        self.flags = 257 if ksk else 256
   179	
   180	    @property
   181	    def rdata(self):
   182	        return struct.pack(">HBB", self.flags, 3, 13) + self.k.point[1:]
   183	
   184	    @property
   185	    def tag(self):
   186	        return key_tag(self.rdata)
   187	
   188	
   189	def ds_rdata(owner, key):
   190	    return struct.pack(">HBB", key.tag, 13, 2) + hashlib.sha256(name_wire(owner) + key.rdata).digest()
   191	
   192	
   193	def _labels(owner):
   194	    return len([x for x in owner.rstrip(".").split(".") if x])
   195	
   196	
   197	def rrsig(owner, rtype, rdatas, ttl, key, signer, inception, expiration):
   198	    head = struct.pack(">HBBIIIH", rtype, 13, _labels(owner), ttl, expiration % U32, inception % U32, key.tag) \
   199	        + name_wire(signer)
   200	    ow = name_wire(owner)
   201	    data = head + b"".join(ow + struct.pack(">HHIH", rtype, 1, ttl, len(r)) + r for r in sorted(rdatas))
   202	    return head + key.k.sign_raw(data)
