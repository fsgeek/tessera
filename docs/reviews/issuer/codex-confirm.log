     1	"""Message queues behind one interface: in memory (tests, local runs) and SQS (AWS). The in-memory queue enforces
     2	SQS's message size limit."""
     3	import itertools
     4	from dataclasses import dataclass
     5	
     6	
     7	@dataclass
     8	class Message:
     9	    id: str
    10	    body: str
    11	    handle: str
    12	
    13	
    14	SQS_MAX_BYTES = 1048576              # SendMessage maximum message size
    15	
    16	
    17	class Queue:
    18	    def send(self, body):
    19	        raise NotImplementedError
    20	
    21	    def receive(self, max_messages=10, wait_s=0):
    22	        raise NotImplementedError
    23	
    24	    def delete(self, handle):
    25	        raise NotImplementedError
    26	
    27	
    28	class InMemoryQueue(Queue):
    29	    """At-least-once queue with a visibility timeout, like SQS: a received message is hidden until it is deleted or
    30	    its visibility timeout passes (measured on the given clock)."""
    31	
    32	    def __init__(self, clock, visibility_s=300, max_bytes=SQS_MAX_BYTES):
    33	        self.clock, self.visibility_s, self.max_bytes = clock, visibility_s, max_bytes
    34	        self.msgs = {}                       # id -> {"body", "visible_at", "handle"}
    35	        self._ids = itertools.count(1)
    36	
    37	    def send(self, body):
    38	        if len(body.encode()) > self.max_bytes:          # as SQS does (IS-09): the stand-in must not hide it
    39	            raise ValueError(f"message of {len(body.encode())} bytes exceeds {self.max_bytes}")
    40	        mid = f"m{next(self._ids)}"
    41	        self.msgs[mid] = {"body": body, "visible_at": 0, "handle": None}
    42	        return mid
    43	
    44	    def receive(self, max_messages=10, wait_s=0):
    45	        now, out = self.clock(), []
    46	        for mid, m in self.msgs.items():
    47	            if len(out) >= max_messages:
    48	                break
    49	            if m["visible_at"] <= now:
    50	                m["visible_at"] = now + self.visibility_s
    51	                m["handle"] = f"{mid}:{next(self._ids)}"
    52	                out.append(Message(mid, m["body"], m["handle"]))
    53	        return out
    54	
    55	    def delete(self, handle):
    56	        mid = handle.split(":")[0]
    57	        m = self.msgs.get(mid)
    58	        if m is not None and m["handle"] == handle:
    59	            del self.msgs[mid]
    60	
    61	    def __len__(self):
    62	        return len(self.msgs)
    63	
    64	
    65	class SqsQueue(Queue):
    66	    """SQS through an injected boto3-style client (`boto3.client("sqs")`)."""
    67	
    68	    def __init__(self, client, url):
    69	        self.client, self.url = client, url
    70	
    71	    def send(self, body):
    72	        return self.client.send_message(QueueUrl=self.url, MessageBody=body)["MessageId"]
    73	
    74	    def receive(self, max_messages=10, wait_s=0):
    75	        r = self.client.receive_message(QueueUrl=self.url, MaxNumberOfMessages=max(1, min(10, max_messages)),
    76	                                        WaitTimeSeconds=wait_s)
    77	        return [Message(m["MessageId"], m["Body"], m["ReceiptHandle"]) for m in r.get("Messages", [])]
    78	
    79	    def delete(self, handle):
    80	        self.client.delete_message(QueueUrl=self.url, ReceiptHandle=handle)

