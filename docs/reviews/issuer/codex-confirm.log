   280	def signed_commit(value, repo_key, when):
   281	    """The key-assertion commit: tessera-v1/key-assertion = value, gpgsig by the TEST repository key."""
   282	    readme = b"TEST issuer repository (stand-in). Not the Tessera repository.\n"
   283	    sub = tree([("100644", "key-assertion", git_id("blob", value))])
   284	    root = tree([("100644", "README", git_id("blob", readme)), ("40000", "tessera-v1", git_id("tree", sub))])
   285	    ident = f"TEST Issuer <test-issuer@wamason.com> {when} +0000".encode()
   286	    payload = b"tree " + git_id("tree", root).hex().encode() + b"\nauthor " + ident + b"\ncommitter " + ident + \
   287	        b"\n\nTEST: publish the tessera-v1 key assertion\n"
   288	    lines = armor(pgp_sign(payload, repo_key, when)).split("\n")
   289	    gpgsig = ("gpgsig " + lines[0] + "\n" + "".join(" " + ln + "\n" for ln in lines[1:])).encode()
   290	    end = payload.index(b"\n\n") + 1
   291	    commit = payload[:end] + gpgsig + payload[end:]
   292	    return commit, [root, sub], value
