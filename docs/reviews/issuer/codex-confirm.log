   111	class StandInCalendar:
   112	    """A calendar that, at each mined block, puts one OP_RETURN transaction per pending commitment into it."""
   113	
   114	    def __init__(self, chain, uri="https://stand-in-calendar.invalid"):
   115	        self.chain, self.uri = chain, uri
   116	        self.pending, self.mined = [], {}           # commitment -> (height, prefix, suffix, txid)
   117	        chain.attach(self)
   118	
   119	    def _tx(self, m):
   120	        prevout = drbg("prevout:" + m.hex(), 32) + struct.pack("<I", 0)
   121	        script_sig = drbg("scriptsig:" + m.hex(), 31)
   122	        inp = prevout + _compact(len(script_sig)) + script_sig + b"\xff\xff\xff\xff"
   123	        prefix = struct.pack("<i", 2) + b"\x01" + inp + b"\x01" + struct.pack("<q", 0) + _compact(34) + b"\x6a\x20"
   124	        return prefix, struct.pack("<I", 0)
   125	
   126	    def include(self, h):
   127	        txids = []
   128	        for m in self.pending:
   129	            prefix, suffix = self._tx(m)
   130	            txid = sha256d(prefix + m + suffix)
   131	            self.mined[m] = (h, prefix, suffix, txid)
   132	            txids.append(txid)
   133	        self.pending = []
   134	        return txids
   135	
   136	    def submit(self, message):
   137	        if message not in self.mined and message not in self.pending:
   138	            self.pending.append(message)
   139	        node = ots.Node()
   140	        node.att(ots.PENDING, ots.pending_payload(self.uri))
   141	        return node.ser()
   142	
   143	    def fetch(self, commitment):
   144	        if commitment not in self.mined:
   145	            return None
   146	        h, prefix, suffix, txid = self.mined[commitment]
   147	        root = ots.Node()
   148	        node = root.op(0xF1, prefix).op(0xF0, suffix).op(0x08).op(0x08)
   149	        for opcode, arg in self.chain.merkle_path(h, txid):
   150	            node = node.op(opcode, arg)
   151	        node.att(ots.BTC, ots._varuint(h))
   152	        return root.ser()
   153	
   154	    def serve(self, method, url, body):
   155	        """The calendar HTTP protocol for ots.HttpCalendar."""
   156	        if method == "POST" and url == self.uri + "/digest":
   157	            return 200, self.submit(body)
   158	        if method == "GET" and url.startswith(self.uri + "/timestamp/"):
   159	            got = self.fetch(bytes.fromhex(url.rsplit("/", 1)[1]))
   160	            return (200, got) if got else (404, b"")
   161	        return 404, b""
   162	
