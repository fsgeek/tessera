   205	class StandInDns(SnapshotSource):
   206	    """The TEST hierarchy . -> com -> wamason.com -> _tessera-v1.wamason.com TXT = the window's assertion value.
   207	    RRSIGs are made at capture time, valid from 5 days before to 10 days after it."""
   208	
   209	    def __init__(self, value, seed="stand-in"):
   210	        self.value = value
   211	        z = lambda n, ksk: ZoneKey(f"{seed}:{n}", ksk)  # noqa: E731
   212	        self.root_ksk, self.root_zsk = z("root-ksk", True), z("root-zsk", False)
   213	        self.com_ksk, self.com_zsk = z("com-ksk", True), z("com-zsk", False)
   214	        self.w_ksk, self.w_zsk = z("w-ksk", True), z("w-zsk", False)
   215	        self.captures = 0
   216	
   217	    def groups(self, now):
   218	        inc, exp = now - 5 * DAY, now + 10 * DAY
   219	        D = "wamason.com."
   220	        plan = [(".", T_DNSKEY, [self.root_ksk.rdata, self.root_zsk.rdata], 172800, self.root_ksk, "."),
   221	                ("com.", T_DS, [ds_rdata("com.", self.com_ksk)], 86400, self.root_zsk, "."),
   222	                ("com.", T_DNSKEY, [self.com_ksk.rdata, self.com_zsk.rdata], 86400, self.com_ksk, "com."),
   223	                (D, T_DS, [ds_rdata(D, self.w_ksk)], 86400, self.com_zsk, "com."),
   224	                (D, T_DNSKEY, [self.w_ksk.rdata, self.w_zsk.rdata], 3600, self.w_ksk, D),
   225	                ("_tessera-v1." + D, T_TXT, [txt_rdata(self.value)], 300, self.w_zsk, D)]
   226	        return [(o, t, rds, ttl, rrsig(o, t, rds, ttl, k, s, inc, exp)) for o, t, rds, ttl, k, s in plan]
   227	
   228	    def capture(self, now):
   229	        self.captures += 1
   230	        body = b""
   231	        for owner, t, rds, ttl, sig in self.groups(now):
   232	            ow = name_wire(owner)
   233	            for r in sorted(rds):
   234	                body += ow + struct.pack(">HHIH", t, 1, ttl, len(r)) + r
   235	            body += ow + struct.pack(">HHIH", T_RRSIG, 1, ttl, len(sig)) + sig
   236	        return body
   237	
   238	    def serve(self, clock):
   239	        """A resolver transport for dns.LiveDns: answers with the owner name compressed to the question."""
   240	        def t(query):
   241	            groups = {(o.rstrip(".") or ".", t): (rds, ttl, sig) for o, t, rds, ttl, sig in self.groups(clock())}
   242	            qid = query[:2]
   243	            i, labels = 12, []
   244	            while query[i]:
   245	                labels.append(query[i + 1:i + 1 + query[i]].decode())
   246	                i += 1 + query[i]
   247	            qtype = struct.unpack(">H", query[i + 1:i + 3])[0]
   248	            qname = ".".join(labels) or "."
   249	            question = query[12:i + 5]
   250	            rds, ttl, sig = groups[(qname, qtype)]
   251	            answers = [(qtype, r) for r in rds] + [(T_RRSIG, sig)]
   252	            msg = qid + struct.pack(">HHHHH", 0x8180, 1, len(answers), 0, 0) + question
   253	            for rt, rd in answers:
   254	                msg += b"\xc0\x0c" + struct.pack(">HHIH", rt, 1, ttl, len(rd)) + rd
   255	            return msg
   256	        return t
   257	
   258	    def root_entries(self, start):
   259	        out = []
   260	        for name, k in (("TEST-ROOT-KSK (stand-in)", self.root_ksk),):
   261	            rd = k.rdata
   262	            out.append({"algorithm": "13", "dnskey_rdata": b64e(rd), "ds_sha256": sha256hex(b"\x00" + rd),
   263	                        "key_tag": str(k.tag), "name": name, "publication": None, "reliance_lifetime_s": "1814400",
   264	                        "revocation": None, "signing_end": None, "signing_start": start,
   265	                        "sources": [{"description": "TEST stand-in root KSK; not a real DNS key",
   266	                                     "sha256": sha256hex(rd), "uri": "test:stand-in-root-ksk"}]})
   267	        return out
