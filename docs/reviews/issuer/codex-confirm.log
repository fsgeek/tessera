   164	# ------------------------------------------------------------------------------------------------ DNS
   165	def key_tag(rdata):
   166	    ac = 0
   167	    for i, b in enumerate(rdata):
   168	        ac += b if i & 1 else b << 8
   169	    ac += (ac >> 16) & 0xFFFF
   170	    return ac & 0xFFFF
