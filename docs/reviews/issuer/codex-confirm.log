   295	# ------------------------------------------------------------------------------------------------ world
   296	class World:
   297	    """Every stand-in a local issuer needs, on one clock."""
   298	
   299	    def __init__(self, clock, seed="stand-in"):
   300	        self.clock, self.seed = clock, seed
   301	        self.chain = StandInChain(clock)
   302	        self.calendar = StandInCalendar(self.chain)
   303	        self.kms_key = MLDSA65Key(f"{seed}:kms")
   304	        self.gpg_key = P256Key(f"{seed}:gpg", created=clock() - 30 * DAY)
   305	        self.repo_key = P256Key(f"{seed}:repository", created=clock() - 30 * DAY)
   306	        self.dns = None
   307	        self.window = None
   308	
   309	    def prepare_window(self, not_before, not_after):
   310	        """The operator's window preparation, with stand-ins: assertion value, signed commit, its stamp taken to
   311	        k = 6, the DNS record published. -> Window."""
   312	        value = assertion_value(self.kms_key.fp_kms, self.gpg_key.fp_gpg, not_before, not_after)
   313	        commit, trees, blob = signed_commit(value, self.repo_key, self.clock() - HOUR)
   314	        stamp_input = (git_id("commit", commit).hex() + "\n").encode()
   315	        proof = ots.stamp(sha256(stamp_input), [self.calendar], drbg("git-nonce:" + self.seed, 16))
   316	        for _ in range(6):
   317	            self.clock.advance(600)
   318	            self.chain.mine(1)
   319	        proof, _ = ots.upgrade(proof, [self.calendar])
   320	        self.dns = StandInDns(value, self.seed)
   321	        start = rfc3339(self.clock() - 60 * DAY)
   322	        trust_base = {"root_ksks": self.dns.root_entries(start),
   323	                      "repository_keys": [{"domain": "wamason.com", "key": b64e(self.repo_key.pgp_body),
   324	                                           "signing_end": None, "signing_start": start,
   325	                                           "sources": [{"description": "TEST stand-in repository key",
   326	                                                        "sha256": sha256hex(self.repo_key.pgp_body),
   327	                                                        "uri": "test:stand-in-repository-key"}]}]}
   328	        self.window = Window(not_before, not_after, self.kms_key.spki, self.gpg_key.pgp_body, value,
   329	                             {"commit": commit, "trees": trees, "blob": blob, "ots": proof}, trust_base).check()
   330	        return self.window
