   271	def git_id(kind, body):
   272	    return hashlib.sha1(f"{kind} {len(body)}".encode() + b"\x00" + body).digest()
   273	
   274	
   275	def tree(entries):
   276	    es = sorted(entries, key=lambda e: e[1].encode() + (b"/" if e[0] == "40000" else b""))
   277	    return b"".join(m.encode() + b" " + n.encode() + b"\x00" + oid for m, n, oid in es)
