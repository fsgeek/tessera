    96	class StandInSigner:
    97	    """A local policy signer with a TEST key. Policy as the deployed slot-2 signer: tag must be attest or manifest;
    98	    an attestation must name this slot's key; the gpg slot refuses a declared_issue_time more than epsilon from
    99	    its clock (A9:401-405). `process()` handles what is queued now; tests call it (or not) to model a signer that
   100	    is slow, down or late."""
   101	
   102	    def __init__(self, slot, key, requests, responses, clock, sign_until=None, fetch=None):
   103	        self.slot, self.key, self.requests, self.responses, self.clock = slot, key, requests, responses, clock
   104	        self.sign_until = sign_until           # IS-03: the window's signing stop, configured at the signer
   105	        self.fetch = fetch                     # IS-09: frame reference -> bytes or None
   106	        self.key_bytes = key.spki if slot == "kms" else key.pgp_body
   107	        self.fp = key.fp_kms if slot == "kms" else key.fp_gpg
   108	        self.signed = []                       # (request_id, frame sha256, signature sha256)
   109	
   110	    def _refuse(self, rid, reason, detail=""):
   111	        return {"request_id": rid, "status": "REFUSED", "reason": reason, "detail": detail,
   112	                "signer": {"clock": rfc3339(self.clock()), "slot": self.slot}}
   113	
   114	    def handle(self, req):
   115	        rid = req.get("request_id")
   116	        try:
   117	            if "frame_ref" in req:
   118	                if self.fetch is None:
   119	                    return self._refuse(rid, "FRAME_UNAVAILABLE")
   120	                frame = self.fetch(req["frame_ref"])
   121	                if frame is None:
   122	                    return self._refuse(rid, "FRAME_UNAVAILABLE")
   123	                if sha256hex(frame) != req["frame_sha256"]:
   124	                    return self._refuse(rid, "FRAME_DIGEST_MISMATCH")
   125	            else:
   126	                frame = b64d(req["frame_b64"])
   127	            sign_by = ts(req["sign_by"]) if "sign_by" in req else None
   128	        except (KeyError, ValueError, TypeError):
   129	            return self._refuse(rid, "BAD_REQUEST")
   130	        try:
   131	            obj = read_frame(frame, "tessera-v1/attest")
   132	            if obj["signer"]["key_fp"] != self.fp:
   133	                return self._refuse(rid, "KEY_FP_MISMATCH")
   134	            if self.slot == "gpg" and abs(ts(obj["common"]["declared_issue_time"]) - self.clock()) > EPS:
   135	                return self._refuse(rid, "DECLARED_TIME_OUTSIDE_EPSILON")
   136	        except Fault:
   137	            try:
   138	                read_frame(frame, "tessera-v1/manifest")
   139	            except Fault as e:
   140	                return self._refuse(rid, e.code)
   141	        now = self.clock()                     # IS-03: checked immediately before the signing operation
   142	        if (self.sign_until is not None and now > self.sign_until) or (sign_by is not None and now > sign_by):
   143	            return self._refuse(rid, "SIGNING_STOPPED")
   144	        if self.slot == "kms":
   145	            sig = self.key.sign(frame)
   146	        else:
   147	            from .testkeys import pgp_sign
   148	            sig = pgp_sign(frame, self.key, self.clock())
   149	        self.signed.append((rid, sha256hex(frame), sha256hex(sig)))
   150	        return {"request_id": rid, "status": "SIGNED", "sig_b64": b64e(sig),
   151	                "signer": {"clock": rfc3339(self.clock()), "slot": self.slot}}
   152	
   153	    def process(self, limit=None):
   154	        n = 0
   155	        while limit is None or n < limit:
   156	            msgs = self.requests.receive(1)
   157	            if not msgs:
   158	                break
   159	            m = msgs[0]
   160	            try:
   161	                req = json.loads(m.body)
   162	            except ValueError:
   163	                req = {}
   164	            self.responses.send(json.dumps(self.handle(req), sort_keys=True))
   165	            self.requests.delete(m.handle)
   166	            n += 1
   167	        return n
