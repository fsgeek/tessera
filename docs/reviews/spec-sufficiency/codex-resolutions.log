    def __init__(self, s):
        self.s, self.i = s, 0

    def ws(self):
        while self.i < len(self.s) and self.s[self.i] in WS:
            self.i += 1

    def fail(self, why):
        raise Bad("JSON_SYNTAX", f"{why} at {self.i}")

    def peek(self):
        return self.s[self.i] if self.i < len(self.s) else ""

    def document(self):
        self.ws()
        v = self.value()
        self.ws()
        if self.i != len(self.s):
            self.fail("text after the value")
        return v

