@@ -0,0 +1,104 @@
+"""Locally constructed falsification probes; no project fixtures or code read."""
+import datetime as dt
+import hashlib
+import unittest
+
+import verifier as v
+
+
+def wrap(tag, body):
+    return bytes([len(tag)]) + tag + b"\x00\x01" + len(body).to_bytes(4, "big") + body
+
+
+def frame(tag, value):
+    return wrap(tag, v.jcs_without_numbers(value))
+
+
+def objects(alg=v.CLASSICAL, sig=None):
+    manifest = {"alg": alg, "issuer": "wamason.com", "key_fp": "spki-sha256:" + "a" * 64,
+                "sset": ["gpg-sha256:" + "b" * 64], "ver": "map-v1"}
+    m = frame(v.MANIFEST, manifest)
+    common = {"alg": alg, "binding_forms": ["STMT_DIRECT"], "content": "probe only",
+              "declared_issue_time": "2026-10-13T00:00:00Z", "issuer": "wamason.com",
+              "manifest_sha256": hashlib.sha256(m).hexdigest(), "preamble_sha256": "c" * 64,
+              "profile": v.PROFILE, "spec": {"id": v.PROFILE + "/verification-spec/1", "sha256": "d" * 64},
+              "vectors_sha256": "e" * 64}
+    frames = [frame(v.ATTEST, {"common": common, "signer": {"key_fp": fp}})
+              for fp in (manifest["key_fp"], manifest["sset"][0])]
+    # MPI r=s=1 is merely structural: no mathematical signature claim.
+    if sig is None:
+        body = bytes.fromhex("04001308000000000000000101000101")
+        sig = bytes([0x88, len(body)]) + body
+    a = bytes([len(v.ANCHOR)]) + v.ANCHOR + b"\x02"
+    for f in frames:
+        a += len(f).to_bytes(4, "big") + f + len(sig).to_bytes(4, "big") + sig
+    return m, a
+
+
+class ProbeTests(unittest.TestCase):
+    def rejects(self, reason, func, *args):
+        with self.assertRaises(v.Reject) as caught:
+            func(*args)
+        self.assertEqual(str(caught.exception), reason)
+
+    def test_structural_receipt_and_swap(self):
+        m, a = objects()
+        slots = v.anchor(a)
+        self.assertEqual(v.receipt_consistency(m, slots)["issuer"], "wamason.com")
+        self.rejects("RECEIPT_SLOT", v.receipt_consistency, m, slots[::-1])
+
+    def test_no_signature_normalization(self):
+        _, a = objects()
+        _, changed = objects(sig=bytes.fromhex("881004001308000000000000000101000202"))
+        v.anchor(changed)
+        self.assertNotEqual(hashlib.sha256(a).digest(), hashlib.sha256(changed).digest())
+
+    def test_unknown_alg_is_opaque_not_valid(self):
+        m, a = objects("FUTURE", b"opaque")
+        self.assertEqual(v.receipt_consistency(m, v.anchor(a))["alg"], "FUTURE")
+        self.assertIsNone(v.report("STOPPED", "unknown algorithm")["v1_verdict"])
+
+    def test_boundaries_and_withdrawn_tag(self):
+        _, a = objects()
+        self.rejects("TRAILING", v.anchor, a + b"x")
+        self.rejects("TRUNCATED", v.anchor, a[:-1])
+        old = b"tessera-v1/receipt-anchor"
+        self.rejects("TAG_UNKNOWN", v.anchor, bytes([len(old)]) + old)
+
+    def test_payload_categories(self):
+        self.rejects("JSON_ENCODING", v.payload, b'"\xff"')
+        self.rejects("JSON_SYNTAX", v.payload, b'{"x":NaN}')
+        self.rejects("JSON_DUPLICATE_NAME", v.payload, b'{"x":null,"\\u0078":true}')
+        self.rejects("JSON_STRING", v.payload, b'"\\ud800"')
+        self.rejects("JSON_STRING", v.payload, '"e\u0301"'.encode())
+        self.rejects("JSON_NONCANONICAL", v.payload, b'{"z":true,"a":null}')
+        self.rejects("JSON_DEPTH", v.payload, b"[" * 65 + b"null" + b"]" * 65)
+        self.assertIsInstance(v.payload(b"[" * 64 + b"null" + b"]" * 64), list)
+
+    def test_number_is_a_stop_not_a_rejection(self):
+        with self.assertRaises(v.Stop):
+            v.payload(b"9.8")
+
+    def test_subpacket_encoding_is_a_stop(self):
+        body = bytes.fromhex("040013080002010000000000000101000101")
+        with self.assertRaises(v.Stop) as caught:
+            v.signature(bytes([0x88, len(body)]) + body, v.CLASSICAL)
+        self.assertEqual(str(caught.exception), "OPENPGP_SUBPACKET_LENGTH_ENCODING_REQUIRED")
+
+    def test_utf16_order(self):
+        value = {"\ue000": None, "\U0001f600": True}
+        raw = '{"\U0001f600":true,"\ue000":null}'.encode()
+        self.assertEqual(v.jcs_without_numbers(value), raw)
+        self.assertEqual(v.payload(raw), value)
+
+    def test_window_inclusive_and_no_T_lower_bound(self):
+        before, after = "2026-10-13T00:00:00Z", "2027-01-11T00:00:00Z"
+        v.issuance_window(before, after, before, v.utc(after))
+        v.issuance_window(before, after, before, v.utc(before) - dt.timedelta(seconds=1))
+        self.rejects("ISSUANCE_WINDOW", v.issuance_window, before, after, before,
+                     v.utc(after) + dt.timedelta(seconds=1))
+        self.rejects("DNS_WINDOW_LENGTH", v.issuance_window, before, "2027-01-11T00:00:01Z", before, v.utc(before))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/docs/reviews/spec-sufficiency/indep-verifier/verifier.py b/docs/reviews/spec-sufficiency/indep-verifier/verifier.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d03924589356df5b63e98e1229ee607644715f9
--- /dev/null
+++ b/docs/reviews/spec-sufficiency/indep-verifier/verifier.py
@@ -0,0 +1,331 @@
+"""Throwaway spec-sufficiency probe, not a conforming V1 verifier.
+
+Only the four documents named in GAPS.md supplied protocol requirements.
+The CLI consumes raw objects, NOT an invented Tessera bundle container.
+No path through this program returns VALID_STRICT.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import hashlib
+import json
+import re
+import unicodedata
+from dataclasses import dataclass
+from pathlib import Path
+
+PROFILE = "tessera-v1-strict"
+CLASSICAL = "OPENPGP4-ECDSA-P256-SHA256"
+ATTEST = b"tessera-v1/attest"
+MANIFEST = b"tessera-v1/manifest"
+ANCHOR = b"tessera-v1/receipt-anchor-sig"
+SNAPSHOT = b"tessera-v1/dnssec-snapshot"
+TAGS = {ATTEST, MANIFEST, ANCHOR, SNAPSHOT}
+CAP = 1 << 24
+HEX = r"[0-9a-f]{64}"
+ALG = r"[A-Z0-9][A-Z0-9-]{0,63}"
+FP = r"(?:spki|gpg)-sha256:" + HEX
+
+
+class Reject(Exception):
+    """A specified failure in the implemented portion of the codec."""
+
+
+class Stop(Exception):
+    """Probe limitation or spec gap; never silently converted to a V1 verdict."""
+
+
+class Pairs(list):
+    """Preserve duplicate object members until their rejection category."""
+
+
+@dataclass(frozen=True)
+class Number:
+    literal: str
+
+
+def require(condition, reason):
+    if not condition:
+        raise Reject(reason)
+
+
+def matches(pattern, value):
+    return isinstance(value, str) and re.fullmatch(pattern, value) is not None
+
+
+def utc(value):
+    require(matches(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", value), "SCHEMA")
+    try:
+        # Deliberate year choice: Gregorian years 0001..9999 (GAPS G18).
+        return dt.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
+    except ValueError:
+        raise Reject("SCHEMA") from None
+
+
+def domain(value):
+    if not isinstance(value, str) or len(value) > 241:
+        return False
+    labels = value.split(".")
+    return len(labels) >= 2 and all(matches(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", x) for x in labels)
+
+
+def closed(value, names):
+    require(isinstance(value, dict) and set(value) == set(names.split()), "SCHEMA")
+
+
+def jcs_without_numbers(value):
+    """Exact E §1.3 serialization for the implemented, number-free domain."""
+    if value is None:
+        return b"null"
+    if value is True:
+        return b"true"
+    if value is False:
+        return b"false"
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+    if isinstance(value, list):
+        return b"[" + b",".join(jcs_without_numbers(x) for x in value) + b"]"
+    if isinstance(value, dict):
+        keys = sorted(value, key=lambda k: k.encode("utf-16-be"))
+        return b"{" + b",".join(jcs_without_numbers(k) + b":" + jcs_without_numbers(value[k]) for k in keys) + b"}"
+    raise Stop("NUMBER_FORMATTING_NOT_IMPLEMENTED")
+
+
+def payload(raw):
+    require(len(raw) <= CAP, "LENGTH_CAP")
+    try:
+        text = raw.decode("utf-8", errors="strict")
+    except UnicodeDecodeError:
+        raise Reject("JSON_ENCODING") from None
+    try:
+        value = json.loads(text, object_pairs_hook=Pairs, parse_int=Number, parse_float=Number,
+                           parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
+    except (ValueError, RecursionError):
+        # Python's own recursion ceiling is not a protocol JSON_DEPTH decision.
+        if len(text) > 0 and text.count("[") + text.count("{") > 900:
+            raise Stop("PARSER_RECURSION_LIMIT") from None
+        raise Reject("JSON_SYNTAX") from None
+
+    objects, strings, numbers = [], [], []
+    max_depth = 0
+    stack = [(value, 0)]
+    while stack:
+        item, depth = stack.pop()
+        if isinstance(item, Pairs):
+            max_depth = max(max_depth, depth + 1)
+            objects.append(item)
+            for key, child in item:
+                strings.append(key)
+                stack.append((child, depth + 1))
+        elif isinstance(item, list):
+            max_depth = max(max_depth, depth + 1)
+            stack.extend((child, depth + 1) for child in item)
+        elif isinstance(item, str):
+            strings.append(item)
+        elif isinstance(item, Number):
+            numbers.append(item)
+    require(max_depth <= 64, "JSON_DEPTH")
+    require(all(len({k for k, _ in obj}) == len(obj) for obj in objects), "JSON_DUPLICATE_NAME")
+    if unicodedata.unidata_version != "16.0.0":
+        raise Stop("UNICODE_16_TABLES_REQUIRED")
+    for string in strings:
+        require(all(not (0xD800 <= ord(c) <= 0xDFFF or 0xFDD0 <= ord(c) <= 0xFDEF
+                         or ord(c) & 0xFFFF in (0xFFFE, 0xFFFF)
+                         or unicodedata.category(c) == "Cn") for c in string), "JSON_STRING")
+        require(unicodedata.normalize("NFC", string) == string, "JSON_STRING")
+    if numbers:
+        # ES(d) is specified, but not reproduced in these documents. Do not use
+        # Python repr as an unexamined replacement or reject valid numbers.
+        raise Stop("NUMBER_FORMATTING_NOT_IMPLEMENTED")
+
+    def unpack(item):
+        if isinstance(item, Pairs):
+            return {k: unpack(v) for k, v in item}
+        if isinstance(item, list):
+            return [unpack(v) for v in item]
+        return item
+
+    value = unpack(value)
+    require(jcs_without_numbers(value) == raw, "JSON_NONCANONICAL")
+    return value
+
+
+def schema(value, tag):
+    if tag == MANIFEST:
+        closed(value, "alg issuer key_fp sset ver")
+        require(matches(ALG, value["alg"]) and domain(value["issuer"]), "SCHEMA")
+        require(matches(r"spki-sha256:" + HEX, value["key_fp"]), "SCHEMA")
+        require(isinstance(value["sset"], list) and len(value["sset"]) == 1
+                and matches(r"gpg-sha256:" + HEX, value["sset"][0]), "SCHEMA")
+        require(value["ver"] == "map-v1", "SCHEMA")
+        return
+    closed(value, "common signer")
+    common = value["common"]
+    closed(common, "alg binding_forms content declared_issue_time issuer manifest_sha256 preamble_sha256 profile spec vectors_sha256")
+    closed(value["signer"], "key_fp")
+    closed(common["spec"], "id sha256")
+    require(matches(ALG, common["alg"]) and domain(common["issuer"]), "SCHEMA")
+    forms = common["binding_forms"]
+    require(isinstance(forms, list) and bool(forms)
+            and all(matches(r"[A-Z][A-Z0-9_]{0,31}", f) for f in forms), "SCHEMA")
+    require(forms == sorted(set(forms)), "SCHEMA")
+    utc(common["declared_issue_time"])
+    require(common["profile"] == PROFILE, "SCHEMA")
+    require(all(matches(HEX, common[k]) for k in ("manifest_sha256", "preamble_sha256", "vectors_sha256")), "SCHEMA")
+    require(matches(r"[a-z0-9][a-z0-9._/-]{0,127}", common["spec"]["id"])
+            and matches(HEX, common["spec"]["sha256"]), "SCHEMA")
+    require(matches(FP, value["signer"]["key_fp"]), "SCHEMA")
+
+
+class Reader:
+    def __init__(self, data):
+        self.data, self.offset = data, 0
+
+    def take(self, size):
+        require(self.offset + size <= len(self.data), "TRUNCATED")
+        result = self.data[self.offset:self.offset + size]
+        self.offset += size
+        return result
+
+    def integer(self, width):
+        return int.from_bytes(self.take(width), "big")
+
+    def header(self, expected):
+        tag = self.take(self.integer(1))
+        require(tag in TAGS, "TAG_UNKNOWN")
+        require(tag == expected, "TAG_MISMATCH")
+
+    def finish(self):
+        require(self.offset == len(self.data), "TRAILING")
+
+
+def frame(raw, tag):
+    reader = Reader(raw)
+    reader.header(tag)
+    require(reader.integer(2) == 1, "CV_UNKNOWN")
+    size = reader.integer(4)
+    require(size <= CAP, "LENGTH_CAP")
+    data = reader.take(size)
+    reader.finish()
+    value = payload(data)
+    schema(value, tag)
+    return value
+
+
+def signature(raw, alg):
+    require(bool(raw), "SIG_EMPTY")
+    require(len(raw) <= (1024 if alg == CLASSICAL else 65536), "LENGTH_CAP")
+    if alg != CLASSICAL:
+        return None  # Explicitly opaque, never a signature verification success.
+    reader = Reader(raw)
+    kind = reader.integer(1)
+    require(kind in (0x88, 0x89), "SIG_PACKET")
+    size = reader.integer(1 if kind == 0x88 else 2)
+    require((kind == 0x88 and size <= 255) or (kind == 0x89 and 256 <= size <= 1021), "SIG_PACKET")
+    body = reader.take(size)
+    reader.finish()
+    inner = Reader(body)
+    try:
+        require(inner.take(4) == b"\x04\x00\x13\x08", "SIG_FORMAT")
+        hashed = inner.take(inner.integer(2))
+        unhashed = inner.take(inner.integer(2))
+        prefix = inner.take(2)
+        scalars = []
+        for _ in range(2):
+            bits = inner.integer(2)
+            require(1 <= bits <= 256, "SIG_FORMAT")
+            scalar = int.from_bytes(inner.take((bits + 7) // 8), "big")
+            require(scalar.bit_length() == bits, "SIG_FORMAT")
+            scalars.append(scalar)
+        inner.finish()
+    except Reject:
+        raise Reject("SIG_FORMAT") from None
+    if hashed or unhashed:
+        # E 464 specifies shortest subpacket lengths but not their wire encoding.
+        raise Stop("OPENPGP_SUBPACKET_LENGTH_ENCODING_REQUIRED")
+    return {"hashed": hashed, "unhashed": unhashed, "digest_prefix": prefix, "r": scalars[0], "s": scalars[1]}
+
+
+def anchor(raw):
+    reader = Reader(raw)
+    reader.header(ANCHOR)
+    require(reader.integer(1) == 2, "ANCHOR_COUNT")
+    result = []
+    for _ in range(2):
+        size = reader.integer(4)
+        require(size <= CAP + 64, "LENGTH_CAP")
+        f = reader.take(size)
+        parsed = frame(f, ATTEST)
+        alg = parsed["common"]["alg"]
+        size = reader.integer(4)
+        require(size != 0, "SIG_EMPTY")
+        require(size <= (1024 if alg == CLASSICAL else 65536), "LENGTH_CAP")
+        sig = reader.take(size)
+        signature(sig, alg)
+        result.append((f, parsed, sig))
+    reader.finish()
+    return result
+
+
+def receipt_consistency(manifest_raw, slots):
+    manifest = frame(manifest_raw, MANIFEST)
+    common = slots[0][1]["common"]
+    require(jcs_without_numbers(common) == jcs_without_numbers(slots[1][1]["common"]), "RECEIPT_COMMON_MISMATCH")
+    for slot, fp in zip(slots, (manifest["key_fp"], manifest["sset"][0])):
+        require(slot[1]["signer"]["key_fp"] == fp, "RECEIPT_SLOT")
+    # The conditions are explicit in PROOF 83; the reason label is local.
+    require(common["manifest_sha256"] == hashlib.sha256(manifest_raw).hexdigest()
+            and common["issuer"] == manifest["issuer"] and common["alg"] == manifest["alg"], "PROBE_MANIFEST_BINDING")
+    return common
+
+
+def snapshot(raw):
+    reader = Reader(raw)
+    reader.header(SNAPSHOT)
+    size = reader.integer(4)
+    require(1 <= size <= CAP, "LENGTH_CAP")  # zero-size reason is chosen; GAPS G30
+    body = reader.take(size)
+    reader.finish()
+    return body
+
+
+def issuance_window(not_before, not_after, declared, verified_time):
+    """Only call with authenticated evidence, not untrusted bundle assertions."""
+    before, after = utc(not_before), utc(not_after)
+    require(after > before, "DNS_WINDOW")
+    require((after - before).total_seconds() <= 7776000, "DNS_WINDOW_LENGTH")
+    require(utc(declared) >= before and verified_time <= after, "ISSUANCE_WINDOW")
+
+
+def report(status, reason, **extra):
+    return {"probe_status": status, "probe_reason": reason, "v1_verdict": None,
+            "T": None, "revocation": "NOT_EVALUATED", "historical_security": "NOT_EVALUATED",
+            "standing": "ABSENT/NOT_ISSUED_IN_PROFILE", **extra}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--anchor", type=Path, required=True, help="raw A_sig, not a bundle")
+    parser.add_argument("--manifest", type=Path, required=True, help="raw F_manifest")
+    args = parser.parse_args()
+    try:
+        raw = args.anchor.read_bytes()
+        slots = anchor(raw)
+        common = receipt_consistency(args.manifest.read_bytes(), slots)
+        result = report("STOPPED", "FULL_VERIFIER_SPEC_GAPS", anchor_sha256=hashlib.sha256(raw).hexdigest(),
+                        common_alg=common["alg"], structural_checks="passed implemented subset",
+                        next_required=["bundle container", "public keys and possession proofs",
+                                       "registered binding forms", "OTS and confirmation rules",
+                                       "DNSSEC snapshot body", "distributed authenticated trust configuration"])
+    except Reject as failure:
+        result = report("REJECTED_SUBSET", str(failure))
+    except Stop as failure:
+        result = report("STOPPED", str(failure))
+    except OSError as failure:
+        result = report("INPUT_ERROR", str(failure))
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()

diff --git a/docs/reviews/spec-sufficiency/indep-verifier/README.md b/docs/reviews/spec-sufficiency/indep-verifier/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..a27f9ed78dd31d61ca454d9bb45478222a062c5f
--- /dev/null
+++ b/docs/reviews/spec-sufficiency/indep-verifier/README.md
@@ -0,0 +1,51 @@
+# Independent verifier probe (throwaway)
+
+This is a spec-sufficiency instrument, not service code or conformance evidence.
+Requirements came only from the four files listed in ../GAPS.md. No existing
+implementation, project vectors, prototype or formal suite was consulted.
+
+Design: parse raw tagged objects; validate the implemented payload domain and
+closed schemas; recover the exact ordered frame/signature tuple; check its
+manifest bindings; stop before unsupported or unspecified checks. No execution
+returns `VALID_STRICT`. Probe statuses and local reason labels are explicitly
+separate from V1 verdicts. Even `REJECTED_SUBSET` is not an aggregate V1 verdict:
+dispatch and global precedence have not been implemented.
+
+Implemented: frame/anchor boundaries and limits; UTF-8, JSON syntax, depth,
+duplicate names, Unicode 16 assignedness/NFC and number-free canonical bytes;
+manifest and attestation schemas; common-byte equality and slot binding; rule O
+packet header, body boundaries and MPIs; opaque unknown-algorithm slots; snapshot
+envelope; the isolated inclusive issuance-window predicate.
+
+Stops: numbers need exact ECMAScript serialization, not an unchecked Python
+formatter; nonempty OpenPGP subpacket areas need a length encoding not reproduced
+in the allowed sources. Raw-key parsing, mathematical signature verification,
+possession proofs, dependency objects, DNSSEC, git paths, OTS, header histories,
+dispatch and verdict aggregation are not implemented. `cryptography` is not
+installed in the probe environment; nothing was installed. The Unicode runtime
+must report 16.0.0 or the payload check stops. A recursive JSON parser can hit its
+own limit before the specified category scan; that is a probe limitation, not a
+protocol rejection. See GAPS.md for protocol questions, including what external
+standards references do and do not supply.
+
+Run locally constructed probes (no project fixtures):
+
+```sh
+PYTHONDONTWRITEBYTECODE=1 python3 docs/reviews/spec-sufficiency/indep-verifier/selftest.py
+```
+
+Inspect raw objects supplied by the caller:
+
+```sh
+PYTHONDONTWRITEBYTECODE=1 python3 docs/reviews/spec-sufficiency/indep-verifier/verifier.py \
+  --anchor /path/to/raw-A_sig --manifest /path/to/raw-F_manifest
+```
+
+This raw-file API is a probe interface, not a proposed bundle container. A
+structurally passing object produces `STOPPED`, with `v1_verdict: null` and
+`T: null`. It establishes neither signature validity nor authority nor time.
+
+The probes exercise boundary failures, duplicate-name and normalization traps,
+UTF-16 member order, swapped slots, changed committed signatures, unknown
+algorithms, explicit stopping points and window boundaries. They are not the
+registered conformance suite, and a pass establishes only those local checks.
diff --git a/docs/reviews/spec-sufficiency/indep-verifier/selftest.py b/docs/reviews/spec-sufficiency/indep-verifier/selftest.py
new file mode 100644
index 0000000000000000000000000000000000000000..63d94d3cbcbbf4b780811076641a612fe2197eb2
--- /dev/null
+++ b/docs/reviews/spec-sufficiency/indep-verifier/selftest.py
@@ -0,0 +1,104 @@
+"""Locally constructed falsification probes; no project fixtures or code read."""
+import datetime as dt
+import hashlib
+import unittest
+
+import verifier as v
+
+
+def wrap(tag, body):
+    return bytes([len(tag)]) + tag + b"\x00\x01" + len(body).to_bytes(4, "big") + body
+
+
+def frame(tag, value):
+    return wrap(tag, v.jcs_without_numbers(value))
+
+
+def objects(alg=v.CLASSICAL, sig=None):
+    manifest = {"alg": alg, "issuer": "wamason.com", "key_fp": "spki-sha256:" + "a" * 64,
+                "sset": ["gpg-sha256:" + "b" * 64], "ver": "map-v1"}
+    m = frame(v.MANIFEST, manifest)
+    common = {"alg": alg, "binding_forms": ["STMT_DIRECT"], "content": "probe only",
+              "declared_issue_time": "2026-10-13T00:00:00Z", "issuer": "wamason.com",
+              "manifest_sha256": hashlib.sha256(m).hexdigest(), "preamble_sha256": "c" * 64,
+              "profile": v.PROFILE, "spec": {"id": v.PROFILE + "/verification-spec/1", "sha256": "d" * 64},
+              "vectors_sha256": "e" * 64}
+    frames = [frame(v.ATTEST, {"common": common, "signer": {"key_fp": fp}})
+              for fp in (manifest["key_fp"], manifest["sset"][0])]
+    # MPI r=s=1 is merely structural: no mathematical signature claim.
+    if sig is None:
+        body = bytes.fromhex("04001308000000000000000101000101")
+        sig = bytes([0x88, len(body)]) + body
+    a = bytes([len(v.ANCHOR)]) + v.ANCHOR + b"\x02"
+    for f in frames:
+        a += len(f).to_bytes(4, "big") + f + len(sig).to_bytes(4, "big") + sig
+    return m, a
+
+
+class ProbeTests(unittest.TestCase):
+    def rejects(self, reason, func, *args):
+        with self.assertRaises(v.Reject) as caught:
+            func(*args)
+        self.assertEqual(str(caught.exception), reason)
+
+    def test_structural_receipt_and_swap(self):
+        m, a = objects()
+        slots = v.anchor(a)
+        self.assertEqual(v.receipt_consistency(m, slots)["issuer"], "wamason.com")
+        self.rejects("RECEIPT_SLOT", v.receipt_consistency, m, slots[::-1])
+
+    def test_no_signature_normalization(self):
+        _, a = objects()
+        _, changed = objects(sig=bytes.fromhex("881004001308000000000000000101000202"))
+        v.anchor(changed)
+        self.assertNotEqual(hashlib.sha256(a).digest(), hashlib.sha256(changed).digest())
+
+    def test_unknown_alg_is_opaque_not_valid(self):
+        m, a = objects("FUTURE", b"opaque")
+        self.assertEqual(v.receipt_consistency(m, v.anchor(a))["alg"], "FUTURE")
+        self.assertIsNone(v.report("STOPPED", "unknown algorithm")["v1_verdict"])
+
+    def test_boundaries_and_withdrawn_tag(self):
+        _, a = objects()
+        self.rejects("TRAILING", v.anchor, a + b"x")
+        self.rejects("TRUNCATED", v.anchor, a[:-1])
+        old = b"tessera-v1/receipt-anchor"
+        self.rejects("TAG_UNKNOWN", v.anchor, bytes([len(old)]) + old)
+
+    def test_payload_categories(self):
+        self.rejects("JSON_ENCODING", v.payload, b'"\xff"')
+        self.rejects("JSON_SYNTAX", v.payload, b'{"x":NaN}')
+        self.rejects("JSON_DUPLICATE_NAME", v.payload, b'{"x":null,"\\u0078":true}')
+        self.rejects("JSON_STRING", v.payload, b'"\\ud800"')
+        self.rejects("JSON_STRING", v.payload, '"e\u0301"'.encode())
+        self.rejects("JSON_NONCANONICAL", v.payload, b'{"z":true,"a":null}')
+        self.rejects("JSON_DEPTH", v.payload, b"[" * 65 + b"null" + b"]" * 65)
+        self.assertIsInstance(v.payload(b"[" * 64 + b"null" + b"]" * 64), list)
+
+    def test_number_is_a_stop_not_a_rejection(self):
+        with self.assertRaises(v.Stop):
+            v.payload(b"9.8")
+
+    def test_subpacket_encoding_is_a_stop(self):
+        body = bytes.fromhex("040013080002010000000000000101000101")
+        with self.assertRaises(v.Stop) as caught:
+            v.signature(bytes([0x88, len(body)]) + body, v.CLASSICAL)
+        self.assertEqual(str(caught.exception), "OPENPGP_SUBPACKET_LENGTH_ENCODING_REQUIRED")
+
+    def test_utf16_order(self):
+        value = {"\ue000": None, "\U0001f600": True}
+        raw = '{"\U0001f600":true,"\ue000":null}'.encode()
+        self.assertEqual(v.jcs_without_numbers(value), raw)
+        self.assertEqual(v.payload(raw), value)
+
+    def test_window_inclusive_and_no_T_lower_bound(self):
+        before, after = "2026-10-13T00:00:00Z", "2027-01-11T00:00:00Z"
+        v.issuance_window(before, after, before, v.utc(after))
+        v.issuance_window(before, after, before, v.utc(before) - dt.timedelta(seconds=1))
+        self.rejects("ISSUANCE_WINDOW", v.issuance_window, before, after, before,
+                     v.utc(after) + dt.timedelta(seconds=1))
+        self.rejects("DNS_WINDOW_LENGTH", v.issuance_window, before, "2027-01-11T00:00:01Z", before, v.utc(before))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
