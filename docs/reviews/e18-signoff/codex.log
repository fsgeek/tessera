   105	
   106	vars == <<now, chain, declared, anchorH, pendingAnchor, shipped, shipAtWall>>
   107	
   108	(* Block timestamps: consensus-bounded skew around arrival time, non-    *)
   109	(* monotonicity allowed (no constraint against earlier blocks).           *)
