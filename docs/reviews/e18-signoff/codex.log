    92	       /\ MaxSkew \in Nat /\ MaxBlocks \in Nat \ {0}
    93	
    94	NoAnchor == -1
    95	NoTime   == -1
    96	
    97	VARIABLES
    98	  now,        \* wall clock (ticks; carries no block semantics here)
    99	  chain,      \* sequence of block timestamps; chain[i] = timestamp of block i
   100	  declared,   \* declared_issue_time of the single attempt (NoTime until Declare)
   101	  anchorH,    \* chain index (height) of the block containing the anchor
   102	  pendingAnchor, \* anchor submitted, waiting for the next block
   103	  shipped,    \* issuance completed under the strict rule
