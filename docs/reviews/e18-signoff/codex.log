    11	(* anchor/confirmedAt/policy. P5's issuance-protocol corollary (ship       *)
    12	(* rule, re-issue, attempt bound) remains ISSUER-side behavior, modeled    *)
    13	(* in P5c_IssuanceProtocol. Amendment 2 (A2.2) gave the corollary a        *)
    14	(* verifier-checkable face — the confirmation-timing conjunct              *)
    15	(* confirmedAt <= declared + delta — and that face lives HERE: it is the   *)
    16	(* same predicate the issuer's Ship rule evaluates (A2.1, one predicate    *)
    17	(* on one chain-visible observable, both sides), so the correspondence     *)
    18	(* between this module's acceptance and P5c's Ship is exact by             *)
    19	(* construction, not by argument.                                           *)
    20	(*                                                                          *)
    21	(* CORRECTION 2026-09-06 (cross-family falsification review, Codex          *)
    22	(* gpt-6-astra;                                                             *)
    23	(* docs/reviews/2026-09-06-codex-tla-falsification-p4-p5p6-p5c.md items 8,  *)
    24	(* 12, and Amendment 4 §A4.3; entered by the AI collaborator, PROPOSED, not *)
    25	(* adopted; the header above is left as written per amend-don't-rewrite):   *)
    26	(* - Item 12: "exact by construction, not by argument" (above) predates the *)
    27	(*   bridge model and overstates. The correspondence between this module's  *)
    28	(*   acceptance and P5c's Ship was ASSERTED in comments and checked nowhere *)
    29	(*   until P5cP5P6_Bridge.tla (2026-07-21) checked it as the invariant      *)
    30	(*   ShippedDesignatedAgree — for a shipped receipt, the designated block   *)
    31	(*   and timestamp the issuer's Ship guard evaluated are the ones the       *)
    32	(*   verifier derives from the shipped headers — with the                   *)
    33	(*   _BrokenAnchorSubst companion red (verifier reads the inclusion-block   *)
    34	(*   timestamp instead). Under P5c's single fused clock the two guards      *)
    35	(*   merely coincide; the checked join is the bridge's, and the reader is   *)
    36	(*   sent there.                                                            *)
    37	(* - Item 8: VerifierOwnsTolerances compares the accepted gaps against the  *)
    38	(*   GLOBAL maxima (DeltaMax, EpsilonMax), not against the verifier's       *)
    39	(*   chosen policy; a receipt-driven enlargement from polDelta = 0 to an    *)
    40	(*   effective 1 under DeltaMax = 3 passes it. Ownership in the policy      *)
    41	(*   sense is carried by ReceiptIndependence (verdict identical under every *)
    42	(*   receipt-tolerance pair), and the _BrokenTolStrict companion shows      *)
    43	(*   exactly that division of labour. See also the qualified comment at     *)
    44	(*   ReceiptIndependence.                                                   *)
    45	(* - Amendment 4 §A4.3: AuthorizedAtDeclared's second conjunct, revoked >   *)
    46	(*   declared, is the registered two-conjunct rule; Amendment 1's looser    *)
    47	(*   sentence "revocation effective after anchor_time does not              *)
    48	(*   retroactively change the verdict" is written by §A4.3 as "after both   *)
    49	(*   anchor_time and declared_issue_time". See the comment at               *)
    50	(*   AuthorizedAtDeclared.                                                  *)
    51	(*                                                                          *)
    52	(* Time is abstract small integers (TLC-bounded); DeltaMax and EpsilonMax  *)
    53	(* are scaled-down stand-ins for the ratified 72h/24h strict maxima — the  *)
    54	(* model checks the LOGIC of the window, not the magnitudes. Signature     *)
    55	(* checks are abstracted as passing (that face belongs to the ProVerif    *)
    56	(* models and P4); this module isolates the temporal/authorization face.   *)
    57	(*                                                                          *)
    58	(* Reading guide (Tony):                                                    *)
    59	(*   declared  - declared_issue_time, what the issuer claims (adversarial: *)
    60	(*               unconstrained; a forger declares whatever helps).          *)
    61	(*   signed    - the actual signing moment. NOT observable by the          *)
    62	(*               verifier; it exists in the model so the security          *)
    63	(*               invariant can quantify over what the verifier cannot see. *)
    64	(*   anchor    - Bitcoin block time of the OTS anchor. The one Layer 2     *)
    65	(*               fact: bytes existed not-after anchor, hence signed <=     *)
    66	(*               anchor is a model CONSTRAINT (the anchor assumption, not  *)
    67	(*               a verifier check).                                         *)
    68	(*   confirmedAt - timestamp of the block granting the k-th confirmation  *)
    69	(*               (height h+k-1; A2.1). Chain-visible to issuer and        *)
    70	(*               verifier alike. Deliberately UNCONSTRAINED relative to   *)
    71	(*               anchor: block timestamps are not monotonic (A2.1), so    *)
    72	(*               confirmedAt < anchor is a legal state and the model      *)
    73	(*               assumes no ordering.                                      *)
    74	(*   revoked   - the key's revocation time; NoRev = never. Lifecycle is    *)
    75	(*               monotonic per P6 (revocation is terminal), which is what  *)
    76	(*               lets one number represent it.                              *)
    77	(*   polDelta, polEps   - the VERIFIER's chosen tolerances; may be         *)
    78	(*               stricter than the strict maxima, never larger (A1.2 P5:   *)
    79	(*               "delta and epsilon belong to the verifier").               *)
    80	(*   rcptDelta, rcptEps - tolerances DECLARED BY THE RECEIPT, adversarial, *)
    81	(*               possibly enormous. The verifier must IGNORE these: they   *)
    82	(*               appear in the state precisely so the invariants can       *)
    83	(*               check that acceptance never depends on them. A future     *)
    84	(*               edit routing them into TemporalOK breaks                   *)
    85	(*               VerifierOwnsTolerances - see the _BrokenTol companion.    *)
    86	(* The verifier sees declared, anchor, confirmedAt, revoked, and its own   *)
    87	(* policy — never signed.                                                   *)
    88	(***************************************************************************)
    89	EXTENDS Integers
    90	
    91	CONSTANTS MaxTime, DeltaMax, EpsilonMax, RcptTolMax
    92	
    93	ASSUME DeltaMax \in Nat /\ EpsilonMax \in Nat /\ MaxTime \in Nat
    94	       /\ RcptTolMax \in Nat /\ RcptTolMax > DeltaMax  \* receipts CAN overclaim
    95	
    96	NoRev == MaxTime + 1  \* revocation never happens (sorts after all times)
    97	
    98	VARIABLES declared, signed, anchor, confirmedAt, revoked,
    99	          polDelta, polEps, rcptDelta, rcptEps
   100	
   101	(* Every combination the universe permits. The one constraint is the      *)
   102	(* anchor upper-bound assumption: the signed bytes existed when anchored.  *)
   103	(* confirmedAt carries NO constraint relative to anchor — non-monotonic   *)
   104	(* block timestamps, A2.1.                                                  *)
   105	Init ==
   106	  /\ declared  \in 0..MaxTime
   107	  /\ anchor    \in 0..MaxTime
   108	  /\ confirmedAt \in 0..MaxTime
   109	  /\ signed    \in 0..anchor         \* Layer 2: existence not-after anchor
   110	  /\ revoked   \in 0..MaxTime \cup {NoRev}
   111	  /\ polDelta  \in 0..DeltaMax       \* verifier may choose stricter, never larger
   112	  /\ polEps    \in 0..EpsilonMax
   113	  /\ rcptDelta \in 0..RcptTolMax     \* adversarial receipt claims, incl. oversized
   114	  /\ rcptEps   \in 0..RcptTolMax
   115	
   116	Next == UNCHANGED <<declared, signed, anchor, confirmedAt, revoked,
   117	                    polDelta, polEps, rcptDelta, rcptEps>>
   118	
   119	(***************************************************************************)
   120	(* The verifier's temporal/authorization checks — over observables only,  *)
   121	(* and over the VERIFIER'S tolerances only. The computation is written    *)
   122	(* with the receipt tolerances as EXPLICIT ARGUMENTS it deliberately      *)
   123	(* ignores: ReceiptIndependence below quantifies over all argument values *)
   124	(* and pins the ignoring. Any future edit that routes receipt tolerances  *)
   125	(* into the window — enlarging (see _BrokenTol) or, subtler,              *)
   126	(* narrowing (see _BrokenTolStrict: issuer-controlled verdict             *)
   127	(* manipulation that every pure safety invariant misses) — breaks it.     *)
   128	(***************************************************************************)
   129	
   130	(* P5: two-sided consistency under the verifier's policy, plus the A2.2   *)
   131	(* confirmation-timing conjunct (third line) — the verifier-checkable     *)
   132	(* face of the issuance corollary, on the verifier's OWN delta. rd/re are *)
   133	(* the receipt-declared tolerances — unused by design; the signature      *)
   134	(* exists so independence is checkable.                                     *)
   135	TemporalOKWith(rd, re) ==
   136	  /\ anchor >= declared - polEps
   137	  /\ anchor <= declared + polDelta
   138	  /\ confirmedAt <= declared + polDelta   \* A2.2: k-th confirmation in-window
   139	
   140	TemporalOK == TemporalOKWith(rcptDelta, rcptEps)
   141	
   142	(* P6: authorization throughout the uncertainty window —                  *)
   143	(*   key_authorized(declared)  i.e. revocation, if any, is after declared *)
   144	(*   AND no revocation effective at or before anchor.                     *)
   145	(* Note both conjuncts are needed: with polEps > 0 the anchor may precede *)
   146	(* declared, so revoked > anchor does not imply revoked > declared.        *)
   147	AuthorizedThroughWindow ==
   148	  /\ revoked > declared
   149	  /\ revoked > anchor
   150	
   151	(* The strict-path temporal verdict (this module's face of VALID_STRICT). *)
   152	StrictAcceptWith(rd, re) == TemporalOKWith(rd, re) /\ AuthorizedThroughWindow
   153	
   154	StrictAccept == StrictAcceptWith(rcptDelta, rcptEps)
   155	
   156	(***************************************************************************)
   157	(* Invariants.                                                              *)
   158	(***************************************************************************)
   159	
   160	(* THE P6 SECURITY THEOREM (the round-2 attack, defeated): bytes signed   *)
   161	(* at or after revocation are never strict-accepted — even though the     *)
   162	(* verifier cannot observe the signing time, and under EVERY verifier     *)
   163	(* policy choice. The proof shape: signed <= anchor (Layer 2), so revoked *)
   164	(* <= signed forces revoked <= anchor, which AuthorizedThroughWindow      *)
   165	(* rejects. TLC checks it exhaustively.                                     *)
   166	ForgeryRejected ==
   167	  (revoked <= signed) => ~StrictAccept
   168	
   169	(* P5, restated over acceptance: no strict-accepted receipt sits outside  *)
   170	(* the verifier-policy window (backdating bounded by polDelta,            *)
   171	(* post-dating by polEps).                                                  *)
   172	WindowRespected ==
   173	  StrictAccept => (/\ anchor - declared <= polDelta
   174	                   /\ declared - anchor <= polEps
   175	                   /\ confirmedAt - declared <= polDelta)
   176	
   177	(* A1.2 P5, "delta and epsilon belong to the verifier, not the receipt":  *)
   178	(* acceptance NEVER exceeds the strict maxima, whatever tolerances the    *)
   179	(* receipt declares. In this (correct) model rcptDelta/rcptEps are        *)
   180	(* ignored, so this holds; the _BrokenTol companion routes them into the  *)
   181	(* window and TLC exhibits a receipt-enlarged acceptance violating it.    *)
   182	VerifierOwnsTolerances ==
   183	  StrictAccept =>
   184	    (/\ anchor - declared <= DeltaMax
   185	     /\ declared - anchor <= EpsilonMax
   186	     /\ confirmedAt - declared <= DeltaMax)
   187	
   188	(* THE A2.0 ARTIFACT, REJECTED (Amendment 2): an anchor whose block is    *)
   189	(* in-window but whose k-th confirmation arrived past the window — the    *)
   190	(* discarded-attempt artifact that strict issuance never ships but whose  *)
   191	(* transaction typically confirms anyway. The pre-A2 verifier             *)
   192	(* (anchor-only checks) accepts it; the _BrokenConf companion carries     *)
   193	(* that verifier, passes every anchor-only invariant, and violates        *)
   194	(* exactly this one.                                                        *)
   195	AbandonedArtifactRejected ==
   196	  (/\ anchor >= declared - polEps
   197	   /\ anchor <= declared + polDelta
   198	   /\ confirmedAt > declared + polDelta)
   199	  => ~StrictAccept
   200	
   201	(* Full noninterference, "ignore receipt tolerances" taken literally: the *)
   202	(* verdict is IDENTICAL under every receipt-declared tolerance pair — not *)
   203	(* merely bounded by the maxima. This is strictly stronger than           *)
   204	(* VerifierOwnsTolerances: a bug giving the receipt a NARROWING influence *)
   205	(* (effective window = min of policy and receipt) passes every safety     *)
   206	(* invariant above — acceptance stays inside the maxima — yet hands the   *)
   207	(* issuer control over other parties' verification outcomes. Only this    *)
   208	(* invariant catches it (_BrokenTolStrict).                                *)
   209	(* CORRECTION 2026-09-06 (review item 8): "strictly stronger" holds only    *)
   210	(* for receipt INFLUENCE — independence catches enlargement and narrowing   *)
   211	(* alike, where VerifierOwnsTolerances catches enlargement past the maxima  *)
   212	(* only. It is NOT logically stronger than VerifierOwnsTolerances: an       *)
   213	(* acceptance predicate that ignores its receipt arguments could still      *)
   214	(* accept outside the maxima (e.g. a predicate that hard-codes a bound      *)
   215	(* larger than DeltaMax and ignores its receipt arguments; Init bounds      *)
   216	(* polDelta \in 0..DeltaMax, so no STATE of this model is the example — the *)
   217	(* example is a predicate) and pass this invariant. The two are             *)
   218	(* complementary; the correct module checks both.                           *)
   219	ReceiptIndependence ==
   220	  \A rd \in 0..RcptTolMax : \A re \in 0..RcptTolMax :
   221	    StrictAcceptWith(rd, re) <=> StrictAccept
   222	
   223	(* P6 second clause standing alone: acceptance implies the key was        *)
   224	(* authorized at the declared issue time itself.                           *)
   225	(* Amendment 4 §A4.3 (2026-09-06): when the anchor precedes the declared    *)
   226	(* time (possible within epsilon), a revocation after the anchor but at or  *)
   227	(* before the declared time still invalidates — this conjunct says so, and  *)
   228	(* §A4.3 writes Amendment 1's "after anchor_time" sentence as "after both   *)
   229	(* anchor_time and declared_issue_time" to match. Boundary (review item     *)
   230	(* 13): declared < revoked stands in for key_authorized(declared); no       *)
   231	(* activation time is modelled (lifecycle deferred, docket items 18, 26).   *)
   232	AuthorizedAtDeclared ==
   233	  StrictAccept => declared < revoked
   234	
   235	(* P6 fail-closed cost, made exact (not just accepted rhetorically): the  *)
   236	(* ONLY honest receipts the interval rule sacrifices are those whose key  *)
   237	(* was revoked inside (declared, anchor] — signed before revocation       *)
   238	(* (honest) but revoked before the anchor confirmed. Everything else      *)
   239	(* honest is accepted if temporally consistent.                            *)
   240	HonestCostIsExactlyTheWindow ==
   241	  (/\ TemporalOK
   242	   /\ signed < revoked          \* honestly signed while authorized
   243	   /\ revoked > declared        \* authorized at declaration too
   244	   /\ ~StrictAccept)
   245	  => (revoked <= anchor)        \* ...then revocation landed in the window
   246	
   247	(* Vacuity checks — used ONLY by the _Sanity cfg (run with TLC            *)
   248	(* -continue), where TLC VIOLATING both is the healthy result: each       *)
   249	(* violation exhibits a reachable state satisfying a defined-predicate    *)
   250	(* antecedent, so the implications above are not vacuously true.           *)
   251	NonMonotonicAcceptUnreachable ==      \* accepted with confirmedAt < anchor:
   252	  ~(StrictAccept /\ confirmedAt < anchor)  \* non-monotonicity (A2.1) exercised
   253	AcceptanceUnreachable == ~StrictAccept
   254	LateBurialCaseUnreachable ==          \* the A2.0 artifact is reachable, so
   255	  ~(/\ anchor >= declared - polEps    \* AbandonedArtifactRejected is not vacuous
   256	    /\ anchor <= declared + polDelta
   257	    /\ confirmedAt > declared + polDelta)
   258	HonestCostCaseUnreachable ==
   259	  ~(/\ TemporalOK
   260	    /\ signed < revoked
   261	    /\ revoked > declared
   262	    /\ ~StrictAccept)
   263	
   264	=================================================================================
CONSTANTS
  MaxTime = 6
  DeltaMax = 3
  EpsilonMax = 1
  RcptTolMax = 6

INIT Init
NEXT Next

INVARIANTS
  ForgeryRejected
  WindowRespected
  VerifierOwnsTolerances
  AbandonedArtifactRejected
  ReceiptIndependence
  AuthorizedAtDeclared
  HonestCostIsExactlyTheWindow
