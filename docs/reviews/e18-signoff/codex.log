   130	(*   refusal and buried by the final ticks satisfied it — so it fired at    *)
   131	(*   MaxTime = 12, and the "+DepthK headroom = 14 exercises the             *)
   132	(*   post-refusal burial path" sentences above, in the cfg, and in          *)
   133	(*   formal/PROPERTIES.md were not what that witness guarded. RECUT         *)
   134	(*   2026-09-06: variable `refusedAt` records the clock value at which the  *)
   135	(*   refusing Tick entered the refusal (sentinel NoRefusal before); the     *)
   136	(*   witness now requires the anchor to have landed AT OR AFTER that        *)
   137	(*   instant (anchorAt >= refusedAt, which an anchor placed before the      *)
   138	(*   refusing Tick cannot satisfy) and then to have reached full depth.     *)
   139	(*   Under the recut the witness is unreachable at MaxTime = 12 and 13 and  *)
   140	(*   fires at 14 (runs archived under falsification-2026-09-06/P5c/recut/). *)
   141	(*   Every previously checked invariant and the action property are kept    *)
   142	(*   unchanged; one guard invariant on the new variable,                    *)
   143	(*   RefusalTimeConsistent, is added so the witness cannot degenerate if    *)
   144	(*   the recording were broken. Companions _Broken and _BrokenSilent carry  *)
   145	(*   the same variable so their "identical state space" claims stay         *)
   146	(*   literally true.                                                        *)
   147	(*                                                                          *)
   148	(* Reading guide (Tony): this module has real actions. Tick advances      *)
   149	(* time and deepens an included anchor by one block per tick (block       *)
   150	(* arrival = clock tick, a deliberate simplification). Anchor lands the   *)
   151	(* stamp in the chain (depth 0 = just included; k more ticks to bury).    *)
   152	(* Reorg orphans any anchor shallower than k. Ship completes issuance    *)
   153	(* under the strict rule. Reissue discards a timed-out attempt and        *)
   154	(* redeclares at the current time.                                          *)
   155	(***************************************************************************)
   156	EXTENDS Integers
   157	
   158	CONSTANTS MaxTime, Delta, DepthK, MaxAttempts
   159	
   160	ASSUME Delta \in Nat /\ DepthK \in Nat \ {0} /\ MaxTime \in Nat
   161	       /\ MaxAttempts \in Nat \ {0}
   162	
   163	NoAnchor == -1
   164	NoRefusal == -1  \* refusedAt sentinel: no refusal recorded (recut 2026-09-06)
   165	
   166	VARIABLES
   167	  now,             \* the clock
   168	  declared,        \* declared_issue_time of the CURRENT attempt
   169	  anchorAt,        \* block time of the current anchor (NoAnchor if none)
   170	  depth,           \* confirmations of that anchor (capped at DepthK)
   171	  shipped,         \* issuance completed
   172	  shippedOrphaned, \* a SHIPPED receipt's anchor was orphaned (must stay FALSE)
   173	  attempts,        \* issuance attempts so far
   174	  reorgs,          \* reorg count (capped; for reachability witnesses)
   175	  refused,         \* the durable refusal record (A2.3 / round-3 ruling 4)
   176	  refusedAt        \* clock value at which the refusing Tick entered `refused`
   177	                   \* (NoRefusal until then; recut 2026-09-06, review item 15)
   178	
   179	vars == <<now, declared, anchorAt, depth, shipped, shippedOrphaned,
   180	          attempts, reorgs, refused, refusedAt>>
   181	
   182	Init ==
   183	  /\ now = 0 /\ declared = 0
   184	  /\ anchorAt = NoAnchor /\ depth = 0
   185	  /\ shipped = FALSE /\ shippedOrphaned = FALSE
   186	  /\ attempts = 1 /\ reorgs = 0
   187	  /\ refused = FALSE /\ refusedAt = NoRefusal
   188	
   189	(* Time advances; an included, unorphaned anchor gains one confirmation   *)
   190	(* per tick (depth capped at DepthK — beyond k, nothing changes).          *)
   191	(*                                                                          *)
   192	(* ATOMIC ENTRY (round-3 ruling 4, construction 1): the tick that carries *)
   193	(* the clock past the FINAL attempt's window records the refusal in the   *)
   194	(* SAME transition. There is no separately enabled Refuse action to       *)
   195	(* postpone — the state in which the last window has expired but no       *)
   196	(* refusal is recorded does not exist. The disjunct also keeps `refused`  *)
   197	(* latched (belt; no action ever unsets it — RefusalLatched is the        *)
   198	(* checked form of that claim).                                            *)
   199	Tick ==
   200	  /\ now < MaxTime
   201	  /\ now' = now + 1
   202	  /\ depth' = IF anchorAt # NoAnchor /\ depth < DepthK THEN depth + 1 ELSE depth
   203	  /\ refused' = (refused \/ (~shipped /\ attempts = MaxAttempts
   204	                                      /\ now + 1 > declared + Delta))
   205	  \* recut 2026-09-06: the entering Tick stamps the clock value it moved to
   206	  /\ refusedAt' = IF refused' /\ ~refused THEN now + 1 ELSE refusedAt
   207	  /\ UNCHANGED <<declared, anchorAt, shipped, shippedOrphaned, attempts, reorgs>>
   208	
   209	(* The OTS calendar lands the stamp in a block — at any time (delays are  *)
   210	(* modeled by this action simply not firing yet). Deliberately NOT        *)
   211	(* guarded on ~refused: a discarded attempt's stamp landing after the     *)
   212	(* refusal is exactly the A2.4 case "a discarded attempt's transaction    *)
   213	(* confirming later confers nothing" — the model keeps that path          *)
   214	(* reachable, and the Ship guard, not this one, is what makes the late    *)
   215	(* anchor worthless. Witness coverage, stated precisely (Codex finding    *)
   216	(* 5): RefusalWithLiveAnchorUnreachable shows an anchor PRESENT in a      *)
   217	(* refused state; RefusalBuriedAnchorUnreachable shows it BURIED to full  *)
   218	(* depth post-refusal with Ship still disabled — the latter needs the     *)
   219	(* +DepthK headroom in MaxTime (14), and at 12 it is unreachable.          *)
   220	(* CORRECTION 2026-09-06 (item 15): the sentence above was false for the    *)
   221	(* witness as it stood (no chronology; fired at 12). It is true for the     *)
   222	(* recut witness, which requires anchorAt >= refusedAt — the anchor         *)
   223	(* landing at or after the refusal instant — and is unreachable at 12       *)
   224	(* and 13, reachable at 14 (see the header correction and the cfg).         *)
   225	Anchor ==
   226	  /\ ~shipped /\ anchorAt = NoAnchor
   227	  /\ anchorAt' = now /\ depth' = 0
   228	  /\ UNCHANGED <<now, declared, shipped, shippedOrphaned, attempts, reorgs,
   229	                 refused, refusedAt>>
   230	
   231	(* A reorganization orphans any anchor shallower than DepthK. Depth >= k  *)
   232	(* is permanent BY ASSUMPTION (A1.6) — that is the Layer 2 line this      *)
   233	(* model builds on, not a result it proves. If a shipped receipt's anchor *)
   234	(* is orphaned, the harm flag latches (the correct Ship rule makes that   *)
   235	(* unreachable; the broken companion makes it reachable).                  *)
   236	Reorg ==
   237	  /\ anchorAt # NoAnchor /\ depth < DepthK
   238	  /\ reorgs < 2
   239	  /\ anchorAt' = NoAnchor /\ depth' = 0 /\ reorgs' = reorgs + 1
   240	  /\ shippedOrphaned' = (shipped \/ shippedOrphaned)
   241	  /\ UNCHANGED <<now, declared, shipped, attempts, refused, refusedAt>>
   242	
   243	(* Issuance completes — STRICT rule per the registered text: the anchor   *)
   244	(* is buried at depth k AND we are still within delta of the declared     *)
   245	(* time. (anchorAt <= now always, so the block time is in-window a        *)
   246	(* fortiori.)                                                               *)
   247	(*                                                                          *)
   248	(* BOUNDARY RACE, intentional (Codex finding 1): with integral time,      *)
   249	(* Ship's guard (now <= declared + Delta) and the refusal trigger         *)
   250	(* (now + 1 > declared + Delta, i.e. now >= declared + Delta) BOTH hold   *)
   251	(* at exactly now = declared + Delta — and there is no tick where         *)
   252	(* neither holds. At the deadline instant a fully-buried anchor may       *)
   253	(* ship, or the clock may advance and refuse; the scheduler's choice is   *)
   254	(* the model's honest image of the physical race between burial and       *)
   255	(* clock. Both branches are safe and the outcomes are mutually            *)
   256	(* exclusive (RefusedOnlyWhenExhausted). Eligibility at the boundary      *)
   257	(* does not oblige shipping — the deadline governs completion; a          *)
   258	(* "qualification guarantees issuance" contract would be a liveness       *)
   259	(* claim, and this module makes none.                                      *)
   260	Ship ==
   261	  /\ ~shipped /\ anchorAt # NoAnchor
   262	  /\ depth >= DepthK
   263	  /\ now <= declared + Delta
   264	  /\ shipped' = TRUE
   265	  /\ UNCHANGED <<now, declared, anchorAt, depth, shippedOrphaned, attempts,
   266	                 reorgs, refused, refusedAt>>
   267	
   268	(* The window expired without completion: discard the attempt, redeclare  *)
   269	(* fresh. The old attempt never ships — its declared time is gone.         *)
   270	Reissue ==
   271	  /\ ~shipped /\ now > declared + Delta
   272	  /\ attempts < MaxAttempts
   273	  /\ declared' = now /\ anchorAt' = NoAnchor /\ depth' = 0
   274	  /\ attempts' = attempts + 1
   275	  /\ UNCHANGED <<now, shipped, shippedOrphaned, reorgs, refused, refusedAt>>
   276	
   277	Next == Tick \/ Anchor \/ Reorg \/ Ship \/ Reissue
   278	
   279	(* Terminal states (shipped, or out of time/attempts) deadlock at the     *)
   280	(* MaxTime bound — run TLC with -deadlock (checking disabled); the        *)
   281	(* deadlocks are artifacts of the bounded model, not protocol defects.    *)
   282	
   283	(***************************************************************************)
   284	(* Invariants — what "the verifier may assume anchor is permanent" costs  *)
   285	(* and buys.                                                                *)
   286	(***************************************************************************)
   287	
   288	(* THE HARM INVARIANT (Gemini's finding, discharged): a shipped receipt's *)
   289	(* anchor is never orphaned — no receipt in the wild ever becomes         *)
   290	(* permanently unverifiable through reorg. Holds because Ship requires    *)
   291	(* depth >= k and Reorg touches only depth < k.                            *)
   292	NoShippedOrphan == ~shippedOrphaned
   293	
   294	(* A shipped receipt is temporally sound and buried: block time within    *)
   295	(* the window of ITS OWN declared time, at full depth. (Post-ship,        *)
   296	(* declared/anchorAt/depth are frozen: Reissue is disabled by shipped,    *)
   297	(* Anchor by anchorAt, Reorg by depth.)                                     *)
   298	ShippedIsSound ==
   299	  shipped =>
   300	    /\ anchorAt # NoAnchor
   301	    /\ anchorAt >= declared
   302	    /\ anchorAt <= declared + Delta
   303	    /\ depth >= DepthK
   304	
   305	(* Discarded attempts stay discarded: after a re-issue, the live declared *)
   306	(* time is the fresh one — there is no state in which an expired          *)
   307	(* declaration ships. (Equivalent state form: an unshipped attempt past   *)
   308	(* its window is exactly an attempt that cannot Ship.)                     *)
   309	ExpiredCannotShip ==
   310	  (~shipped /\ now > declared + Delta) => ~ENABLED Ship
   311	
   312	(* THE DEADLOCK INVARIANT (round-3 ruling 4): no silent terminal failure. *)
   313	(* If the final attempt's window has expired and nothing shipped, the     *)
   314	(* refusal record already exists — there is NO reachable state in which   *)
   315	(* issuance is dead but undocumented. This is the state-level shadow of   *)
   316	(* the atomic entry in Tick; the _BrokenSilent companion (separately      *)
   317	(* enabled Refuse) must violate exactly this invariant and nothing else.   *)
   318	NoSilentDeadlock ==
   319	  (~shipped /\ attempts = MaxAttempts /\ now > declared + Delta) => refused
   320	
   321	(* The negative outcome is sound: refusal is recorded ONLY on genuine     *)
   322	(* exhaustion — final attempt, window expired, nothing shipped. (The      *)
   323	(* conjuncts stay true once entered: Reissue is disabled by               *)
   324	(* attempts = MaxAttempts so declared is frozen, now is monotone, and     *)
   325	(* Ship is disabled forever by the expired window — so refused and        *)
   326	(* shipped are mutually exclusive as a corollary.)                         *)
   327	RefusedOnlyWhenExhausted ==
   328	  refused => /\ ~shipped
   329	             /\ attempts = MaxAttempts
   330	             /\ now > declared + Delta
   331	
   332	(* The in-model latch: every step either preserves refused or sets it;    *)
   333	(* no step unsets it. Action property (PROPERTIES in the cfg, not         *)
   334	(* INVARIANTS). This proves LOGICAL state persistence only — storage      *)
   335	(* durability, retrievability, and reporting are implementation/handoff   *)
   336	(* obligations (see the header's narrowed claim).                          *)
   337	RefusalLatched == [][refused => refused']_vars
   338	
   339	(* Guard on the recording variable (recut 2026-09-06, review item 15):    *)
   340	(* refusedAt is set exactly when the refusal is entered, to a clock value *)
   341	(* no later than now. Without this, a broken recording (refusedAt stuck   *)
   342	(* at NoRefusal = -1) would make anchorAt >= refusedAt trivially true and *)
   343	(* silently restore the chronology-free witness this recut replaces.      *)
   344	RefusalTimeConsistent ==
   345	  /\ (refused <=> refusedAt # NoRefusal)
   346	  /\ (refused => refusedAt \in 0..now)
   347	
   348	(* Vacuity witnesses — _Sanity cfg, TLC -continue; VIOLATIONS are the     *)
   349	(* healthy result: shipping is reachable at all, after a re-issue, and    *)
   350	(* after surviving a reorg; refusal is reachable at all, after a reorg,   *)
   351	(* with a live (late, worthless) anchor present — the A2.4                *)
   352	(* discarded-attempt case — and with that anchor BURIED to full depth     *)
   353	(* post-refusal while Ship stays disabled (the off-happy-path trace of    *)
   354	(* Codex finding 5). If RefusalUnreachable is NOT violated, the refusal   *)
   355	(* invariants above are vacuous — check MaxTime >=                        *)
   356	(* MaxAttempts * (Delta + 1); if RefusalBuriedAnchorUnreachable is NOT    *)
   357	(* violated, the post-refusal burial path is untested — check the         *)
   358	(* + DepthK headroom (14).                                                 *)
   359	ShipUnreachable        == ~shipped
   360	ReissueShipUnreachable == ~(shipped /\ attempts > 1)
   361	ReorgShipUnreachable   == ~(shipped /\ reorgs > 0)
   362	RefusalUnreachable               == ~refused
   363	RefusalAfterReorgUnreachable     == ~(refused /\ reorgs > 0)
   364	RefusalWithLiveAnchorUnreachable == ~(refused /\ anchorAt # NoAnchor)
   365	\* recut 2026-09-06 (item 15): was ~(refused /\ depth >= DepthK), which an
   366	\* anchor placed BEFORE the refusal satisfied; now the anchor must have
   367	\* landed at or after the refusal instant and then reached full depth.
   368	RefusalBuriedAnchorUnreachable   ==
   369	  ~(refused /\ anchorAt >= refusedAt /\ depth >= DepthK)
   370	
