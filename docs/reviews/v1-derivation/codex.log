   100	def temporal(anchor, frames, common, trust, policy, cks, facts, prefix=""):
   101	    """Drop-in for verifier._temporal when anchor['format'] == 'ots-bitcoin'."""
   102	    from .. import objects
   103	    delta = policy.delta if policy.delta is not None else trust.delta
   104	    eps = policy.epsilon if policy.epsilon is not None else trust.epsilon
   105	    k = trust.k
   106	    pid = lambda x: f"{prefix}{x}"  # noqa: E731
   107	    try:
   108	        declared = objects.parse_ts(common.get("declared_issue_time", ""))
   109	        cks.add(pid("TIME"), PASS)
   110	    except ValueError:
   111	        cks.add(pid("TIME"), FAIL, "DECLARED_TIME_MALFORMED")
   112	        return
   113	    r = evaluate(anchor, objects.receipt_digest(frames), trust.header_store, k,
   114	                 getattr(trust, "header_policy", "pin-every-header"))
   115	    for cid, (st, why) in r["checks"].items():
   116	        cks.add(pid(cid), st, why)
   117	    facts["ots"] = r["facts"].get("ots")
   118	    if "anchor_time" not in r["facts"]:
   119	        return
   120	    at, ca = r["facts"]["anchor_time"], r["facts"]["confirmed_at"]
   121	    facts["anchor_time"], facts["confirmed_at"], facts["declared"] = at, ca, declared
   122	    cks.add(pid("V33"), PASS if declared - eps <= at else FAIL, "" if declared - eps <= at else "P5_ANCHOR_BEFORE_WINDOW")
   123	    cks.add(pid("V34"), PASS if at <= declared + delta else FAIL, "" if at <= declared + delta else "P5_ANCHOR_AFTER_WINDOW")
   124	    cks.add(pid("V35"), PASS if ca <= declared + delta else FAIL, "" if ca <= declared + delta else "P5_CONFIRMATION_LATE")
   125	    cks.add(pid("V36"), PASS)
