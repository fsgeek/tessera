    44	def split_gpgsig(commit: bytes) -> tuple[bytes, bytes]:
    45	    """Return (signed payload = commit without the gpgsig header, armored signature)."""
    46	    lines = commit.split(b"\n")
    47	    out, sig, in_sig, in_header = [], [], False, True
    48	    for ln in lines:
    49	        if in_header and ln == b"":
    50	            in_header = False
    51	            out.append(ln)
    52	            continue
    53	        if in_header and ln.startswith(b"gpgsig "):
    54	            in_sig = True
    55	            sig.append(ln[len(b"gpgsig "):])
    56	            continue
    57	        if in_sig and ln.startswith(b" "):
    58	            sig.append(ln[1:])
    59	            continue
    60	        in_sig = False
    61	        out.append(ln)
    62	    return b"\n".join(out), b"\n".join(sig)
