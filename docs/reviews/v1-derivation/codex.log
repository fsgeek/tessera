    93	            return mode, oid
    94	    return None
    95	
    96	
    97	def collect(commit_id: str, path: str) -> CommitEvidence:
    98	    typ, raw = raw_object(commit_id)
    99	    assert typ == "commit" and object_id("commit", raw) == commit_id
   100	    payload, armored = split_gpgsig(raw)
   101	    sig = P.parse_signature(dearmor(armored))
   102	    tree_id = raw.split(b"\n", 1)[0].split()[1].decode()
   103	    objs = []
   104	    cur = tree_id
   105	    for part in path.split("/"):
   106	        t, body = raw_object(cur)
   107	        assert object_id(t, body) == cur
   108	        objs.append((t, cur, body))
   109	        ent = tree_entry(body, part)
   110	        if ent is None:
   111	            raise FileNotFoundError(path)
   112	        cur = ent[1]
   113	    t, body = raw_object(cur)
   114	    objs.append((t, cur, body))
   115	    return CommitEvidence(commit_id, raw, payload, sig, objs)
   116	
   117	
   118	def verify_offline(ev: CommitEvidence, pubkey_packets: bytes) -> dict:
   119	    """Everything an offline verifier can check from archived bytes, with no git and no gpg."""
   120	    key = None
   121	    for tag, body, _ in P.iter_packets(pubkey_packets):
   122	        if tag == 6:
   123	            key = P.parse_public_key_body(body)
   124	            break
   125	    sig_ok = key is not None and P.verify(ev.signature, key, ev.signed_payload)
   126	    ids_ok = object_id("commit", ev.commit_raw) == ev.commit_id and \
   127	        all(object_id(t, b) == oid for t, oid, b in ev.path_objects)
   128	    links_ok = ev.commit_raw.split(b"\n", 1)[0].split()[1].decode() == ev.path_objects[0][1]
   129	    hdr = dict(ln.split(b" ", 1) for ln in ev.signed_payload.split(b"\n\n", 1)[0].split(b"\n") if b" " in ln)
   130	    committer_time = int(hdr[b"committer"].rsplit(b" ", 2)[1])
   131	    return {"signature_ok": sig_ok, "object_ids_ok": ids_ok, "tree_link_ok": links_ok,
   132	            "signer_fpr": ev.signature.issuer_fpr, "key_fpr": key.fingerprint_v4 if key else None,
   133	            "sig_creation_time": ev.signature.creation_time, "committer_time": committer_time,
   134	            "hash_alg": ev.signature.hash_alg, "pk_alg": ev.signature.pk_alg,
   135	            "archive_bytes": ev.archive_bytes}
     1	"""Item 4a: what a DNSSEC "chain snapshot" gives an offline verifier (RFC 4033-4035). THROWAWAY.
     2	
     3	capture() (network, run once 2026-10-07) asks a resolver, with the DO bit, for every RRset on a
     4	path from the root to a name and stores the raw DNS responses (wire format, base64) as a fixture.
     5	validate_offline() then re-validates the chain with dnspython, with no network, at a CHOSEN time.
     6	
     7	Findings this module demonstrates (see tests/test_phase3.py):
     8	  * wamason.com is not signed: .com returns an authenticated denial (NSEC3, opt-out) of any DS for
     9	    it. The registered evidence 1 (R-4.26) cannot be produced today.
    10	  * the only key an offline verifier needs is the ROOT KSK; it authenticates every signed name on
    11	    the internet, so "the DNS channel's key" (the model's skS / pk(skS)) is not specific to wamason.com.
    12	    What ties a DNSSEC snapshot to an issuer is the owner NAME of the RRset -- a comparison the
    13	    model never makes, against an issuer identity the spec says is "bound, not validated".
    14	  * every RRSIG has an inception/expiration window (days to weeks); RFC 4035 §5.3.1 checks it against
    15	    the validator's current time. A 2106 verifier must instead supply an authenticated time inside
    16	    every window on the chain -- i.e. the snapshot itself must be time-anchored.
    17	"""
    18	from __future__ import annotations
    19	
    20	import base64
    21	import json
    22	import time
    23	from pathlib import Path
    24	
    25	import dns.dnssec
    26	import dns.flags
    27	import dns.message
    28	import dns.name
    29	import dns.query
    30	import dns.rdataclass
    31	import dns.rdatatype
    32	import dns.rrset
    33	
    34	FIXTURES = Path(__file__).resolve().parent / "fixtures"
    35	# IANA root trust anchor KSK-2017 (key tag 20326), DS digest type 2 (SHA-256), from root-anchors.xml.
    36	ROOT_KSK_2017_DS = "E06D44B80B8F1D39A95C0B0D7C65D08458E880409BBC683457104237C7F8EC8D"
    37	ROOT_KSK_2017_TAG = 20326
    38	
    39	
    40	def _q(name: str, rtype: str, server: str) -> dns.message.Message:
    41	    q = dns.message.make_query(name, rtype, want_dnssec=True)
    42	    q.flags |= dns.flags.CD   # we validate ourselves
    43	    r = dns.query.udp(q, server, timeout=10)
    44	    if r.flags & dns.flags.TC:
    45	        r = dns.query.tcp(q, server, timeout=10)
    46	    return r
    47	
    48	
    49	def capture(target: str, rtype: str, out: str, server: str = "1.1.1.1") -> dict:
    50	    """Network. Fetch DNSKEY for every zone from root to `target`'s zone, DS for each child, and the
    51	    target RRset (or the denial proof). Store raw wire messages."""
    52	    labels = target.rstrip(".").split(".")
    53	    zones = ["."] + [".".join(labels[i:]) + "." for i in range(len(labels) - 1, -1, -1)]  # root ... target
    54	    msgs = {}
    55	    for z in zones:
    56	        msgs[f"{z} DNSKEY"] = _q(z, "DNSKEY", server)
    57	        if z != ".":
    58	            msgs[f"{z} DS"] = _q(z, "DS", server)
    59	    msgs[f"{target} {rtype}"] = _q(target, rtype, server)
    60	    d = {"captured": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "server": server, "target": target,
    61	         "rtype": rtype, "messages": {k: base64.b64encode(m.to_wire()).decode() for k, m in msgs.items()}}
    62	    (FIXTURES / out).write_text(json.dumps(d, indent=1))
    63	    return d
    64	
    65	
    66	def load(name: str) -> dict:
    67	    d = json.loads((FIXTURES / name).read_text())
    68	    d["msgs"] = {k: dns.message.from_wire(base64.b64decode(v)) for k, v in d["messages"].items()}
    69	    return d
    70	
    71	
    72	def _sets(msg: dns.message.Message, section: str = "answer"):
    73	    """Split a section into {(name, type): rrset} and {(name, covered type): rrsig rrset}."""
    74	    data, sigs = {}, {}
    75	    for rr in getattr(msg, section):
    76	        if rr.rdtype == dns.rdatatype.RRSIG:
    77	            sigs[(rr.name, rr.covers)] = rr
    78	        else:
    79	            data[(rr.name, rr.rdtype)] = rr
    80	    return data, sigs
    81	
    82	
    83	def validate_offline(fx: dict, now: float) -> dict:
    84	    """Walk root -> zones -> target with dnspython's RRSIG validation at time `now`. Returns a
    85	    per-step ledger and a final status: SECURE (positive RRset validated), INSECURE (authenticated
    86	    proof that the zone is unsigned), or BOGUS (some signature failed: at `now` that includes expiry)."""
    87	    ledger = []
    88	    msgs = fx["msgs"]
    89	    zone_keys: dict[dns.name.Name, dns.rrset.RRset] = {}
    90	    root = dns.name.root
    91	    # 1. root DNSKEY against the trust anchor
    92	    kd, ks = _sets(msgs[". DNSKEY"])
    93	    keys = kd[(root, dns.rdatatype.DNSKEY)]
    94	    ksk = [k for k in keys if dns.dnssec.key_id(k) == ROOT_KSK_2017_TAG]
    95	    ds_ok = bool(ksk) and dns.dnssec.make_ds(root, ksk[0], "SHA256").digest.hex().upper() == ROOT_KSK_2017_DS
    96	    ledger.append(("root KSK matches IANA anchor 20326", ds_ok))
    97	    try:
    98	        dns.dnssec.validate(keys, ks[(root, dns.rdatatype.DNSKEY)], {root: keys}, now=now)
    99	        ledger.append(("root DNSKEY RRset self-signed", True))
   100	    except dns.dnssec.ValidationFailure as e:
   101	        ledger.append((f"root DNSKEY RRset self-signed: {e}", False))
   102	        return {"status": "BOGUS", "ledger": ledger}
   103	    zone_keys[root] = keys
   104	    parent = root
   105	    zones = [k.split()[0] for k in fx["messages"] if k.endswith(" DNSKEY")]
   106	    for z in zones[1:]:
   107	        zn = dns.name.from_text(z)
   108	        dsmsg = msgs[f"{z} DS"]
   109	        dd, dsig = _sets(dsmsg)
   110	        if (zn, dns.rdatatype.DS) not in dd:
   111	            # authenticated denial of DS => insecure delegation (RFC 4035 §5.2)
   112	            ad, asig = _sets(dsmsg, "authority")
   113	            ok = True
   114	            for (n, t), rr in ad.items():
   115	                if t in (dns.rdatatype.NSEC3, dns.rdatatype.NSEC, dns.rdatatype.SOA):
   116	                    try:
   117	                        dns.dnssec.validate(rr, asig[(n, t)], {parent: zone_keys[parent]}, now=now)
   118	                    except (dns.dnssec.ValidationFailure, KeyError) as e:
   119	                        ok = False
   120	                        ledger.append((f"denial record {n} {dns.rdatatype.to_text(t)}: {e}", False))
   121	            n3 = [rr for (n, t), rr in ad.items() if t == dns.rdatatype.NSEC3]
   122	            ledger.append((f"no DS for {z}: authenticated denial via {len(n3)} NSEC3 record(s) signed by {parent}", ok))
   123	            return {"status": "INSECURE" if ok else "BOGUS", "ledger": ledger, "insecure_at": z}
   124	        try:
   125	            dns.dnssec.validate(dd[(zn, dns.rdatatype.DS)], dsig[(zn, dns.rdatatype.DS)], {parent: zone_keys[parent]}, now=now)
   126	            ledger.append((f"DS {z} signed by {parent}", True))
   127	        except dns.dnssec.ValidationFailure as e:
   128	            ledger.append((f"DS {z} signed by {parent}: {e}", False))
   129	            return {"status": "BOGUS", "ledger": ledger}
   130	        kd, ks = _sets(msgs[f"{z} DNSKEY"])
   131	        keys = kd[(zn, dns.rdatatype.DNSKEY)]
   132	        ds_digests = {(d.key_tag, d.digest) for d in dd[(zn, dns.rdatatype.DS)]}
   133	        linked = any((dns.dnssec.key_id(k), dns.dnssec.make_ds(zn, k, d.digest_type).digest) in ds_digests
   134	                     for k in keys for d in dd[(zn, dns.rdatatype.DS)])
   135	        ledger.append((f"{z} DNSKEY matches a DS in {parent}", linked))
   136	        try:
   137	            dns.dnssec.validate(keys, ks[(zn, dns.rdatatype.DNSKEY)], {zn: keys}, now=now)
   138	            ledger.append((f"{z} DNSKEY RRset self-signed", True))
   139	        except dns.dnssec.ValidationFailure as e:
   140	            ledger.append((f"{z} DNSKEY self-signed: {e}", False))
   141	            return {"status": "BOGUS", "ledger": ledger}
   142	        if not linked:
   143	            return {"status": "BOGUS", "ledger": ledger}
   144	        zone_keys[zn] = keys
   145	        parent = zn
   146	    tmsg = msgs[f"{fx['target']} {fx['rtype']}"]
   147	    td, tsig = _sets(tmsg)
   148	    tn = dns.name.from_text(fx["target"])
   149	    rr = td.get((tn, dns.rdatatype.from_text(fx["rtype"])))
   150	    if rr is None:
   151	        return {"status": "BOGUS", "ledger": ledger + [("target RRset missing", False)]}
   152	    try:
   153	        dns.dnssec.validate(rr, tsig[(tn, rr.rdtype)], {parent: zone_keys[parent]}, now=now)
   154	        ledger.append((f"{fx['target']} {fx['rtype']} signed by {parent}", True))
   155	    except (dns.dnssec.ValidationFailure, KeyError) as e:
   156	        ledger.append((f"{fx['target']} {fx['rtype']}: {e}", False))
   157	        return {"status": "BOGUS", "ledger": ledger}
   158	    return {"status": "SECURE", "ledger": ledger, "rrset": rr.to_text(), "owner": str(rr.name)}
   159	
   160	
   161	def rrsig_windows(fx: dict) -> list[tuple[str, int, int]]:
   162	    """(covered RRset, inception, expiration) for every RRSIG captured."""
   163	    out = []
   164	    for k, m in fx["msgs"].items():
   165	        for sec in (m.answer, m.authority):
   166	            for rr in sec:
   167	                if rr.rdtype == dns.rdatatype.RRSIG:
   168	                    for sig in rr:
   169	                        out.append((f"{rr.name} {dns.rdatatype.to_text(sig.type_covered)}", sig.inception, sig.expiration))
   170	    return out
   171	
   172	
   173	def common_window(fx: dict) -> tuple[int, int]:
   174	    w = rrsig_windows(fx)
   175	    return max(x[1] for x in w), min(x[2] for x in w)

