    73	def check_segment(headers: dict[int, Header], lo: int, hi: int) -> tuple[bool, str]:
    74	    """Linkage + PoW for heights lo..hi. Difficulty-retarget validity is NOT checked (no segment used
    75	    here crosses a 2016-block boundary; a real verifier must check it, or an attacker picks nBits)."""
    76	    for h in range(lo, hi + 1):
    77	        x = headers.get(h)
    78	        if x is None:
    79	            return False, f"HEADER_MISSING:{h}"
    80	        if not x.pow_ok():
    81	            return False, f"POW_INVALID:{h}"
    82	        if h > lo and x.prev != headers[h - 1].hash:
    83	            return False, f"CHAIN_BROKEN:{h}"
    84	        if h > lo and (h % 2016) and x.bits != headers[h - 1].bits:
    85	            return False, f"BITS_CHANGED_OFF_BOUNDARY:{h}"
    86	        if h % 2016 == 0 and h > lo:
    87	            return False, f"RETARGET_NOT_IMPLEMENTED:{h}"
    88	    return True, ""
