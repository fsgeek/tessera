     1	"""Verifier stage (h) and standing step 8 over a real-format OTS anchor. THROWAWAY.
     2	
     3	Same check ids and semantics as the stub (`verifier._temporal`), with these real-mechanism rules:
     4	
     5	  V33a  the OTS proof's file digest equals this receipt's digest (G-19's two-frame preimage, kept),
     6	        and at least one BitcoinBlockHeaderAttestation's merkle root equals the bundled header's.
     7	        A proof holding only PendingAttestations cannot be evaluated: UNVERIFIABLE (ANCHOR_PENDING_ONLY).
     8	        A proof usually holds SEVERAL Bitcoin attestations (one per calendar, at different heights).
     9	        The spec's `anchor_time` is singular; this module takes the EARLIEST verified attestation
    10	        (the strongest true "existed by" statement) and records the others. GUESS G-55.
    11	        If the bundle names a txid, it must be a transaction on the chosen attestation's path (G-42).
    12	  V37   headers h..h+k-1 present in the bundle (R-3.48 candidate: the k-header segment is embedded).
    13	  V38   two policies (TrustConfig.header_policy):
    14	          "pin-every-header" -- phase 1's G-31: every header's hash equals the store's pin
    15	          "checkpoint+pow"   -- R-3.48 candidate: headers link to a pinned header, each meets its
    16	                                own nBits target, nBits constant inside the retarget period
    17	        Both also require linkage and PoW. On REGTEST difficulty PoW proves nothing; on mainnet it does.
    18	  V33-V36 as the stub, with anchor_time = nTime(h), confirmed_at = nTime(h+k-1).
    19	"""
    20	from __future__ import annotations
    21	
    22	import base64
    23	
    24	from . import btc, ots
    25	
    26	PASS, FAIL, UNPERF = "pass", "fail", "unperformable"
    27	
    28	
    29	def _headers(anchor: dict) -> dict[int, btc.Header]:
    30	    out = {}
    31	    for h, hx in (anchor.get("headers_hex") or {}).items():
    32	        try:
    33	            out[int(h)] = btc.Header.parse(bytes.fromhex(hx))
    34	        except ValueError:
    35	            pass
    36	    return out
    37	
    38	
    39	def evaluate(anchor: dict, digest_hex: str, store: dict[int, str], k: int, policy: str) -> dict:
    40	    """Pure evaluation of an OTS anchor; returns a dict of check outcomes and facts."""
    41	    r: dict = {"checks": {}, "facts": {}}
    42	    c = r["checks"]
    43	    try:
    44	        dtf = ots.load(base64.b64decode(anchor["ots_b64"]))
    45	    except Exception:  # noqa: BLE001
    46	        c["V33a"] = (FAIL, "ANCHOR_PROOF_MALFORMED")
    47	        return r
    48	    hs = _headers(anchor)
    49	    chk = ots.check(dtf, None, hs, bytes.fromhex(digest_hex))
    50	    bit = [b for b in chk.bitcoin]
    51	    r["facts"]["ots"] = {"bitcoin_attestations": [b["height"] for b in bit], "pending": chk.pending,
    52	                         "verified": [b["height"] for b in chk.verified()]}
    53	    if not chk.file_digest_ok:
    54	        c["V33a"] = (FAIL, "ANCHOR_NOT_OVER_THIS_RECEIPT")
    55	        return r
    56	    if not bit:
    57	        c["V33a"] = (UNPERF, "ANCHOR_PENDING_ONLY")
    58	        return r
    59	    if not any(b["header_present"] for b in bit):
    60	        c["V37"] = (UNPERF, "HEADERS_UNAVAILABLE")
    61	        c["V33a"] = (UNPERF, "ANCHOR_BLOCK_HEADER_UNAVAILABLE")
    62	        return r
    63	    e = chk.earliest()
    64	    if e is None:
    65	        c["V33a"] = (FAIL, "ANCHOR_MERKLE_ROOT_MISMATCH")
    66	        return r
    67	    h = e["height"]
    68	    if anchor.get("txid") and anchor["txid"] not in e["txids"]:
    69	        c["V33a"] = (FAIL, "TXID_NOT_ON_ATTESTATION_PATH")
    70	        return r
    71	    need = list(range(h, h + k))
    72	    if any(x not in hs for x in need):
    73	        c["V37"] = (UNPERF, "HEADERS_UNAVAILABLE")
    74	        c["V33a"] = (PASS, "")
    75	        return r
    76	    c["V37"] = (PASS, "")
    77	    ok, why = btc.check_segment(hs, h, h + k - 1)
    78	    if not ok:
    79	        c["V38"] = (FAIL if not why.startswith("RETARGET") else UNPERF, why)
    80	    elif policy == "pin-every-header":
    81	        bad = [x for x in need if x in store and store[x] != hs[x].hash_hex]
    82	        missing = [x for x in need if x not in store]
    83	        c["V38"] = (FAIL, "HEADER_STORE_CONFLICT") if bad else \
    84	            (UNPERF, "HEADER_NOT_IN_TRUST_STORE") if missing else (PASS, "")
    85	    elif policy == "checkpoint+pow":
    86	        bad = [x for x in need if x in store and store[x] != hs[x].hash_hex]
    87	        linked = (h - 1) in store and hs[h].prev[::-1].hex() == store[h - 1]
    88	        pinned_inside = any(x in store for x in need)
    89	        c["V38"] = (FAIL, "HEADER_STORE_CONFLICT") if bad else \
    90	            (PASS, "EXTENDED_BY_POW_FROM_PINNED_HEADER") if (linked or pinned_inside) else \
    91	            (UNPERF, "SEGMENT_NOT_LINKED_TO_ANY_PINNED_HEADER")
    92	    else:
    93	        raise ValueError(policy)
    94	    c["V33a"] = (PASS, "")
    95	    r["facts"].update(anchor_time=hs[h].time, confirmed_at=hs[h + k - 1].time, height=h,
    96	                      mtp=btc.median_time_past(hs, h))
    97	    return r
    98	
