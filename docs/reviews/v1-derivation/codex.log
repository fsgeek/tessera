    78	    rp2 = attacks.replay_cc02(w, full, T0 + 3 * HOUR)
    79	    cases["b"] = Case("b", "C-C2 reattribution: Acme's genuine statement under attacker keys", rp2.bundle,
    80	                      honest, False, "INVALID (V17/V18): the attribution is forged even though the files are genuine")
    81	
    82	    # (c) C-C5 transplant. The attacker puts its own release statement in both layers.
    83	    ev = evil_statement(sub, evil)
    84	    rp5 = attacks.replay_cc05(w, full, T0 + 3 * HOUR, inner_content=ev, outer_content=ev)
    85	    c5 = Case("c", "C-C5 wrapped inner-signature transplant (evil tarball)", rp5.bundle, evil, False,
    86	              "outer layer VALID_DEGRADED (attacker's own wrapper, registered cost); inner layer INVALID (V19)")
    87	    c5.world_facts["dsks"] = rp5.dsks   # adversary capability; passed to the verifier as phase 1 does
    88	    cases["c"] = c5
    89	
    90	    # (d1) honest receipt verified under a degraded policy, repo evidence present.
    91	    cases["d1"] = Case("d1", "honest receipt, degraded policy (repo waived, evidence present)", full, honest, True,
    92	                       "VALID_DEGRADED, repo observation would-pass", policies=("degraded",))
    93	    # (d2) honest receipt whose repo evidence was lost in custody.
    94	    lost = copy.deepcopy(full)
    95	    lost["layers"][0]["manifest"]["evidences"] = [e for e in lost["layers"][0]["manifest"]["evidences"]
    96	                                                  if e["channel"] != "repo"]
    97	    cases["d2"] = Case("d2", "honest receipt, repo evidence lost in custody", lost, honest, True,
    98	                       "strict: UNVERIFIABLE; degraded: VALID_DEGRADED, repo observation absent")
    99	    # (d3) the registered degraded cost: an attacker holding the leaked dns channel key runs its own
   100	    # copy of the issuer under Tessera's issuer id, with its own key, and mints its own TLR.
   101	    clone = Issuer(w.issuer.issuer_id, [KeyPair.generate("attacker-clone")], [Channel("dns", w.dns.key)],
   102	                   w.chain, w.params)
   103	    r3 = clone.issue(json.dumps(ev).encode(), T0 + 4 * HOUR)
   104	    cases["d3"] = Case("d3", "attacker clone issuer with leaked dns key (evil tarball, own TLR)", r3.shipped,
   105	                       evil, False, "strict: UNVERIFIABLE; degraded: VALID_DEGRADED (registered cost R-1.11, R-6.43)")
   106	
   107	    # (e) honest receipt; in the world, slot-B's key was revoked 60 s after the declared time,
   108	    # i.e. inside (declared, anchor]. The bundle bytes are identical to (a).
   109	    declared = full["layers"][0]["anchor"]["headers"][0]["time"] - full["issuance_record"]["observed_anchor_delay_s"]
   110	    cases["e"] = Case("e", "honest receipt; slot-B key revoked inside (declared, anchor]", full, honest, False,
   111	                      "INVALID (R-5.21): revocation effective at or before anchor_time",
   112	                      {"revoked": {w.skB2.fp: declared + 60}})
   113	
   114	    # (f) an impostor submits Acme's name with the evil tarball through the honest service.
   115	    r6 = w.issuer.issue(json.dumps(ev).encode(), T0 + 5 * HOUR)
   116	    cases["f"] = Case("f", "impostor submits 'Acme Corp' + evil tarball through the honest service",
   117	                      r6.shipped, evil, False, "VALID_STRICT, ESTABLISHED: the spec attests bytes, not submitters")
   118	    # (h) an honest renewal: a custodian wraps the complete honest receipt (R-7.46). The custodian's
   119	    # channel evidence is minted by the same stub channels (the model's one-key-per-channel reading).
   120	    skW = KeyPair.generate("custodian")
   121	    inner = full["layers"][0]
   122	    emb = [{"slot": s["slot"], "frame_b64": s["frame_b64"], "sig_b64": s["sig_b64"]} for s in inner["slots"]]
   123	    now = T0 + 6 * HOUR
   124	    outer = build_attest_layer(object_type="OT_WRAPPER", content={"renewal": "custodial wrap", "of": "acme-widget-1.4.2"},
   125	                               declared=now, issuer_id="archive.example", slot_keys=[skW], channels=[w.dns, w.repo],
   126	                               extra_common={"inner": {"cv": 1, "slots": emb}, "outer_cv": 1})
   127	    outer["anchor"] = anchor_layer(outer, w.chain, now, ChainSchedule(), w.params.k)
   128	    inner_entry = {"object_type": "OT_ATTEST", "manifest": inner["manifest"], "anchor": inner["anchor"],
   129	                   "slots": [{k: s[k] for k in ("slot", "alg", "pubkey_b64")} for s in inner["slots"]]}
   130	    wrapped = {"bundle_format": full["bundle_format"], "layers": [outer, inner_entry], "embedded": full["embedded"],
   131	               "standing": full["standing"]}
   132	    cases["h"] = Case("h", "honest custodial renewal wrapper around the complete honest receipt", wrapped, honest, True,
   133	                      "both layers VALID_STRICT; standing for wrapped layers is routed to S-P7 (R-6.44)")
   134	    return Scenario(w, sub, honest, evil, out.accepted_payload, cases)
