   586	(* Checks, in §1.2's order:                                             *)
   587	(*  1 accepted authority evidence, per channel, checksign(ev,kCh) =     *)
   588	(*    (STMT_DIGEST, h(t))                            [S-P1 / first link] *)
   589	(*  2 key binding: the frame's kfp is fp(kX), and mh = h(t)     [S-P3]   *)
   590	(*  3 set logic: the signed t's required set names the slot,            *)
   591	(*    fp(kX) = kfpr, every required slot satisfied              [S-P2]   *)
   592	(*  4 common content: ota = otb, cva = cvb, pla = plb, plus alg, id     *)
   593	(*    pinned through t                                       [S-P2 Q6]   *)
   594	(*  5 type, opacity and recorded-version checks                 [S-P7]   *)
   595	(*  6 possession over the ACCEPTED MANIFEST under the ACCEPTING KEY,    *)
   596	(*    checksign(ppf,kX) = (POSS,t)                       [S-P3 / S-P2]   *)
   597	(* (7 is the standing path, which runs in parallel — below.)            *)
   598	(* ==================================================================== *)
   599	let AttestStage(pkDv: pkey, pkRv: pkey) =
   600	  in(stageCh, (aid: bitstring, lyr: bitstring, ctx: bitstring,
   601	               kEnc: pkey, idEnc: bitstring,
   602	               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
   603	  in(envMat, (=aid, =lyr, t: bitstring, evD: bitstring, evR: bitstring,
   604	              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
   605	  (* CHECK 1 *)
   606	  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in
   607	  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in
   608	  event AuthorityEvidence(t, evD, pkDv);
   609	  event AuthorityEvidence(t, evR, pkRv);
   610	  let authTuple(id, kfprA, ss, alg, ver) = t in
   611	  ( (* ---------------- the one-signer branch ---------------- *)
   612	    ( if ss = signers0 then
   613	      if fp(kA) = kfprA then                                            (* 3 *)
   614	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
   615	      if mhA = h(t) then                                                (* 2 *)
   616	      if otA = OT_ATTEST then                                           (* 5 *)
   617	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   618	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   619	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   620	      event SlotSatisfied(aid, lyr, t, kfprA);
   621	      event AcceptanceComplete(aid, lyr, t);
   622	      event Accept(evD, evR, t, kA, fbA);
   623	      event ScopeReported(aid, lyr, kA, id);
   624	      ( out(link1aCh, (lyr, t, evD, evR))
   625	      | out(link2aCh, (lyr, t, kfprA, kA))
   626	      | out(possCh, (lyr, kA, t, ppfA))
   627	      | out(bytesCh, (lyr, kA, sgA, fbA))
   628	      | out(link5Ch, (lyr, t, kA, fbA))
   629	      | out(link6aCh, (lyr, OT_ATTEST, fbA))
   630	      | out(link6bCh, (aid, lyr, kA, id, fbA))
