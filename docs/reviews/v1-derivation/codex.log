   129	def merkle_root_and_paths(txids: list[bytes]) -> tuple[bytes, list[list[tuple[str, bytes]]]]:
   130	    """Bitcoin's tree: sha256d(left || right), last node duplicated on odd levels. Paths are
   131	    [(side, sibling)] with side 'R' = sibling goes on the right."""
   132	    paths: list[list[tuple[str, bytes]]] = [[] for _ in txids]
   133	    level = [(t, [i]) for i, t in enumerate(txids)]
   134	    while len(level) > 1:
   135	        if len(level) % 2:
   136	            level.append((level[-1][0], []))
   137	        nxt = []
   138	        for i in range(0, len(level), 2):
   139	            (a, ia), (b, ib) = level[i], level[i + 1]
   140	            for j in ia:
   141	                paths[j].append(("R", b))
   142	            for j in ib:
   143	                paths[j].append(("L", a))
   144	            nxt.append((sha256d(a + b), ia + ib))
   145	        level = nxt
   146	    return level[0][0], paths
