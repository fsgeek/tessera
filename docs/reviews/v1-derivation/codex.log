   106	def op_return_tx(commitment: bytes, salt: int) -> tuple[bytes, bytes, bytes]:
   107	    """A legacy-serialized one-in, one-out transaction whose output is OP_RETURN <32 bytes>.
   108	    Returns (tx, prefix, suffix) with tx == prefix || commitment || suffix -- the shape OTS calendars
   109	    use, so the proof is `prepend prefix, append suffix, sha256, sha256` -> txid."""
   110	    assert len(commitment) == 32
   111	    prev_out = hashlib.sha256(b"regtest-funding" + struct.pack("<I", salt)).digest() + struct.pack("<I", 0)
   112	    txin = prev_out + varint(0) + struct.pack("<I", 0xFFFFFFFD)
   113	    script = b"\x6a\x20" + commitment
   114	    txout = struct.pack("<q", 0) + varint(len(script)) + script
   115	    prefix = struct.pack("<i", 1) + varint(1) + txin + varint(1) + struct.pack("<q", 0) + varint(len(script)) + b"\x6a\x20"
   116	    suffix = struct.pack("<I", 0)  # locktime
   117	    tx = struct.pack("<i", 1) + varint(1) + txin + varint(1) + txout + suffix
   118	    assert tx == prefix + commitment + suffix
   119	    return tx, prefix, suffix
