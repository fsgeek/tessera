    98	def varint(n: int) -> bytes:
    99	    if n < 0xFD:
   100	        return bytes([n])
   101	    if n <= 0xFFFF:
   102	        return b"\xfd" + struct.pack("<H", n)
   103	    return b"\xfe" + struct.pack("<I", n)
