    36	@dataclass(frozen=True)
    37	class Header:
    38	    version: int
    39	    prev: bytes          # internal byte order
    40	    merkle_root: bytes   # internal byte order (what an OTS BitcoinBlockHeaderAttestation commits to)
    41	    time: int
    42	    bits: int
    43	    nonce: int
    44	
    45	    @classmethod
    46	    def parse(cls, raw: bytes) -> "Header":
    47	        if len(raw) != 80:
    48	            raise ValueError("header must be 80 bytes")
    49	        v, = struct.unpack("<i", raw[:4])
    50	        t, b, n = struct.unpack("<III", raw[68:80])
    51	        return cls(v, raw[4:36], raw[36:68], t, b, n)
    52	
    53	    def serialize(self) -> bytes:
    54	        return struct.pack("<i", self.version) + self.prev + self.merkle_root + struct.pack("<III", self.time, self.bits, self.nonce)
    55	
    56	    @property
    57	    def hash(self) -> bytes:
    58	        return sha256d(self.serialize())
    59	
    60	    @property
    61	    def hash_hex(self) -> str:          # display order, as block explorers print it
    62	        return self.hash[::-1].hex()
    63	
    64	    def pow_ok(self) -> bool:
    65	        return int.from_bytes(self.hash, "little") <= target_from_bits(self.bits)
