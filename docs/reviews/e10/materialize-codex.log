def subpackets(raw):
    c=Cursor(raw,'SIG_FORMAT'); out=[]
    while c.pos<len(raw):
        o=c.uint(1)
        if o<192: n=o
        elif o<255: n=((o-192)<<8)+c.uint(1)+192
        else:
