"""TEST-ONLY deterministic cryptography for the V1 conformance universe.

Every key here is derived from a public seed string and is labelled TEST. None of them protects anything.

Reuses formal/p8/vectors/gen.py for the P-256 arithmetic, RFC 6979 nonces, frame and anchor encoders, fingerprints
and the OpenPGP v4 signature digest (ENCODING-V1 §3.5), so frames are never re-implemented here.
"""
import base64
import hashlib
import struct
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "formal" / "p8" / "vectors"))
import gen  # noqa: E402  (P8 implementation A: encoders and primitives)

from cryptography.hazmat.primitives import hashes, serialization  # noqa: E402
from cryptography.hazmat.primitives.asymmetric import ed25519, padding, rsa  # noqa: E402

N = gen.N


def drbg(seed, n):
    """Deterministic byte stream: SHA-256 in counter mode over a TEST seed string."""
    out, i = b"", 0
    while len(out) < n:
        out += hashlib.sha256(f"TEST|{seed}|{i}".encode()).digest()
        i += 1
    return out[:n]


# ----------------------------------------------------------------------------------------------- P-256
class P256Key:
    """A TEST P-256 key. d derived from the seed; point computed with gen.py's arithmetic."""

    def __init__(self, seed, created=1790000000):
        self.seed = seed
        self.d = int.from_bytes(drbg("p256:" + seed, 32), "big") % (N - 1) + 1
        x, y = gen._mul(self.d, (gen.GX, gen.GY))
        self.x, self.y = x, y
        self.point = gen._point(x, y)                      # 04 || X || Y
        self.created = created                             # OpenPGP key-packet creation time

    @property
    def spki(self):
        return gen.spki_der(self.point)

    @property
    def pgp_body(self):
        return gen.openpgp_v4_body(self.point, self.created)

    @property
    def fp_kms(self):
        return gen.fp_kms(self.point)

    @property
    def fp_gpg(self):
        return gen.fp_gpg(self.point, self.created)

    @property
    def v4_fpr_sha1(self):
        body = self.pgp_body
        return hashlib.sha1(b"\x99" + struct.pack(">H", len(body)) + body).digest()

    def sign_digest(self, h, extra=b""):
        return gen.ecdsa_sign(self.d, h, extra)


# ----------------------------------------------------------------------------------------------- ML-DSA-65
class MLDSA65Key:
    """A TEST ML-DSA-65 key for the hybrid kms slot (formal/p8/HYBRID-SUPPLEMENT-DRAFT.md §1-§3).

    The key is generated by `cryptography` (FIPS 204 KeyGen from a 32-byte seed derived from the TEST seed string);
    the transported key is `cryptography`'s DER SubjectPublicKeyInfo, checked against the supplement's 22-byte
    prefix. Signing is the issuer's only path, EXTERNAL_MU (supplement §1, owner decision 6): mu is computed by
    `cryptography`'s MLDSAMuHasher from the public key and the frame (pure mode, empty context) and cross-checked
    against gen.py's formula; the signature is FIPS 204 Algorithm 7 from mu with rnd = 32 zero bytes (the
    deterministic variant, so the cases regenerate byte-identically; `cryptography` signs hedged only). Every
    signature is verified over the frame itself by `cryptography` before it is returned."""

    def __init__(self, seed):
        from cryptography.hazmat.primitives.asymmetric import mldsa
        self.seed = seed
        self.xi = drbg("mldsa65:" + seed, 32)
        self._ck = mldsa.MLDSA65PrivateKey.from_seed_bytes(self.xi)
        self._pub = self._ck.public_key()
        self.pk = self._pub.public_bytes_raw()
        gpk, self._gpriv = gen.mldsa65_keygen(self.xi)
        assert gpk == self.pk, "gen.py and cryptography derive different ML-DSA-65 keys from one seed"
        self.spki = self._pub.public_bytes(serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo)
        assert self.spki == gen.SPKI_MLDSA65_PREFIX + self.pk and len(self.spki) == 1974

    @property
    def fp_kms(self):
        return gen.fp_spki(self.spki)

    def mu(self, msg):
        from cryptography.hazmat.primitives.asymmetric import mldsa
        h = mldsa.MLDSAMuHasher(self._pub)
