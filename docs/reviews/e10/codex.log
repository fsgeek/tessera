def ts(s):
    """RFC 3339 'YYYY-MM-DDTHH:MM:SSZ' -> integer seconds (proleptic Gregorian, no leap seconds; P§7.1)."""
    y, mo, d = int(s[0:4]), int(s[5:7]), int(s[8:10])
    hh, mm, ss = int(s[11:13]), int(s[14:16]), int(s[17:19])
