    35	        for _ in range(rnd.randint(1,3)):
    36	            p = rnd.randrange(len(t)+1); op = rnd.random()
    37	            if op<0.4 and p<len(t): t[p]=rnd.choice(alphabet)
    38	            elif op<0.7: t.insert(p, rnd.choice(alphabet))
    39	            elif p<len(t): del t[p]
    40	    t = bytes(t)
    41	    a, b = va(lambda: A.ingest(t)), vb(lambda: B.ingest(t))
    42	    n += 1
    43	    if a=='OK' and b=='OK':
    44	        if A.jcs(A.ingest(t)) != B.jcs(B.ingest(t)): dis+=1; print('JCS DIFF', t)
    45	    elif a!=b: dis+=1; print('VERDICT DIFF', t, a, b) if dis<15 else None
    46	    codes[a]=codes.get(a,0)+1
    47	for _ in range(20000):
    48	    f = bytearray(rnd.choice(frames))
    49	    for _ in range(rnd.randint(1,2)):
    50	        p = rnd.randrange(len(f)); op=rnd.random()
    51	        if op<0.5: f[p]=rnd.randrange(256)
    52	        elif op<0.75: f.insert(p, rnd.randrange(256))
    53	        else: del f[p]
    54	    f = bytes(f); n += 1
    55	    a, b = va(lambda: A.decode_frame(f, A.T_ATTEST)), vb(lambda: B.frame_decode(f, 'attest'))
    56	    if a!=b: dis+=1; print('FRAME DIFF', a, b) if dis<15 else None
    57	    codes[a]=codes.get(a,0)+1
    58	print('cases', n, 'disagreements', dis); print(sorted(codes.items(), key=lambda x:-x[1]))
    59	sys.exit(1 if dis else 0)

codex
The historical DNSSEC and git evidence authenticates the key set, but does not show when those keys signed a receipt. Anchoring the exact signatures closes that gap. It supports post-break survival only conditionally: the verifier still needs a trusted historical security cutoff and a trustworthy time bound. Signature malleability also means a transformed copy would fail the original anchor check. I’ll record these limits and the required proof/vector changes in the review.
