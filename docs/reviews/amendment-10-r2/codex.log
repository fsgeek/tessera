from itertools import combinations
intervals=[(a,b) for a in range(6) for b in range(a,6)]
def overlap(x,y): return max(x[0],y[0])<=min(x[1],y[1])
def classify(t,entries,horizon):
    if t in entries: return 'PASS'
    if any(overlap(t[1:],e[1:]) for e in entries) or t[1]<=horizon: return 'INVALID'
    return 'UNVERIFIABLE'
checks=0
for a in range(6):
    for old_interval in intervals:
        old=(('A',*old_interval),)
        for new_interval in intervals:
            if new_interval[0]<=a or overlap(old_interval,new_interval): continue
            for new_key in ['A','B']:
                new=old+((new_key,*new_interval),)
                for next_a in range(a,6):
                    for key in ['A','B']:
                        for interval in intervals:
                            t=(key,*interval); before=classify(t,old,a); after=classify(t,new,next_a)
                            if before in ('PASS','INVALID'): assert before==after,(t,old,new,a,next_a,before,after)
                            checks+=1
print('local classifier append comparisons:',checks,'no prior PASS/INVALID changed')
