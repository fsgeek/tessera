    62	  for role in roles/cloudkms.signer roles/cloudkms.publicKeyViewer; do
    63	    $GC kms keys add-iam-policy-binding $KEY --keyring=$KEYRING --location=$REGION \
    64	      --member="serviceAccount:$SIGNER_SA" --role=$role >/dev/null
    65	  done
