   195	cd service/signer-gcp && .venv/bin/python -m pytest -q          # green first
   196	export REQUEST_QUEUE_URL=...  RESPONSE_QUEUE_URL=...  FRAME_BUCKET=...   # terraform output signer_queues / result_bucket
