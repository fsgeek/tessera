    48	ISSUER_SIGNER_ROLE=tessera-v1-issuer-signer-gpg                    # made by service/issuer/infra (signer_principals)
    49	FED_ROLE=tessera-v1-signer-gpg-federated                           # made here; the gpg entry of signer_principals
