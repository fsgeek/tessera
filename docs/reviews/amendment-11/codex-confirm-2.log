    40	INVOKER_SA=tessera-signer-invoker@$PROJECT.iam.gserviceaccount.com # Cloud Scheduler: run.invoker on the job only
    41	BUILDER_SA=slot2-builder@$PROJECT.iam.gserviceaccount.com          # Cloud Build: push to the repo only (exists)
    42	REPO=tessera-signer
