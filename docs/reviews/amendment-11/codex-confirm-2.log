   179	            raise Refuse("KEY_FP_MISMATCH", fp)
   180	        if kind == "attest":
   181	            declared = ts(obj["common"]["declared_issue_time"])
   182	            if abs(declared - now) > EPS:
   183	                raise Refuse("DECLARED_TIME_OUTSIDE_EPSILON",
   184	                             f"declared {rfc3339(declared)}, signer clock {rfc3339(now)}, epsilon {EPS} s")
   185	        return kind
   186	
   187	    def _stopped(self, now, sign_by):
   188	        if now > self.sign_until:
   189	            return f"clock {rfc3339(now)} past the signing stop {rfc3339(self.sign_until)}"
   190	        if now > sign_by:
   191	            return f"clock {rfc3339(now)} past sign_by {rfc3339(sign_by)}"
   192	        return None
   193	
   194	    # ------------------------------------------------------------------------------------------- signing
   195	    def verify(self, frame, sig):
   196	        """The issuer's check (signers.verify_slot_signature): rule-R codec, then ML-DSA-65 over the exact frame."""
   197	        try:
   198	            parsed = parse_signature(sig, HYBRID_ALG, "kms", REGISTRY)
   199	            sig_policy(parsed)
   200	            return signature_verifies(frame, parsed, self.pub)
   201	        except Fault:
   202	            return False
   203	
   204	    def _kms_sign(self, frame):
   205	        try:
   206	            sig = self.kms.sign(KeyId=self.key_id, Message=external_mu(self.pk_raw, frame), MessageType="EXTERNAL_MU",
   207	                                SigningAlgorithm="ML_DSA_SHAKE_256")["Signature"]
   208	        except Exception as e:  # noqa: BLE001  KMS or network: transient
   209	            raise Retry(f"kms sign: {type(e).__name__}: {e}") from None
   210	        return bytes(sig)
   211	
   212	    # ------------------------------------------------------------------------------------------- one message
   213	    def _signer_info(self, now):
   214	        return {"clock": rfc3339(now), "slot": self.slot, "key_fp": self.fp, "epsilon_s": EPS,
   215	                "sign_until": rfc3339(self.sign_until)}
   216	
   217	    def handle(self, body, receive_count=1, message_id=None):
   218	        """-> the response dict to send, or raises Retry (the message is left for redelivery)."""
   219	        rid, frame_sha, sig_sha, now = None, None, None, self.clock()
   220	        line = {"event": None, "message_id": message_id, "receive_count": receive_count, "slot": self.slot,
   221	                "key_fp": self.fp}
   222	        try:
   223	            try:
   224	                req = self._request(body)
   225	                rid = req.get("request_id")
   226	                if not isinstance(rid, str) or not RE_RID.fullmatch(rid):
   227	                    rid = None
   228	                    raise Refuse("BAD_REQUEST", "request_id")
   229	                frame, sign_by = self._frame(req)
   230	                frame_sha = sha256hex(frame)
   231	                kind = self.check_frame(frame, self.clock())
   232	                now = self.clock()                    # IS-03: immediately before the signing operation
   233	                stopped = self._stopped(now, sign_by)
   234	                if stopped:
   235	                    raise Refuse("SIGNING_STOPPED", stopped)
   236	                sig = self._kms_sign(frame)
   237	                sig_sha = sha256hex(sig)
   238	                if not self.verify(frame, sig):
   239	                    raise Retry(f"KMS signature {sig_sha} does not verify over the full frame")
   240	                now = self.clock()
   241	                stopped = self._stopped(now, sign_by)
   242	                if stopped:                           # signed, but returned after the stop: withheld
   243	                    raise Refuse("SIGNING_STOPPED", "signature withheld: " + stopped)
   244	            except Retry as e:
   245	                if receive_count < MAX_RECEIVES:
   246	                    self.log(dict(line, event="retry", request_id=rid, frame_sha256=frame_sha,
   247	                                  signature_sha256=sig_sha, detail=str(e)))
   248	                    raise
   249	                raise Refuse("SIGNING_ERROR", f"after {receive_count} receives: {e}") from None
   250	            except Refuse:
   251	                raise
   252	            except Exception as e:  # noqa: BLE001  a bug must not drop the request silently or loop forever
   253	                if receive_count < MAX_RECEIVES:
   254	                    self.log(dict(line, event="retry", request_id=rid, frame_sha256=frame_sha,
   255	                                  signature_sha256=sig_sha, detail=f"{type(e).__name__}: {e}"))
   256	                    raise Retry(str(e)) from None
   257	                raise Refuse("INTERNAL_ERROR", f"{type(e).__name__}: {e}") from None
   258	        except Refuse as r:
   259	            resp = {"request_id": rid, "status": "REFUSED", "reason": r.reason, "detail": r.detail,
   260	                    "signer": self._signer_info(now)}
   261	            if frame_sha:
   262	                resp["frame_sha256"] = frame_sha
   263	            self.log(dict(line, event="refused", request_id=rid, frame_sha256=frame_sha, signature_sha256=sig_sha,
   264	                          reason=r.reason, detail=r.detail, clock=rfc3339(now)))
   265	            return resp
   266	        self.log(dict(line, event="signed", request_id=rid, frame_sha256=frame_sha, signature_sha256=sig_sha,
   267	                      kind=kind, clock=rfc3339(now)))
   268	        return {"request_id": rid, "status": "SIGNED", "sig_b64": b64e(sig), "frame_sha256": frame_sha,
   269	                "signer": self._signer_info(now)}
     1	# Deploying the V1 issuer and its signers (owner, 2026-10-27)
