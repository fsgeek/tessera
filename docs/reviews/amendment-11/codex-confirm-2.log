    31	# registration commits to deleting (formal/p8/HYBRID-SUPPLEMENT.md §11 item 6). No defaults: set all four.
    32	KEY="${SLOT2_KEY:-}"                # the production key's name in $KEYRING
    33	KEY_VERSION_N="${SLOT2_KEY_VERSION:-1}"
    34	KEY_CREATED="${SLOT2_KEY_CREATED:-}" # that version's createTime (epoch seconds), bound into KEY_FP
    35	KEY_FP="${SLOT2_KEY_FP:-}"           # gpg-sha256:... of the v4 public-key packet built with KEY_CREATED
    36	KEY_VERSION="projects/$PROJECT/locations/$REGION/keyRings/$KEYRING/cryptoKeys/$KEY/cryptoKeyVersions/$KEY_VERSION_N"
