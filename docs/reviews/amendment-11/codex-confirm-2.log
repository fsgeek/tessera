    97	  $GC builds submit "$ctx" --region=$REGION --config="$ctx/signer-gcp/cloudbuild.yaml" \
    98	    --substitutions=_IMAGE="$IMAGE_BASE:$tag" \
    99	    --service-account="projects/$PROJECT/serviceAccounts/$BUILDER_SA" \
   100	    --gcs-source-staging-dir="$SRC_BUCKET/source"
   101	  rm -rf -- "${ctx:?}"
