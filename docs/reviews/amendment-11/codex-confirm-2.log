    52	say() { printf '\n== %s\n' "$*"; }
    53	need() { [ -n "${!1:-}" ] || { echo "$1 is not set (see the header of $0)"; exit 2; }; }
    54	
    55	sas() {
    56	  say "service accounts (no keys are ever created for them)"
    57	  for sa in tessera-signer-gpg:"Tessera V1 slot-2 signer runtime" tessera-signer-invoker:"Tessera V1 slot-2 signer scheduler"; do
    58	    name=${sa%%:*}; desc=${sa#*:}
    59	    $GC iam service-accounts describe "$name@$PROJECT.iam.gserviceaccount.com" >/dev/null 2>&1 \
    60	      || $GC iam service-accounts create "$name" --display-name="$desc"
