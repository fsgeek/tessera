    22	AWS="$HOME/.local/bin/aws --profile tessera --region us-east-2"
    23	GCLOUD="$HOME/.local/bin/gcloud"
    24	GC="$GCLOUD --project=tessera-slot2 --quiet"
    25	ACCOUNT=477139661040
    26	PROJECT=tessera-slot2
    27	PROJECT_NUMBER=990386490765
    28	REGION=us-east1
    29	KEYRING=tessera-v1
