    64	need_key() { for v in SLOT2_KEY SLOT2_KEY_CREATED SLOT2_KEY_FP; do need $v; done
    65	  [ "$KEY" != "$SPIKE_KEY" ] || { echo "SLOT2_KEY is the spike key; V1 uses a new production key"; exit 2; }; }
    66	
    67	keyiam() {
    68	  need_key
    69	  say "key IAM: $SIGNER_SA gets cloudkms.signer + cloudkms.publicKeyViewer on $KEY only"
    70	  for role in roles/cloudkms.signer roles/cloudkms.publicKeyViewer; do
    71	    $GC kms keys add-iam-policy-binding $KEY --keyring=$KEYRING --location=$REGION \
    72	      --member="serviceAccount:$SIGNER_SA" --role=$role >/dev/null
