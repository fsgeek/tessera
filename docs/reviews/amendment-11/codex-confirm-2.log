   106	signer_uid() { $GC iam service-accounts describe "$SIGNER_SA" --format='value(uniqueId)'; }
   107	
   108	role() {
   109	  say "AWS role $FED_ROLE: web identity (accounts.google.com), only $SIGNER_SA; may only assume $ISSUER_SIGNER_ROLE"
   110	  local uid; uid="$(signer_uid)"
   111	  local trust; trust=$(cat <<EOF
   112	{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Federated":"accounts.google.com"},
   113	 "Action":"sts:AssumeRoleWithWebIdentity",
   114	 "Condition":{"StringEquals":{"accounts.google.com:sub":"$uid","accounts.google.com:aud":"$uid",
   115	                              "accounts.google.com:oaud":"$AUDIENCE"}}}]}
   116	EOF
   117	)
   118	  local perms; perms=$(cat <<EOF
   119	{"Version":"2012-10-17","Statement":[{"Sid":"ChainToIssuerSignerRole","Effect":"Allow","Action":"sts:AssumeRole",
   120	 "Resource":"arn:aws:iam::$ACCOUNT:role/$ISSUER_SIGNER_ROLE"}]}
   121	EOF
   122	)
   123	  if $AWS iam get-role --role-name $FED_ROLE >/dev/null 2>&1; then
   124	    $AWS iam update-assume-role-policy --role-name $FED_ROLE --policy-document "$trust"
   125	  else
   126	    $AWS iam create-role --role-name $FED_ROLE --assume-role-policy-document "$trust" --max-session-duration 3600 \
   127	      --description "Tessera V1 slot-2 signer (GCP $SIGNER_SA): web identity, chains to $ISSUER_SIGNER_ROLE" \
   128	      --tags Key=project,Value=tessera Key=purpose,Value=signer-gpg --query Role.Arn --output text
   129	  fi
   130	  $AWS iam put-role-policy --role-name $FED_ROLE --policy-name chain-to-issuer-signer --policy-document "$perms"
   131	  echo "set signer_principals = { gpg = \"arn:aws:iam::$ACCOUNT:role/$FED_ROLE\" } in the issuer's tfvars"
   132	}
   133	
   134	job() {
   135	  need_key
   136	  need REQUEST_QUEUE_URL; need RESPONSE_QUEUE_URL; need FRAME_BUCKET; need SIGN_UNTIL
   137	  say "Cloud Run job $JOB (a job, not a service: no endpoint)"
   138	  local digest; digest="$(cat "$HERE/.image-digest")"
   139	  local env="REQUEST_QUEUE_URL=$REQUEST_QUEUE_URL,RESPONSE_QUEUE_URL=$RESPONSE_QUEUE_URL,FRAME_BUCKET=$FRAME_BUCKET"
   140	  env+=",AWS_ROLE_ARN=arn:aws:iam::$ACCOUNT:role/$FED_ROLE,AWS_AUDIENCE=$AUDIENCE,AWS_REGION_QUEUES=us-east-2"
   141	  env+=",AWS_CHAIN_ROLE_ARN=arn:aws:iam::$ACCOUNT:role/$ISSUER_SIGNER_ROLE"
   142	  env+=",KMS_KEY_VERSION=$KEY_VERSION,KEY_CREATED=$KEY_CREATED,KEY_FP=$KEY_FP,SIGN_UNTIL=$SIGN_UNTIL"
   143	  env+=",SIGNER_IMAGE=$IMAGE_BASE@$digest,RUN_SECONDS=40,WAIT_SECONDS=5,VISIBILITY_SECONDS=120"
   144	  $GC run jobs deploy $JOB --region=$REGION --image="$IMAGE_BASE@$digest" --service-account="$SIGNER_SA" \
   145	    --set-env-vars="$env" --tasks=1 --parallelism=1 --max-retries=0 --task-timeout=150s \
   146	    --cpu=1 --memory=512Mi --labels=project=tessera,purpose=signer-gpg
   147	  $GC run jobs add-iam-policy-binding $JOB --region=$REGION \
   148	    --member="serviceAccount:$INVOKER_SA" --role=roles/run.invoker >/dev/null
   149	}
   150	
   151	scheduler() {
   152	  say "Cloud Scheduler $SCHED: every minute, runs the job as $INVOKER_SA (OAuth); E-01: keep it running while signing is possible"
   153	  local uri="https://run.googleapis.com/v2/projects/$PROJECT/locations/$REGION/jobs/$JOB:run"
   154	  if $GC scheduler jobs describe $SCHED --location=$REGION >/dev/null 2>&1; then
   155	    $GC scheduler jobs update http $SCHED --location=$REGION --schedule="* * * * *" --uri="$uri" \
   156	      --http-method=POST --oauth-service-account-email="$INVOKER_SA"
   157	  else
   158	    $GC scheduler jobs create http $SCHED --location=$REGION --schedule="* * * * *" --uri="$uri" \
   159	      --http-method=POST --oauth-service-account-email="$INVOKER_SA" --time-zone=UTC --attempt-deadline=60s
   160	  fi
   161	}
   162	
   163	harden() {
   164	  need_key
   165	  say "check: no project-level grant that can change the job or the key (the 2026-10-14 removals still hold)"
   166	  $GC projects remove-iam-policy-binding $PROJECT --condition=None \
   167	    --member="serviceAccount:$PROJECT_NUMBER-compute@developer.gserviceaccount.com" --role=roles/editor >/dev/null 2>&1 || true
   168	  $GC projects remove-iam-policy-binding $PROJECT --condition=None \
   169	    --member="serviceAccount:$PROJECT_NUMBER@cloudbuild.gserviceaccount.com" --role=roles/cloudbuild.builds.builder >/dev/null 2>&1 || true
   170	  $GC projects get-iam-policy $PROJECT --format=json
   171	  $GC kms keys get-iam-policy $KEY --keyring=$KEYRING --location=$REGION --format=json
   172	}
   173	
   174	OLD_SA=slot2-signer@$PROJECT.iam.gserviceaccount.com              # the 2026-10-14 instrument's runtime account
   175	
   176	# SG-03: absent is the only tolerated failure. gone CMD... succeeds iff CMD reports that the thing does not exist.
   177	gone() { local out; if out=$("$@" 2>&1); then return 1; fi; grep -qiE 'not.?found|cannot find|does not exist' <<<"$out"; }
   178	die() { echo "retire-instrument: $*" >&2; exit 1; }
   179	
   180	retire_instrument() {
   181	  say "retire the 2026-10-14 instrument: its job reads another queue and can also cause $SPIKE_KEY signatures"
   182	  gone $GC scheduler jobs describe slot2-signer-tick --location=$REGION \
   183	    || $GC scheduler jobs delete slot2-signer-tick --location=$REGION
   184	  gone $GC run jobs describe slot2-signer --region=$REGION || $GC run jobs delete slot2-signer --region=$REGION
   185	  for role in roles/cloudkms.signer roles/cloudkms.publicKeyViewer; do
   186	    if $GC kms keys get-iam-policy $SPIKE_KEY --keyring=$KEYRING --location=$REGION --format=json | grep -q "$OLD_SA"; then
   187	      $GC kms keys remove-iam-policy-binding $SPIKE_KEY --keyring=$KEYRING --location=$REGION \
   188	        --member="serviceAccount:$OLD_SA" --role=$role >/dev/null
   189	    fi
   190	  done
   191	  # Disabling the account ends every route through it at once, including grants inherited from the project.
   192	  gone $GC iam service-accounts describe "$OLD_SA" || $GC iam service-accounts disable "$OLD_SA"
   193	
   194	  say "verify: nothing of the instrument can still sign"
   195	  gone $GC scheduler jobs describe slot2-signer-tick --location=$REGION || die "scheduler slot2-signer-tick remains"
   196	  gone $GC run jobs describe slot2-signer --region=$REGION || die "job slot2-signer remains"
   197	  ! $GC kms keys get-iam-policy $SPIKE_KEY --keyring=$KEYRING --location=$REGION --format=json | grep -q "$OLD_SA" \
   198	    || die "$OLD_SA still bound on $SPIKE_KEY"
   199	  ! $GC projects get-iam-policy $PROJECT --format=json | grep -q "$OLD_SA" || die "$OLD_SA still bound on $PROJECT"
   200	  gone $GC iam service-accounts describe "$OLD_SA" \
   201	    || [ "$($GC iam service-accounts describe "$OLD_SA" --format='value(disabled)')" = "True" ] \
   202	    || die "$OLD_SA is not disabled"
   203	  say "instrument retired and verified"
   204	}
   205	
   206	run_now() { $GC run jobs execute $JOB --region=$REGION --wait; }
   207	
   208	case "${1:-}" in
   209	  sas|keyiam|registry|build|role|job|scheduler|harden) "$1" ;;
   210	  run-now) run_now ;;
   211	  retire-instrument) retire_instrument ;;
   212	  *) echo "usage: $0 sas|role|keyiam|registry|build|job|run-now|scheduler|harden|retire-instrument"; exit 2 ;;
   213	esac
