    33	# The signer role is the only principal allowed kms:Sign (and kms:GetPublicKey). Account administration keeps the
    34	# key manageable but holds neither; the Deny makes an IAM grant of kms:Sign to any other principal ineffective, so
    35	# obtaining a signature otherwise needs PutKeyPolicy or a change to the signer role or its code: management events,
    36	# recorded by the trail below. That an IAM administrator can do those is C3 (README "Who can cause a signature").
    37	data "aws_iam_policy_document" "key" {
    38	  statement {
    39	    sid = "KeyAdministrationWithoutSign"
    40	    actions = [
    41	      "kms:CancelKeyDeletion", "kms:CreateAlias", "kms:DeleteAlias", "kms:DescribeKey", "kms:DisableKey",
    42	      "kms:EnableKey", "kms:GetKeyPolicy", "kms:GetKeyRotationStatus", "kms:ListAliases", "kms:ListGrants",
    43	      "kms:ListKeyPolicies", "kms:ListResourceTags", "kms:PutKeyPolicy", "kms:RetireGrant", "kms:RevokeGrant",
    44	      "kms:ScheduleKeyDeletion", "kms:TagResource", "kms:UntagResource", "kms:UpdateAlias", "kms:UpdateKeyDescription",
    45	    ]
    46	    resources = ["*"]
