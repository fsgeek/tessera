    37	def verify_slot_signature(slot, key_bytes, frame, sig):
    38	    """Rule R (kms) or rule O (gpg) codec and policy, then the signature over the exact frame bytes, with the
    39	    service verifier's own functions."""
    40	    try:
    41	        parsed = parse_signature(sig, ALG, slot, REGISTRY)
