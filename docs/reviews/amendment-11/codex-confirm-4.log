    48	class SlotSigner:
    49	    """Issuer side of one slot: its public key and its two queues."""
    50	
    51	    def __init__(self, slot, key_bytes, requests, responses, wake=None):
    52	        if slot not in SLOTS:
    53	            raise ValueError(slot)
    54	        public_key(key_bytes, slot, ALG)                 # KEY_FORMAT gate
    55	        self.slot, self.key_bytes = slot, key_bytes
    56	        self.fp = fp_kms(key_bytes) if slot == "kms" else fp_gpg(key_bytes)
    57	        self.requests, self.responses, self._wake = requests, responses, wake
    58	
    59	    def send(self, rid, frame, sign_by=None, stash=None):
    60	        """stash(frame) -> object reference, used when the inline message would be too large (IS-09)."""
    61	        msg = {"request_id": rid, "frame_b64": b64e(frame)}
    62	        if sign_by is not None:
    63	            msg["sign_by"] = rfc3339(sign_by)
    64	        body = json.dumps(msg, sort_keys=True)
    65	        if len(body.encode()) > INLINE_MAX:
    66	            if stash is None:
    67	                raise ValueError("frame too large for an inline signer request")
    68	            del msg["frame_b64"]
    69	            msg.update(frame_ref=stash(frame), frame_sha256=sha256hex(frame))
    70	            body = json.dumps(msg, sort_keys=True)
    71	        self.requests.send(body)
    72	
    73	    def wake(self):
    74	        if self._wake is not None:
    75	            self._wake(self.slot)
    76	
    77	    def receive(self, max_messages=10):
    78	        out = []
    79	        for m in self.responses.receive(max_messages):
    80	            try:
    81	                body = json.loads(m.body)
    82	                if not isinstance(body, dict):
    83	                    raise ValueError
    84	            except ValueError:
    85	                body = {"_unparseable": m.body[:200]}
    86	            out.append((m.handle, body))
    87	        return out
    88	
    89	    def ack(self, handle):
    90	        self.responses.delete(handle)
    91	
    92	    def verify(self, frame, sig):
    93	        return verify_slot_signature(self.slot, self.key_bytes, frame, sig)
