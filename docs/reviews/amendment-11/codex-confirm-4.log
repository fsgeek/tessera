    95	def run_sig(v, keys, docs):
    96	    """Function-level harness for one signature against one known-good key: signature codec (the function of rows
    97	    3.1/9.3), policy (9.1/9.4), then verification (9.2/9.5). Returns 'ACCEPT', the Fault code, or 'SIG_INVALID'
    98	    (POSSESSION_INVALID for a possession proof: same function, different row). It is NOT the bundle's order: a
    99	    bundle evaluates keys (5.1) before signature policy (9.1) and reports by row precedence. Precedence claims come
   100	    only from TestBundle."""
   101	    alg, slot = v['alg'], v['slot']
   102	    try:
   103	        parsed = parse_signature(bytes.fromhex(v['sig_hex']), alg, slot, registered_codecs(alg))
   104	        sig_policy(parsed)
   105	    except Fault as e:
   106	        return e.code
   107	    k = keys[v['key']]
   108	    key = public_key(bytes.fromhex(k['hex']), k['slot'], k['alg'])
   109	    return 'ACCEPT' if signature_verifies(bytes.fromhex(docs[v['document']]), parsed, key) else 'SIG_INVALID'
