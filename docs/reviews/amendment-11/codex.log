    24	EPS = 24 * 3600                      # A9.2: refuse iff |declared - clock| > EPS
    25	MAX_BODY = 1 << 20                   # one SQS message, bytes (the SQS maximum)
    26	MAX_FRAME = 1 + 255 + 2 + 4 + (1 << 24)   # the largest frame the codec can accept (ENCODING-V1 §2)
    27	T_ATTEST, T_MANIFEST = "tessera-v1/attest", "tessera-v1/manifest"
    28	RE_REQID = re.compile(r"[A-Za-z0-9._:-]{1,128}")
    29	RE_REF = re.compile(r"frames/[A-Za-z0-9._-]{1,128}/[0-9a-f]{64}")
    30	INLINE_KEYS = frozenset(("request_id", "sign_by", "frame_b64"))
    31	REF_KEYS = frozenset(("request_id", "sign_by", "frame_ref", "frame_sha256"))
    32	
