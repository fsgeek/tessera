   295	    digest=sha(document+sig.trailer)
   296	    if digest[:2]!=sig.prefix: return False
   297	    try: key.verify(utils.encode_dss_signature(sig.r,sig.s),digest,ec.ECDSA(utils.Prehashed(hashes.SHA256()))); return True
