    78	build() {
    79	  say "stage signer-gcp + verifier, build the image (Cloud Build, builder SA)"
    80	  local ctx; ctx="$(mktemp -d)"
    81	  mkdir -p "$ctx/signer-gcp" "$ctx/verifier"
    82	  cp "$HERE"/{Dockerfile,requirements.txt,pyproject.toml,cloudbuild.yaml} "$ctx/signer-gcp/"
