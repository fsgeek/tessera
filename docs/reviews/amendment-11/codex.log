    70	def run_sig(v, keys, docs):
    71	    """Function-level harness for one signature against one known-good key: signature codec (the function of rows
    72	    3.1/9.3), policy (9.1/9.4), then verification (9.2/9.5). Returns 'ACCEPT', the Fault code, or 'SIG_INVALID'
    73	    (POSSESSION_INVALID for a possession proof: same function, different row). It is NOT the bundle's order: a
    74	    bundle evaluates keys (5.1) before signature policy (9.1) and reports by row precedence. Precedence claims come
    75	    only from TestBundle."""
    76	    alg, slot = v['alg'], v['slot']
    77	    try:
    78	        parsed = parse_signature(bytes.fromhex(v['sig_hex']), alg, slot, registered_codecs(alg))
    79	        sig_policy(parsed)
    80	    except Fault as e:
    81	        return e.code
    82	    k = keys[v['key']]
    83	    key = public_key(bytes.fromhex(k['hex']), k['slot'], k['alg'])
    84	    return 'ACCEPT' if signature_verifies(bytes.fromhex(docs[v['document']]), parsed, key) else 'SIG_INVALID'
    85	
    86	
    87	def run_key(v):
    88	    try:
    89	        public_key(bytes.fromhex(v['key_hex']), v['slot'], v['alg'])
    90	        return 'ACCEPT'
    91	    except Fault as e:
    92	        return e.code
