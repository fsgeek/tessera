    53	class StartupError(Exception):
    54	    """The signer refuses to run at all (wrong key, wrong configuration)."""
    55	
    56	
    57	class Signer:
    58	    def __init__(self, cfg, kms, sqs, s3, clock, monotonic, log):
    59	        self.cfg, self.kms, self.sqs, self.s3 = cfg, kms, sqs, s3
    60	        self.clock, self.monotonic, self.log = clock, monotonic, log
    61	        self.code = code_sha256()
    62	        self.issued = {}                  # (request_id, frame sha256) -> packet, this run only
    63	        self.pub = self.key_bytes = self.fpr = None
    64	
    65	    # ------------------------------------------------------------------------------------------ the key
    66	    def load_key(self):
    67	        """Fetch the HSM public key and check it against the pinned version, algorithm, protection level and
    68	        fingerprint before anything is signed."""
    69	        pk = self.kms.public_key()
    70	        if pk.get("name") != self.cfg.key_version:
    71	            raise StartupError(f"KMS returned key version {pk.get('name')!r}, not {self.cfg.key_version!r}")
    72	        if pk.get("algorithm") != KMS_ALGORITHM:
    73	            raise StartupError(f"key algorithm {pk.get('algorithm')!r}, not {KMS_ALGORITHM}")
    74	        if pk.get("protectionLevel") != "HSM":
    75	            raise StartupError(f"key protection level {pk.get('protectionLevel')!r}, not HSM")
    76	        try:
    77	            pub = serialization.load_pem_public_key(pk["pem"].encode())
    78	        except (KeyError, ValueError, TypeError) as e:
    79	            raise StartupError(f"KMS public key does not load: {e!r}") from None
    80	        if not isinstance(pub, ec.EllipticCurvePublicKey) or pub.curve.name != "secp256r1":
    81	            raise StartupError("KMS public key is not P-256")
    82	        body = openpgp.key_body(openpgp.point65(pub), self.cfg.key_created)
    83	        fp = openpgp.fp_gpg(body)
    84	        if fp != self.cfg.key_fp:
    85	            raise StartupError(f"HSM key fingerprint {fp} is not the pinned {self.cfg.key_fp}; refusing to run")
    86	        self.pub, self.key_bytes, self.fpr = pub, body, openpgp.v4_fingerprint(body)
    87	        self.verify_key = public_key(body, SLOT, ALG)      # the verifier's own key gate (KEY_FORMAT)
    88	
    89	    # ------------------------------------------------------------------------------------------ signing
    90	    def sign(self, frame, created):
    91	        """One rule-O packet over the exact frame, created at `created`; checked with the service verifier's own
    92	        functions (the checks the issuer runs) before it is returned."""
    93	        hashed = openpgp.hashed_area(self.fpr, created)
    94	        unhashed = openpgp.subpacket(16, self.fpr[-8:])
    95	        digest = openpgp.sig_digest(frame, hashed)
    96	        der = self.kms.sign_digest(digest)
    97	        self.pub.verify(der, digest, ec.ECDSA(utils.Prehashed(hashes.SHA256())))   # raises if the HSM output is bad
    98	        r, s = utils.decode_dss_signature(der)
    99	        packet = openpgp.sig_packet(hashed, unhashed, digest[:2], r, s)
   100	        try:
   101	            parsed = parse_signature(packet, ALG, SLOT, REGISTRY)
   102	            sig_policy(parsed)
   103	            ok = signature_verifies(frame, parsed, self.verify_key)
   104	        except Fault as e:
   105	            raise RuntimeError(f"self-check: {e.code}") from None
   106	        if not ok:
   107	            raise RuntimeError("self-check: the packet does not verify on the frame")
   108	        return packet
   109	
   110	    # ------------------------------------------------------------------------------------------ one message
   111	    def _signer_info(self, clock):
   112	        c = self.cfg
   113	        return {"slot": SLOT, "clock": isotime(clock), "code_sha256": self.code, "image": c.image,
   114	                "key_version": c.key_version, "key_fp": c.key_fp, "epsilon_s": EPS, "alg": ALG,
   115	                "sign_until": isotime(c.sign_until)}
   116	
   117	    def _receives(self, msg):
   118	        try:
   119	            return int(msg.get("Attributes", {}).get("ApproximateReceiveCount", "1"))
   120	        except ValueError:
   121	            return 1
   122	
   123	    def _transient(self, msg, rid, reason, exc):
   124	        """Leave the message for redelivery (None), or after MAX_RECEIVES deliveries refuse with `reason`."""
   125	        if self._receives(msg) < MAX_RECEIVES:
   126	            self.log(event="transient_retry", request_id=rid, reason=reason, error=repr(exc)[:500])
   127	            return None
   128	        raise Refuse(reason, repr(exc)[:500])
   129	
   130	    def fetch(self, req, msg):
   131	        """IS-09: the object at frame_ref, accepted only if its SHA-256 is frame_sha256. None: retry later."""
   132	        try:
   133	            obj = self.s3.get_object(Bucket=self.cfg.frame_bucket, Key=req.frame_ref)
   134	        except Exception as e:  # noqa: BLE001
   135	            if _not_found(e):
   136	                raise Refuse("FRAME_UNAVAILABLE", req.frame_ref) from None
   137	            return self._transient(msg, req.request_id, "FRAME_UNAVAILABLE", e)
   138	        size = obj.get("ContentLength")
   139	        if isinstance(size, int) and size > policy.MAX_FRAME:
   140	            raise Refuse("FRAME_UNAVAILABLE", f"object of {size} bytes exceeds {policy.MAX_FRAME}")
   141	        try:
   142	            frame = obj["Body"].read(policy.MAX_FRAME + 1)
   143	        except Exception as e:  # noqa: BLE001
   144	            return self._transient(msg, req.request_id, "FRAME_UNAVAILABLE", e)
   145	        if len(frame) > policy.MAX_FRAME:
   146	            raise Refuse("FRAME_UNAVAILABLE", f"object exceeds {policy.MAX_FRAME} bytes")
   147	        if hashlib.sha256(frame).hexdigest() != req.frame_sha256:
   148	            raise Refuse("FRAME_DIGEST_MISMATCH", f"object at {req.frame_ref} is not {req.frame_sha256}")
   149	        return frame
   150	
   151	    def handle(self, msg):
   152	        """Answer one request message and delete it, or leave it on the queue for a later delivery.
   153	        -> the response sent, or None."""
   154	        clock = self.clock()
   155	        resp = {"v": 1, "sqs_message_id": msg.get("MessageId"), "request_id": None,
   156	                "signer": self._signer_info(clock)}
   157	        try:
   158	            obj = policy.load(msg.get("Body"))
   159	            resp["request_id"] = policy.request_id(obj)
   160	            req = policy.parse(obj)
   161	            frame = policy.inline_frame(req) if req.frame_b64 is not None else self.fetch(req, msg)
   162	            if frame is None:
   163	                return None
   164	            fsha = resp["frame_sha256"] = hashlib.sha256(frame).hexdigest()
   165	            now = self.clock()                           # SG-02: after the frame is in hand; IS-03: just before signing
   166	            kind, _ = policy.check_frame(frame, self.cfg.key_fp, now)
   167	            policy.check_stop(now, self.cfg.sign_until, req.sign_by)    # SG-01: for a resend as well
   168	            packet = self.issued.get((req.request_id, fsha))
   169	            if packet is None:
   170	                try:
   171	                    packet = self.sign(frame, now)
   172	                except Exception as e:  # noqa: BLE001  KMS, network, or a failed self-check
   173	                    return self._transient(msg, req.request_id, "SIGNER_ERROR", e)
   174	                try:
   175	                    policy.check_stop(self.clock(), self.cfg.sign_until, req.sign_by)
   176	                except Refuse:                           # SG-01: the HSM signed after a cutoff: withheld, logged
   177	                    self.log(event="withheld", request_id=req.request_id, frame_sha256=fsha,
   178	                             sig_sha256=hashlib.sha256(packet).hexdigest(), created=isotime(now))
   179	                    raise
   180	                self.issued[(req.request_id, fsha)] = packet
   181	                self.log(event="signed", request_id=req.request_id, frame_sha256=fsha,
   182	                         sig_sha256=hashlib.sha256(packet).hexdigest(), created=isotime(now), kind=kind)
   183	            else:
   184	                self.log(event="resent", request_id=req.request_id, frame_sha256=fsha,
   185	                         sig_sha256=hashlib.sha256(packet).hexdigest())
   186	            resp.update(status="SIGNED", kind=kind, sig_b64=base64.b64encode(packet).decode("ascii"),
   187	                        sig_sha256=hashlib.sha256(packet).hexdigest())
   188	        except Refuse as r:
   189	            resp.update(status="REFUSED", reason=r.code, detail=r.detail[:500])        # signed nothing
   190	        except Exception as e:  # noqa: BLE001  a codec bug or unexpected input: refuse, never sign
   191	            resp.update(status="REFUSED", reason="INTERNAL", detail=repr(e)[:500])
   192	        self.sqs.send_message(QueueUrl=self.cfg.response_queue_url, MessageBody=_dumps(resp))
   193	        self.sqs.delete_message(QueueUrl=self.cfg.request_queue_url, ReceiptHandle=msg["ReceiptHandle"])
   194	        self.log(event="response", request_id=resp["request_id"], sqs_message_id=resp["sqs_message_id"],
   195	                 status=resp["status"], reason=resp.get("reason"), detail=resp.get("detail"),
   196	                 frame_sha256=resp.get("frame_sha256"), sig_sha256=resp.get("sig_sha256"),
   197	                 clock=resp["signer"]["clock"])
   198	        return resp
   199	
   200	    # ------------------------------------------------------------------------------------------ one run
   201	    def run(self):
   202	        """Drain the request queue until it is empty or the budget is spent. -> number of messages answered."""
   203	        t0, n = self.monotonic(), 0
   204	        self.log(event="start", code_sha256=self.code, image=self.cfg.image, key_version=self.cfg.key_version,
   205	                 key_fp=self.cfg.key_fp, alg=ALG, epsilon_s=EPS, sign_until=isotime(self.cfg.sign_until),
   206	                 clock=isotime(self.clock()))
   207	        while self.monotonic() - t0 < self.cfg.budget_s:
   208	            msgs = self.sqs.receive_message(
   209	                QueueUrl=self.cfg.request_queue_url, MaxNumberOfMessages=10, WaitTimeSeconds=self.cfg.wait_s,
   210	                VisibilityTimeout=self.cfg.visibility_s,
   211	                MessageSystemAttributeNames=["ApproximateReceiveCount"]).get("Messages", [])
   212	            if not msgs:
   213	                break
   214	            for m in msgs:
   215	                try:
   216	                    if self.handle(m) is not None:
   217	                        n += 1
   218	                except Exception as e:  # noqa: BLE001  send or delete failed: the queue delivers it again
   219	                    self.log(event="handle_error", sqs_message_id=m.get("MessageId"), error=repr(e)[:500])
   220	        self.log(event="done", answered=n, seconds=round(self.monotonic() - t0, 1))
   221	        return n
   222	
   223	
   224	def _dumps(obj):
   225	    return json.dumps(obj, sort_keys=True, separators=(",", ":"))
    25	| G1 | **Exact bytes.** The receipt binds these exact bytes. Change one bit and the check fails. | C1 |
    26	| G2 | **Presented to Tessera.** The bytes were presented to the Tessera V1 service at some issuance. | C2 |
    27	| G3 | **Both signatures.** Both of the service's keys signed. A missing, stripped or swapped signature fails. | C3 |
    28	| G4 | **The keys were Tessera's.** DNSSEC (`_tessera-v1.wamason.com`, at the snapshot's own anchored time) and a signed git commit (at its own evidence time) named the keys for the service's domain. The git commit was in the Bitcoin chain at least 6 blocks before the receipt. | C4, A10.6 |
    29	| G5 | **Existed by a block.** The signed bytes and both signatures existed before a specific Bitcoin block: the lowest-height qualifying block in the presented proof, confirmed 6 deep. | C5, A10.1, A10.5 |
    30	| G6 | **A real-time bound, under an unchecked assumption.** A-UTC says at least one of that block and its 5 successors has a time stamp at most 2 hours behind when it was made. If A-UTC holds, the bytes existed before U (the latest of those 6 times, plus 2 hours). U is reported separately and never changes the verdict. | A10.1.1 |
    31	| G7 | **Window, two checks only.** The declared issue time is not before the keys' window opened, and the chain time T is not after it closed. This does not prove the signing happened inside the window. | C4, A10.2 |
    32	| G8 | **No Tessera needed.** The verdict depends only on the inputs above. | C6 |
    33	| G9 | **A typed verdict.** Once the trust configuration is authenticated, the verifier returns `VALID_STRICT`, `INVALID` or `UNVERIFIABLE`, with a reason code and `revocation: NOT_EVALUATED`, `historical_security: NOT_EVALUATED`, `standing: ABSENT/NOT_ISSUED_IN_PROFILE`. Missing required evidence prevents acceptance. A valid receipt still leaves everything in §3 unestablished. If the trust configuration is not authenticated, there is no receipt verdict. | C7; A9.5 trust-configuration authority; V1-PROFILE §5 (`TRUST_CONFIG_UNAUTHENTICATED`) |
    34	| G10 | **Honest receipts cannot be moved.** If an attacker takes over the DNS and git authority records while the service's own keys stay secret and unmisused, it cannot move honestly signed frames to other keys or bytes, or change their signer sets, whether they were signed before or after the takeover. | A10.4 |
    35	**No G11.** The service-key listing (A10.4.1) is not in V1, by the author's ruling of 2026-10-23 (E9 row 2,
    36	`docs/reviews/e9-packet/AUTHOR-RULINGS.md`; `docs/decisions/2026-10-19-listing-cut.md`). G10 holds while the independent release boundary of A9.5 holds.
    37	**New receipts under an attacker's own keys pass when both authority channels are captured.**
    38	
    39	## 3. Not guaranteed
    40	
    41	Each of these is a deliberate limit, not a missing feature.
    42	
    43	- **Who submitted the bytes**, or that a replayed receipt suits the current transaction (case f).
    44	- **What the bytes mean**, or that they are true. A contract inside the bytes is the checker's to verify (cases i, i′).
    45	- **That a key was not revoked** (cases e, e′).
    46	- **That an algorithm or a key was still safe** when it signed.
    47	- **Any lower time bound or priority.** "Existed by" is never "existed after" or "came first".
    48	- **Real time without A-UTC.** Without it, only chain order is claimed.
    49	- **Standing** of any kind.
    50	- **Separate control of the two keys.** One controller holds both. Capturing the issuing AWS account means both
    51	  slots can sign.
    52	- **Visibility.** Publishing the authority records is the issuer's duty; the verifier does not check it. V1
    53	  guarantees no detection or public exposure of a capture, of new receipts, or of a release given to one party.
    54	- **That DNSSEC shows publication before issue.**
    55	- **Anything after a Bitcoin reorganization of 6 or more blocks.**
    56	- **Renewal, degraded modes, or wrappers.** These are refused (`UNVERIFIABLE`), including honest ones (cases d2, h:
    57	  the two registered false rejects).
    58	- **One receipt per presentation.** A receipt id (SHA-256 of `A_sig`) names a receipt, not a presentation. Signing
    59	  is randomized, so the same honest frames can carry more than one valid signature set and therefore more than one
    60	  valid receipt, each with its own T. Each still meets G1–G10. (Owner, 2026-10-19, from finding E-02 of the first
    61	  real run.)
    62	- **Stability of T and U across different proofs.** A different proof or pin set can select a different block.
    63	- **Protection for a checker who skips authenticating the verifier release** or runs a substituted one.
    64	
    65	## 4. Failure model
    66	
    67	| Failure or attacker | What still holds |
