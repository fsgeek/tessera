   126	    expected = P8.T_MANIFEST if tag == P8.T_MANIFEST else P8.T_ATTEST   # anything else: TAG_UNKNOWN/TAG_MISMATCH
   127	    try:
   128	        v = P8.decode_frame(frame, expected)
   129	    except P8.Reject as e:
   130	        raise Refuse(e.code, str(e))
   131	    if expected == P8.T_ATTEST:
   132	        alg, fp = v["common"]["alg"], v["signer"]["key_fp"]
   133	    else:
   134	        alg, fp = v["alg"], v["sset"][0]
   135	    if alg not in ALLOWED_ALGS:
   136	        raise Refuse("ALG_NOT_ALLOWED", alg)
   137	    if fp != KEY_FP:
   138	        raise Refuse("KEY_FP_MISMATCH", fp)
   139	    if expected == P8.T_ATTEST:
   140	        declared = calendar.timegm(time.strptime(v["common"]["declared_issue_time"], "%Y-%m-%dT%H:%M:%SZ"))
   141	        if abs(declared - clock) > EPSILON:
   142	            raise Refuse("DECLARED_TIME_OUTSIDE_EPSILON",
   143	                         f"declared {v['common']['declared_issue_time']}, signer clock "
   144	                         f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(clock))}, "
   145	                         f"difference {declared - int(clock)} s, epsilon {EPSILON} s")
   146	    return ("attest" if expected == P8.T_ATTEST else "manifest"), alg
   147	
   148	def sign_rule_o(frame, alg, pub, fpr):
   149	    """One rule-O packet, built exactly as prototype/spike-pq/spike_gcp.py builds it; self-checked before return."""
   150	    when = int(time.time())
   151	    hashed = P8._subpacket(33, b"\x04" + fpr) + P8._subpacket(2, when.to_bytes(4, "big"))
   152	    unhashed = P8._subpacket(16, fpr[-8:])
   153	    digest = P8.openpgp_v4_sig_digest(frame, hashed)
   154	    der = hsm_sign_digest(digest)
   155	    pub.verify(der, digest, ec.ECDSA(utils.Prehashed(hashes.SHA256())))     # raises if the HSM output is bad
   156	    r, s = utils.decode_dss_signature(der)
   157	    packet = P8.openpgp_v4_sig_packet(hashed, unhashed, digest[:2], r, s)
   158	    P8.decode_sig(packet, alg, 1)                                            # rule-O codec gate, slot gpg
   159	    return packet
   160	
   161	# ---- queue loop ---------------------------------------------------------------------------------------------
   162	def aws_session():
   163	    token = metadata(f"identity?audience={urllib.request.quote(AUDIENCE)}&format=full")
   164	    sts = boto3.client("sts", region_name=REGION)
   165	    c = sts.assume_role_with_web_identity(RoleArn=ROLE_ARN, RoleSessionName="slot2-signer",
   166	                                          WebIdentityToken=token, DurationSeconds=900)["Credentials"]
   167	    return boto3.client("sqs", region_name=REGION, aws_access_key_id=c["AccessKeyId"],
   168	                        aws_secret_access_key=c["SecretAccessKey"], aws_session_token=c["SessionToken"])
   169	
   170	def handle(sqs, msg, pub, fpr):
   171	    clock = time.time()
   172	    resp = {"v": 1, "sqs_message_id": msg["MessageId"], "request_id": None,
   173	            "signer": {"code_sha256": CODE_SHA256, "image": IMAGE, "key_version": KEY_VERSION, "key_fp": KEY_FP,
   174	                       "epsilon_s": EPSILON, "allowed_algs": list(ALLOWED_ALGS),
   175	                       "clock": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(clock))}}
   176	    frame = b""
   177	    try:
   178	        body = msg.get("Body", "")
   179	        if len(body) > MAX_BODY:
   180	            raise Refuse("REQUEST_TOO_LARGE", str(len(body)))
   181	        try:
   182	            req = json.loads(body)
   183	        except ValueError as e:
   184	            raise Refuse("REQUEST_MALFORMED", f"not JSON: {e}")
   185	        if not isinstance(req, dict) or set(req) != {"request_id", "frame_b64"}:
   186	            raise Refuse("REQUEST_MALFORMED", "want exactly {request_id, frame_b64}")
   187	        if isinstance(req["request_id"], str) and RE_REQID.fullmatch(req["request_id"]):
   188	            resp["request_id"] = req["request_id"]
   189	        else:
   190	            raise Refuse("REQUEST_MALFORMED", "bad request_id")
   191	        try:
   192	            frame = base64.b64decode(req["frame_b64"], validate=True)
   193	        except Exception:
   194	            raise Refuse("REQUEST_MALFORMED", "frame_b64 is not strict base64")
   195	        resp["frame_sha256"] = hashlib.sha256(frame).hexdigest()
   196	        kind, alg = check_policy(frame, clock)
   197	        try:
   198	            packet = sign_rule_o(frame, alg, pub, fpr)
   199	        except Exception as e:                                       # transient (KMS/network) or self-check fail
   200	            if int(msg["Attributes"].get("ApproximateReceiveCount", "1")) < MAX_RECEIVES:
   201	                log(event="sign_error_retry", request_id=resp["request_id"], error=repr(e))
   202	                return                                               # leave it; visibility timeout re-delivers
   203	            raise Refuse("SIGNER_ERROR", repr(e))
   204	        resp.update(status="SIGNED", kind=kind, sig_b64=base64.b64encode(packet).decode())
   205	    except Refuse as r:
   206	        resp.update(status="REFUSED", reason=r.code, detail=r.detail[:500])     # signed nothing
   207	    except Exception as e:                                           # decoder bug or unexpected input
   208	        resp.update(status="REFUSED", reason="INTERNAL", detail=repr(e)[:500])
   209	    sqs.send_message(QueueUrl=RESP_URL, MessageBody=json.dumps(resp, sort_keys=True))
   210	    sqs.delete_message(QueueUrl=REQ_URL, ReceiptHandle=msg["ReceiptHandle"])
   211	    log(event="response", request_id=resp["request_id"], sqs_message_id=msg["MessageId"],
   212	        status=resp["status"], reason=resp.get("reason"), detail=resp.get("detail"),
   213	        frame_sha256=resp.get("frame_sha256"), clock=resp["signer"]["clock"])
   214	
   215	def main():
   216	    t0 = time.time()
   217	    pub, fpr = load_key()
   218	    sqs = aws_session()
   219	    log(event="start", code_sha256=CODE_SHA256, image=IMAGE, key_version=KEY_VERSION, key_fp=KEY_FP,
   220	        allowed_algs=list(ALLOWED_ALGS), epsilon_s=EPSILON, clock=utcnow())
   221	    n = 0
   222	    while time.time() - t0 < BUDGET:
   223	        msgs = sqs.receive_message(QueueUrl=REQ_URL, MaxNumberOfMessages=10, WaitTimeSeconds=5,
   224	                                   VisibilityTimeout=60, MessageSystemAttributeNames=["ApproximateReceiveCount"]).get("Messages", [])
   225	        if not msgs:
   226	            break
   227	        for m in msgs:
   228	            m.setdefault("Attributes", {})
   229	            handle(sqs, m, pub, fpr)
   230	            n += 1
   231	    log(event="done", handled=n, seconds=round(time.time() - t0, 1))
   232	
   233	if __name__ == "__main__":
   234	    main()
