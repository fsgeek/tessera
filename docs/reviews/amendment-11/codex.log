    47	
    48	say() { printf '\n== %s\n' "$*"; }
    49	need() { [ -n "${!1:-}" ] || { echo "$1 is not set (see the header of $0)"; exit 2; }; }
    50	
    51	sas() {
    52	  say "service accounts (no keys are ever created for them)"
    53	  for sa in tessera-signer-gpg:"Tessera V1 slot-2 signer runtime" tessera-signer-invoker:"Tessera V1 slot-2 signer scheduler"; do
    54	    name=${sa%%:*}; desc=${sa#*:}
    55	    $GC iam service-accounts describe "$name@$PROJECT.iam.gserviceaccount.com" >/dev/null 2>&1 \
    56	      || $GC iam service-accounts create "$name" --display-name="$desc"
