    88	  local tag; tag="$(cd "$ctx" && find . -type f ! -name .gcloudignore -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16)"
    89	  $GC builds submit "$ctx" --region=$REGION --config="$ctx/signer-gcp/cloudbuild.yaml" \
    90	    --substitutions=_IMAGE="$IMAGE_BASE:$tag" \
    91	    --service-account="projects/$PROJECT/serviceAccounts/$BUILDER_SA" \
    92	    --gcs-source-staging-dir="$SRC_BUCKET/source"
    93	  rm -rf -- "${ctx:?}"
    94	  $GC artifacts docker images describe "$IMAGE_BASE:$tag" --format='value(image_summary.digest)' > "$HERE/.image-digest"
    95	  echo "image: $IMAGE_BASE@$(cat "$HERE/.image-digest")"
    96	}
    97	
    98	signer_uid() { $GC iam service-accounts describe "$SIGNER_SA" --format='value(uniqueId)'; }
    99	
   100	role() {
   101	  say "AWS role $FED_ROLE: web identity (accounts.google.com), only $SIGNER_SA; may only assume $ISSUER_SIGNER_ROLE"
   102	  local uid; uid="$(signer_uid)"
   103	  local trust; trust=$(cat <<EOF
   104	{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Federated":"accounts.google.com"},
   105	 "Action":"sts:AssumeRoleWithWebIdentity",
   106	 "Condition":{"StringEquals":{"accounts.google.com:sub":"$uid","accounts.google.com:aud":"$uid",
   107	                              "accounts.google.com:oaud":"$AUDIENCE"}}}]}
   108	EOF
   109	)
   110	  local perms; perms=$(cat <<EOF
   111	{"Version":"2012-10-17","Statement":[{"Sid":"ChainToIssuerSignerRole","Effect":"Allow","Action":"sts:AssumeRole",
   112	 "Resource":"arn:aws:iam::$ACCOUNT:role/$ISSUER_SIGNER_ROLE"}]}
   113	EOF
   114	)
   115	  if $AWS iam get-role --role-name $FED_ROLE >/dev/null 2>&1; then
   116	    $AWS iam update-assume-role-policy --role-name $FED_ROLE --policy-document "$trust"
   117	  else
   118	    $AWS iam create-role --role-name $FED_ROLE --assume-role-policy-document "$trust" --max-session-duration 3600 \
   119	      --description "Tessera V1 slot-2 signer (GCP $SIGNER_SA): web identity, chains to $ISSUER_SIGNER_ROLE" \
   120	      --tags Key=project,Value=tessera Key=purpose,Value=signer-gpg --query Role.Arn --output text
   121	  fi
   122	  $AWS iam put-role-policy --role-name $FED_ROLE --policy-name chain-to-issuer-signer --policy-document "$perms"
   123	  echo "set signer_principals = { gpg = \"arn:aws:iam::$ACCOUNT:role/$FED_ROLE\" } in the issuer's tfvars"
   124	}
   125	
   126	job() {
   127	  need REQUEST_QUEUE_URL; need RESPONSE_QUEUE_URL; need FRAME_BUCKET; need SIGN_UNTIL
   128	  say "Cloud Run job $JOB (a job, not a service: no endpoint)"
   129	  local digest; digest="$(cat "$HERE/.image-digest")"
   130	  local env="REQUEST_QUEUE_URL=$REQUEST_QUEUE_URL,RESPONSE_QUEUE_URL=$RESPONSE_QUEUE_URL,FRAME_BUCKET=$FRAME_BUCKET"
   131	  env+=",AWS_ROLE_ARN=arn:aws:iam::$ACCOUNT:role/$FED_ROLE,AWS_AUDIENCE=$AUDIENCE,AWS_REGION_QUEUES=us-east-2"
   132	  env+=",AWS_CHAIN_ROLE_ARN=arn:aws:iam::$ACCOUNT:role/$ISSUER_SIGNER_ROLE"
   133	  env+=",KMS_KEY_VERSION=$KEY_VERSION,KEY_CREATED=$KEY_CREATED,KEY_FP=$KEY_FP,SIGN_UNTIL=$SIGN_UNTIL"
   134	  env+=",SIGNER_IMAGE=$IMAGE_BASE@$digest,RUN_SECONDS=40,WAIT_SECONDS=5,VISIBILITY_SECONDS=120"
   135	  $GC run jobs deploy $JOB --region=$REGION --image="$IMAGE_BASE@$digest" --service-account="$SIGNER_SA" \
   136	    --set-env-vars="$env" --tasks=1 --parallelism=1 --max-retries=0 --task-timeout=150s \
   137	    --cpu=1 --memory=512Mi --labels=project=tessera,purpose=signer-gpg
   138	  $GC run jobs add-iam-policy-binding $JOB --region=$REGION \
   139	    --member="serviceAccount:$INVOKER_SA" --role=roles/run.invoker >/dev/null
   140	}
   141	
   142	scheduler() {
   143	  say "Cloud Scheduler $SCHED: every minute, runs the job as $INVOKER_SA (OAuth); E-01: keep it running while signing is possible"
   144	  local uri="https://run.googleapis.com/v2/projects/$PROJECT/locations/$REGION/jobs/$JOB:run"
   145	  if $GC scheduler jobs describe $SCHED --location=$REGION >/dev/null 2>&1; then
   146	    $GC scheduler jobs update http $SCHED --location=$REGION --schedule="* * * * *" --uri="$uri" \
   147	      --http-method=POST --oauth-service-account-email="$INVOKER_SA"
   148	  else
   149	    $GC scheduler jobs create http $SCHED --location=$REGION --schedule="* * * * *" --uri="$uri" \
   150	      --http-method=POST --oauth-service-account-email="$INVOKER_SA" --time-zone=UTC --attempt-deadline=60s
   151	  fi
   152	}
   153	
   154	harden() {
   155	  say "check: no project-level grant that can change the job or the key (the 2026-10-14 removals still hold)"
   156	  $GC projects remove-iam-policy-binding $PROJECT --condition=None \
   157	    --member="serviceAccount:$PROJECT_NUMBER-compute@developer.gserviceaccount.com" --role=roles/editor >/dev/null 2>&1 || true
   158	  $GC projects remove-iam-policy-binding $PROJECT --condition=None \
   159	    --member="serviceAccount:$PROJECT_NUMBER@cloudbuild.gserviceaccount.com" --role=roles/cloudbuild.builds.builder >/dev/null 2>&1 || true
   160	  $GC projects get-iam-policy $PROJECT --format=json
   161	  $GC kms keys get-iam-policy $KEY --keyring=$KEYRING --location=$REGION --format=json
   162	}
   163	
   164	OLD_SA=slot2-signer@$PROJECT.iam.gserviceaccount.com              # the 2026-10-14 instrument's runtime account
   165	
   166	# SG-03: absent is the only tolerated failure. gone CMD... succeeds iff CMD reports that the thing does not exist.
   167	gone() { local out; if out=$("$@" 2>&1); then return 1; fi; grep -qiE 'not.?found|cannot find|does not exist' <<<"$out"; }
   168	die() { echo "retire-instrument: $*" >&2; exit 1; }
   169	
   170	retire_instrument() {
   171	  say "retire the 2026-10-14 instrument: its job reads another queue and can also cause $KEY signatures"
   172	  gone $GC scheduler jobs describe slot2-signer-tick --location=$REGION \
   173	    || $GC scheduler jobs delete slot2-signer-tick --location=$REGION
   174	  gone $GC run jobs describe slot2-signer --region=$REGION || $GC run jobs delete slot2-signer --region=$REGION
   175	  for role in roles/cloudkms.signer roles/cloudkms.publicKeyViewer; do
   176	    if $GC kms keys get-iam-policy $KEY --keyring=$KEYRING --location=$REGION --format=json | grep -q "$OLD_SA"; then
   177	      $GC kms keys remove-iam-policy-binding $KEY --keyring=$KEYRING --location=$REGION \
   178	        --member="serviceAccount:$OLD_SA" --role=$role >/dev/null
   179	    fi
   180	  done
   181	  # Disabling the account ends every route through it at once, including grants inherited from the project.
   182	  gone $GC iam service-accounts describe "$OLD_SA" || $GC iam service-accounts disable "$OLD_SA"
   183	
   184	  say "verify: nothing of the instrument can still sign"
   185	  gone $GC scheduler jobs describe slot2-signer-tick --location=$REGION || die "scheduler slot2-signer-tick remains"
   186	  gone $GC run jobs describe slot2-signer --region=$REGION || die "job slot2-signer remains"
   187	  ! $GC kms keys get-iam-policy $KEY --keyring=$KEYRING --location=$REGION --format=json | grep -q "$OLD_SA" \
   188	    || die "$OLD_SA still bound on $KEY"
   189	  ! $GC projects get-iam-policy $PROJECT --format=json | grep -q "$OLD_SA" || die "$OLD_SA still bound on $PROJECT"
   190	  gone $GC iam service-accounts describe "$OLD_SA" \
   191	    || [ "$($GC iam service-accounts describe "$OLD_SA" --format='value(disabled)')" = "True" ] \
   192	    || die "$OLD_SA is not disabled"
   193	  say "instrument retired and verified"
   194	}
   195	
   196	run_now() { $GC run jobs execute $JOB --region=$REGION --wait; }
   197	
   198	case "${1:-}" in
   199	  sas|keyiam|registry|build|role|job|scheduler|harden) "$1" ;;
   200	  run-now) run_now ;;
   201	  retire-instrument) retire_instrument ;;
   202	  *) echo "usage: $0 sas|role|keyiam|registry|build|job|run-now|scheduler|harden|retire-instrument"; exit 2 ;;
   203	esac

