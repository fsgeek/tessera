   288	def signature_verifies(document,sig,key):
   289	    if isinstance(sig,bytes):
   290	        if not mldsa65_encoding_valid(sig): return False
   291	        try:
   292	            # Algorithm 3 applies 00 00 itself: pass exact F, not mu or M'.
   293	            key.verify(sig,document,context=b''); return True
