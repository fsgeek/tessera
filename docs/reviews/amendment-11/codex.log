    34	class Refuse(Exception):
    35	    """A refusal: the signer answers REFUSED with this reason and signs nothing."""
    36	
    37	    def __init__(self, code, detail=""):
    38	        super().__init__(f"{code}: {detail}")
    39	        self.code, self.detail = code, detail
    40	
    41	
    42	@dataclass(frozen=True)
    43	class Request:
    44	    request_id: str
    45	    sign_by: int
    46	    frame_b64: str | None = None
    47	    frame_ref: str | None = None
    48	    frame_sha256: str | None = None
    49	
    50	
    51	def load(body):
    52	    """Message body -> JSON object. BAD_REQUEST for anything else."""
    53	    if not isinstance(body, str):
    54	        raise Refuse("BAD_REQUEST", "body is not text")
    55	    if len(body.encode("utf-8", "surrogatepass")) > MAX_BODY:
    56	        raise Refuse("BAD_REQUEST", f"body of {len(body)} characters exceeds {MAX_BODY} bytes")
    57	    try:
    58	        obj = json.loads(body)
    59	    except ValueError as e:
    60	        raise Refuse("BAD_REQUEST", f"not JSON: {e}") from None
    61	    if not isinstance(obj, dict):
    62	        raise Refuse("BAD_REQUEST", "not a JSON object")
    63	    return obj
    64	
    65	
    66	def request_id(obj):
    67	    rid = obj.get("request_id")
    68	    if not (isinstance(rid, str) and RE_REQID.fullmatch(rid)):
    69	        raise Refuse("BAD_REQUEST", "bad request_id")
    70	    return rid
    71	
    72	
    73	def parse(obj):
    74	    """JSON object -> Request. Exactly one of the two shapes; strict values."""
    75	    rid = request_id(obj)
    76	    keys = set(obj)
    77	    if keys not in (INLINE_KEYS, REF_KEYS):
    78	        raise Refuse("BAD_REQUEST", f"members {sorted(keys)}; want {sorted(INLINE_KEYS)} or {sorted(REF_KEYS)}")
    79	    try:
    80	        sign_by = utc(obj["sign_by"])
    81	    except Fault:
    82	        raise Refuse("BAD_REQUEST", "sign_by is not an RFC 3339 UTC second") from None
    83	    if keys == INLINE_KEYS:
    84	        if not isinstance(obj["frame_b64"], str):
    85	            raise Refuse("BAD_REQUEST", "frame_b64 is not a string")
    86	        return Request(rid, sign_by, frame_b64=obj["frame_b64"])
    87	    ref, digest = obj["frame_ref"], obj["frame_sha256"]
    88	    if not (isinstance(ref, str) and RE_REF.fullmatch(ref)):
    89	        raise Refuse("BAD_REQUEST", "frame_ref is not frames/<rid>/<sha256>")
    90	    if not (isinstance(digest, str) and HEX.fullmatch(digest)):
    91	        raise Refuse("BAD_REQUEST", "frame_sha256 is not 64 lowercase hex digits")
    92	    return Request(rid, sign_by, frame_ref=ref, frame_sha256=digest)
    93	
    94	
    95	def inline_frame(req):
    96	    """Strict, canonical base64 (the issuer's b64e) -> bytes."""
    97	    try:
    98	        frame = b64(req.frame_b64)
    99	    except Fault:
   100	        raise Refuse("BAD_REQUEST", "frame_b64 is not canonical base64") from None
   101	    if len(frame) > MAX_FRAME:
   102	        raise Refuse("BAD_REQUEST", "frame too large")
   103	    return frame
   104	
   105	
   106	def check_frame(frame, key_fp, clock):
   107	    """-> (kind, alg), or raises Refuse. `clock` is the signer's own clock, integer seconds."""
   108	    if len(frame) < 1 or len(frame) < 1 + frame[0]:
   109	        raise Refuse("TRUNCATED", "no complete tag")
   110	    expected = T_MANIFEST if frame[1:1 + frame[0]] == T_MANIFEST.encode() else T_ATTEST   # else TAG_UNKNOWN/MISMATCH
   111	    try:
   112	        obj = read_frame(frame, expected)
   113	    except Fault as e:
   114	        raise Refuse(e.code, f"frame does not decode as {expected}") from None
   115	    if expected == T_ATTEST:
   116	        alg, fp = obj["common"]["alg"], obj["signer"]["key_fp"]
   117	    else:
   118	        alg, fp = obj["alg"], obj["sset"][0]
   119	    if alg != ALG:
   120	        raise Refuse("ALG_NOT_ALLOWED", alg)
   121	    if fp != key_fp:
   122	        raise Refuse("KEY_FP_MISMATCH", fp)
   123	    if expected == T_ATTEST:
   124	        declared = utc(obj["common"]["declared_issue_time"])
   125	        if abs(declared - clock) > EPS:
   126	            raise Refuse("DECLARED_TIME_OUTSIDE_EPSILON",
   127	                         f"declared {obj['common']['declared_issue_time']}, difference {declared - clock} s, "
   128	                         f"epsilon {EPS} s")
   129	    return ("attest" if expected == T_ATTEST else "manifest"), alg
   130	
   131	
   132	def check_stop(now, sign_until, sign_by):
   133	    """IS-03, called immediately before the HSM call: refuse past the configured stop or the request's sign_by."""
   134	    if now > sign_until:
   135	        raise Refuse("SIGNING_STOPPED", f"signer clock {now} past the configured signing stop {sign_until}")
   136	    if now > sign_by:
   137	        raise Refuse("SIGNING_STOPPED", f"signer clock {now} past the request's sign_by {sign_by}")
     1	"""One run of the slot-2 policy signer over injected clients: drain the request queue for a time budget and, for each
     2	request, either sign the frame with the HSM key (one rule-O packet) or refuse it with a reason. Queue content and the
     3	referenced frame objects are untrusted input.
     4	
     5	Clients (boto3-style for AWS, so main.py passes boto3 clients straight in; tests pass fakes):
     6	  sqs  receive_message / send_message / delete_message
     7	  s3   get_object(Bucket, Key) -> {"Body": readable, "ContentLength": int}; a missing object raises an error whose
     8	       response Error Code is NoSuchKey, 404 or NotFound
     9	  kms  public_key() -> Cloud KMS PublicKey resource (dict); sign_digest(sha256 digest) -> DER ECDSA signature
    10	  clock() -> integer seconds; monotonic() -> float seconds; log(**fields)
    11	
    12	Response (the issuer reads request_id, status, sig_b64, reason; everything else is for the logs and the operator):
    13	  {"v": 1, "request_id", "sqs_message_id", "status": "SIGNED" | "REFUSED", "kind"?, "sig_b64"?, "sig_sha256"?,
    14	   "frame_sha256"?, "reason"?, "detail"?, "signer": {"slot": "gpg", "clock", ...}}
    15	
    16	E-02 on this side: every signature is logged (request id, frame SHA-256, signature SHA-256) before its response is
    17	sent. A request delivered twice in one run gets the same signature again, not a second one. Across runs there is no
    18	memory: a request redelivered after its response was sent (a failed delete) is signed again, and the issuer records
    19	the second response as a duplicate. sign_by bounds how late that can happen."""
    20	import base64
    21	import hashlib
    22	import json
    23	import os
    24	
    25	from cryptography.hazmat.primitives import hashes, serialization
    26	from cryptography.hazmat.primitives.asymmetric import ec, utils
    27	from tessera_verify.codec import (Fault, parse_signature, public_key, registered_codecs, sig_policy,
    28	                                  signature_verifies, isotime)
    29	
    30	from . import openpgp, policy
    31	from .policy import ALG, EPS, Refuse
    32	
    33	SLOT = "gpg"
    34	MAX_RECEIVES = 3                      # transient errors (KMS, S3, network): leave the message, then refuse
    35	KMS_ALGORITHM = "EC_SIGN_P256_SHA256"
    36	REGISTRY = registered_codecs(ALG)
    37	
    38	
    39	def code_sha256():
    40	    here = os.path.dirname(os.path.abspath(__file__))
    41	    h = hashlib.sha256()
    42	    for name in sorted(f for f in os.listdir(here) if f.endswith(".py")):
    43	        with open(os.path.join(here, name), "rb") as f:
    44	            h.update(name.encode() + b"\0" + f.read() + b"\0")
    45	    return h.hexdigest()
    46	
    47	
    48	def _not_found(exc):
    49	    code = getattr(exc, "response", {}).get("Error", {}).get("Code")
    50	    return code in ("NoSuchKey", "404", "NotFound") or type(exc).__name__ == "NoSuchKey"
    51	
