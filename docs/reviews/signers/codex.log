"""One run of the slot-2 policy signer over injected clients: drain the request queue for a time budget and, for each
request, either sign the frame with the HSM key (one rule-O packet) or refuse it with a reason. Queue content and the
referenced frame objects are untrusted input.

Clients (boto3-style for AWS, so main.py passes boto3 clients straight in; tests pass fakes):
  sqs  receive_message / send_message / delete_message
  s3   get_object(Bucket, Key) -> {"Body": readable, "ContentLength": int}; a missing object raises an error whose
       response Error Code is NoSuchKey, 404 or NotFound
  kms  public_key() -> Cloud KMS PublicKey resource (dict); sign_digest(sha256 digest) -> DER ECDSA signature
  clock() -> integer seconds; monotonic() -> float seconds; log(**fields)

Response (the issuer reads request_id, status, sig_b64, reason; everything else is for the logs and the operator):
  {"v": 1, "request_id", "sqs_message_id", "status": "SIGNED" | "REFUSED", "kind"?, "sig_b64"?, "sig_sha256"?,
   "frame_sha256"?, "reason"?, "detail"?, "signer": {"slot": "gpg", "clock", ...}}

E-02 on this side: every signature is logged (request id, frame SHA-256, signature SHA-256) before its response is
sent. A request delivered twice in one run gets the same signature again, not a second one. Across runs there is no
memory: a request redelivered after its response was sent (a failed delete) is signed again, and the issuer records
the second response as a duplicate. sign_by bounds how late that can happen."""
import base64
import hashlib
import json
import os

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec, utils
from tessera_verify.codec import (Fault, parse_signature, public_key, registered_codecs, sig_policy,
                                  signature_verifies, isotime)

from . import openpgp, policy
from .policy import ALG, EPS, Refuse

SLOT = "gpg"
MAX_RECEIVES = 3                      # transient errors (KMS, S3, network): leave the message, then refuse
KMS_ALGORITHM = "EC_SIGN_P256_SHA256"
REGISTRY = registered_codecs(ALG)


def code_sha256():
    here = os.path.dirname(os.path.abspath(__file__))
    h = hashlib.sha256()
    for name in sorted(f for f in os.listdir(here) if f.endswith(".py")):
        with open(os.path.join(here, name), "rb") as f:
            h.update(name.encode() + b"\0" + f.read() + b"\0")
    return h.hexdigest()


def _not_found(exc):
    code = getattr(exc, "response", {}).get("Error", {}).get("Code")
    return code in ("NoSuchKey", "404", "NotFound") or type(exc).__name__ == "NoSuchKey"


class StartupError(Exception):
    """The signer refuses to run at all (wrong key, wrong configuration)."""


class Signer:
    def __init__(self, cfg, kms, sqs, s3, clock, monotonic, log):
        self.cfg, self.kms, self.sqs, self.s3 = cfg, kms, sqs, s3
        self.clock, self.monotonic, self.log = clock, monotonic, log
        self.code = code_sha256()
        self.issued = {}                  # (request_id, frame sha256) -> packet, this run only
        self.pub = self.key_bytes = self.fpr = None

    # ------------------------------------------------------------------------------------------ the key
    def load_key(self):
        """Fetch the HSM public key and check it against the pinned version, algorithm, protection level and
        fingerprint before anything is signed."""
        pk = self.kms.public_key()
        if pk.get("name") != self.cfg.key_version:
            raise StartupError(f"KMS returned key version {pk.get('name')!r}, not {self.cfg.key_version!r}")
        if pk.get("algorithm") != KMS_ALGORITHM:
            raise StartupError(f"key algorithm {pk.get('algorithm')!r}, not {KMS_ALGORITHM}")
        if pk.get("protectionLevel") != "HSM":
            raise StartupError(f"key protection level {pk.get('protectionLevel')!r}, not HSM")
        try:
            pub = serialization.load_pem_public_key(pk["pem"].encode())
        except (KeyError, ValueError, TypeError) as e:
            raise StartupError(f"KMS public key does not load: {e!r}") from None
        if not isinstance(pub, ec.EllipticCurvePublicKey) or pub.curve.name != "secp256r1":
            raise StartupError("KMS public key is not P-256")
        body = openpgp.key_body(openpgp.point65(pub), self.cfg.key_created)
        fp = openpgp.fp_gpg(body)
        if fp != self.cfg.key_fp:
            raise StartupError(f"HSM key fingerprint {fp} is not the pinned {self.cfg.key_fp}; refusing to run")
        self.pub, self.key_bytes, self.fpr = pub, body, openpgp.v4_fingerprint(body)
        self.verify_key = public_key(body, SLOT, ALG)      # the verifier's own key gate (KEY_FORMAT)

    # ------------------------------------------------------------------------------------------ signing
    def sign(self, frame, created):
        """One rule-O packet over the exact frame, created at `created`; checked with the service verifier's own
        functions (the checks the issuer runs) before it is returned."""
        hashed = openpgp.hashed_area(self.fpr, created)
        unhashed = openpgp.subpacket(16, self.fpr[-8:])
        digest = openpgp.sig_digest(frame, hashed)
        der = self.kms.sign_digest(digest)
        self.pub.verify(der, digest, ec.ECDSA(utils.Prehashed(hashes.SHA256())))   # raises if the HSM output is bad
        r, s = utils.decode_dss_signature(der)
        packet = openpgp.sig_packet(hashed, unhashed, digest[:2], r, s)
        try:
            parsed = parse_signature(packet, ALG, SLOT, REGISTRY)
            sig_policy(parsed)
            ok = signature_verifies(frame, parsed, self.verify_key)
        except Fault as e:
            raise RuntimeError(f"self-check: {e.code}") from None
        if not ok:
            raise RuntimeError("self-check: the packet does not verify on the frame")
        return packet

    # ------------------------------------------------------------------------------------------ one message
    def _signer_info(self, clock):
        c = self.cfg
        return {"slot": SLOT, "clock": isotime(clock), "code_sha256": self.code, "image": c.image,
                "key_version": c.key_version, "key_fp": c.key_fp, "epsilon_s": EPS, "alg": ALG,
                "sign_until": isotime(c.sign_until)}

    def _receives(self, msg):
        try:
            return int(msg.get("Attributes", {}).get("ApproximateReceiveCount", "1"))
        except ValueError:
            return 1

    def _transient(self, msg, rid, reason, exc):
        """Leave the message for redelivery (None), or after MAX_RECEIVES deliveries refuse with `reason`."""
        if self._receives(msg) < MAX_RECEIVES:
            self.log(event="transient_retry", request_id=rid, reason=reason, error=repr(exc)[:500])
            return None
        raise Refuse(reason, repr(exc)[:500])

    def fetch(self, req, msg):
        """IS-09: the object at frame_ref, accepted only if its SHA-256 is frame_sha256. None: retry later."""
        try:
            obj = self.s3.get_object(Bucket=self.cfg.frame_bucket, Key=req.frame_ref)
        except Exception as e:  # noqa: BLE001
            if _not_found(e):
                raise Refuse("FRAME_UNAVAILABLE", req.frame_ref) from None
            return self._transient(msg, req.request_id, "FRAME_UNAVAILABLE", e)
        size = obj.get("ContentLength")
        if isinstance(size, int) and size > policy.MAX_FRAME:
            raise Refuse("FRAME_UNAVAILABLE", f"object of {size} bytes exceeds {policy.MAX_FRAME}")
        try:
            frame = obj["Body"].read(policy.MAX_FRAME + 1)
        except Exception as e:  # noqa: BLE001
            return self._transient(msg, req.request_id, "FRAME_UNAVAILABLE", e)
        if len(frame) > policy.MAX_FRAME:
            raise Refuse("FRAME_UNAVAILABLE", f"object exceeds {policy.MAX_FRAME} bytes")
        if hashlib.sha256(frame).hexdigest() != req.frame_sha256:
            raise Refuse("FRAME_DIGEST_MISMATCH", f"object at {req.frame_ref} is not {req.frame_sha256}")
        return frame

    def handle(self, msg):
        """Answer one request message and delete it, or leave it on the queue for a later delivery.
        -> the response sent, or None."""
        clock = self.clock()
        resp = {"v": 1, "sqs_message_id": msg.get("MessageId"), "request_id": None,
                "signer": self._signer_info(clock)}
        try:
            obj = policy.load(msg.get("Body"))
            resp["request_id"] = policy.request_id(obj)
            req = policy.parse(obj)
            frame = policy.inline_frame(req) if req.frame_b64 is not None else self.fetch(req, msg)
            if frame is None:
                return None
            fsha = resp["frame_sha256"] = hashlib.sha256(frame).hexdigest()
            kind, _ = policy.check_frame(frame, self.cfg.key_fp, clock)
            packet = self.issued.get((req.request_id, fsha))
            if packet is None:
                now = self.clock()                       # IS-03: read immediately before the HSM call
                policy.check_stop(now, self.cfg.sign_until, req.sign_by)
                try:
                    packet = self.sign(frame, now)
                except Exception as e:  # noqa: BLE001  KMS, network, or a failed self-check
                    return self._transient(msg, req.request_id, "SIGNER_ERROR", e)
                self.issued[(req.request_id, fsha)] = packet
                self.log(event="signed", request_id=req.request_id, frame_sha256=fsha,
                         sig_sha256=hashlib.sha256(packet).hexdigest(), created=isotime(now), kind=kind)
            else:
                self.log(event="resent", request_id=req.request_id, frame_sha256=fsha,
                         sig_sha256=hashlib.sha256(packet).hexdigest())
            resp.update(status="SIGNED", kind=kind, sig_b64=base64.b64encode(packet).decode("ascii"),
                        sig_sha256=hashlib.sha256(packet).hexdigest())
        except Refuse as r:
            resp.update(status="REFUSED", reason=r.code, detail=r.detail[:500])        # signed nothing
        except Exception as e:  # noqa: BLE001  a codec bug or unexpected input: refuse, never sign
            resp.update(status="REFUSED", reason="INTERNAL", detail=repr(e)[:500])
        self.sqs.send_message(QueueUrl=self.cfg.response_queue_url, MessageBody=_dumps(resp))
        self.sqs.delete_message(QueueUrl=self.cfg.request_queue_url, ReceiptHandle=msg["ReceiptHandle"])
        self.log(event="response", request_id=resp["request_id"], sqs_message_id=resp["sqs_message_id"],
                 status=resp["status"], reason=resp.get("reason"), detail=resp.get("detail"),
                 frame_sha256=resp.get("frame_sha256"), sig_sha256=resp.get("sig_sha256"),
                 clock=resp["signer"]["clock"])
        return resp

    # ------------------------------------------------------------------------------------------ one run
    def run(self):
        """Drain the request queue until it is empty or the budget is spent. -> number of messages answered."""
        t0, n = self.monotonic(), 0
        self.log(event="start", code_sha256=self.code, image=self.cfg.image, key_version=self.cfg.key_version,
                 key_fp=self.cfg.key_fp, alg=ALG, epsilon_s=EPS, sign_until=isotime(self.cfg.sign_until),
                 clock=isotime(self.clock()))
        while self.monotonic() - t0 < self.cfg.budget_s:
            msgs = self.sqs.receive_message(
                QueueUrl=self.cfg.request_queue_url, MaxNumberOfMessages=10, WaitTimeSeconds=self.cfg.wait_s,
                VisibilityTimeout=self.cfg.visibility_s,
                MessageSystemAttributeNames=["ApproximateReceiveCount"]).get("Messages", [])
            if not msgs:
                break
            for m in msgs:
                try:
                    if self.handle(m) is not None:
                        n += 1
                except Exception as e:  # noqa: BLE001  send or delete failed: the queue delivers it again
                    self.log(event="handle_error", sqs_message_id=m.get("MessageId"), error=repr(e)[:500])
        self.log(event="done", answered=n, seconds=round(self.monotonic() - t0, 1))
        return n


def _dumps(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"))
"""The slot-2 signing policy: request parsing and the checks a frame must pass before any signature is requested.
Pure functions over bytes, strings and integer clocks; nothing here signs, reads a queue or reads an object.

Request (the issuer's format, service/issuer/tessera_issue/signers.py SlotSigner.send; authoritative):
  inline:    {"request_id", "sign_by", "frame_b64"}
  reference: {"request_id", "sign_by", "frame_ref", "frame_sha256"}       (IS-09)
No other member is accepted. `sign_by` is required here (the issuer always sends it; a request without a deadline is
refused rather than signed at any later time).

Policy (A9.6; service/issuer/DESIGN.md IS-03, IS-09; V1-OPERATIONS-RUNBOOK §3), every check before signing:
  - the frame decodes under the service verifier's codec as tessera-v1/attest or tessera-v1/manifest, within schema;
  - its alg (attest: common.alg; manifest: alg) is the registered pair id ALG;
  - attest: signer.key_fp is this key's gpg-sha256 fingerprint; manifest: sset[0] is;
  - attest: |declared_issue_time - signer clock| <= EPS (24 h, A9.2);
  - immediately before the HSM call: the clock is not past the configured signing stop, nor past the request's sign_by.
EPS, ALG and the policy are code, not configuration. Nothing in a request can change them."""
import json
import re
from dataclasses import dataclass

from tessera_verify.codec import HEX, HYBRID_ALG, Fault, b64, read_frame, utc

ALG = HYBRID_ALG                     # KMS-MLDSA65-PURE-GPG-OPENPGP4-ECDSA-P256-SHA256, the catalog's registered pair id
EPS = 24 * 3600                      # A9.2: refuse iff |declared - clock| > EPS
MAX_BODY = 1 << 20                   # one SQS message, bytes (the SQS maximum)
MAX_FRAME = 1 + 255 + 2 + 4 + (1 << 24)   # the largest frame the codec can accept (ENCODING-V1 §2)
T_ATTEST, T_MANIFEST = "tessera-v1/attest", "tessera-v1/manifest"
RE_REQID = re.compile(r"[A-Za-z0-9._:-]{1,128}")
RE_REF = re.compile(r"frames/[A-Za-z0-9._-]{1,128}/[0-9a-f]{64}")
INLINE_KEYS = frozenset(("request_id", "sign_by", "frame_b64"))
REF_KEYS = frozenset(("request_id", "sign_by", "frame_ref", "frame_sha256"))


class Refuse(Exception):
    """A refusal: the signer answers REFUSED with this reason and signs nothing."""

    def __init__(self, code, detail=""):
        super().__init__(f"{code}: {detail}")
        self.code, self.detail = code, detail


@dataclass(frozen=True)
class Request:
    request_id: str
    sign_by: int
    frame_b64: str | None = None
    frame_ref: str | None = None
    frame_sha256: str | None = None


def load(body):
    """Message body -> JSON object. BAD_REQUEST for anything else."""
    if not isinstance(body, str):
        raise Refuse("BAD_REQUEST", "body is not text")
    if len(body.encode("utf-8", "surrogatepass")) > MAX_BODY:
        raise Refuse("BAD_REQUEST", f"body of {len(body)} characters exceeds {MAX_BODY} bytes")
    try:
        obj = json.loads(body)
    except ValueError as e:
        raise Refuse("BAD_REQUEST", f"not JSON: {e}") from None
    if not isinstance(obj, dict):
        raise Refuse("BAD_REQUEST", "not a JSON object")
    return obj


def request_id(obj):
    rid = obj.get("request_id")
    if not (isinstance(rid, str) and RE_REQID.fullmatch(rid)):
        raise Refuse("BAD_REQUEST", "bad request_id")
    return rid


def parse(obj):
    """JSON object -> Request. Exactly one of the two shapes; strict values."""
    rid = request_id(obj)
    keys = set(obj)
    if keys not in (INLINE_KEYS, REF_KEYS):
        raise Refuse("BAD_REQUEST", f"members {sorted(keys)}; want {sorted(INLINE_KEYS)} or {sorted(REF_KEYS)}")
    try:
        sign_by = utc(obj["sign_by"])
    except Fault:
        raise Refuse("BAD_REQUEST", "sign_by is not an RFC 3339 UTC second") from None
    if keys == INLINE_KEYS:
        if not isinstance(obj["frame_b64"], str):
            raise Refuse("BAD_REQUEST", "frame_b64 is not a string")
        return Request(rid, sign_by, frame_b64=obj["frame_b64"])
    ref, digest = obj["frame_ref"], obj["frame_sha256"]
    if not (isinstance(ref, str) and RE_REF.fullmatch(ref)):
        raise Refuse("BAD_REQUEST", "frame_ref is not frames/<rid>/<sha256>")
    if not (isinstance(digest, str) and HEX.fullmatch(digest)):
        raise Refuse("BAD_REQUEST", "frame_sha256 is not 64 lowercase hex digits")
    return Request(rid, sign_by, frame_ref=ref, frame_sha256=digest)


def inline_frame(req):
    """Strict, canonical base64 (the issuer's b64e) -> bytes."""
    try:
        frame = b64(req.frame_b64)
    except Fault:
        raise Refuse("BAD_REQUEST", "frame_b64 is not canonical base64") from None
    if len(frame) > MAX_FRAME:
        raise Refuse("BAD_REQUEST", "frame too large")
    return frame


def check_frame(frame, key_fp, clock):
    """-> (kind, alg), or raises Refuse. `clock` is the signer's own clock, integer seconds."""
    if len(frame) < 1 or len(frame) < 1 + frame[0]:
        raise Refuse("TRUNCATED", "no complete tag")
    expected = T_MANIFEST if frame[1:1 + frame[0]] == T_MANIFEST.encode() else T_ATTEST   # else TAG_UNKNOWN/MISMATCH
    try:
        obj = read_frame(frame, expected)
    except Fault as e:
        raise Refuse(e.code, f"frame does not decode as {expected}") from None
    if expected == T_ATTEST:
        alg, fp = obj["common"]["alg"], obj["signer"]["key_fp"]
    else:
        alg, fp = obj["alg"], obj["sset"][0]
    if alg != ALG:
        raise Refuse("ALG_NOT_ALLOWED", alg)
    if fp != key_fp:
        raise Refuse("KEY_FP_MISMATCH", fp)
    if expected == T_ATTEST:
        declared = utc(obj["common"]["declared_issue_time"])
        if abs(declared - clock) > EPS:
            raise Refuse("DECLARED_TIME_OUTSIDE_EPSILON",
                         f"declared {obj['common']['declared_issue_time']}, difference {declared - clock} s, "
                         f"epsilon {EPS} s")
    return ("attest" if expected == T_ATTEST else "manifest"), alg


def check_stop(now, sign_until, sign_by):
    """IS-03, called immediately before the HSM call: refuse past the configured stop or the request's sign_by."""
    if now > sign_until:
        raise Refuse("SIGNING_STOPPED", f"signer clock {now} past the configured signing stop {sign_until}")
    if now > sign_by:
        raise Refuse("SIGNING_STOPPED", f"signer clock {now} past the request's sign_by {sign_by}")
"""Entry point of the Cloud Run job: read the configuration from the environment, check the HSM key, obtain AWS
credentials by web identity federation, and run once. Exit status 0 after a run (refusals included); 2 when the
signer refuses to run at all (configuration or key mismatch), so the job execution shows as failed.

Environment (all required unless a default is shown):
  REQUEST_QUEUE_URL, RESPONSE_QUEUE_URL   the issuer's gpg-slot queues (Terraform output signer_queues.gpg)
  FRAME_BUCKET                            the issuer's result bucket (Terraform output result_bucket); IS-09 frames
  AWS_ROLE_ARN, AWS_AUDIENCE              the web-identity role and the ID-token audience its trust requires
  AWS_CHAIN_ROLE_ARN (optional)           a second role to assume with the first role's credentials
  AWS_REGION_QUEUES (us-east-2)
  KMS_KEY_VERSION                         projects/.../cryptoKeys/<key>/cryptoKeyVersions/<n>
  KEY_CREATED, KEY_FP                     OpenPGP creation time bound into the fingerprint; the pinned gpg-sha256 fp
  SIGN_UNTIL                              the window's signing stop (not-after minus 96 h), RFC 3339 UTC second
  SIGNER_IMAGE (unknown), RUN_SECONDS (40), WAIT_SECONDS (5), VISIBILITY_SECONDS (120)"""
import json
import re
import sys
import time
from dataclasses import dataclass

from tessera_verify.codec import Fault, utc

from .signer import Signer, StartupError

RE_FP = re.compile(r"gpg-sha256:[0-9a-f]{64}")
RE_KEY_VERSION = re.compile(r"projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+/cryptoKeyVersions/[0-9]+")


@dataclass(frozen=True)
class Config:
    request_queue_url: str
    response_queue_url: str
    frame_bucket: str
    key_version: str
    key_created: int
    key_fp: str
    sign_until: int
    aws_role_arn: str
    aws_audience: str
    aws_region: str = "us-east-2"
    aws_chain_role_arn: str | None = None
    image: str = "unknown"
    budget_s: int = 40
    wait_s: int = 5
    visibility_s: int = 120


def config_from_env(env):
    """-> Config, or raises StartupError naming the first bad variable."""
    def need(name):
        v = env.get(name, "")
        if not v:
            raise StartupError(f"{name} is not set")
        return v

    def integer(name, default=None, lo=0, hi=None):
        raw = env.get(name, "") or (None if default is None else str(default))
        if raw is None:
            raise StartupError(f"{name} is not set")
        if not raw.isdigit() or int(raw) < lo or (hi is not None and int(raw) > hi):
            raise StartupError(f"{name}={raw!r} is not an integer in range")
        return int(raw)

    key_version, key_fp = need("KMS_KEY_VERSION"), need("KEY_FP")
    if not RE_KEY_VERSION.fullmatch(key_version):
        raise StartupError("KMS_KEY_VERSION is not a full key-version resource name")
    if not RE_FP.fullmatch(key_fp):
        raise StartupError("KEY_FP is not gpg-sha256:<64 hex>")
    try:
        sign_until = utc(need("SIGN_UNTIL"))
    except Fault:
        raise StartupError("SIGN_UNTIL is not an RFC 3339 UTC second (YYYY-MM-DDTHH:MM:SSZ)") from None
    return Config(request_queue_url=need("REQUEST_QUEUE_URL"), response_queue_url=need("RESPONSE_QUEUE_URL"),
                  frame_bucket=need("FRAME_BUCKET"), key_version=key_version,
                  key_created=integer("KEY_CREATED", lo=1, hi=2**32 - 1), key_fp=key_fp, sign_until=sign_until,
                  aws_role_arn=need("AWS_ROLE_ARN"), aws_audience=need("AWS_AUDIENCE"),
                  aws_region=env.get("AWS_REGION_QUEUES") or "us-east-2",
                  aws_chain_role_arn=env.get("AWS_CHAIN_ROLE_ARN") or None,
                  image=env.get("SIGNER_IMAGE") or "unknown", budget_s=integer("RUN_SECONDS", 40, 1, 3000),
                  wait_s=integer("WAIT_SECONDS", 5, 0, 20), visibility_s=integer("VISIBILITY_SECONDS", 120, 30, 43200))


def log(**fields):
    print(json.dumps(fields, sort_keys=True, default=str), flush=True)


def from_env(env):
    from . import gcp
    cfg = config_from_env(env)
    md = gcp.Metadata()
    kms = gcp.GcpKms(cfg.key_version, md.access_token)
    signer = Signer(cfg, kms, None, None, lambda: int(time.time()), time.monotonic, log)
    signer.load_key()                     # before any AWS credential is obtained or any message is read
    signer.sqs, signer.s3 = gcp.aws_clients(cfg.aws_role_arn, cfg.aws_audience, cfg.aws_region, md.id_token,
                                            gcp.boto3_client, cfg.aws_chain_role_arn)
    return signer


def main(env=None):
    import os
    try:
        signer = from_env(os.environ if env is None else env)
    except StartupError as e:
        log(event="refuse_to_run", error=str(e))
        return 2
    signer.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""The real adapters: the Google metadata server (access and ID tokens for the job's own service account), Cloud KMS
over REST with CRC32C integrity checks, and AWS credentials by web identity federation. No static credential of any
kind: the job runs as its service account, and AWS trusts a Google-issued ID token for that account.

AWS credentials (README "AWS credentials"): the metadata server mints an ID token for this service account with the
configured audience; STS AssumeRoleWithWebIdentity exchanges it for a role in the issuing AWS account whose trust
names accounts.google.com with this account's unique ID (sub, aud) and the audience (oaud). If a second role is
configured (chain_role_arn), those credentials then AssumeRole into it: that is how the issuer's Terraform signer
role (principal = the first role's ARN) is reached without a Terraform change. Sessions last 900 s; one run is far
shorter."""
import base64
import json
import urllib.error
import urllib.parse
import urllib.request

MD = "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/"
KMS = "https://cloudkms.googleapis.com/v1/"
SESSION_S = 900


def crc32c(data):
    crc = 0xFFFFFFFF
    for b in data:
        crc ^= b
        for _ in range(8):
            crc = (crc >> 1) ^ (0x82F63B78 & -(crc & 1))
    return crc ^ 0xFFFFFFFF


def http(method, url, headers, body=None, timeout=30):
    """-> response bytes; raises RuntimeError with the status on an HTTP error."""
    req = urllib.request.Request(url, method=method, data=body, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"{method} {url.split('?')[0]}: HTTP {e.code} {e.read()[:300]!r}") from None


class Metadata:
    def __init__(self, fetch=http):
        self.fetch = fetch

    def _get(self, path):
        return self.fetch("GET", MD + path, {"Metadata-Flavor": "Google"}, timeout=10).decode()

    def access_token(self):
        return json.loads(self._get("token"))["access_token"]

    def id_token(self, audience):
        return self._get(f"identity?audience={urllib.parse.quote(audience, safe='')}&format=full")


class GcpKms:
    """One key version: its public key, and asymmetricSign over a SHA-256 digest with request and response
    CRC32C checks (Cloud KMS data integrity guidelines)."""

    def __init__(self, key_version, token, fetch=http):
        self.key_version, self.token, self.fetch = key_version, token, fetch

    def _call(self, method, suffix, body=None):
        data = None if body is None else json.dumps(body).encode()
        out = self.fetch(method, KMS + self.key_version + suffix,
                         {"Authorization": "Bearer " + self.token(), "Content-Type": "application/json"}, data)
        return json.loads(out)

    def public_key(self):
        pk = self._call("GET", "/publicKey")
        if "pemCrc32c" in pk and int(pk["pemCrc32c"]) != crc32c(pk.get("pem", "").encode()):
            raise RuntimeError("KMS public key CRC32C mismatch")
        return pk

    def sign_digest(self, digest):
        out = self._call("POST", ":asymmetricSign", {"digest": {"sha256": base64.b64encode(digest).decode()},
                                                     "digestCrc32c": str(crc32c(digest))})
        if out.get("name") != self.key_version or out.get("verifiedDigestCrc32c") is not True:
            raise RuntimeError(f"KMS response integrity: name={out.get('name')} "
                               f"verified={out.get('verifiedDigestCrc32c')}")
        der = base64.b64decode(out["signature"])
        if int(out["signatureCrc32c"]) != crc32c(der):
            raise RuntimeError("KMS signature CRC32C mismatch")
        return der


def aws_clients(role_arn, audience, region, id_token, make_client, chain_role_arn=None):
    """-> (sqs, s3) clients on federated credentials. make_client(service, region, credentials-or-None)."""
    sts = make_client("sts", region, None)
    creds = sts.assume_role_with_web_identity(RoleArn=role_arn, RoleSessionName="tessera-signer-gpg",
                                              WebIdentityToken=id_token(audience),
                                              DurationSeconds=SESSION_S)["Credentials"]
    if chain_role_arn:
        sts2 = make_client("sts", region, creds)
        creds = sts2.assume_role(RoleArn=chain_role_arn, RoleSessionName="tessera-signer-gpg",
                                 DurationSeconds=SESSION_S)["Credentials"]
    return make_client("sqs", region, creds), make_client("s3", region, creds)


def boto3_client(service, region, creds):
    import boto3
    if creds is None:
        return boto3.client(service, region_name=region)
    return boto3.client(service, region_name=region, aws_access_key_id=creds["AccessKeyId"],
                        aws_secret_access_key=creds["SecretAccessKey"], aws_session_token=creds["SessionToken"])

