import base64
import hashlib
import json
import time

import pytest
from tessera_verify.codec import (frame, isotime, jcs, parse_signature, public_key, registered_codecs, sig_policy,
                                  signature_verifies, utc)

from tessera_signer import openpgp
from tessera_signer.main import Config
from tessera_signer.policy import ALG
from tessera_signer.signer import Signer

from fakes import Clock, FakeKms, FakeS3, FakeSqs

T0 = utc("2026-11-10T12:00:00Z")
SIGN_UNTIL = T0 + 10 * 86400
KEY_VERSION = "projects/tessera-slot2/locations/us-east1/keyRings/tessera-v1/cryptoKeys/slot2/cryptoKeyVersions/1"
KEY_CREATED = 1791946553
REQ, RESP, BUCKET = "https://sqs.test/gpg-requests", "https://sqs.test/gpg-responses", "issuer-results"


def attest(key_fp, declared, alg=ALG, content=None):
    common = {"alg": alg, "binding_forms": ["STMT_DIRECT"], "content": content or {"statement": "test"},
              "declared_issue_time": isotime(declared), "issuer": "wamason.com", "manifest_sha256": "a" * 64,
              "preamble_sha256": "b" * 64, "profile": "tessera-v1-strict",
              "spec": {"id": "tessera-v1-strict/verification-spec/1", "sha256": "c" * 64}, "vectors_sha256": "d" * 64}
    return frame("tessera-v1/attest", jcs({"common": common, "signer": {"key_fp": key_fp}}))


def manifest(gpg_fp, alg=ALG):
    return frame("tessera-v1/manifest", jcs({"alg": alg, "issuer": "wamason.com", "key_fp": "spki-sha256:" + "e" * 64,
                                             "sset": [gpg_fp], "ver": "map-v1"}))


class Env:
    def __init__(self):
        self.clock = Clock(T0)
        self.sqs, self.s3, self.kms = FakeSqs(self.clock), FakeS3(), FakeKms(KEY_VERSION)
        self.key_body = openpgp.key_body(openpgp.point65(self.kms.key.public_key()), KEY_CREATED)
        self.fp = openpgp.fp_gpg(self.key_body)
        self.logs = []
        self.cfg = self.config()
        self.signer = self.make_signer()

    def config(self, **kw):
        base = dict(request_queue_url=REQ, response_queue_url=RESP, frame_bucket=BUCKET, key_version=KEY_VERSION,
                    key_created=KEY_CREATED, key_fp=self.fp, sign_until=SIGN_UNTIL, aws_role_arn="arn:aws:iam::1:role/r",
                    aws_audience="aud", image="test", budget_s=40, wait_s=0, visibility_s=120)
        base.update(kw)
        return Config(**base)

    def make_signer(self, cfg=None, kms=None):
        s = Signer(cfg or self.cfg, kms or self.kms, self.sqs, self.s3, self.clock, time.monotonic,
                   lambda **f: self.logs.append(f))
        s.load_key()
        return s

    def enqueue(self, msg):
        body = msg if isinstance(msg, str) else json.dumps(msg, sort_keys=True)
        return self.sqs.send_message(QueueUrl=REQ, MessageBody=body)["MessageId"]

    def inline(self, data, rid="req-1", sign_by=None):
        return self.enqueue({"request_id": rid, "frame_b64": base64.b64encode(data).decode(),
                             "sign_by": isotime(SIGN_UNTIL if sign_by is None else sign_by)})

    def by_ref(self, data, rid="req-1", sign_by=None, stored=None, digest=None):
        digest = digest or hashlib.sha256(data).hexdigest()
        ref = f"frames/rid-1/{digest}"
        if stored is not False:
            self.s3.put(BUCKET, ref, data if stored is None else stored)
        return self.enqueue({"request_id": rid, "frame_ref": ref, "frame_sha256": digest,
                             "sign_by": isotime(SIGN_UNTIL if sign_by is None else sign_by)})

    def run(self):
        return self.signer.run()

    def responses(self):
        return self.sqs.take(RESP)

    def one(self):
        self.run()
        out = self.responses()
        assert len(out) == 1, out
        return out[0]

    def verifies(self, data, sig_b64):
        sig = base64.b64decode(sig_b64)
        parsed = parse_signature(sig, ALG, "gpg", registered_codecs(ALG))
        sig_policy(parsed)
        return signature_verifies(data, parsed, public_key(self.key_body, "gpg", ALG))

    def events(self, name):
        return [e for e in self.logs if e.get("event") == name]


@pytest.fixture
def env():
    return Env()
"""In-memory stand-ins for the clients the signer uses (boto3-style SQS and S3, the Cloud KMS adapter), implementing
exactly the calls the signer makes (no AWS, no GCP, no network)."""
import io
import itertools
import json

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec, utils

SQS_MAX_BYTES = 1048576


class ClientError(Exception):
    def __init__(self, code):
        super().__init__(code)
        self.response = {"Error": {"Code": code}}


class Clock:
    def __init__(self, t):
        self.t = int(t)

    def __call__(self):
        return self.t

    def advance(self, s):
        self.t += int(s)


class FakeSqs:
    """At-least-once queues with visibility timeouts and receive counts, on the given clock."""

    def __init__(self, clock):
        self.clock, self.queues, self._ids = clock, {}, itertools.count(1)
        self.fail_delete = False
        self.fail_send = False

    def _q(self, url):
        return self.queues.setdefault(url, {})

    def send_message(self, QueueUrl, MessageBody):
        if self.fail_send:
            raise ClientError("ServiceUnavailable")
        if len(MessageBody.encode()) > SQS_MAX_BYTES:
            raise ClientError("InvalidParameterValue")
        mid = f"m{next(self._ids)}"
        self._q(QueueUrl)[mid] = {"body": MessageBody, "visible_at": 0, "receives": 0, "handle": None}
        return {"MessageId": mid}

    def receive_message(self, QueueUrl, MaxNumberOfMessages=1, WaitTimeSeconds=0, VisibilityTimeout=30,
                        MessageSystemAttributeNames=()):
        now, out = self.clock(), []
        for mid, m in self._q(QueueUrl).items():
            if len(out) >= MaxNumberOfMessages:
                break
            if m["visible_at"] <= now:
                m["visible_at"], m["receives"] = now + VisibilityTimeout, m["receives"] + 1
                m["handle"] = f"{mid}:{next(self._ids)}"
                msg = {"MessageId": mid, "ReceiptHandle": m["handle"], "Body": m["body"]}
                if "ApproximateReceiveCount" in MessageSystemAttributeNames:
                    msg["Attributes"] = {"ApproximateReceiveCount": str(m["receives"])}
                out.append(msg)
        return {"Messages": out} if out else {}

    def delete_message(self, QueueUrl, ReceiptHandle):
        if self.fail_delete:
            raise ClientError("ServiceUnavailable")
        mid = ReceiptHandle.split(":")[0]
        m = self._q(QueueUrl).get(mid)
        if m is not None and m["handle"] == ReceiptHandle:
            del self._q(QueueUrl)[mid]

    def bodies(self, url):
        return [json.loads(m["body"]) for m in self._q(url).values()]

    def take(self, url):
        """All messages on a queue as JSON, removing them (what a consumer that deletes would see)."""
        out = self.bodies(url)
        self._q(url).clear()
        return out


class QueueView:
    """The issuer's Queue interface (send / receive / delete) over one FakeSqs queue, so the issuer's own SlotSigner
    can drive the signer in the conformance tests."""

    def __init__(self, sqs, url):
        self.sqs, self.url = sqs, url

    def send(self, body):
        return self.sqs.send_message(QueueUrl=self.url, MessageBody=body)["MessageId"]

    def receive(self, max_messages=10, wait_s=0):
        from types import SimpleNamespace
        r = self.sqs.receive_message(QueueUrl=self.url, MaxNumberOfMessages=max_messages, VisibilityTimeout=60)
        return [SimpleNamespace(id=m["MessageId"], body=m["Body"], handle=m["ReceiptHandle"])
                for m in r.get("Messages", [])]

    def delete(self, handle):
        self.sqs.delete_message(QueueUrl=self.url, ReceiptHandle=handle)


class FakeS3:
    def __init__(self):
        self.objects, self.calls = {}, []
        self.transient = 0                     # this many get_object calls raise a non-404 error first

    def put(self, bucket, key, data):
        self.objects[(bucket, key)] = bytes(data)

    def get_object(self, Bucket, Key):
        self.calls.append((Bucket, Key))
        if self.transient:
            self.transient -= 1
            raise ClientError("SlowDown")
        data = self.objects.get((Bucket, Key))
        if data is None:
            raise ClientError("NoSuchKey")
        return {"Body": io.BytesIO(data), "ContentLength": len(data)}


class FakeKms:
    """A P-256 key standing in for the HSM key version. sign_digest signs the digest as Cloud KMS does."""

    def __init__(self, name, algorithm="EC_SIGN_P256_SHA256", protection="HSM", key=None):
        self.key = key or ec.generate_private_key(ec.SECP256R1())
        self.name, self.algorithm, self.protection = name, algorithm, protection
        self.signed = []                       # digests signed
        self.fail = 0                          # this many sign calls raise first
        self.corrupt = False                   # return a signature over a different digest

    def public_key(self):
        pem = self.key.public_key().public_bytes(serialization.Encoding.PEM,
                                                 serialization.PublicFormat.SubjectPublicKeyInfo).decode()
        return {"name": self.name, "algorithm": self.algorithm, "protectionLevel": self.protection, "pem": pem}

    def sign_digest(self, digest):
        if self.fail:
            self.fail -= 1
            raise RuntimeError("KMS :asymmetricSign: HTTP 503")
        self.signed.append(digest)
        d = bytes(32) if self.corrupt else digest
        return self.key.sign(d, ec.ECDSA(utils.Prehashed(hashes.SHA256())))
"""Successful signing, E-02 duplicate and late requests, startup checks and configuration."""
import base64
import hashlib

import pytest
from tessera_verify.codec import isotime, parse_signature, registered_codecs

from tessera_signer import openpgp
from tessera_signer.main import config_from_env, main
from tessera_signer.policy import ALG
from tessera_signer.signer import StartupError

from conftest import KEY_CREATED, KEY_VERSION, REQ, SIGN_UNTIL, T0, attest, manifest
from fakes import FakeKms


# ------------------------------------------------------------------------------------------ signing
def test_attest_inline_signed_and_verifies(env):
    data = attest(env.fp, T0)
    env.inline(data, rid="req-abc")
    r = env.one()
    assert r["status"] == "SIGNED" and r["request_id"] == "req-abc" and r["kind"] == "attest"
    assert env.verifies(data, r["sig_b64"])
    sig = base64.b64decode(r["sig_b64"])
    assert r["sig_sha256"] == hashlib.sha256(sig).hexdigest()
    assert r["frame_sha256"] == hashlib.sha256(data).hexdigest()
    assert r["signer"]["slot"] == "gpg" and r["signer"]["key_fp"] == env.fp
    assert len(env.kms.signed) == 1
    assert env.sqs.bodies(REQ) == []


def test_manifest_possession_signed(env):
    data = manifest(env.fp)
    env.inline(data)
    r = env.one()
    assert r["status"] == "SIGNED" and r["kind"] == "manifest" and env.verifies(data, r["sig_b64"])


def test_frame_ref_signed_over_the_referenced_bytes(env):
    data = attest(env.fp, T0, content={"statement": "x" * 400_000})     # too large for an inline message
    env.by_ref(data)
    r = env.one()
    assert r["status"] == "SIGNED" and env.verifies(data, r["sig_b64"])
    assert r["frame_sha256"] == hashlib.sha256(data).hexdigest()


def test_signature_does_not_verify_on_other_bytes(env):
    data = attest(env.fp, T0)
    env.inline(data)
    r = env.one()
    assert not env.verifies(data + b"x", r["sig_b64"])
    assert not env.verifies(attest(env.fp, T0 + 1), r["sig_b64"])


def test_signature_packet_layout(env):
    """Hashed {33 issuer fingerprint, 2 creation time = the clock read before signing}, unhashed {16 key id}."""
    env.clock.t = T0 + 77
    env.inline(attest(env.fp, T0))
    sig = parse_signature(base64.b64decode(env.one()["sig_b64"]), ALG, "gpg", registered_codecs(ALG))
    fpr = openpgp.v4_fingerprint(env.key_body)
    assert [(t, d) for t, _, d in sig.hashed] == [(33, b"\x04" + fpr), (2, (T0 + 77).to_bytes(4, "big"))]
    assert [(t, d) for t, _, d in sig.unhashed] == [(16, fpr[-8:])]


def test_every_signature_is_logged_before_its_response(env):
    data = attest(env.fp, T0)
    env.inline(data)
    env.run()
    events = [e["event"] for e in env.logs]
    assert events.index("signed") < events.index("response")
    (s,) = env.events("signed")
    (r,) = env.responses()
    assert s["sig_sha256"] == r["sig_sha256"] and s["frame_sha256"] == hashlib.sha256(data).hexdigest()


def test_a_run_answers_every_queued_request(env):
    for i in range(23):
        env.inline(attest(env.fp, T0 + i), rid=f"req-{i}")
    assert env.run() == 23
    out = env.responses()
    assert sorted(r["request_id"] for r in out) == sorted(f"req-{i}" for i in range(23))
    assert all(r["status"] == "SIGNED" for r in out)


# ------------------------------------------------------------------------------------------ E-02
def test_duplicate_request_in_one_run_gets_the_same_signature(env):
    """The issuer's retry reuses the request id; the second delivery is answered without a second signature."""
    data = attest(env.fp, T0)
    env.inline(data, rid="req-dup")
    env.inline(data, rid="req-dup")
    env.run()
    a, b = env.responses()
    assert a["status"] == b["status"] == "SIGNED" and a["sig_b64"] == b["sig_b64"]
    assert len(env.kms.signed) == 1
    assert len(env.events("signed")) == 1 and len(env.events("resent")) == 1


def test_same_request_id_with_other_frame_is_signed_separately(env):
    env.inline(attest(env.fp, T0), rid="req-x")
    env.inline(attest(env.fp, T0 + 1), rid="req-x")
    env.run()
    a, b = env.responses()
    assert a["sig_b64"] != b["sig_b64"] and len(env.kms.signed) == 2


def test_redelivery_after_a_failed_delete_signs_again_in_a_later_run(env):
    """No memory across runs: the response was sent but the request not deleted, so the next run answers again. Both
    signatures verify, carry the same request id, and are both logged; the issuer records the second as a
    duplicate."""
    data = attest(env.fp, T0)
    env.inline(data, rid="req-late")
    env.sqs.fail_delete = True
    env.run()
    env.sqs.fail_delete = False
    assert len(env.events("handle_error")) == 1
    env.clock.advance(env.cfg.visibility_s)
    env.signer = env.make_signer()                       # a new job execution
    env.run()
    a, b = env.responses()
    assert a["request_id"] == b["request_id"] == "req-late"
    assert env.verifies(data, a["sig_b64"]) and env.verifies(data, b["sig_b64"])
    assert len(env.events("signed")) == 2
    assert env.sqs.bodies(REQ) == []


def test_late_request_past_sign_by_is_refused_not_signed(env):
    """The issuer gave up on a request (sign_by passed); a signer that runs only afterwards refuses it."""
    data = attest(env.fp, T0)
    env.inline(data, rid="req-old", sign_by=T0 + 600)
    env.clock.advance(3600)
    r = env.one()
    assert r["status"] == "REFUSED" and r["reason"] == "SIGNING_STOPPED" and env.kms.signed == []


def test_failed_send_leaves_the_request_and_logs_the_signature(env):
    env.inline(attest(env.fp, T0))
    env.sqs.fail_send = True
    env.run()
    env.sqs.fail_send = False
    assert len(env.events("signed")) == 1 and env.responses() == []
    assert len(env.sqs.bodies(REQ)) == 1                 # redelivered after the visibility timeout


# ------------------------------------------------------------------------------------------ startup
@pytest.mark.parametrize("kw,match", [
    ({"name": KEY_VERSION.replace("/1", "/2")}, "key version"),
    ({"algorithm": "EC_SIGN_P384_SHA384"}, "algorithm"),
    ({"protection": "SOFTWARE"}, "protection level"),
])
def test_startup_refuses_a_different_key(env, kw, match):
    kms = FakeKms(kw.get("name", KEY_VERSION), kw.get("algorithm", "EC_SIGN_P256_SHA256"),
                  kw.get("protection", "HSM"), key=env.kms.key)
    with pytest.raises(StartupError, match=match):
        env.make_signer(kms=kms)


def test_startup_refuses_a_key_with_another_fingerprint(env):
    with pytest.raises(StartupError, match="fingerprint"):
        env.make_signer(kms=FakeKms(KEY_VERSION))        # a fresh key: the pinned fingerprint is not its own


def test_startup_refuses_a_wrong_creation_time(env):
    with pytest.raises(StartupError, match="fingerprint"):
        env.make_signer(cfg=env.config(key_created=KEY_CREATED + 1))


