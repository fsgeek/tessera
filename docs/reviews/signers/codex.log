    20	
    21	class EncodeError(ValueError):
    22	    pass
    23	
    24	
    25	def header(tag):
    26	    return bytes([len(tag)]) + tag
    27	
    28	
    29	def frame(tag, payload):
    30	    if len(payload) > MAX_PAYLOAD:
    31	        raise EncodeError("payload above 2^24 bytes")
    32	    return header(tag) + struct.pack(">HI", 1, len(payload)) + payload
    33	
    34	
    35	def fp_kms(spki_der):
    36	    return "spki-sha256:" + hashlib.sha256(spki_der).hexdigest()
    37	
    38	
    39	def fp_gpg(v4_body):
    40	    return "gpg-sha256:" + hashlib.sha256(v4_body).hexdigest()
    41	
    42	
    43	def openpgp_v4_body(point65, created):
    44	    return bytes([4]) + struct.pack(">I", created) + bytes([19, len(P256_OID)]) + P256_OID + struct.pack(">H", 515) + point65
    45	
    46	
    47	def encode_manifest(kms_fp, gpg_fp, alg=ALG, issuer=D):
    48	    f = frame(T_MANIFEST, jcs({"alg": alg, "issuer": issuer, "key_fp": kms_fp, "sset": [gpg_fp], "ver": "map-v1"}))
    49	    read_frame(f, "tessera-v1/manifest")
    50	    return f
    51	
    52	
    53	def common_metadata(content_b64, declared_issue_time, manifest, catalog):
    54	    return {"alg": catalog["alg"], "binding_forms": ["STMT_DIRECT"], "content": content_b64,
    55	            "declared_issue_time": declared_issue_time, "issuer": D, "manifest_sha256": sha256hex(manifest),
    56	            "preamble_sha256": catalog["preamble_sha256"], "profile": PROFILE,
    57	            "spec": {"id": SPEC_ID, "sha256": catalog["spec_sha256"]}, "vectors_sha256": catalog["vectors_sha256"]}
    58	
    59	
    60	def encode_attest(common, key_fp):
    61	    f = frame(T_ATTEST, jcs({"common": common, "signer": {"key_fp": key_fp}}))
    62	    read_frame(f, "tessera-v1/attest")
    63	    return f
    64	
    65	
    66	def encode_anchor(f_kms, s_kms, f_gpg, s_gpg):
    67	    """A_sig: header || 0x02 || per slot in manifest order: u32 len(F) || F || u32 len(S) || S (ENC section 5)."""
    68	    out = header(T_ANCHOR) + bytes([2])
    69	    for part in (f_kms, s_kms, f_gpg, s_gpg):
    70	        out += struct.pack(">I", len(part)) + part
    71	    read_anchor(out, registered_codecs(ALG))
    72	    return out
