data "aws_partition" "current" {}

data "aws_sqs_queue" "requests" {
  name = "${var.issuer_name}-kms-requests"
}

data "aws_sqs_queue" "responses" {
  name = "${var.issuer_name}-kms-responses"
}

locals {
