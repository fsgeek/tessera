    81	    with tempfile.TemporaryDirectory() as tmp:
    82	        stage = Path(tmp) / "stage"
    83	        subprocess.run(["uv", "pip", "install", "--quiet", "--target", str(stage), "--python-version", "3.14",
    84	                        "--python-platform", PLATFORM, "--only-binary", ":all:", *WHEEL], check=True)
    85	        shutil.copytree(HERE / "tessera_issue", stage / "tessera_issue", ignore=ignore)
    86	        shutil.copytree(VERIFIER / "tessera_verify", stage / "tessera_verify", ignore=ignore)
    87	        shutil.copytree(FROZEN, stage / "freeze-v1" / "objects", ignore=ignore)
    88	        dest = stage / LAMBDA_BINARY.removeprefix("/var/task/")
    89	        dest.parent.mkdir(parents=True)
    90	        shutil.copyfile(binary, dest)
    91	        dest.chmod(0o755)
    92	        if rec:
    93	            (dest.parent.parent / "install.json").write_text(json.dumps(rec, indent=1, sort_keys=True) + "\n")
    94	        digest = write_zip(stage, out)
    95	    return digest
