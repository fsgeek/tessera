    75	def encode_snapshot_envelope(body):
    76	    if not 1 <= len(body) <= MAX_PAYLOAD:
    77	        raise EncodeError("snapshot body length")
    78	    return header(T_SNAPSHOT) + struct.pack(">I", len(body)) + body
