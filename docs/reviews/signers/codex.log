    81	def assertion_value(kms_fp, gpg_fp, not_before, not_after):
    82	    """The ENC section 7 value: exactly 255 bytes, no LF; the TXT string and the git blob."""
    83	    nb, na = ts(not_before), ts(not_after)
    84	    if rfc3339(nb) != not_before or rfc3339(na) != not_after:
    85	        raise EncodeError("window times must be canonical RFC 3339 seconds")
    86	    if not 0 < na - nb <= WINDOW_MAX_SECONDS:
    87	        raise EncodeError("window must be non-empty and at most 90 days")
    88	    v = (f"v=tessera1;profile={PROFILE};kms={kms_fp.split(':')[1]};gpg={gpg_fp.split(':')[1]};"
    89	         f"issuance-not-before={not_before};issuance-not-after={not_after}").encode("ascii")
    90	    if len(v) != 255:
    91	        raise EncodeError(f"assertion value is {len(v)} bytes, not 255")
    92	    return v
    93	
    94	
    95	def txt_rdata(value):
    96	    if len(value) > 255:
    97	        raise EncodeError("TXT string too long")
    98	    return bytes([len(value)]) + value

