  MaxTime = 14
  Delta = 3
  DepthK = 2
  MaxAttempts = 3

INIT Init
NEXT Next

INVARIANTS
  NoShippedOrphan
  ShippedIsSound
  ExpiredCannotShip
  NoSilentDeadlock
  RefusedOnlyWhenExhausted
  RefusalTimeConsistent

