     1	---------------------------- MODULE P4_VerifierStates ----------------------------
     2	(***************************************************************************)
     3	(* Tessera Band 0 — P4: fail-closed verifier state logic.                 *)
     4	(* Authoritative property statements: Amendment 1 §A1.2 (P4) and §A1.2.1  *)
     5	(* (the waiver lattice). This module is the machine-checkable form.       *)
     6	(*                                                                         *)
     7	(* The verifier's verdict over a bundle is a pure function (P9) of the     *)
     8	(* per-check outcomes and the verifier's declared policy. TLC exhaustively *)
     9	(* enumerates every combination of check outcomes and every policy, and   *)
    10	(* checks the A1.2/A1.2.1 invariants over all of them. There is no        *)
    11	(* temporal behavior here — evaluation is instantaneous — so the "state   *)
    12	(* machine" is degenerate: all the content is in the Init enumeration and *)
    13	(* the invariants.                                                         *)
    14	(*                                                                         *)
    15	(* Reading guide (Tony): Checks is an abstract set of the verifier's      *)
    16	(* individual checks (signature-verifies, manifest-evidence-validates,    *)
    17	(* temporal-consistency, ...). NonWaivable \subseteq Checks per A1.2.1.   *)
    18	(* `status` assigns each check pass/fail/unperformable; `waived` is the   *)
   105	Verdict == VerdictFor(waived)
   106	
   107	(***************************************************************************)
   108	(* Invariants — each maps to a clause of A1.2 P4 / A1.2.1.                *)
   109	(***************************************************************************)
   110	
   111	(* P4: the four states partition all outcomes (totality; never a bare     *)
   112	(* boolean, never a fifth state).                                          *)
   113	Partition == Verdict \in Verdicts
   114	
   115	(* A1.2.1 monotonicity: a failed non-waivable check is INVALID under      *)
   116	(* EVERY policy — no waiver set may promote it.                            *)
   117	Monotonicity ==
   118	  (\E c \in NonWaivable : status[c] = "fail") =>
   119	    \A W \in SUBSET Waivable : VerdictFor(W) = "INVALID"
   120	
   121	(* A1.2.1: an unperformable non-waivable check never yields any VALID     *)
   122	(* state, under any policy. (INVALID is permitted: some other required    *)
   123	(* check may have definitively failed.)                                    *)
   124	NoSilentPromotion ==
   125	  (\E c \in NonWaivable : status[c] = "unperformable") =>
   126	    \A W \in SUBSET Waivable :
   127	      VerdictFor(W) \in {"INVALID", "UNVERIFIABLE"}
   128	
   129	(* P1-facing corollary: any VALID verdict means every non-waivable check  *)
   130	(* was performed and passed.                                               *)
   131	ValidNeedsNonWaivablePass ==
   132	  (Verdict \in {"VALID_STRICT", "VALID_DEGRADED"}) =>
   133	    \A c \in NonWaivable : status[c] = "pass"
   134	
   135	(* P4/§3.1: VALID_STRICT is the fail-closed default — every check, not    *)
   136	(* just the required ones, performed and passed.                           *)
   137	StrictMeansEverything ==
   138	  Verdict = "VALID_STRICT" => \A c \in Checks : status[c] = "pass"
   139	
   140	(* A1.2.1: VALID_DEGRADED only arises from an explicit, nonempty waiver   *)
   141	(* within the waivable set — never as a default.                           *)
   142	DegradedNeedsExplicitWaiver ==
   143	  Verdict = "VALID_DEGRADED" => (waived # {} /\ waived \subseteq Waivable)
   144	
   145	(* UNVERIFIABLE is honest: it arises only when some required check truly  *)
   146	(* could not be performed (and none failed).                               *)
   147	UnverifiableIsHonest ==
   148	  Verdict = "UNVERIFIABLE" =>
   149	    /\ \E c \in RequiredUnder(waived) : status[c] = "unperformable"
   150	    /\ \A c \in RequiredUnder(waived) : status[c] # "fail"
   151	
   152	(***************************************************************************)
   153	(* Exact classification (iff, not just one-way safety). The one-way       *)
   154	(* implications above would all pass under an over-conservative verdict   *)
   155	(* function (e.g. everything INVALID); these pin the classification in    *)
   156	(* both directions, so a future edit to VerdictFor cannot silently drift  *)
   157	(* toward misclassification in either the permissive or the conservative  *)
   158	(* direction. Together the four right-hand sides partition all outcomes.  *)
   159	(***************************************************************************)
   160	AnyRequiredFail == \E c \in RequiredUnder(waived) : status[c] = "fail"
   161	AnyRequiredUnperf == \E c \in RequiredUnder(waived) : status[c] = "unperformable"
   162	AllRequiredPass == \A c \in RequiredUnder(waived) : status[c] = "pass"
   163	
   164	ExactInvalid ==
   165	  (Verdict = "INVALID") <=> AnyRequiredFail
   166	
   167	ExactUnverifiable ==
   168	  (Verdict = "UNVERIFIABLE") <=> (~AnyRequiredFail /\ AnyRequiredUnperf)
   169	
   170	ExactStrict ==
   171	  (Verdict = "VALID_STRICT") <=>
   172	    (waived = {} /\ \A c \in Checks : status[c] = "pass")
   173	
   174	ExactDegraded ==
   175	  (Verdict = "VALID_DEGRADED") <=> (waived # {} /\ AllRequiredPass)
   176	
   177	(***************************************************************************)
