        L.add(f"BYTES.{s['slot']}.frame_wellformed", PASS if not fails else FAIL, str(fails))
        pl = json.loads(fr.payload)
        commons.append(pl["common"]); fp = fingerprint(s["alg"], pub); fps.append(fp)
        L.add(f"BYTES.{s['slot']}.signer_fp_in_slot", PASS if pl["signer"]["key_fp"] == fp else FAIL, "")
    L.add("BYTES.common_equal", PASS if commons[0] == commons[1] else FAIL)
    L.add("BYTES.tuple_matches_keys", PASS if (t["key_fp"], t["sset"]) == (fps[0], fps[1:]) else FAIL)
    L.add("BYTES.manifest_hash", PASS if commons[0]["manifest_hash"] == objects.manifest_hash(t) else FAIL)
    L.add("AUTH.owner_name_bound", PASS if t["issuer_id"] == domain == commons[0]["issuer_id"] else FAIL,
          f"signed issuer_id={commons[0]['issuer_id']} trust D={domain}")
    pf = objects.possession_frame(t)
    for s, p in zip(slots, man["possession"]):
        ok = gpg.verify_openpgp_slot(s["alg"], b64d(s["pubkey_b64"]), b64d(p["sig_b64"]), pf)
        L.add(f"SIG.{s['slot']}.possession", PASS if ok else FAIL)
    pre = (HERE / "out" / b["preimage_file"]).read_bytes()
    want = b"tessera/v0/receipt-digest\x00" + b"".join(len(f).to_bytes(4, "big") + f for f in frames)
    L.add("BYTES.anchor_preimage_rebuilt", PASS if pre == want and hashlib.sha256(pre).hexdigest() == b["receipt_digest"] else FAIL)
    return pre, parse_iso(commons[0]["declared_issue_time"])

# ---------------------------------------------------------------- 2. DNSSEC chain (C4 i)
def _sets(msg, section):
    data, sigs = {}, {}
    for rr in getattr(msg, section):
        (sigs if rr.rdtype == dns.rdatatype.RRSIG else data)[(rr.name, rr.covers if rr.rdtype == dns.rdatatype.RRSIG else rr.rdtype)] = rr
    return data, sigs

def check_dnssec(snap, trust, now, domain, L):
    """Validate root -> com -> D at time `now`. Returns the list of (label, inception, expiration) of every RRSIG used."""
    M = {k: dns.message.from_wire(base64.b64decode(v)) for k, v in snap["messages"].items()}
    used = []
    def val(label, rrset, sigset, keys_by_zone, only_tags=None):
        sigs = sigset
        if only_tags is not None:
            sigs = dns.rrset.RRset(sigset.name, sigset.rdclass, sigset.rdtype, sigset.covers)
            for s in sigset:
                if s.key_tag in only_tags: sigs.add(s)
            if not len(sigs): raise dns.dnssec.ValidationFailure("no RRSIG by an allowed key")
        dns.dnssec.validate(rrset, sigs, keys_by_zone, now=now)
        for s in sigs: used.append((label, s.inception, s.expiration, s.key_tag))
    root = dns.name.root
    # root DNSKEY RRset (A9.5 root-KSK rule, existential): valid at `now` iff SOME trusted KSK whose SIGNING period
    # contains `now` is present with the pinned digest and validates it. A trusted KSK that is published but not signing
    # (or outside its signing period) is informational and never a failure; a KSK's publication period is not used here.
    kd, ks = _sets(M[". DNSKEY"], "answer")
    if (root, dns.rdatatype.DNSKEY) not in kd or (root, dns.rdatatype.DNSKEY) not in ks:
        L.add("DNSSEC.root.dnskey_rrset", UNPERF, "NO_TRUSTED_KSK_USABLE (root DNSKEY RRset or its RRSIG missing from the snapshot)"); return used
    keys = kd[(root, dns.rdatatype.DNSKEY)]; rs = ks[(root, dns.rdatatype.DNSKEY)]
    usable = []; outside = []
    for ksk in trust["root_ksks"]:
        lo = parse_iso(ksk["signing_valid_from"]); hi = parse_iso(ksk["signing_valid_until"]) if ksk["signing_valid_until"] else None
        in_period = lo <= now and (hi is None or now <= hi)
        present = [k for k in keys if dns.dnssec.key_id(k) == ksk["key_tag"] and k.algorithm == ksk["algorithm"]
                   and dns.dnssec.make_ds(root, k, "SHA256").digest.hex().upper() == ksk["ds_digest_sha256"]]
        signed = any(s.key_tag == ksk["key_tag"] for s in rs)
        role = ("USABLE" if in_period and present and signed else
                "INFORMATIONAL_signed_outside_signing_period" if signed and present else
                "INFORMATIONAL_published_not_signing" if present and not signed else "INFORMATIONAL")
        L.add(f"DNSSEC.root.{ksk['name']}", PASS if role == "USABLE" else "SKIP",
              f"{role} in_signing_period={in_period} key_present_and_matches_pinned_digest={bool(present)} signed_root_DNSKEY={signed}")
        if role == "USABLE": usable.append((ksk, present[0]))
        if role.startswith("INFORMATIONAL_signed_outside"): outside.append(ksk["name"])
    if not usable:
        # R-2.26 split by cause. (a) a trusted KSK signed it but outside its signing period: the check ran and failed -> FAIL
        # (INVALID, KSK_OUTSIDE_SIGNING_PERIOD). (b) no signer is a key this trust config holds, or signatures are missing:
        # the check could not be performed -> UNPERFORMABLE (UNVERIFIABLE, NO_TRUSTED_KSK_USABLE; e.g. a newer unlisted KSK).
        if outside: L.add("DNSSEC.root.dnskey_rrset", FAIL, f"KSK_OUTSIDE_SIGNING_PERIOD {outside}")
        else: L.add("DNSSEC.root.dnskey_rrset", UNPERF, "NO_TRUSTED_KSK_USABLE")
        return used
    ok_any = False
    for ksk, key in usable:
        tk = dns.rrset.RRset(root, dns.rdataclass.IN, dns.rdatatype.DNSKEY); tk.add(key)
        try:
            val("root DNSKEY", keys, rs, {root: tk}, {ksk["key_tag"]}); ok_any = True
            L.add("DNSSEC.root.dnskey_rrset", PASS, f"validated by {ksk['name']} ({ksk['key_tag']})"); break
        except dns.dnssec.ValidationFailure as e:
            L.add("DNSSEC.root.dnskey_rrset", FAIL, f"{ksk['name']}: {e}")
    if not ok_any: return used
    zone_keys = {root: keys}; parent = root
    for z in ("com.", "wamason.com."):
        zn = dns.name.from_text(z)
        dd, dsg = _sets(M[f"{z} DS"], "answer")
        if (zn, dns.rdatatype.DS) not in dd:
            L.add(f"DNSSEC.{z}.ds", FAIL, "NO_DS (zone insecure or denial)"); return used
        try:
            val(f"{z} DS", dd[(zn, dns.rdatatype.DS)], dsg[(zn, dns.rdatatype.DS)], {parent: zone_keys[parent]})
            L.add(f"DNSSEC.{z}.ds", PASS, f"signed by {parent}")
        except (dns.dnssec.ValidationFailure, KeyError) as e:
            L.add(f"DNSSEC.{z}.ds", FAIL, str(e)); return used
        kd, ks = _sets(M[f"{z} DNSKEY"], "answer"); zk = kd[(zn, dns.rdatatype.DNSKEY)]
        dsset = {(d.key_tag, d.digest_type, d.digest) for d in dd[(zn, dns.rdatatype.DS)]}
        def _ds_ok(k):
            for d in dsset:
                if d[0] == dns.dnssec.key_id(k) and d[1] in (2, 4) and dns.dnssec.make_ds(zn, k, {2: "SHA256", 4: "SHA384"}[d[1]]).digest == d[2]:
                    return True
            return False
        linked = [k for k in zk if _ds_ok(k)]
        L.add(f"DNSSEC.{z}.dnskey_matches_ds", PASS if linked else FAIL, f"tags={[dns.dnssec.key_id(k) for k in linked]}")
        if not linked: return used
        lk = dns.rrset.RRset(zn, dns.rdataclass.IN, dns.rdatatype.DNSKEY)
        for k in linked: lk.add(k)
        try:
            val(f"{z} DNSKEY", zk, ks[(zn, dns.rdatatype.DNSKEY)], {zn: lk}, {dns.dnssec.key_id(k) for k in linked})
            L.add(f"DNSSEC.{z}.dnskey_selfsigned", PASS)
        except (dns.dnssec.ValidationFailure, KeyError) as e:
            L.add(f"DNSSEC.{z}.dnskey_selfsigned", FAIL, str(e)); return used
        zone_keys[zn] = zk; parent = zn
    dn = dns.name.from_text(domain)
    for rt in ("SOA", "NS", "TXT"):
        d, s = _sets(M[f"{domain}. {rt}"], "answer"); r = dns.rdatatype.from_text(rt)
        try:
            val(f"{domain} {rt}", d[(dn, r)], s[(dn, r)], {dn: zone_keys[dn]})
            L.add(f"DNSSEC.target.{rt}", PASS, f"owner={d[(dn, r)].name} signed by {dn}")
        except (dns.dnssec.ValidationFailure, KeyError) as e:
            L.add(f"DNSSEC.target.{rt}", FAIL, str(e))
    # key-publication record: which names carry a TXT key record?
    found_key = False
    for q in ("_tessera.wamason.com. TXT", "tessera.wamason.com. TXT"):
        qn = dns.name.from_text(q.split()[0]); m = M[q]
        d, s = _sets(m, "answer")
        if (qn, dns.rdatatype.TXT) in d:
            found_key = True
            try: val(q, d[(qn, 16)], s[(qn, 16)], {dn: zone_keys[dn]}); L.add(f"DNSSEC.keyrecord.{q}", PASS, d[(qn, 16)].to_text())
            except Exception as e: L.add(f"DNSSEC.keyrecord.{q}", FAIL, str(e))
            continue
        ad, asg = _sets(m, "authority")
        nsec = ad.get((qn, dns.rdatatype.NSEC))
        try:
            val(q + " NSEC", nsec, asg[(qn, dns.rdatatype.NSEC)], {dn: zone_keys[dn]})
            bm = {t for w in nsec[0].windows for t in [w[0] * 256 + i * 8 + b for i, byte in enumerate(w[1]) for b in range(8) if byte & (0x80 >> b)]}
            absent = dns.rdatatype.TXT not in bm and dns.rdatatype.CNAME not in bm
            L.add(f"DNSSEC.keyrecord_absent.{q}", PASS if absent else FAIL, "authenticated NODATA: NSEC type bitmap lacks TXT/CNAME")
        except Exception as e:
            L.add(f"DNSSEC.keyrecord_absent.{q}", FAIL, str(e))
    L.add("DNSKEY_PUBLICATION.key_txt_record_present", PASS if found_key else UNPERF,
          "" if found_key else "NO key-publication TXT record exists in the zone: C4(i) cannot establish K for D")
    return used

# ---------------------------------------------------------------- 3. OTS to pinned headers (C5)
def check_ots(tag, ots_bytes, file_bytes, hdrs, pins, k, L):
    dtf = O.load(ots_bytes)
    chk = O.check(dtf, file_bytes, hdrs)
    L.add(f"OTS.{tag}.digest_matches", PASS if chk.file_digest_ok else FAIL)
    if not chk.bitcoin:
        L.add(f"OTS.{tag}.attestation", UNPERF, f"ANCHOR_PENDING_ONLY ({len(chk.pending)} pending calendars)"); return None
    good = []
    for b in chk.bitcoin:
        h = b["height"]; need = range(h, h + k)
        if not all(x in hdrs for x in need): L.add(f"OTS.{tag}.att@{h}", UNPERF, "HEADERS_NOT_IN_BUNDLE"); continue
        if not b["merkle_ok"]: L.add(f"OTS.{tag}.att@{h}", FAIL, "MERKLE_ROOT_MISMATCH"); continue
        ok, why = btc.check_segment(hdrs, h, h + k - 1)
        if not ok: L.add(f"OTS.{tag}.att@{h}", FAIL, why); continue
        miss = [x for x in need if str(x) not in pins["headers"]]
        bad = [x for x in need if str(x) in pins["headers"] and pins["headers"][str(x)] != hdrs[x].hash_hex]
        if bad: L.add(f"OTS.{tag}.att@{h}", FAIL, f"HEADER_CONFLICTS_WITH_PIN {bad}"); continue
        if miss: L.add(f"OTS.{tag}.att@{h}", UNPERF, f"HEADERS_NOT_COVERED {miss}"); continue
        L.add(f"OTS.{tag}.att@{h}", PASS, f"merkle root ok; PoW+linkage ok; {k} headers equal pins; nTime={iso(hdrs[h].time)}")
        good.append(h)
    if not good: return None
    h = min(good)
    return {"height": h, "T": hdrs[h].time, "confirmed_at": hdrs[h + k - 1].time, "all": good}

def conjuncts(tag, declared, a, delta, eps, L):
    c1, c2, c3 = declared - eps <= a["T"], a["T"] <= declared + delta, a["confirmed_at"] <= declared + delta
    L.add(f"TIME.{tag}.c1_T>=declared-eps", PASS if c1 else FAIL, f"T-declared={a['T']-declared}s")
    L.add(f"TIME.{tag}.c2_T<=declared+delta", PASS if c2 else FAIL)
    L.add(f"TIME.{tag}.c3_conf<=declared+delta", PASS if c3 else FAIL, f"confirmed_at-declared={a['confirmed_at']-declared}s")

def check_snapshot_time(snap_declared, a, p, used, L):
    """The snapshot's own anchored time a['T'] (from its OTS proof; not the receipt's T, not wall-clock) must lie inside
    every RRSIG window used and within [declared - eps, declared + delta]."""
    conjuncts("snapshot", snap_declared, a, p["delta_s"], p["epsilon_s"], L)
    if used:
        lo = max(u[1] for u in used); hi = min(u[2] for u in used)
        L.add("DNSSEC.T_snap_inside_joint_window", PASS if lo <= a["T"] <= hi else FAIL, f"T_snap={iso(a['T'])} window=[{iso(lo)}, {iso(hi)}]")

def run(eval_arg, trust_path, out_dir, quiet=False):
    L = Ledger(); out = Path(out_dir)
    trust = json.loads(Path(trust_path).read_text()); D = trust["issuer_domain"]; p = trust["params"]; k = p["k"]
    b = json.loads((out / "receipt.json").read_text()); snap = json.loads((out / "dns-snapshot.json").read_text())
    pre, declared = check_signatures(b, L, D)
    pins = hdrs = None
    if (out / "bitcoin-pins.json").exists():
        pins = json.loads((out / "bitcoin-pins.json").read_text())
        hdrs = {int(h): btc.Header.parse(bytes.fromhex(x)) for h, x in json.loads((out / "bitcoin-headers.json").read_text()).items()}
        L.add("PINS.header_hashes_present", PASS, f"pins sha256={hashlib.sha256((out/'bitcoin-pins.json').read_bytes()).hexdigest()[:16]}.. n={len(pins['headers'])}")
    else:
        pins, hdrs = {"headers": {}}, {}
    snap_bytes = (out / "dns-snapshot.json").read_bytes()
    ar = check_ots("receipt", (out / "receipt-preimage.bin.ots").read_bytes(), pre, hdrs, pins, k, L)
    as_ = check_ots("snapshot", (out / "dns-snapshot.json.ots").read_bytes(), snap_bytes, hdrs, pins, k, L)
    if ar: conjuncts("receipt", declared, ar, p["delta_s"], p["epsilon_s"], L)
    snap_declared = snap["captured_end"]
    # evaluation time for DNSSEC
    if eval_arg == "auto":
        now, basis = (as_["T"], "snapshot's anchored time T_snap") if as_ else (None, "snapshot not anchored: no evaluation time, no stand-in")
    else:
        now, basis = int(eval_arg), "stated by caller"
    if now is None:
        used = []; L.add("DNSSEC.eval_time", UNPERF, "SNAPSHOT_NOT_ANCHORED (UNVERIFIABLE: missing anchor is missing evidence)")
    else:
        used = check_dnssec(snap, trust, now, D, L)
    if used:
        lo = max(u[1] for u in used); hi = min(u[2] for u in used)
        L.add("DNSSEC.eval_time_inside_every_used_RRSIG_window", PASS if lo <= now <= hi else FAIL,
              f"eval={iso(now)} [{basis}] joint window [{iso(lo)}, {iso(hi)}] = {(hi-lo)/3600:.1f} h over {len(used)} RRSIGs")
    if as_: check_snapshot_time(snap_declared, as_, p, used, L)
    L.add("NETWORK.socket_attempts_zero", PASS if _NET["attempts"] == 0 else FAIL, f"attempts={_NET['attempts']}")
    assert _NET["attempts"] == 0, "network was touched"
    groups = {g: L.status(g) for g in ("SIG", "BYTES", "AUTH", "DNSSEC", "DNSKEY_PUBLICATION", "OTS.receipt", "OTS.snapshot", "TIME", "NETWORK")}
    if not quiet:
        for r in L.rows: print(f"{r[1]:13} {r[0]}  {r[2]}")
        print("\nGROUPS", json.dumps(groups)); print("eval_time", iso(now) if now is not None else None, "-", basis)
    return L, groups, {"receipt_anchor": ar, "snapshot_anchor": as_, "eval": now, "declared": declared, "joint": (lo, hi) if used else None}

if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("--eval-time", default="auto"); ap.add_argument("--trust", default=str(HERE / "trust-config.json"))
    ap.add_argument("--out", default=str(HERE / "out")); a = ap.parse_args()
    L, g, f = run(a.eval_time, a.trust, a.out)
    need = ("SIG", "BYTES", "AUTH", "DNSSEC", "OTS.receipt", "OTS.snapshot", "TIME", "NETWORK")
    sys.exit(0 if all(g[x] == PASS for x in need) else 1)
