def _sets(msg, section):
    data, sigs = {}, {}
    for rr in getattr(msg, section):
        (sigs if rr.rdtype == dns.rdatatype.RRSIG else data)[(rr.name, rr.covers if rr.rdtype == dns.rdatatype.RRSIG else rr.rdtype)] = rr
    return data, sigs

