   178	def _take(iss, slot, signer, body):
   179	    now = iss.clock()
   180	    srid = body.get("request_id")
   181	    idx = iss.requests.sigreq_get(srid) if isinstance(srid, str) else None
   182	    sig = None
   183	    if body.get("status") == "SIGNED":
   184	        try:
   185	            sig = b64d(body.get("sig_b64", ""))
   186	        except (ValueError, TypeError):
   187	            sig = None
   188	    entry = {"at": rfc3339(now), "slot": slot, "request_id": srid, "status": body.get("status"),
   189	             "reason": body.get("reason"), "frame_sha256": idx["frame_sha256"] if idx else None,
   190	             "signature_sha256": sha256hex(sig) if sig is not None else None, "disposition": None}
   191	    if idx is None or idx.get("slot") != slot:
   192	        entry["disposition"] = "unrequested"
   193	    else:
   194	        rec = iss.requests.get(idx["rid"])
   195	        job = rec["jobs"].get(idx["job"]) if rec else None
   196	        if rec is None or rec["state"] != "ACCEPTED" or rec["stage"] != "signing" or job is None:
   197	            entry["disposition"] = "not-waiting"
   198	        elif job.get("sig_sha256"):
   199	            entry["disposition"] = "duplicate"
   200	        elif body.get("status") == "REFUSED":
   201	            entry["disposition"] = "refused"
   202	            iss.requests.siglog_add(entry)
   203	            return _end(iss, rec, "FAILED", "SIGNER_REFUSED:" + str(body.get("reason")), now)
   204	        elif sig is None:
   205	            entry["disposition"] = "malformed"
   206	        else:
   207	            frame = iss.results.get("work", rec["rid"], job["frame"])
   208	            if frame is None or sha256hex(frame) != job["frame_sha256"] or not signer.verify(frame, sig):
