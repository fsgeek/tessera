    52	def settle(iss, rec, attempts=5):
    53	    """CF-01: decide an unconfirmed COMPLETE, in place. The clock is read after the record was read, so the COMPLETE
    54	    commit happened no later than that reading. The confirmation is itself a write, and status reports COMPLETE only
    55	    once it is durable (S4: the end is the status becoming COMPLETE), so it must also commit before the deadline.
    56	    A clock check cannot bound when a write commits; the writer lease can (CF2-01): every write runs inside one
    57	    Lambda invocation, so it commits within WRITE_LEASE_S of the decision. Hence: decided at least WRITE_LEASE_S
    58	    before the deadline, it is confirmed (ended_at = that reading, never earlier than the commit); inside the last
    59	    lease it is left unconfirmed (it reads as ACCEPTED, with its fail_after); at or after the deadline it is FAILED
    60	    (NOT_COMPLETE_WITHIN_24H). Both writes are compare-and-set, so a confirmation and a failure never both win.
    61	    -> rec."""
    62	    for _ in range(attempts):
    63	        if rec is None or confirmed(rec):
    64	            return rec
    65	        now = iss.clock()
    66	        deadline = rec["created_at"] + DEADLINE_S
    67	        if deadline - WRITE_LEASE_S <= now < deadline:
    68	            return rec                                   # CF2-01: too late to confirm, too early to fail
    69	        if now < deadline:
    70	            rec.update(confirmed_at=now, ended_at=now, expires_at=now + RETENTION_S)
    71	            rec["events"] = rec["events"][-40:] + [[now, "confirmed"]]
    72	        else:
    73	            rec.update(state="FAILED", reason="NOT_COMPLETE_WITHIN_24H", ended_at=now, expires_at=now + RETENTION_S,
    74	                       receipt_sha256=None)
    75	            rec["events"] = rec["events"][-40:] + [[now, "FAILED", "NOT_COMPLETE_WITHIN_24H", "unconfirmed"]]
    76	        if iss.requests.save(rec):
    77	            return rec
    78	        cur = iss.requests.get(rec["rid"])               # someone else settled (or changed) it: decide again
    79	        rec.clear()
    80	        if cur is not None:
    81	            rec.update(cur)
    82	        else:
    83	            return None
    84	    raise RuntimeError("completion could not be settled; retried later")
