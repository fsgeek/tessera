    68	  /\ burialAtWall' = IF /\ burialAtWall = NoTime
    69	                        /\ anchorH' # NoAnchor
    70	                        /\ Len(chain) + 1 >= anchorH' + DepthK
    71	                     THEN now ELSE burialAtWall
    72	  /\ UNCHANGED <<now, declared, shipped, shipAtWall>>
    73	
    74	Declare ==
    75	  /\ declared = NoTime
    76	  /\ declared' = now
    77	  /\ UNCHANGED <<now, chain, anchorH, pendingAnchor, shipped, shipAtWall,
    78	                 burialAtWall>>
    79	
