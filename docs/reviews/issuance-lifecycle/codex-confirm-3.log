   106	  /\ shipped' = TRUE /\ shipAtWall' = now
   107	  /\ UNCHANGED <<now, chain, declared, anchorH, pendingAnchor, burialAtWall>>
   108	
   109	Next == Tick \/ NewBlock \/ Declare \/ AnchorNext \/ Ship
