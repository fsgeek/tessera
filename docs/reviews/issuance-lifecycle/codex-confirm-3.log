   139	(* the execution-time guard forbade is live — shipped AFTER the wall      *)
   140	(* envelope on timely eligibility (the latch's point: the scheduler       *)
   141	(* cannot expire an eligible attempt).                                     *)
   142	ShipUnreachable == ~shipped
