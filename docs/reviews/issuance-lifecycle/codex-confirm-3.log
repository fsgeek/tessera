   380	             /\ cur' = IF w.to \in Ended /\ i < N THEN i + 1 ELSE cur
   381	             /\ req' = IF w.to = "shipped" THEN "complete"
   382	                       ELSE IF w.to \in Ended /\ i = N THEN "refused"
   383	                       ELSE req
   384	             /\ rreason' = IF w.to \in Ended /\ i = N
   385	                           THEN (IF w.to = "unavail" THEN "EVIDENCE_UNAVAILABLE"
   386	                                 ELSE "ATTEMPTS_EXHAUSTED")
   387	                           ELSE rreason
