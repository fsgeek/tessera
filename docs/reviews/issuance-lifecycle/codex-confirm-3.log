    84	                 burialAtWall>>
    85	
    86	IssuerDesignatedH == anchorH + DepthK
    87	IssuerConfirmedTs == chain[IssuerDesignatedH]
    88	
    89	VerifierDesignatedH(h) == h + KConf - 1
    90	VerifierConfirmedTs(h) == chain[VerifierDesignatedH(h)]
    91	
    92	VerdictValid(d, h) ==
    93	  /\ d - Epsilon <= chain[h]
    94	  /\ chain[h] <= d + Delta
    95	  /\ VerifierConfirmedTs(h) <= d + Delta
    96	
    97	(* Ship under latch: chain guard unchanged; lifecycle guard on B.         *)
    98	(* Eligibility (buried to depth) implies burialAtWall # NoTime.            *)
    99	Ship ==
