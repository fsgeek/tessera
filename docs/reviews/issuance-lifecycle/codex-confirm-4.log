   265	EndOn(i) == IF now <= B(i) THEN "discarded" ELSE "expired"
   266	
   267	Win(t) == LET c == t \div PollInterval IN
   268	          IF WindowMode = "completed" THEN (c - Expected)..(c - 1)
   269	          ELSE (c - Expected + 1)..c
   270	
   271	EndOK(p, i) ==
   272	  IF Variant \in {"B6", "B7"}                      \* R51 counter rule
   273	  THEN /\ inv[p].rus # NoTime
   274	       /\ now - inv[p].rus >= OpPeriod
   275	       /\ inv[p].rfp >= Needed
   276	  ELSE IF Variant = "B8"                            \* R52 fixed window
   277	  THEN /\ inv[p].rus # NoTime
   278	       /\ now - inv[p].rus >= OpPeriod
   279	       /\ Cardinality({x \in inv[p].rfi :
   280	                         x - inv[p].rus \div PollInterval \in 0..(Expected - 1)}) >= Needed
   281	  ELSE Cardinality(Win(now) \cap inv[p].rfi) >= Needed   \* R53 rolling window
   282	
   283	Send(p) ==
   284	  /\ inv[p].pc = "fetched"
   285	  /\ LET i   == inv[p].att
   286	         c   == inv[p].cls
   287	         rst == inv[p].rst
   288	         v   == inv[p].fver
   289	         SendW(to) == /\ pending' = pending \cup {MkW(p, i, rst, to, v, inv[p].fat)}
   290	                      /\ inv' = [inv EXCEPT ![p].pc = "await"]
   291	         NoW == /\ inv' = [inv EXCEPT ![p] = IdleInv]
   292	                /\ UNCHANGED pending
   293	     IN
   294	     IF rst = "latched" THEN SendW("shipped") /\ UNCHANGED obsAt
   295	     ELSE IF rst # "open" THEN NoW /\ UNCHANGED obsAt
   296	     ELSE IF c = "elig" THEN SendW("latched") /\ UNCHANGED obsAt
   297	     ELSE IF Conclusive(c, now, i) THEN SendW(EndOn(i)) /\ UNCHANGED obsAt
   298	     \* a failed poll; it counts only if its fetch started after B
   299	     ELSE IF inv[p].fat <= B(i) THEN NoW /\ UNCHANGED obsAt
   300	     ELSE IF Variant = "B4"
   301	          THEN (IF now > B(i) + OpPeriod THEN SendW("unavail") ELSE SendW("fail"))
   302	               /\ UNCHANGED obsAt
   303	     ELSE IF EndOK(p, i)
   304	          THEN \E s \in Snap(i) :            \* re-fetch immediately before writing
   305	                 LET rc == Classify(s[1], s[2], i) IN
   306	                 /\ obsAt' = ObsUpd(i, rc)
   307	                 /\ IF rc = "elig" THEN SendW("latched")
   308	                    ELSE IF Conclusive(rc, now, i) THEN SendW(EndOn(i))
   309	                    ELSE SendW("unavail")
   310	     ELSE SendW("fail") /\ UNCHANGED obsAt
   311	  /\ UNCHANGED <<now, StoreVars, EnvVars, faults, polled, starts, CGhosts, obsKilled, lostLive>>
   312	
   313	Kill(p) ==
   314	  /\ AllowKill
   315	  /\ Live(p) /\ faults < MaxFaults
   316	  /\ faults' = faults + 1
   317	  /\ inv' = [inv EXCEPT ![p] = IdleInv]
   318	  /\ pending' = {IF w.p = p THEN [w EXCEPT !.orphan = TRUE] ELSE w : w \in pending}
   319	  /\ obsKilled' = IF TrackGhosts /\ inv[p].pc = "fetched" /\ inv[p].cls = "elig"
   320	                  THEN [obsKilled EXCEPT ![inv[p].att] = TRUE] ELSE obsKilled
   321	  /\ UNCHANGED <<now, StoreVars, EnvVars, polled, starts, CGhosts, obsAt, lostLive>>
   322	
   323	Resend(p) ==
   324	  /\ inv[p].pc = "await" /\ faults < MaxFaults   \* fences are not re-sent
   325	  /\ \E w \in pending :
   326	       /\ w.p = p /\ ~w.orphan /\ ~w.dup
   327	       /\ pending' = pending \cup {[w EXCEPT !.dup = TRUE, !.sent = now]}
   328	  /\ faults' = faults + 1
   329	  /\ UNCHANGED <<now, StoreVars, EnvVars, inv, polled, starts, CGhosts, WGhosts>>
   330	
   331	(* Owner bookkeeping when write w resolves (applied = guard held).         *)
   332	Owner(w, pend2, applied) ==
   333	  IF w.orphan \/ inv[w.p].pc \notin {"await", "fencing"}
   334	     \/ \E x \in pend2 : x.p = w.p /\ ~x.orphan
   335	  THEN inv
   336	  ELSE IF w.to = "fence" /\ applied
   337	       THEN [inv EXCEPT ![w.p].pc = "fenced", ![w.p].fver = ver[w.att] + 1]
   338	       ELSE [inv EXCEPT ![w.p] = IdleInv]
   339	
   340	GuardOK(w) == /\ req = "active" /\ cur = w.att /\ st[w.att] = w.from
   341	              /\ ver[w.att] = w.gver
   342	
   343	Commit(w) ==
   344	  /\ w \in pending
   345	  /\ LET i == w.att
   346	         pend2 == pending \ {w}
   347	         ok == GuardOK(w)
   348	         ending == w.to \in Ended IN
   349	     /\ pending' = pend2
   350	     /\ inv' = Owner(w, pend2, ok)
   351	     /\ IF ok
   352	        THEN /\ ver' = [ver EXCEPT ![i] = ver[i] + 1]
   353	             /\ CASE w.to = "fence" ->
   354	                     UNCHANGED <<req, rreason, cur, st, decl, us, fp, fi, CGhosts>>
   355	                  [] w.to = "fail" ->
   356	                     /\ us' = IF us[i] = NoTime THEN [us EXCEPT ![i] = w.fat] ELSE us
   357	                     /\ fp' = [fp EXCEPT ![i] = IF fp[i] < FPCap THEN fp[i] + 1 ELSE FPCap]
   358	                     /\ fi' = [fi EXCEPT ![i] = fi[i] \cup {w.fat \div PollInterval}]
   359	                     /\ firstCF' = IF firstCF[i] = NoTime
   360	                                   THEN [firstCF EXCEPT ![i] = w.fat] ELSE firstCF
   361	                     /\ failTicks' = [failTicks EXCEPT ![i] = failTicks[i] \cup {w.fat}]
   362	                     /\ UNCHANGED <<req, rreason, cur, st, decl, p5ok, spreadOK>>
   363	                  [] OTHER ->
   364	                     /\ st' = [j \in Attempts |->
   365	                                 IF j = i THEN w.to
   366	                                 ELSE IF j = i + 1 /\ ending THEN "open"
   367	                                 ELSE st[j]]
   368	                     /\ decl' = IF ending /\ i < N THEN [decl EXCEPT ![i + 1] = now] ELSE decl
   369	                     /\ cur' = IF ending /\ i < N THEN i + 1 ELSE cur
   370	                     /\ req' = IF w.to = "shipped" THEN "complete"
   371	                               ELSE IF ending /\ i = N THEN "refused" ELSE req
   372	                     /\ rreason' = IF ending /\ i = N THEN "ATTEMPTS_EXHAUSTED" ELSE rreason
   373	                     \* a committed success (latch / end) clears both counters
   374	                     /\ us' = [us EXCEPT ![i] = NoTime]
   375	                     /\ fp' = [fp EXCEPT ![i] = 0]
   376	                     /\ fi' = [fi EXCEPT ![i] = {}]
   377	                     /\ p5ok' = IF w.to = "unavail"
   378	                                THEN [p5ok EXCEPT ![i] =
   379	                                        Cardinality({k \in Win(w.dec) :
   380	                                           \E x \in failTicks[i] :
   381	                                             x \div PollInterval = k}) >= Needed]
   382	                                ELSE p5ok
   383	                     /\ spreadOK' = IF w.to = "unavail"
   384	                                    THEN [spreadOK EXCEPT ![i] =
   385	                                            Cardinality({x \in failTicks[i] :
   386	                                                x >= firstCF[i] /\ x < w.dec}) >= Needed]
   387	                                    ELSE spreadOK
   388	                     /\ UNCHANGED <<firstCF, failTicks>>
   389	             /\ UNCHANGED lostLive
   390	        ELSE /\ UNCHANGED <<StoreVars, CGhosts>>
   391	             /\ lostLive' = IF TrackGhosts /\ w.to = "latched" /\ ~w.orphan
   392	                               /\ st[i] \in Ended
   393	                            THEN [lostLive EXCEPT ![i] = TRUE] ELSE lostLive
   394	  /\ UNCHANGED <<now, EnvVars, faults, polled, starts, obsAt, obsKilled>>
   395	
   396	Drop(w) ==
   397	  /\ w \in pending /\ faults < MaxFaults
   398	  /\ faults' = faults + 1
   399	  /\ pending' = pending \ {w}
   400	  /\ inv' = Owner(w, pending \ {w}, FALSE)
   401	  /\ UNCHANGED <<now, StoreVars, EnvVars, polled, starts, CGhosts, WGhosts>>
   402	
   403	Issuer == \E p \in ProcSet : Start(p) \/ Fence(p) \/ Fetch(p) \/ Send(p)
   404	                             \/ Kill(p) \/ Resend(p)
   405	Store  == \E w \in pending : Commit(w) \/ Drop(w)
   406	Next == Tick \/ Env \/ Issuer \/ Store
   407	Spec == Init /\ [][Next]_vars
   408	
   409	LiveSpec ==
   410	  /\ Spec
   411	  /\ \A p \in ProcSet : WF_vars(Start(p)) /\ WF_vars(Fence(p))
   412	                        /\ WF_vars(Fetch(p)) /\ WF_vars(Send(p))
   413	  /\ WF_vars(\E w \in pending : Commit(w))
   414	  /\ SF_vars(Tick)
   415	
   416	(***************************************************************************)
   417	(* Checked properties.                                                      *)
   418	(***************************************************************************)
   419	TypeOK ==
   420	  /\ now \in Times
   421	  /\ req \in {"active", "complete", "refused"}
   422	  /\ cur \in Attempts
   423	  /\ st \in [Attempts -> AStates]
   424	  /\ \A i \in Attempts : us[i] \in Times \cup {NoTime}
   425	  /\ fp \in [Attempts -> 0..FPCap]
   426	  /\ faults \in 0..MaxFaults
   427	
   428	NoTimelyExpiry ==
   429	  \A i \in Attempts : st[i] \in {"expired", "discarded"} => ~TimelyEligible(i)
   430	NegativeEndsAreTrue ==
   431	  \A i \in Attempts : st[i] \in {"expired", "discarded"} => bur[i] # NoTime /\ ~pass[i]
   432	ExpiryAfterB ==
   433	  \A w \in pending : (w.to = "expired" => w.dec > B(w.att))
   434	                     /\ (w.to = "discarded" => w.dec <= B(w.att))
   435	LatchIsTrue ==
   436	  \A i \in Attempts : st[i] \in {"latched", "shipped"} => bur[i] # NoTime /\ pass[i]
   437	OneLive == \A i \in Attempts : st[i] \in {"open", "latched"} => i = cur
   438	AllocatedPrefix == \A i \in Attempts : (st[i] # "none") <=> (i <= cur)
   439	PastAttemptsEnded == \A i \in Attempts : i < cur => st[i] \in Ended
   440	CompleteIffShipped ==
   441	  /\ (req = "complete") <=> (\E i \in Attempts : st[i] = "shipped")
   442	  /\ \A i, j \in Attempts : st[i] = "shipped" /\ st[j] = "shipped" => i = j
   443	NoSilentEnd == (\A i \in Attempts : st[i] \in Ended) => req = "refused"
   444	NeverBetweenAttempts == req = "active" => st[cur] \in {"open", "latched"}
   445	RefusedOnlyWhenExhausted ==
   446	  req = "refused" => /\ \A i \in Attempts : st[i] \in Ended
   447	                     /\ cur = N /\ rreason = "ATTEMPTS_EXHAUSTED"
   448	USAfterB == \A i \in Attempts : us[i] # NoTime => us[i] > B(i)
   449	P5_UnavailablePeriod == \A i \in Attempts : st[i] = "unavail" => p5ok[i]
   450	P5_SpreadOld == \A i \in Attempts : st[i] = "unavail" => spreadOK[i]
   451	
   452	EndedFrozen     == [][\A i \in Attempts : st[i] \in Ended => st'[i] = st[i]]_vars
   453	LatchProtects   == [][\A i \in Attempts :
   454	                       st[i] \in {"latched", "shipped"} => st'[i] \in {"latched", "shipped"}]_vars
   455	ShipFromLatch   == [][\A i \in Attempts :
   456	                       (st'[i] = "shipped" /\ st[i] # "shipped") => st[i] = "latched"]_vars
   457	TerminalLatched == [][req # "active" => UNCHANGED <<req, rreason, st>>]_vars
   458	
   459	Termination == <>(req # "active")
   460	
   461	(***************************************************************************)
   462	(* Witnesses: violation = reachable.                                        *)
   463	(***************************************************************************)
   464	ResidualKilledObserver ==
   465	  ~\E i \in Attempts : /\ st[i] = "unavail" /\ TimelyEligible(i)
   466	                       /\ obsKilled[i] /\ obsAt[i] = "timely"
   467	ResidualUnobserved ==
   468	  ~\E i \in Attempts : st[i] = "unavail" /\ TimelyEligible(i) /\ obsAt[i] = "no"
   469	ResidualLiveObserver ==
   470	  ~\E i \in Attempts : lostLive[i] /\ TimelyEligible(i) /\ st[i] = "unavail"
   471	\* broader form of (c): ANY live latch write lost to an ending, timely or not
   472	LiveLatchLostToEnd == ~\E i \in Attempts : lostLive[i]
   473	\* ILC3-01: with AllowKill = FALSE, a timely observation lost without a kill
   474	\* ILC3-03, rolling window: an attempt whose FIRST fixed window (the R52
   475	\* window from its first committed failure) had an interval with no
   476	\* committed failed fetch nevertheless ends EVIDENCE_UNAVAILABLE.
   477	EndAfterGapUnreachable ==
   478	  ~\E i \in Attempts :
   479	     /\ st[i] = "unavail" /\ firstCF[i] # NoTime
   480	     /\ \E k \in 0..(Expected - 1) :
   481	          ~\E x \in failTicks[i] :
   482	             x \div PollInterval = firstCF[i] \div PollInterval + k
   483	ResidualLostLatchNoKill ==
   484	  ~\E i \in Attempts : st[i] = "unavail" /\ TimelyEligible(i) /\ obsAt[i] = "timely"
   485	\* ILC3-03: the fixed window (B8) has an interval of its period that passed
   486	\* with no committed failure: it can never be covered again (structural);
   487	\* only a committed success could reset it.
   488	FixedWindowStranded ==
   489	  ~\E i \in Attempts :
   490	     /\ st[i] = "open" /\ us[i] # NoTime
   491	     /\ \E k \in 0..(Expected - 1) :
   492	          /\ (us[i] \div PollInterval) + k < now \div PollInterval
   493	          /\ ~\E x \in fi[i] : x - us[i] \div PollInterval = k
   494	
   495	ShipUnreachable          == req # "complete"
   496	RefusalUnreachable       == req # "refused"
   497	ExpiredUnreachable       == ~\E i \in Attempts : st[i] = "expired"
   498	DiscardedUnreachable     == ~\E i \in Attempts : st[i] = "discarded"
   499	UnavailUnreachable       == ~\E i \in Attempts : st[i] = "unavail"
   500	LatchAfterFailUnreachable == ~\E i \in Attempts : failTicks[i] # {} /\ st[i] \in {"latched", "shipped"}
   501	OrphanPendingUnreachable == ~\E w \in pending : w.orphan
   502	FenceFailedUnreachable   == ~\E w \in pending : w.to = "fence" /\ w.orphan
   503	
