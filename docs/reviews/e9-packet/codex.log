    64	def ls_tree(repo, commit, paths):
    65	    out = {}
    66	    for line in git(repo, "ls-tree", "-r", "-z", commit, "--", *paths).split(b"\0"):
    67	        if line:
    68	            meta, path = line.split(b"\t", 1)
    69	            mode, typ, oid = meta.decode().split()
    70	            out[path.decode()] = (mode, typ, oid)
    71	    return out
