    74	def check_path(p, mode, typ):
    75	    if typ != "blob" or mode not in ("100644", "100755"):
    76	        sys.exit(f"not a tracked regular file: {p} ({mode} {typ})")
    77	    if not PATH_RE.fullmatch(p) or any(c in ("", ".", "..") for c in p.split("/")):
    78	        sys.exit(f"path outside the section 15.8 grammar: {p!r}")
