   453	def tag_at(b, want):
   454	    need(b, 0, 1)
   455	    n = b[0]
   456	    need(b, 1, n)
   457	    tag = bytes(b[1:1 + n])
   458	    if tag not in TAGS:
   459	        raise Bad("TAG_UNKNOWN")
   460	    if TAGS[tag] != want:
   461	        raise Bad("TAG_MISMATCH")
   462	    return 1 + n
