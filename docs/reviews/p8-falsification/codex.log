   501	def subpackets_ok(b, lo, hi):
   502	    """True iff b[lo:hi] is an exact run of subpackets with shortest-form lengths."""
   503	    i = lo
   504	    while i < hi:
   505	        c = b[i]
   506	        if c <= 191:
   507	            ln, i = c, i + 1
   508	        elif c <= 254:
   509	            if i + 1 >= hi:
   510	                return False
   511	            ln, i = (c - 192) * 256 + b[i + 1] + 192, i + 2
   512	        else:
   513	            if i + 4 >= hi:
   514	                return False
   515	            ln, i = int.from_bytes(b[i + 1:i + 5], "big"), i + 5
   516	            if ln <= 16319:
   517	                return False
   518	        if ln < 1 or i + ln > hi:
   519	            return False
   520	        i += ln
   521	    return True
