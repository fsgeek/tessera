   467	    need(b, pos, 2)
   468	    if b[pos] != 0 or b[pos + 1] != 1:
   469	        raise Bad("CV_UNKNOWN")
   470	    pos += 2
   471	    need(b, pos, 4)
   472	    length = int.from_bytes(b[pos:pos + 4], "big")
   473	    pos += 4
   474	    if length > CAP:
   475	        raise Bad("LENGTH_CAP")
   476	    remaining = len(b) - pos
   477	    if remaining != length:
   478	        raise Bad("TRUNCATED" if remaining < length else "TRAILING")
   479	    v = payload_value(bytes(b[pos:]))
   480	    (attest_ok if want == "attest" else manifest_ok)(v)
