   217	# ===================================== number rule and formatting =====================================
   218	def _decimal(lit):
   219	    """literal -> (negative, digit string without leading/trailing zeros, exponent) or zero marker."""
   220	    m = re.fullmatch(r"(-?)([0-9]+)(?:\.([0-9]+))?(?:[eE]([+-]?[0-9]+))?", lit)
   221	    neg, ip, fp, ex = m.group(1) == "-", m.group(2), m.group(3) or "", int(m.group(4) or 0)
   222	    digits = (ip + fp).lstrip("0")
   223	    if not digits:
   224	        return neg, "", 0
   225	    exp = ex - len(fp)
   226	    stripped = digits.rstrip("0")
   227	    return neg, stripped, exp + (len(digits) - len(stripped))
