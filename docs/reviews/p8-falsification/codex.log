   264	# ===================================== domain checks =====================================
   265	def nodes(t):
   266	    stack = [t]
   267	    while stack:
   268	        x = stack.pop()
   269	        yield x
   270	        if isinstance(x, tuple) and x[0] == "O":
   271	            for k, v in x[1]:
   272	                yield k
   273	                stack.append(v)
   274	        elif isinstance(x, tuple) and x[0] == "A":
   275	            stack.extend(x[1])
