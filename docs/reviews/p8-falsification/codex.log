   326	# ===================================== RFC 8785 serializer =====================================
   327	def jcs(v):
   328	    if v is None:
   329	        return b"null"
   330	    if v is True:
   331	        return b"true"
   332	    if v is False:
   333	        return b"false"
   334	    if isinstance(v, float):
   335	        return es_string(v).encode()
   336	    if isinstance(v, str):
   337	        out = ['"']
   338	        for ch in v:
   339	            c = ord(ch)
   340	            if ch == '"':
   341	                out.append('\\"')
   342	            elif ch == "\\":
   343	                out.append("\\\\")
   344	            elif c < 0x20:
   345	                out.append({8: "\\b", 9: "\\t", 10: "\\n", 12: "\\f", 13: "\\r"}.get(c, "\\u%04x" % c))
   346	            else:
   347	                out.append(ch)
   348	        out.append('"')
   349	        return "".join(out).encode("utf-8")
   350	    if isinstance(v, list):
   351	        return b"[" + b",".join(jcs(x) for x in v) + b"]"
   352	    if isinstance(v, dict):
   353	        keys = sorted(v, key=lambda k: k.encode("utf-16-be"))
   354	        return b"{" + b",".join(jcs(k) + b":" + jcs(v[k]) for k in keys) + b"}"
   355	    raise TypeError(type(v))
   356	
