   298	def to_value(t):
   299	    if isinstance(t, tuple):
   300	        if t[0] == "O":
   301	            return {k: to_value(v) for k, v in t[1]}
   302	        if t[0] == "A":
   303	            return [to_value(v) for v in t[1]]
   304	        return number(t[1])
   305	    return t
