+            raw=bytes.fromhex(v['bytes_hex']); check('vector-anchor',raw,anchor(raw))
+        elif v['kind']=='content':
+            raw=bytes.fromhex(v['bytes_hex']);check('vector-payload',raw,payload(raw))
+    for v in RS:
