   582	def anchor_decode(b):
   583	    pos = tag_at(b, "anchor")
   584	    need(b, pos, 1)
   585	    if b[pos] != 2:
   586	        raise Bad("ANCHOR_COUNT")
   587	    pos += 1
   588	    out = []
   589	    for slot in (0, 1):
   590	        need(b, pos, 4)
   591	        n = int.from_bytes(b[pos:pos + 4], "big")
   592	        pos += 4
   593	        if n > CAP + 64:
   594	            raise Bad("LENGTH_CAP")
   595	        need(b, pos, n)
   596	        f = bytes(b[pos:pos + n])
   597	        alg = frame_decode(f, "attest")["common"]["alg"]
   598	        pos += n
   599	        need(b, pos, 4)
   600	        n = int.from_bytes(b[pos:pos + 4], "big")
   601	        pos += 4
   602	        if n == 0:
   603	            raise Bad("SIG_EMPTY")
   604	        if n > CAPS[rule_of(alg, slot)]:
   605	            raise Bad("LENGTH_CAP")
   606	        need(b, pos, n)
   607	        sg = bytes(b[pos:pos + n])
   608	        sig_check(sg, alg, slot)
   609	        out.append((f, sg))
   610	        pos += n
   611	    if pos != len(b):
   612	        raise Bad("TRAILING")
   613	    return out
