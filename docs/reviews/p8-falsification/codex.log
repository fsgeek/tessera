   308	def ingest(b, limit=62):
   309	    t = parse_text(b)
   310	    if depth_of(t) > limit:
   311	        raise Bad("JSON_DEPTH")
   312	    for x in nodes(t):
   313	        if isinstance(x, tuple) and x[0] == "O":
   314	            names = [k for k, _ in x[1]]
   315	            if len(names) != len(set(names)):
   316	                raise Bad("JSON_DUPLICATE_NAME")
   317	    for x in nodes(t):
   318	        if isinstance(x, str):
   319	            string_ok(x)
   320	    for x in nodes(t):
   321	        if isinstance(x, tuple) and x[0] == "N":
   322	            number(x[1])
   323	    return to_value(t)
