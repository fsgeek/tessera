   492	HYB_ALG = "KMS-MLDSA65-PURE-GPG-OPENPGP4-ECDSA-P256-SHA256"     # hybrid supplement (OWNER-PROPOSED)
   493	RULES = {V1_ALG: ["pgp4", "pgp4"], HYB_ALG: ["mldsa65", "pgp4"]}
