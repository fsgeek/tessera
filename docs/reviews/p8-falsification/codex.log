+    counts['snapshot-size']=snapcounts
+    print(json.dumps({'counts':dict(counts),'histogram':dict(hist)},indent=2))
+
+if __name__=='__main__':
+    {'witness':witness,'boundaries':boundaries,'lemma9':lemma9}[sys.argv[1]]()

