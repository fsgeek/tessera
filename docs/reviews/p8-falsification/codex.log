   616	def anchor_encode(f0, s0, f1, s1):
   617	    t = TAG_OF["anchor"]
   618	    return bytes([len(t)]) + t + b"\x02" + b"".join(len(x).to_bytes(4, "big") + x for x in (f0, s0, f1, s1))
