   524	def pgp4_parse(s):
   525	    """-> (hashed area bytes, r, s). One legacy-format tag-2 packet, shortest length form, v4 type 0x00,
   526	    ECDSA (19) with SHA-256 (8); every inner length consumed exactly."""
   527	    if s[0] == 0x88:
   528	        need(s, 1, 1)
   529	        blen, at = s[1], 2
   530	    elif s[0] == 0x89:
   531	        need(s, 1, 2)
   532	        blen, at = int.from_bytes(s[1:3], "big"), 3
   533	        if blen <= 255:
   534	            raise Bad("SIG_PACKET")
   535	    else:
   536	        raise Bad("SIG_PACKET")
   537	    if len(s) - at != blen:
   538	        raise Bad("TRUNCATED" if len(s) - at < blen else "TRAILING")
   539	    end = len(s)
   540	    fmt = Bad("SIG_FORMAT")
   541	    if end - at < 6 or list(s[at:at + 4]) != [4, 0, 19, 8]:
   542	        raise fmt
   543	    hlen = int.from_bytes(s[at + 4:at + 6], "big")
   544	    h0, h1 = at + 6, at + 6 + hlen
   545	    if h1 + 2 > end or not subpackets_ok(s, h0, h1):
   546	        raise fmt
   547	    ulen = int.from_bytes(s[h1:h1 + 2], "big")
   548	    u0, u1 = h1 + 2, h1 + 2 + ulen
   549	    if u1 > end or not subpackets_ok(s, u0, u1):
   550	        raise fmt
   551	    i = u1 + 2                                   # skip the unsigned left-16 field
   552	    ints = []
   553	    for _ in range(2):
   554	        if i + 2 > end:
   555	            raise fmt
   556	        nbits = int.from_bytes(s[i:i + 2], "big")
   557	        nbytes = (nbits + 7) // 8
   558	        if nbits == 0 or nbits > 256 or i + 2 + nbytes > end:
   559	            raise fmt
   560	        v = int.from_bytes(s[i + 2:i + 2 + nbytes], "big")
   561	        if v.bit_length() != nbits:
   562	            raise fmt
   563	        ints.append(v)
   564	        i += 2 + nbytes
   565	    if i != end:
   566	        raise fmt
   567	    return bytes(s[h0:h1]), ints[0], ints[1]
