+    a,b=int.from_bytes(z0,'big'),int.from_bytes(z1,'big')
+    d=(-(a+b)*pow(2*r,-1,n))%n
+    s=((a+r*d)*pow(k,-1,n))%n
+    assert d and r and s and z0!=z1 and z0[:2]==z1[:2]
