+    (HERE/'exhaustive.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps({'counts':dict(counts),'disagreements':len(diffs)},indent=2))
+    for d in diffs[:12]:print(d)
+
+if __name__=='__main__':main()
