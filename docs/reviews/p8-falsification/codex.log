+        a=outcome(lambda:B.frame_decode(raw,'attest'));b=outcome(lambda:I.read_frame(raw,'tessera-v1/attest'))
+        # No duplicate huge data in evidence files.
+        print('payload-bytes',size,'B='+a[0],'I='+b[0],flush=True)
