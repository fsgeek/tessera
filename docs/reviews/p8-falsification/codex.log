   169	    try: ledger.add('2.1',jcs(obj)==bundle,'JSON_NONCANONICAL')
   170	    except Fault: ledger.fault('2.1','JSON_NONCANONICAL')
   171	    raw=container_schema(obj,ledger)
   172	    headers={int(p.split('.')[1]):data for p,data in raw.items() if p.startswith('headers.')}; pins=config['_pins']
   173	    # Installation input, never inferred from a bundle or its spec lookup.
   174	    catalog_alg=next(iter(catalog.values()))['alg'] if catalog else None
   175	    registry=registered_codecs(catalog_alg)
   176	    anchor=ledger.run('3.1',read_anchor,raw['a_sig'],registry) if 'a_sig' in raw else None
   177	    manifest=ledger.run('4.1',read_frame,raw['manifest'],'tessera-v1/manifest') if 'manifest' in raw else None
   178	    frames=anchor if anchor else []

