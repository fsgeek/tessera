   230	def es_string(f):
   231	    """ECMAScript Number::toString for a finite double (RFC 8785 §3.2.2.3)."""
   232	    if f == 0:
   233	        return "0"
   234	    sign = "-" if f < 0 else ""
   235	    _, digits, exp = _decimal(repr(abs(f)).replace("e+", "e"))
   236	    k = len(digits)
   237	    n = exp + k
   238	    if k <= n <= 21:
   239	        body = digits + "0" * (n - k)
   240	    elif 0 < n <= 21:
   241	        body = digits[:n] + "." + digits[n:]
   242	    elif -6 < n <= 0:
   243	        body = "0." + "0" * (-n) + digits
   244	    else:
   245	        e = n - 1
   246	        body = digits[0] + ("." + digits[1:] if k > 1 else "") + "e" + ("+" if e >= 0 else "-") + str(abs(e))
   247	    return sign + body
   248	
   249	
   250	def number(lit):
   251	    neg, digits, exp = _decimal(lit)
   252	    if not digits:
   253	        if neg:
   254	            raise Bad("JSON_NUMBER", "negative zero")
   255	        return 0.0
   256	    f = float(lit)
   257	    if f != f or f in (float("inf"), float("-inf")):
   258	        raise Bad("JSON_NUMBER", "not a finite double")
   259	    if f == 0 or _decimal(es_string(f)) != (neg, digits, exp):
   260	        raise Bad("JSON_NUMBER", "value not preserved")
   261	    return f
