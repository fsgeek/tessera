prototype/indep-verifier/codex-r4.log:14346:originals=json.loads(\"{\\\"codec.py\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Independent ENC codecs. No repository implementation imports.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport base64\\\\nimport datetime as dt\\\\nimport decimal\\\\nimport hashlib\\\\nimport json\\\\nimport math\\\\nimport re\\\\nimport unicodedata\\\\nfrom dataclasses import dataclass\\\\nfrom cryptography.hazmat.primitives import hashes\\\\nfrom cryptography.hazmat.primitives.asymmetric import ec, utils, mldsa\\\\nfrom cryptography.exceptions import InvalidSignature\\\\n\\\\nALG = 'OPENPGP4-ECDSA-P256-SHA256'\\\\nHYBRID_ALG = 'KMS-MLDSA65-PURE-GPG-OPENPGP4-ECDSA-P256-SHA256'\\\\n# Candidate supplement codecs compiled into this instrument. Catalog selection\\\\n# supplies policy support; this registry does not assert dated owner registration.\\\\nCODEC_ALGS = frozenset((ALG,HYBRID_ALG))\\\\nPROFILE = 'tessera-v1-strict'\\\\nHEX = re.compile(r'[0-9a-f]{64}\\\\\\\\Z')\\\\nTAGS = {'tessera-v1/attest','tessera-v1/manifest','tessera-v1/receipt-anchor-sig','tessera-v1/dnssec-snapshot'}\\\\nSPKI = bytes.fromhex('3059301306072a8648ce3d020106082a8648ce3d030107034200')\\\\nMLDSA65_SPKI = bytes.fromhex('308207b2300b0609608648016503040312038207a100')\\\\nGPG_PREFIX = bytes.fromhex('13082a8648ce3d0301070203')\\\\nP = 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff\\\\nB = 0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\\\\nN = 0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551\\\\n\\\\nclass Fault(ValueError):\\\\n    def __init__(self,code): self.code=code; super().__init__(code)\\\\n\\\\ndef demand(condition,code):\\\\n    if not condition: raise Fault(code)\\\\n\\\\ndef sha(data): return hashlib.sha256(data).digest()\\\\ndef shahex(data): return sha(data).hex()\\\\ndef b64(value):\\\\n    try:\\\\n        demand(isinstance(value,str) and not isinstance(value,Literal),'CONTAINER_SCHEMA')\\\\n        raw=base64.b64decode(value,validate=True)\\\\n        demand(base64.b64encode(raw).decode()==value,'CONTAINER_SCHEMA')\\\\n        return raw\\\\n    except (ValueError,UnicodeError): raise Fault('CONTAINER_SCHEMA') from None\\\\n\\\\ndef utc(s):\\\\n    demand(isinstance(s,str) and re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z',s),'SCHEMA')\\\\n    try: return int((dt.datetime.strptime(s,'%Y-%m-%dT%H:%M:%SZ')-dt.datetime(1970,1,1)).total_seconds())\\\\n    except ValueError: raise Fault('SCHEMA') from None\\\\n\\\\ndef isotime(t): return (dt.datetime(1970,1,1)+dt.timedelta(seconds=t)).strftime('%Y-%m-%dT%H:%M:%SZ')\\\\ndef domain(s):\\\\n    return isinstance(s,str) and len(s)<=241 and len(s.split('.'))>=2 and all(re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?',x) for x in s.split('.'))\\\\ndef fp(s,slot=None):\\\\n    if not isinstance(s,str): return False\\\\n    options=['spki-sha256:'] if slot=='kms' else ['gpg-sha256:'] if slot=='gpg' else ['spki-sha256:','gpg-sha256:']\\\\n    return any(s.startswith(p) and HEX.fullmatch(s[len(p):]) for p in options)\\\\n\\\\nclass Literal(str): pass\\\\nclass Pairs(list): pass\\\\n@dataclass(frozen=True)\\\\nclass Number:\\\\n    value: float\\\\n\\\\ndef es(value):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Shortest binary64 roundtrip, closest decimal then even, ECMA layout.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    if value==0: return '0'\\\\n    if value<0: return '-'+es(-value)\\\\n    with decimal.localcontext() as ctx:\\\\n        ctx.prec=1100\\\\n        exact=decimal.Decimal.from_float(value)\\\\n        exponent=exact.adjusted()\\\\n        candidates=[]\\\\n        for k in range(1,18):\\\\n            step=decimal.Decimal(10)**(exponent-k+1)\\\\n            nearest=int((exact/step).to_integral_value(rounding=decimal.ROUND_HALF_EVEN))\\\\n            for i in (nearest-1,nearest,nearest+1):\\\\n                if i>0:\\\\n                    candidate=decimal.Decimal(i)*step\\\\n                    if float(candidate)==value:\\\\n                        candidates.append((abs(candidate-exact),i%2,candidate))\\\\n            if candidates: break\\\\n        demand(bool(candidates),'JSON_NUMBER')\\\\n        d=min(candidates)[2].normalize()\\\\n        digits=''.join(map(str,d.as_tuple().digits)); n=len(digits)+d.as_tuple().exponent; k=len(digits)\\\\n        if k<=n<=21: return digits+'0'*(n-k)\\\\n        if 0<n<=21: return digits[:n]+'.'+digits[n:]\\\\n        if -6<n<=0: return '0.'+'0'*(-n)+digits\\\\n        return digits[0]+('.'+digits[1:] if k>1 else '')+'e'+('+' if n-1>=0 else '-')+str(abs(n-1))\\\\n\\\\ndef parse_json(raw,canonical=False,no_numbers=False,max_depth=64, numbers=True):\\\\n    try: text=raw.decode('utf-8',errors='strict')\\\\n    except UnicodeError: raise Fault('JSON_ENCODING') from None\\\\n    try:\\\\n        obj=json.loads(text,object_pairs_hook=Pairs,parse_int=Literal,parse_float=Literal,\\\\n                       parse_constant=lambda _: (_ for _ in ()).throw(Fault('JSON_SYNTAX')))\\\\n    except (ValueError,RecursionError): raise Fault('JSON_SYNTAX') from None\\\\n    def visit(v,depth=0):\\\\n        if isinstance(v,(Pairs,list)):\\\\n            demand(depth+1<=max_depth,'JSON_DEPTH')\\\\n            for x in ( [v for _,v in v] if isinstance(v,Pairs) else v): visit(x,depth+1)\\\\n    visit(obj)\\\\n    def walk(v):\\\\n        yield v\\\\n        if isinstance(v,Pairs):\\\\n            for key,val in v: yield key; yield from walk(val)\\\\n        elif isinstance(v,list):\\\\n            for val in v: yield from walk(val)\\\\n    values=list(walk(obj))\\\\n    for val in values:\\\\n        if isinstance(val,Pairs): demand(len({k for k,_ in val})==len(val),'JSON_DUPLICATE_NAME')\\\\n    for val in values:\\\\n        if isinstance(val,str) and not isinstance(val,Literal):\\\\n            demand(all(not (0xd800<=ord(c)<=0xdfff or 0xfdd0<=ord(c)<=0xfdef or ord(c)&0xffff in (0xfffe,0xffff))\\\\n                       and unicodedata.category(c)"'!='"'Cn' for c in val) and unicodedata.normalize('NFC',val)==val,'JSON_STRING')\\\\n    def convert(v):\\\\n        if isinstance(v,Literal):\\\\n            if not numbers: return v\\\\n            demand(not no_numbers,'JSON_NUMBER')\\\\n            # Decimal accepts huge exponents poorly; zero is handled without constructing it.\\\\n            mantissa=re.split('[eE]',v)[0]\\\\n            zero=all(c in '-.0' for c in mantissa)\\\\n            demand(not (zero and v.startswith('-')),'JSON_NUMBER')\\\\n            if zero: return Number(0.0)\\\\n            try:\\\\n                exact=decimal.Decimal(v); f=float(v)\\\\n                demand(math.isfinite(f) and decimal.Decimal(es(f))==exact,'JSON_NUMBER')\\\\n                return Number(f)\\\\n            except (decimal.InvalidOperation,OverflowError,ValueError): raise Fault('JSON_NUMBER') from None\\\\n        if isinstance(v,Pairs): return {k:convert(x) for k,x in v}\\\\n        if isinstance(v,list): return [convert(x) for x in v]\\\\n        return v\\\\n    obj=convert(obj)\\\\n    if canonical: demand(jcs(obj)==raw,'JSON_NONCANONICAL')\\\\n    return obj\\\\n\\\\ndef jcs(v):\\\\n    def dump(v):\\\\n        if isinstance(v,Literal):\\\\n            try:\\\\n                f=float(v); demand(math.isfinite(f),'JSON_NONCANONICAL'); return es(f)\\\\n            except (ValueError,OverflowError): raise Fault('JSON_NONCANONICAL') from None\\\\n        if isinstance(v,Number): return es(v.value)\\\\n        if v is None: return 'null'\\\\n        if v is True: return 'true'\\\\n        if v is False: return 'false'\\\\n        if isinstance(v,str): return json.dumps(v,ensure_ascii=False,separators=(',',':'))\\\\n        if isinstance(v,list): return '['+','.join(dump(x) for x in v)+']'\\\\n        if isinstance(v,dict): return '{'+','.join(dump(k)+':'+dump(v[k]) for k in sorted(v,key=lambda k:k.encode('utf-16be')))+'}'\\\\n        raise TypeError('not a JSON value')\\\\n    return dump(v).encode('utf-8')\\\\n\\\\nclass Cursor:\\\\n    def __init__(self,data,code='TRUNCATED'): self.data=data; self.pos=0; self.code=code\\\\n    def take(self,n):\\\\n        demand(n>=0 and n<=len(self.data)-self.pos,self.code)\\\\n        out=self.data[self.pos:self.pos+n]; self.pos+=n; return out\\\\n    def uint(self,n): return int.from_bytes(self.take(n),'big')\\\\n    def end(self,code='TRAILING'): demand(self.pos==len(self.data),code)\\\\n\\\\ndef tag(c,expected):\\\\n    t=c.take(c.uint(1))\\\\n    demand(t in {t.encode() for t in TAGS},'TAG_UNKNOWN')\\\\n    demand(t==expected.encode(),'TAG_MISMATCH')\\\\n\\\\ndef frame(t,payload): return bytes([len(t)])+t.encode()+b'\\\\\\\\x00\\\\\\\\x01'+len(payload).to_bytes(4,'big')+payload\\\\n\\\\ndef schema(obj,expected): demand(isinstance(obj,dict) and set(obj)==set(expected),'SCHEMA')\\\\ndef schema_alg(a): demand(isinstance(a,str) and re.fullmatch(r'[A-Z0-9][A-Z0-9-]{0,63}',a),'SCHEMA')\\\\n\\\\ndef read_frame(raw,expected):\\\\n    c=Cursor(raw); tag(c,expected); demand(c.uint(2)==1,'CV_UNKNOWN'); n=c.uint(4)\\\\n    demand(n<=2**24,'LENGTH_CAP'); payload=c.take(n); c.end()\\\\n    obj=parse_json(payload,canonical=True)\\\\n    if expected=='tessera-v1/manifest':\\\\n        schema(obj,['alg','issuer','key_fp','sset','ver']); schema_alg(obj['alg'])\\\\n        demand(domain(obj['issuer']) and fp(obj['key_fp'],'kms') and obj['ver']=='map-v1','SCHEMA')\\\\n        demand(isinstance(obj['sset'],list) and len(obj['sset'])==1 and fp(obj['sset'][0],'gpg'),'SCHEMA')\\\\n    else:\\\\n        schema(obj,['common','signer']); schema(obj['signer'],['key_fp']); demand(fp(obj['signer']['key_fp']),'SCHEMA')\\\\n        co=obj['common']; schema(co,['alg','binding_forms','content','declared_issue_time','issuer','manifest_sha256','preamble_sha256','profile','spec','vectors_sha256'])\\\\n        schema_alg(co['alg']); schema(co['spec'],['id','sha256'])\\\\n        demand(domain(co['issuer']) and co['profile']==PROFILE,'SCHEMA'); utc(co['declared_issue_time'])\\\\n        demand(isinstance(co['spec']['id'],str) and re.fullmatch(r'[a-z0-9][a-z0-9._/-]{0,127}',co['spec']['id']),'SCHEMA')\\\\n        for value in [co['manifest_sha256'],co['preamble_sha256'],co['vectors_sha256'],co['spec']['sha256']]: demand(isinstance(value,str) and HEX.fullmatch(value),'SCHEMA')\\\\n        forms=co['binding_forms']; demand(isinstance(forms,list) and bool(forms) and all(isinstance(f,str) and re.fullmatch(r'[A-Z][A-Z0-9_]{0,31}',f) for f in forms),'SCHEMA')\\\\n        demand(forms==sorted(set(forms)),'SCHEMA')\\\\n    return obj\\\\n\\\\ndef subpackets(raw):\\\\n    c=Cursor(raw,'SIG_FORMAT'); out=[]\\\\n    while c.pos<len(raw):\\\\n        o=c.uint(1)\\\\n        if o<192: n=o\\\\n        elif o<255: n=((o-192)<<8)+c.uint(1)+192\\\\n        else:\\\\n            n=c.uint(4); demand(n>=16320,'SIG_FORMAT')\\\\n        demand(n>=1,'SIG_FORMAT'); p=c.take(n); out.append((p[0]&127,bool(p[0]&128),p[1:]))\\\\n    return out\\\\n\\\\n@dataclass\\\\nclass Signature:\\\\n    hashed: list\\\\n    unhashed: list\\\\n    prefix: bytes\\\\n    r: int\\\\n    s: int\\\\n    trailer: bytes\\\\n\\\\ndef signature_rule(alg,slot):\\\\n    if alg==HYBRID_ALG and slot=='kms': return 'R',3309\\\\n    if alg in CODEC_ALGS: return 'O',1024\\\\n    return 'opaque',65536\\\\n\\\\ndef parse_signature(raw,alg=ALG,slot='kms'):\\\\n    rule,cap=signature_rule(alg,slot)\\\\n    demand(len(raw)>0,'SIG_EMPTY'); demand(len(raw)<=cap,'LENGTH_CAP')\\\\n    if rule=='opaque': return None\\\\n    if rule=='R':\\\\n        # HS §2: codec is length-only; sigDecode belongs to verification.\\\\n        demand(len(raw)==3309,'SIG_FORMAT'); return raw\\\\n    c=Cursor(raw); first=c.uint(1); demand(first in (0x88,0x89),'SIG_PACKET')\\\\n    n=c.uint(1 if first==0x88 else 2); demand(first==0x88 or n>255,'SIG_PACKET')\\\\n    body=c.take(n); c.end(); b=Cursor(body,'SIG_FORMAT'); demand(b.take(4)==b'\\\\\\\\x04\\\\\\\\x00\\\\\\\\x13\\\\\\\\x08','SIG_FORMAT')\\\\n    hlen=b.uint(2); h=b.take(hlen); header=body[:6+hlen]\\\\n    hashed=subpackets(h); unhashed=subpackets(b.take(b.uint(2))); prefix=b.take(2)\\\\n    def mpi():\\\\n        bits=b.uint(2); demand(1<=bits<=256,'SIG_FORMAT'); value=int.from_bytes(b.take((bits+7)//8),'big'); demand(value.bit_length()==bits,'SIG_FORMAT'); return value\\\\n    r=mpi(); s=mpi(); b.end('SIG_FORMAT')\\\\n    return Signature(hashed,unhashed,prefix,r,s,header+b'\\\\\\\\x04\\\\\\\\xff'+len(header).to_bytes(4,'big'))\\\\n\\\\ndef sig_policy(sig):\\\\n    # Rule R has no OpenPGP policy/trailer. FIPS gates run at verification,\\\\n    # mapping to SIG_INVALID or POSSESSION_INVALID, never SIG_POLICY.\\\\n    if isinstance(sig,bytes): return\\\\n    demand(sig is not None,'SIG_POLICY')\\\\n    creation=[d for t,_,d in sig.hashed if t==2]\\\\n    demand(len(creation)==1 and len(creation[0])==4,'SIG_POLICY')\\\\n    ids=[d for t,_,d in sig.hashed if t==16]; fps=[d for t,_,d in sig.hashed if t==33]\\\\n    demand(len(ids)<=1 and all(len(d)==8 for d in ids),'SIG_POLICY')\\\\n    demand(len(fps)<=1 and all(len(d)==21 and d[0]==4 for d in fps),'SIG_POLICY')\\\\n    demand(not ids or not fps or ids[0]==fps[0][-8:],'SIG_POLICY')\\\\n    for t,critical,_ in sig.hashed: demand(t"'!=3 and (t in (2,16,33) or not critical),'"'SIG_POLICY')\\\\n    demand(1<=sig.r<N and 1<=sig.s<N,'SIG_POLICY')\\\\n\\\\ndef point(raw):\\\\n    demand(len(raw)==65 and raw[0]==4,'KEY_FORMAT')\\\\n    x=int.from_bytes(raw[1:33],'big'); y=int.from_bytes(raw[33:],'big')\\\\n    demand(x<P and y<P and (y*y-(x*x*x-3*x+B))%P==0,'KEY_FORMAT')\\\\n    try: return ec.EllipticCurvePublicNumbers(x,y,ec.SECP256R1()).public_key()\\\\n    except ValueError: raise Fault('KEY_FORMAT') from None\\\\n\\\\ndef public_key(raw,slot,alg=ALG):\\\\n    if slot=='kms':\\\\n        if alg==HYBRID_ALG:\\\\n            # HS §3 / RFC 9881 §§2,4: exact DER, absent parameters, zero\\\\n            # unused bits. Every 1952-byte pkDecode input is well formed.\\\\n            demand(len(raw)==1974 and raw[:22]==MLDSA65_SPKI,'KEY_FORMAT')\\\\n            return mldsa.MLDSA65PublicKey.from_public_bytes(raw[22:])\\\\n        demand(len(raw)==91 and raw[:26]==SPKI,'KEY_FORMAT'); return point(raw[26:])\\\\n    demand(len(raw)==82 and raw[0]==4 and raw[5:17]==GPG_PREFIX,'KEY_FORMAT'); return point(raw[17:])\\\\n\\\\ndef mldsa65_encoding_valid(sig):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"FIPS 204 Algorithms 21, 27, 8; verification gates, not rule-R codec.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    if len(sig)"'!=3309: return False'"\\\\n    # HintBitUnpack: counts bounded and nondecreasing; strict order within\\\\n    # each polynomial (including no duplicates); unused indices all zero.\\\\n    hints=sig[3248:]; start=0\\\\n    for end in hints[55:]:\\\\n        if not start<=end<=55: return False\\\\n        indices=hints[start:end]\\\\n        if any(a>=b for a,b in zip(indices,indices[1:])): return False\\\\n        start=end\\\\n    if any(hints[start:55]): return False\\\\n    # BitUnpack(z, gamma1-1, gamma1), 20 little-endian bits/coefficient.\\\\n    # ML-DSA-65: gamma1=2"'^19, beta=196; strict infinity-norm bound.'"\\\\n    bits=int.from_bytes(sig[48:3248],'little')\\\\n    for _ in range(5*256):\\\\n        coefficient=(1<<19)-(bits&((1<<20)-1))\\\\n        if abs(coefficient)>=(1<<19)-196: return False\\\\n        bits>>=20\\\\n    return True\\\\n\\\\ndef signature_verifies(document,sig,key):\\\\n    if isinstance(sig,bytes):\\\\n        if not mldsa65_encoding_valid(sig): return False\\\\n        try:\\\\n            # Algorithm 3 applies 00 00 itself: pass exact F, not mu or M'.\\\\n            key.verify(sig,document,context=b''); return True\\\\n        except (InvalidSignature,ValueError): return False\\\\n    digest=sha(document+sig.trailer)\\\\n    if digest[:2]"'!=sig.prefix: return False'"\\\\n    try: key.verify(utils.encode_dss_signature(sig.r,sig.s),digest,ec.ECDSA(utils.Prehashed(hashes.SHA256()))); return True\\\\n    except (InvalidSignature,ValueError): return False\\\\n\\\\ndef read_anchor(raw):\\\\n    c=Cursor(raw); tag(c,'tessera-v1/receipt-anchor-sig'); demand(c.uint(1)==2,'ANCHOR_COUNT'); out=[]\\\\n    for slot in ('kms','gpg'):\\\\n        n=c.uint(4); demand(n<=2**24+64,'LENGTH_CAP'); f=c.take(n); obj=read_frame(f,'tessera-v1/attest')\\\\n        n=c.uint(4); demand(n>0,'SIG_EMPTY'); demand(n<=signature_rule(obj['common']['alg'],slot)[1],'LENGTH_CAP')\\\\n        s=c.take(n); parsed=parse_signature(s,obj['common']['alg'],slot); out.append((f,obj,s,parsed))\\\\n    c.end(); return out\\\\n\\\",\\\"verify.py\\\":\\\"#"'!/usr/bin/env python3.14'"\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Independent V1 differential instrument. Emits only the stable six on stdout.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport argparse\\\\nimport re\\\\nimport sys\\\\nimport unicodedata\\\\nfrom dataclasses import dataclass\\\\nfrom pathlib import Path\\\\nfrom codec import (ALG,CODEC_ALGS,PROFILE,Fault,Literal,b64,demand,frame,isotime,jcs,parse_json,\\\\n                   parse_signature,public_key,read_anchor,read_frame,shahex,\\\\n                   signature_verifies,sig_policy,utc)\\\\nfrom anchors import parse_ots,select,sha256d,tx_path\\\\nfrom dnssec import interval,parse_snapshot,txt_value,validate_snapshot\\\\nfrom git_channel import dearmor,object_id,parse_commit,parse_tree,verify_path\\\\nfrom policy import parse_catalog,parse_trust\\\\nimport release_constants as release\\\\nimport sha1dc\\\\n\\\\nSLOTS=('kms','gpg')\\\\nROWS=['1.1','1.2','1.3','1.4','2.1','2.2','2.3','2.4','3.1','4.1','4.2','5.1','5.2','6.1','6.2','6.3','7.1',\\\\n      '8.1','8.2','8.3','8.4','8.5','9.1','9.2','9.3','9.4','9.5','10.1','10.2','10.3',\\\\n      '11.1','11.2','11.3','11.4','11.5','12.1','12.2','12.3',\\\\n      '13.1','13.2','13.3','13.4','13.5','13.6','13.7',\\\\n      '14.1','14.2','14.3','14.4','14.5','14.6','14.7','14.8',\\\\n      '15.1','15.2','16.1','17.1','17.2','17.3','17.4']\\\\n@dataclass\\\\nclass Check:\\\\n    row:str\\\\n    status:str\\\\n    reason:str|None=None\\\\n    tie:tuple=()\\\\n\\\\nclass Ledger:\\\\n    def __init__(self): self.checks=[]\\\\n    def add(self,row,condition,code,tie=(),unknown=False):\\\\n        self.checks.append(Check(row,'pass' if condition else 'unknown' if unknown else 'invalid',None if condition else code,tie))\\\\n        return bool(condition)\\\\n    def fault(self,row,code,tie=(),unknown=False): return self.add(row,False,code,tie,unknown)\\\\n    def run(self,row,fn,*args,tie=()):\\\\n        try: value=fn(*args); self.checks.append(Check(row,'pass',tie=tie)); return value\\\\n        except Fault as e: self.fault(row,e.code,tie); return None\\\\n    def report(self,t):\\\\n        rank={r:i for i,r in enumerate(ROWS)}\\\\n        for kind,verdict in [('invalid','INVALID'),('unknown','UNVERIFIABLE')]:\\\\n            candidates=[c for c in self.checks if c.status==kind and c.reason]\\\\n            if candidates:\\\\n                winner=min(candidates,key=lambda c:(rank[c.row],c.tie))\\\\n                return stable(verdict,winner.reason,t)\\\\n        return stable('VALID_STRICT','OK',t)\\\\n    def diagnostics(self):\\\\n        result=[]\\\\n        for row in ROWS:\\\\n            seen=[c for c in self.checks if c.row==row]\\\\n            result.extend(seen or [Check(row,'blocked')])\\\\n        return result\\\\n\\\\ndef stable(verdict,reason,t=None):\\\\n    return {'historical_security':'NOT_EVALUATED','reason':reason,'revocation':'NOT_EVALUATED',\\\\n            'standing':'ABSENT/NOT_ISSUED_IN_PROFILE','T':isotime(t) if t is not None else None,'verdict':verdict}\\\\n\\\\nBINARY={'a_sig','manifest','spec','vectors','preamble','dependency_manifest'}\\\\nNESTED={'possession':{'kms','gpg'},'keys':{'kms','gpg'},'receipt_anchor':{'ots','txid'},\\\\n        'dns':{'ots','snapshot_body'},'git':{'blob','commit','object_format','ots','trees'},\\\\n        'issuer_record':{'observed_anchor_delay_s','policy_version'}}\\\\nREQUIRED=BINARY|set(NESTED)-{'issuer_record'}|{'headers'}\\\\nDEC=re.compile(r'(?:0|[1-9][0-9]*)\\\\\\\\Z')\\\\n\\\\ndef decimal_string(v): return isinstance(v,str) and not isinstance(v,Literal) and len(v)<=10 and DEC.fullmatch(v) and int(v)<=4294967295\\\\n\\\\ndef container_schema(obj,ledger):\\\\n    raw={}; layer=obj['layers'][0]\\\\n    if set(obj)"'!={'"'profile','layers'}: ledger.fault('2.4','CONTAINER_SCHEMA',('top',))\\\\n    if not isinstance(layer,dict): ledger.fault('2.4','CONTAINER_SCHEMA',('layer',)); return raw\\\\n    def missing(path): ledger.fault('2.2','GIT_OBJECT_FORMAT_MISSING' if path=='git.object_format' else 'MEMBER_MISSING:'+path,(path.encode('utf-16be'),),True)\\\\n    def bad(path): ledger.fault('2.4','CONTAINER_SCHEMA',(path.encode('utf-16be'),))\\\\n    def binary(value,path):\\\\n        try: raw[path]=b64(value)\\\\n        except Fault: bad(path)\\\\n    for k in sorted(REQUIRED):\\\\n        if k not in layer: missing(k)\\\\n    for k,value in layer.items():\\\\n        if k in BINARY: binary(value,k)\\\\n        elif k in NESTED:\\\\n            if not isinstance(value,dict): bad(k); continue\\\\n            for f in sorted(NESTED[k]):\\\\n                path=k+'.'+f\\\\n                if f not in value:\\\\n                    if k=='issuer_record': bad(path)\\\\n                    else: missing(path)\\\\n                    continue\\\\n                v=value[f]\\\\n                if path=='git.object_format':\\\\n                    if not isinstance(v,str) or isinstance(v,Literal): bad(path)\\\\n                    else: raw[path]=v; ledger.add('2.3',v=='sha1','GIT_OBJECT_FORMAT',unknown=True)\\\\n                elif path=='receipt_anchor.txid':\\\\n                    if isinstance(v,str) and not isinstance(v,Literal) and re.fullmatch(r'[0-9a-f]{64}',v): raw[path]=v\\\\n                    else: bad(path)\\\\n                elif path=='git.trees':\\\\n                    if not isinstance(v,list): bad(path)\\\\n                    else:\\\\n                        if len(v)"'!=2: bad(path)'"\\\\n                        for i,x in enumerate(v[:2]): binary(x,f'{path}.{i}')\\\\n                        for i in range(len(v),2): missing(f'{path}.{i}')\\\\n                elif path=='issuer_record.observed_anchor_delay_s':\\\\n                    if not decimal_string(v): bad(path)\\\\n                elif path=='issuer_record.policy_version':\\\\n                    if not isinstance(v,str) or isinstance(v,Literal) or not re.fullmatch(r'tessera-v1-issue-policy/(?:0|[1-9][0-9]*)',v): bad(path)\\\\n                else: binary(v,path)\\\\n            for f in set(value)-NESTED[k]: bad(k+'.'+f)\\\\n        elif k=='headers':\\\\n            if not isinstance(value,dict) or not value: bad(k); continue\\\\n            for h,v in value.items():\\\\n                if not decimal_string(h) or not isinstance(v,str) or isinstance(v,Literal) or not re.fullmatch(r'[0-9a-f]{160}',v): bad('headers.'+h)\\\\n                else: raw['headers.'+h]=bytes.fromhex(v)\\\\n        else: bad(k)\\\\n    for row in ('2.2','2.4'):\\\\n        if not any(c.row==row for c in ledger.checks): ledger.add(row,True,'')\\\\n    return raw\\\\n\\\\n@dataclass\\\\nclass AnchorResult:\\\\n    selected:object|None\\\\n    usable:bool\\\\n\\\\ndef anchor_checks(ledger,row,data,expected,headers,pins,kind,txid=None):\\\\n    # All branches are evaluated even when an independent stage has failed.\\\\n    if data is None: return AnchorResult(None,False)\\\\n    receipt=kind=='receipt'; codes={'receipt':'RECEIPT_ANCHOR_MISMATCH','snapshot':'SNAPSHOT_STAMP_MISMATCH','git':'GIT_STAMP_MISMATCH'}\\\\n    sub=lambda i: f'11.{i}' if receipt else row\\\\n    proof=ledger.run(sub(1),parse_ots,data,tie=(0,))\\\\n    if proof is None: return AnchorResult(None,False)\\\\n    digest_ok=False\\\\n    if expected is not None: digest_ok=ledger.add(sub(2),proof.digest.hex()==shahex(expected),codes[kind],(1,))\\\\n    selected,contradicted=select(proof,headers,pins)\\\\n    ledger.add(sub(3),not contradicted,'OTS_MERKLE_MISMATCH',(2,))\\\\n    no_anchor=('HEADERS_MISSING' if proof.bitcoin else 'ANCHOR_PENDING_ONLY') if receipt else 'SNAPSHOT_NOT_ANCHORED' if kind=='snapshot' else 'GIT_NOT_ANCHORED'\\\\n    ledger.add(sub(4),selected is not None,no_anchor,(3,),True)\\\\n    if selected:\\\\n        if not receipt or txid is not None:\\\\n            ledger.add(sub(5),any(tx_path(a,txid if receipt else None) for a in selected.paths),\\\\n                       'ANCHOR_TXID_MISMATCH' if receipt else 'OTS_TX_SHAPE',(4,))\\\\n    # T requires grammar, digest, no contradiction, qualifying; NOT tx shape.\\\\n    return AnchorResult(selected,digest_ok and not contradicted and selected is not None)\\\\n\\\\ndef verify_bundle(bundle,config,catalog,request='strict',diagnostics=False):\\\\n    if len(bundle)>2**27: return stable('UNVERIFIABLE','OUT_OF_PROFILE')\\\\n    try: obj=parse_json(bundle,numbers=False)\\\\n    except Fault: return stable('UNVERIFIABLE','OUT_OF_PROFILE')\\\\n    if not isinstance(obj,dict) or obj.get('profile')"'!=PROFILE: return stable('"'UNVERIFIABLE','OUT_OF_PROFILE')\\\\n    if not isinstance(obj.get('layers'),list) or len(obj['layers'])"'!=1 or request!='"'strict': return stable('UNVERIFIABLE','OUT_OF_PROFILE')\\\\n    ledger=Ledger()\\\\n    for row in ('1.1','1.2','1.3','1.4'): ledger.add(row,True,'')\\\\n    try: ledger.add('2.1',jcs(obj)==bundle,'JSON_NONCANONICAL')\\\\n    except Fault: ledger.fault('2.1','JSON_NONCANONICAL')\\\\n    raw=container_schema(obj,ledger)\\\\n    headers={int(p.split('.')[1]):data for p,data in raw.items() if p.startswith('headers.')}; pins=config['_pins']\\\\n    anchor=ledger.run('3.1',read_anchor,raw['a_sig']) if 'a_sig' in raw else None\\\\n    manifest=ledger.run('4.1',read_frame,raw['manifest'],'tessera-v1/manifest') if 'manifest' in raw else None\\\\n    frames=anchor if anchor else []\\\\n    commons=[f[1]['common'] for f in frames]\\\\n    fps=[manifest['key_fp'],manifest['sset'][0]] if manifest else []\\\\n    if manifest:\\\\n        for i,co in enumerate(commons): ledger.add('4.2',co['manifest_sha256']==shahex(raw['manifest']),'RECEIPT_MANIFEST_MISMATCH',(i,))\\\\n    # Selection is an installation input, independent of the bundle's spec\\\\n    # lookup. Codecs still use each frame's own alg (r2-F01).\\\\n    catalog_alg=next(iter(catalog.values()))['alg'] if catalog else None\\\\n    supported={i:co['alg']==catalog_alg and co['alg'] in CODEC_ALGS for i,co in enumerate(commons)}\\\\n    keys={}; bound={}\\\\n    for i,slot in enumerate(SLOTS):\\\\n        keybytes=raw.get('keys.'+slot)\\\\n        if keybytes is not None and supported.get(i):\\\\n            # EA-31: installed-spec key rules require catalog-supported alg.\\\\n            key=ledger.run('5.1',public_key,keybytes,slot,catalog_alg,tie=(i,)); keys[slot]=key\\\\n            if key is not None and manifest:\\\\n                bound[slot]=ledger.add('5.2',shahex(keybytes)==fps[i].split(':')[1],'KEY_MISMATCH',(i,))\\\\n    if anchor:\\\\n        if manifest:\\\\n            for i,f in enumerate(frames): ledger.add('6.1',f[1]['signer']['key_fp']==fps[i],'RECEIPT_SLOT',(i,))\\\\n        ledger.add('6.2',jcs(commons[0])==jcs(commons[1]),'RECEIPT_COMMON_MISMATCH')\\\\n        if manifest:\\\\n            for fieldno,field in enumerate(('issuer','alg')):\\\\n                for i,co in enumerate(commons): ledger.add('6.3',co[field]==manifest[field],'RECEIPT_MANIFEST_MISMATCH',(fieldno,i))\\\\n    entries=[]\\\\n    for i,co in enumerate(commons):\\\\n        entry=catalog.get(co['spec']['sha256']); entries.append(entry)\\\\n        ledger.add('7.1',supported[i],'ALG_UNKNOWN',(i,),True)\\\\n        ledger.add('8.1',co['issuer']=='wamason.com'==config['issuer_domain'],'ISSUER_NOT_PINNED',(i,))\\\\n        ledger.add('8.2',co['spec']['id']=='tessera-v1-strict/verification-spec/1','SPEC_ID',(i,))\\\\n        ledger.add('8.3',entry is not None,'SPEC_UNKNOWN',(i,),True)\\\\n        if entry:\\\\n            for j,field in enumerate(('vectors_sha256','preamble_sha256')):\\\\n                ledger.add('8.4',co[field]==entry[field],'SPEC_OBJECT_MISMATCH',(j,i))\\\\n        if co['binding_forms']==['STMT_DIRECT']: ledger.add('8.5',True,'',tie=(0,i))\\\\n        for j,f in enumerate(co['binding_forms']):\\\\n            if f"'!='"'STMT_DIRECT': ledger.fault('8.5','BINDING_FORM_UNSUPPORTED' if f=='STMT_DIGEST' else 'BINDING_FORM_UNKNOWN',(j,i),True)\\\\n    for i,slot in enumerate(SLOTS):\\\\n        co=commons[i] if i<len(commons) else None\\\\n        if anchor and supported.get(i):\\\\n            sig=frames[i][3]; policy=ledger.run('9.1',sig_policy,sig,tie=(i,))\\\\n            # run returns None for both successful policy and failure: consult checks.\\\\n            policy_ok=ledger.checks[-1].status=='pass'\\\\n            if policy_ok and keys.get(slot) is not None and bound.get(slot):\\\\n                ledger.add('9.2',signature_verifies(frames[i][0],sig,keys[slot]),'SIG_INVALID',(i,))\\\\n        possession=raw.get('possession.'+slot)\\\\n        if possession is not None:\\\\n            alg=co['alg'] if co else (manifest['alg'] if manifest else None)\\\\n            if alg is not None:\\\\n                parsed=ledger.run('9.3',parse_signature,possession,alg,slot,tie=(i,))\\\\n                codec_ok=ledger.checks[-1].status=='pass'\\\\n                if codec_ok and supported.get(i):\\\\n                    ledger.run('9.4',sig_policy,parsed,tie=(i,)); policy_ok=ledger.checks[-1].status=='pass'\\\\n                    if policy_ok and keys.get(slot) is not None and bound.get(slot) and manifest:\\\\n                        ledger.add('9.5',signature_verifies(raw['manifest'],parsed,keys[slot]),'POSSESSION_INVALID',(i,))\\\\n    for h,header in sorted(headers.items()):\\\\n        if h in pins: ledger.add('10.1',sha256d(header)[::-1].hex()==pins[h],'HEADER_CONFLICTS_PIN',(h,))\\\\n        ledger.add('10.2',h in pins,'HEADERS_NOT_COVERED',(h,),True)\\\\n        if h+1 in headers: ledger.add('10.3',headers[h+1][4:36]==sha256d(header),'HEADER_CHAIN_BROKEN',(h,))\\\\n    receipt=anchor_checks(ledger,None,raw.get('receipt_anchor.ots'),raw.get('a_sig'),headers,pins,'receipt',raw.get('receipt_anchor.txid'))\\\\n    t=receipt.selected.time if receipt.usable else None\\\\n    declared=utc(commons[0]['declared_issue_time']) if commons else None\\\\n    if receipt.selected and declared is not None:\\\\n        for row,condition,code in [('12.1',receipt.selected.time>=declared-86400,'TIME_BEFORE_DECLARED_EPSILON'),\\\\n                                   ('12.2',receipt.selected.time<=declared+259200,'TIME_AFTER_DECLARED_DELTA'),\\\\n                                   ('12.3',receipt.selected.confirmed<=declared+259200,'CONFIRMATION_LATE')]: ledger.add(row,condition,code)\\\\n    body=raw.get('dns.snapshot_body'); snapshot=None; dns_value=None; envelope=None\\\\n    if body is not None:\\\\n        if ledger.add('13.1',1<=len(body)<=2**24,'LENGTH_CAP'):\\\\n            envelope=bytes([26])+b'tessera-v1/dnssec-snapshot'+len(body).to_bytes(4,'big')+body\\\\n            snapshot=ledger.run('13.2',parse_snapshot,body)\\\\n    if snapshot: ledger.add('13.3',not snapshot.wildcard,'DNS_WILDCARD')\\\\n    snap_anchor=anchor_checks(ledger,'13.4',raw.get('dns.ots'),envelope,headers,pins,'snapshot')\\\\n    if snapshot and snap_anchor.usable:\\\\n        for i,outcome in enumerate(validate_snapshot(snapshot,config,snap_anchor.selected.time)):\\\\n            ledger.add('13.5',outcome.status=='pass',outcome.reason,(i,),outcome.status=='unknown')\\\\n    if snapshot:\\\\n        if snapshot.txt is None or not snapshot.txt.rr: ledger.fault('13.6','DNS_EVIDENCE_MISSING',unknown=True)\\\\n        else:\\\\n            owner=(b'_tessera-v1',)+tuple(commons[0]['issuer'].encode().split(b'.')) if commons else None\\\\n            if owner is not None: owner_ok=ledger.add('13.6',snapshot.txt.owner==owner,'DNS_OWNER',(0,))\\\\n            else: owner_ok=True\\\\n            # TXT grammar is independent of authenticated DNSSEC and available frames.\\\\n            dns_value=ledger.run('13.6',txt_value,[r.data for r in snapshot.txt.rr],tie=(1,))\\\\n    if snap_anchor.selected and declared is not None:\\\\n        ledger.add('13.7',declared-86400<=snap_anchor.selected.time<=declared+259200 and snap_anchor.selected.confirmed<=declared+259200,'SNAPSHOT_TIME')\\\\n    commit=raw.get('git.commit'); parsed_commit=ledger.run('14.1',parse_commit,commit) if commit is not None else None\\\\n    sig=ledger.run('14.2',dearmor,parsed_commit[2]) if parsed_commit else None\\\\n    trees=[raw.get('git.trees.'+str(i)) for i in range(2)]; parsed_trees=[]\\\\n    for i,tree in enumerate(trees): parsed_trees.append(ledger.run('14.3',parse_tree,tree,tie=(i,)) if tree is not None else None)\\\\n    blob=raw.get('git.blob'); path_ok=False\\\\n    if commit is not None or any(tree is not None for tree in trees) or blob is not None:\\\\n        # Row 14.4 via the owner-pinned SHA-1DC (sha1dc.py; operator hook 2026-10-14).\\\\n        # Without the pinned detector: explicit residual; never pretend hashlib implements SHA-1DC.\\\\n        if not sha1dc.available(): ledger.fault('14.4','INDEPENDENT_SHA1DC_UNAVAILABLE',unknown=True)\\\\n        else:\\\\n            for i,(kind,body) in enumerate([('commit',commit),('tree',trees[0]),('tree',trees[1]),('blob',blob)]):\\\\n                if body is None: continue\\\\n                try: ledger.add('14.4',not sha1dc.collision(kind,body),'GIT_SHA1_COLLISION',(i,))\\\\n                except sha1dc.Unavailable: ledger.fault('14.4','INDEPENDENT_SHA1DC_UNAVAILABLE',(i,),unknown=True)\\\\n    if parsed_commit and all(tree is not None for tree in parsed_trees) and blob is not None:\\\\n        ledger.run('14.5',verify_path,parsed_commit[0],trees,blob); path_ok=ledger.checks[-1].status=='pass'\\\\n    stamped=(object_id('commit',commit)+'\\\\\\\\n').encode() if commit is not None else None\\\\n    git_anchor=anchor_checks(ledger,'14.6',raw.get('git.ots'),stamped,headers,pins,'git')\\\\n    if parsed_commit and sig is not None and git_anchor.usable:\\\\n        states=[]\\\\n        for e in config['repository_keys']:\\\\n            if e['domain']==config['issuer_domain'] and signature_verifies(parsed_commit[1],sig,e['_public']): states.append(interval(e,git_anchor.selected.time,utc(config['as_of'])))\\\\n        if 'pass' in states: ledger.add('14.7',True,'')\\\\n        elif 'horizon' in states: ledger.fault('14.7','TRUST_HORIZON',unknown=True)\\\\n        elif 'outside' in states: ledger.fault('14.7','GIT_SIGNER_OUTSIDE_INTERVAL')\\\\n        else: ledger.fault('14.7','GIT_SIGNER_NOT_CONFIGURED',unknown=True)\\\\n    if receipt.selected and git_anchor.selected:\\\\n        ledger.add('14.8',git_anchor.selected.height+5<receipt.selected.height,'GIT_NOT_PRECOMMITTED')\\\\n    if dns_value and manifest:\\\\n        for i,slot in enumerate(SLOTS): ledger.add('15.1',dns_value[slot]==fps[i].split(':')[1],'DNS_KEY_MISMATCH',(i,))\\\\n    if dns_value and path_ok: ledger.add('15.2',blob==dns_value['_raw'],'CHANNEL_VALUE_MISMATCH')\\\\n    if dns_value and declared is not None and receipt.selected:\\\\n        ledger.add('16.1',declared>=dns_value['_start'] and receipt.selected.time<=dns_value['_end'],'ISSUANCE_WINDOW')\\\\n    for i,co in enumerate(commons):\\\\n        for j,(member,target) in enumerate([('spec',co['spec']['sha256']),('vectors',co['vectors_sha256']),('preamble',co['preamble_sha256'])],1):\\\\n            if member in raw: ledger.add('17.'+str(j),shahex(raw[member])==target,'BUNDLE_OBJECT_HASH',(i,))\\\\n        if entries[i] and 'dependency_manifest' in raw:\\\\n            ledger.add('17.4',shahex(raw['dependency_manifest'])==entries[i]['dependency_manifest_sha256'],'BUNDLE_OBJECT_HASH',(i,))\\\\n    result=ledger.report(t)\\\\n    return (result,ledger) if diagnostics else result\\\\n\\\\ndef main():\\\\n    parser=argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument('--trust',required=True); parser.add_argument('--bundle',required=True); parser.add_argument('--catalog')\\\\n    args=parser.parse_args()\\\\n    try:\\\\n        demand(sys.version_info[:2]==(3,14),'RUNTIME_UNSUPPORTED')\\\\n        demand(unicodedata.unidata_version==release.UNICODE_VERSION,'UNICODE_TABLES_UNSUPPORTED')\\\\n        trust=Path(args.trust).read_bytes()\\\\n        demand(release.TRUST_SHA256 is not None and shahex(trust)==release.TRUST_SHA256,'TRUST_CONFIG_UNAUTHENTICATED')\\\\n        config=parse_trust(trust)\\\\n        demand(release.UNICODE_MODULE_SHA256 is not None and shahex(Path(getattr(unicodedata,'__file__',sys.executable)).read_bytes())==release.UNICODE_MODULE_SHA256,'UNICODE_TABLES_UNSUPPORTED')\\\\n        catalog_raw=Path(args.catalog).read_bytes() if args.catalog else release.CATALOG_BYTES\\\\n        demand(catalog_raw is not None and shahex(catalog_raw)==release.CATALOG_SHA256,'CATALOG_UNAUTHENTICATED')\\\\n        catalog=parse_catalog(catalog_raw)\\\\n        # Bound the read, not just the later parse.\\\\n        with open(args.bundle,'rb') as f: bundle=f.read(2**27+1)\\\\n        print(jcs(verify_bundle(bundle,config,catalog)).decode())\\\\n        return 0\\\\n    except Fault as e: print(e.code,file=sys.stderr); return 2\\\\n    except OSError as e: print('INPUT_IO_ERROR: '+str(e),file=sys.stderr); return 2\\\\nif __name__=='__main__': raise SystemExit(main())\\\\n\\\",\\\"tests/test_hybrid.py\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Independent synthetic hybrid tests; no project vectors or other implementations.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport copy\\\\nimport hashlib\\\\nimport subprocess\\\\nimport sys\\\\nimport tempfile\\\\nimport unittest\\\\nfrom pathlib import Path\\\\nfrom unittest.mock import Mock\\\\n\\\\nfrom fixtures import make_fixture,enc,sign,stamp\\\\nimport codec\\\\nfrom codec import ALG,Fault,b64,frame,jcs,parse_signature,public_key,read_anchor,shahex,signature_verifies,utc\\\\nfrom policy import parse_catalog,parse_trust\\\\nfrom verify import verify_bundle\\\\nfrom cryptography.hazmat.primitives import serialization\\\\nfrom cryptography.hazmat.primitives.asymmetric import ec,mldsa\\\\nimport sha1dc\\\\n\\\\nPAIR='KMS-MLDSA65-PURE-GPG-OPENPGP4-ECDSA-P256-SHA256'\\\\nPREFIX=bytes.fromhex('308207b2300b0609608648016503040312038207a100')\\\\nPOSITIVE=('VALID_STRICT','OK') if sha1dc.available() else ('UNVERIFIABLE','INDEPENDENT_SHA1DC_UNAVAILABLE')\\\\n\\\\ndef evaluate(b,t,c):\\\\n    return verify_bundle(jcs(b),parse_trust(jcs(t)),parse_catalog(jcs(c)),diagnostics=True)\\\\n\\\\ndef faults(ledger): return [(c.row,c.reason) for c in ledger.checks if c.status in ('invalid','unknown')]\\\\n\\\\ndef anchor_bytes(items):\\\\n    raw=b'\\\\\\\\x1d'+b'tessera-v1/receipt-anchor-sig'+b'\\\\\\\\x02'\\\\n    for document,signature in items:\\\\n        raw+=len(document).to_bytes(4,'big')+document+len(signature).to_bytes(4,'big')+signature\\\\n    return raw\\\\n\\\\nclass HybridCodecTests(unittest.TestCase):\\\\n    def code(self,expected,fn,*args):\\\\n        with self.assertRaises(Fault) as cm: fn(*args)\\\\n        self.assertEqual(cm.exception.code,expected)\\\\n\\\\n    def test_raw_length_only_codec_and_slot_rules(self):\\\\n        # Every 3309-byte string is codec-valid, including invalid FIPS encodings.\\\\n        for raw in (bytes(3309),b'\\\\\\\\xff'*3309):\\\\n            self.assertEqual(parse_signature(raw,PAIR,'kms'),raw)\\\\n        for n,reason in ((0,'SIG_EMPTY'),(1,'SIG_FORMAT'),(3308,'SIG_FORMAT'),(3310,'LENGTH_CAP'),(6618,'LENGTH_CAP')):\\\\n            self.code(reason,parse_signature,bytes(n),PAIR,'kms')\\\\n        key=ec.generate_private_key(ec.SECP256R1()); packet=sign(key,b'frame')\\\\n        self.assertIsInstance(parse_signature(packet,PAIR,'gpg'),codec.Signature)\\\\n        self.code('SIG_FORMAT',parse_signature,packet,PAIR,'kms')\\\\n        self.code('LENGTH_CAP',parse_signature,bytes(3309),PAIR,'gpg')\\\\n        self.code('LENGTH_CAP',parse_signature,bytes(3309),ALG,'kms')\\\\n        self.assertIsNone(parse_signature(b'x'*3310,'UNKNOWN','kms'))\\\\n        self.code('LENGTH_CAP',parse_signature,bytes(65537),'UNKNOWN','kms')\\\\n\\\\n    def test_exact_spki_and_parameter_sets(self):\\\\n        key=mldsa.MLDSA65PrivateKey.generate().public_key()\\\\n        der=key.public_bytes(serialization.Encoding.DER,serialization.PublicFormat.SubjectPublicKeyInfo)\\\\n        self.assertEqual(der,PREFIX+key.public_bytes_raw())\\\\n        self.assertEqual(public_key(der,'kms',PAIR).public_bytes_raw(),key.public_bytes_raw())\\\\n        self.code('KEY_FORMAT',public_key,der,'kms',ALG)\\\\n        variants=[der[:-1],der+b'x',der[22:],b'-----BEGIN PUBLIC KEY-----',\\\\n                  der[:21]+b'\\\\\\\\x01'+der[22:],der[:14]+b'\\\\\\\\x11'+der[15:],\\\\n                  bytes.fromhex('308207b4300d06096086480165030403120500038207a100')+der[22:],\\\\n                  bytes.fromhex('30830707b2300b0609608648016503040312038207a100')+der[22:],\\\\n                  b'\\\\\\\\x30\\\\\\\\x80'+der[4:]+b'\\\\\\\\x00\\\\\\\\x00']\\\\n        for kind in (mldsa.MLDSA44PrivateKey,mldsa.MLDSA87PrivateKey):\\\\n            variants.append(kind.generate().public_key().public_bytes(serialization.Encoding.DER,serialization.PublicFormat.SubjectPublicKeyInfo))\\\\n        variants.append(codec.SPKI+b'\\\\\\\\x04'+bytes(64))\\\\n        for raw in variants:\\\\n            with self.subTest(length=len(raw)): self.code('KEY_FORMAT',public_key,raw,'kms',PAIR)\\\\n        # All raw 1952-byte strings have well-formed pkDecode fields.\\\\n        for raw in (bytes(1952),b'\\\\\\\\xff'*1952):\\\\n            self.assertEqual(public_key(PREFIX+raw,'kms',PAIR).public_bytes_raw(),raw)\\\\n\\\\n    def test_anchor_lengths_and_each_frames_own_codec(self):\\\\n        b,_,_=make_fixture(hybrid=True)\\\\n        frames=read_anchor(b64(b['layers'][0]['a_sig']))\\\\n        items=[(f[0],f[2]) for f in frames]\\\\n        for n,reason in ((0,'SIG_EMPTY'),(3308,'SIG_FORMAT'),(3310,'LENGTH_CAP')):\\\\n            self.code(reason,read_anchor,anchor_bytes([(items[0][0],bytes(n)),items[1]]))\\\\n        self.code('TRUNCATED',read_anchor,anchor_bytes(items)[:len(items[0][0])+45])\\\\n        # The second frame's classical id selects rule O despite the first's R.\\\\n        second=copy.deepcopy(frames[1][1]); second['common']['alg']=ALG\\\\n        mixed=[items[0],(frame('tessera-v1/attest',jcs(second)),items[1][1])]\\\\n        self.assertIsInstance(read_anchor(anchor_bytes(mixed))[1][3],codec.Signature)\\\\n        self.code('SIG_PACKET',read_anchor,anchor_bytes([items[0],(mixed[1][0],b'\\\\\\\\xc2\\\\\\\\x00')]))\\\\n\\\\n    def test_pure_empty_context_external_mu_and_wrong_modes(self):\\\\n        key=mldsa.MLDSA65PrivateKey.generate(); pub=public_key(PREFIX+key.public_key().public_bytes_raw(),'kms',PAIR)\\\\n        document=frame('tessera-v1/manifest',b'{}')+b'x'*5000\\\\n        tr=hashlib.shake_256(key.public_key().public_bytes_raw()).digest(64)\\\\n        mu=hashlib.shake_256(tr+b'\\\\\\\\x00\\\\\\\\x00'+document).digest(64)\\\\n        signatures=[key.sign(document,context=b''),key.sign_mu(mu)]\\\\n        for sig in signatures:\\\\n            self.assertTrue(signature_verifies(document,parse_signature(sig,PAIR,'kms'),pub))\\\\n            self.assertFalse(signature_verifies(document+b'x',sig,pub))\\\\n            self.assertFalse(signature_verifies(mu,sig,pub))\\\\n        # FIPS 204 Algorithm 4: HashML-DSA with SHA-256's DER OID.\\\\n        wrong_hash_message=b'\\\\\\\\x01\\\\\\\\x00'+bytes.fromhex('0609608648016503040201')+hashlib.sha256(document).digest()\\\\n        bad=[key.sign(document,context=b'tessera-v1'),key.sign(mu),\\\\n             key.sign_mu(hashlib.shake_256(tr+document).digest(64)),\\\\n             key.sign_mu(hashlib.shake_256(tr+wrong_hash_message).digest(64))]\\\\n        for sig in bad: self.assertFalse(signature_verifies(document,sig,pub))\\\\n\\\\n    def test_strict_encoding_before_backend_verification(self):\\\\n        # A permissive backend must never accept malformed hint or z encodings.\\\\n        backend=Mock(); backend.verify.return_value=None\\\\n        z=int.from_bytes(b'\\\\\\\\x00'*3200,'little')\\\\n        for i in range(1280): z|=(1<<19)<<(20*i)  # coefficients zero\\\\n        base=bytes(48)+z.to_bytes(3200,'little')+bytes(61)\\\\n        self.assertTrue(signature_verifies(b'frame',base,backend))\\\\n        variants=[]\\\\n        for indices,counts in ((b'\\\\\\\\x07\\\\\\\\x07',[2]*6),(b'\\\\\\\\x08\\\\\\\\x07',[2]*6),(b'',[56]*6),(b'\\\\\\\\x07\\\\\\\\x08',[2,1,2,2,2,2])):\\\\n            variants.append(base[:3248]+indices+bytes(55-len(indices))+bytes(counts))\\\\n        variants.append(base[:3248]+b'\\\\\\\\x01'+bytes(60))  # nonzero unused padding\\\\n        for coefficient in ((1<<19)-196,-((1<<19)-196)):\\\\n            bits=(z&~((1<<20)-1))|((1<<19)-coefficient)\\\\n            variants.append(bytes(48)+bits.to_bytes(3200,'little')+bytes(61))\\\\n        variants.extend([base[:-1],base+b'x'])\\\\n        backend.verify.reset_mock()\\\\n        for sig in variants:\\\\n            with self.subTest(tail=sig[-61:].hex()): self.assertFalse(signature_verifies(b'frame',sig,backend))\\\\n        backend.verify.assert_not_called()\\\\n        # Same index in different polynomials is legal; per-polynomial order only.\\\\n        legal=base[:3248]+b'\\\\\\\\x07\\\\\\\\x07'+bytes(53)+bytes([1,2,2,2,2,2])\\\\n        self.assertTrue(signature_verifies(b'frame',legal,backend))\\\\n\\\\nclass HybridProfileTests(unittest.TestCase):\\\\n    def test_complete_hybrid_and_fingerprint(self):\\\\n        b,t,c=make_fixture(hybrid=True,common_overrides={'content':{'large':'x'*5000}})\\\\n        result,ledger=evaluate(b,t,c)\\\\n        self.assertEqual((result['verdict'],result['reason']),POSITIVE)\\\\n        self.assertEqual(result['T'],'2026-10-14T12:00:00Z')\\\\n        self.assertEqual(faults(ledger),[] if sha1dc.available() else [('14.4',POSITIVE[1])])\\\\n        frames=read_anchor(b64(b['layers'][0]['a_sig']))\\\\n        self.assertGreater(len(frames[0][0]),4096)\\\\n        self.assertEqual(frames[0][1]['signer']['key_fp'],'spki-sha256:'+shahex(b64(b['layers'][0]['keys']['kms'])))\\\\n        self.assertTrue(all(any(c.row==row and c.status=='pass' for c in ledger.checks) for row in ('5.1','5.2','9.2','9.5')))\\\\n\\\\n    def test_wrong_installation_skips_key_and_signature_semantics(self):\\\\n        for hybrid in (False,True):\\\\n            b,t,c=make_fixture(hybrid=hybrid); c['entries'][0]['alg']=ALG if hybrid else PAIR\\\\n            for bad_keys in (False,True):\\\\n                sample=copy.deepcopy(b)\\\\n                if bad_keys: sample['layers'][0]['keys']={'kms':enc(b'bad key'),'gpg':enc(b'bad key')}\\\\n                result,ledger=evaluate(sample,t,c)\\\\n                self.assertEqual((result['verdict'],result['reason']),('UNVERIFIABLE','ALG_UNKNOWN'))\\\\n                self.assertFalse(any(c.row in ('5.1','5.2','9.1','9.2','9.4','9.5') for c in ledger.checks))\\\\n                self.assertEqual(result['T'],'2026-10-14T12:00:00Z')\\\\n\\\\n    def test_unknown_algorithm_skips_semantics_but_keeps_independent_checks(self):\\\\n        b,t,c=make_fixture(common_overrides={'alg':'UNKNOWN'},manifest_overrides={'alg':'UNKNOWN'})\\\\n        b['layers'][0]['keys']={'kms':enc(b'bad'),'gpg':enc(b'bad')}\\\\n        b['layers'][0]['possession']={'kms':enc(b'opaque'),'gpg':enc(b'opaque')}\\\\n        result,ledger=evaluate(b,t,c)\\\\n        self.assertEqual((result['verdict'],result['reason']),('UNVERIFIABLE','ALG_UNKNOWN'))\\\\n        self.assertFalse(any(c.row in ('5.1','5.2','9.1','9.2','9.4','9.5') for c in ledger.checks))\\\\n        b['layers'][0]['spec']=enc(b'wrong object')\\\\n        result,_=evaluate(b,t,c); self.assertEqual((result['verdict'],result['reason']),('INVALID','BUNDLE_OBJECT_HASH'))\\\\n\\\\n    def test_unselected_codec_known_id_still_enforces_its_codec(self):\\\\n        for hybrid in (False,True):\\\\n            b,t,c=make_fixture(hybrid=hybrid); c['entries'][0]['alg']=ALG if hybrid else PAIR\\\\n            b['layers'][0]['possession']['kms']=enc(bytes(3308) if hybrid else b'\\\\\\\\xc2\\\\\\\\x00')\\\\n            result,_=evaluate(b,t,c)\\\\n            self.assertEqual((result['verdict'],result['reason']),('INVALID','SIG_FORMAT' if hybrid else 'SIG_PACKET'))\\\\n        b,t,c=make_fixture(hybrid=True,kms_signer=lambda k,d:bytes(3308)); c['entries'][0]['alg']=ALG\\\\n        result,ledger=evaluate(b,t,c)\\\\n        self.assertEqual(result['reason'],'SIG_FORMAT'); self.assertIn(('3.1','SIG_FORMAT'),faults(ledger))\\\\n\\\\n    def test_supported_key_format_precedes_fingerprint(self):\\\\n        for hybrid in (False,True):\\\\n            b,t,c=make_fixture(hybrid=hybrid); b['layers'][0]['keys']['kms']=enc(b'bad')\\\\n            result,_=evaluate(b,t,c); self.assertEqual(result['reason'],'KEY_FORMAT')\\\\n        b,t,c=make_fixture(hybrid=True)\\\\n        other=mldsa.MLDSA65PrivateKey.generate().public_key()\\\\n        b['layers'][0]['keys']['kms']=enc(PREFIX+other.public_bytes_raw())\\\\n        result,_=evaluate(b,t,c); self.assertEqual(result['reason'],'KEY_MISMATCH')\\\\n        b,t,c=make_fixture(); b['layers'][0]['keys']['kms']=enc(PREFIX+other.public_bytes_raw())\\\\n        result,_=evaluate(b,t,c); self.assertEqual(result['reason'],'KEY_FORMAT')\\\\n\\\\n    def test_supported_unknown_spec_still_verifies(self):\\\\n        b,t,c=make_fixture(hybrid=True); c['entries'][0]['spec_sha256']=shahex(b'other spec')\\\\n        result,ledger=evaluate(b,t,c)\\\\n        self.assertEqual(result['reason'],'SPEC_UNKNOWN')\\\\n        self.assertTrue(all(any(c.row==row and c.status=='pass' for c in ledger.checks) for row in ('5.1','9.2','9.5')))\\\\n\\\\n    def test_internal_malformation_is_verification_not_codec_failure(self):\\\\n        def duplicate(k,d):\\\\n            s=k.sign(d); return s[:3248]+b'\\\\\\\\x07\\\\\\\\x07'+bytes(53)+bytes([2]*6)\\\\n        for possession in (False,True):\\\\n            kwargs={'kms_possession_signer':duplicate} if possession else {'kms_signer':duplicate}\\\\n            b,t,c=make_fixture(hybrid=True,**kwargs); result,ledger=evaluate(b,t,c)\\\\n            self.assertEqual(result['reason'],'POSSESSION_INVALID' if possession else 'SIG_INVALID')\\\\n            self.assertFalse(any(row in ('3.1','9.3') for row,_ in faults(ledger)))\\\\n\\\\n    def test_wrong_context_and_mode_receipt_and_possession(self):\\\\n        def hash_mode(k,d):\\\\n            representative=b'\\\\\\\\x01\\\\\\\\x00'+bytes.fromhex('0609608648016503040201')+hashlib.sha256(d).digest()\\\\n            tr=hashlib.shake_256(k.public_key().public_bytes_raw()).digest(64)\\\\n            return k.sign_mu(hashlib.shake_256(tr+representative).digest(64))\\\\n        for possession in (False,True):\\\\n            for signing in (lambda k,d:k.sign(d,context=b'tessera-v1'),lambda k,d:k.sign_mu(hashlib.shake_256(hashlib.shake_256(k.public_key().public_bytes_raw()).digest(64)+d).digest(64)),hash_mode):\\\\n                kwargs={'kms_possession_signer':signing} if possession else {'kms_signer':signing}\\\\n                b,t,c=make_fixture(hybrid=True,**kwargs); result,_=evaluate(b,t,c)\\\\n                self.assertEqual(result['reason'],'POSSESSION_INVALID' if possession else 'SIG_INVALID')\\\\n\\\\n    def test_another_valid_signature_still_fails_original_anchor(self):\\\\n        alternative=[]\\\\n        def capture(k,d):\\\\n            alternative.append(k.sign(d)); return k.sign(d)\\\\n        b,t,c=make_fixture(hybrid=True,kms_signer=capture)\\\\n        frames=read_anchor(b64(b['layers'][0]['a_sig']))\\\\n        self.assertNotEqual(alternative[0],frames[0][2])\\\\n        b['layers'][0]['a_sig']=enc(anchor_bytes([(frames[0][0],alternative[0]),(frames[1][0],frames[1][2])]))\\\\n        result,ledger=evaluate(b,t,c)\\\\n        self.assertEqual(result['reason'],'RECEIPT_ANCHOR_MISMATCH'); self.assertIsNone(result['T'])\\\\n        self.assertFalse(any(row=='9.2' for row,_ in faults(ledger)))\\\\n\\\\n    def test_both_slot_possession_proofs_bind_exact_manifest(self):\\\\n        b,t,c=make_fixture(hybrid=True)\\\\n        frames=read_anchor(b64(b['layers'][0]['a_sig']))\\\\n        for i,slot in enumerate(('kms','gpg')):\\\\n            sample=copy.deepcopy(b); sample['layers'][0]['possession'][slot]=enc(frames[i][2])\\\\n            result,_=evaluate(sample,t,c)\\\\n            self.assertEqual(result['reason'],'POSSESSION_INVALID')\\\\n\\\\n    def test_mixed_pair_common_values_rejected(self):\\\\n        b,t,c=make_fixture(hybrid=True,gpg_common_overrides={'alg':ALG})\\\\n        result,_=evaluate(b,t,c); self.assertEqual(result['reason'],'RECEIPT_COMMON_MISMATCH')\\\\n\\\\n    def test_hybrid_cli_installed_catalog(self):\\\\n        directory=Path(__file__).resolve().parents[1]; constants=directory/'release_constants.py'; original=constants.read_bytes()\\\\n        try:\\\\n            with tempfile.TemporaryDirectory(dir=directory) as temporary:\\\\n                root=Path(temporary); b,t,c=make_fixture(hybrid=True)\\\\n                for name,obj in (('bundle',b),('trust',t),('catalog',c)): (root/(name+'.json')).write_bytes(jcs(obj))\\\\n                build=subprocess.run([sys.executable,str(directory/'build_release.py'),'--trust',str(root/'trust.json'),'--catalog',str(root/'catalog.json')],capture_output=True)\\\\n                self.assertEqual(build.returncode,0,build.stderr.decode())\\\\n                command=[sys.executable,str(directory/'verify.py'),'--trust',str(root/'trust.json'),'--bundle',str(root/'bundle.json')]\\\\n                for suffix in ([],['--catalog',str(root/'catalog.json')]):\\\\n                    run=subprocess.run(command+suffix,capture_output=True)\\\\n                    self.assertEqual(run.returncode,0,run.stderr.decode())\\\\n                    result=codec.parse_json(run.stdout.strip(),canonical=True)\\\\n                    self.assertEqual((result['verdict'],result['reason']),POSITIVE); self.assertEqual(len(result),6)\\\\n        finally: constants.write_bytes(original)\\\\n\\\",\\\"REPORT.md\\\":\\\"# Independent V1 verifier instrument report\\\\n\\\\nDate: 2026-10-14. Status: implemented differential instrument with explicit\\\\nfail-closed gaps; **not a fully conformant positive V1 verifier**.\\\\n\\\\n**Current hybrid follow-up:** the instrument now implements the requested\\\\ncandidate supplement's rule R and exact ML-DSA-65 SPKI, catalog branch selection,\\\\nand profile §8 EA-31. See the final addendum for current validation and source\\\\nhashes. Earlier dated build results below are retained as history, not current\\\\nfallback-only limitations. No dated hybrid registration is asserted.\\\\n\\\\nAll added code, tests, examples, documentation and the local Python environment\\\\nare under "'`prototype/indep-verifier/`. No other Tessera implementation,'"\\\\nformal model, vector file or independent-verifier review was read or imported.\\\\nThe three authorized documents supplied the requirements, with Amendment 9\\\\nas governor. Workflow skill instructions were consulted separately; they were\\\\nnot normative implementation evidence. No memory files were read.\\\\n\\\\n## Outcome and material limitations\\\\n\\\\nThe requested CLI exists:\\\\n\\\\n"'```sh'"\\\\npython verify.py --trust TRUST_CONFIG --bundle BUNDLE [--catalog CATALOG]\\\\n"'```'"\\\\n\\\\nIt prints the exact six stable fields as canonical JSON after successful\\\\nstartup. T is determined independently of unrelated checks. INVALID dominates\\\\nUNVERIFIABLE, and the reported reason follows the expanded §15.7 row order,\\\\nthen each row's tie order. No network is used at verification time.\\\\n\\\\nThere are **60 expanded numbered check ids** in the implementation ledger.\\\\n59 have executable checks; **14.4 is explicitly unperformable** because a\\\\npinned SHA-1DC implementation/version is not supplied in these normative\\\\ninputs. Ordinary SHA-1 is used only to reconstruct the proposed links and\\\\nstamp target; it never establishes collision detection. With obtainable git\\\\nobjects this build contributes the visible instrument-specific reason\\\\n"'`INDEPENDENT_SHA1DC_UNAVAILABLE`. Accordingly **a complete otherwise valid'"\\\\nbundle returns UNVERIFIABLE, never VALID_STRICT, in this build**. This prevents\\\\nunsafe acceptance but also prevents testing honest positive V1 acceptance.\\\\nIt does not meet the registered false-reject bar and is not C-row discharge.\\\\n\\\\nActual authenticated trust configuration, frozen catalog/spec/vector hashes,\\\\nrelease authentication, final hybrid registration, and official pinned UCD /\\\\nECMA dependency artifacts are not furnished by the allowed sources. These are\\\\nbuild/release inputs, not policy to infer from bundles. The checked-in release\\\\nis unprovisioned and refuses to emit a verdict until explicit local instrument\\\\nprovisioning. That step does not prove release authenticity or custody.\\\\n\\\\n**AMBIGUITIES count: 18**, A01–A18 in [AMBIGUITIES.md](AMBIGUITIES.md), including\\\\nmissing normative build inputs and explicit choices where rejection mapping\\\\nor framing remains underdetermined. They are instrument readings, not new\\\\nTessera decisions. Their implemented locations and normative locators are\\\\nlisted there.\\\\n\\\\n## Check-table coverage\\\\n\\\\n\\\\\\\"Implemented\\\\\\\" means code exists and the synthetic complete evidence path was\\\\nexercised; it does not mean every rejection combination has been covered or\\\\nthat conformance has been discharged.\\\\n\\\\n| Check ids | Implementation | Evidence / limitations |\\\\n|---|---|---|\\\\n| 1.1–1.4 | Strict dispatch, size cap, profile, one layer, strict request only | Malformed JSON and unsigned dispatch tests; API accepts an explicit request input, CLI requests strict |\\\\n| 2.1–2.4 | JCS, member absence under typed parents, descriptor exceptions, closed recursive container schema | Noncanonical JSON, numeric member, missing git, null parent/descriptor, unsupported descriptor and malformed optional diagnostics |\\\\n| 3.1 | Exact A_sig tag/count/slot lengths, per-frame JSON/schema, per-slot codec | Classical: O/O; candidate pair: R/O (3309/1024); others opaque. Known unselected ids retain their own codecs |\\\\n| 4.1–4.2 | Manifest frame/schema and each common manifest digest | Synthetic possession and tuple path; altered digest/manifest alg tests |\\\\n| 5.1–5.2 | Installed-spec SPKI/v4 bodies and SHA-256 fingerprints, gated by catalog support (EA-31) | Fallback: explicit P-256 point validation. Candidate hybrid kms: exact 1974-byte ML-DSA-65 SPKI; every raw 1952-byte key well formed. Unsupported ids skip these rows |\\\\n| 6.1–6.3 | Slot fingerprints, common byte identity, issuer/alg manifest equalities | Independently signed disagreeing common content and tuple mismatch tests; equal canonical common bytes are exact substrings by the closed frame grammar |\\\\n| 7.1 | Single catalog-supported algorithm, separate from codec routing | Unknown id with codec-valid opaque signatures yields ALG_UNKNOWN; no invented hybrid id |\\\\n| 8.1–8.5 | Pinned issuer, spec id/catalog lookup, catalog object hashes, binding forms | Pinned-domain and binding-form tests; unknown spec with independently valid/invalid bundled objects |\\\\n| 9.1–9.5 | Rule-O policy/hash prefix/ECDSA; pure empty-context ML-DSA-65 over exact frame/manifest; strict FIPS gates | Unsupported ids retain possession codec only. Bad raw internals become SIG_INVALID / POSSESSION_INVALID; rule R has no OpenPGP policy |\\\\n| 10.1–10.3 | All supplied header pins, coverage, consecutive links | Conflicting pin, unused unpinned header, nonmonotone times and complete three-proof pool |\\\\n| 11.1–11.5 | Closed OTS wire parser and bounds; digest; all contradicted branches; lowest qualifying height; selected-height tx/OP_RETURN/merkle suffix and txid | Depth 256/257, ops 65536/65537, attestations 4096/4097, shortest LEB128, non-32-byte Bitcoin message, payload trailing data; digest/txid and incomplete unselected branch tests |\\\\n| 12.1–12.3 | Inclusive three-conjunct receipt timing with frozen ε/δ/k | Each individual failure tested; confirmation time may precede T |\\\\n| 13.1–13.7 | Snapshot envelope/cap; wire body and recovery skeleton; global wildcard restriction; own OTS shape; DNSSEC root/non-root candidate aggregation; fifteen-step TXT codec; snapshot conjuncts | Root-only/omitted groups, metadata and selector mismatches, parent-blocked local math, extra invalid root witness in either order, open horizon and finalized reliance, serial wrap/ambiguity/reversal, snapshot c3; algorithm 13 plus RSA 8, DS 2 plus 4 |\\\\n| 14.1–14.3 | Closed signed commit, dearmor/CRC/codec/policy, canonical tree parser | Synthetic signed P-256 commit and parser boundary tests |\\\\n| **14.4** | **Unperformable; no SHA-1DC detector** | **Explicit fail-closed reason, prevents complete-bundle acceptance** |\\\\n| 14.5–14.8 | SHA-1 commit→root→subtree→blob path, signed-id OTS target, repository interval/horizon, h_git+5<h_receipt | Positive git time later than both declared and receipt T still passes its implemented checks; later-height git proof rejects GIT_NOT_PRECOMMITTED |\\\\n| 15.1–15.2 | Manifest fingerprints match TXT, git blob byte-equal to TXT | Full synthetic dual-channel authority tuple, with no framing bytes on blob |\\\\n| 16.1 | Declared≥not-before and T≤not-after, inclusive; no T≥not-before test | Both exact boundaries and one-second violations; DNS window >90 days fails before this row |\\\\n| 17.1–17.4 | Raw spec/vectors/preamble bytes to each signed hash, dependency bytes to known catalog only | Independent object failure dominates missing evidence / unknown spec; unknown catalog entry never supplies a dependency-manifest comparison target |\\\\n\\\\n"'`policy.py` implements §15.5'"'s closed trust configuration, canonical numbers as\\\\nstrings, unique/sorted entries, DNSKEY and DS cross-checks, public-key checks,\\\\nopen/finalized periods and pins. The explicit local build enforces the compiled\\\\nhash allowlist and embeds the independently supplied catalog. Its optional\\\\nprevious-config check enforces the append-only key/period/pin invariants without\\\\nmaking the runtime fetch previous state. Runtime enforces Unicode 16.0.0 and\\\\nan instrument-pinned implementation binary; equivalence to unpublished official\\\\nUCD digests has not been established.\\\\n\\\\nDNSSEC candidate outcomes are aggregated once per required RRset. Eligible\\\\nsupported candidates dominate failing extras; root horizon precedes finalized\\\\ninterval/time/crypto failures. Non-root aggregation separately considers\\\\nabsence, selector-matching unsupported paths, locally valid but parent-blocked\\\\npaths and the ordered failing-candidate classes. Candidate ordering is the\\\\nG35 tuple, not transport order. Global wildcard and body-framing restrictions\\\\nremain independent of candidate eligibility.\\\\n\\\\n## Validation\\\\n\\\\nEnvironment used: CPython 3.14.6, Unicode 16.0.0, cryptography 50.0.2, in the\\\\nlocal "'`.venv`. cryptography'"'s packaged dependencies were installed there;\\\\nno global package installation was performed.\\\\n\\\\nCommand:\\\\n\\\\n"'```sh'"\\\\n.venv/bin/python -m unittest discover -s tests -v\\\\n"'```'"\\\\n\\\\nResult: **61 tests pass**. One test additionally exercises **180 seeded\\\\nmalformed binary-member mutations**. Parser tests were initially run against\\\\nmissing modules and failed; discovered selector, global-wildcard, RSA-width\\\\nand CLI/runtime issues were reproduced before their corrections.\\\\n\\\\nThe tests generate independent P-256 signatures, a delegated DNSSEC snapshot,\\\\na signed git commit with raw trees/blob, three distinct non-witness Bitcoin\\\\ntransactions and OTS operation paths, and synthetic pinned headers. A complete\\\\nfixture yields 145 passing subchecks, one explicit unperformable SHA-1DC check,\\\\nand no blocked expanded rows. These headers are fabricated test inputs, not\\\\nmainnet evidence or a timestamp claim.\\\\n\\\\nThe CLI is exercised in subprocesses with embedded and explicit catalog routes,\\\\ncanonical stable output, unpinned config refusal and no stdout verdict on\\\\nstartup failure. Tests restore the original release constants after temporary\\\\nlocal provisioning. "'`examples/` is a reviewable synthetic bundle/config/catalog;'"\\\\n[README.md](README.md) gives the commands to use it. Private keys are not saved.\\\\n\\\\n## Known gaps and non-demonstrations\\\\n\\\\n- Mandatory SHA-1DC is not implemented. This is the sole explicit unperformable\\\\n  check on the complete fallback fixture, and a material limitation.\\\\n- The hybrid supplement remains a draft in these inputs. Its requested candidate\\\\n  codecs/semantics are implemented and independently tested, without asserting\\\\n  dated registration, freeze authenticity or real deployed-signer evidence.\\\\n- Local hash provisioning is not an authenticated Tessera release. Release-key\\\\n  custody, bootstrap/rotation/recovery and actual archival trust sources remain\\\\n  external assumptions and open owner work.\\\\n- Unicode/ECMA implementation behavior is pinned for the instrument; no agreement\\\\n  run against the future official dependency manifest or frozen P8 vectors was\\\\n  performed. The repository vectors were deliberately not read.\\\\n- Tests cover the grammar families and representative mixed outcomes, not all\\\\n  candidate combinations, every table rejection code, every resource-size edge,\\\\n  all historical time endpoints or real mainnet/DNSSEC fixtures. There is no\\\\n  differential comparison against another Tessera implementation in this run.\\\\n- Spec, vectors, purpose preamble and dependency objects are hashed as raw bytes,\\\\n  never interpreted or executed as policy. No freeze object assembler or archival\\\\n  source-validation service is claimed; runtime does not need either to hash a\\\\n  presented object against independently frozen values.\\\\n- A9's issuer clock policy, custody, public publication, non-overlap of successive\\\\n  receipts, release signing and the human safe-decision test are not verifier\\\\n  checks. No result here establishes them.\\\\n\\\\nA T printed with INVALID is not evidence of a valid service receipt. A later\\\\npresented proof may cause ISSUANCE_WINDOW; request the original issuer proof.\\\\nThe verifier does not establish public publication of the git assertion.\\\\nRevocation and historical security remain NOT_EVALUATED; standing is\\\\nABSENT/NOT_ISSUED_IN_PROFILE.\\\\n\\\\n## Normative-source record\\\\n\\\\nOnly these Tessera artifacts supplied requirements (byte hashes below identify\\\\nthis reading's working-tree snapshot, not a signed freeze):\\\\n\\\\n- "'`docs/phase-0-prereg-amendment-9.md`: SHA-256 `ff09f9b1ff6bb717bcca2c2f803eb8674f4beb2d28e88d5718320fe9b63c9f05`.'"\\\\n- "'`docs/V1-PROFILE.md`: SHA-256 `493e72a89675da4d4aaa0bf318fd0c8690b4d947448f6118fdd7c96bbdea7316`.'"\\\\n- "'`formal/p8/ENCODING-V1.md`: SHA-256 `d9ea82eb3e893fef865f124a612ecb6784932ea131559d792be8f01e597eb5ec`.'"\\\\n\\\\nExternal references consulted: [RFC 4034](https://www.rfc-editor.org/rfc/rfc4034), [RFC 4035](https://www.rfc-editor.org/rfc/rfc4035), [RFC 1982](https://www.rfc-editor.org/rfc/rfc1982), [RFC 9580](https://www.rfc-editor.org/rfc/rfc9580.txt), and the profile-cited [RFC 3110](https://www.rfc-editor.org/rfc/rfc3110.txt), [RFC 5702](https://www.rfc-editor.org/rfc/rfc5702.txt), [RFC 6605](https://www.rfc-editor.org/rfc/rfc6605.txt); [OpenTimestamps serialization reference](https://github.com/opentimestamps/python-opentimestamps/blob/master/opentimestamps/core/serialize.py); Bitcoin [transaction](https://developer.bitcoin.org/reference/transactions.html) and [header](https://developer.bitcoin.org/reference/block_chain.html) formats. Git signature documentation endpoints were attempted; the implemented closed grammar and object-id preimages come directly from the authorized profile and encoding document. External dependencies do not override the profile's supported-path restrictions.\\\\n\\\\n## Addendum 2026-10-14: SHA-1DC hook (operator change, not by the independent builder)\\\\n\\\\nOwner decision 2026-10-14 pinned the normative SHA-1DC detector: github.com/cr-marcstevens/sha1collisiondetection\\\\nat commit "'`a06f1adbe5522f3c939cd6a3f13d5ec7f4c1a988`, vendored under `prototype/vendor/sha1collisiondetection/`'"\\\\n(pin record and detector demonstration: "'`prototype/vendor/SHA1DC-PIN.md`). This supplies the input whose absence'"\\\\nA04 recorded; it is the only change to this instrument's verification logic for the differential run, and it\\\\nimplements no reading of the profile.\\\\n\\\\n- New "'`sha1dc.py`: runs the pinned `sha1dcsum` (binary SHA-256 pinned locally) on stdin over the git-framed bytes'"\\\\n  "'`'"\\\\\\\"<type> <len>\\\\\\\\0\\\\\\\" ‖ body"'` and returns the detector'"'s prescribed collision return ("'`*coll*` marker).'"\\\\n- "'`verify.py` row 14.4: when the pinned binary is present, each present object (tie order commit, root tree, sub'"\\\\n  tree, blob) contributes pass or "'`INVALID / GIT_SHA1_COLLISION` (profile §15.4, §15.7 row 14.4). If the pinned'"\\\\n  binary is absent or a detector call fails, the original "'`UNVERIFIABLE / INDEPENDENT_SHA1DC_UNAVAILABLE` remains.'"\\\\n  Ids for row 14.5 are still computed with hashlib SHA-1; they equal SHA-1DC's output whenever 14.4 passes.\\\\n- Tests: "'`tests/test_verifier.py` now expects `VALID_STRICT / OK` for the complete synthetic bundle when the'"\\\\n  detector is built (the old expectation otherwise), plus one test that the hook frames commit, both trees and the\\\\n  blob and maps a detection to "'`GIT_SHA1_COLLISION`. 62 tests pass.'"\\\\n- Consequence: the statements above that \\\\\\\"a complete otherwise valid bundle returns UNVERIFIABLE, never\\\\n  VALID_STRICT\\\\\\\" and \\\\\\\"14.4 is explicitly unperformable\\\\\\\" no longer hold when the pinned detector is built; A04 is\\\\n  resolved by the owner pin. Note that SHAttered's raw collision is detected but the same file git-framed as a blob\\\\n  is not (the header misaligns its blocks), so no available fixture exercises a positive detection end to end.\\\\n\\\\n## Addendum 2026-10-14: independent diff-1 corrections\\\\n\\\\nRead the revised profile only, plus this instrument's own code and tests; no\\\\nconformance, differential or other implementation source was read. A lightweight\\\\nmemory-registry search found no verifier-specific guidance and supplied no\\\\nimplementation evidence. The initial report's no-memory statement describes\\\\nits original build. All edits in this follow-up remain within this directory.\\\\nProfile snapshot SHA-256:\\\\n"'`89eb8d50c660163133e2c658dd1158ac8ec54a832a3dd9d752ed4f143a57cb0a`.'"\\\\n\\\\n- §15.3 point 3, OWNER diff-1 F-1: inspect RRSIG signer-name bytes during body\\\\n  parsing. Observable uppercase ASCII or compression pointers now reject as\\\\n  INVALID / SNAPSHOT_FORMAT before witness aggregation, even beside a valid\\\\n  witness. Other malformed supported RDATA remains candidate-local.\\\\n- Coverage, OWNER diff-1 F-3: row-2.4-invalid headers already were excluded by\\\\n  schema extraction. Added regression tests for invalid heights and malformed\\\\n  values, including selected receipt, snapshot and git heights. Remaining\\\\n  entries determine anchor availability and T; invalid entries contribute only\\\\n  CONTAINER_SCHEMA and cannot introduce pin/coverage/link failures.\\\\n- G35: malformed RRSIG sorting now preserves independently readable tag,\\\\n  inception, expiration and signature fields. Only unavailable fields fall back\\\\n  to zero/empty, followed by raw RDATA and key RDATA. The same extraction is\\\\n  used for malformed-candidate failure ordering at root and non-root groups.\\\\n  The previously used all-zero tuple could reject correctly serialized bodies.\\\\n\\\\nValidation: "'`.venv/bin/python -m unittest discover -s tests -q`:'"\\\\n**66 tests passed**, including four new regression methods. Before the fixes,\\\\nnoncanonical signer tests demonstrated acceptance beside a valid witness and\\\\nthree readable-field ordering cases rejected correctly sorted bodies. Header\\\\nregressions passed before any production change. A12 is now owner-resolved;\\\\nA06 records the corrected per-field fallback. No differential comparison was\\\\nrun in this follow-up, and no conformance or discharge claim is made.\\\\n\\\\n## Addendum 2026-10-14: requested hybrid branch and EA-31\\\\n\\\\nAll reads for this change were confined to this instrument's own files, the four\\\\nauthorized Tessera specifications below, and "'`prototype/differential/ADAPTER.md`'"\\\\nfor the CLI/catalog interface. External normative references consulted were\\\\n[FIPS 204](https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.204.pdf) and\\\\n[RFC 9881](https://www.rfc-editor.org/rfc/rfc9881.html). The permitted third-party\\\\ncryptography API was inspected in the instrument's existing local environment.\\\\nNo conformance code, differential code, formal vectors, other implementation\\\\nsource, review/decision files linked from the supplement, or memory files were\\\\nread. All edits and temporary provisioning artifacts stayed within this directory.\\\\n\\\\n**Behavior.** The codec registry contains the exact pair id\\\\n"'`KMS-MLDSA65-PURE-GPG-OPENPGP4-ECDSA-P256-SHA256`, alongside the classical id.'"\\\\nEach slot uses its own frame's alg and slot. For pair/kms, rule R accepts exactly\\\\n3309 raw bytes without inspecting them: zero is SIG_EMPTY, shorter nonzero is\\\\nSIG_FORMAT, longer is LENGTH_CAP. Pair/gpg still uses rule O with cap 1024.\\\\nOther ids retain the opaque codec and cap 65536. Codec checks apply even to an\\\\nunselected known branch.\\\\n\\\\nThe catalog independently selects semantic support; unknown spec lookup does\\\\nnot alter algorithm selection. Key format and fingerprint binding run only for\\\\ncatalog-supported receipt slots (EA-31). Hybrid kms requires exactly the\\\\nsupplement's 22-byte prefix followed by 1952 raw key bytes: DER SPKI with\\\\nid-ml-dsa-65, absent parameters and zero unused bits, total 1974. Every raw\\\\n1952-byte key is well formed. The fingerprint is "'`spki-sha256:` plus lowercase'"\\\\nhex SHA-256 of the entire exact SPKI. Supported fallback receipts still reject\\\\nML-DSA SPKI as KEY_FORMAT. Unsupported algorithms skip key format/binding,\\\\nsignature policy/math and possession policy/math, contributing ALG_UNKNOWN;\\\\nindependent schema, codecs, manifest/common equalities and hashes still run.\\\\nHonest fallback/hybrid receipts shown to the other installation are\\\\nUNVERIFIABLE / ALG_UNKNOWN, with no KEY_FORMAT contribution.\\\\n\\\\nRule R verifies pure ML-DSA-65, explicit empty context, over exact "'`F` or'"\\\\n"'`F_manifest`; no prehash, trailer, normalization, received μ or signing-mode'"\\\\ninput is accepted. Before the backend, independent FIPS gates enforce bounded\\\\nnondecreasing hint counts, strictly increasing indices within each polynomial\\\\n(duplicates rejected), zero unused hint padding and "'`|z| < 2''^19 − 196`.'"\\\\nThe backend performs the lattice verification. Internal defects become\\\\nSIG_INVALID / POSSESSION_INVALID, preserving the length-only codec. Rule R's\\\\nOpenPGP-policy rows pass vacuously; rule O and repository signing remain classical.\\\\n\\\\n**K-R is an assumption, not a verifier check.** The kms key is dedicated to\\\\nV1 attest/manifest frames, pure mode, empty context; the issuer computes μ using\\\\nthis key's raw public key and uses EXTERNAL_MU for both operations. Exclusive\\\\nkey use and the issuer/IAM restriction cannot be inferred from a receipt.\\\\nRAW and EXTERNAL_MU signatures over the same frame are indistinguishable to\\\\nverification; this instrument certifies neither the signing API path nor IAM.\\\\nK-O remains the separate gpg key-use assumption. Neither is discharged here.\\\\n\\\\n**Interpretation record.** A03 is superseded. A14–A18 in AMBIGUITIES.md record\\\\ndraft-versus-requested codec registration scope, unsupported codec-versus-semantic\\\\nevaluation, per-slot/missing-receipt prerequisites, raw policy-row mapping, and\\\\ncatalog provisioning/unknown-spec behavior. The fixed crypto parameters, SPKI,\\\\nfingerprint and K-R status were explicit, not guesses. The draft remains a draft;\\\\ncompiling its codecs does not date or authenticate registration.\\\\n\\\\n**Validation.** Existing environment: CPython 3.14.6, Unicode 16.0.0,\\\\n**cryptography 50.0.2**, packaged backend **OpenSSL 4.0.3 (29 Sep 2026)**.\\\\nThe existing "'`requirements.txt` already pins cryptography 50.0.2; no dependency'"\\\\ninstallation or pin change was needed. The local owner-pinned SHA-1DC hook was\\\\navailable during this run; its implementation was neither inspected nor changed.\\\\n\\\\n"'```sh'"\\\\n.venv/bin/python -m unittest discover -s tests -v\\\\n"'```'"\\\\n\\\\nResult: **83 tests pass**, comprising the prior 66 and **17 new hybrid methods**.\\\\nThe first new-test run failed (11 assertion failures, 3 errors) on missing\\\\nhybrid codec/key/verification behavior and unconditional key evaluation; after\\\\nimplementation all pass. Tests independently generate ML-DSA/P-256 keys,\\\\nexternal-μ signatures over frames larger than 4096 bytes, signatures over the\\\\nmanifest, and the existing synthetic DNS/git/OTS evidence. Both selected\\\\nbranches pass; both wrong-installation directions give ALG_UNKNOWN. The hybrid\\\\nCLI passes with embedded and explicit catalog routes, with release constants\\\\nrestored after testing.\\\\n\\\\nRejections cover exact raw length boundaries within anchors and possession,\\\\nwrong slot codec, exact SPKI alternatives (P-256/44/87, NULL parameters,\\\\nunused bits, DER length defects, bare/PEM/truncated/trailing), mismatched\\\\nfingerprints, wrong frames/manifests, nonempty context, HashML-DSA/SHA-256,\\\\nmissing "'`00 00` in μ, strict hints/padding/counts/z, unknown spec, independent'"\\\\nhash failure under unknown alg, mixed pair ids, and another valid signature\\\\nfailing the original anchored tuple. A permissive mock backend confirms every\\\\nstrict encoding gate stops verification before the library is called; repeated\\\\nindices across different polynomials remain allowed. Malformed hints also fail\\\\nthe complete receipt/possession paths with the required codes.\\\\n\\\\nThis is independently authored profile/codec evidence, using one shared\\\\nthird-party crypto backend for test signing and verification. It is not two\\\\nindependent ML-DSA implementations, FIPS certification, a real KMS capture,\\\\ndifferential agreement, formal discharge, or proof of all V1 conformance.\\\\nThe retained release-authentication and frozen-dependency limitations still apply.\\\\n\\\\nSource snapshot SHA-256 (working-tree bytes, not signing/freeze hashes):\\\\n\\\\n| Authorized source | SHA-256 |\\\\n|---|---|\\\\n| "'`docs/phase-0-prereg-amendment-9.md` | `ff09f9b1ff6bb717bcca2c2f803eb8674f4beb2d28e88d5718320fe9b63c9f05` |'"\\\\n| "'`docs/V1-PROFILE.md` | `78dc6be38384895092829424fca8a3cd871910cdf9c35f43620899bbd5780519` |'"\\\\n| "'`formal/p8/ENCODING-V1.md` | `d9ea82eb3e893fef865f124a612ecb6784932ea131559d792be8f01e597eb5ec` |'"\\\\n| "'`formal/p8/HYBRID-SUPPLEMENT-DRAFT.md` | `4e8e675326ed59e0af43e6f5372f17db14ca0504b533cb3bb7325e88fca8549f` |'"\\\\n\\\",\\\"AMBIGUITIES.md\\\":\\\"# Ambiguities and missing normative inputs\\\\n\\\\nThese are instrument readings, not owner decisions or amendments. A9 governs.\\\\nNo bundled object supplies policy. The numbered rows are §15.7 check ids;\\\\n"'`startup` identifies checks that refuse to emit a verdict.'"\\\\n\\\\n| # | Check id | Question | Reading implemented (fail closed) | File:line |\\\\n|---|---|---|---|---|\\\\n| A01 | startup | §5/§14.2 supplies no authenticated release/config hash or release-signature format. What configuration is authorized? | The checked-in release is unprovisioned and refuses every config. An explicit local build pins a caller-selected, schema-checked config; this is instrument provisioning, never proof of release authenticity. There is no runtime auto-trust or bundle override. | "'`release_constants.py:2`; `build_release.py:9`; profile §5, §14.2 items 1–3 |'"\\\\n| A02 | 7.1, 8.3–8.4, 17.4 / startup | The catalog's values are listed, but neither its wire schema nor its actual frozen bytes/hashes exists. How is "'`--catalog` encoded/authenticated? | A closed canonical JSON `tessera-v1-independent-catalog/1` with exactly one entry and the fields in `policy.CAT_KEYS`; constants must match the profile. Its exact bytes are independently build-pinned and embedded. An external catalog must match that digest, never self-authorize. No catalog is silently fabricated from the bundle. | `policy.py:59`; `release_constants.py:3`; profile §1, §14.2 item 7 |'"\\\\n| A03 | 3.1, 5.1, 7.1, 9 | Originally no assigned pair id, mode/context or SPKI supplement was available. Which hybrid id is codec-known? | Superseded for this requested hybrid instrument by the supplied supplement §§1–3: the exact classical id and exact pair id are codec-known. The external installation catalog selects semantic support. This is candidate-supplement support, not proof of dated registration; see A14. Every other syntactically valid id remains opaque with unperformable semantics. | "'`codec.py:CODEC_ALGS`, `signature_rule`; `verify.py:verify_bundle`; profile §1, §8; supplement §§1–3 |'"\\\\n| A04 | 14.4 | §15.4 requires a pinned SHA-1DC implementation/version/return behavior, but §14.2 item 15 explicitly says these are not supplied. Which detector is normative? | Do not replace SHA-1DC with ordinary SHA-1. Every obtainable git object contributes "'`UNVERIFIABLE / INDEPENDENT_SHA1DC_UNAVAILABLE`; other independent checks continue. This instrument-only reason is a visible extension because the table has no code for this missing build dependency. No complete in-profile bundle can return VALID_STRICT in this build. | `verify.py:251`; profile §15.4, §14.2 item 15 |'"\\\\n| A05 | startup, 2.1, 3.1, 4.1 | The Unicode 16.0.0 UCD digests and ECMA edition are not yet furnished (§9/§14.2 item 15). How can implementation tables be identified? | Require Python 3.14's Unicode version to be exactly 16.0.0 and explicitly build-pin the local unicodedata binary (the interpreter executable if built in); a different runtime refuses. Implement the profile's explicit ES recipe independently. This pins instrument behavior, not agreement with an absent official UCD digest or future frozen vectors. | "'`codec.py:60`; `verify.py:285`; `build_release.py:9` |'"\\\\n| A06 | 13.2, 13.5 | A supported malformed RRSIG with fewer than two bytes has no obtainable Type Covered for body grouping. Where does it belong? | Attach to the immediately preceding same-owner group when possible, or a root DNSKEY discriminator if no preceding group exists, then classify as DNSSEC_FORMAT. Impossible transitions remain SNAPSHOT_FORMAT. Only individually unobtainable sort fields fall back to zero/empty; readable tag, inception, expiration and signature are retained, with raw RDATA as serialization tie. Valid candidates dominate malformed extras except global wildcard and noncanonical-name restrictions. | "'`dnssec.py:78`; `dnssec.py:110`; profile §15.3, §6.1 |'"\\\\n| A07 | 13.3 | Does the global no-wildcard restriction apply when Labels is readable but the rest of the RRSIG is malformed? | Yes. Read Labels independently whenever four RDATA bytes exist; fewer Labels rejects even if the rest cannot parse or another witness validates. | "'`dnssec.py:93`; profile §15.3 point 4, §6.1 r2-F07 |'"\\\\n| A08 | 13.5, 14.7 | r2-F04 explicitly names *finalized* interval failures, leaving a verifying open entry evaluated before signing_start without a listed interval class. | An authenticated candidate before signing_start is INVALID / KSK_OUTSIDE_RELIANCE_PERIOD or GIT_SIGNER_OUTSIDE_INTERVAL, including open entries; only a time later than as_of and not before start is TRUST_HORIZON. | "'`dnssec.py:189`; profile §5, §6.3 |'"\\\\n| A09 | 14.1 | Commit author/committer fields are "'`<bytes>` without a minimum length. Are empty values admitted? | Require a nonempty value after each literal header prefix. Empty values reject as GIT_COMMIT_FORMAT. Names, addresses, clocks and other contents remain uninterpreted. | `git_channel.py:21`; profile §15.4 |'"\\\\n| A10 | 2.1, 2.4 | The container prohibits all JSON numbers, but §2.1 JCS precedes schema and dispatch explicitly inspects only JSON categories 1–5. How are otherwise syntactic numbers classified? | Dispatch admits syntactic number tokens; the container schema rejects every numeric value. JCS spelling is separately checked first. A non-finite numeric conversion makes the canonical check fail as JSON_NONCANONICAL, not OUT_OF_PROFILE. Signed payloads still use the full value-preserving number rule. | "'`codec.py:86`; `verify.py:144`; profile §3.1, §15.1 |'"\\\\n| A11 | 9.1, 9.4 | §8 places ECDSA r/s range under its rule-O policy list without separately mapping out-of-range codec-valid MPIs to a reason. | Treat r/s outside [1,n−1] as SIG_POLICY, before signature mathematics. Zero fails the codec's exact MPI bit-count rule as SIG_FORMAT. | "'`codec.py:227`; profile §8 |'"\\\\n| A12 | 13.2, 13.5 | §15.3 requires canonical embedded names but also routes malformed supported RRSIG RDATA to DNSSEC_FORMAT. Is an uppercase/compressed signer name a body or candidate defect? | Resolved by OWNER 2026-10-14, diff-1 F-1: uppercase ASCII or compression pointers inside the signer name are globally SNAPSHOT_FORMAT, even beside a valid witness. Other malformed supported RRSIG RDATA remains candidate-local DNSSEC_FORMAT. | "'`dnssec.py:canonical_signer`; profile §15.3 point 3, diff-1 F-1 |'"\\\\n| A13 | 13.5 | Does a supported RSA signature with a wrong octet width fail format or mathematics? | Enforce the modulus-sized PKCS#1 signature width, reporting DNSSEC_FORMAT before mathematics. RSA key encoding and 512–4096-bit size limits follow RFC 3110/5702; no leading-zero key octets are accepted. | "'`dnssec.py:172`; profile §6.1; RFC 5702 §3, RFC 3110 §2 |'"\\\\n\\\\nNormative locators: A01—"'`docs/V1-PROFILE.md:340`; A02/A03—`docs/V1-PROFILE.md:98`; A04—`docs/V1-PROFILE.md:1271`; A05—`docs/V1-PROFILE.md:927`; A06/A07/A12—`docs/V1-PROFILE.md:1206`; A08—`docs/V1-PROFILE.md:432`; A09/A13—`docs/V1-PROFILE.md:1251`; A10—`docs/V1-PROFILE.md:1131`; A11—`docs/V1-PROFILE.md:824`.'"\\\\n\\\\n## Follow-up 2026-10-14: diff-1\\\\n\\\\nA12's earlier candidate-local reading is superseded by the explicit owner F-1\\\\nrule; the row above records the resolved reading. A06's all-zero fallback is\\\\ncorrected to preserve each readable G35 field. F-3 under Coverage resolves\\\\nheader participation: an entry failing row 2.4 contributes CONTAINER_SCHEMA\\\\nonly and is absent from the shared pool used by rows 10.x, 11.x, 13.4 and 14.6.\\\\nThe existing schema extraction already implements that rule. These corrections\\\\nadd no new unresolved ambiguity.\\\\n\\\\n## Follow-up 2026-10-14: requested hybrid support and EA-31\\\\n\\\\nThe exact id, 3309-byte length/cap and length error order, pure mode with empty\\\\ncontext, 1974-byte SPKI prefix and SHA-256 fingerprint, and K-R's status as an\\\\nassumption are explicit in supplement §§1–4. They required no guessed crypto\\\\nparameters or key encoding. FIPS 204 Algorithms 3, 8, 21 and 27 supply the\\\\nverification/strict-decoding rules; RFC 9881 §§2,4 supplies the SPKI conventions.\\\\n\\\\nThe following records every integration point requiring an instrument reading\\\\nof the draft/profile or reconciliation of overlapping text. These are visible\\\\nimplementation choices, not new owner decisions. A03's former fallback-only\\\\nreading and unconditional key-format evaluation are superseded.\\\\n\\\\n| # | Check id | Question / tension | Reading implemented | Location and source |\\\\n|---|---|---|---|---|\\\\n| A14 | 3.1, 7.1 / build | The supplied supplement still says DRAFT/not registered and profile §1 EA-09 says the pair remains opaque before dated registration, but the user explicitly requests hybrid support and a codec-known unselected id. No registration-state interface is provided. | Compile both exact codecs into this requested candidate instrument. The independently provisioned catalog selects the supported branch; there is no runtime registration-date inference, bundle override or claim that registration occurred. A14 describes the scope of this instrument; it does not turn the draft into a registered artifact. | "'`codec.py:CODEC_ALGS`; supplement status, §§1,7; profile §1 r2-F01/EA-09; current user instruction |'"\\\\n| A15 | 3.1, 9.3 versus 5.x, 9.1–9.2, 9.4–9.5 | EA-31 says unsupported signatures and possession are not evaluated, while r2-F01 requires their own codecs and row 9.3 lists only presence as its prerequisite. | Interpret non-evaluation as semantic non-evaluation. Receipt codec and possession codec still run, including known unselected ids; unsupported key parsing, fingerprint binding, signature policy/math and possession policy/math do not run. Codec-invalid bytes still contribute INVALID and independent schema/hash checks still run. | "'`verify.py:verify_bundle`; `codec.py:parse_signature`, `read_anchor`; profile §1 r2-F01, §8 EA-31, §15.7 rows 3.1/9.3 |'"\\\\n| A16 | 5.1–5.2, 7.1 | Row 7.1 follows key rows in reporting order but is their new prerequisite. What if common algorithms differ or receipt decoding fails? | Determine support from each decoded slot's own "'`common.alg` and the installation catalog before key evaluation. Use the selected installation id for supported-slot keys. Skip the other slot'"'s key semantics; common/manifest equality still rejects independently. If no receipt decodes, row 7.1 is unavailable and both key rows stay blocked; a manifest alone cannot authorize a key-format check. Reporting order remains unchanged. | "'`verify.py:verify_bundle`; profile §8 EA-31, §15.7 rows 5.1/5.2/6.2/6.3/7.1; supplement §5 |'"\\\\n| A17 | 9.1, 9.4 and 9.2, 9.5 | The profile has policy rows for both signatures, but the §8 policy is explicitly rule O and supplement §2 sends malformed ML-DSA internals to verification failure. | Raw rule R has no additional OpenPGP policy, so these policy rows pass vacuously for codec-valid rule R. Strict hint counts/order/duplicates/padding and z bound run at mathematical verification, before the backend, and map to SIG_INVALID / POSSESSION_INVALID. No internal FIPS decoding defect becomes SIG_POLICY or a codec failure. | "'`codec.py:sig_policy`, `mldsa65_encoding_valid`, `signature_verifies`; profile §8, §15.7; supplement §2 and decision 3 |'"\\\\n| A18 | 7.1, 8.3 / build | The draft/profile provides no actual frozen hybrid catalog bytes, hashes or new installation transport. Does support depend on bundled spec lookup or inferred registration? | Retain A02's one-entry authenticated/provisioned catalog interface, including ADAPTER.md's existing mapping; its alg selects support independently of the bundled spec hash lookup. Thus a selected known alg can still undergo semantics with SPEC_UNKNOWN. A syntactically valid catalog alg without compiled semantics cannot manufacture support. The checked-in release remains unprovisioned, and no real frozen catalog is fabricated. | "'`policy.py:parse_catalog`; `build_release.py`; `verify.py:verify_bundle`; profile §1, §14.2; supplement §§1,9; allowed differential ADAPTER.md interface |'"\\\\n\\\\nK-R is recorded in REPORT.md, not implemented as a check: receipt bytes cannot\\\\nestablish exclusive issuer/IAM key use, EXTERNAL_MU use at signing, or the\\\\nabsence of signatures in other protocols. No assumption failure code is invented.\\\\n\\\",\\\"README.md\\\":\\\"# Independent V1 verifier instrument\\\\n\\\\nThis is differential-testing code under A9.2, not a service verifier and not\\\\nC-row discharge evidence. Read [REPORT.md](REPORT.md) and\\\\n[AMBIGUITIES.md](AMBIGUITIES.md) before interpreting its results.\\\\n\\\\n**This build cannot return VALID_STRICT for a complete bundle:** the required\\\\npinned SHA-1DC detector is not supplied by the allowed normative inputs. Row\\\\n14.4 is explicitly unperformable. The distributed release is also deliberately\\\\nunprovisioned: no real trust configuration or frozen catalog was provided.\\\\n\\\\n## Local environment and tests\\\\n\\\\nFrom this directory:\\\\n\\\\n"'```sh'"\\\\npython3.14 -m venv .venv\\\\n.venv/bin/python -m pip install --no-cache-dir -r requirements.txt\\\\n.venv/bin/python -m unittest discover -s tests -v\\\\nsource .venv/bin/activate\\\\n"'```'"\\\\n\\\\nNo global installation is required. Python must be 3.14 and its Unicode tables\\\\nmust report 16.0.0. The local build also binds the Unicode implementation\\\\nbinary (the executable when unicodedata is built in).\\\\n\\\\n## Interface\\\\n\\\\nProvisioning is a separate, explicit instrument build step:\\\\n\\\\n"'```sh'"\\\\npython build_release.py --trust TRUST_CONFIG --catalog CATALOG\\\\npython verify.py --trust TRUST_CONFIG --bundle BUNDLE\\\\npython verify.py --trust TRUST_CONFIG --bundle BUNDLE --catalog CATALOG\\\\n"'```'"\\\\n\\\\nThe builder validates and embeds the catalog and pins both input hashes in\\\\n"'`release_constants.py`. It does not sign a release or establish independent'"\\\\nrelease-key custody. An external "'`--catalog` must match the compiled hash.'"\\\\nTrust-config schema is the profile's exact §15.5 schema. Catalog transport is\\\\nthe explicitly documented instrument reading A02; see "'`policy.CAT_KEYS` and'"\\\\n"'`examples/catalog.json`. Nothing supplied by a bundle changes policy.'"\\\\n\\\\nThe catalog's single "'`alg` selects classical or candidate hybrid support. Both'"\\\\nexact ids remain codec-known even when unselected. The pair's kms slot uses\\\\n3309-byte raw ML-DSA-65, pure mode with empty context, and the exact 1974-byte\\\\nSPKI; gpg retains rule O. Unsupported receipt algorithms skip key and signature\\\\nsemantics (EA-31), contributing "'`UNVERIFIABLE / ALG_UNKNOWN`; independent'"\\\\ncodecs and other checks still apply. Draft/registration interpretation and K-R's\\\\nassumption status are recorded in the hybrid addenda to REPORT and AMBIGUITIES.\\\\n\\\\nOptionally pass "'`--previous-trust PRIOR_CONFIG` to the builder to check the'"\\\\nappend-only transition. The runtime never retrieves prior configs.\\\\n\\\\nAfter successful startup the CLI prints exactly one canonical JSON object with\\\\n"'`T`, `historical_security`, `reason`, `revocation`, `standing`, `verdict`.'"\\\\nINVALID and UNVERIFIABLE are normal verdicts (exit 0). Startup and I/O refusals\\\\nuse exit 2, stderr and **no stdout verdict**. There is no network access.\\\\n\\\\n## Synthetic demonstration\\\\n\\\\n"'`examples/` contains generated public inputs with fabricated Bitcoin headers'"\\\\nand trust pins. These are parser/logic fixtures, never historical evidence.\\\\nTo regenerate them and provision a disposable local instrument:\\\\n\\\\n"'```sh'"\\\\npython generate_example.py\\\\npython build_release.py --trust examples/trust.json --catalog examples/catalog.json\\\\npython verify.py --trust examples/trust.json --bundle examples/bundle.json\\\\n"'```'"\\\\n\\\\nExpected reason: "'`INDEPENDENT_SHA1DC_UNAVAILABLE`, with the fixture'"'s receipt T.\\\\nUnit tests temporarily provision generated release bindings and restore the\\\\noriginal constants in "'`finally`; they do not bind your instrument to their'"\\\\nrandom test keys. Test signatures and keys are generated locally, without any\\\\nTessera fixture/implementation imports. Private keys are not written.\\\\n\\\\n## Reading the result\\\\n\\\\nA T reported with INVALID is not evidence of a valid service receipt. An\\\\nISSUANCE_WINDOW failure can arise from presenting a later proof: request the\\\\nissuer's original proof. The verifier cannot establish public publication of\\\\nthe git commit. It does not evaluate revocation or historical key/algorithm\\\\nsafety, nor submitter identity, payload truth, priority, renewal or standing.\\\\n\\\",\\\"release_constants.py\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Unprovisioned instrument. Set only by the explicit build_release.py step.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nTRUST_SHA256 = None\\\\nCATALOG_SHA256 = None\\\\nCATALOG_BYTES = None\\\\nUNICODE_VERSION = '16.0.0'\\\\nUNICODE_MODULE_SHA256 = None\\\\n# No pinned SHA-1DC implementation was furnished by the normative inputs.\\\\nSHA1DC_AVAILABLE = False\\\\n\\\"}\")
