+        ('issuer',['a.b','0.1','a'*63+'.'+'b'*63+'.'+'c'*63+'.'+'d'*49,'a'*63+'.'+'b'*63+'.'+'c'*63+'.'+'d'*50,'a'*64+'.b','-a.b','a.b.']),
