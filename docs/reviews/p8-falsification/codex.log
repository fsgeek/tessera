+    key=ec.derive_private_key(d,ec.SECP256R1()).public_key()
+    r=ec.derive_private_key(k,ec.SECP256R1()).public_key().public_numbers().x % n
+    s=pow(k,-1,n)*(z1+r*d)%n; z2=(-z1-2*r*d)%n
+    der=utils.encode_dss_signature(r,s)
