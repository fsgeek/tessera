+        count['pairs']+=1
+        # Type-aware equality is recovered by decoding tagged JSON representations here.
+        for x in (v,w):
+            raw=B.jcs(x);a,b=payload(raw)
+            assert a[0]==b[0]=='OK',(raw,a[0],b[0])
+            assert B.jcs(a[1])==I.jcs(b[1])==raw
+            count['payload_roundtrips']+=1
+        def typed(x):
