+    obj=B.frame_decode(f0,'attest');raw=B.jcs(obj)
+    fr=I.frame('tessera-v1/attest',b'\xef\xbb\xbf'+raw+b'\xff')
+    show('precedence-frame-BOM-invalid',*frame(fr))
