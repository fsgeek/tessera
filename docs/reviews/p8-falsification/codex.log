   278	def depth_of(t):
   279	    if isinstance(t, tuple) and t[0] in "OA":
   280	        kids = [v for _, v in t[1]] if t[0] == "O" else t[1]
   281	        return 1 + max([depth_of(v) for v in kids] or [0])
   282	    return 0
