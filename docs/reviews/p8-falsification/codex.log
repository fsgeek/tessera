    74	            step=decimal.Decimal(10)**(exponent-k+1)
    75	            nearest=int((exact/step).to_integral_value(rounding=decimal.ROUND_HALF_EVEN))
    76	            for i in (nearest-1,nearest,nearest+1):
    77	                if i>0:
    78	                    candidate=decimal.Decimal(i)*step
    79	                    if float(candidate)==value:
    80	                        candidates.append((abs(candidate-exact),i%2,candidate))
    81	            if candidates: break
    82	        demand(bool(candidates),'JSON_NUMBER')
    83	        d=min(candidates)[2].normalize()
    84	        digits=''.join(map(str,d.as_tuple().digits)); n=len(digits)+d.as_tuple().exponent; k=len(digits)
