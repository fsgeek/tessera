+    f0,s0,f1,s1 = [bytes.fromhex(byid['A-H1']['input'][k]) for k in ('f0_hex','s0_hex','f1_hex','s1_hex')]
+    malformed = B.anchor_encode(f0,b'x',f1,s1)
