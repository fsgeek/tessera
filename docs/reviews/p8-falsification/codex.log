   570	def sig_check(s, alg, slot):
   571	    r = rule_of(alg, slot)
   572	    if len(s) == 0:
   573	        raise Bad("SIG_EMPTY")
   574	    if len(s) > CAPS[r]:
   575	        raise Bad("LENGTH_CAP")
   576	    if r == "pgp4":
   577	        pgp4_parse(s)
   578	    if r == "mldsa65" and len(s) != 3309:
   579	        raise Bad("SIG_FORMAT")
