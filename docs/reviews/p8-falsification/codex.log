   285	def string_ok(s):
   286	    for ch in s:
   287	        c = ord(ch)
   288	        if 0xD800 <= c < 0xE000:
   289	            raise Bad("JSON_STRING", "surrogate")
   290	        if c in range(0xFDD0, 0xFDF0) or c % 0x10000 in (0xFFFE, 0xFFFF):
   291	            raise Bad("JSON_STRING", "noncharacter")
   292	        if unicodedata.category(ch) == "Cn":
   293	            raise Bad("JSON_STRING", "unassigned")
   294	    if unicodedata.normalize("NFC", s) != s:
   295	        raise Bad("JSON_STRING", "not NFC")
