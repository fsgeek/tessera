+      for v in json.loads((ROOT / 'formal/p8/vectors' / f).read_text())['vectors']]
+RS = [v for f in ('reject.json', 'hybrid-reject.json')
+      for v in json.loads((ROOT / 'formal/p8/vectors' / f).read_text())['vectors']]
+byid = {v['id']:v for v in GS}
+
+def outcome(fn):
+    try: return 'OK', fn()
