   137	## 5. P4 kept intact
   138	
   139	`run.sh` re-runs P4's committed configurations, unchanged, into `runs/p4-rerun/`. Every result matches the committed
   140	`.out` files:
   141	
   142	| Run | Result |
   143	|---|---|
   144	| main | GREEN, 1,944 distinct |
   145	| Sanity (`-continue`) | all four witnesses violated, 1,944 violation reports, the same as committed |
   146	| `_Broken` | RED `StrictMeansEverything` |
   147	| `_Broken_Green` | RED `NoSilentPromotion` |
   148	| `_Broken_Green2` | GREEN |
   149	
   150	*Harness note:* the first `SUMMARY.tsv` row for P4 Sanity said GREEN. That was a classifier bug: under `-continue`,
   151	TLC also prints "No error has been found". The row and `run.sh` were corrected; the raw output was always correct.
   152	
   153	## 6. Observations for the owner (no change made)
   154	
   155	1. **What counts as a "missing signature" in V1.** The model follows A9 C3 ("a missing, stripped or substituted
   156	   one fails") and spec V28: a required signature that is absent is `INVALID`. Here is what V1 does with absent
   157	   signature material:
   158	   - A signature stripped *inside* a present `a_sig` fails in the codec: `SIG_EMPTY` / `TRUNCATED`, `INVALID`. This
   159	     matches the model.
   160	   - An absent `possession.<slot>` member is `UNVERIFIABLE / MEMBER_MISSING` (F03-j). So is a wholly absent `a_sig`
   161	     member (profile §2.1 and the §15.1 closed schema; no conformance case exists for this).
   162	
   163	   The profile therefore classes those two absences as *missing evidence*. Both outcomes are fail-closed, so nothing
   164	   is falsely accepted. But whether they are consistent with C3's "fails" is the owner's reading to record. The
   165	   model does not decide it.
   166	2. **Companion count.** The derivation asked for three companions: the fail-open companion, the mixed case, and
   167	   missing-signature versus missing-evidence. They are FailOpen, UnknownDominates/UnknownAsOutOfProfile, and the
   168	   MissingSig/MissingEvidence pair. The other two (MalformedAsUnknown, DispatchFallthrough) test the "exactly one
   169	   case" boundary and the dispatch gate. They were cheap and are recorded as extras.
     1	#!/bin/bash
     2	# E6a run harness (STATUS: PROPOSED, 2026-10-19, AI collaborator).
     3	# Re-runnable: regenerates runs/ from the committed modules and cfgs.
     4	# TLC: ~/.local/lib/tla2tools.jar (2026.07.31), -workers 1 (deterministic
     5	# first violation). P4_VerifierStates.tla is found through TLA-Library and is
     6	# not copied or edited.
     7	set -u
     8	HERE="$(cd "$(dirname "$0")" && pwd)"
     9	TLA_DIR="$(cd "$HERE/.." && pwd)"
    10	JAR="${TLA2TOOLS:-$HOME/.local/lib/tla2tools.jar}"
    11	META="$(mktemp -d "${TMPDIR:-/tmp}/e6a-meta.XXXXXX")"
    12	RUNS="$HERE/runs"
    13	mkdir -p "$RUNS/main" "$RUNS/sanity" "$RUNS/broken" "$RUNS/matrix" "$RUNS/p4-rerun" "$RUNS/cfg"
    14	cd "$HERE" || exit 1
    15	
    16	tlc() { # tlc <out> <cfg> <module> [extra...]
    17	  local out=$1 cfg=$2 mod=$3; shift 3
    18	  java -XX:+UseParallelGC -DTLA-Library="$TLA_DIR" -cp "$JAR" tlc2.TLC \
    19	    -workers 1 -noGenerateSpecTE -metadir "$(mktemp -d "$META/m.XXXXXX")" "$@" \
    20	    -config "$cfg" "$mod.tla" > "$out" 2>&1
    21	}
    22	summ() { # one line: result | invariant | distinct states
    23	  local f=$1 r inv st
    24	  # Violations are checked first: under -continue TLC also prints "No error has been found".
    25	  if grep -q "Invariant .* is violated" "$f"; then r=RED
    26	    inv=$(grep -o "Invariant [A-Za-z0-9_]* is violated" "$f" | awk '{print $2}' | sort -u | paste -sd, -)
    27	  elif grep -q "Model checking completed. No error has been found." "$f"; then r=GREEN; inv=-
    28	  else r=ERROR; inv=-; fi
    29	  st=$(grep -o "[0-9]* distinct states" "$f" | tail -1)
    30	  echo "$r|$inv|${st:-n/a}"
    31	}
    32	
    33	INVS=$(awk '/^INVARIANTS/{f=1;next} f&&NF{print $1}' E6a_V1.cfg)
    34	WITS="NeverInStrict NeverInDegraded NeverInInvalid NeverOutOfProfile NeverAlgUnknown NeverUnknownOpaqueBadSig NeverMixedFailedUnknown NeverUnknownEmptySig NeverMissingSignature NeverMemberMissing NeverMissingEvPlusUnknown NeverDefectPlusMissingEv NeverWaivedAbsentDegraded"
    35	BROKEN="E6a_Broken_FailOpen E6a_Broken_MalformedAsUnknown E6a_Broken_MissingSigAsEvidence E6a_Broken_MissingEvidenceAsFail E6a_Broken_UnknownDominates E6a_Broken_UnknownAsOutOfProfile E6a_Broken_DispatchFallthrough"
    36	
    37	mkcfg() { # mkcfg <out> <inst V1|General> <invariant...>
    38	  local out=$1 inst=$2; shift 2
    39	  { awk '/^CONSTANTS/{f=1} /^INVARIANTS/{exit} f' "E6a_$inst.cfg"; echo "INVARIANTS"
    40	    for i in "$@"; do echo "  $i"; done; } > "$out"
    41	}
    42	
    43	SUMMARY="$RUNS/SUMMARY.tsv"
    44	echo -e "run\tmodule\tinstance\tinvariants\tresult\tred_on\tstates" > "$SUMMARY"
    45	rec() { local s; s=$(summ "$5" | tr "|" "\t"); printf "%s\t%s\t%s\t%s\t%s\n" "$1" "$2" "$3" "$4" "$s" >> "$SUMMARY"; }
    46	
    47	for inst in V1 General; do
    48	  # 1. Main: correct module, all invariants. Must be GREEN.
    49	  tlc "$RUNS/main/E6a_AlgVerdict_$inst.out" "E6a_$inst.cfg" E6a_AlgVerdict
    50	  rec main E6a_AlgVerdict "$inst" ALL "$RUNS/main/E6a_AlgVerdict_$inst.out"
    51	  # 2. Sanity witnesses, one run each. Healthy = RED (reachable).
    52	  for w in $WITS; do
    53	    mkcfg "$RUNS/cfg/sanity_${w}_$inst.cfg" "$inst" "$w"
    54	    tlc "$RUNS/sanity/${w}_$inst.out" "$RUNS/cfg/sanity_${w}_$inst.cfg" E6a_AlgVerdict
    55	    rec sanity E6a_AlgVerdict "$inst" "$w" "$RUNS/sanity/${w}_$inst.out"
    56	  done
    57	  # 3. Broken companions: all-invariants run (first violation), then one run
    58	  #    per invariant (the exact red/green matrix).
    59	  for b in $BROKEN; do
    60	    tlc "$RUNS/broken/${b}_$inst.out" "E6a_$inst.cfg" "$b"
    61	    rec broken-all "$b" "$inst" ALL "$RUNS/broken/${b}_$inst.out"
    62	    log="$RUNS/matrix/${b}_$inst.log"; : > "$log"
    63	    for i in $INVS; do
    64	      mkcfg "$META/c_${b}_${i}_$inst.cfg" "$inst" "$i"
    65	      tlc "$META/o.out" "$META/c_${b}_${i}_$inst.cfg" "$b"
    66	      { echo "===== $b / $inst / $i"; cat "$META/o.out"; } >> "$log"
    67	      rec matrix "$b" "$inst" "$i" "$META/o.out"
    68	    done
    69	  done
    70	done
    71	
    72	# 4. P4 regression: the committed P4 cfgs, unchanged, re-run into runs/p4-rerun.
    73	cd "$TLA_DIR" || exit 1
    74	tlc "$RUNS/p4-rerun/P4_VerifierStates.out" P4_VerifierStates.cfg P4_VerifierStates
    75	rec p4-rerun P4_VerifierStates - main "$RUNS/p4-rerun/P4_VerifierStates.out"
    76	tlc "$RUNS/p4-rerun/P4_VerifierStates_Sanity.out" P4_VerifierStates_Sanity.cfg P4_VerifierStates -continue
    77	rec p4-rerun P4_VerifierStates - sanity "$RUNS/p4-rerun/P4_VerifierStates_Sanity.out"
    78	for c in P4_VerifierStates_Broken P4_VerifierStates_Broken_Green P4_VerifierStates_Broken_Green2; do
    79	  tlc "$RUNS/p4-rerun/$c.out" "$c.cfg" P4_VerifierStates_Broken
    80	  rec p4-rerun P4_VerifierStates_Broken - "$c" "$RUNS/p4-rerun/$c.out"
    81	done
    82	echo "done: $SUMMARY (metadirs left in $META)"
