     1	---------------------------- MODULE P4_VerifierStates ----------------------------
     2	(***************************************************************************)
     3	(* Tessera Band 0 — P4: fail-closed verifier state logic.                 *)
     4	(* Authoritative property statements: Amendment 1 §A1.2 (P4) and §A1.2.1  *)
     5	(* (the waiver lattice). This module is the machine-checkable form.       *)
     6	(*                                                                         *)
     7	(* The verifier's verdict over a bundle is a pure function (P9) of the     *)
     8	(* per-check outcomes and the verifier's declared policy. TLC exhaustively *)
     9	(* enumerates every combination of check outcomes and every policy, and   *)
    10	(* checks the A1.2/A1.2.1 invariants over all of them. There is no        *)
    11	(* temporal behavior here — evaluation is instantaneous — so the "state   *)
    12	(* machine" is degenerate: all the content is in the Init enumeration and *)
    13	(* the invariants.                                                         *)
    14	(*                                                                         *)
    15	(* Reading guide (Tony): Checks is an abstract set of the verifier's      *)
    16	(* individual checks (signature-verifies, manifest-evidence-validates,    *)
    17	(* temporal-consistency, ...). NonWaivable \subseteq Checks per A1.2.1.   *)
    18	(* `status` assigns each check pass/fail/unperformable; `waived` is the   *)
    19	(* verifier's declared policy (the waived subset; {} = strict). The       *)
    20	(* companion P4_VerifierStates_Broken module implements the classic       *)
    21	(* fail-open bug and TLC produces the violating assignment.               *)
    22	(*                                                                          *)
    23	(* CORRECTION 2026-09-06 (cross-family falsification review, Codex          *)
    24	(* gpt-6-astra;                                                             *)
    25	(* docs/reviews/2026-09-06-codex-tla-falsification-p4-p5p6-p5c.md item 6,   *)
    26	(* and Amendment 4 §A4.2; entered by the AI collaborator, PROPOSED, not     *)
    27	(* adopted; the header above is left as written per amend-don't-rewrite):   *)
    28	(* - "This module is the machine-checkable form" of P4 and the waiver       *)
    29	(*   lattice overstates. What the committed run discharges is narrower: the *)
    30	(*   eleven formulas in P4_VerifierStates.cfg hold over every status        *)
    31	(*   assignment in [Checks -> Statuses] and every legal waiver set in       *)
    32	(*   SUBSET Waivable, for the configured instance (five abstract checks,    *)
    33	(*   two non-waivable). Not represented here, and carried elsewhere: the    *)
    34	(*   recording of the waived set and the authorizing policy (an H1a/Band 1  *)
    35	(*   artifact); the mapping of c1..c5 to §A1.2.1's concrete non-waivable    *)
    36	(*   and waivable categories (the reading aid's cast table; the invariants  *)
    37	(*   do not depend on the count); bundles, keys, replay, and the            *)
    38	(*   adversary's actions (P1/P3/P7 and the symbolic suite). The verdict is  *)
    39	(*   a derived value, not a stored one.                                     *)
    40	(* - The precedence at VerdictFor — a required FAIL outranks a required     *)
    41	(*   UNPERFORMABLE, verdict INVALID — is no longer "for author              *)
    42	(*   ratification": Amendment 4 §A4.2 records the author's ratification of  *)
    43	(*   it as modelled ("Precedence — RULED (author)", 2026-09-06), with the   *)
    44	(*   reason that a definite failure is stronger evidence than an open       *)
    45	(*   question, both are fail-closed, and the alternative would make the     *)
    46	(*   verdict depend on evaluation order. docs/phase-0-prereg-amendment-4.md *)
    47	(*   (committed 5188e7a and OTS-stamped at 5dfd82b; its own status line,    *)
    48	(*   "adopted in session, not yet signed", was not updated, while its own   *)
    49	(*   in-force criterion is "the author's signing commit and OpenTimestamps  *)
    50	(*   stamp" — whether the stamp or the status line governs is the author's  *)
    51	(*   call).                                                                 *)
    52	(* - P4's registered sentence "A check that cannot be performed yields      *)
    53	(*   UNVERIFIABLE — never any VALID state" is read, per Amendment 4 §A4.2,  *)
    54	(*   as "A REQUIRED check that cannot be performed…": a waived (waivable,   *)
    55	(*   explicitly-policied) check that cannot be performed yields             *)
    56	(*   VALID_DEGRADED, which is what ExactDegraded checks and what §A1.2.1's  *)
    57	(*   lattice already says. NoSilentPromotion and ExactUnverifiable are the  *)
    58	(*   formulas of the qualified sentence, not of the unqualified one.        *)
    59	(***************************************************************************)
    60	EXTENDS FiniteSets
    61	
    62	CONSTANTS Checks, NonWaivable
    63	
    64	ASSUME NonWaivable \subseteq Checks
    65	
    66	Waivable == Checks \ NonWaivable
    67	
    68	Statuses == {"pass", "fail", "unperformable"}
    69	
    70	Verdicts == {"VALID_STRICT", "VALID_DEGRADED", "INVALID", "UNVERIFIABLE"}
    71	
    72	VARIABLES status, waived
    73	
    74	(* Every combination of check outcomes and every legal policy. A1.2.1:   *)
    75	(* only Waivable checks may appear in a waiver set — a policy naming a    *)
    76	(* non-waivable check is not a legal policy at all.                       *)
    77	Init ==
    78	  /\ status \in [Checks -> Statuses]
    79	  /\ waived \in SUBSET Waivable
    80	
    81	Next == UNCHANGED <<status, waived>>
    82	
    83	(***************************************************************************)
    84	(* The verdict function, parameterized by the waiver set W so that the    *)
    85	(* monotonicity invariant can quantify over ALL policies for one status   *)
    86	(* assignment. Precedence decision (surfaced by this model, for author    *)
    87	(* ratification): when one required check FAILS and another is            *)
    88	(* UNPERFORMABLE, the verdict is INVALID — a definitive failure is        *)
    89	(* stronger evidence than an open question, and both are fail-closed.     *)
    90	(* CORRECTION 2026-09-06: ratified as modelled — Amendment 4 §A4.2          *)
    91	(* ("Precedence — RULED (author)"); see the header correction for the       *)
    92	(* citation and the status caveat.                                          *)
    93	(***************************************************************************)
    94	RequiredUnder(W) == Checks \ W
    95	
    96	VerdictFor(W) ==
    97	  IF \E c \in RequiredUnder(W) : status[c] = "fail"
    98	    THEN "INVALID"
    99	  ELSE IF \E c \in RequiredUnder(W) : status[c] = "unperformable"
   100	    THEN "UNVERIFIABLE"
   101	  ELSE IF W = {}
   102	    THEN "VALID_STRICT"
   103	    ELSE "VALID_DEGRADED"
   104	
   105	Verdict == VerdictFor(waived)
   106	
   107	(***************************************************************************)
   108	(* Invariants — each maps to a clause of A1.2 P4 / A1.2.1.                *)
   109	(***************************************************************************)
   110	
   111	(* P4: the four states partition all outcomes (totality; never a bare     *)
   112	(* boolean, never a fifth state).                                          *)
   113	Partition == Verdict \in Verdicts
   114	
   115	(* A1.2.1 monotonicity: a failed non-waivable check is INVALID under      *)
   116	(* EVERY policy — no waiver set may promote it.                            *)
   117	Monotonicity ==
   118	  (\E c \in NonWaivable : status[c] = "fail") =>
   119	    \A W \in SUBSET Waivable : VerdictFor(W) = "INVALID"
   120	
   121	(* A1.2.1: an unperformable non-waivable check never yields any VALID     *)
   122	(* state, under any policy. (INVALID is permitted: some other required    *)
   123	(* check may have definitively failed.)                                    *)
   124	NoSilentPromotion ==
   125	  (\E c \in NonWaivable : status[c] = "unperformable") =>
   126	    \A W \in SUBSET Waivable :
   127	      VerdictFor(W) \in {"INVALID", "UNVERIFIABLE"}
   128	
   129	(* P1-facing corollary: any VALID verdict means every non-waivable check  *)
   130	(* was performed and passed.                                               *)
   131	ValidNeedsNonWaivablePass ==
   132	  (Verdict \in {"VALID_STRICT", "VALID_DEGRADED"}) =>
   133	    \A c \in NonWaivable : status[c] = "pass"
   134	
   135	(* P4/§3.1: VALID_STRICT is the fail-closed default — every check, not    *)
   136	(* just the required ones, performed and passed.                           *)
   137	StrictMeansEverything ==
   138	  Verdict = "VALID_STRICT" => \A c \in Checks : status[c] = "pass"
   139	
   140	(* A1.2.1: VALID_DEGRADED only arises from an explicit, nonempty waiver   *)
   141	(* within the waivable set — never as a default.                           *)
   142	DegradedNeedsExplicitWaiver ==
   143	  Verdict = "VALID_DEGRADED" => (waived # {} /\ waived \subseteq Waivable)
   144	
   145	(* UNVERIFIABLE is honest: it arises only when some required check truly  *)
   146	(* could not be performed (and none failed).                               *)
   147	UnverifiableIsHonest ==
   148	  Verdict = "UNVERIFIABLE" =>
   149	    /\ \E c \in RequiredUnder(waived) : status[c] = "unperformable"
   150	    /\ \A c \in RequiredUnder(waived) : status[c] # "fail"
   151	
   152	(***************************************************************************)
   153	(* Exact classification (iff, not just one-way safety). The one-way       *)
   154	(* implications above would all pass under an over-conservative verdict   *)
   155	(* function (e.g. everything INVALID); these pin the classification in    *)
   156	(* both directions, so a future edit to VerdictFor cannot silently drift  *)
   157	(* toward misclassification in either the permissive or the conservative  *)
   158	(* direction. Together the four right-hand sides partition all outcomes.  *)
   159	(***************************************************************************)
   160	AnyRequiredFail == \E c \in RequiredUnder(waived) : status[c] = "fail"
   161	AnyRequiredUnperf == \E c \in RequiredUnder(waived) : status[c] = "unperformable"
   162	AllRequiredPass == \A c \in RequiredUnder(waived) : status[c] = "pass"
   163	
   164	ExactInvalid ==
   165	  (Verdict = "INVALID") <=> AnyRequiredFail
   166	
   167	ExactUnverifiable ==
   168	  (Verdict = "UNVERIFIABLE") <=> (~AnyRequiredFail /\ AnyRequiredUnperf)
   169	
   170	ExactStrict ==
   171	  (Verdict = "VALID_STRICT") <=>
   172	    (waived = {} /\ \A c \in Checks : status[c] = "pass")
   173	
   174	ExactDegraded ==
   175	  (Verdict = "VALID_DEGRADED") <=> (waived # {} /\ AllRequiredPass)
   176	
   177	(***************************************************************************)
   178	(* Vacuity checks — used ONLY by the _Sanity cfg (run with TLC -continue), *)
   179	(* where TLC VIOLATING all four is the healthy result: each verdict is    *)
   180	(* reachable under the correct verdict function, so the implication-      *)
   181	(* shaped invariants above are not vacuously true. If VerdictFor had a    *)
   182	(* bug making any verdict unsatisfiable, its invariants would pass        *)
   183	(* vacuously — these witnesses close that hole.                            *)
   184	(***************************************************************************)
   185	VerdictNeverStrict       == Verdict # "VALID_STRICT"
   186	VerdictNeverDegraded     == Verdict # "VALID_DEGRADED"
   187	VerdictNeverInvalid      == Verdict # "INVALID"
   188	VerdictNeverUnverifiable == Verdict # "UNVERIFIABLE"
   189	
   190	===================================================================================

