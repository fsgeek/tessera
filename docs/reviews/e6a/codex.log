    66	
    67	OutOfProfileOnlyAtDispatch ==
    68	  reasonV = "OUT_OF_PROFILE" => dispatch = "out"
    69	
    70	(***************************************************************************)
    71	(* Group B. The transition (A3 §A3.6.2 items 2 and 3).                    *)
    72	(***************************************************************************)
    73	(* The registered transition: a well-formed, correctly bound, unsupported *)
    74	(* identifier, with nothing definitely failed, gives UNVERIFIABLE.        *)
    75	UnknownAlgGivesUnverifiable ==
    76	  (InP /\ AnyUnknown /\ ~AnyDefect) => verdictV = "UNVERIFIABLE"
    77	
    78	(* The fail-open companion's target: an unknown algorithm never yields    *)
    79	(* any VALID state, under any legal policy, whatever else holds.          *)
    80	UnknownAlgNeverValid ==
    81	  (InP /\ AnyUnknown) => verdictV \in {"INVALID", "UNVERIFIABLE"}
    82	
    83	(* The registered INVALID list for the identifier.                        *)
    84	InvalidAlgFormsGiveInvalid ==
    85	  (InP /\ \E s \in Slots : AlgDefect(s)) => verdictV = "INVALID"
    86	
    87	(* "A known algorithm whose signature fails" is INVALID.                  *)
    88	KnownAlgBadSigInvalid ==
    89	  (InP /\ \E s \in Slots : alg[s] = "supported" /\ sig[s] = "bad")
    90	    => verdictV = "INVALID"
    91	
    92	(* "UNVERIFIABLE for exactly one case", in reason form: the ALG_UNKNOWN   *)
    93	(* reason is reported iff an unknown id is present, nothing failed, and   *)
    94	(* no earlier-ordered unperformable reason (an absent member) applies.    *)
    95	AlgUnknownReasonExact ==
    96	  (reasonV = "ALG_UNKNOWN") <=>
    97	    (InP /\ AnyUnknown /\ ~AnyDefect /\ ~AnyEvMissing)
    98	
    99	(***************************************************************************)
   100	(* Group C. Mixed failed / unperformable (A4 §A4.2 precedence, kept       *)
   101	(* inside the profile: Codex review of the V1 derivation, finding 11).    *)
   102	(***************************************************************************)
   103	MixedFailedUnknownInvalid ==
   104	  (InP /\ AnyDefect /\ AnyUnknown) => (verdictV = "INVALID" /\ reasonV = "FAILED")
   105	
   106	MixedFailedMissingEvidenceInvalid ==
   107	  (InP /\ AnyDefect /\ AnyEvMissing) => (verdictV = "INVALID" /\ reasonV = "FAILED")
   108	
   109	(***************************************************************************)
   110	(* Group D. Missing signature versus missing evidence (Codex finding 11: *)
   111	(* "Missing required signatures and missing required authority evidence   *)
   112	(* also have different registered meanings").                             *)
   113	(***************************************************************************)
   114	(* A9 C3: a missing or stripped required signature FAILS -- INVALID under *)
   115	(* every policy, whatever the algorithm (conformance ALG-02: unknown alg  *)
   116	(* with an empty signature is INVALID / SIG_EMPTY).                        *)
   117	MissingSignatureInvalid ==
   118	  (InP /\ \E s \in Slots : sig[s] = "absent") => verdictV = "INVALID"
   119	
   120	(* A missing required evidence member is UNPERFORMABLE, not a failure:    *)
   121	(* alone it gives UNVERIFIABLE / MEMBER_MISSING (case d2).                *)
   122	MissingEvidenceUnverifiable ==
   123	  (InP /\ AnyEvMissing /\ ~AnyDefect)
   124	    => (verdictV = "UNVERIFIABLE" /\ reasonV = "MEMBER_MISSING")
   125	
   126	(* ...and never VALID.                                                     *)
   127	MissingEvidenceNeverValid ==
   128	  (InP /\ AnyEvMissing) => verdictV \in {"INVALID", "UNVERIFIABLE"}
   129	
   130	(* Absence is not failure: INVALID only from a definite defect.           *)
   131	InvalidNeedsDefect ==
   132	  verdictV = "INVALID" => (InP /\ AnyDefect)
   133	
   134	(***************************************************************************)
   135	(* Group E. Exact classification on the inputs (both directions, so an   *)
   136	(* over-conservative verdict cannot pass; the P4 Exact* pattern).         *)
   137	(***************************************************************************)
   138	TypeOK ==
   139	  /\ verdictV \in B!Verdicts
   140	  /\ reasonV  \in B!Reasons
   141	  /\ statusMap \in [B!AllChecks -> B!Statuses]
   142	
   143	ReasonMatchesVerdict ==
   144	  /\ (reasonV = "OK")     <=> (verdictV \in {"VALID_STRICT", "VALID_DEGRADED"})
   145	  /\ (reasonV = "FAILED") <=> (verdictV = "INVALID")
   146	  /\ (reasonV \in {"OUT_OF_PROFILE", "MEMBER_MISSING", "ALG_UNKNOWN"})
   147	       <=> (verdictV = "UNVERIFIABLE")
   148	
   149	ExactInvalidIn ==
   150	  InP => ((verdictV = "INVALID") <=> AnyDefect)
   151	
   152	ExactUnverifiableIn ==
   153	  InP => ((verdictV = "UNVERIFIABLE") <=>
   154	            (~AnyDefect /\ (AnyUnknown \/ AnyEvMissing)))
   155	
   156	ExactStrictIn ==
   157	  InP => ((verdictV = "VALID_STRICT") <=> (waived = {} /\ AllClean))
   158	
   159	ExactDegradedIn ==
   160	  InP => ((verdictV = "VALID_DEGRADED") <=> (waived # {} /\ AllClean))
   161	
   162	(* V1 is strict-only: with no waivable check, VALID_DEGRADED is unreachable. *)
   163	NoDegradedWithoutWaivable ==
   164	  WaivableEv = {} => verdictV # "VALID_DEGRADED"
   165	
   166	(***************************************************************************)
   167	(* Group F. Agreement with P4, and P4's own invariants on the derived     *)
   168	(* status map. F1 says the in-profile verdict IS P4's VerdictFor; the     *)
   169	(* P4_* formulas are P4_VerifierStates' eleven, evaluated on statusMap.   *)
   170	(* A companion that mis-classifies inputs leaves group F green: P4 alone  *)
   171	(* cannot see that defect.                                                *)
   172	(***************************************************************************)
   173	AgreesWithP4 == InP => verdictV = P4!VerdictFor(waived)
   174	
   175	P4_Partition                 == P4!Partition
   176	P4_Monotonicity              == P4!Monotonicity
   177	P4_NoSilentPromotion         == P4!NoSilentPromotion
   178	P4_ValidNeedsNonWaivablePass == P4!ValidNeedsNonWaivablePass
