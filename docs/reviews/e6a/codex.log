     1	------------------------------ MODULE E6a_Props ------------------------------
     2	(***************************************************************************)
     3	(* Tessera, exit item E6a: the invariants, stated once.                   *)
     4	(* STATUS: PROPOSED, 2026-10-19, produced by the AI collaborator (owner   *)
     5	(* work, Claude Opus 5.5); not adopted; the commit is the author's.       *)
     6	(*                                                                         *)
     7	(* Every verdict module (correct and broken) instantiates this module     *)
     8	(* with its own derived status map, verdict and reason:                    *)
     9	(*   INSTANCE E6a_Props WITH statusMap <- DerivedStatus,                   *)
    10	(*                           verdictV  <- Verdict, reasonV <- Reason       *)
    11	(* so the formulas a companion is checked against are, by construction,  *)
    12	(* the formulas the correct module is checked against.                    *)
    13	(*                                                                         *)
    14	(* The invariants speak about the RAW INPUTS (alg, sig, ev), not about    *)
    15	(* the status map. That is the point of E6a: a verifier that classifies   *)
    16	(* an unknown algorithm as "pass" produces a status map on which all of   *)
    17	(* P4's eleven invariants still hold (group F below), because P4 checks   *)
    18	(* the verdict FUNCTION, not the classification of inputs into check      *)
    19	(* outcomes. E6a adds the classification.                                 *)
    20	(***************************************************************************)
    21	
    22	CONSTANTS Slots, EvItems, WaivableEv
    23	VARIABLES dispatch, alg, sig, ev, waived, statusMap, verdictV, reasonV
    24	
    25	LOCAL B  == INSTANCE E6a_Base
    26	LOCAL P4 == INSTANCE P4_VerifierStates
    27	              WITH Checks      <- B!AllChecks,
    28	                   NonWaivable <- B!NonWaivableChecks,
    29	                   status      <- statusMap,
    30	                   waived      <- waived
    31	
    32	(***************************************************************************)
    33	(* Input-level facts: the registered boundary, read off the inputs.       *)
    34	(***************************************************************************)
    35	InP == dispatch = "in"
    36	
    37	ReqEv(e) == B!EvCheck(e) \in B!Required
    38	
    39	(* A definite defect: something a required check must FAIL on.           *)
    40	(* A3 §A3.6.2 item 2's INVALID list; A9 C3 ("a missing, stripped or       *)
    41	(* substituted [signature] fails"); a required evidence member present    *)
    42	(* and failing.                                                            *)
    43	AlgDefect(s) == alg[s] \in B!InvalidAlgForms
    44	SigDefect(s) == \/ sig[s] = "absent"
    45	                \/ (alg[s] = "supported" /\ sig[s] = "bad")
    46	EvDefect(e)  == ReqEv(e) /\ ev[e] = "bad"
    47	AnyDefect    == \/ \E s \in Slots : AlgDefect(s) \/ SigDefect(s)
    48	                \/ \E e \in EvItems : EvDefect(e)
    49	
    50	(* The one UNVERIFIABLE algorithm case, and missing evidence.             *)
    51	Unknown(s)   == alg[s] = "unsupported"
    52	AnyUnknown   == \E s \in Slots : Unknown(s)
    53	EvMissing(e) == ReqEv(e) /\ ev[e] = "absent"
    54	AnyEvMissing == \E e \in EvItems : EvMissing(e)
    55	
    56	(* Everything required present and passing.                               *)
    57	AllClean ==
    58	  /\ \A s \in Slots : alg[s] = "supported" /\ sig[s] = "good"
    59	  /\ \A e \in EvItems : ReqEv(e) => ev[e] = "good"
    60	
    61	(***************************************************************************)
    62	(* Group A. Dispatch (A9.5; V1-PROFILE §3.1).                             *)
    63	(***************************************************************************)
    64	DispatchTerminal ==
