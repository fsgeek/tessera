     1	------------------------------ MODULE E6a_Base ------------------------------
     2	(***************************************************************************)
     3	(* Tessera, exit item E6a (A9 §A9.2; A3 §A3.6.2 items 2 and 3).            *)
     4	(* STATUS: PROPOSED, 2026-10-19, produced by the AI collaborator (owner   *)
     5	(* work, Claude Opus 5.5); not adopted; the commit is the author's.       *)
     6	(*                                                                         *)
     7	(* Shared inputs for the E6a family. Nothing here decides a verdict.      *)
     8	(* The verdict modules (E6a_AlgVerdict and its _Broken companions) EXTEND *)
     9	(* this module; E6a_Props states the invariants once, so every companion  *)
    10	(* is checked against the same formulas (the P4 _Broken copy drifted to    *)
    11	(* seven of eleven invariants: 2026-09-06 review item 5).                  *)
    12	(*                                                                         *)
    13	(* What one state is: one presented input to the verifier, abstracted to  *)
    14	(*   dispatch  -- did the input pass profile dispatch ("in") or not       *)
    15	(*                ("out": unknown profile label, bad layer structure,      *)
    16	(*                unsupported request; V1-PROFILE §3.1 D1-D4)              *)
    17	(*   alg[s]    -- per signature slot, the algorithm identifier's form      *)
    18	(*                (A3 §A3.6.2 item 2's list, below)                        *)
    19	(*   sig[s]    -- per slot, the signature: absent, present but not         *)
    20	(*                verifying, present and verifying                         *)
    21	(*   ev[e]     -- per required evidence member: absent, present and        *)
    22	(*                failing, present and passing                             *)
    23	(*   waived    -- the verifier's declared waiver set (A1.2.1). V1 is       *)
    24	(*                strict-only, so its configuration has no waivable check. *)
    25	(* The verdict is DERIVED from these by the verdict modules; it is never  *)
    26	(* stored, as in P4.                                                       *)
    27	(***************************************************************************)
    28	EXTENDS FiniteSets
    29	
    30	CONSTANTS
    31	  Slots,       \* signature slots named by the signed manifest (V1: kms, gpg)
    32	  EvItems,     \* required evidence members (abstract; V1: e.g. the DNS and git channels)
    33	  WaivableEv   \* evidence members a degraded policy may waive (A1.2.1, P10); V1: {}
    34	
    35	ASSUME WaivableEv \subseteq EvItems
    36	
    37	(* A3 §A3.6.2 item 2, exact. "supported" is the catalog-supported id.     *)
    38	(* "unsupported" is the ONE UNVERIFIABLE case: a well-formed, correctly    *)
    39	(* bound, but unsupported identifier. The other five are the registered   *)
    40	(* INVALID list: missing identifier; identifier/signature encoding        *)
    41	(* mismatch; malformed parameters; identifier prohibited by policy;       *)
    42	(* substitution of the signed identifier. (The sixth INVALID item, "a     *)
    43	(* known algorithm whose signature fails", is alg = "supported" with       *)
    44	(* sig = "bad".)                                                           *)
    45	AlgForms == {"supported", "unsupported",
    46	             "missing", "encoding_mismatch", "malformed", "prohibited",
    47	             "substituted"}
    48	InvalidAlgForms == AlgForms \ {"supported", "unsupported"}
    49	
    50	SigForms      == {"absent", "bad", "good"}
    51	EvForms       == {"absent", "bad", "good"}
    52	DispatchForms == {"in", "out"}
    53	
    54	(* The checks the verifier performs on a dispatched input. Each slot has   *)
    55	(* an algorithm check and a signature check; each evidence member one      *)
    56	(* check. These are the P4 module's abstract `Checks`, made concrete.      *)
    57	AlgCheck(s) == <<"alg", s>>
    58	SigCheck(s) == <<"sig", s>>
    59	EvCheck(e)  == <<"ev", e>>
    60	
    61	AlgChecks == {AlgCheck(s) : s \in Slots}
    62	SigChecks == {SigCheck(s) : s \in Slots}
    63	EvChecks  == {EvCheck(e) : e \in EvItems}
    64	AllChecks == AlgChecks \cup SigChecks \cup EvChecks
    65	
    66	(* A1.2.1: identifier binding and signature verification (P3, P8) are    *)
    67	(* non-waivable; only declared redundancy (here: an authority-evidence     *)
    68	(* channel, P10) may be waived. Waiving a whole signature slot (P2's       *)
    69	(* degraded subset) is NOT modelled; V1 has no waivers at all.             *)
    70	WaivableChecks    == {EvCheck(e) : e \in WaivableEv}
    71	NonWaivableChecks == AllChecks \ WaivableChecks
    72	
    73	Statuses == {"pass", "fail", "unperformable"}
    74	Verdicts == {"VALID_STRICT", "VALID_DEGRADED", "INVALID", "UNVERIFIABLE"}
    75	
    76	(* Reason classes, abstracted from V1-PROFILE §15.7's codes:              *)
    77	(*   OUT_OF_PROFILE -- rows 1.1-1.4 (dispatch)                             *)
    78	(*   FAILED         -- any INVALID code (the model does not pick which)    *)
    79	(*   MEMBER_MISSING -- row 2.2 (a required member absent)                  *)
    80	(*   ALG_UNKNOWN    -- row 7.1                                             *)
    81	(*   OK             -- success                                             *)
    82	(* Row 2.2 precedes row 7.1 in the total check order, so an input with    *)
    83	(* both an absent member and an unknown alg, and no failure, reports      *)
    84	(* MEMBER_MISSING (conformance case AGG-d).                                *)
    85	Reasons == {"OUT_OF_PROFILE", "FAILED", "MEMBER_MISSING", "ALG_UNKNOWN", "OK"}
    86	
    87	VARIABLES dispatch, alg, sig, ev, waived
    88	
    89	inputs == <<dispatch, alg, sig, ev, waived>>
    90	
    91	(* Every combination of inputs and every legal policy. As in P4, a policy *)
    92	(* naming a non-waivable check is not in the enumeration (excluded, not   *)
    93	(* rejected; READING-AID-P4).                                              *)
    94	Init ==
    95	  /\ dispatch \in DispatchForms
    96	  /\ alg      \in [Slots -> AlgForms]
    97	  /\ sig      \in [Slots -> SigForms]
    98	  /\ ev       \in [EvItems -> EvForms]
    99	  /\ waived   \in SUBSET WaivableChecks
   100	
   101	Next == UNCHANGED inputs
   102	
   103	Required == AllChecks \ waived
   104	
   105	(***************************************************************************)
   106	(* Shared derivation helpers. A verdict module supplies a status map `st` *)
   107	(* (one status per check); these turn it into a verdict and a reason.     *)
   108	(* The in-profile verdict is P4's own VerdictFor, instantiated on the     *)
   109	(* derived status map: P4 is reused, not restated, and its file is not    *)
   110	(* edited.                                                                 *)
   111	(***************************************************************************)
   112	LOCAL P4(st) == INSTANCE P4_VerifierStates
   113	                  WITH Checks      <- AllChecks,
   114	                       NonWaivable <- NonWaivableChecks,
   115	                       status      <- st,
   116	                       waived      <- waived
   117	
   118	(* Dispatch is terminal (A9.5; V1-PROFILE §3.1): an out-of-profile input  *)
   119	(* is UNVERIFIABLE and nothing else is evaluated. Inside, P4 decides.     *)
   120	VerdictFrom(st) ==
   121	  IF dispatch = "out" THEN "UNVERIFIABLE" ELSE P4(st)!VerdictFor(waived)
   122	
   123	P4VerdictOf(st) == P4(st)!VerdictFor(waived)
   124	
   125	ReasonFrom(st) ==
   126	  IF dispatch = "out" THEN "OUT_OF_PROFILE"
   127	  ELSE IF \E c \in Required : st[c] = "fail" THEN "FAILED"
   128	  ELSE IF \E c \in Required \cap EvChecks : st[c] = "unperformable"
   129	    THEN "MEMBER_MISSING"
   130	  ELSE IF \E c \in Required \cap (AlgChecks \cup SigChecks) :
   131	            st[c] = "unperformable"
   132	    THEN "ALG_UNKNOWN"
   133	  ELSE "OK"
   134	
   135	=============================================================================
     1	---------------------------- MODULE E6a_AlgVerdict ----------------------------
     2	(***************************************************************************)
     3	(* Tessera, exit item E6a: the P4 partition transition for an unknown     *)
     4	(* algorithm, with dispatch, the mixed failed/unperformable case, and     *)
     5	(* missing signature versus missing evidence.                             *)
     6	(* STATUS: PROPOSED, 2026-10-19, produced by the AI collaborator (owner   *)
     7	(* work, Claude Opus 5.5); not adopted; the commit is the author's.       *)
     8	(*                                                                         *)
     9	(* Registered text: A3 §A3.6.2 item 2 (the verdict boundary) and item 3   *)
    10	(* ("the formal model's P4-partition transition with a broken companion  *)
    11	(* -- a verifier that fail-opens past an unknown algorithm must go red"); *)
    12	(* A4 §A4.2 (FAIL over UNPERFORMABLE); A9 §A9.5 (dispatch); A9 C3         *)
    13	(* (a missing signature fails). V1-PROFILE §3 and §15.7 for V1's codes.   *)
    14	(*                                                                         *)
    15	(* P4_VerifierStates.tla is NOT edited. It is instantiated (in E6a_Base)  *)
    16	(* with the derived status map below; its VerdictFor decides every       *)
    17	(* in-profile verdict. Run with -DTLA-Library=<repo>/formal/tla so SANY   *)
    18	(* finds it.                                                               *)
    19	(***************************************************************************)
    20	EXTENDS E6a_Base
    21	
    22	(* Classification of inputs into check outcomes -- the part E6a adds.     *)
    23	AlgStatus(s) ==
    24	  CASE alg[s] = "supported"   -> "pass"
    25	    [] alg[s] = "unsupported" -> "unperformable"   \* the one UNVERIFIABLE case
    26	    [] OTHER                  -> "fail"            \* A3.6.2 item 2's INVALID list
    27	
    28	(* An absent signature is a codec failure whatever the algorithm (A9 C3; *)
    29	(* conformance ALG-02). Signature semantics are performed only for the    *)
    30	(* supported id; otherwise they are unperformable (blocked by the alg     *)
    31	(* check, V1-PROFILE row 9.2 "(blocked: 7.1)").                           *)
    32	SigStatus(s) ==
    33	  IF sig[s] = "absent" THEN "fail"
    34	  ELSE IF alg[s] # "supported" THEN "unperformable"
    35	  ELSE IF sig[s] = "bad" THEN "fail"
    36	  ELSE "pass"
    37	
    38	(* An absent evidence member is unperformable, not a failure (A9 case d2; *)
    39	(* V1-PROFILE row 2.2 MEMBER_MISSING).                                     *)
    40	EvStatus(e) ==
    41	  CASE ev[e] = "absent" -> "unperformable"
    42	    [] ev[e] = "bad"    -> "fail"
    43	    [] ev[e] = "good"   -> "pass"
    44	
    45	DerivedStatus ==
    46	  [c \in AllChecks |->
    47	     CASE c[1] = "alg" -> AlgStatus(c[2])
    48	       [] c[1] = "sig" -> SigStatus(c[2])
    49	       [] c[1] = "ev"  -> EvStatus(c[2])]
    50	
    51	Verdict == VerdictFrom(DerivedStatus)
    52	Reason  == ReasonFrom(DerivedStatus)
    53	
    54	INSTANCE E6a_Props WITH statusMap <- DerivedStatus,
    55	                        verdictV  <- Verdict,
    56	                        reasonV   <- Reason
    57	
    58	=============================================================================

