   133	# does not say); the safety mechanism is deadline.py's per-request guard, these only avoid starting a unit that cannot
   134	# finish. MIN_REQUEST_S: another request is started only with at least this much left.
   135	MIN_REQUEST_S = 60
   136	DRAIN_SHARE = 1 / 3              # ILC-I2-04: at most this share of an invocation drains signer responses
   137	ENUM_PAGE = 10                   # ILC-I2-04: active requests read per page
   138	MTP_SPAN = 11                                # median-time-past window (Bitcoin consensus)
   139	
   140	
   141	class StageError(Exception):
   142	    pass
   143	
   144	
   145	class Superseded(StageError):
   146	    """A guarded write failed: the record changed since this invocation read it (or fenced it)."""
   147	
   148	
   149	def _deadline(iss):
   150	    return deadline.CURRENT.get() or deadline.Deadline(iss.clock, float("inf"), 0)
   151	
   152	
   153	def _tip_worst(iss):
   154	    f = getattr(iss.headers, "tip_worst_s", None)
   155	    return f() if f else 2 * deadline.HTTP_WORST_S
   156	
   157	
   158	def _height_worst(iss):
   159	    f = getattr(iss.headers, "height_worst_s", None)
   160	    return f() if f else 4 * deadline.HTTP_WORST_S
   161	
   162	
   163	def _tip(iss):
   164	    deadline.ensure(_tip_worst(iss), "tip")
   165	    return iss.headers.tip()
   166	
   167	
   168	# ------------------------------------------------------------------------------------------------ the poller
   169	def poll(iss, budget_s=None):
   170	    """One scheduled tick under one deadline (ILC-I-02; its clock is monotonic, ILC-I2-01). Work classes share the
   171	    invocation (ILC-I2-04): draining signer responses may use at most DRAIN_SHARE of it; requests then get the rest.
   172	    Requests are enumerated in bounded pages from a DURABLE continuation position (RequestStore.active_page and the
   173	    poller cursor), and the position is moved past a request BEFORE it is worked on, so neither a long active list
   174	    nor a request that exhausts (or kills) an invocation takes the others' turns. -> summary dict."""
   175	    d = deadline.Deadline(getattr(iss, "elapsed_clock", None) or iss.clock,          # ILC-I2-01: monotonic
   176	                          iss.budget_s if budget_s is None else budget_s, POLL_RESERVE_S)
   177	    out = {"drained": 0, "advanced": {}, "cleaned": 0}
   178	    with deadline.Installed(d):
   179	        try:
   180	            out["drained"] = drain(iss, share_s=DRAIN_SHARE * d.limit)
   181	            _serve_requests(iss, d, out)
   182	            if d.available() >= MIN_REQUEST_S:
   183	                out["cleaned"] = cleanup(iss)
   184	        except OutOfBudget as e:                       # out of time outside a request's turn: resumed next poll
   185	            iss.note("poll out of time:", e)
   186	            out["out_of_time"] = True
   187	    return out
   188	
   189	
   190	def _serve_requests(iss, d, out):
   191	    store = iss.requests
   192	    cur = store.cursor_get()
   193	    if not isinstance(cur, dict):
   194	        cur = {"token": None, "skip": 0}
   195	    seen, served, wrapped = set(), 0, False
   196	    while True:
   197	        rids, nxt = store.active_page(cur["token"], ENUM_PAGE)
   198	        if not rids and cur["token"] is not None and not wrapped:
   199	            cur, wrapped = {"token": None, "skip": 0}, True            # end of the list: start again from the top
   200	            continue
   201	        for i in range(cur["skip"], len(rids)):
   202	            rid = rids[i]
   203	            if rid in seen:
   204	                return                                 # a full lap in this invocation
   205	            if served and d.available() < MIN_REQUEST_S:
   206	                out["deferred"] = True
   207	                return
   208	            store.cursor_put({"token": cur["token"], "skip": i + 1})  # moved BEFORE the request is worked on
   209	            seen.add(rid)
   210	            served += 1
   211	            rec = store.get(rid)
   212	            if rec is None or rec["state"] != "ACCEPTED":
   213	                continue                               # the index is eventually consistent
   214	            before = rec["stage"]
   215	            try:
   216	                advance(iss, rec)
   217	            except OutOfBudget as e:
   218	                iss.note("out of time, request kept:", rid[:12], e)
   219	            except PreShipUnavailable as e:
   220	                iss.note("pre-ship unavailable, request kept:", rid[:12], e)
   221	            except Exception as e:  # noqa: BLE001  one request's fault never stops the others; retried next tick
   222	                iss.note("stage", before, "error, request kept:", rid[:12], type(e).__name__, e)
   223	            out["advanced"][rid] = (before, rec["stage"] or rec["state"])
   224	        if nxt is None:
   225	            if wrapped or cur["token"] is None and not rids:
   226	                store.cursor_put({"token": None, "skip": 0})
   227	                return
   228	            cur, wrapped = {"token": None, "skip": 0}, True
   229	        else:
   230	            cur = {"token": nxt, "skip": 0}
   231	        store.cursor_put(cur)
   232	
   233	
   234	def advance(iss, rec):
   235	    now = iss.clock()
   236	    try:
   237	        STAGES[rec["stage"]](iss, rec, now)
   238	    except StageError as e:
   239	        iss.note("stage", rec["stage"], "deferred:", e)
   240	
   241	
   242	def _commit(iss, rec, expect):
   243	    """Commit: a write guarded on `expect` (the lifecycle guard as read) and the record version."""
   244	    if not iss.requests.save(rec, expect):
   245	        raise Superseded("record changed since it was read; re-read next tick")
   246	
   247	
   248	def _event(rec, now, *what):
   249	    rec["events"] = (rec.get("events") or [])[-40:] + [[now, *what]]
   250	
   251	
   252	def _fence(iss, rec, now):
   253	    """Fence (R5-F3): a guarded write that bumps the version, committed before this invocation fetches anything for
   254	    the attempt. Any write a killed earlier invocation left pending carries an older version and now fails its guard.
   255	    If the fence itself fails, Superseded ends this request's turn: nothing is fetched."""
   256	    g = lifecycle_guard(rec)
   257	    rec["fenced_at"] = now
   258	    _commit(iss, rec, g)
   259	
   260	
   261	def _end_request(iss, rec, expect, state, reason, now):
   262	    """The request's terminal write (COMPLETE, REFUSED or FAILED), after its cleanup obligation is durable."""
   263	    iss.requests.cleanup_put(rec["rid"], {"rid": rec["rid"], "end_done": False})   # IS-07: before the commit
   264	    now = max(now, iss.clock())                        # ended_at read after the obligation is durable (IS-02)
   265	    a = current(rec)
   266	    if a is not None and a["state"] in (OPEN, LATCHED) and state != "COMPLETE":
   267	        if a["state"] == LATCHED:                      # no path ends a latched attempt other than step 7's discard
   268	            raise StageError("refusing to end a latched attempt with the request")
   269	        a.update(state=DISCARDED, end={"outcome": OUTCOME[DISCARDED], "reason": reason, "at": now})
   270	    rec.update(state=state, reason=reason, stage=None, ended_at=now, expires_at=now + RETENTION_S)
   665	    """Issuer pre-stamp check with the verifier's DNSSEC code: wildcard-free, every chain group valid now, and the
   666	    TXT value equal to the window's assertion."""
   667	    try:
   668	        snap = parse_snapshot(body)
   669	        if snap.wildcard:
   670	            return "DNS_WILDCARD"
   671	        config = check_config(iss.window.trust_base, {}, rfc3339(now))
   672	        bad = [a.reason or a.status for a in validate_snapshot(snap, config, now) if a.status != "pass"]
   673	        if bad:
   674	            return bad[0]
   675	        if snap.txt is None or txt_value([r.data for r in snap.txt.rr])["_raw"] != iss.window.assertion:
   676	            return "DNS_VALUE_DIFFERS"
   677	    except Fault as e:
   678	        return e.code
   679	    return None
   680	
   681	
   682	def _capture_snapshot(iss, rec, a, now):
   683	    """Capture, validate and stamp the DNSSEC snapshot for attempt a. -> True when stored (proofs updated in rec,
   684	    not yet committed); False after committing a 'snapshot-rejected' event (recapture next tick)."""
   685	    body = iss.dns.capture(now)
   686	    problem = _validate_snapshot_now(iss, body, now)
   687	    if problem:
   688	        g = lifecycle_guard(rec)
   689	        _event(rec, now, "snapshot-rejected", a["id"], problem)
   690	        _commit(iss, rec, g)
   691	        return False
   692	    env = encode_snapshot_envelope(body)
   693	    raw = ots.stamp(sha256(env), iss.calendars, iss.nonce())
   694	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.body", body)
   695	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.ots", raw)
   696	    a["proofs"]["snapshot"] = {"stamped_at": now}
   697	    return True
   698	
   699	
   700	def _try_snapshot(iss, rec, a, now):
   701	    """Capture and stamp the attempt's DNSSEC snapshot if it has none. ILC-I2-05: a rejected or failed capture is
   702	    recorded and retried later; it never holds up the receipt's evidence. -> True when a snapshot is now held."""
   703	    if "snapshot" in a["proofs"]:
   704	        return True
   705	    g = lifecycle_guard(rec)
   706	    try:
   707	        if not _capture_snapshot(iss, rec, a, now):
   708	            return False
   709	    except (OutOfBudget, Superseded):
   710	        raise
   711	    except Exception as e:  # noqa: BLE001  a capture failure is retried; it is not a lifecycle event
   712	        iss.note("snapshot capture failed, retried:", rec["rid"][:12], type(e).__name__, e)
   713	        return False
   714	    a.pop("snapshot_failure", None)
   715	    _event(rec, now, "stamped", a["id"], "snapshot")
   716	    _commit(iss, rec, g)
   717	    return True
   718	
   719	
   720	def st_stamp(iss, rec, now):
   721	    tip = _tip(iss)
   722	    if tip < iss.window.h_git + 5:                     # chain-order pre-commitment (profile 4, 6.3)
   723	        return
   724	    a = current(rec)
   725	    proofs = a["proofs"]
   726	    if "receipt" not in proofs:                        # A9.5: a fresh stamp of this attempt's own A_sig
   727	        raw = ots.stamp(sha256(iss.results.get("work", rec["rid"], f"{a['id']}/a_sig")), iss.calendars, iss.nonce())
   728	        iss.results.put("work", rec["rid"], f"{a['id']}/receipt.ots", raw)       # immutable once committed
   729	        g = lifecycle_guard(rec)
   730	        proofs["receipt"] = {"stamped_at": now, "tip": tip}
   731	        _event(rec, now, "stamped", a["id"], "receipt")
   732	        _commit(iss, rec, g)
   733	    _try_snapshot(iss, rec, a, now)                   # ILC-I2-05: evidence does not wait for it
   734	    g = lifecycle_guard(rec)
   735	    rec["stage"] = "evidence"
   736	    _commit(iss, rec, g)
   737	
   738	
   739	# ------------------------------------------------------------------------------------------------ evidence (steps 3-5)
   740	def conjunct_failed(sel, declared):
   741	    """The three-conjunct temporal predicate of A2.1/A2.2 on a selected presentation (the verifier's rows 12.1-12.3,
   742	    all three; rows 12.2 and 12.3 alone are not the predicate). -> the first failing conjunct's code, or None."""
   743	    if not declared - EPS <= sel.time:
   744	        return "TIME_BEFORE_DECLARED_EPSILON"
   745	    if not sel.time <= declared + DELTA:
   746	        return "TIME_AFTER_DECLARED_DELTA"
   747	    if not sel.confirmed <= declared + DELTA:
   748	        return "CONFIRMATION_LATE"
   749	    return None
   750	
   751	
   752	@dataclass
   753	class Evidence:
   754	    """One Fetch for one attempt. cls: "elig" (the lowest qualifying presentation in hand satisfies the predicate),
   755	    "neg" (COMPLETE evidence and that presentation fails a conjunct), "err" (some part of the fetch failed) or
   756	    "pending" (anything else: a calendar not yet attested, a segment not yet buried k = 6, nothing qualifying).
   757	    Only "elig" and "neg" are successes; neither "err" nor "pending" is ever evidence of absence."""
   758	    cls: str                                          # "elig" | "neg" | "invalid" | "err" | "pending"
   759	    fetch_start: int
   760	    sel: object = None
   761	    failed: str = None
   762	    presentation: dict = None
   763	    detail: str = ""
   764	    errors: list = field(default_factory=list)
   765	
   766	
   767	def _headers(iss, rec, a, heights):
   768	    """Headers at `heights`, checkpointed per height under the attempt (ILI-05): a header once fetched and checked is
   769	    stored, so a later invocation resumes instead of fetching it again. A height not yet stored is fetched only if the
   770	    explorers' worst case for one height fits the time left (else OutOfBudget, after keeping what was fetched).
   771	
   772	    Consecutive heights must link. If stored headers do not (a stored header is stale: a reorganisation, or a bad
   773	    store), every stored header of the set is invalidated DURABLY (an empty object), and the set is fetched again; the
   774	    refresh then advances across invocations, each one keeping the heights it re-fetched (ILC-I-03), instead of
   775	    restarting from the lowest height and never reaching the stale one. The checkpoint relies on the k-deep
   776	    assumption: no reorganisation of 6 or more blocks (A1.6, V1 contract)."""
   777	    rid, aid = rec["rid"], a["id"]
   778	    hs = sorted(set(heights))
   779	    seg_name = f"{aid}/seg/{hs[0]}-{hs[-1]}"
   780	    seg = iss.results.get("work", rid, seg_name)           # a whole linked set, stored once checked: one read
   781	    if seg and len(seg) == 80 * len(hs):
   782	        out = {h: seg[80 * i:80 * (i + 1)] for i, h in enumerate(hs)}
   783	        try:
   784	            check_links(out)
   785	            return out
   786	        except Exception:  # noqa: BLE001  fall through to the per-height checkpoints
   787	            pass
   788	    out = {}
   789	    for h in hs:
   790	        name = f"{aid}/hdr/{h}"
   791	        raw = iss.results.get("work", rid, name)
   792	        if raw is None or len(raw) != 80:
   793	            deadline.ensure(_height_worst(iss), f"header {h}")
   794	            raw = iss.headers.headers([h])[h]
   795	            if len(raw) != 80:
   796	                raise ValueError(f"header {h} is not 80 bytes")
   797	            iss.results.put("work", rid, name, raw)
   798	        out[h] = raw
   799	    try:
   800	        check_links(out)
   801	    except Exception as e:  # noqa: BLE001
   802	        iss.results.put("work", rid, seg_name, b"")
   803	        for h in hs:                                   # durable invalidation: the refresh survives the invocation
   804	            iss.results.put("work", rid, f"{aid}/hdr/{h}", b"")
   805	        raise StageError(f"stored headers {hs[0]}..{hs[-1]} did not link ({e}); invalidated, re-fetched next") \
   806	            from None
   807	    if seg != b"".join(out[h] for h in hs):
   808	        iss.results.put("work", rid, seg_name, b"".join(out[h] for h in hs))
   809	    return out
   810	
   811	
   812	def _upgrade(iss, rec, a, name, cursor_name):
   813	    """Upgrade one of the attempt's proofs from its calendars, within the deadline, resuming at the durable cursor
   814	    (ILC-I-05). -> (proof bytes, finished)."""
   815	    rid = rec["rid"]
   816	    raw = iss.results.get("work", rid, name)
   817	    cur = iss.results.get("work", rid, cursor_name)
   818	    start = int(cur) if cur and cur.isdigit() else 0
   819	    # ILC-I2-03: the checkpoint write is reserved BEFORE any calendar request: a request starts only if, after it,
   820	    # one write still fits. If a calendar answered, the changed proof is that write (its resolved attestations leave
   821	    # the pending list, so the next invocation asks the others); otherwise the cursor is. Either way the progress of
   822	    # this invocation is durable.
   823	    write = getattr(iss.results, "request_worst_s", 0)
   824	    new, changed, finished, nxt = ots.upgrade_bounded(
   825	        raw, iss.calendars, start=start,
   826	        keep_going=lambda: _deadline(iss).available() >= deadline.HTTP_WORST_S + write)
   827	    if changed:
   828	        iss.results.put("work", rid, name, new)
   829	    if nxt != start:
   830	        try:
   831	            iss.results.put("work", rid, cursor_name, str(nxt).encode())
   832	        except OutOfBudget:
   833	            if not changed:
   834	                raise
   835	    return new, finished
   836	
   837	
   838	def _evaluate(iss, rec, a, new, proof, tip, a_sig, fetch_start):
   839	    """Classify the evidence in `proof` (see fetch_evidence)."""
   840	    aid = a["id"]
   841	    hdrs, missing, errors = {}, [], []
   842	    for h in sorted({x.height for x in proof.bitcoin}):
   843	        if h + K - 1 > tip:
   844	            missing.append(h)                          # not yet buried k deep: the segment does not exist yet
   845	            continue
   846	        try:
   847	            hdrs.update(_headers(iss, rec, a, range(h, h + K)))
   848	        except OutOfBudget:
   849	            raise
   850	        except Exception as e:  # noqa: BLE001
   851	            errors.append(f"{h}: {type(e).__name__}: {e}")
   852	    pins = {h: pin_of(v) for h, v in hdrs.items()}
   853	    sel, _ = select(proof, hdrs, pins)
   854	    complete = bool(proof.bitcoin) and not proof.pending and not missing and not errors
   855	    declared = ts(a["declared_issue_time"])
   856	    failed = conjunct_failed(sel, declared) if sel is not None else None
   857	    if sel is not None and failed is None:
   858	        root = hdrs[sel.height][36:68]
   859	        pruned, dropped = ots.prune_to_height(new, sel.height, merkle_root=root)
   860	        seg = {i: hdrs[i] for i in range(sel.height, sel.height + K)}
   861	        check, contradicted = select(parse_ots(pruned), seg, {i: pin_of(v) for i, v in seg.items()})
   862	        if (check is None or contradicted
   863	                or (check.height, check.time, check.confirmed) != (sel.height, sel.time, sel.confirmed)):
   864	            return Evidence("err", fetch_start, detail="pruned presentation does not reproduce the selection")
   865	        pres = {"format": "tessera-v1-issuer-presentation/1", "attempt": aid, "a_sig_sha256": sha256hex(a_sig),
   866	                "ots": b64e(pruned), "height": sel.height, "T": sel.time, "confirmed_at": sel.confirmed,
   867	                "contradicted_pruned": dropped,
   868	                "headers": {str(i): v.hex() for i, v in sorted(seg.items())}}
   869	        return Evidence("elig", fetch_start, sel=sel, presentation=pres)
   870	    if complete and sel is not None:
   871	        return Evidence("neg", fetch_start, sel=sel, failed=failed)
   872	    if complete and all(x.height in hdrs and hdrs[x.height][36:68] != x.message for x in proof.bitcoin):
   873	        return Evidence("invalid", fetch_start, failed="EVIDENCE_CONTRADICTED",
   874	                        detail=f"all {len(proof.bitcoin)} attestations contradicted by their pinned headers")
   875	    detail = (f"pending calendars {len(proof.pending)}, unburied {missing}, "
   876	              f"{'no qualifying height' if sel is None else 'selected fails ' + str(failed)}")
   877	    return Evidence("err" if errors else "pending", fetch_start, sel=sel, failed=failed, detail=detail, errors=errors)
   878	
   879	
   880	def fetch_evidence(iss, rec, a):
   881	    """Fetch: the attempt's own proof (it must stamp SHA-256 of this attempt's A_sig), the full pinned, linked h..h+5
   882	    segment of every Bitcoin attestation, and the lowest qualifying height by the verifier's `select`. The wall
   883	    reading `fetch_start` is taken before anything is fetched (R5-F1). Every request is under the poll's deadline;
   884	    headers and calendar answers already obtained are kept, and OutOfBudget is raised (no classification, no
   885	    lifecycle write) when the evidence could not be fetched in this invocation.
   886	
   887	    ILC-I-05: the evidence already held is evaluated FIRST; if it already shows eligibility the attempt latches
   888	    without spending time on pending calendars. Otherwise pending calendars are asked, in turn from a durable cursor
   889	    (so a long list of slow calendars is served across invocations), and the evidence is evaluated again.
   890	
   891	    Classes: "elig" - the lowest qualifying presentation satisfies the three conjuncts; it is pruned to the qualifying
   892	    branches at its height (select's contradiction flag is honoured: contradicted branches are not part of it, and
   893	    the pruned presentation is re-checked contradiction-free). "neg" - COMPLETE evidence and that presentation fails a
   894	    conjunct. "invalid" - COMPLETE evidence in which EVERY Bitcoin attestation is contradicted by its pinned header
   895	    (ILI-03: conclusive invalid evidence, profile 7.1; reason EVIDENCE_CONTRADICTED). "err" / "pending" - anything
   896	    else; never evidence of absence."""
   897	    fetch_start = iss.clock()
   898	    rid, aid = rec["rid"], a["id"]
   899	    name = aid + "/receipt.upgraded.ots"
   900	    try:
   901	        a_sig = iss.results.get("work", rid, aid + "/a_sig")
   902	        held = iss.results.get("work", rid, name)
   903	        if held is None:
   904	            held = iss.results.get("work", rid, aid + "/receipt.ots")
   905	            if held is not None:
   906	                iss.results.put("work", rid, name, held)
   907	        if held is None or a_sig is None:
   908	            raise StageError("attempt material unavailable")
   909	        proof = parse_ots(held)
   910	        if proof.digest != sha256(a_sig):
   911	            return Evidence("err", fetch_start, detail="proof does not stamp this attempt's A_sig")
   912	        tip = _tip(iss)
   913	        ev = _evaluate(iss, rec, a, held, proof, tip, a_sig, fetch_start)          # the evidence already held
   914	        if ev.cls == "elig" or not proof.pending:
   915	            return ev
   916	        new, finished = _upgrade(iss, rec, a, name, aid + "/receipt.upgrade-cursor")
   917	        if new != held:
   918	            proof = parse_ots(new)
   919	            if proof.digest != sha256(a_sig):
   920	                return Evidence("err", fetch_start, detail="upgraded proof does not stamp this attempt's A_sig")
   921	            ev = _evaluate(iss, rec, a, new, proof, tip, a_sig, fetch_start)
   922	        if not finished and ev.cls != "elig":
   923	            raise OutOfBudget("pending calendars left for the next poll")
   924	        return ev
   925	    except OutOfBudget:
   926	        raise
   927	    except Exception as e:  # noqa: BLE001  a failed fetch: never a negative
   928	        return Evidence("err", fetch_start, detail=f"{type(e).__name__}: {e}")
   929	
   930	
   931	def _add_interval(a, idx):
   932	    """Diagnostic failure history (gated step 5: behind no behaviour). failed_intervals holds runs [first, last] of
   933	    absolute interval indices (fetch_start // POLL_INTERVAL_S), each interval at most once. -> True if changed."""
   934	    runs = [list(r) for r in a.get("failed_intervals") or []]
   935	    if any(lo <= idx <= hi for lo, hi in runs):
   936	        return False
   937	    runs.append([idx, idx])
   938	    runs.sort()
   939	    merged = []
   940	    for lo, hi in runs:
   941	        if merged and lo <= merged[-1][1] + 1:
   942	            merged[-1][1] = max(merged[-1][1], hi)
   943	        else:
   944	            merged.append([lo, hi])
   945	    if len(merged) > FAILED_INTERVAL_RUNS:
   946	        a["failed_intervals_dropped"] = a.get("failed_intervals_dropped", 0) + len(merged) - FAILED_INTERVAL_RUNS
   947	        merged = merged[-FAILED_INTERVAL_RUNS:]
   948	    a["failed_intervals"] = merged
   949	    return True
