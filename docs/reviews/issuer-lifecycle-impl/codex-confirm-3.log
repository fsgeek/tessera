+    raw = ots.stamp(sha256(env), iss.calendars, iss.nonce())
+    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.body", body)
+    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.ots", raw)
+    a["proofs"]["snapshot"] = {"stamped_at": now}
+    return True
