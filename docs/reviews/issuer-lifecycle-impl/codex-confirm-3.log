import inspect, textwrap
from tessera_issue import deadline


def mutate(name, old, new):
    src = textwrap.dedent(inspect.getsource(getattr(pipeline, name)))
    assert old in src, (name, old)
    exec(compile(src.replace(old, new), "mut", "exec"), pipeline.__dict__)
    for k, v in list(pipeline.STAGES.items()):
        if v.__name__ == name:
            pipeline.STAGES[k] = pipeline.__dict__[name]


def bypass(kind):
    real = deadline.guarded
    def guarded(worst_s, fn, *a, what="", **kw):
        if what.startswith(kind):
            return fn(*a, **kw)
        return real(worst_s, fn, *a, what=what, **kw)
    deadline.guarded = guarded


if MUT and MUT.startswith("ILCI02_"):                  # one client kind bypasses the deadline guard
    bypass(MUT[len("ILCI02_"):].lower())
if MUT == "ILCI01":                                     # 13.5 (trust configuration) treated as snapshot bytes
    pipeline.SNAPSHOT_BYTES_ROWS.add("13.5")
if MUT == "ILCI03":                                     # no durable invalidation of a stale stored set
    mutate("_headers", 'iss.results.put("work", rid, f"{aid}/hdr/{h}", b"")', "pass")
if MUT == "ILCI04":                                     # the snapshot stage never evaluates impossibility
    mutate("st_snapshot", 'evidence = _snapshot_impossible(iss, rec, a, a.get("snapshot_failure"))', "evidence = None")
if MUT == "ILCI05_ORDER":                               # pending calendars asked before the held evidence counts
    src = textwrap.dedent(inspect.getsource(real_fetch))
    old = 'if ev.cls == "elig" or not proof.pending:'
    assert old in src
    ns = dict(pipeline.__dict__)
    exec(compile(src.replace(old, "if not proof.pending:"), "mut", "exec"), ns)
    real_fetch = ns["fetch_evidence"]
if MUT == "ILCI05_CURSOR":                              # every invocation restarts at the first pending calendar
    mutate("_upgrade", 'start = int(cur) if cur and cur.isdigit() else 0', "start = 0")

# ---------------- round 3 (ILC-I2)
from tessera_issue import aws as _aws
if MUT == "ILCI2_01_BODY":                              # the S3 body read outside the guarded request
    def _read(self, key):
