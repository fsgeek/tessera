def test_http_total_is_not_total():
    class Handler(socketserver.BaseRequestHandler):
        def handle(self):
            self.request.recv(4096)
            self.request.sendall(b'HTTP/1.0 200 OK\r\nContent-Length: 10\r\n\r\n')
            try:
                for _ in range(10):
                    time.sleep(.04); self.request.sendall(b'x')
            except OSError: pass
    with socketserver.TCPServer(('127.0.0.1',0),Handler) as server:
        th=threading.Thread(target=server.handle_request);th.start()
        start=time.monotonic()
        try: ots.urllib_transport(.1)('GET',f'http://127.0.0.1:{server.server_address[1]}/',None)
        except TimeoutError: pass
        span=time.monotonic()-start;th.join()
    print('HTTP_TOTAL',span,'configured',.1)
    assert span > .3

