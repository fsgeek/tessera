   428	             "signature_sha256": sha256hex(sig) if sig is not None else None, "disposition": None,
   429	             "attempt": idx.get("attempt") if idx else None}
   430	    if diag is not None:
   431	        entry.update(reason_sha256=sha256hex(diag), reason_length=len(diag))
