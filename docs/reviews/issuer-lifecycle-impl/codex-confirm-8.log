        raw = self.c._client
        return guarded(AWS_WORST_S, lambda: raw.get_object(Bucket=self.b, Key=key)["Body"].read(),
                       what="s3.get_object")

    def get(self, ns, rid, name):
        try:
            return self._read(self.key(ns, rid, name))
        except Exception as e:  # noqa: BLE001
            if _not_found(e):
                return None
            raise

