        loc.iss.results.put("work", rid, f"a1/hdr/{i}", raw)
    slow = SlowHeaders(loc.iss.headers, loc.clock)
    loc.iss.headers = slow
    for _ in range(6):
        poll(loc)
    rec = get(loc, rid)
    assert att(rec)["state"] in ("latched", "shipped") and h + 4 in slow.calls
