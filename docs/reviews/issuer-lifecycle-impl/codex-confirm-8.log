def test_first_overrun(monkeypatch):
    monkeypatch.setitem(SLOW,'sqs',0)
    loc,_=aws_wire('sqs')
    _,rid=submit(loc,str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values(): wk.process()
    # Replenished unrequested replies: 60 receive + 60 lookup + 60 log + 60 ack.
    # All individual operations fit their configured 73-second admission bound.
    object.__setattr__(loc.iss.requests.c,'_client',SlowClient(loc.iss.requests.c._client,loc.clock,60,[]))
    for signer in loc.iss.signers.values(): signer.responses.client._client._delay=60
    for slot, signer in loc.iss.signers.items():
        real = signer.receive
        def receive(n=10, slot=slot, real=real):
            loc.iss.requests.c._client._delay = 60 if slot == 'kms' else 0
            return real(n)
        signer.receive = receive
    # Put junk ahead of KMS replies; retain obtainable, valid GPG responses.
    loc.workers['kms'].responses.msgs.clear()
    junk=json.dumps({'request_id':'req-'+'0'*40,'status':'SIGNED','sig_b64':'AAAA'})
    for i in range(12):
        loc.workers['kms'].responses.send(junk)
        start=loc.clock()
        out=pipeline.poll(loc.iss)
        print('OVERRUN',i,loc.clock()-start,out,len(loc.workers['gpg'].responses))
    rec=get(loc,rid)
    assert all(v['sig_sha256'] for k,v in att(rec)['jobs'].items() if 'gpg' in k)
    assert len(loc.workers['gpg'].responses)==0

    for _ in range(4): pipeline.poll(loc.iss)
    assert all(v['sig_sha256'] for k,v in att(get(loc,rid))['jobs'].items() if 'gpg' in k)
    print('CONTROL GPG collected')
import uuid
from conftest import loc,key
from test_lifecycle_confirm import aws_wire,SLOW,SlowClient
from test_lifecycle import get,att
from helpers import submit
from tessera_issue import pipeline

def setup(monkeypatch):
    monkeypatch.setitem(SLOW,'sqs',0)
    loc,_=aws_wire('sqs')
    _,rid=submit(loc,str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values(): wk.process()
    # Deliver KMS first, leave only the valid GPG replies awaiting collection.
    for handle,body,age in loc.iss.signers['kms'].receive():
        pipeline._take(loc.iss,'kms',loc.iss.signers['kms'],body)
        loc.iss.signers['kms'].ack(handle)
    loc.iss.requests.cursor_put({'drain_turn':0})
    for signer in loc.iss.signers.values():
        signer.responses.client._client._delay=60
    return loc,rid

def test_short_budget_empty_first_queue(monkeypatch):
    loc,rid=setup(monkeypatch)
    for i in range(12):
        out=pipeline.poll(loc.iss,budget_s=190)
        print('SHORT',i,out,loc.iss.requests.cursor_get())
    print('RESULT',get(loc,rid)['stage'],[(k,bool(v['sig_sha256'])) for k,v in att(get(loc,rid))['jobs'].items()],len(loc.workers['gpg'].responses))
    assert all(v['sig_sha256'] for k,v in att(get(loc,rid))['jobs'].items() if 'gpg' in k)
    # Control: starting with GPG at the same budget consumes the valid responses.
    loc.iss.requests.cursor_put({'drain_turn':1})
    for _ in range(6):
        loc.iss.requests.cursor_put({'drain_turn':1})
        pipeline.poll(loc.iss,budget_s=190)
    print('CONTROL',get(loc,rid)['stage'])
    assert all(v['sig_sha256'] for k,v in att(get(loc,rid))['jobs'].items() if 'gpg' in k)
