"""The issuer's wiring: one object holding the window, the frozen objects, the stores, the signers, the calendars,
the header source, the DNS source, the pre-ship checker and the clock. API handlers and the poller take it."""
from dataclasses import dataclass, field

from .util import HOUR, SystemClock, random_bytes

# The registered lifecycle (A2.1-A2.3 with A9.2's parameters; docs/decisions/2026-10-29-issuance-lifecycle.md). There is
# no request deadline: the former 24-hour FAILED rule (S4) contradicted A2 and is withdrawn.
N_ATTEMPTS = 3                      # A2.3 / A9.2: at most N attempts per request
SLACK_S = 24 * HOUR                 # A2.1 / A9.2: S; an attempt's boundary is B = declared + delta + S
POLL_INTERVAL_S = 600               # the poller's schedule (infra: rate(10 minutes)); indexes failed_intervals, which
                                    # is diagnostic only while design step 5 is gated
# ILI-05 / ILC-I-02: one poll runs inside one Lambda invocation (timeout 300 s, infra/main.tf). deadline.py guards
# every request the poller makes: it starts a request only if the request's worst case fits the time left minus the
# reserve, and caps the request's timeout to what is left. Running out of time never ends an attempt.
POLLER_TIMEOUT_S = 300
POLL_BUDGET_S = 290                 # the invocation's usable time (lambda_app lowers it to the time actually left)
POLL_RESERVE_S = 10                 # kept free after the last request: returning the poll's summary
HTTP_TIMEOUT_S = 20                 # one calendar or explorer request, total (ots.urllib_transport caps the total)
# CF3-01, ILC-I-02: the SDK's own time per AWS request (connection, response wait, retries and back-off). Passed to
# botocore.config.Config; deadline.AWS_WORST_S is computed from it.
AWS_CLIENT_CONFIG = {"connect_timeout": 3, "read_timeout": 8,
                     "retries": {"mode": "standard", "total_max_attempts": 3}}
RETENTION_S = 30 * 24 * HOUR        # S5: lookup and retrieval for 30 days after the request ends
WRITE_LEASE_S = 15 * 60             # CF-02: the longest a Lambda invocation can run (AWS maximum); every issuer write
                                    # happens inside one, so none lands later than this after its writer saw the request
SIGNER_RETRY_S = 30 * 60            # re-send an unanswered signer request (same request id) after 30 min


@dataclass
class Issuer:
    window: object
    frozen: object
    requests: object                 # RequestStore
    results: object                  # ResultStore
    signers: dict                    # {"kms": SlotSigner, "gpg": SlotSigner}
    calendars: list
    headers: object                  # HeaderSource
    dns: object                      # SnapshotSource
    preship: object                  # PreShip
    clock: object = field(default_factory=SystemClock)
    closing: bool = False            # operator: closure announced and reached -> CLOSING
    signing_available: bool = True   # operator: a signer is known to be down -> SIGNING_UNAVAILABLE
    nonce: object = field(default=lambda: random_bytes(16))
    signer_retry_s: int = SIGNER_RETRY_S
    budget_s: float = POLL_BUDGET_S  # ILI-05: one poll's work budget (lambda_app lowers it to the time remaining)
    log: list = field(default_factory=list)

    def note(self, *a):
        self.log.append(" ".join(str(x) for x in a))

    @property
    def tombstone_until(self):
        """Content-free key records are kept until issuance closes, and long enough to answer EXPIRED for every
        request of the window (owner choice: not-after + 30 days + 1 day)."""
        return self.window.na + RETENTION_S + 24 * HOUR
"""Bitcoin header source behind one interface: tip() and headers(heights) -> {height: 80 header bytes}.

ExplorerHeaders reads two or more Esplora-style explorers over an injected transport and accepts a header only
when every explorer returns the same block hash, the header hashes to it, and consecutive headers link. The
issuer pins exactly what it checked (pre-ship), so a header source that lies is caught there, not trusted."""
import json

from .util import sha256d


class HeaderError(Exception):
    pass


class HeaderSource:
    def tip(self):
        raise NotImplementedError

    def headers(self, heights):
        raise NotImplementedError


def pin_of(header):
    return sha256d(header)[::-1].hex()


def check_links(hdrs):
    for h in sorted(hdrs):
        if len(hdrs[h]) != 80:
            raise HeaderError(f"header {h} is not 80 bytes")
        if h - 1 in hdrs and hdrs[h][4:36] != sha256d(hdrs[h - 1]):
            raise HeaderError(f"header {h} does not link to {h - 1}")


class ExplorerHeaders(HeaderSource):
    def __init__(self, base_urls, transport):
        from .deadline import HTTP_WORST_S, guarded_transport
        if len(base_urls) < 2:
            raise ValueError("at least two independent explorers")
        self.bases = [u.rstrip("/") for u in base_urls]
        self.transport = guarded_transport(transport, "explorer", HTTP_WORST_S)     # ILC-I-02: each request

    def tip_worst_s(self):
        """Worst case of tip(): one request per explorer (ILC-I-02: the explorer count is part of it)."""
        from .deadline import HTTP_WORST_S
        return len(self.bases) * HTTP_WORST_S

    def height_worst_s(self):
        """Worst case of headers([h]): the block hash and the header from every explorer."""
        from .deadline import HTTP_WORST_S
        return 2 * len(self.bases) * HTTP_WORST_S

    def _get(self, url):
        status, body = self.transport("GET", url, None)
        if status != 200:
            raise HeaderError(f"GET {url}: HTTP {status}")
        return body.decode("ascii").strip()

    def tip(self):
        return min(int(self._get(b + "/blocks/tip/height")) for b in self.bases)

    def headers(self, heights):
        out = {}
        for h in heights:
            hashes = {self._get(f"{b}/block-height/{h}") for b in self.bases}
            if len(hashes) != 1:
                raise HeaderError(f"explorers disagree at height {h}: {sorted(hashes)}")
            bh = hashes.pop()
            raws = {self._get(f"{b}/block/{bh}/header") for b in self.bases}
            if len(raws) != 1:
                raise HeaderError(f"explorers return different headers for {bh}")
            raw = bytes.fromhex(raws.pop())
            if pin_of(raw) != bh:
                raise HeaderError(f"header at {h} does not hash to {bh}")
            out[h] = raw
        check_links(out)
        return out


def headers_json(hdrs):
    return json.dumps({str(h): v.hex() for h, v in sorted(hdrs.items())}, sort_keys=True)
"""DNSSEC snapshot capture (profile 15.3) behind one interface: capture(now) -> snapshot body bytes.

LiveDns asks a resolver (over an injected transport: query wire -> response wire) for the six RRsets from the root
DNSKEY down to _tessera-v1.<D> TXT with the DO and CD bits, and converts the answers to the 15.3 body: groups in
chain order, canonical (lowercase, uncompressed) owners, RDATA sorted without duplicates, then RRSIGs sorted by
(key tag, inception, expiration, signature, RDATA), every TTL equal to the group's least Original TTL.
Validation is not done here: the pipeline validates with the service verifier's DNSSEC code before stamping."""
import os
import socket
import struct

from .util import D

T_TXT, T_DS, T_RRSIG, T_DNSKEY, T_OPT = 16, 43, 46, 48, 41
QUERIES = [(".", T_DNSKEY), ("com.", T_DS), ("com.", T_DNSKEY), (D + ".", T_DS), (D + ".", T_DNSKEY),
           ("_tessera-v1." + D + ".", T_TXT)]


class DnsError(Exception):
    pass


class SnapshotSource:
    def capture(self, now):
        raise NotImplementedError


def name_wire(name):
    name = name.rstrip(".").lower()
    if not name:
        return b"\x00"
    return b"".join(bytes([len(x)]) + x.encode("ascii") for x in name.split(".")) + b"\x00"


def make_query(name, rtype, qid=None):
    qid = int.from_bytes(os.urandom(2), "big") if qid is None else qid
    head = struct.pack(">HHHHHH", qid, 0x0110, 1, 0, 0, 1)            # RD, CD; one question; one additional (OPT)
    opt = b"\x00" + struct.pack(">HHIH", T_OPT, 4096, 0x00008000, 0)   # EDNS0, payload 4096, DO
    return head + name_wire(name) + struct.pack(">HH", rtype, 1) + opt


def _read_name(msg, i, depth=0):
    labels = []
    while True:
        if i >= len(msg) or depth > 64:
            raise DnsError("bad name")
        n = msg[i]
        if n & 0xC0 == 0xC0:
            ptr = ((n & 0x3F) << 8) | msg[i + 1]
            rest, _ = _read_name(msg, ptr, depth + 1)
            return labels + rest, i + 2
        i += 1
        if n == 0:
            return labels, i
        labels.append(msg[i:i + n].lower())
        i += n


def parse_answers(msg):
    """-> (truncated flag, [(owner labels tuple, type, ttl, rdata)]) from the answer section."""
    if len(msg) < 12:
        raise DnsError("short message")
    _, flags, qd, an, _, _ = struct.unpack(">HHHHHH", msg[:12])
    if flags & 0x000F:
        raise DnsError(f"rcode {flags & 0xF}")
    i = 12
    for _ in range(qd):
        _, i = _read_name(msg, i)
        i += 4
    out = []
    for _ in range(an):
        owner, i = _read_name(msg, i)
        rtype, cls, ttl, ln = struct.unpack(">HHIH", msg[i:i + 10])
        i += 10
        rd = msg[i:i + ln]
        if len(rd) != ln:
            raise DnsError("truncated RDATA")
        i += ln
        if cls == 1:
            out.append((tuple(owner), rtype, ttl, rd))
    return bool(flags & 0x0200), out


def truncated(msg):
    """The TC bit from the header alone: a truncated answer may end inside a record."""
    if len(msg) < 12:
        raise DnsError("short message")
    return bool(struct.unpack(">H", msg[2:4])[0] & 0x0200)


def _canonical_rrsig(rd):
    """Lowercase the signer name inside RRSIG RDATA (it is never compressed, RFC 4034 3.1.7)."""
    labels, end = _read_name(rd, 18)
    return rd[:18] + b"".join(bytes([len(x)]) + x for x in labels) + b"\x00" + rd[end:]


def group_bytes(owner, rtype, rdatas, rrsigs):
    ow = name_wire(owner)
    ttl = min(struct.unpack(">I", s[4:8])[0] for s in rrsigs)
    out = b""
    for rd in sorted(set(rdatas)):
        out += ow + struct.pack(">HHIH", rtype, 1, ttl, len(rd)) + rd
    for rd in sorted(set(rrsigs), key=lambda r: (r[16:18], r[12:16], r[8:12], r[r.index(b"\x00", 18) + 1:], r)):
        out += ow + struct.pack(">HHIH", T_RRSIG, 1, ttl, len(rd)) + rd
    return out


def convert(responses):
    """responses: [(name, type, response wire)] in QUERIES order -> 15.3 body."""
    body = b""
    for name, rtype, wire in responses:
        _, rrs = parse_answers(wire)
        want = tuple(x.encode() for x in name.rstrip(".").lower().split(".") if x)
        rds = [rd for o, t, _, rd in rrs if o == want and t == rtype]
        sigs = [_canonical_rrsig(rd) for o, t, _, rd in rrs if o == want and t == T_RRSIG
                and struct.unpack(">H", rd[:2])[0] == rtype]
        if not rds or not sigs:
            raise DnsError(f"no signed {rtype} RRset at {name}")
        body += group_bytes(name, rtype, rds, sigs)
    return body


class LiveDns(SnapshotSource):
    """Resolver capture for the deployed issuer. transport(query wire) -> response wire."""

    def __init__(self, transport):
        from .deadline import DNS_WORST_S, guarded_transport
        self.transport = guarded_transport(transport, "dns", DNS_WORST_S)          # ILC-I-02: each query

    def capture(self, now):
        responses = []
        for name, rtype in QUERIES:
            responses.append((name, rtype, self.transport(make_query(name, rtype))))
        return convert(responses)


def udp_tcp_transport(server="1.1.1.1", timeout=10):
    """Real resolver access (not used by the tests): UDP, then TCP when truncated. ILC-I-02: the query's TOTAL time is
    at most 2 x timeout (deadline.DNS_WORST_S), capped by what the poller's deadline leaves; every blocking operation
    gets only the time remaining of that total."""
    import time
    from .deadline import call_timeout

    def t(q):
        end = time.monotonic() + call_timeout(2 * timeout)

        def left():
            rest = end - time.monotonic()
            if rest <= 0:
                raise DnsError("resolver query over its time")
            return min(timeout, rest)
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.settimeout(left())
            s.sendto(q, (server, 53))
            r, _ = s.recvfrom(65535)
        if truncated(r):                       # IS-11: header TC bit, before any record is parsed
            with socket.create_connection((server, 53), timeout=left()) as s:
                s.sendall(struct.pack(">H", len(q)) + q)
                s.settimeout(left())
                n = struct.unpack(">H", s.recv(2))[0]
                r = b""
                while len(r) < n:
                    s.settimeout(left())
                    chunk = s.recv(n - len(r))
                    if not chunk:
                        raise DnsError("TCP response truncated")
                    r += chunk
        return r
    return t
"""Lambda entry points: api_handler (API Gateway REST proxy; the API key id is the client credential) and
poller_handler (EventBridge schedule, every 10 minutes; reserved concurrency 1). from_env() builds the issuer from
environment variables set by infra/; boto3 is imported only here.

Environment: REQUEST_TABLE, RESULT_BUCKET, FREEZE_DIR (packaged frozen objects), WINDOW_OBJECT (default
config/window.json in RESULT_BUCKET), KMS_REQUEST_QUEUE_URL, KMS_RESPONSE_QUEUE_URL, GPG_REQUEST_QUEUE_URL,
GPG_RESPONSE_QUEUE_URL, KMS_WAKE_TOPIC_ARN, GPG_WAKE_TOPIC_ARN (optional), OTS_CALENDARS, EXPLORERS (comma lists),
DNS_RESOLVER, CLOSING, SIGNING_AVAILABLE ("true"/"false"), TESSERA_VERIFY_INSTALL_JSON (the packaged verifier's
install record, for the pre-ship checks)."""
import base64
import json
import os

from . import api, freeze, pipeline, service, window as window_mod
from .aws import DynamoRequestStore, S3ResultStore, SnsWake
from .chain import ExplorerHeaders
from .dns import LiveDns, udp_tcp_transport
from .ots import HttpCalendar, urllib_transport
from .preship import PreShip
from .queues import SqsQueue
from .service import POLL_BUDGET_S, POLLER_TIMEOUT_S, Issuer
from .signers import SlotSigner

_ISSUER = None

# CF3-01: bound the client's own time per AWS call (connection, response wait, retries and backoff) well inside the
# writer lease (service.WRITE_LEASE_S). It does not bound when AWS commits a request already sent; that residual is
# the stated service clock tolerance (docs/decisions/2026-10-27-service-clock-tolerance.md). ILC-I-02: the poller's
# deadline guard admits an AWS request only if this configuration's worst case fits the time left.
AWS_CLIENT_CONFIG = service.AWS_CLIENT_CONFIG


def from_env(env=None, session=None):
    env = os.environ if env is None else env
    kw = {}
    if session is None:                                # the Lambda path; tests pass a fake session
        import boto3
        from botocore.config import Config
        session = boto3.session.Session()
        kw["config"] = Config(**AWS_CLIENT_CONFIG)
    ddb, s3, sqs, sns = (session.client(n, **kw) for n in ("dynamodb", "s3", "sqs", "sns"))
    results = S3ResultStore(s3, env["RESULT_BUCKET"])
    win = window_mod.load_json(results.get_config(env.get("WINDOW_OBJECT", "window.json")).decode())
    frozen = freeze.load(env["FREEZE_DIR"])
    wake = SnsWake(sns, {"kms": env.get("KMS_WAKE_TOPIC_ARN"), "gpg": env.get("GPG_WAKE_TOPIC_ARN")})
    signers = {"kms": SlotSigner("kms", win.kms_key, SqsQueue(sqs, env["KMS_REQUEST_QUEUE_URL"]),
                                 SqsQueue(sqs, env["KMS_RESPONSE_QUEUE_URL"]), wake),
               "gpg": SlotSigner("gpg", win.gpg_key, SqsQueue(sqs, env["GPG_REQUEST_QUEUE_URL"]),
                                 SqsQueue(sqs, env["GPG_RESPONSE_QUEUE_URL"]), wake)}
    http = urllib_transport()
    return Issuer(window=win, frozen=frozen, requests=DynamoRequestStore(ddb, env["REQUEST_TABLE"]), results=results,
                  signers=signers,
                  calendars=[HttpCalendar(u, http) for u in env["OTS_CALENDARS"].split(",") if u],
                  headers=ExplorerHeaders([u for u in env["EXPLORERS"].split(",") if u], http),
                  dns=LiveDns(udp_tcp_transport(env.get("DNS_RESOLVER", "1.1.1.1"))),
                  preship=PreShip(frozen, win.trust_base, env.get("TESSERA_VERIFY_INSTALL_JSON")),
                  closing=env.get("CLOSING", "false") == "true",
                  signing_available=env.get("SIGNING_AVAILABLE", "true") == "true")


def _issuer():
    global _ISSUER
    if _ISSUER is None:
        _ISSUER = from_env()
    return _ISSUER


def handle_api_event(iss, event):
    """API Gateway REST proxy event -> proxy response. Plain function; api_handler binds the issuer."""
    method = event.get("httpMethod")
    resource = event.get("resource") or ""
    headers = {k.lower(): v for k, v in (event.get("headers") or {}).items()}
    cred = ((event.get("requestContext") or {}).get("identity") or {}).get("apiKeyId")
    key = (event.get("pathParameters") or {}).get("key")
    if method == "POST" and resource == "/v1/requests":
        raw = event.get("body") or ""
        try:
            body = base64.b64decode(raw, validate=True) if event.get("isBase64Encoded") else raw.encode("utf-8")
        except ValueError:
            body = None
        if body is None:
            resp = api.Response(400, {"state": "REFUSED", "reason": "BAD_REQUEST"})
        else:
            resp = api.submit(iss, cred, headers.get("tessera-request-key"), body)
    elif method == "GET" and resource == "/v1/requests/{key}":
        resp = api.status(iss, cred, key)
    elif method == "GET" and resource == "/v1/requests/{key}/receipt":
        resp = api.receipt(iss, cred, key)
    else:
        resp = api.Response(404, {"error": "NOT_FOUND"})
    status, hdrs, data = api.encode(resp)
    return {"statusCode": status, "headers": hdrs, "body": data.decode("utf-8"), "isBase64Encoded": False}


SHA1DC_BINARY = "/var/task/tessera-verify/bin/sha1dcsum"     # where package.py puts the detector


def install_facts():
    """The facts this Lambda's install.json must record (profile 15.9 R2), read where it runs: the runtime's Unicode
    module digest differs from the build host's. Nothing is trusted from it; package.py checks the record it becomes,
    and the verifier checks it again at startup. Built before the issuer, which needs the record to exist."""
    import hashlib
    from tessera_verify import install_record
    digest = hashlib.sha256(open(SHA1DC_BINARY, "rb").read()).hexdigest()
    return install_record.current_facts(SHA1DC_BINARY, digest)


def api_handler(event, context):
    return handle_api_event(_issuer(), event)


def poller_handler(event, context):
    if isinstance(event, dict) and event.get("tessera") == "install-facts":
        return install_facts()                         # invoked by the operator only; EventBridge never sends it
    iss = _issuer()
    budget = getattr(iss, "budget_s", POLL_BUDGET_S)   # ILC-I-02: never more than the time this invocation has left
    remaining = getattr(context, "get_remaining_time_in_millis", None)
    if remaining is not None:
        budget = min(budget, remaining() / 1000 - (POLLER_TIMEOUT_S - POLL_BUDGET_S))
    out = pipeline.poll(iss, budget_s=budget)
    return json.loads(json.dumps(out, default=str))

