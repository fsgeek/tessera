   218	    the attempt. Any write a killed earlier invocation left pending carries an older version and now fails its guard.
   219	    If the fence itself fails, Superseded ends this request's turn: nothing is fetched."""
   220	    g = lifecycle_guard(rec)
   221	    rec["fenced_at"] = now
   222	    _commit(iss, rec, g)
   223	
   224	
   225	def _end_request(iss, rec, expect, state, reason, now):
   226	    """The request's terminal write (COMPLETE, REFUSED or FAILED), after its cleanup obligation is durable."""
   227	    iss.requests.cleanup_put(rec["rid"], {"rid": rec["rid"], "end_done": False})   # IS-07: before the commit
   228	    now = max(now, iss.clock())                        # ended_at read after the obligation is durable (IS-02)
   229	    a = current(rec)
   230	    if a is not None and a["state"] in (OPEN, LATCHED) and state != "COMPLETE":
   231	        if a["state"] == LATCHED:                      # no path ends a latched attempt other than step 7's discard
   232	            raise StageError("refusing to end a latched attempt with the request")
   233	        a.update(state=DISCARDED, end={"outcome": OUTCOME[DISCARDED], "reason": reason, "at": now})
   234	    rec.update(state=state, reason=reason, stage=None, ended_at=now, expires_at=now + RETENTION_S)
   235	    _event(rec, now, state, reason)
   236	    _commit(iss, rec, expect)
   237	    try:
   238	        _cleanup_one(iss, rec["rid"], {"rid": rec["rid"], "end_done": False}, now)
   239	    except Exception as e:  # noqa: BLE001  the obligation stays; the next poll retries it
   240	        iss.note("cleanup deferred:", rec["rid"][:12], type(e).__name__, e)
   241	
   242	
   243	def _end_attempt(iss, rec, outcome, reason, now, extra=None, no_successor=None):
   244	    """End the current attempt (EXPIRED or DISCARDED, with its reason) and, in the SAME guarded write, allocate the
   245	    next attempt, or refuse the request: ATTEMPTS_EXHAUSTED after attempt N, SIGNING_CLOSED when the next attempt
   246	    would need signing after the stop (design step 8; the model's Commit of an ending write). no_successor names a
   247	    reason no next attempt can be built at all (ILI-08: the content is lost); the request is then refused with it.
   248	    extra: further fields of the attempt's end record (evidence, a diagnostic reference)."""
   249	    assert outcome in ENDED
   250	    expect = lifecycle_guard(rec)
   251	    a, i = current(rec), rec["cur"]
   252	    a.update(state=outcome, end={"outcome": OUTCOME[outcome], "reason": reason, "at": now, **(extra or {})},
   253	             unavailable_since=None, failed_intervals=[])
   254	    _event(rec, now, OUTCOME[outcome], a["id"], reason)
   255	    if no_successor:
   256	        return _end_request(iss, rec, expect, "REFUSED", no_successor, now)
   257	    if i < N_ATTEMPTS and now <= iss.window.sign_until:
   258	        rec["attempts"].append(new_attempt(i + 1, now))
   259	        rec.update(cur=i + 1, stage="frames")
   260	        _event(rec, now, "allocated", rec["attempts"][-1]["id"])
   261	        return _commit(iss, rec, expect)
   262	    _end_request(iss, rec, expect, "REFUSED", "ATTEMPTS_EXHAUSTED" if i >= N_ATTEMPTS else "SIGNING_CLOSED", now)
   263	
   264	
   265	# ------------------------------------------------------------------------------------------------ cleanup (IS-07)
   266	END_NS = ("content", "work", "frames")
   267	
   268	
   269	def _cleanup_one(iss, rid, doc, now=None):
   270	    """-> True when the obligation is discharged. Content, work files and frames go when the request has ended;
   271	    the receipt goes 30 days after the end (or at once if the request did not complete). Deletion is keyed to the
   272	    persisted end, never to an object's age; objects are tagged cleanup-due just before they are deleted (5.3.1).
   273	
   274	    CF-02: a writer that read the request while it was ACCEPTED (an upload retry, a response consumer, a stale
   275	    poller) may still store an object after the end. Each such writer runs inside one Lambda invocation, so it is
   276	    gone WRITE_LEASE_S after the end was first seen here. Until then the obligation is kept and every poll deletes
   277	    again; only a listing taken after the lease discharges it."""
   278	    rec = iss.requests.get(rid)
   279	    if rec is not None and rec["state"] == "ACCEPTED":
   280	        return False                                   # not ended (an obligation written before a lost commit)
   281	    seen = iss.clock()                                 # read after the record: no earlier than the end's commit
   282	    expired = rec is None or seen >= rec["ended_at"] + RETENTION_S
   283	    namespaces = END_NS + ("result",) if (expired or rec["state"] != "COMPLETE") else END_NS
   284	    if doc.get("end_done") and not expired:
   285	        return False
   286	    if doc.get("fence_until") is None:                 # CF-02: start the writers' lease, durably
   287	        doc = dict(doc, rid=rid, fence_until=seen + WRITE_LEASE_S)
   288	        iss.requests.cleanup_put(rid, doc)
   289	    for ns in namespaces:
   290	        iss.results.mark_due(ns, rid)                  # due now: the lifecycle backstop may expire them from here on
   291	        iss.results.delete(ns, rid)
   292	    left = [ns for ns in namespaces if iss.results.names(ns, rid)]
   293	    if left:
   294	        raise StageError("objects left after deletion: " + ",".join(left))
   295	    if seen < doc["fence_until"]:
   296	        return False                                   # CF-02: a late writer may still store; delete again later
   297	    if expired or "result" in namespaces:
   298	        iss.requests.cleanup_done(rid)
   299	        return True
   300	    iss.requests.cleanup_put(rid, dict(doc, end_done=True))
   301	    return False
   302	
   303	
   304	def cleanup(iss):
   305	    now, n = iss.clock(), 0
   306	    for rid, doc in iss.requests.cleanup_list():
   307	        try:
   308	            n += bool(_cleanup_one(iss, rid, doc, now))
   309	        except OutOfBudget:
   310	            raise
   311	        except Exception as e:  # noqa: BLE001
   312	            iss.note("cleanup", rid[:12], "error, kept:", type(e).__name__, e)
   313	    return n
