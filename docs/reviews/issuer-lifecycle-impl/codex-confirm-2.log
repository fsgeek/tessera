   560	        _commit(iss, rec, g)                         # ILI-04: recovered BEFORE deciding that signing is still needed
   561	    if all(j["sig_sha256"] for j in jobs.values()):
   562	        return _seal(iss, rec, a, now)               # a complete set is sealed whatever the signing window
   563	    if now > iss.window.sign_until:                  # still needs signing after the stop (never a stamped attempt)
   564	        return _end_attempt(iss, rec, DISCARDED, "SIGNING_CLOSED", now)
   565	    g = lifecycle_guard(rec)
   566	    resend = [(k, j) for k, j in jobs.items() if not j["sig_sha256"] and now - j["sent_at"] >= iss.signer_retry_s]
   567	    if not resend:
   568	        return
   569	    for k, j in resend:
   570	        j.update(sent_at=now, attempts=j["attempts"] + 1)
   571	        iss.requests.sigreq_put(j["request_id"], {"rid": rec["rid"], "attempt": a["id"], "job": k, "slot": j["slot"],
   572	                                                  "frame_sha256": j["frame_sha256"]}, now + RETENTION_S)
   573	    _event(rec, now, "resend", a["id"], [k for k, _ in resend])
   574	    _commit(iss, rec, g)
   575	    slots = set()
   576	    for k, j in resend:                               # E-02: the same request id; a late first answer still counts
   577	        _send(iss, rec, a, k)
   578	        slots.add(j["slot"])
   579	    for s in slots:
   580	        iss.signers[s].wake()
