   688	@dataclass
   689	class Evidence:
   690	    """One Fetch for one attempt. cls: "elig" (the lowest qualifying presentation in hand satisfies the predicate),
   691	    "neg" (COMPLETE evidence and that presentation fails a conjunct), "err" (some part of the fetch failed) or
   692	    "pending" (anything else: a calendar not yet attested, a segment not yet buried k = 6, nothing qualifying).
   693	    Only "elig" and "neg" are successes; neither "err" nor "pending" is ever evidence of absence."""
   694	    cls: str                                          # "elig" | "neg" | "invalid" | "err" | "pending"
   695	    fetch_start: int
   696	    sel: object = None
   697	    failed: str = None
   698	    presentation: dict = None
   699	    detail: str = ""
   700	    errors: list = field(default_factory=list)
   701	
   702	
   703	def _headers(iss, rec, a, heights):
   704	    """Headers at `heights`, checkpointed per height under the attempt (ILI-05): a header once fetched and checked is
   705	    stored, so a later invocation resumes instead of fetching it again. A height not yet stored is fetched only if the
   706	    explorers' worst case for one height fits the time left (else OutOfBudget, after keeping what was fetched).
   707	
   708	    Consecutive heights must link. If stored headers do not (a stored header is stale: a reorganisation, or a bad
   709	    store), every stored header of the set is invalidated DURABLY (an empty object), and the set is fetched again; the
   710	    refresh then advances across invocations, each one keeping the heights it re-fetched (ILC-I-03), instead of
   711	    restarting from the lowest height and never reaching the stale one. The checkpoint relies on the k-deep
   712	    assumption: no reorganisation of 6 or more blocks (A1.6, V1 contract)."""
   713	    rid, aid = rec["rid"], a["id"]
   714	    hs = sorted(set(heights))
   715	    seg_name = f"{aid}/seg/{hs[0]}-{hs[-1]}"
   716	    seg = iss.results.get("work", rid, seg_name)           # a whole linked set, stored once checked: one read
   717	    if seg and len(seg) == 80 * len(hs):
   718	        out = {h: seg[80 * i:80 * (i + 1)] for i, h in enumerate(hs)}
   719	        try:
   720	            check_links(out)
   721	            return out
   722	        except Exception:  # noqa: BLE001  fall through to the per-height checkpoints
   723	            pass
   724	    out = {}
   725	    for h in hs:
   726	        name = f"{aid}/hdr/{h}"
   727	        raw = iss.results.get("work", rid, name)
   728	        if raw is None or len(raw) != 80:
   729	            deadline.ensure(_height_worst(iss), f"header {h}")
   730	            raw = iss.headers.headers([h])[h]
   731	            if len(raw) != 80:
   732	                raise ValueError(f"header {h} is not 80 bytes")
   733	            iss.results.put("work", rid, name, raw)
   734	        out[h] = raw
   735	    try:
   736	        check_links(out)
   737	    except Exception as e:  # noqa: BLE001
   738	        iss.results.put("work", rid, seg_name, b"")
   739	        for h in hs:                                   # durable invalidation: the refresh survives the invocation
   740	            iss.results.put("work", rid, f"{aid}/hdr/{h}", b"")
   741	        raise StageError(f"stored headers {hs[0]}..{hs[-1]} did not link ({e}); invalidated, re-fetched next") \
   742	            from None
   743	    if seg != b"".join(out[h] for h in hs):
   744	        iss.results.put("work", rid, seg_name, b"".join(out[h] for h in hs))
   745	    return out
   746	
   747	
   748	def _upgrade(iss, rec, a, name, cursor_name):
   749	    """Upgrade one of the attempt's proofs from its calendars, within the deadline, resuming at the durable cursor
   750	    (ILC-I-05). -> (proof bytes, finished)."""
   751	    rid = rec["rid"]
   752	    raw = iss.results.get("work", rid, name)
   753	    cur = iss.results.get("work", rid, cursor_name)
   754	    start = int(cur) if cur and cur.isdigit() else 0
   755	    new, changed, finished, nxt = ots.upgrade_bounded(
   756	        raw, iss.calendars, start=start,
   757	        keep_going=lambda: _deadline(iss).available() >= deadline.HTTP_WORST_S + MIN_REQUEST_S / 2)
   758	    if changed:
   759	        iss.results.put("work", rid, name, new)
   760	    if nxt != start:
   761	        iss.results.put("work", rid, cursor_name, str(nxt).encode())
   762	    return new, finished
