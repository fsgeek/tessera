   675	# ------------------------------------------------------------------------------------------------ evidence (steps 3-5)
   676	def conjunct_failed(sel, declared):
   677	    """The three-conjunct temporal predicate of A2.1/A2.2 on a selected presentation (the verifier's rows 12.1-12.3,
   678	    all three; rows 12.2 and 12.3 alone are not the predicate). -> the first failing conjunct's code, or None."""
   679	    if not declared - EPS <= sel.time:
   680	        return "TIME_BEFORE_DECLARED_EPSILON"
   681	    if not sel.time <= declared + DELTA:
   682	        return "TIME_AFTER_DECLARED_DELTA"
   683	    if not sel.confirmed <= declared + DELTA:
   684	        return "CONFIRMATION_LATE"
   685	    return None
