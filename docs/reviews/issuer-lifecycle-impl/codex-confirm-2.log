   583	def _seal(iss, rec, a, now):
   584	    """Profile 4 steps 4-6: verify each signature on the exact bytes, freeze, build A_sig, check it (A9.5: the
   585	    signatures are frozen before the attempt is stamped)."""
   586	    rid, aid = rec["rid"], a["id"]
   587	    get = lambda n: iss.results.get("work", rid, f"{aid}/{n}")  # noqa: E731
   588	    sigs = {}
   589	    for job, j in a["jobs"].items():
   590	        s, f = get(sig_name(job, j["sig_sha256"])), get(j["frame"])
   591	        if (s is None or sha256hex(s) != j["sig_sha256"] or not iss.signers[j["slot"]].verify(f, s)
   592	                or not iss.requests.siglog_has(j["request_id"], j["sig_sha256"])):     # IS-01
   593	            g = lifecycle_guard(rec)
   594	            j["sig_sha256"] = None                     # lost or corrupt: ask again with the same id
   595	            j["sent_at"] = 0
   596	            return _commit(iss, rec, g)
   597	        sigs[job] = s
   598	    a_sig = encode_anchor(get("f_kms"), sigs["s_kms"], get("f_gpg"), sigs["s_gpg"])
   599	    try:
   600	        for (f, obj, s, _), slot in zip(read_anchor(a_sig, registered_codecs(ALG)), ("kms", "gpg")):
   601	            if not iss.signers[slot].verify(f, s) or obj["common"]["manifest_sha256"] != sha256hex(get("manifest")):
   602	                raise StageError("A_sig check")
   603	        read_frame(get("manifest"), "tessera-v1/manifest")
   604	    except Fault as e:
   605	        raise StageError("A_sig decode: " + e.code) from None
   606	    iss.results.put("work", rid, f"{aid}/a_sig", a_sig)
   607	    g = lifecycle_guard(rec)
   608	    a["receipt_id"] = sha256hex(a_sig)
   609	    rec["stage"] = "stamp"
   610	    _event(rec, now, "a_sig", aid, a["receipt_id"])
   611	    _commit(iss, rec, g)
   612	
