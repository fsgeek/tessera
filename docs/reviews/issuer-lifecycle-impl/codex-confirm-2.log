   316	# ------------------------------------------------------------------------------------------------ E-02 drain
   317	def drain(iss, max_batches=50):
   318	    """Read every slot's response queue. Every response is logged (request id, slot, status, frame hash when the
   319	    id is known, signature hash) whether or not it is used, and then deleted from the queue."""
   320	    n, d = 0, _deadline(iss)
   321	    for slot, signer in iss.signers.items():
   322	        for _ in range(max_batches):
   323	            if d.available() < MIN_REQUEST_S:            # leave the rest queued for the next poll
   324	                break
   325	            batch = signer.receive(10)
   326	            if not batch:
   327	                break
   328	            for handle, body in batch:
   329	                try:
   330	                    _take(iss, slot, signer, body)
   331	                except OutOfBudget:
   332	                    raise                                  # not acknowledged; delivered again next poll
   333	                except Exception as e:  # noqa: BLE001  not acknowledged: the queue delivers it again
   334	                    iss.note("response", slot, "not taken:", type(e).__name__, e)
   335	                    continue
   336	                signer.ack(handle)
   337	                n += 1
   338	    return n
