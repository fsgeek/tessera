   614	def _validate_snapshot_now(iss, body, now):
   615	    """Issuer pre-stamp check with the verifier's DNSSEC code: wildcard-free, every chain group valid now, and the
   616	    TXT value equal to the window's assertion."""
   617	    try:
   618	        snap = parse_snapshot(body)
   619	        if snap.wildcard:
   620	            return "DNS_WILDCARD"
   621	        config = check_config(iss.window.trust_base, {}, rfc3339(now))
   622	        bad = [a.reason or a.status for a in validate_snapshot(snap, config, now) if a.status != "pass"]
   623	        if bad:
   624	            return bad[0]
   625	        if snap.txt is None or txt_value([r.data for r in snap.txt.rr])["_raw"] != iss.window.assertion:
   626	            return "DNS_VALUE_DIFFERS"
   627	    except Fault as e:
   628	        return e.code
   629	    return None
   630	
   631	
   632	def _capture_snapshot(iss, rec, a, now):
   633	    """Capture, validate and stamp the DNSSEC snapshot for attempt a. -> True when stored (proofs updated in rec,
   634	    not yet committed); False after committing a 'snapshot-rejected' event (recapture next tick)."""
   635	    body = iss.dns.capture(now)
   636	    problem = _validate_snapshot_now(iss, body, now)
   637	    if problem:
   638	        g = lifecycle_guard(rec)
   639	        _event(rec, now, "snapshot-rejected", a["id"], problem)
   640	        _commit(iss, rec, g)
   641	        return False
   642	    env = encode_snapshot_envelope(body)
   643	    raw = ots.stamp(sha256(env), iss.calendars, iss.nonce())
   644	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.body", body)
   645	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.ots", raw)
   646	    a["proofs"]["snapshot"] = {"stamped_at": now}
   647	    return True
   648	
   649	
   650	def st_stamp(iss, rec, now):
   651	    tip = iss.headers.tip()
   652	    if tip < iss.window.h_git + 5:                     # chain-order pre-commitment (profile 4, 6.3)
   653	        return
   654	    a = current(rec)
   655	    proofs = a["proofs"]
   656	    if "receipt" not in proofs:                        # A9.5: a fresh stamp of this attempt's own A_sig
   657	        raw = ots.stamp(sha256(iss.results.get("work", rec["rid"], f"{a['id']}/a_sig")), iss.calendars, iss.nonce())
   658	        iss.results.put("work", rec["rid"], f"{a['id']}/receipt.ots", raw)       # immutable once committed
   659	        g = lifecycle_guard(rec)
   660	        proofs["receipt"] = {"stamped_at": now, "tip": tip}
   661	        _event(rec, now, "stamped", a["id"], "receipt")
   662	        _commit(iss, rec, g)
   663	    if "snapshot" not in proofs:
   664	        g = lifecycle_guard(rec)
   665	        if not _capture_snapshot(iss, rec, a, now):
   666	            return
   667	        _event(rec, now, "stamped", a["id"], "snapshot")
   668	        rec["stage"] = "evidence"
   669	        return _commit(iss, rec, g)
   670	    g = lifecycle_guard(rec)
   671	    rec["stage"] = "evidence"
   672	    _commit(iss, rec, g)
