   764	
   765	def _evaluate(iss, rec, a, new, proof, tip, a_sig, fetch_start):
   766	    """Classify the evidence in `proof` (see fetch_evidence)."""
   767	    aid = a["id"]
   768	    hdrs, missing, errors = {}, [], []
   769	    for h in sorted({x.height for x in proof.bitcoin}):
   770	        if h + K - 1 > tip:
   771	            missing.append(h)                          # not yet buried k deep: the segment does not exist yet
   772	            continue
   773	        try:
   774	            hdrs.update(_headers(iss, rec, a, range(h, h + K)))
   775	        except OutOfBudget:
   776	            raise
   777	        except Exception as e:  # noqa: BLE001
   778	            errors.append(f"{h}: {type(e).__name__}: {e}")
   779	    pins = {h: pin_of(v) for h, v in hdrs.items()}
   780	    sel, _ = select(proof, hdrs, pins)
   781	    complete = bool(proof.bitcoin) and not proof.pending and not missing and not errors
   782	    declared = ts(a["declared_issue_time"])
   783	    failed = conjunct_failed(sel, declared) if sel is not None else None
   784	    if sel is not None and failed is None:
   785	        root = hdrs[sel.height][36:68]
   786	        pruned, dropped = ots.prune_to_height(new, sel.height, merkle_root=root)
   787	        seg = {i: hdrs[i] for i in range(sel.height, sel.height + K)}
   788	        check, contradicted = select(parse_ots(pruned), seg, {i: pin_of(v) for i, v in seg.items()})
   789	        if (check is None or contradicted
   790	                or (check.height, check.time, check.confirmed) != (sel.height, sel.time, sel.confirmed)):
   791	            return Evidence("err", fetch_start, detail="pruned presentation does not reproduce the selection")
   792	        pres = {"format": "tessera-v1-issuer-presentation/1", "attempt": aid, "a_sig_sha256": sha256hex(a_sig),
   793	                "ots": b64e(pruned), "height": sel.height, "T": sel.time, "confirmed_at": sel.confirmed,
   794	                "contradicted_pruned": dropped,
   795	                "headers": {str(i): v.hex() for i, v in sorted(seg.items())}}
   796	        return Evidence("elig", fetch_start, sel=sel, presentation=pres)
   797	    if complete and sel is not None:
   798	        return Evidence("neg", fetch_start, sel=sel, failed=failed)
   799	    if complete and all(x.height in hdrs and hdrs[x.height][36:68] != x.message for x in proof.bitcoin):
   800	        return Evidence("invalid", fetch_start, failed="EVIDENCE_CONTRADICTED",
   801	                        detail=f"all {len(proof.bitcoin)} attestations contradicted by their pinned headers")
   802	    detail = (f"pending calendars {len(proof.pending)}, unburied {missing}, "
   803	              f"{'no qualifying height' if sel is None else 'selected fails ' + str(failed)}")
   804	    return Evidence("err" if errors else "pending", fetch_start, sel=sel, failed=failed, detail=detail, errors=errors)
   805	
   806	
   807	def fetch_evidence(iss, rec, a):
   808	    """Fetch: the attempt's own proof (it must stamp SHA-256 of this attempt's A_sig), the full pinned, linked h..h+5
   809	    segment of every Bitcoin attestation, and the lowest qualifying height by the verifier's `select`. The wall
   810	    reading `fetch_start` is taken before anything is fetched (R5-F1). Every request is under the poll's deadline;
   811	    headers and calendar answers already obtained are kept, and OutOfBudget is raised (no classification, no
   812	    lifecycle write) when the evidence could not be fetched in this invocation.
   813	
   814	    ILC-I-05: the evidence already held is evaluated FIRST; if it already shows eligibility the attempt latches
   815	    without spending time on pending calendars. Otherwise pending calendars are asked, in turn from a durable cursor
   816	    (so a long list of slow calendars is served across invocations), and the evidence is evaluated again.
   817	
   818	    Classes: "elig" - the lowest qualifying presentation satisfies the three conjuncts; it is pruned to the qualifying
   819	    branches at its height (select's contradiction flag is honoured: contradicted branches are not part of it, and
   820	    the pruned presentation is re-checked contradiction-free). "neg" - COMPLETE evidence and that presentation fails a
   821	    conjunct. "invalid" - COMPLETE evidence in which EVERY Bitcoin attestation is contradicted by its pinned header
   822	    (ILI-03: conclusive invalid evidence, profile 7.1; reason EVIDENCE_CONTRADICTED). "err" / "pending" - anything
   823	    else; never evidence of absence."""
   824	    fetch_start = iss.clock()
   825	    rid, aid = rec["rid"], a["id"]
   826	    name = aid + "/receipt.upgraded.ots"
   827	    try:
   828	        a_sig = iss.results.get("work", rid, aid + "/a_sig")
   829	        held = iss.results.get("work", rid, name)
   830	        if held is None:
   831	            held = iss.results.get("work", rid, aid + "/receipt.ots")
   832	            if held is not None:
   833	                iss.results.put("work", rid, name, held)
