    poll(loc);assert get(loc,rid)['stage']=='snapshot'
    loc.world.chain.mine(20)
    loc.iss.dns.capture=lambda now:b'invalid DNS snapshot'
    for _ in range(4):poll(loc)
    r=get(loc,rid)
    print('IMPOSSIBILITY_NOT_REACHED',r['stage'],att(r)['state'],r['events'][-1])
    assert r['stage']=='snapshot' and att(r)['state']=='latched'

def test_original_reason_limit_through_external_response(loc,key):
    from test_lifecycle_repairs import test_ILI07_an_oversized_signer_reason_is_bounded_and_kept_by_reference as check
    check(loc,key)

def test_pending_calendar_order_starves_existing_eligible_proof(loc,key):
    _,rid=submit(loc,key);r=to_evidence(loc,rid);a=att(r);h=bury(loc,declared(a)+HOUR)
    raw,_=ots.upgrade(loc.iss.results.get('work',rid,'a1/receipt.ots'),loc.iss.calendars)
    digest,root=ots.parse_file(raw)
    class Pending:
        def __init__(self,i):self.uri=f'https://pending-{i}.invalid'
        def fetch(self,msg):loc.clock.advance(20);return None
    for i in range(12):
        cal=Pending(i);loc.iss.calendars.append(cal);root.att(ots.PENDING,ots.pending_payload(cal.uri))
    loc.iss.results.put('work',rid,'a1/receipt.upgraded.ots',ots.serialize_file(digest,root))
    for _ in range(3):poll(loc)
    r=get(loc,rid)
    print('PENDING_STARVATION',r['stage'],att(r)['state'])
    assert r['stage']=='evidence' and att(r)['state']=='open'
    # Sufficient qualifying evidence was already in hand throughout.
    hs=loc.iss.headers.headers(range(h,h+6))
    from tessera_issue.chain import pin_of
    from tessera_verify.anchors import select,parse_ots
    sel,_=select(parse_ots(raw),hs,{i:pin_of(x) for i,x in hs.items()})
    assert sel and pipeline.conjunct_failed(sel,declared(a)) is None
"""Scratch mutations of the issuer pipeline (model companions and ILI repairs). MUT selects one."""
import os
from types import SimpleNamespace
from tessera_issue import ots, pipeline, stores
from tessera_issue.lifecycle import B_of, current, DISCARDED, EXPIRED, new_attempt

MUT = os.environ.get("MUT")
real_fetch = pipeline.fetch_evidence

def fetch(iss, rec, a):
    ev = real_fetch(iss, rec, a)
    if MUT == "B1" and ev.cls == "pending" and ev.sel is not None and ev.failed:
        ev.cls = "neg"
    if MUT == "B1err" and ev.cls in ("pending", "err") and ev.sel is not None and ev.failed:
        ev.cls = "neg"
    if MUT == "B3" and ev.cls in ("err", "pending") and iss.clock() > B_of(a):
        ev.cls, ev.failed = "neg", "UNAVAILABLE_AS_FALSE"
    if MUT == "ILI03" and ev.cls == "invalid":            # complete contradiction treated as pending
        ev.cls = "pending"
    return ev
pipeline.fetch_evidence = fetch

if MUT == "B5":
    pipeline._fence = lambda iss, rec, now: None
if MUT == "GATE":
    real_ev = pipeline.STAGES["evidence"]
    def st(iss, rec, now):
        a = current(rec)
        if now > B_of(a) + 86400 and a["state"] == "open":
            return pipeline._end_attempt(iss, rec, EXPIRED, "EVIDENCE_UNAVAILABLE", now)
        return real_ev(iss, rec, now)
    pipeline.STAGES["evidence"] = st
if MUT == "SPLIT":
    def end(iss, rec, outcome, reason, now, extra=None, no_successor=None):
        g = stores.lifecycle_guard(rec)
        a = current(rec)
        a.update(state=outcome, end={"outcome": outcome.upper(), "reason": reason, "at": now})
        pipeline._commit(iss, rec, g)
        if rec["cur"] < 3:
            g = stores.lifecycle_guard(rec)
            rec["attempts"].append(new_attempt(rec["cur"] + 1, now)); rec.update(cur=rec["cur"] + 1, stage="frames")
            pipeline._commit(iss, rec, g)
    pipeline._end_attempt = end
if MUT == "NOPRUNE":
    ots.prune_to_height = lambda raw, h, merkle_root=None: (raw, 0)
if MUT == "ILI01_CONTRA":                              # prune by height only: contradicted branch kept
    real_prune = ots.prune_to_height
    ots.prune_to_height = lambda raw, h, merkle_root=None: real_prune(raw, h)
if MUT == "SWAP":
    real_pres = pipeline._preserved
    def pres(iss, rec, a):
        p = real_pres(iss, rec, a)
        raw = iss.results.get("work", rec["rid"], a["id"] + "/receipt.upgraded.ots")
        from tessera_issue.util import b64e
        p["ots"] = b64e(raw)
        return p
    pipeline._preserved = pres
if MUT == "DISCARDANY":                                # any pre-ship failure discards a latched attempt
    real_cls = pipeline.classify_preship
    def cls(ledger):
        kind, check = real_cls(ledger)
        return "frozen", check or SimpleNamespace(reason="ANY", row="0")
    pipeline.classify_preship = cls
if MUT == "ILI01_ROWS":                                # the frozen classification disabled: all retried
    pipeline.FROZEN_ROWS.clear()
if MUT == "ILI02_AGE":                                 # snapshot impossibility assumed from one SNAPSHOT_TIME
    pipeline._snapshot_impossible = lambda iss, rec, a, failure: (
        {"snapshot_reason": failure["reason"]} if failure and failure["reason"] == "SNAPSHOT_TIME" else None)
if MUT == "ILI04":                                     # closure decided before durable signatures are reconciled
    real_sign = pipeline.STAGES["signing"]
    def st(iss, rec, now):
        a = current(rec)
        if now > iss.window.sign_until and not all(j["sig_sha256"] for j in a["jobs"].values()):
            return pipeline._end_attempt(iss, rec, DISCARDED, "SIGNING_CLOSED", now)
        return real_sign(iss, rec, now)
    pipeline.STAGES["signing"] = st
if MUT == "ILI05_NOCACHE":
    real_put = None
    def headers(iss, rec, a, heights):
        out = {}
        for h in heights:
            pipeline._budget(iss).need(pipeline.HEADER_COST_S, "h")
            out[h] = iss.headers.headers([h])[h]
        return out
    pipeline._headers = headers
if MUT == "ILI05_NOCURSOR":
    stores.InMemoryRequestStore.cursor_get = lambda self: None
if MUT == "ILI07_RAW":
    pipeline._bounded = lambda raw: (raw, None)
if MUT == "ILI08":
    pipeline._recover_content = lambda iss, rec: None
if MUT == "APIWRITE":
    from tessera_issue import api
    real_status = api.status
    def status(iss, cred, key):
        r = real_status(iss, cred, key)
        rec = iss.requests.get(api.record_id(cred, key.lower()))
        if rec is not None:
            iss.requests.save(rec)
        return r
    api.status = status


import inspect, textwrap
from tessera_issue import deadline


def mutate(name, old, new):
    src = textwrap.dedent(inspect.getsource(getattr(pipeline, name)))
    assert old in src, (name, old)
    exec(compile(src.replace(old, new), "mut", "exec"), pipeline.__dict__)
    for k, v in list(pipeline.STAGES.items()):
        if v.__name__ == name:
            pipeline.STAGES[k] = pipeline.__dict__[name]


def bypass(kind):
    real = deadline.guarded
    def guarded(worst_s, fn, *a, what="", **kw):
        if what.startswith(kind):
            return fn(*a, **kw)
        return real(worst_s, fn, *a, what=what, **kw)
    deadline.guarded = guarded


if MUT and MUT.startswith("ILCI02_"):                  # one client kind bypasses the deadline guard
    bypass(MUT[len("ILCI02_"):].lower())
if MUT == "ILCI01":                                     # 13.5 (trust configuration) treated as snapshot bytes
    pipeline.SNAPSHOT_BYTES_ROWS.add("13.5")
if MUT == "ILCI03":                                     # no durable invalidation of a stale stored set
    mutate("_headers", 'iss.results.put("work", rid, f"{aid}/hdr/{h}", b"")', "pass")
if MUT == "ILCI04":                                     # the snapshot stage never evaluates impossibility
    mutate("st_snapshot", 'evidence = _snapshot_impossible(iss, rec, a, a.get("snapshot_failure"))', "evidence = None")
if MUT == "ILCI05_ORDER":                               # pending calendars asked before the held evidence counts
    src = textwrap.dedent(inspect.getsource(real_fetch))
    old = 'if ev.cls == "elig" or not proof.pending:'
    assert old in src
    ns = dict(pipeline.__dict__)
    exec(compile(src.replace(old, "if not proof.pending:"), "mut", "exec"), ns)
    real_fetch = ns["fetch_evidence"]
if MUT == "ILCI05_CURSOR":                              # every invocation restarts at the first pending calendar
    mutate("_upgrade", 'start = int(cur) if cur and cur.isdigit() else 0', "start = 0")

