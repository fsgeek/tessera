def test_dns_reuses_timeout_across_blocking_operations(monkeypatch):
    import socket
    from tessera_issue.dns import udp_tcp_transport,DnsError
    now=[0.0]
    monkeypatch.setattr(time,'monotonic',lambda:now[0])
    class Sock:
        def __enter__(self):return self
        def __exit__(self,*a):pass
        def settimeout(self,t):self.timeout=t
        def sendto(self,*a):now[0]+=.4
        def recvfrom(self,*a):now[0]+=.5;return b'\\x00\\x00\\x02\\x00'+b'\\x00'*8,('127.0.0.1',53)
        def sendall(self,*a):now[0]+=self.timeout
    udp=Sock();tcp=Sock()
    monkeypatch.setattr(socket,'socket',lambda *a:udp)
    def connect(*args,timeout):
