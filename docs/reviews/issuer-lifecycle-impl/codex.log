   338	def test_3_the_guard_is_state_attempt_id_and_version(kind):
   339	    st = InMemoryRequestStore() if kind == "memory" else DynamoRequestStore(FakeDynamo(), "t")
   340	    rec = {"rid": "r", "state": "ACCEPTED", "stage": "evidence", "expires_at": None, "cur": 1,
   341	           "attempts": [{"n": 1, "id": "a1", "state": "open"}]}
   342	    st.create(rec)
   343	    rec = st.get("r")
   344	    g = lifecycle_guard(rec)
