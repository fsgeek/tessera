    38	class LambdaTimeout(BaseException):
    39	    """The invocation is killed: nothing in the issuer can catch it."""
    40	
    41	
    42	# ------------------------------------------------------------------------------------------------ helpers
    43	def get(loc, rid):
    44	    return loc.iss.requests.get(rid)
    45	
    46	
    47	def att(rec, n=None):
    48	    return rec["attempts"][(n or rec["cur"]) - 1]
    49	
    50	
    51	def only_first_open(rec):
    52	    """Attempt 1 is still the current attempt, still open, and nothing was allocated after it."""
    53	    return rec["state"] == "ACCEPTED" and rec["cur"] == 1 and len(rec["attempts"]) == 1 \
    54	        and rec["attempts"][0]["state"] == "open"
    55	
    56	
    57	def declared(a):
    58	    return ts(a["declared_issue_time"])
    59	
    60	
    61	def poll(loc):
    62	    return pipeline.poll(loc.iss)
    63	
    64	
    65	def sign(loc):
    66	    for w in loc.workers.values():
    67	        w.process()
    68	
    69	
    70	def to_evidence(loc, rid):
    71	    """Frames, signatures and the stamps of the current attempt, with no block mined: the stamps stay pending."""
    72	    for _ in range(12):
    73	        rec = get(loc, rid)
    74	        if rec["state"] == "ACCEPTED" and rec["stage"] == "evidence":
    75	            return rec
    76	        sign(loc)
    77	        poll(loc)
    78	    raise AssertionError(("evidence stage not reached", rec["state"], rec["stage"], loc.iss.log[-3:]))
    79	
    80	
    81	def bury(loc, at, confirmed_at=None):
    82	    """Mine the block holding every pending commitment at wall time `at`, then five more; the sixth (h + 5) gets
    83	    time `confirmed_at` (default: at + 5). -> h."""
    84	    chain = loc.world.chain
    85	    loc.clock.t = at
    86	    h = chain.mine(1)
    87	    loc.clock.t = (confirmed_at - 4) if confirmed_at is not None else at
    88	    chain.mine(5)
    89	    assert confirmed_at is None or chain.blocks[h + 5]["time"] == confirmed_at
    90	    return h
    91	
    92	
    93	def run(loc, rid, max_polls=12):
    94	    """Poll (signers answering) until the request ends. -> record."""
    95	    for _ in range(max_polls):
    96	        rec = get(loc, rid)
    97	        if rec["state"] != "ACCEPTED":
    98	            return rec
    99	        sign(loc)
   100	        poll(loc)
   101	    return get(loc, rid)
   102	
   103	
   104	def saves(loc):
   105	    """Record every committed record version (deep copies), in order."""
   106	    store, seen = loc.iss.requests, []
   107	    real = store.save
   108	
   109	    def rec_save(rec, expect=None):
   110	        ok = real(rec, expect)
   111	        if ok:
   112	            seen.append(copy.deepcopy(rec))
   113	        return ok
   114	    store.save = rec_save
   115	    return seen
   116	
   117	
   118	def negative_then_next(loc, rid, at):
   119	    """Bury the current attempt's stamp late (T > declared + delta), poll once at `at` (>= the burial). -> record."""
   120	    rec = to_evidence(loc, rid)
   121	    a = att(rec)
   122	    bury(loc, declared(a) + DELTA + HOUR)
   123	    loc.clock.t = max(at, loc.clock())
   124	    poll(loc)
   125	    return get(loc, rid)
