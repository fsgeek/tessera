   316	def test_3_a_duplicate_end_and_allocate_write_fails_its_guard(loc, key):
   317	    """Resend: an ending write retried after an ambiguous response applies once; the retry fails its guard."""
   318	    _, rid = submit(loc, key)
   319	    rec = to_evidence(loc, rid)
   320	    store, dup = loc.iss.requests, []
   321	    real = store.save
   322	
   323	    def twice(rec, expect=None):
   324	        before = copy.deepcopy(rec)
   325	        ok = real(rec, expect)
   326	        if ok and rec["cur"] == 2 and not dup:
   327	            dup.append(real(before, expect))
   328	        return ok
   329	    store.save = twice
   330	    bury(loc, declared(att(rec)) + DELTA + HOUR)
   331	    poll(loc)
   332	    store.save = real
   333	    rec = get(loc, rid)
   334	    assert dup == [False] and len(rec["attempts"]) == 2 and rec["cur"] == 2
