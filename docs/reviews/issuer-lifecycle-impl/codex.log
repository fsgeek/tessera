   729	    on_time = w.accept_until + DELTA - HOUR                # both stamps are mined on time (within declared + delta;
   730	    loc.clock.t = on_time                                  # L1 now leaves delta + S + 24 h before the signing stop)
   731	    bury(loc, on_time)
   732	    loc.clock.t = w.sign_until + 2 * DAY                  # ... and first observed after the stop
   733	    poll(loc)
   734	    assert att(get(loc, r_latch))["state"] == "latched"
   735	    assert run(loc, r_latch)["state"] == "COMPLETE" and run(loc, r_open)["state"] == "COMPLETE"
