   228	def test_3_the_fence_commits_before_any_evidence_is_fetched(loc, key):
   229	    _, rid = submit(loc, key)
   230	    to_evidence(loc, rid)
   231	    order, store = [], loc.iss.requests
   232	    real_save, real_tip, real_fetch = store.save, loc.iss.headers.tip, loc.iss.calendars[0].fetch
   233	    store.save = lambda rec, expect=None: (order.append(("save", real_save(rec, expect))), order[-1][1])[1]
   234	    loc.iss.headers.tip = lambda: (order.append(("tip",)), real_tip())[1]
   235	    loc.iss.calendars[0].fetch = lambda m: (order.append(("calendar",)), real_fetch(m))[1]
   236	    poll(loc)
   237	    assert order[0] == ("save", True) and ("calendar",) in order
   238	    assert order.index(("save", True)) < order.index(("calendar",))
