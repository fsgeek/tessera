   758	def test_9_live_objects_are_never_marked_and_cleanup_marks_before_deleting(key):
   759	    from tessera_issue import local
   760	    from conftest import FROZEN
   761	    loc = local.build(FROZEN)
   762	    loc.iss.results = S3ResultStore(FakeS3(), "bucket")
   763	    loc.workers["kms"].fetch = loc.workers["gpg"].fetch = loc.iss.results.get_ref
   764	    s3 = loc.iss.results.c
   765	    _, rid = submit(loc, key)
   766	    a = att(to_evidence(loc, rid))
   767	    loc.clock.t = B_of(a) + 45 * DAY                      # far older than any former age rule
   768	    poll(loc)
   769	    live = [k for b, k in s3.objects if k.split("/")[1] == rid]
   770	    assert live and not [k for k in live if s3.tags.get(("bucket", k))]
   771	    order, real_delete = [], s3.delete_objects
   772	
   773	    def delete(**kw):
   774	        order.append(("delete", [o["Key"] for o in kw["Delete"]["Objects"]]))
   775	        for o in kw["Delete"]["Objects"]:
   776	            assert s3.tags.get(("bucket", o["Key"])) == {"cleanup-due": "true"}, o["Key"]
   777	        return real_delete(**kw)
   778	    s3.delete_objects = delete
   779	    bury(loc, loc.clock() + 60)                           # complete negative after B and after the signing stop
   780	    poll(loc)
   781	    rec = get(loc, rid)
   782	    assert rec["state"] == "REFUSED" and rec["reason"] == "SIGNING_CLOSED" and order
   783	    assert not [k for b, k in s3.objects if k.split("/")[1] == rid]
