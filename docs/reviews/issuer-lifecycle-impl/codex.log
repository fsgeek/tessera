    69	    def create(self, rec, tombstone_until=None):
    70	        """IS-04: the record and the key's tombstone are written in one transaction."""
    71	        rec["version"] = 1
    72	        items = [{"Put": {"TableName": self.t, "Item": self._item(rec),
    73	                          "ConditionExpression": "attribute_not_exists(pk)"}}]
    74	        if tombstone_until is not None:
    75	            items.append({"Put": {"TableName": self.t, "Item": {"pk": {"S": "KEY#" + rec["rid"]},
    76	                                                                "expires_at": {"N": str(tombstone_until)}}}})
    77	        try:
    78	            self.c.transact_write_items(TransactItems=items)
    79	            return True
    80	        except Exception as e:  # noqa: BLE001
    81	            if _transaction_conflict(e):
    82	                return False
    83	            raise
    84	
