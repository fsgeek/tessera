   527	# ------------------------------------------------------------------------------------------------ evidence (steps 3-5)
   528	def conjunct_failed(sel, declared):
   529	    """The three-conjunct temporal predicate of A2.1/A2.2 on a selected presentation (the verifier's rows 12.1-12.3,
   530	    all three; rows 12.2 and 12.3 alone are not the predicate). -> the first failing conjunct's code, or None."""
   531	    if not declared - EPS <= sel.time:
   532	        return "TIME_BEFORE_DECLARED_EPSILON"
   533	    if not sel.time <= declared + DELTA:
   534	        return "TIME_AFTER_DECLARED_DELTA"
   535	    if not sel.confirmed <= declared + DELTA:
   536	        return "CONFIRMATION_LATE"
   537	    return None
   538	
   539	
   540	@dataclass
   541	class Evidence:
   542	    """One Fetch for one attempt. cls: "elig" (the lowest qualifying presentation in hand satisfies the predicate),
   543	    "neg" (COMPLETE evidence and that presentation fails a conjunct), "err" (some part of the fetch failed) or
   544	    "pending" (anything else: a calendar not yet attested, a segment not yet buried k = 6, nothing qualifying).
   545	    Only "elig" and "neg" are successes; neither "err" nor "pending" is ever evidence of absence."""
   546	    cls: str
   547	    fetch_start: int
   548	    sel: object = None
   549	    failed: str = None
   550	    presentation: dict = None
   551	    detail: str = ""
   552	    errors: list = field(default_factory=list)
   553	
   554	
   555	def fetch_evidence(iss, rec, a):
   556	    """Fetch: upgrade the attempt's own proof (it must stamp SHA-256 of this attempt's A_sig), obtain the full pinned,
   557	    linked h..h+5 segment of every Bitcoin attestation, and select the lowest qualifying height with the verifier's
   558	    `select`. The wall reading `fetch_start` is taken before anything is fetched (R5-F1)."""
   559	    fetch_start = iss.clock()
   560	    rid, aid = rec["rid"], a["id"]
   561	    try:
   562	        raw = (iss.results.get("work", rid, aid + "/receipt.upgraded.ots")
   563	               or iss.results.get("work", rid, aid + "/receipt.ots"))
   564	        a_sig = iss.results.get("work", rid, aid + "/a_sig")
   565	        if raw is None or a_sig is None:
   566	            raise StageError("attempt material unavailable")
   567	        new, changed = ots.upgrade(raw, iss.calendars)
   568	        proof = parse_ots(new)
   569	        if proof.digest != sha256(a_sig):
   570	            return Evidence("err", fetch_start, detail="proof does not stamp this attempt's A_sig")
   571	        if changed:
   572	            iss.results.put("work", rid, aid + "/receipt.upgraded.ots", new)
   573	        tip = iss.headers.tip()
   574	    except Exception as e:  # noqa: BLE001  a failed fetch: never a negative
   575	        return Evidence("err", fetch_start, detail=f"{type(e).__name__}: {e}")
   576	    hdrs, missing, errors = {}, [], []
   577	    for h in sorted({x.height for x in proof.bitcoin}):
   578	        if h + K - 1 > tip:
   579	            missing.append(h)                          # not yet buried k deep: the segment does not exist yet
   580	            continue
   581	        try:
   582	            seg = iss.headers.headers(list(range(h, h + K)))
   583	            if sorted(seg) != list(range(h, h + K)):
   584	                raise ValueError("incomplete segment")
   585	            check_links(seg)
   586	            hdrs.update(seg)
   587	        except Exception as e:  # noqa: BLE001
   588	            errors.append(f"{h}: {type(e).__name__}: {e}")
   589	    sel, _ = select(proof, hdrs, {h: pin_of(v) for h, v in hdrs.items()})
   590	    declared = ts(a["declared_issue_time"])
   591	    failed = conjunct_failed(sel, declared) if sel is not None else None
   592	    if sel is not None and failed is None:
   593	        pruned = ots.prune_to_height(new, sel.height)
   594	        seg = {i: hdrs[i] for i in range(sel.height, sel.height + K)}
   595	        check, _ = select(parse_ots(pruned), seg, {i: pin_of(v) for i, v in seg.items()})
   596	        if check is None or (check.height, check.time, check.confirmed) != (sel.height, sel.time, sel.confirmed):
   597	            return Evidence("err", fetch_start, detail="pruned presentation does not reproduce the selection")
   598	        pres = {"format": "tessera-v1-issuer-presentation/1", "attempt": aid, "a_sig_sha256": sha256hex(a_sig),
   599	                "ots": b64e(pruned), "height": sel.height, "T": sel.time, "confirmed_at": sel.confirmed,
   600	                "headers": {str(i): v.hex() for i, v in sorted(seg.items())}}
   601	        return Evidence("elig", fetch_start, sel=sel, presentation=pres)
   602	    complete = bool(proof.bitcoin) and not proof.pending and not missing and not errors
   603	    if complete and sel is not None:
   604	        return Evidence("neg", fetch_start, sel=sel, failed=failed)
   605	    detail = (f"pending calendars {len(proof.pending)}, unburied {missing}, "
   606	              f"{'no qualifying height' if sel is None else 'selected fails ' + str(failed)}")
   607	    return Evidence("err" if errors else "pending", fetch_start, sel=sel, failed=failed, detail=detail, errors=errors)
   608	
   609	
   610	def _add_interval(a, idx):
   611	    """Diagnostic failure history (gated step 5: behind no behaviour). failed_intervals holds runs [first, last] of
   612	    absolute interval indices (fetch_start // POLL_INTERVAL_S), each interval at most once. -> True if changed."""
   613	    runs = [list(r) for r in a.get("failed_intervals") or []]
   614	    if any(lo <= idx <= hi for lo, hi in runs):
   615	        return False
   616	    runs.append([idx, idx])
   617	    runs.sort()
   618	    merged = []
   619	    for lo, hi in runs:
   620	        if merged and lo <= merged[-1][1] + 1:
   621	            merged[-1][1] = max(merged[-1][1], hi)
   622	        else:
   623	            merged.append([lo, hi])
   624	    if len(merged) > FAILED_INTERVAL_RUNS:
   625	        a["failed_intervals_dropped"] = a.get("failed_intervals_dropped", 0) + len(merged) - FAILED_INTERVAL_RUNS
   626	        merged = merged[-FAILED_INTERVAL_RUNS:]
   627	    a["failed_intervals"] = merged
   628	    return True
   629	
   630	
   631	def st_evidence(iss, rec, now):
   632	    """An OPEN attempt: Fence, Fetch, Send. Latch on eligibility; end only on complete negative evidence (discard at or
   633	    before B, expire after B); otherwise stay open, recording the failure history after B for diagnosis only."""
   634	    a = current(rec)
   635	    _fence(iss, rec, now)                             # Fence: committed before any fetch
   636	    ev = fetch_evidence(iss, rec, a)                  # Fetch
   637	    now = iss.clock()                                 # Send: the decision's reading
   638	    if ev.cls == "elig":
   639	        return _latch(iss, rec, a, ev, now)
   640	    if ev.cls == "neg":
   641	        return _end_attempt(iss, rec, DISCARDED if now <= B_of(a) else EXPIRED, ev.failed, now)
   642	    if ev.fetch_start > B_of(a):                      # only fetches that STARTED after B count (R5-F1)
   643	        g = lifecycle_guard(rec)
   644	        changed = a.get("unavailable_since") is None
   645	        if changed:
   646	            a["unavailable_since"] = ev.fetch_start
   647	        changed = _add_interval(a, ev.fetch_start // POLL_INTERVAL_S) or changed
   648	        if changed:
   649	            a["last_failed_fetch"] = {"at": ev.fetch_start, "class": ev.cls, "detail": ev.detail[:300]}
   650	            _commit(iss, rec, g)                      # diagnostic only; no decision reads it while step 5 is gated
   651	
   652	
   653	def _latch(iss, rec, a, ev, now):
   654	    """Latch (A2.1; design step 3): written whenever eligibility is observed while the attempt is open, with
   655	    observed_at and the qualifying presentation itself. The presentation is an immutable, digest-named object written
   656	    BEFORE the latch commits its reference (no transaction spans DynamoDB and S3; the item limit is 400 KB)."""
   657	    body = json.dumps(ev.presentation, sort_keys=True, separators=(",", ":")).encode()
   658	    digest = sha256hex(body)
   659	    name = f"{a['id']}/presentation-{digest}"
   660	    iss.results.put("work", rec["rid"], name, body)
   661	    g = lifecycle_guard(rec)
   662	    a.update(state=LATCHED, unavailable_since=None, failed_intervals=[],
   663	             latch={"observed_at": now, "fetch_start": ev.fetch_start, "ref": name, "sha256": digest,
   664	                    "height": ev.sel.height, "T": ev.sel.time, "confirmed_at": ev.sel.confirmed})
   665	    rec["stage"] = "finalize"
   666	    _event(rec, now, "latched", a["id"], ev.sel.height, rfc3339(ev.sel.time))
   667	    _commit(iss, rec, g)
   668	
   669	
   670	# ------------------------------------------------------------------------------------------------ after the latch (step 7)
   671	def _preserved(iss, rec, a):
   672	    lt = a["latch"]
   673	    body = iss.results.get("work", rec["rid"], lt["ref"])
   674	    if body is None or sha256hex(body) != lt["sha256"]:
   675	        raise StageError("preserved presentation unavailable; retried")
   676	    return json.loads(body)
   677	
   678	
   679	def st_finalize(iss, rec, now):
   680	    """A LATCHED attempt. Transient failures (store, explorer, calendar, DNS, pre-ship engine) are retried; it is
