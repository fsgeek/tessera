   196	class S3ResultStore(ResultStore):
   197	    """Receipt URLs (IS-06): short-lived (<= 300 s) pre-signed GETs, minted per request after the API's credential check."""
   198	
   199	    def __init__(self, client, bucket):
   200	        self.c, self.b = client, bucket
   201	
   202	    @staticmethod
   203	    def key(ns, rid, name):
   204	        if ns not in NAMESPACES:
   205	            raise ValueError(ns)
   206	        return f"{ns}/{rid}/{name}"
   207	
   208	    def put(self, ns, rid, name, data):
   209	        self.c.put_object(Bucket=self.b, Key=self.key(ns, rid, name), Body=bytes(data), ServerSideEncryption="AES256")
   210	
   211	    def get(self, ns, rid, name):
   212	        try:
   213	            return self.c.get_object(Bucket=self.b, Key=self.key(ns, rid, name))["Body"].read()
   214	        except Exception as e:  # noqa: BLE001
   215	            if _not_found(e):
   216	                return None
   217	            raise
   218	
   219	    DELETE_ROUNDS = 20                                # CF-04: listing pages (<= 1000 keys each) per call
   220	
   221	    def delete(self, ns, rid):
   222	        """Delete everything under (ns, rid). Raises on any per-object error S3 reports inside a successful
   223	        DeleteObjects response, and after DELETE_ROUNDS pages, so one obligation can never hold the poller (CF-04);
   224	        the caller keeps the obligation and the next poll continues."""
   225	        prefix = self.key(ns, rid, "")
   226	        for _ in range(self.DELETE_ROUNDS):           # list from the start each round: deleting never skips keys
   227	            keys = [{"Key": o["Key"]} for o in self.c.list_objects_v2(Bucket=self.b, Prefix=prefix).get("Contents", [])]
   228	            if not keys:
   229	                return
   230	            r = self.c.delete_objects(Bucket=self.b, Delete={"Objects": keys, "Quiet": True}) or {}
   231	            errors = r.get("Errors") or []
   232	            if errors:
   233	                e = errors[0]
   234	                raise OSError(f"S3 could not delete {len(errors)} object(s) under {prefix}: "
   235	                              f"{e.get('Key')} {e.get('Code')} {e.get('Message', '')}".rstrip())
   236	        raise OSError(f"deletion under {prefix} not finished after {self.DELETE_ROUNDS} rounds; continued next poll")
   237	
   238	    def names(self, ns, rid):
   239	        prefix, out, token = self.key(ns, rid, ""), [], None
   240	        while True:
   241	            kw = {"Bucket": self.b, "Prefix": prefix}
   242	            if token:
   243	                kw["ContinuationToken"] = token
   244	            r = self.c.list_objects_v2(**kw)
   245	            out += [o["Key"][len(prefix):] for o in r.get("Contents", [])]
   246	            token = r.get("NextContinuationToken")
   247	            if not token:
   248	                return sorted(out)
   249	
   250	    def mark_due(self, ns, rid):
   251	        """Tag every object under (ns, rid) cleanup-due (5.3.1); the lifecycle backstop expires only tagged objects.
   252	        A per-object error raises, and the obligation is retried."""
   253	        for name in self.names(ns, rid):
   254	            self.c.put_object_tagging(Bucket=self.b, Key=self.key(ns, rid, name),
   255	                                      Tagging={"TagSet": [{"Key": CLEANUP_TAG[0], "Value": CLEANUP_TAG[1]}]})
   256	
   257	    def size(self, ns, rid, name):
   258	        try:
   259	            return int(self.c.head_object(Bucket=self.b, Key=self.key(ns, rid, name))["ContentLength"])
   260	        except Exception as e:  # noqa: BLE001
   261	            if _not_found(e):
   262	                return None
   263	            raise
   264	
   265	    def presign(self, ns, rid, name, expires_in, now):
   266	        return self.c.generate_presigned_url(
   267	            "get_object", Params={"Bucket": self.b, "Key": self.key(ns, rid, name)}, ExpiresIn=int(expires_in))
   268	
   269	    def get_config(self, name):
   270	        return self.c.get_object(Bucket=self.b, Key="config/" + name)["Body"].read()
