   179	def test_1_a_late_response_for_another_attempt_is_logged_and_ignored(loc, key):
   180	    _, rid = submit(loc, key)
   181	    kms, gpg = loc.workers["kms"], loc.workers["gpg"]
   182	    poll(loc)                                            # attempt 1: frames sent
   183	    skew = gpg.clock
   184	    gpg.clock = lambda: loc.clock() + 2 * DAY            # attempt 1's gpg attestation is refused (epsilon)
   185	    gpg.process()
   186	    gpg.clock = skew
   187	    poll(loc)                                            # the refusal discards attempt 1; attempt 2 is allocated
   188	    rec = get(loc, rid)
   189	    assert att(rec, 1)["state"] == "discarded" and att(rec, 1)["end"]["reason"].startswith("SIGNER_REFUSED:")
   190	    assert rec["cur"] == 2
   191	    poll(loc)                                            # attempt 2's frames are sent
   192	    a1_ids = {j["request_id"] for j in att(get(loc, rid), 1)["jobs"].values()}
   193	    sign(loc)                                            # kms now answers attempt 1's requests late, and attempt 2's
   194	    poll(loc)
   195	    rec = get(loc, rid)
   196	    log = loc.iss.requests.siglog()
   197	    late = [e for e in log if e["request_id"] in a1_ids and e["status"] == "SIGNED"]
   198	    assert late and all(e["disposition"] == "other-attempt" for e in late)
   199	    a2 = att(rec, 2)
   200	    used = {(e["request_id"], e["signature_sha256"]) for e in log if e["disposition"] == "used"}
   201	    for j in a2["jobs"].values():
   202	        assert j["request_id"] not in a1_ids
   203	        assert j["sig_sha256"] is None or (j["request_id"], j["sig_sha256"]) in used
   204	    assert rec["stage"] in ("stamp", "evidence")
