   356	def test_4_latch_on_k6_and_three_conjuncts_with_the_preserved_presentation(loc, key):
   357	    _, rid = submit(loc, key)
   358	    rec = to_evidence(loc, rid)
   359	    a = att(rec)
   360	    h = bury(loc, declared(a) + HOUR)
   361	    loc.clock.advance(60)
   362	    poll(loc)
   363	    rec = get(loc, rid)
   364	    a = att(rec)
   365	    assert a["state"] == "latched" and rec["stage"] == "finalize"
   366	    lt = a["latch"]
   367	    assert lt["observed_at"] == loc.clock() and lt["height"] == h
   368	    assert lt["T"] == loc.world.chain.blocks[h]["time"] and lt["confirmed_at"] == loc.world.chain.blocks[h + 5]["time"]
   369	    body = loc.iss.results.get("work", rid, lt["ref"])
   370	    assert body is not None and lt["ref"].startswith("a1/presentation-")
   371	    pres = json.loads(body)
   372	    hdrs = {int(k): bytes.fromhex(v) for k, v in pres["headers"].items()}
   373	    assert sorted(hdrs) == list(range(h, h + 6))
   374	    proof = parse_ots(b64d(pres["ots"]))
   375	    assert proof.digest == sha256(loc.iss.results.get("work", rid, "a1/a_sig")) and not proof.pending
   376	    sel, _ = select(proof, hdrs, {k: pin_of(v) for k, v in hdrs.items()})
   377	    assert (sel.height, sel.time, sel.confirmed) == (h, lt["T"], lt["confirmed_at"])
