   284	            if frame is None or sha256hex(frame) != job["frame_sha256"] or not signer.verify(frame, sig):
   285	                entry["disposition"] = "bad-signature"
   286	            else:
   287	                entry["disposition"] = "used"
   288	                iss.requests.siglog_add(entry)         # IS-01: durable in the log before it can be used
   289	                iss.results.put("work", rec["rid"], f"{a['id']}/" + sig_name(idx["job"], entry["signature_sha256"]),
   290	                                sig)
   291	                outcome = _record_signature(iss, idx["rid"], a["id"], idx["job"], entry["signature_sha256"], srid,
   292	                                            now)
   293	                if outcome != "used":                  # IS-08: say what became of it
   294	                    iss.requests.siglog_add(dict(entry, disposition="superseded:" + outcome))
   295	                return
   296	    iss.requests.siglog_add(entry)
