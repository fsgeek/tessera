    61	class Node:
    62	    """A timestamp node: items are ("att", tag, payload) or ("op", opcode, arg, child)."""
    63	
    64	    def __init__(self):
    65	        self.items = []
    66	
    67	    def op(self, opcode, arg=b""):
    68	        for it in self.items:
    69	            if it[0] == "op" and it[1] == opcode and it[2] == arg:
    70	                return it[3]
    71	        child = Node()
    72	        self.items.append(("op", opcode, arg, child))
    73	        return child
    74	
    75	    def att(self, tag, payload):
    76	        if ("att", tag, payload) not in self.items:
    77	            self.items.append(("att", tag, payload))
    78	
    79	    def merge(self, other):
    80	        for it in other.items:
    81	            if it[0] == "att":
    82	                self.att(it[1], it[2])
    83	            else:
    84	                self.op(it[1], it[2]).merge(it[3])
    85	
    86	    def ser(self):
    87	        out = b""
    88	        for i, it in enumerate(self.items):
    89	            if i < len(self.items) - 1:
    90	                out += b"\xff"
    91	            if it[0] == "att":
    92	                out += b"\x00" + it[1] + _varbytes(it[2])
    93	            else:
    94	                out += bytes([it[1]]) + (_varbytes(it[2]) if it[1] != 0x08 else b"") + it[3].ser()
    95	        return out
    96	
