   134	def parse_file(raw):
   135	    """-> (digest, root Node)."""
   136	    if not raw.startswith(MAGIC) or raw[len(MAGIC):len(MAGIC) + 2] != b"\x01\x08":
   137	        raise OtsError("not an OTS file of major version 1 with a SHA-256 file hash")
   138	    i = len(MAGIC) + 2
   139	    return raw[i:i + 32], parse_timestamp(raw[i + 32:])
