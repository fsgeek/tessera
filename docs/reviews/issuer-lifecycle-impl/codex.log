   355	# ------------------------------------------------------------------------------------------------ stages
   356	def st_upload(iss, rec, now):
   357	    """IS-05: the API created the record before storing the content. Proceed once the content is there; an upload
   358	    abandoned past the grace period fails the request (no attempt exists yet)."""
   359	    content = iss.results.get("content", rec["rid"], content_name(rec["content_sha256"]))
   360	    g = lifecycle_guard(rec)
   361	    if content is not None and sha256hex(content) == rec["content_sha256"]:
   362	        rec["stage"] = "frames"
   363	        return _commit(iss, rec, g)
   364	    if now - rec["created_at"] >= UPLOAD_GRACE_S:
   365	        return _end_request(iss, rec, g, "FAILED", "CONTENT_UNAVAILABLE", now)
   366	
   367	
   368	def st_frames(iss, rec, now):
   369	    w = iss.window
   370	    if not rec.get("cur"):                           # Start: attempt 1 (a lifecycle transition; the poller's only)
   371	        g = lifecycle_guard(rec)
   372	        if now > w.sign_until:
   373	            return _end_request(iss, rec, g, "REFUSED", "SIGNING_CLOSED", now)
   374	        rec.update(attempts=[new_attempt(1, now)], cur=1)
   375	        _event(rec, now, "allocated", "a1")
   376	        _commit(iss, rec, g)
   377	    a = current(rec)
   378	    if now > w.sign_until:                           # this attempt would be signed after the stop
   379	        return _end_attempt(iss, rec, DISCARDED, "SIGNING_CLOSED", now)
   380	    content = iss.results.get("content", rec["rid"], content_name(rec["content_sha256"]))
   381	    if content is None or sha256hex(content) != rec["content_sha256"]:
   382	        return _end_request(iss, rec, lifecycle_guard(rec), "FAILED", "CONTENT_UNAVAILABLE", now)
   383	    aid, declared = a["id"], a["declared_issue_time"]
   384	    manifest = encode_manifest(w.kms_fp, w.gpg_fp)
   385	    common = common_metadata(b64e(content), declared, manifest, iss.frozen.catalog)
   386	    frames = {"manifest": manifest, "f_kms": encode_attest(common, w.kms_fp), "f_gpg": encode_attest(common, w.gpg_fp)}
   387	    for name, data in frames.items():
   388	        iss.results.put("work", rec["rid"], f"{aid}/{name}", data)
   389	    jobs = {}
   390	    for job, slot, fname in JOBS:
   391	        srid = request_id(f"{rec['rid']}/{aid}", slot, frames[fname])
   392	        jobs[job] = {"slot": slot, "frame": fname, "frame_sha256": sha256hex(frames[fname]), "request_id": srid,
   393	                     "sent_at": now, "attempts": 1, "sig_sha256": None}
   394	        iss.requests.sigreq_put(srid, {"rid": rec["rid"], "attempt": aid, "job": job, "slot": slot,
   395	                                       "frame_sha256": jobs[job]["frame_sha256"]}, now + RETENTION_S)
   396	    g = lifecycle_guard(rec)
   397	    a["jobs"] = jobs
   398	    rec["stage"] = "signing"
   399	    _event(rec, now, "frames", aid, declared)
   400	    _commit(iss, rec, g)                             # durable before anything is sent
   401	    for job, _, _ in JOBS:
   402	        _send(iss, rec, a, job)
   403	    for slot in iss.signers:
   404	        iss.signers[slot].wake()                     # E-01: started on demand, once per batch
   405	
   406	
   407	def st_signing(iss, rec, now):
   408	    a = current(rec)
   409	    jobs = a["jobs"]
   410	    if all(j["sig_sha256"] for j in jobs.values()):
   411	        return _seal(iss, rec, a, now)
   412	    if now > iss.window.sign_until:                  # still needs signing after the stop (never a stamped attempt)
   413	        return _end_attempt(iss, rec, DISCARDED, "SIGNING_CLOSED", now)
   414	    g = lifecycle_guard(rec)
   415	    if _reconcile(iss, rec, a):                      # IS-08: verified and logged, but its record update was lost
   416	        _event(rec, now, "reconciled", a["id"])
   417	        return _commit(iss, rec, g)
   418	    resend = [(k, j) for k, j in jobs.items() if not j["sig_sha256"] and now - j["sent_at"] >= iss.signer_retry_s]
   419	    if not resend:
   420	        return
   421	    for k, j in resend:
   422	        j.update(sent_at=now, attempts=j["attempts"] + 1)
   423	        iss.requests.sigreq_put(j["request_id"], {"rid": rec["rid"], "attempt": a["id"], "job": k, "slot": j["slot"],
   424	                                                  "frame_sha256": j["frame_sha256"]}, now + RETENTION_S)
   425	    _event(rec, now, "resend", a["id"], [k for k, _ in resend])
   426	    _commit(iss, rec, g)
   427	    slots = set()
   428	    for k, j in resend:                               # E-02: the same request id; a late first answer still counts
   429	        _send(iss, rec, a, k)
   430	        slots.add(j["slot"])
   431	    for s in slots:
   432	        iss.signers[s].wake()
   433	
   434	
   435	def _seal(iss, rec, a, now):
   436	    """Profile 4 steps 4-6: verify each signature on the exact bytes, freeze, build A_sig, check it (A9.5: the
   437	    signatures are frozen before the attempt is stamped)."""
   438	    rid, aid = rec["rid"], a["id"]
   439	    get = lambda n: iss.results.get("work", rid, f"{aid}/{n}")  # noqa: E731
   440	    sigs = {}
   441	    for job, j in a["jobs"].items():
   442	        s, f = get(sig_name(job, j["sig_sha256"])), get(j["frame"])
   443	        if (s is None or sha256hex(s) != j["sig_sha256"] or not iss.signers[j["slot"]].verify(f, s)
   444	                or not iss.requests.siglog_has(j["request_id"], j["sig_sha256"])):     # IS-01
   445	            g = lifecycle_guard(rec)
   446	            j["sig_sha256"] = None                     # lost or corrupt: ask again with the same id
   447	            j["sent_at"] = 0
   448	            return _commit(iss, rec, g)
   449	        sigs[job] = s
   450	    a_sig = encode_anchor(get("f_kms"), sigs["s_kms"], get("f_gpg"), sigs["s_gpg"])
   451	    try:
   452	        for (f, obj, s, _), slot in zip(read_anchor(a_sig, registered_codecs(ALG)), ("kms", "gpg")):
   453	            if not iss.signers[slot].verify(f, s) or obj["common"]["manifest_sha256"] != sha256hex(get("manifest")):
   454	                raise StageError("A_sig check")
   455	        read_frame(get("manifest"), "tessera-v1/manifest")
   456	    except Fault as e:
   457	        raise StageError("A_sig decode: " + e.code) from None
   458	    iss.results.put("work", rid, f"{aid}/a_sig", a_sig)
   459	    g = lifecycle_guard(rec)
   460	    a["receipt_id"] = sha256hex(a_sig)
   461	    rec["stage"] = "stamp"
   462	    _event(rec, now, "a_sig", aid, a["receipt_id"])
   463	    _commit(iss, rec, g)
   464	
   465	
   466	def _validate_snapshot_now(iss, body, now):
   467	    """Issuer pre-stamp check with the verifier's DNSSEC code: wildcard-free, every chain group valid now, and the
   468	    TXT value equal to the window's assertion."""
   469	    try:
   470	        snap = parse_snapshot(body)
   471	        if snap.wildcard:
   472	            return "DNS_WILDCARD"
   473	        config = check_config(iss.window.trust_base, {}, rfc3339(now))
   474	        bad = [a.reason or a.status for a in validate_snapshot(snap, config, now) if a.status != "pass"]
   475	        if bad:
   476	            return bad[0]
   477	        if snap.txt is None or txt_value([r.data for r in snap.txt.rr])["_raw"] != iss.window.assertion:
   478	            return "DNS_VALUE_DIFFERS"
   479	    except Fault as e:
   480	        return e.code
   481	    return None
   482	
   483	
   484	def _capture_snapshot(iss, rec, a, now):
   485	    """Capture, validate and stamp the DNSSEC snapshot for attempt a. -> True when stored (proofs updated in rec,
   486	    not yet committed); False after committing a 'snapshot-rejected' event (recapture next tick)."""
   487	    body = iss.dns.capture(now)
   488	    problem = _validate_snapshot_now(iss, body, now)
   489	    if problem:
   490	        g = lifecycle_guard(rec)
   491	        _event(rec, now, "snapshot-rejected", a["id"], problem)
   492	        _commit(iss, rec, g)
   493	        return False
   494	    env = encode_snapshot_envelope(body)
   495	    raw = ots.stamp(sha256(env), iss.calendars, iss.nonce())
   496	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.body", body)
   497	    iss.results.put("work", rec["rid"], f"{a['id']}/snapshot.ots", raw)
   498	    a["proofs"]["snapshot"] = {"stamped_at": now}
   499	    return True
   500	
   501	
   502	def st_stamp(iss, rec, now):
   503	    tip = iss.headers.tip()
   504	    if tip < iss.window.h_git + 5:                     # chain-order pre-commitment (profile 4, 6.3)
   505	        return
   506	    a = current(rec)
   507	    proofs = a["proofs"]
   508	    if "receipt" not in proofs:                        # A9.5: a fresh stamp of this attempt's own A_sig
   509	        raw = ots.stamp(sha256(iss.results.get("work", rec["rid"], f"{a['id']}/a_sig")), iss.calendars, iss.nonce())
   510	        iss.results.put("work", rec["rid"], f"{a['id']}/receipt.ots", raw)       # immutable once committed
   511	        g = lifecycle_guard(rec)
   512	        proofs["receipt"] = {"stamped_at": now, "tip": tip}
   513	        _event(rec, now, "stamped", a["id"], "receipt")
   514	        _commit(iss, rec, g)
   515	    if "snapshot" not in proofs:
   516	        g = lifecycle_guard(rec)
   517	        if not _capture_snapshot(iss, rec, a, now):
   518	            return
   519	        _event(rec, now, "stamped", a["id"], "snapshot")
   520	        rec["stage"] = "evidence"
   521	        return _commit(iss, rec, g)
   522	    g = lifecycle_guard(rec)
   523	    rec["stage"] = "evidence"
   524	    _commit(iss, rec, g)
