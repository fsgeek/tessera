   224	
   225	# ------------------------------------------------------------------------------------------------ E-02 drain
   226	def drain(iss, max_batches=50):
   227	    """Read every slot's response queue. Every response is logged (request id, slot, status, frame hash when the
   228	    id is known, signature hash) whether or not it is used, and then deleted from the queue."""
   229	    n = 0
   230	    for slot, signer in iss.signers.items():
   231	        for _ in range(max_batches):
   232	            batch = signer.receive(10)
   233	            if not batch:
   234	                break
   235	            for handle, body in batch:
   236	                try:
   237	                    _take(iss, slot, signer, body)
   238	                except Exception as e:  # noqa: BLE001  not acknowledged: the queue delivers it again
   239	                    iss.note("response", slot, "not taken:", type(e).__name__, e)
   240	                    continue
   241	                signer.ack(handle)
   242	                n += 1
   243	    return n
   244	
   245	
   246	def _take(iss, slot, signer, body):
   247	    """Route one signer response by (request, ATTEMPT, job). A response for an attempt that is not the request's
   248	    current one is logged ("other-attempt") and ignored: it can never fill another attempt (step 2)."""
   249	    now = iss.clock()
   250	    srid = body.get("request_id")
   251	    idx = iss.requests.sigreq_get(srid) if isinstance(srid, str) else None
   252	    sig = None
   253	    if body.get("status") == "SIGNED":
   254	        try:
   255	            sig = b64d(body.get("sig_b64", ""))
   256	        except (ValueError, TypeError):
   257	            sig = None
   258	    entry = {"at": rfc3339(now), "slot": slot, "request_id": srid, "status": body.get("status"),
   259	             "reason": body.get("reason"), "frame_sha256": idx["frame_sha256"] if idx else None,
   260	             "signature_sha256": sha256hex(sig) if sig is not None else None, "disposition": None,
   261	             "attempt": idx.get("attempt") if idx else None}
   262	    if idx is None or idx.get("slot") != slot:
   263	        entry["disposition"] = "unrequested"
   264	    else:
   265	        rec = iss.requests.get(idx["rid"])
   266	        a = current(rec) if rec else None
   267	        job = a["jobs"].get(idx["job"]) if a else None
   268	        if rec is None or rec["state"] != "ACCEPTED":
   269	            entry["disposition"] = "not-waiting"
   270	        elif a is None or a["id"] != idx.get("attempt"):
   271	            entry["disposition"] = "other-attempt"
   272	        elif rec["stage"] != "signing" or a["state"] != OPEN or job is None:
   273	            entry["disposition"] = "not-waiting"
   274	        elif job.get("sig_sha256"):
   275	            entry["disposition"] = "duplicate"
   276	        elif body.get("status") == "REFUSED":
   277	            entry["disposition"] = "refused"
   278	            iss.requests.siglog_add(entry)
   279	            return _end_attempt(iss, rec, DISCARDED, "SIGNER_REFUSED:" + str(body.get("reason")), now)
   280	        elif sig is None:
   281	            entry["disposition"] = "malformed"
   282	        else:
   283	            frame = iss.results.get("work", rec["rid"], f"{a['id']}/{job['frame']}")
   284	            if frame is None or sha256hex(frame) != job["frame_sha256"] or not signer.verify(frame, sig):
   285	                entry["disposition"] = "bad-signature"
   286	            else:
   287	                entry["disposition"] = "used"
   288	                iss.requests.siglog_add(entry)         # IS-01: durable in the log before it can be used
   289	                iss.results.put("work", rec["rid"], f"{a['id']}/" + sig_name(idx["job"], entry["signature_sha256"]),
   290	                                sig)
   291	                outcome = _record_signature(iss, idx["rid"], a["id"], idx["job"], entry["signature_sha256"], srid,
   292	                                            now)
   293	                if outcome != "used":                  # IS-08: say what became of it
   294	                    iss.requests.siglog_add(dict(entry, disposition="superseded:" + outcome))
   295	                return
   296	    iss.requests.siglog_add(entry)
