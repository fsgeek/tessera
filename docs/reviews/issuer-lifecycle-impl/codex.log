   155	def walk(node, msg):
   156	    """Yield (node, message at node)."""
   157	    stack = [(node, msg)]
   158	    while stack:
   159	        n, m = stack.pop()
   160	        yield n, m
   161	        for it in n.items:
   162	            if it[0] == "op":
   163	                stack.append((it[3], apply(it[1], it[2], m)))
