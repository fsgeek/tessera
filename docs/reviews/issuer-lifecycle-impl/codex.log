   217	def prune_to_height(raw, height):
   218	    """Keep only the branches ending in a Bitcoin attestation at `height`. The preserved presentation of a latch is
   219	    pruned this way, so whatever headers later travel with it, its lowest qualifying height (and so T) cannot move to
   220	    another attestation (profile 7.1: T is presentation-sensitive). -> file bytes."""
   221	    digest, root = parse_file(raw)
   222	
   223	    def keep(node):
   224	        items = []
   225	        for it in node.items:
   226	            if it[0] == "att":
   227	                if it[1] == BTC and _Reader(it[2]).varuint() == height:
   228	                    items.append(it)
   229	            elif keep(it[3]):
   230	                items.append(it)
   231	        node.items = items
   232	        return bool(items)
   233	    if not keep(root):
   234	        raise OtsError(f"no Bitcoin attestation at height {height}")
   235	    return serialize_file(digest, root)
