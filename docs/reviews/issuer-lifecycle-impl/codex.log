    51	    GUARD_ATTRS = (("state", "lstate"), ("attempt", "latt"), ("astate", "lastate"))
    52	
    53	    def _item(self, rec):
    54	        item = {"pk": {"S": "REQ#" + rec["rid"]}, "doc": {"S": json.dumps(rec, sort_keys=True)},
    55	                "version": {"N": str(rec["version"])}}
    56	        g = lifecycle_guard(rec)
    57	        for field, attr in self.GUARD_ATTRS:
    58	            item[attr] = {"S": str(g[field] or "")}
