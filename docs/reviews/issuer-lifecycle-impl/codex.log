   155	def test_1_attempts_have_their_own_declared_time_frames_jobs_stamp_and_evidence(loc, key):
   156	    _, rid = submit(loc, key)
   157	    rec = to_evidence(loc, rid)
   158	    a1 = att(rec)
   159	    assert rec["cur"] == 1 and a1["id"] == "a1" and a1["state"] == "open"
   160	    loc.clock.advance(HOUR)
   161	    rec = negative_then_next(loc, rid, declared(a1) + DELTA + 2 * HOUR)
   162	    assert att(rec, 1)["state"] == "discarded" and rec["cur"] == 2
   163	    rec = to_evidence(loc, rid)
   164	    a1, a2 = att(rec, 1), att(rec, 2)
   165	    assert a2["id"] == "a2" and declared(a2) > declared(a1)
   166	    names = loc.iss.results.names("work", rid)
   167	    n1, n2 = {n for n in names if n.startswith("a1/")}, {n for n in names if n.startswith("a2/")}
   168	    assert n1 and n2 and not [n for n in names if not n.startswith(("a1/", "a2/"))]
   169	    for name in ("manifest", "f_kms", "f_gpg", "a_sig", "receipt.ots", "snapshot.ots"):
   170	        assert loc.iss.results.get("work", rid, "a1/" + name) != loc.iss.results.get("work", rid, "a2/" + name) \
   171	            or name == "manifest"
   172	    assert {j["request_id"] for j in a1["jobs"].values()}.isdisjoint(j["request_id"] for j in a2["jobs"].values())
   173	    for n, a in ((1, a1), (2, a2)):                       # each stamp is a fresh stamp of that attempt's own A_sig
   174	        proof = parse_ots(loc.iss.results.get("work", rid, f"a{n}/receipt.ots"))
   175	        assert proof.digest == sha256(loc.iss.results.get("work", rid, f"a{n}/a_sig"))
   176	    assert a1["receipt_id"] != a2["receipt_id"]
