   131	def anchor_checks(ledger,row,data,expected,headers,pins,kind,txid=None):
   132	    # All branches are evaluated even when an independent stage has failed.
   133	    if data is None: return AnchorResult(None,False)
   134	    receipt=kind=='receipt'; codes={'receipt':'RECEIPT_ANCHOR_MISMATCH','snapshot':'SNAPSHOT_STAMP_MISMATCH','git':'GIT_STAMP_MISMATCH'}
   135	    sub=lambda i: f'11.{i}' if receipt else row
   136	    proof=ledger.run(sub(1),parse_ots,data,tie=(0,))
   137	    if proof is None: return AnchorResult(None,False)
   138	    digest_ok=False
   139	    if expected is not None: digest_ok=ledger.add(sub(2),proof.digest.hex()==shahex(expected),codes[kind],(1,))
   140	    selected,contradicted=select(proof,headers,pins)
   141	    ledger.add(sub(3),not contradicted,'OTS_MERKLE_MISMATCH',(2,))
   142	    no_anchor=('HEADERS_MISSING' if proof.bitcoin else 'ANCHOR_PENDING_ONLY') if receipt else 'SNAPSHOT_NOT_ANCHORED' if kind=='snapshot' else 'GIT_NOT_ANCHORED'
   143	    ledger.add(sub(4),selected is not None,no_anchor,(3,),True)
   144	    if selected:
   145	        if not receipt or txid is not None:
   146	            ledger.add(sub(5),any(tx_path(a,txid if receipt else None) for a in selected.paths),
   147	                       'ANCHOR_TXID_MISMATCH' if receipt else 'OTS_TX_SHAPE',(4,))
   148	    # T requires grammar, digest, no contradiction, qualifying; NOT tx shape.
   149	    return AnchorResult(selected,digest_ok and not contradicted and selected is not None)
