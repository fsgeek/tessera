   102	def parse_timestamp(data):
   103	    """Serialized timestamp (no file header) -> Node. Raises OtsError outside the grammar."""
   104	    r = _Reader(data)
   105	    node = _parse(r, 0)
   106	    if r.i != len(data):
   107	        raise OtsError("trailing bytes")
   108	    return node
   109	
   110	
   111	def _parse(r, depth):
   112	    if depth > 256:
   113	        raise OtsError("depth")
   114	    node = Node()
   115	    while True:
   116	        more = r.d[r.i:r.i + 1] == b"\xff"
   117	        if more:
   118	            r.i += 1
   119	        op = r.byte()
   120	        if op == 0x00:
   121	            tag = r.take(8)
   122	            if tag not in (BTC, PENDING):
   123	                raise OtsError("attestation tag outside the V1 grammar")
   124	            node.items.append(("att", tag, r.take(r.varuint())))
   125	        elif op in (0x08, 0xF0, 0xF1):
   126	            arg = b"" if op == 0x08 else r.take(r.varuint())
   127	            node.items.append(("op", op, arg, _parse(r, depth + 1)))
   128	        else:
   129	            raise OtsError(f"op {op:#x} outside the V1 grammar")
   130	        if not more:
   131	            return node
