   514	def test_5_evidence_that_never_completes_never_ends_the_attempt(loc, key):
   515	    """GATED (step 5): no burial ever. Polls continue for sixty days past B; the attempt stays open, with its failure
   516	    history recorded for diagnosis only. No EVIDENCE_UNAVAILABLE, no successor, no refusal, no cleanup."""
   517	    _, rid = submit(loc, key)
   518	    a = att(to_evidence(loc, rid))
   519	    b = B_of(a)
   520	    for t in [b - 600, b, b + 1, b + 600, b + 1200, b + DAY, b + 30 * DAY, b + 60 * DAY]:
   521	        loc.clock.t = t
   522	        poll(loc)
   523	    rec = get(loc, rid)
   524	    a = att(rec)
   525	    assert rec["state"] == "ACCEPTED" and rec["cur"] == 1 and len(rec["attempts"]) == 1 and a["state"] == "open"
   526	    assert a["unavailable_since"] == b + 1                     # the first failed fetch that started after B
   527	    assert a["failed_intervals"][0][0] == (b + 1) // POLL_INTERVAL_S
   528	    assert (b + 60 * DAY) // POLL_INTERVAL_S in {i for lo, hi in a["failed_intervals"] for i in range(lo, hi + 1)}
   529	    assert loc.iss.requests.cleanup_list() == []
   530	    assert "EVIDENCE_UNAVAILABLE" not in json.dumps(rec)
   531	    bury(loc, b + 61 * DAY)                                     # evidence finally completes: negative -> EXPIRED
   532	    poll(loc)
   533	    rec = get(loc, rid)
   534	    assert att(rec, 1)["state"] == "expired" and att(rec, 1)["unavailable_since"] is None
