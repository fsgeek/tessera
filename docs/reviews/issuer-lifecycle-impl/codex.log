   285	def txid_of(att):
   286	    """Display txid of the transaction on an attestation path (verifier Attestation): the first consecutive
   287	    SHA-256 pair's input, as profile 15.2 defines it; None if the path has none."""
   288	    from tessera_verify.anchors import sha256d
   289	    p = att.path
   290	    for i in range(len(p) - 1):
   291	        if p[i][0] == p[i + 1][0] == 0x08:
   292	            return sha256d(p[i][2])[::-1].hex()
   293	    return None

