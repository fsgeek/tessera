    23	def _conditional_failed(exc):
    24	    code = getattr(exc, "response", {}).get("Error", {}).get("Code")
    25	    return code == "ConditionalCheckFailedException" or type(exc).__name__ == "ConditionalCheckFailedException"
    26	
    27	
    28	def _transaction_conflict(exc):
    29	    code = getattr(exc, "response", {}).get("Error", {}).get("Code")
    30	    if code != "TransactionCanceledException" and type(exc).__name__ != "TransactionCanceledException":
    31	        return False
    32	    reasons = getattr(exc, "response", {}).get("CancellationReasons") or []
    33	    return any(r.get("Code") == "ConditionalCheckFailed" for r in reasons)
    34	
    35	
    36	def _not_found(exc):
    37	    code = getattr(exc, "response", {}).get("Error", {}).get("Code")
    38	    return code in ("NoSuchKey", "404", "NotFound") or type(exc).__name__ == "NoSuchKey"
