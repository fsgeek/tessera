   268	def urllib_transport(timeout=20):
   269	    """Real HTTP for the deployed issuer (not used by the tests)."""
   270	    import urllib.error
   271	    import urllib.request
   272	
   273	    def t(method, url, body):
   274	        req = urllib.request.Request(url, data=body, method=method,
   275	                                     headers={"Accept": "application/vnd.opentimestamps.v1",
   276	                                              "User-Agent": "tessera-issuer/1"})
   277	        try:
   278	            with urllib.request.urlopen(req, timeout=timeout) as r:
   279	                return r.status, r.read(1 << 20)
   280	        except urllib.error.HTTPError as e:
   281	            return e.code, b""
   282	    return t
