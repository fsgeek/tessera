   215	def cleanup(iss):
   216	    now, n = iss.clock(), 0
   217	    for rid, doc in iss.requests.cleanup_list():
   218	        try:
   219	            n += bool(_cleanup_one(iss, rid, doc, now))
   220	        except Exception as e:  # noqa: BLE001
   221	            iss.note("cleanup", rid[:12], "error, kept:", type(e).__name__, e)
   222	    return n
