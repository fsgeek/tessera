    33	class _Reader:
    34	    def __init__(self, data):
    35	        self.d, self.i = data, 0
    36	
    37	    def byte(self):
    38	        if self.i >= len(self.d):
    39	            raise OtsError("truncated")
    40	        self.i += 1
    41	        return self.d[self.i - 1]
    42	
    43	    def take(self, n):
    44	        if self.i + n > len(self.d):
    45	            raise OtsError("truncated")
    46	        self.i += n
    47	        return self.d[self.i - n:self.i]
    48	
    49	    def varuint(self):
    50	        v = sh = 0
    51	        while True:
    52	            c = self.byte()
    53	            v |= (c & 0x7F) << sh
    54	            sh += 7
    55	            if not c & 0x80:
    56	                return v
    57	            if sh > 35:
    58	                raise OtsError("varuint")
