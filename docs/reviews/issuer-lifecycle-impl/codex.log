   139	class GappedHeaders:
   140	    """The header source, failing for chosen heights (a header store or explorer that cannot serve them)."""
   141	
   142	    def __init__(self, real, blocked=None):
   143	        self.real, self.blocked = real, None if blocked is None else set(blocked)   # None: every height
   144	
   145	    def tip(self):
   146	        return self.real.tip()
   147	
   148	    def headers(self, heights):
   149	        if self.blocked is None or self.blocked & set(heights):
   150	            raise OSError("explorers unavailable for " + str(sorted(heights)))
   151	        return self.real.headers(heights)
