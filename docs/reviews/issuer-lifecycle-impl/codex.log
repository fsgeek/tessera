   254	
   255	def _kill_on(loc, pred):
   256	    """Kill the invocation when it sends a write matching pred; the write is left pending. -> list of (rec, expect)."""
   257	    store, left = loc.iss.requests, []
   258	    real = store.save
   259	
   260	    def send(rec, expect=None):
   261	        if not left and pred(rec):
   262	            left.append((copy.deepcopy(rec), copy.deepcopy(expect)))
   263	            store.save = real
   264	            raise LambdaTimeout()
   265	        return real(rec, expect)
   266	    store.save = send
   267	    return left
   268	
   269	
   270	def _stale_calendar(loc):
   271	    cal = loc.iss.calendars[0]
   272	    real = cal.fetch
   273	    cal.fetch = lambda m: None                              # up, but answering stale (pending)
   274	    return lambda: setattr(cal, "fetch", real)
