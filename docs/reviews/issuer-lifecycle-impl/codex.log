     1	"""Bitcoin header source behind one interface: tip() and headers(heights) -> {height: 80 header bytes}.
     2	
     3	ExplorerHeaders reads two or more Esplora-style explorers over an injected transport and accepts a header only
     4	when every explorer returns the same block hash, the header hashes to it, and consecutive headers link. The
     5	issuer pins exactly what it checked (pre-ship), so a header source that lies is caught there, not trusted."""
     6	import json
     7	
     8	from .util import sha256d
     9	
    10	
    11	class HeaderError(Exception):
    12	    pass
    13	
    14	
    15	class HeaderSource:
    16	    def tip(self):
    17	        raise NotImplementedError
    18	
    19	    def headers(self, heights):
    20	        raise NotImplementedError
    21	
    22	
    23	def pin_of(header):
    24	    return sha256d(header)[::-1].hex()
    25	
    26	
    27	def check_links(hdrs):
    28	    for h in sorted(hdrs):
    29	        if len(hdrs[h]) != 80:
    30	            raise HeaderError(f"header {h} is not 80 bytes")
    31	        if h - 1 in hdrs and hdrs[h][4:36] != sha256d(hdrs[h - 1]):
    32	            raise HeaderError(f"header {h} does not link to {h - 1}")
    33	
    34	
    35	class ExplorerHeaders(HeaderSource):
    36	    def __init__(self, base_urls, transport):
    37	        if len(base_urls) < 2:
    38	            raise ValueError("at least two independent explorers")
    39	        self.bases, self.transport = [u.rstrip("/") for u in base_urls], transport
    40	
    41	    def _get(self, url):
    42	        status, body = self.transport("GET", url, None)
    43	        if status != 200:
    44	            raise HeaderError(f"GET {url}: HTTP {status}")
    45	        return body.decode("ascii").strip()
    46	
    47	    def tip(self):
    48	        return min(int(self._get(b + "/blocks/tip/height")) for b in self.bases)
    49	
    50	    def headers(self, heights):
    51	        out = {}
    52	        for h in heights:
    53	            hashes = {self._get(f"{b}/block-height/{h}") for b in self.bases}
    54	            if len(hashes) != 1:
    55	                raise HeaderError(f"explorers disagree at height {h}: {sorted(hashes)}")
    56	            bh = hashes.pop()
    57	            raws = {self._get(f"{b}/block/{bh}/header") for b in self.bases}
    58	            if len(raws) != 1:
    59	                raise HeaderError(f"explorers return different headers for {bh}")
    60	            raw = bytes.fromhex(raws.pop())
    61	            if pin_of(raw) != bh:
    62	                raise HeaderError(f"header at {h} does not hash to {bh}")
    63	            out[h] = raw
    64	        check_links(out)
    65	        return out
    66	
    67	
    68	def headers_json(hdrs):
    69	    return json.dumps({str(h): v.hex() for h, v in sorted(hdrs.items())}, sort_keys=True)
