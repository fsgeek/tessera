   570	def test_5_partial_header_recovery_lower_attestation_qualifies_later(loc, key):
   571	    """ILC2-03 (the model's B1' companion): every calendar has attested; the higher attestation's segment is in hand
   572	    and fails; the lower attestation's segment cannot yet be obtained. No discard or expiry; once the segment is
   573	    recovered the lower attestation is the lowest qualifying one, and it latches."""
   574	    held = HeldCalendar(loc.world.chain)
   575	    loc.iss.calendars.append(held)
   576	    _, rid = submit(loc, key)
   577	    a = att(to_evidence(loc, rid))
   578	    h1 = bury(loc, declared(a) + HOUR)                     # calendar A: timely, at h1
   579	    real = loc.iss.headers
