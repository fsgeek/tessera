   298	
   299	def sig_name(job, sig_sha256):
   300	    """Each verified signature has its own object, so concurrent consumers never overwrite one another (IS-08)."""
   301	    return f"sig-{job}-{sig_sha256}"
   302	
   303	
   304	def _record_signature(iss, rid, aid, job, sig_sha256, srid, now):
   305	    """IS-08: merge one verified signature into its attempt, re-reading on a guarded-write conflict."""
   306	    for _ in range(MERGE_ATTEMPTS):
   307	        rec = iss.requests.get(rid)
   308	        a = current(rec) if rec else None
   309	        if (rec is None or rec["state"] != "ACCEPTED" or a is None or a["id"] != aid or a["state"] != OPEN
   310	                or rec["stage"] != "signing" or job not in a["jobs"]):
   311	            return "not-waiting"
   312	        if a["jobs"][job]["sig_sha256"]:
   313	            return "duplicate"
   314	        g = lifecycle_guard(rec)
   315	        a["jobs"][job]["sig_sha256"] = sig_sha256
   316	        _event(rec, now, "signed", aid, job, srid)
   317	        if iss.requests.save(rec, g):
   318	            return "used"
   319	    return "save-conflict"                             # left in storage and the log; reconciled before any resend
   320	
   321	
   322	def _reconcile(iss, rec, a):
   323	    """IS-08: adopt a stored signature that verifies on the job's frame and has its "used" log record, instead of
   324	    asking the signer again. -> True if a job was satisfied."""
   325	    names, found, aid = iss.results.names("work", rec["rid"]), False, a["id"]
   326	    for job, j in a["jobs"].items():
   327	        if j["sig_sha256"]:
   328	            continue
   329	        frame = iss.results.get("work", rec["rid"], f"{aid}/{j['frame']}")
   330	        for name in names:
   331	            if not name.startswith(f"{aid}/sig-{job}-"):
   332	                continue
   333	            sig = iss.results.get("work", rec["rid"], name)
   334	            h = sha256hex(sig) if sig is not None else None
   335	            if (h and name == f"{aid}/" + sig_name(job, h) and iss.requests.siglog_has(j["request_id"], h)
   336	                    and iss.signers[j["slot"]].verify(frame, sig)):
   337	                j["sig_sha256"], found = h, True
   338	                break
   339	    return found
   340	
   341	
   342	def _send(iss, rec, a, job):
   343	    j = a["jobs"][job]
   344	    frame = iss.results.get("work", rec["rid"], f"{a['id']}/{j['frame']}")
   345	
   346	    def stash(data):                                   # IS-09: immutable, digest-named, deleted with the request
   347	        name = f"{a['id']}-{sha256hex(data)}"
   348	        iss.results.put("frames", rec["rid"], name, data)
   349	        return iss.results.ref("frames", rec["rid"], name)
   350	    # IS-03: every signer refuses after the window's signing stop. The former per-request bound (acceptance + 24 h)
   351	    # is withdrawn with the 24-hour rule; an attempt's own signing has no other deadline.
   352	    iss.signers[j["slot"]].send(j["request_id"], frame, sign_by=iss.window.sign_until, stash=stash)
   353	
