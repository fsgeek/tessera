   247	class HttpCalendar:
   248	    """The public calendar protocol over an injected transport(method, url, body) -> (status, bytes)."""
   249	
   250	    def __init__(self, uri, transport):
   251	        self.uri, self.transport = uri.rstrip("/"), transport
   252	
   253	    def submit(self, message):
   254	        status, body = self.transport("POST", self.uri + "/digest", message)
   255	        if status != 200:
   256	            raise CalendarError(f"calendar {self.uri} submit: HTTP {status}")
   257	        return body
   258	
   259	    def fetch(self, commitment):
   260	        status, body = self.transport("GET", self.uri + "/timestamp/" + commitment.hex(), None)
   261	        if status == 404:
   262	            return None
   263	        if status != 200:
   264	            raise CalendarError(f"calendar {self.uri} fetch: HTTP {status}")
   265	        return body
