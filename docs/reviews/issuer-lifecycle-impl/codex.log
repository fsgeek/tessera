    22	@dataclass
    23	class Attestation:
    24	    height: int
    25	    message: bytes
    26	    path: tuple
    27	    order: int
    28	@dataclass
    29	class Proof:
    30	    digest: bytes
    31	    bitcoin: list
    32	    pending: list
    33	
    34	def parse_ots(raw):
    35	    demand(len(raw)<=2**20,'OTS_FORMAT'); c=Reader(raw)
    36	    demand(c.take(len(MAGIC))==MAGIC and c.varuint()==1 and c.uint(1)==8,'OTS_FORMAT')
    37	    digest=c.take(32); bitcoin=[]; pending=[]; ops=0; attestations=0
    38	    # Explicit stack: a depth-256 proof is safe under any Python recursion setting.
    39	    tasks=[(digest,(),0)]
    40	    while tasks:
    41	        message,path,depth=tasks.pop(); demand(depth<=256,'OTS_FORMAT')
    42	        sibling=c.data[c.pos:c.pos+1]==b'\xff'
    43	        if sibling: c.take(1); tasks.append((message,path,depth))
    44	        opcode=c.uint(1)
    45	        if opcode==0:
    46	            attestations+=1; demand(attestations<=4096,'OTS_FORMAT')
    47	            tag=c.take(8); payload=Reader(c.varbytes(8192))
    48	            if tag==BTC:
    49	                h=payload.varuint(); payload.end('OTS_FORMAT'); demand(len(message)==32,'OTS_FORMAT')
    50	                bitcoin.append(Attestation(h,message,path,len(bitcoin)))
    51	            elif tag==PENDING:
    52	                uri=payload.varbytes(1000); payload.end('OTS_FORMAT'); pending.append(uri)
    53	            else: raise Fault('OTS_FORMAT')
    54	        else:
    55	            ops+=1; demand(ops<=65536 and opcode in (8,0xf0,0xf1),'OTS_FORMAT')
    56	            arg=b'' if opcode==8 else c.varbytes(4096)
    57	            demand(opcode==8 or len(arg)>0,'OTS_FORMAT')
    58	            result=sha(message) if opcode==8 else message+arg if opcode==0xf0 else arg+message
    59	            demand(len(message)<=4096 and len(result)<=4096,'OTS_FORMAT')
    60	            tasks.append((result,path+((opcode,arg,message),),depth+1))
    61	    c.end('OTS_FORMAT'); return Proof(digest,bitcoin,pending)
