   185	def upgrade(raw, calendars):
   186	    """Replace each pending attestation whose calendar now has a complete timestamp. -> (new bytes, changed)."""
   187	    by_uri = {c.uri: c for c in calendars}
   188	    digest, root = parse_file(raw)
   189	    changed = False
   190	    for node, msg in list(walk(root, digest)):
   191	        for it in list(node.items):
   192	            if it[0] == "att" and it[1] == PENDING:
   193	                cal = by_uri.get(pending_uri(it[2]))
   194	                if cal is None:
   195	                    continue
   196	                try:
   197	                    got = cal.fetch(msg)
   198	                except (OSError, CalendarError):
   199	                    got = None
   200	                if got:
   201	                    sub = parse_timestamp(got)
   202	                    node.items.remove(it)
   203	                    node.merge(sub)
   204	                    changed = True
   205	    return serialize_file(digest, root), changed
