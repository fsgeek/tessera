   128	class HeldCalendar(StandInCalendar):
   129	    """A second calendar whose commitments are mined only once released."""
   130	
   131	    def __init__(self, chain):
   132	        super().__init__(chain, uri="https://stand-in-calendar-b.invalid")
   133	        self.held = True
   134	
   135	    def include(self, h):
   136	        return [] if self.held else super().include(h)
