   208	def lowest_btc_height(raw):
   209	    """Lowest Bitcoin attestation height in the proof, or None (read with the verifier's parser)."""
   210	    try:
   211	        p = parse_ots(raw)
   212	    except Fault as e:
   213	        raise OtsError(e.code) from None
   214	    return min((a.height for a in p.bitcoin), default=None)
