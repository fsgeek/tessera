   277	@pytest.mark.parametrize("fence", [True, False], ids=["fenced", "B5-no-fence"])
   278	def test_3_a_leftover_write_of_a_killed_invocation_cannot_beat_a_live_latch(loc, key, fence, monkeypatch):
   279	    """R5 path (c) and its companion B5. Invocation 1 reads past B, its fetch is stale, it sends its failure-history
   280	    write and is killed; the write stays pending. Invocation 2 fences, fetches eligibility and latches; the leftover
   281	    write resolves just before the latch. With the fence it fails its version guard and the latch commits. Without the
   282	    fence (B5) the leftover commits and the live latch fails its guard: the race the fence closes."""
   283	    _, rid = submit(loc, key)
   284	    rec = to_evidence(loc, rid)
   285	    a = att(rec)
   286	    bury(loc, declared(a) + HOUR)                          # timely
   287	    loc.clock.t = B_of(a) + 600
   288	    restore = _stale_calendar(loc)
   289	    left = _kill_on(loc, lambda r: bool(current(r).get("failed_intervals")))
   290	    with pytest.raises(LambdaTimeout):
   291	        poll(loc)
   292	    restore()
   293	    assert left
   294	    if not fence:
   295	        monkeypatch.setattr(pipeline, "_fence", lambda iss, rec, now: None)
   296	    store, outcome = loc.iss.requests, {}
   297	    real = store.save
   298	
   299	    def latch_after_leftover(rec, expect=None):
   300	        if current(rec)["state"] == "latched" and "leftover" not in outcome:
   301	            outcome["leftover"] = real(*left[0])
   302	        return real(rec, expect)
   303	    store.save = latch_after_leftover
   304	    poll(loc)
   305	    store.save = real
   306	    rec = get(loc, rid)
   307	    if fence:
   308	        assert outcome["leftover"] is False and att(rec)["state"] == "latched"
   309	        assert not att(rec)["failed_intervals"]
   310	    else:
   311	        assert outcome["leftover"] is True and only_first_open(rec)
   312	    poll(loc)
   313	    assert att(get(loc, rid))["state"] in ("latched", "shipped")   # either way it is not lost for good
   314	
