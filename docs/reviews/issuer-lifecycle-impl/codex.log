    63	class TxReader(Cursor):
    64	    def __init__(self,raw): super().__init__(raw,'OTS_TX_SHAPE')
    65	    def compact(self):
    66	        first=self.uint(1)
    67	        if first<253: return first
    68	        width={253:2,254:4,255:8}[first]; n=int.from_bytes(self.take(width),'little')
    69	        demand(n>={253:253,254:65536,255:4294967296}[first],'OTS_TX_SHAPE'); return n
    70	
    71	def transaction(raw):
    72	    c=TxReader(raw); c.take(4); n=c.compact(); demand(1<=n<=len(raw)//41,'OTS_TX_SHAPE')
    73	    for _ in range(n): c.take(36); c.take(c.compact()); c.take(4)
    74	    n=c.compact(); demand(1<=n<=len(raw)//9,'OTS_TX_SHAPE'); scripts=[]
    75	    for _ in range(n): c.take(8); scripts.append(c.take(c.compact()))
    76	    c.take(4); c.end('OTS_TX_SHAPE'); return scripts
    77	
    78	def tx_path(att,txid=None):
    79	    path=att.path
    80	    for i in range(len(path)-1):
    81	        if path[i][0]==path[i+1][0]==8:
    82	            # The definition chooses the FIRST consecutive SHA256 pair.
    83	            p=path[i][2]; j=i
    84	            while j>0 and path[j-1][0] in (0xf0,0xf1): j-=1
    85	            m=path[j][2]
    86	            try: scripts=transaction(p)
    87	            except Fault: return False
    88	            if len(m)!=32 or b'\x6a\x20'+m not in scripts: return False
    89	            if txid is not None and sha256d(p)[::-1].hex()!=txid: return False
    90	            suffix=path[i+2:]
    91	            if len(suffix)%3: return False
    92	            for k in range(0,len(suffix),3):
    93	                a,b,c=suffix[k:k+3]
    94	                if a[0] not in (0xf0,0xf1) or len(a[1])!=32 or b[0]!=8 or c[0]!=8: return False
    95	            return True
    96	    return False
