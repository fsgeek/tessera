   582	    assert only_first_open(get(loc, rid))
   583	    held.held = False
   584	    h2 = bury(loc, declared(a) + DELTA + HOUR)            # calendar B: late, at h2 > h1 + 5
   585	    assert h2 > h1 + 5
   586	    for t in (declared(a) + DELTA + 2 * HOUR, B_of(a) + DAY):   # before and after B
   587	        loc.clock.t = t
