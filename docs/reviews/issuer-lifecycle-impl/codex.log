   205	        raise StageError("objects left after deletion: " + ",".join(left))
   206	    if seen < doc["fence_until"]:
   207	        return False                                   # CF-02: a late writer may still store; delete again later
   208	    if expired or "result" in namespaces:
   209	        iss.requests.cleanup_done(rid)
   210	        return True
   211	    iss.requests.cleanup_put(rid, dict(doc, end_done=True))
   212	    return False
