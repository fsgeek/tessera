   166	def stamp(digest, calendars, nonce):
   167	    """One stamp: file digest -> append(nonce) -> sha256 -> each calendar's timestamp. -> file bytes."""
   168	    if len(digest) != 32 or len(nonce) != 16:
   169	        raise OtsError("digest and nonce lengths")
   170	    root = Node()
   171	    m = sha256(digest + nonce)
   172	    node = root.op(0xF0, nonce).op(0x08)
   173	    got = 0
   174	    for cal in calendars:
   175	        try:
   176	            node.merge(parse_timestamp(cal.submit(m)))
   177	            got += 1
   178	        except (OtsError, OSError, CalendarError):
   179	            continue
   180	    if not got:
   181	        raise OtsError("no calendar accepted the stamp")
   182	    return serialize_file(digest, root)
   183	
