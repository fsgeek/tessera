   346	    assert not st.save(copy.deepcopy(rec), dict(g, attempt="a2"))
   347	    assert not st.save(copy.deepcopy(rec), dict(g, state="REFUSED"))
   348	    assert not st.save(copy.deepcopy(rec), dict(g, astate="latched"))
   349	    stale = copy.deepcopy(rec)
   350	    assert st.save(rec, g)
   351	    assert not st.save(stale, g)                         # same state and attempt, older version
   352	    assert st.get("r")["version"] == rec["version"]
