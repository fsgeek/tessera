    98	@dataclass
    99	class Selected:
   100	    height: int
   101	    time: int
   102	    confirmed: int
   103	    paths: list
   104	    latest: int=0  # max nTime over h..h+5 as an unbounded int (A10.1.1; profile 7.4)
   105	
   106	def select(proof,headers,pins):
   107	    contradicted=[]; qualifying=[]
   108	    for att in proof.bitcoin:
   109	        h=att.height
   110	        if h in headers and h in pins and sha256d(headers[h])[::-1].hex()==pins[h] and headers[h][36:68]!=att.message:
   111	            contradicted.append(att)
   112	        if any(i not in headers or i not in pins or sha256d(headers[i])[::-1].hex()!=pins[i] for i in range(h,h+6)): continue
   113	        if any(headers[i][4:36]!=sha256d(headers[i-1]) for i in range(h+1,h+6)): continue
   114	        if headers[h][36:68]==att.message: qualifying.append(att)
   115	    if not qualifying: return None,bool(contradicted)
   116	    height=min(a.height for a in qualifying)
   117	    return Selected(height,int.from_bytes(headers[height][68:72],'little'),
   118	                    int.from_bytes(headers[height+5][68:72],'little'),[a for a in qualifying if a.height==height],
   119	                    max(int.from_bytes(headers[i][68:72],'little') for i in range(height,height+6))),bool(contradicted)

