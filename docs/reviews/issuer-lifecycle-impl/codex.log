   241	def test_3_no_fetch_happens_when_the_fence_fails(loc, key):
   242	    _, rid = submit(loc, key)
   243	    rec = to_evidence(loc, rid)
   244	    bury(loc, declared(att(rec)) + HOUR)
   245	    fetched, store = [], loc.iss.requests
   246	    real_save = store.save
   247	    store.save = lambda rec, expect=None: False             # every guarded write fails (e.g. a concurrent writer)
   248	    real_fetch = loc.iss.calendars[0].fetch
   249	    loc.iss.calendars[0].fetch = lambda m: fetched.append(m) or real_fetch(m)
   250	    poll(loc)
   251	    store.save = real_save
   252	    assert not fetched and only_first_open(get(loc, rid))
