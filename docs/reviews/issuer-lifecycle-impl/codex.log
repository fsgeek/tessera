    18	def _varuint(n):
    19	    out = b""
    20	    while True:
    21	        b = n & 0x7F
    22	        n >>= 7
    23	        if n:
    24	            out += bytes([b | 0x80])
    25	        else:
    26	            return out + bytes([b])
