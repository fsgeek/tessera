    89	        if expect is not None:                        # the lifecycle guard, evaluated atomically with the version
    90	            for field, attr in self.GUARD_ATTRS:
    91	                cond += f" AND #{attr} = :{attr}"
    92	                names["#" + attr] = attr
    93	                values[":" + attr] = {"S": str(expect[field] or "")}
    94	        try:
    95	            self.c.put_item(TableName=self.t, Item=self._item(rec), ConditionExpression=cond,
    96	                            ExpressionAttributeNames=names, ExpressionAttributeValues=values)
    97	            return True
    98	        except Exception as e:  # noqa: BLE001
    99	            rec["version"] = old
   100	            if _conditional_failed(e):
   101	                return False
   102	            raise
