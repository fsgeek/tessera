    base = ((int(loc.clock()) // 1200) + 1) * 1200
    junk = json.dumps({"request_id": "req-" + "0" * 40, "status": "SIGNED", "sig_b64": "AAAA"})
    for i in range(12):
        loc.clock.t = base + 599 + 600 * i + (0 if i % 2 == 0 else 2)
        for _ in range(100):
            loc.workers["kms"].responses.send(junk)
        pipeline.poll(loc.iss)
        if all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k):
            break
    assert all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k)


def test_ILCI6_one_slow_response_on_one_slot_cannot_starve_the_other(monkeypatch):
    """Codex's overrun counterexample (CODEX-CONFIRM-6.md): handling one KMS response costs 240 s (four 60 s
    requests), KMS junk is replenished before every poll and placed ahead of the valid GPG replies. Every slot is
    received from before anything is handled, and the oldest message is handled first: the GPG replies, which only
    grow older, are collected within a bounded number of polls."""
    monkeypatch.setitem(SLOW, "sqs", 0)
    loc, _ = aws_wire("sqs")
    _, rid = submit(loc, str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values():
        wk.process()
    object.__setattr__(loc.iss.requests.c, "_client", SlowClient(loc.iss.requests.c._client, loc.clock, 60, []))
    for signer in loc.iss.signers.values():
        signer.responses.client._client._delay = 60
    for slot, signer in loc.iss.signers.items():
        real = signer.receive

        def receive(n=10, slot=slot, real=real):
            loc.iss.requests.c._client._delay = 60 if slot == "kms" else 0
            return real(n)
        signer.receive = receive
    loc.workers["kms"].responses.msgs.clear()
    junk = json.dumps({"request_id": "req-" + "0" * 40, "status": "SIGNED", "sig_b64": "AAAA"})
    for i in range(12):
        loc.workers["kms"].responses.send(junk)
        loc.clock.advance(1200 - loc.clock() % 1200)     # every poll starts in a same-parity window (as Codex's)
        pipeline.poll(loc.iss)
        if all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k):
            break
    assert all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k)


def test_ILCI6_messages_are_handled_oldest_first_across_slots(loc, monkeypatch):
    handled = []
    monkeypatch.setattr(pipeline, "_take", lambda iss, slot, signer, body: handled.append(body["n"]))
    kms, gpg = loc.workers["kms"].responses, loc.workers["gpg"].responses
    for n, q in [(1, gpg), (2, kms), (3, gpg), (4, kms), (5, kms), (6, gpg)]:
        q.send(json.dumps({"n": n}))
        loc.clock.advance(1)
    pipeline.drain(loc.iss)
    assert handled == [1, 2, 3, 4, 5, 6]


"""In-memory stand-ins for the boto3 clients the AWS adapters use, implementing exactly the calls and condition
expressions the adapters make (no AWS, no network)."""
import copy
import io

from tessera_issue.queues import InMemoryQueue


class ClientError(Exception):
    def __init__(self, code):
        super().__init__(code)
        self.response = {"Error": {"Code": code}}


DYNAMO_ITEM_LIMIT = 400 * 1024                        # DynamoDB's item size limit, attribute names included


def dynamo_item_size(item):
    """Item size as DynamoDB counts it for these attribute types: UTF-8 name bytes plus value bytes (S: UTF-8
    length; N: an upper bound of its digits)."""
    total = 0
    for name, value in item.items():
        (kind, v), = value.items()
        total += len(name.encode()) + len(str(v).encode())
    return total


class FakeDynamo:
    def __init__(self):
        self.tables = {}
        self.calls = []
        self.max_item = 0

    def _check_size(self, item):
        size = dynamo_item_size(item)
        if size > DYNAMO_ITEM_LIMIT:
            raise ClientError("ValidationException")       # "Item size has exceeded the maximum allowed size"
        self.max_item = max(self.max_item, size)

    def _t(self, name):
        return self.tables.setdefault(name, {})

    def get_item(self, TableName, Key, ConsistentRead=False):
        self.calls.append("get_item")
        it = self._t(TableName).get(Key["pk"]["S"])
        return {"Item": copy.deepcopy(it)} if it else {}

    def put_item(self, TableName, Item, ConditionExpression=None, ExpressionAttributeNames=None,
                 ExpressionAttributeValues=None):
        self.calls.append("put_item")
        self._check_size(Item)
        t, pk = self._t(TableName), Item["pk"]["S"]
        cur = t.get(pk)
        if ConditionExpression == "attribute_not_exists(pk)":
            if cur is not None:
                raise ClientError("ConditionalCheckFailedException")
        elif ConditionExpression is not None and ConditionExpression.startswith("#v = :v"):
            # the version compare-and-set, optionally AND-ed with the lifecycle guard ("#x = :x" terms only)
            assert ExpressionAttributeNames["#v"] == "version"
            for term in ConditionExpression.split(" AND "):
                n, eq, v = term.split(" ")
                assert eq == "=" and n.startswith("#") and v.startswith(":"), term
                if cur is None or cur.get(ExpressionAttributeNames[n]) != ExpressionAttributeValues[v]:
                    raise ClientError("ConditionalCheckFailedException")
        elif ConditionExpression is not None:
            raise AssertionError("unexpected condition " + ConditionExpression)
        t[pk] = copy.deepcopy(Item)
        return {}

    def transact_write_items(self, TransactItems):
        """All-or-nothing: every condition is checked before anything is written."""
        self.calls.append("transact_write_items")
        for op in TransactItems:
            self._check_size(op["Put"]["Item"])
        reasons, ok = [], True
        for op in TransactItems:
            put = op["Put"]
            cur = self._t(put["TableName"]).get(put["Item"]["pk"]["S"])
            cond = put.get("ConditionExpression")
            assert cond in (None, "attribute_not_exists(pk)")
            if cond and cur is not None:
                reasons.append({"Code": "ConditionalCheckFailed"})
                ok = False
            else:
                reasons.append({"Code": "None"})
        if not ok:
            e = ClientError("TransactionCanceledException")
            e.response["CancellationReasons"] = reasons
            raise e
        for op in TransactItems:
            put = op["Put"]
            self._t(put["TableName"])[put["Item"]["pk"]["S"]] = copy.deepcopy(put["Item"])
        return {}

    def delete_item(self, TableName, Key):
        self.calls.append("delete_item")
        self._t(TableName).pop(Key["pk"]["S"], None)
        return {}

    def query(self, TableName, IndexName, KeyConditionExpression, ExpressionAttributeNames,
        rec = iss.requests.get(rid)
        a = current(rec) if rec else None
        if (rec is None or rec["state"] != "ACCEPTED" or a is None or a["id"] != aid or a["state"] != OPEN
                or rec["stage"] != "signing" or job not in a["jobs"]):
            return "not-waiting"
        if a["jobs"][job]["sig_sha256"]:
            return "duplicate"
        g = lifecycle_guard(rec)
        a["jobs"][job]["sig_sha256"] = sig_sha256
        _event(rec, now, "signed", aid, job, srid)
        if iss.requests.save(rec, g):
            return "used"
    return "save-conflict"                             # left in storage and the log; reconciled before any resend


def _reconcile(iss, rec, a):
    """IS-08: adopt a stored signature that verifies on the job's frame and has its "used" log record, instead of
    asking the signer again. -> True if a job was satisfied."""
    names, found, aid = iss.results.names("work", rec["rid"]), False, a["id"]
    for job, j in a["jobs"].items():
        if j["sig_sha256"]:
            continue
        frame = iss.results.get("work", rec["rid"], f"{aid}/{j['frame']}")
        for name in names:
            if not name.startswith(f"{aid}/sig-{job}-"):
                continue
            sig = iss.results.get("work", rec["rid"], name)
            h = sha256hex(sig) if sig is not None else None
            if (h and name == f"{aid}/" + sig_name(job, h) and iss.requests.siglog_has(j["request_id"], h)
                    and iss.signers[j["slot"]].verify(frame, sig)):
                j["sig_sha256"], found = h, True
                break
    return found


def _send(iss, rec, a, job):
