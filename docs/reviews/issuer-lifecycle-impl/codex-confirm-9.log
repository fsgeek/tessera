@pytest.mark.parametrize('first',[0,1])
def test_two_receives_destroy_capacity(monkeypatch,first):
    monkeypatch.setitem(SLOW,'sqs',0)
    loc,_=aws_wire('sqs')
    _,rid=submit(loc,str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values(): wk.process()
    object.__setattr__(loc.iss.requests.c,'_client',SlowClient(loc.iss.requests.c._client,loc.clock,30,[]))
    for signer in loc.iss.signers.values(): signer.responses.client._client._delay=50
    class R:
        def randrange(self,n): return first
    loc.iss.rng=R()
    for i in range(12):
        loc.clock.advance(600)
        out=pipeline.poll(loc.iss)
        rec=get(loc,rid)
        print('TWO',first,i,out,[bool(v['sig_sha256']) for v in att(rec)['jobs'].values()],loc.iss.log[-3:])
        assert any(v['sig_sha256'] for v in att(rec)['jobs'].values())
        break
    # Same dependencies/budget, one receive: full handling including acknowledgement fits.
    loc.clock.advance(600)
    loc.iss.signers={('gpg' if first==0 else 'kms'):loc.iss.signers['gpg' if first==0 else 'kms']}
    loc.iss.rng=type('Zero',(),{'randrange':lambda self,n:0})()
    start=loc.clock()
    with deadline.Installed(deadline.Deadline(loc.iss.elapsed_clock,290,10)):
        n=pipeline.drain(loc.iss,share_s=290/3)
    print('ONE',first,n,loc.clock()-start)
    assert n==1
    assert any(v['sig_sha256'] for v in att(get(loc,rid))['jobs'].values())
