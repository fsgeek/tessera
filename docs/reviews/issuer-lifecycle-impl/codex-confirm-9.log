        self.c.put_item(TableName=self.t, Item={"pk": {"S": "SIGLOG#" + uuid.uuid4().hex}, "doc": doc})

    def siglog_has(self, request_id, signature_sha256):
        return self._get(self._used_pk(request_id, signature_sha256)) is not None

