    # own RRSIG times at its anchored time); see test_lifecycle_round3.py
    for row, reason, kind in [("13.5", "KSK_OUTSIDE_RELIANCE_PERIOD", "retry"), ("13.5", "RRSIG_NOT_VALID_AT_EVAL_TIME",
