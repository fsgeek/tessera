import json, uuid
from conftest import loc,key
from test_lifecycle_confirm import aws_wire,SLOW
from test_lifecycle import get,att
from helpers import submit
from tessera_issue import pipeline

def test_parity_lock(monkeypatch):
    monkeypatch.setitem(SLOW,'sqs',20)
    loc,_=aws_wire('sqs')
    _,rid=submit(loc,str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values(): wk.process()
    base=((int(loc.clock())//1200)+1)*1200
    junk=json.dumps({'request_id':'req-'+'0'*40,'status':'SIGNED','sig_b64':'AAAA'})
    for i in range(12):
        # Schedule phase 599 s; alternate delivery delays of 0 and 2 seconds.
        loc.clock.t=base+599+600*i+(0 if i%2==0 else 2)
        for _ in range(100): loc.workers['kms'].responses.send(junk)
        pipeline.poll(loc.iss)
    rec=get(loc,rid)
    print('LOCK',rec['stage'],[(k,bool(v['sig_sha256'])) for k,v in att(rec)['jobs'].items()],len(loc.workers['gpg'].responses))
    assert all(v['sig_sha256'] for k,v in att(rec)['jobs'].items() if 'gpg' in k)
    loc.clock.t=base+600*13+1
    pipeline.poll(loc.iss)
    print('ESCAPE',[(k,bool(v['sig_sha256'])) for k,v in att(get(loc,rid))['jobs'].items()])
    assert all(v['sig_sha256'] for k,v in att(get(loc,rid))['jobs'].items() if 'gpg' in k)
