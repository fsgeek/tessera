def _drain_start_slot(iss, order_time, n):
    """ILC-I4-01, ILC-I5 (owner decisions): which signer slot is served first: floor(ordering input / poll interval)
    mod the number of slots, where the ordering input is the schedule's event time (or the invocation's start reading
    when there is none). Order only; fairness does not depend on it, because every slot has its own share."""
    return (int(order_time) // POLL_INTERVAL_S) % max(1, n)


def drain(iss, max_batches=50, share_s=float("inf"), order_time=None):
    """Read every slot's response queue. Every response is logged (request id, slot, status, frame hash when the
    id is known, signature hash) whether or not it is used, and then deleted from the queue.

    ILC-I2-04, ILC-I5 (fairness by construction): the drain allocation `share_s` is split equally between the signer
    slots, and EVERY slot gets its own share in EVERY poll, served in order (the first slot from _drain_start_slot);
    a slot's unused share passes to the next. The shares are cooperative: checked between response-processing units
    (a receive, a response's handling), so one slow unit can overrun a share; what is left stays queued and is
    delivered again. So neither a continuously replenished queue nor any ordering can starve the other slot or the
    request work."""
    n, d = 0, _deadline(iss)
    slots = list(iss.signers.items())
    turn = _drain_start_slot(iss, iss.clock() if order_time is None else order_time, len(slots))
    per_slot = share_s / max(1, len(slots))
    carry = 0.0
    for slot, signer in slots[turn:] + slots[:turn]:
        allowance, start = per_slot + carry, d.clock()

        def over():
            return d.clock() - start >= allowance or d.available() < MIN_REQUEST_S
        try:
            for _ in range(max_batches):
                if over():
                    break
                batch = signer.receive(10)
                if not batch:
                    break
                for k, (handle, body) in enumerate(batch):
                    if k and over():               # the first response of a batch is always handled, so a slot
                        break                      # whose receive used its share still progresses; the rest stay
                                                   # queued and are delivered again after the visibility timeout
                    try:
                        _take(iss, slot, signer, body)
                    except OutOfBudget:
                        raise
                    except Exception as e:  # noqa: BLE001  not acknowledged: the queue delivers it again
                        iss.note("response", slot, "not taken:", type(e).__name__, e)
                        continue
                    signer.ack(handle)
                    n += 1
                else:
                    continue
                break
        except OutOfBudget as e:
            iss.note("drain out of time:", slot, e)
        carry = max(0.0, allowance - (d.clock() - start))  # unused share passes to the next slot
    return n


def _bounded(raw):
    """ILI-07: a signer-supplied reason as a bounded code. -> (code, diagnostic bytes or None)."""
    if raw is None:
        return None, None
    if isinstance(raw, str) and REASON_RE.match(raw):
        return raw, None
"""ONE deadline guard for every remote and store request the poller makes (ILC-I-02; docs/reviews/issuer-lifecycle-impl
/CODEX-CONFIRM.md). The poller installs a Deadline for the duration of one poll (pipeline.poll). Every client request
then goes through `call`, which

  (a) refuses to START the request unless its worst-case duration fits the time remaining minus the reserve
      (raising OutOfBudget: the work resumes in the next invocation; nothing is decided on a refused request), and
  (b) passes the request a timeout no larger than what remains: CALL_TIMEOUT holds that value while the request runs,
      and the HTTP and DNS transports cap their total time to it. AWS SDK clients cannot take a per-request timeout;
      their configured worst case (AWS_WORST_S, from the client configuration: attempts x (connect + read) plus the
      retry back-off) is what (a) admits, so it never exceeds what remains either.

The guard sits at the lowest layer, around each single request, so no adapter loop (pagination, deletion rounds,
explorer agreement) can multiply time unchecked:

  DynamoDB, S3, SQS (signer sends and receives), SNS   GuardedClient around each boto3-style client (aws.py, queues.py)
  calendars, explorers                                 guarded_transport in ots.HttpCalendar, chain.ExplorerHeaders
  DNS resolver                                         guarded_transport in dns.LiveDns
  the pre-ship check (local CPU, no timeout knob)      pipeline, with PRESHIP_WORST_S

Per-unit cost figures elsewhere (a header height, a tip) are computed from these worst cases and the configured
explorer count, and are used only to avoid starting a unit that cannot finish; the safety mechanism is this guard.
Outside a poll (the API, tests calling a function directly) no deadline is installed and calls run unguarded."""
import contextvars

from .service import AWS_CLIENT_CONFIG, HTTP_TIMEOUT_S

CURRENT = contextvars.ContextVar("tessera_deadline", default=None)
CALL_TIMEOUT = contextvars.ContextVar("tessera_call_timeout", default=None)


def aws_worst_s(config=AWS_CLIENT_CONFIG):
    """Worst case of one SDK request under the client configuration: every attempt waits its full connect and read
    timeouts, and every retry waits the standard mode's maximum back-off (20 s)."""
    attempts = config["retries"]["total_max_attempts"]
    return attempts * (config["connect_timeout"] + config["read_timeout"]) + (attempts - 1) * 20


AWS_WORST_S = aws_worst_s()
HTTP_WORST_S = HTTP_TIMEOUT_S              # one calendar or explorer request (total, capped by the transport)
DNS_WORST_S = 2 * 10                       # one resolver query: UDP, then TCP if truncated (total, capped)
PRESHIP_WORST_S = 30                       # the verifier library on one bundle; local CPU, measured well below


class OutOfBudget(Exception):
    """The next request does not fit the invocation's remaining time; resumed next poll."""


class Deadline:
    def __init__(self, clock, limit_s, reserve_s):
        self.clock, self.start, self.limit, self.reserve = clock, clock(), limit_s, reserve_s

    def remaining(self):
        return self.limit - (self.clock() - self.start)

    def available(self):
        return self.remaining() - self.reserve

    def ensure(self, worst_s, what=""):
        """Refuse unless `worst_s` fits; used for whole units (a header height) before their first request."""
        if worst_s > self.available():
            raise OutOfBudget(f"{what}: worst case {worst_s:.0f} s, {self.available():.0f} s available; "
                              "resumed next poll")

    def call(self, worst_s, fn, *args, what="", **kwargs):
        self.ensure(worst_s, what)
        token = CALL_TIMEOUT.set(min(worst_s, self.available()))
        try:
            return fn(*args, **kwargs)
        finally:
            CALL_TIMEOUT.reset(token)


def guarded(worst_s, fn, *args, what="", **kwargs):
    """Run one request under the current deadline (if any)."""
    d = CURRENT.get()
    if d is None:
        return fn(*args, **kwargs)
    return d.call(worst_s, fn, *args, what=what, **kwargs)


def ensure(worst_s, what=""):
    d = CURRENT.get()
    if d is not None:
        d.ensure(worst_s, what)


def call_timeout(default):
    """The timeout a transport must use for the request now running: its own, capped by what remains."""
    t = CALL_TIMEOUT.get()
    return default if t is None else max(0.001, min(default, t))


class GuardedClient:
    """A boto3-style client whose every method call is one guarded request of worst case AWS_WORST_S (or `worst_s`).
    Non-callable attributes pass through. Methods the adapters use to build URLs locally (generate_presigned_url)
    make no request and are not guarded."""
    LOCAL = {"generate_presigned_url"}

    def __init__(self, client, kind, worst_s=None):
        object.__setattr__(self, "_client", client)
        object.__setattr__(self, "_kind", kind)
        object.__setattr__(self, "_worst", AWS_WORST_S if worst_s is None else worst_s)

    def __setattr__(self, name, value):            # test hooks patch the wrapped client, not the guard
        setattr(self._client, name, value)

    def __getattr__(self, name):
        attr = getattr(self._client, name)
        if not callable(attr) or name in self.LOCAL:
            return attr

        def call(*args, **kwargs):
            return guarded(self._worst, attr, *args, what=f"{self._kind}.{name}", **kwargs)
        return call


def guarded_transport(transport, kind, worst_s):
    """A transport (method, url, body) or (query) whose every request is guarded."""
    if getattr(transport, "_tessera_guarded", False):
        return transport

    def t(*args):
        return guarded(worst_s, transport, *args, what=kind)
    t._tessera_guarded = True
    return t


class Installed:
    """Context manager: install a Deadline for one poll."""

    def __init__(self, deadline):
        self.deadline, self.token = deadline, None

    def __enter__(self):
        self.token = CURRENT.set(self.deadline)
        return self.deadline

    def __exit__(self, *exc):
        CURRENT.reset(self.token)
        return False
    return install_record.current_facts(SHA1DC_BINARY, digest)


def api_handler(event, context):
    return handle_api_event(_issuer(), event)


def _scheduled_time(event):
    """ILC-I5: the EventBridge scheduled event's 'time' (exact 10-minute steps), the drain's ordering input; None when
    absent or malformed (the poller then uses its start reading)."""
    from .util import ts
    try:
        return ts(event["time"]) if isinstance(event, dict) and isinstance(event.get("time"), str) else None
    except ValueError:
        return None


def poller_handler(event, context):
    if isinstance(event, dict) and event.get("tessera") == "install-facts":
        return install_facts()                         # invoked by the operator only; EventBridge never sends it
    iss = _issuer()
    budget = getattr(iss, "budget_s", POLL_BUDGET_S)   # ILC-I-02: never more than the time this invocation has left
    remaining = getattr(context, "get_remaining_time_in_millis", None)
    if remaining is not None:
        budget = min(budget, remaining() / 1000 - (POLLER_TIMEOUT_S - POLL_BUDGET_S))
    out = pipeline.poll(iss, budget_s=budget, schedule_time=_scheduled_time(event))
    return json.loads(json.dumps(out, default=str))
  admits every request the poller makes: DynamoDB, S3 (including the body read of `get_object`, inside the same guarded
  request) and SQS and SNS through `GuardedClient` around each SDK client; calendars, explorers and the resolver through
  `guarded_transport`; the pre-ship check directly. A request starts only if its configured worst case fits the time
  left minus a 10 s reserve, and the HTTP and DNS transports are given a timeout capped to what remains. Worst cases
  count the configured explorers and the SDK's retry attempts (`attempts x (connect + read) + back-off` = 73 s). Its
  purpose is that every invocation leaves durable progress: headers are checkpointed per height and as linked
  segments, a stale stored set is invalidated durably (ILC-I-03), the evidence already held is evaluated before any
  pending calendar is asked (ILC-I-05), calendar requests stop while one checkpoint write still fits (ILC-I2-03),
  requests are enumerated in bounded pages from a durable position moved before each request (ILC-I2-04), and draining
  signer responses has a cooperative allocation of a third of an invocation (ILC-I2-04, ILC-I3-02), split equally
  between the signer slots: EVERY slot gets its own share in EVERY poll, served in order, and a slot's unused share
  passes to the next (ILC-I5, owner decision: fairness by construction, so no ordering can starve a slot). The shares
  are checked between response-processing units (a receive, a response's handling), without reserving a unit's
  remaining cost, so one slow unit can overrun its share; it is not a total-time claim. Which slot goes first is only
  an ordering: floor(ordering input / 600 s) mod the number of slots, where the ordering input is the EventBridge
  schedule event's `time` (exact 10-minute steps), or the invocation's wall-clock start reading when the event has
  none. Running out of time never ends an attempt.
  **An overrun is a hard kill, and the protocol tolerates it:** the fence, the guarded writes and the checkpoints make
  a killed invocation's leftovers harmless. **Known limits on the deadline's precision** (not chased): the HTTP
  transport's socket timeout applies per blocking operation, so a server dripping bytes can exceed the request's
  total; a DNS query is a composite of UDP and TCP operations, each with its own allowance, and hostname resolution is
  not covered; an SDK request's connect and read timeouts are not a total-operation deadline (streamed bodies); the
  pre-ship check is local CPU with a 30 s admission estimate and no interruption. Measured progress envelope (tests):
  with any one client slow, every invocation stays within its deadline in the tests' fakes, and a request still
  completes with every DynamoDB request taking 20 s, every S3 request 10 s, every SQS or SNS request 60 s, every
  calendar, explorer or resolver request 15 s, or a 25 s pre-ship check; at DynamoDB 30 s or S3 20 s per request a
  stage can need more requests than one invocation admits and the request stalls (listed above).
