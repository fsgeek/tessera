def test_ILCI5_every_slot_is_served_whatever_the_ordering_input(monkeypatch):
    """Codex's parity lock-in probe (docs/reviews/issuer-lifecycle-impl/CODEX-CONFIRM-5.md): start readings 599 s
    into alternate 10-minute windows (+0 / +2 s) all pick slot 0, and KMS traffic is replenished before every poll.
    Each slot has its own share of the drain allocation, so GPG is served anyway."""
    monkeypatch.setitem(SLOW, "sqs", 20)
    loc, _ = aws_wire("sqs")
    _, rid = submit(loc, str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values():
        wk.process()
    base = ((int(loc.clock()) // 1200) + 1) * 1200
    junk = json.dumps({"request_id": "req-" + "0" * 40, "status": "SIGNED", "sig_b64": "AAAA"})
    for i in range(12):
        loc.clock.t = base + 599 + 600 * i + (0 if i % 2 == 0 else 2)
        for _ in range(100):
            loc.workers["kms"].responses.send(junk)
        assert pipeline._drain_start_slot(loc.iss, loc.clock(), 2) == 0
        pipeline.poll(loc.iss)
        if all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k):
            break
    assert all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k)


