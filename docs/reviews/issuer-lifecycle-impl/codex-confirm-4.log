def _end_attempt(iss, rec, outcome, reason, now, extra=None, no_successor=None):
    """End the current attempt (EXPIRED or DISCARDED, with its reason) and, in the SAME guarded write, allocate the
    next attempt, or refuse the request: ATTEMPTS_EXHAUSTED after attempt N, SIGNING_CLOSED when the next attempt
    would need signing after the stop (design step 8; the model's Commit of an ending write). no_successor names a
    reason no next attempt can be built at all (ILI-08: the content is lost); the request is then refused with it.
    extra: further fields of the attempt's end record (evidence, a diagnostic reference)."""
    assert outcome in ENDED
    expect = lifecycle_guard(rec)
    a, i = current(rec), rec["cur"]
    a.update(state=outcome, end={"outcome": OUTCOME[outcome], "reason": reason, "at": now, **(extra or {})},
             unavailable_since=None, failed_intervals=[])
    _event(rec, now, OUTCOME[outcome], a["id"], reason)
    if no_successor:
        return _end_request(iss, rec, expect, "REFUSED", no_successor, now)
    if i < N_ATTEMPTS and now <= iss.window.sign_until:
        rec["attempts"].append(new_attempt(i + 1, now))
        rec.update(cur=i + 1, stage="frames")
        _event(rec, now, "allocated", rec["attempts"][-1]["id"])
        return _commit(iss, rec, expect)
    _end_request(iss, rec, expect, "REFUSED", "ATTEMPTS_EXHAUSTED" if i >= N_ATTEMPTS else "SIGNING_CLOSED", now)


# ------------------------------------------------------------------------------------------------ cleanup (IS-07)
END_NS = ("content", "work", "frames")


def _cleanup_one(iss, rid, doc, now=None):
    """-> True when the obligation is discharged. Content, work files and frames go when the request has ended;
    the receipt goes 30 days after the end (or at once if the request did not complete). Deletion is keyed to the
    persisted end, never to an object's age; objects are tagged cleanup-due just before they are deleted (5.3.1).

    CF-02: a writer that read the request while it was ACCEPTED (an upload retry, a response consumer, a stale
    poller) may still store an object after the end. Each such writer runs inside one Lambda invocation, so it is
    gone WRITE_LEASE_S after the end was first seen here. Until then the obligation is kept and every poll deletes
    again; only a listing taken after the lease discharges it."""
    rec = iss.requests.get(rid)
    if rec is not None and rec["state"] == "ACCEPTED":
        return False                                   # not ended (an obligation written before a lost commit)
    seen = iss.clock()                                 # read after the record: no earlier than the end's commit
    expired = rec is None or seen >= rec["ended_at"] + RETENTION_S
    namespaces = END_NS + ("result",) if (expired or rec["state"] != "COMPLETE") else END_NS
    if doc.get("end_done") and not expired:
        return False
    if doc.get("fence_until") is None:                 # CF-02: start the writers' lease, durably
        doc = dict(doc, rid=rid, fence_until=seen + WRITE_LEASE_S)
        iss.requests.cleanup_put(rid, doc)
    for ns in namespaces:
        iss.results.mark_due(ns, rid)                  # due now: the lifecycle backstop may expire them from here on
        iss.results.delete(ns, rid)
    left = [ns for ns in namespaces if iss.results.names(ns, rid)]
    if left:
        raise StageError("objects left after deletion: " + ",".join(left))
    if seen < doc["fence_until"]:
        return False                                   # CF-02: a late writer may still store; delete again later
    if expired or "result" in namespaces:
        iss.requests.cleanup_done(rid)
        return True
    iss.requests.cleanup_put(rid, dict(doc, end_done=True))
    return False


def cleanup(iss):
    now, n = iss.clock(), 0
    for rid, doc in iss.requests.cleanup_list():
        try:
            n += bool(_cleanup_one(iss, rid, doc, now))
        except OutOfBudget:
            raise
        except Exception as e:  # noqa: BLE001
            iss.note("cleanup", rid[:12], "error, kept:", type(e).__name__, e)
    return n


# ------------------------------------------------------------------------------------------------ E-02 drain
def _position(iss):
    cur = iss.requests.cursor_get()
    return cur if isinstance(cur, dict) else {}


def _drain_turn(iss, position):
    """ILC-I3-01: the signer slot the drain starts with, kept in the poller's durable position record (not in the
    process: a cold-started Lambda rebuilds its signers in a fixed order)."""
    return int(position.get("drain_turn", 0))


def _drain_turn_put(iss, position, n):
    position["drain_turn"] = n                         # the request position writes that follow keep it too
    iss.requests.cursor_put(dict(position))


def drain(iss, max_batches=50, share_s=float("inf"), position=None):
    """Read every slot's response queue. Every response is logged (request id, slot, status, frame hash when the
    id is known, signature hash) whether or not it is used, and then deleted from the queue. ILC-I2-04: draining
    stops once it has used `share_s` of the invocation (or the deadline refuses a request); what is left stays queued
    and is delivered again, so a continuously replenished queue cannot starve request work."""
    n, d = 0, _deadline(iss)
    start = d.clock()

    def over():
        return d.clock() - start >= share_s or d.available() < MIN_REQUEST_S
    slots = list(iss.signers.items())
    position = _position(iss) if position is None else position
    turn = _drain_turn(iss, position) % max(1, len(slots))
    rotated = False
    try:
        for slot, signer in slots[turn:] + slots[:turn]:
            for _ in range(max_batches):
                if over():
                    return n
                batch = signer.receive(10)
                if not batch:
                    break
                if not rotated:                    # ILC-I3-01: durable before any response is worked on, so a
                    _drain_turn_put(iss, position, turn + 1)   # cold start continues the rotation; only written
                    rotated = True                 # when there is something to drain
                for handle, body in batch:
                    if over():
                        return n                   # not acknowledged: delivered again after the visibility timeout
                    try:
                        _take(iss, slot, signer, body)
                    except OutOfBudget:
                        raise
                    except Exception as e:  # noqa: BLE001  not acknowledged: the queue delivers it again
                        iss.note("response", slot, "not taken:", type(e).__name__, e)
                        continue
                    signer.ack(handle)
                    n += 1
    except OutOfBudget as e:
        iss.note("drain out of time:", e)
    return n


def _bounded(raw):
    """ILI-07: a signer-supplied reason as a bounded code. -> (code, diagnostic bytes or None)."""
    if raw is None:
        return None, None
    if isinstance(raw, str) and REASON_RE.match(raw):
        return raw, None
    data = raw.encode("utf-8", "replace") if isinstance(raw, str) else json.dumps(raw, sort_keys=True).encode()
    return "UNRECOGNIZED_REASON", data[:DIAG_MAX]


def _keep_diagnostic(iss, rid, aid, data):
    """Store an oversized or malformed external diagnostic by reference (deleted with the request's work files)."""
    digest = sha256hex(data)
    name = f"{aid}/diag-{digest}"
    iss.results.put("work", rid, name, data)
    return {"ref": name, "sha256": digest, "length": len(data)}


def _take(iss, slot, signer, body):
    """Route one signer response by (request, ATTEMPT, job). A response for an attempt that is not the request's
    current one is logged ("other-attempt") and ignored: it can never fill another attempt (step 2). Every field taken
    from the response is bounded before it is stored (ILI-07)."""
    now = iss.clock()
    raw_id = body.get("request_id")
    srid = raw_id if isinstance(raw_id, str) and REQUEST_ID_RE.match(raw_id) else None
    idx = iss.requests.sigreq_get(srid) if srid else None
    status = body.get("status") if body.get("status") in ("SIGNED", "REFUSED") else "OTHER"
    reason, diag = _bounded(body.get("reason"))
    sig = None
    if status == "SIGNED":
        try:
            sig = b64d(body.get("sig_b64", ""))
        except (ValueError, TypeError):
            sig = None
    entry = {"at": rfc3339(now), "slot": slot,
             "request_id": srid or "invalid:" + sha256hex(json.dumps(raw_id).encode())[:32], "status": status,
             "reason": reason, "frame_sha256": idx["frame_sha256"] if idx else None,
             "signature_sha256": sha256hex(sig) if sig is not None else None, "disposition": None,
             "attempt": idx.get("attempt") if idx else None}
    if diag is not None:
        entry.update(reason_sha256=sha256hex(diag), reason_length=len(diag))
    if idx is None or idx.get("slot") != slot:
        entry["disposition"] = "unrequested"
    else:
        rec = iss.requests.get(idx["rid"])
        a = current(rec) if rec else None
        job = a["jobs"].get(idx["job"]) if a else None
        if rec is None or rec["state"] != "ACCEPTED":
            entry["disposition"] = "not-waiting"
        elif a is None or a["id"] != idx.get("attempt"):
            entry["disposition"] = "other-attempt"
        elif rec["stage"] != "signing" or a["state"] != OPEN or job is None:
            entry["disposition"] = "not-waiting"
        elif job.get("sig_sha256"):
            entry["disposition"] = "duplicate"
        elif status == "REFUSED":
            entry["disposition"] = "refused"
            extra = {"diagnostic": _keep_diagnostic(iss, rec["rid"], a["id"], diag)} if diag is not None else None
            iss.requests.siglog_add(entry)
            return _end_attempt(iss, rec, DISCARDED, "SIGNER_REFUSED:" + str(reason or "NO_REASON"), now, extra)
        elif sig is None:
            entry["disposition"] = "malformed"
        else:
            frame = iss.results.get("work", rec["rid"], f"{a['id']}/{job['frame']}")
            if frame is None or sha256hex(frame) != job["frame_sha256"] or not signer.verify(frame, sig):
                entry["disposition"] = "bad-signature"
"""Repairs after Codex's second confirmation (docs/reviews/issuer-lifecycle-impl/CODEX-CONFIRM-2.md, ILC-I2-01..05)
under the owner's round-3 decisions. Codex's probes (/tmp/tmp.iALl276cQE/test_round2.py) are reproduced as
regression tests with the repaired behaviour as the oracle."""
import json
import uuid

import pytest

from tessera_issue import api, deadline, ots, pipeline
from tessera_issue.aws import S3ResultStore
from tessera_issue.service import POLL_BUDGET_S
from tessera_issue.util import DELTA, HOUR

from helpers import submit
from test_lifecycle import att, bury, declared, get, poll, sign, to_evidence
from test_lifecycle_confirm import SLOW, aws_wire
from test_lifecycle_repairs import latched


# ================================================================================================ ILC-I2-01
def test_ILCI2_01_an_S3_body_is_read_inside_the_guarded_request():
    """Codex's probe: get_object returned before Body.read(), so the body read ran outside the guard."""
    seen = []

    class Body:
        def read(self):
            seen.append(deadline.CALL_TIMEOUT.get())
            return b"body"

    class Client:
        def get_object(self, **kw):
            return {"Body": Body()}
    store = S3ResultStore(Client(), "b")
    clock = [0]
    with deadline.Installed(deadline.Deadline(lambda: clock[0], 290, 10)):
        assert store.get("work", "rid", "x") == b"body"
    assert seen and seen[0] is not None


def test_ILCI2_01_the_invocation_deadline_runs_on_a_monotonic_clock_not_the_wall_clock(loc, key):
    """A wall-clock step during a poll (NTP, a skewed host) does not consume or extend the invocation's time: the
    deadline is measured on the issuer's elapsed (monotonic) clock."""
    _, rid = submit(loc, key)
    _, rid2 = submit(loc, str(uuid.uuid4()), b"second")
    wall = loc.iss.clock
    steps = [0]

    def stepping_wall():
        steps[0] += 1
        return wall() + 10_000 * steps[0]                 # the wall clock jumps forward on every reading
    loc.iss.clock = stepping_wall
    out = pipeline.poll(loc.iss)
    loc.iss.clock = wall
    assert not out.get("out_of_time") and not out.get("deferred")
    assert get(loc, rid)["stage"] == get(loc, rid2)["stage"] == "signing"


# ================================================================================================ ILC-I2-02
@pytest.fixture
def short_rrsigs(monkeypatch):
    """Snapshots whose RRSIGs are valid when captured but expire 100 s later (Codex's probe)."""
    from tessera_issue import stand_in
    real = stand_in.rrsig

    def short(*args):
        return real(*args[:-1], args[-2] + 5 * 24 * HOUR + 100)
    monkeypatch.setattr(stand_in, "rrsig", short)


def test_ILCI2_02_an_RRSIG_expired_at_the_snapshot_anchor_is_recaptured(loc, key, short_rrsigs):
    rid, rec = latched(loc, key)
    captures = loc.world.dns.captures
    poll(loc)
    rec = get(loc, rid)
    last = [e for e in rec["events"] if e[1] == "preship-recapture"][-1]
    assert last[3] == "RRSIG_NOT_VALID_AT_EVAL_TIME" and last[4] == "13.5"
    assert rec["stage"] == "snapshot" and att(rec)["state"] == "latched"
    poll(loc)
    assert loc.world.dns.captures > captures                 # recaptured, not retried on the same snapshot


def test_ILCI2_02_an_expired_RRSIG_reaches_the_impossibility_proof(loc, key, short_rrsigs):
    rid, rec = latched(loc, key)
    loc.clock.t = declared(att(rec)) + DELTA + 100
    loc.world.chain.mine(20)                                 # the chain's median time past is past declared + delta
    poll(loc)
    rec = get(loc, rid)
    end = rec["attempts"][0]["end"]
    assert end["reason"] == "SNAPSHOT_IMPOSSIBLE" and end["evidence"]["snapshot_reason"] == "RRSIG_NOT_VALID_AT_EVAL_TIME"


def test_ILCI2_02_row_13_5_is_classified_by_reason():
    from tessera_verify.verify import Ledger
    for reason, kind in [("RRSIG_NOT_VALID_AT_EVAL_TIME", "snapshot"), ("RRSIG_INTERVAL_REVERSED", "snapshot"),
                         ("RRSIG_TIME_AMBIGUOUS", "snapshot"), ("KSK_OUTSIDE_RELIANCE_PERIOD", "retry"),
                         ("TRUST_HORIZON", "retry"), ("NO_TRUSTED_KSK_USABLE", "retry"),
                         ("TRUSTED_KSK_SIGNATURE_INVALID", "retry"), ("DNSSEC_SIGNATURE_INVALID", "retry")]:
        led = Ledger()
        led.fault("13.5", reason)
        assert pipeline.classify_preship(led)[0] == kind, reason


# ================================================================================================ ILC-I2-03
def test_ILCI2_03_calendar_progress_is_checkpointed_on_the_guarded_adapters():
    """Codex's probe: 20 pending calendars at 20 s each on the real guarded S3 adapter. The checkpoint writes are
    reserved before calendar requests are spent, so the cursor is saved and every calendar is reached across polls."""
    loc, _ = aws_wire("calendar")
    _, rid = submit(loc, str(uuid.uuid4()))
    to_evidence(loc, rid)
    raw = loc.iss.results.get("work", rid, "a1/receipt.ots")
    digest, root = ots.parse_file(raw)
    asked = []
    for i in range(20):
        uri = f"https://pending-{i}.invalid"

        def transport(method, url, body, i=i):
            asked.append(i)
            loc.clock.advance(20)
            return 404, b""
        loc.iss.calendars.append(ots.HttpCalendar(uri, transport))
        root.att(ots.PENDING, ots.pending_payload(uri))
    loc.iss.results.put("work", rid, "a1/receipt.upgraded.ots", ots.serialize_file(digest, root))
    for _ in range(8):
        poll(loc)
        if set(range(20)) <= set(asked):
            break
    assert set(range(20)) <= set(asked), sorted(set(asked))
    assert loc.iss.results.get("work", rid, "a1/receipt.upgrade-cursor") is not None


# ================================================================================================ ILC-I2-04
def test_ILCI2_04_every_request_advances_when_enumeration_is_slow(monkeypatch):
    """Codex's probe: 15 requests, every DynamoDB request taking 20 s. Enumeration is paged and resumable from a
    durable continuation position, so every request gets turns and advances."""
    monkeypatch.setitem(SLOW, "dynamodb", 20)
    loc, _ = aws_wire("dynamodb")
    loc.iss.budget_s = float("inf")
    rids = []
    for _ in range(15):
        k = str(uuid.uuid4())
        api.submit(loc.iss, "cred-A", k, b"x")
        rids.append(api.record_id("cred-A", k))
    loc.iss.budget_s = POLL_BUDGET_S
    for _ in range(30):
        pipeline.poll(loc.iss)
        if all(loc.iss.requests.get(r)["cur"] >= 1 for r in rids):
            break
    assert all(loc.iss.requests.get(r)["cur"] >= 1 for r in rids)


def test_ILCI2_04_a_flood_of_signer_responses_does_not_starve_request_work(monkeypatch):
    """Fairness between work classes: draining signer responses has a share of each invocation, so a queue that is
    continuously replenished cannot take every invocation from the requests."""
    monkeypatch.setitem(SLOW, "sqs", 20)
    loc, _ = aws_wire("sqs")
    _, rid = submit(loc, str(uuid.uuid4()))
    junk = json.dumps({"request_id": "req-" + "0" * 40, "status": "SIGNED", "sig_b64": "AAAA"})
    q = loc.workers["kms"].responses                        # the fake SQS queue behind the issuer's adapter
    for _ in range(3):
        for _ in range(300):                                 # replenished before every poll
            q.send(junk)
        pipeline.poll(loc.iss)
    assert get(loc, rid)["cur"] >= 1


# ================================================================================================ ILC-I2-05
def test_ILCI2_05_receipt_evidence_is_classified_while_snapshot_capture_keeps_failing(loc, key):
    """Codex's probe: the DNS capture keeps being rejected and the chain moves past the attempt's temporal limit. The
    receipt is still classified: its complete negative ends the attempt."""
    _, rid = submit(loc, key)
    poll(loc)
    sign(loc)
    poll(loc)
    loc.iss.dns.capture = lambda now: b"bad"
    for _ in range(3):
        poll(loc)
    rec = get(loc, rid)
    assert rec["stage"] == "evidence"
    bury(loc, declared(att(rec)) + DELTA + 20 * HOUR)
    poll(loc)
    rec = get(loc, rid)
    assert rec["attempts"][0]["state"] in ("discarded", "expired")
    assert rec["attempts"][0]["end"]["reason"] == "TIME_AFTER_DECLARED_DELTA"


def test_ILCI2_05_a_latch_without_any_snapshot_captures_one_before_finalizing(loc, key):
    _, rid = submit(loc, key)
    good = loc.iss.dns.capture
    loc.iss.dns.capture = lambda now: b"bad"
    a = att(to_evidence(loc, rid))
    bury(loc, declared(a) + HOUR)
    poll(loc)
    rec = get(loc, rid)
    assert att(rec)["state"] == "latched" and rec["stage"] == "snapshot"
    loc.iss.dns.capture = good
    loc.clock.t = declared(a) + 2 * HOUR
    poll(loc)
    loc.world.chain.mine(6)
    for _ in range(3):
        poll(loc)
    assert get(loc, rid)["state"] == "COMPLETE"


def test_ILCI2_05_no_snapshot_ever_captured_and_no_timely_anchor_possible_is_impossible(loc, key):
    _, rid = submit(loc, key)
    loc.iss.dns.capture = lambda now: b"bad"
    a = att(to_evidence(loc, rid))
    bury(loc, declared(a) + HOUR)
    poll(loc)
    assert get(loc, rid)["stage"] == "snapshot"
    loc.clock.t = declared(a) + DELTA + 100
    loc.world.chain.mine(20)
    poll(loc)
    end = get(loc, rid)["attempts"][0]["end"]
    assert end["reason"] == "SNAPSHOT_IMPOSSIBLE" and end["evidence"]["snapshot_reason"] == "NO_SNAPSHOT"


# ================================================================================================ ILC-I3-01
def test_ILCI3_01_the_drain_rotation_survives_cold_starts(monkeypatch):
    """Codex's eight-cold-start probe (docs/reviews/issuer-lifecycle-impl/CODEX-CONFIRM-3.md): 20 s SQS calls, the
    KMS response queue refilled before every poll, and a cold start (a fresh issuer object: in-memory state lost,
    signers rebuilt KMS first) before every poll. The starting slot is persisted with the poller's position, so the
    GPG queue gets its turns and the request reaches stamp."""
    monkeypatch.setitem(SLOW, "sqs", 20)
    loc, _ = aws_wire("sqs")
    _, rid = submit(loc, str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values():
        wk.process()
    junk = json.dumps({"request_id": "req-" + "0" * 40, "status": "SIGNED", "sig_b64": "AAAA"})
    for _ in range(8):
        for _ in range(100):
            loc.workers["kms"].responses.send(junk)
        for attr in ("drain_turn",):                      # a cold start: nothing kept in memory
            loc.iss.__dict__.pop(attr, None)
        pipeline.poll(loc.iss)
        if get(loc, rid)["stage"] != "signing":
            break
    assert get(loc, rid)["stage"] in ("stamp", "evidence")
     configuration (14.7), every configuration-dependent snapshot result (13.5 except its RRSIG-time reasons, which
     are in rule 2 - `validate_snapshot` against the configured root KSKs, reliance periods and trust horizon - and
     13.4's header outcomes), and every UNVERIFIABLE result outside rule 2.
  T > not-after discards (`T_AFTER_NOT_AFTER`).
- **SNAPSHOT_IMPOSSIBLE** (ILI-02, ILC-I-01, ILC-I-04). Discards only when both are proven from evidence: the snapshot
  being replaced failed a byte-only check (rule 2) and its proof is complete, so it can never pass; and the median
  time past of the eleven authenticated, linked headers ending five below the tip is later than declared + delta, so
  every new anchor fails row 13.7 (Bitcoin consensus: a block's time exceeds the median of its eleven predecessors,
  which never decreases). It is evaluated where the failure is found (finalization) and again before every recapture
  (the snapshot stage), so captures that keep being rejected cannot hold the attempt once it is proven. Elapsed time
  never discards. Assumption, as in the V1 contract: **no reorganisation of 6 or more blocks** (A1.6); it also
  underlies the header checkpoints.
- **Limits awaiting the author's termination decision (outside the step-5 gate).** These are disclosed limits, NOT
  satisfied obligations: each can keep a request open indefinitely, which leaves A2.3's termination obligation
  (`phase-0-prereg-amendment-2.md:288`) unmet in that case. Disclosure discharges nothing; an author decision (or an
  owner rule within registered text) is needed if they must end. From Codex's round-2 table E
  (`docs/reviews/issuer-lifecycle-impl/CODEX-CONFIRM-2.md`):

  | Path | Kind |
  |---|---|
  | A stage repeatedly needs more requests than one invocation admits before its durable completion (a very slow store or dependency; the measured envelope is below) | stated slow-store limit (a progress limitation; overrun is a tolerated hard kill, below) |
  | Snapshot recapture where impossibility cannot be proved: pending snapshot proof, unobtainable median-time-past headers, or insufficient chain progress | stated limit (absence of an impossibility proof never authorizes a discard) |
  | A latched attempt's snapshot proof never becomes usable; a preserved presentation or assembly object permanently missing | stated external-evidence / storage limit |
  | Unrepaired catalog or trust configuration (including configuration-dependent 13.5 outcomes), verifier unavailability, or persistent header / presentation disagreement | stated operator / dependency limit (no age-based ending is authorized) |
  | Persistent store or queue failures, failed guarded commits, or stage exceptions before a terminal write | operational limitation (no general termination guarantee; signing closure cannot complete a transition whose reads or writes stay unavailable) |
  | The chain never reaches the git pre-commitment depth, or no calendar ever accepts a stamp | dependency limit before evidence processing |

- **Presentation** (ILI-01, ILI-06). The latched presentation keeps only branches at the selected height whose
  attested message is that block's merkle root; contradicted branches there are dropped (counted in the latch as
  `contradicted_pruned`) and the pruned presentation is re-checked contradiction-free. Complete evidence in which every
  attestation is contradicted ends the attempt `EVIDENCE_CONTRADICTED` (discarded at or before B, expired after);
  incomplete or non-qualifying evidence stays open (ILI-03).
- **Signing closure** (ILI-04). Durable signatures (stored and logged "used") are reconciled before closure is
  decided; a complete recovered set is sealed whatever the window.
- **Content** (ILI-08). Content is checked before attempt 1 is allocated (`FAILED CONTENT_UNAVAILABLE`, no attempt).
  After allocation, lost content is recovered from an earlier attempt's attestation frame (it carries the bytes);
  if none decodes to the content digest, no attempt can ever be built, and the ending write discards the attempt and
  refuses the request `REFUSED CONTENT_UNAVAILABLE` (end-and-refuse, like `SIGNING_CLOSED`).
- **Invocation budget: a PROGRESS mechanism, not a bound** (ILI-05, ILC-I-02, ILC-I2-01; owner decision: the earlier
  "never overrun" claim is withdrawn). One deadline (`tessera_issue/deadline.py`), measured on a monotonic clock,
  admits every request the poller makes: DynamoDB, S3 (including the body read of `get_object`, inside the same guarded
  request) and SQS and SNS through `GuardedClient` around each SDK client; calendars, explorers and the resolver through
  `guarded_transport`; the pre-ship check directly. A request starts only if its configured worst case fits the time
  left minus a 10 s reserve, and the HTTP and DNS transports are given a timeout capped to what remains. Worst cases
  count the configured explorers and the SDK's retry attempts (`attempts x (connect + read) + back-off` = 73 s). Its
  purpose is that every invocation leaves durable progress: headers are checkpointed per height and as linked
  segments, a stale stored set is invalidated durably (ILC-I-03), the evidence already held is evaluated before any
  pending calendar is asked (ILC-I-05), calendar requests stop while one checkpoint write still fits (ILC-I2-03),
  requests are enumerated in bounded pages from a durable position moved before each request (ILC-I2-04), and draining
  signer responses has a cooperative allocation of a third of an invocation (ILC-I2-04, ILC-I3-02): it is checked
  between response-processing units (a receive, a response's handling), without reserving a unit's remaining cost, so
  one slow unit can overrun it; it is not a total-time claim. The signer slot the drain starts with rotates, and the
  rotation is kept in the poller's durable position record, so cold starts continue it (ILC-I3-01). Running out of time never ends an attempt.
  **An overrun is a hard kill, and the protocol tolerates it:** the fence, the guarded writes and the checkpoints make
  a killed invocation's leftovers harmless. **Known limits on the deadline's precision** (not chased): the HTTP
  transport's socket timeout applies per blocking operation, so a server dripping bytes can exceed the request's
  total; a DNS query is a composite of UDP and TCP operations, each with its own allowance, and hostname resolution is
  not covered; an SDK request's connect and read timeouts are not a total-operation deadline (streamed bodies); the
  pre-ship check is local CPU with a 30 s admission estimate and no interruption. Measured progress envelope (tests):
  with any one client slow, every invocation stays within its deadline in the tests' fakes, and a request still
  completes with every DynamoDB request taking 20 s, every S3 request 10 s, every SQS or SNS request 60 s, every
  calendar, explorer or resolver request 15 s, or a 25 s pre-ship check; at DynamoDB 30 s or S3 20 s per request a
  stage can need more requests than one invocation admits and the request stalls (listed above).
- **Snapshot capture does not gate the receipt** (ILC-I2-05). Stamping moves the attempt to evidence whether or not
  the DNSSEC snapshot capture succeeded; capture is retried in each evidence poll (early, since its anchor must be
  timely) and, if the attempt latches without one, before finalization (stage `snapshot`). A receipt's latch or
  conclusive negative is never held up by the snapshot. If no snapshot was ever captured and the median-time-past
  bound excludes every timely anchor, the attempt is discarded `SNAPSHOT_IMPOSSIBLE` (`NO_SNAPSHOT`).
- **13.5 by reason** (ILC-I2-02). `RRSIG_NOT_VALID_AT_EVAL_TIME`, `RRSIG_INTERVAL_REVERSED` and
  `RRSIG_TIME_AMBIGUOUS` depend on the snapshot's own RRSIG times against its anchored time: a recapture can repair
  them (and they count for the impossibility proof). Every other 13.5 outcome (configured KSK intervals, reliance
  periods, trust horizon, and conservatively the chain of trust built on them) is configuration-dependent and retried.
- **Bounded external fields** (ILI-07). Signer request ids, statuses and reasons are validated; an unrecognised or
  oversized reason becomes `UNRECOGNIZED_REASON` and the original is stored by reference (`diag-<sha256>`, with its
  digest and length). The DynamoDB fake rejects items over 400 KiB.
- **GATED.** `EVIDENCE_UNAVAILABLE` is not implemented in any form. An attempt whose evidence never completes stays
  open. `unavailable_since` and `failed_intervals` (runs of `fetch_start // 600`) are written for diagnosis only.
  Nothing here claims termination.
- **Storage.** No age rule applies to live objects: the S3 lifecycle rule expires only objects tagged `cleanup-due`,
  which the cleanup obligation sets just before deleting (content, work and frames at the end; the receipt 30 days
  after `ended_at`).
- **Public view.** ACCEPTED shows `attempt` {number, of, state} and, for an open attempt, `expiry_boundary` (B) with a
  note that the twelve-day budget is nominal; REFUSED lists each attempt's outcome and reason.
