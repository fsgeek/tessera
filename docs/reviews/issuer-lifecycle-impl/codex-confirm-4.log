import sys,json,uuid
sys.path.insert(0,'/home/tony/projects/tessera/service/issuer/tests')
from conftest import loc,key
from tessera_issue import pipeline
from test_lifecycle import att,get,poll,to_evidence,bury,declared
from test_lifecycle_confirm import aws_wire,SLOW
from helpers import submit
from tessera_issue.util import HOUR

def test_cold_starts_starve_second_signer(monkeypatch):
    monkeypatch.setitem(SLOW,'sqs',20)
    loc,_=aws_wire('sqs')
    _,rid=submit(loc,str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values(): wk.process()
    junk=json.dumps({'request_id':'req-'+'0'*40,'status':'SIGNED','sig_b64':'AAAA'})
    for n in range(8):
        for _ in range(100): loc.workers['kms'].responses.send(junk)
        loc.iss.drain_turn=0 # fresh Lambda issuer object; persistent stores and queues retained
        pipeline.poll(loc.iss)
    rec=get(loc,rid)
    print('COLD',rec['stage'],[(k,v['sig_sha256'] is not None) for k,v in att(rec)['jobs'].items()],len(loc.workers['gpg'].responses))
    assert rec['stage']=='signing'
    assert all(not v['sig_sha256'] for k,v in att(rec)['jobs'].items() if 'gpg' in k)
    assert len(loc.workers['gpg'].responses)>0
    pipeline.poll(loc.iss) # a warm continuation starts with GPG
    print('WARM',get(loc,rid)['stage'])
    assert get(loc,rid)['stage']=='stamp'

def test_no_snapshot_timely_capture_allowed(loc,key):
    good=loc.iss.dns.capture
    loc.iss.dns.capture=lambda now:b'bad'
    _,rid=submit(loc,key)
    a=att(to_evidence(loc,rid))
    bury(loc,declared(a)+HOUR)
    poll(loc)
    assert get(loc,rid)['stage']=='snapshot'
    loc.iss.dns.capture=good
    poll(loc)
    assert get(loc,rid)['stage']=='finalize'
    assert att(get(loc,rid))['state']=='latched'

def test_drain_share_is_cooperative_not_a_cap(monkeypatch):
    monkeypatch.setitem(SLOW,'sqs',60)
    loc,_=aws_wire('sqs')
    q=loc.workers['kms'].responses
    junk=json.dumps({'request_id':'req-'+'0'*40,'status':'SIGNED','sig_b64':'AAAA'})
    for _ in range(30): q.send(junk)
    from tessera_issue import deadline
    start=loc.clock()
    with deadline.Installed(deadline.Deadline(loc.iss.elapsed_clock,290,10)):
        pipeline.drain(loc.iss,share_s=290/3)
    span=loc.clock()-start
    print('DRAIN_SHARE',span,290/3)
    assert span>290/3
