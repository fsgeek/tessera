    ev = rec["attempts"][0]["end"]["evidence"]
    assert ev["median_time_past"] > ev["declared_plus_delta"] and ev["snapshot_reason"] == "SNAPSHOT_TIME"
    assert ev["mtp_heights"][1] == loc.world.chain.tip() - 5


