    pipeline._headers = headers
if MUT == "ILI05_NOCURSOR":
    stores.InMemoryRequestStore.cursor_get = lambda self: None
if MUT == "ILI07_RAW":
    pipeline._bounded = lambda raw: (raw, None)
if MUT == "ILI08":
    pipeline._recover_content = lambda iss, rec: None
if MUT == "APIWRITE":
