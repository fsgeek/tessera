   511	        jobs[job] = {"slot": slot, "frame": fname, "frame_sha256": sha256hex(frames[fname]), "request_id": srid,
   512	                     "sent_at": now, "attempts": 1, "sig_sha256": None}
   513	        iss.requests.sigreq_put(srid, {"rid": rec["rid"], "attempt": aid, "job": job, "slot": slot,
   514	                                       "frame_sha256": jobs[job]["frame_sha256"]}, now + RETENTION_S)
   515	    g = lifecycle_guard(rec)
   516	    a["jobs"] = jobs
   517	    rec["stage"] = "signing"
   518	    _event(rec, now, "frames", aid, declared)
   519	    _commit(iss, rec, g)                             # durable before anything is sent
   520	    for job, _, _ in JOBS:
   521	        _send(iss, rec, a, job)
   522	    for slot in iss.signers:
