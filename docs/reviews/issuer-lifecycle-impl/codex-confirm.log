"""A complete local issuer on stand-ins: in-memory stores and queues, stand-in signers (TEST keys), the stand-in
calendar and chain, the TEST DNS hierarchy. Used by the tests and for local runs.

  python -m tessera_issue.local --freeze FROZEN_OBJECTS_DIR --out DIR     # one receipt, offline"""
import argparse
import json
from dataclasses import dataclass
from pathlib import Path

from . import api, freeze, pipeline
from .chain import ExplorerHeaders
from .dns import LiveDns
from .ots import HttpCalendar
from .preship import PreShip
from .queues import InMemoryQueue
from .service import Issuer
from .signers import SlotSigner, StandInSigner
from .stand_in import World
from .stores import InMemoryRequestStore, InMemoryResultStore
from .util import DAY, FakeClock, rfc3339, ts


@dataclass
class Local:
    iss: Issuer
    world: World
    workers: dict          # slot -> StandInSigner
    clock: FakeClock

    def tick(self, run_signers=True, mine=True, step=600):
        """One poller period: signers answer what is queued, the poller runs, ten minutes pass, a block is mined."""
        if run_signers:
            for w in self.workers.values():
                w.process()
        out = pipeline.poll(self.iss)
        self.clock.advance(step)
        if mine:
            self.world.chain.mine(1)
        return out

    def run_until_done(self, rid, max_ticks=200, **kw):
        for _ in range(max_ticks):
            rec = self.iss.requests.get(rid)
            if rec["state"] != "ACCEPTED":
                return rec
            self.tick(**kw)
        return self.iss.requests.get(rid)


def build(objects_dir, start="2026-11-02T00:00:00Z", window_days=30, wire=False, seed="stand-in"):
    """wire=True puts the real protocol clients (HttpCalendar, ExplorerHeaders over two explorers, LiveDns) in
    front of the stand-ins, so the issuer reaches them only through the calendar, explorer and resolver protocols."""
    clock = FakeClock(ts(start))
    world = World(clock, seed)
    nb = rfc3339(ts(start) - DAY)
    window = world.prepare_window(nb, rfc3339(ts(nb) + window_days * DAY))
    frozen = freeze.load(objects_dir)
    queues = {s: (InMemoryQueue(clock), InMemoryQueue(clock)) for s in ("kms", "gpg")}
    wakes = []
    signers = {"kms": SlotSigner("kms", world.kms_key.spki, *queues["kms"], wake=wakes.append),
               "gpg": SlotSigner("gpg", world.gpg_key.pgp_body, *queues["gpg"], wake=wakes.append)}
    if wire:
        cal = HttpCalendar(world.calendar.uri, world.calendar.serve)
        hdr = ExplorerHeaders(["https://explorer-a.invalid/api", "https://explorer-b.invalid/api"],
                              world.chain.serve_esplora)
        dns = LiveDns(world.dns.serve(clock))
    else:
        cal, hdr, dns = world.calendar, world.chain, world.dns
    iss = Issuer(window=window, frozen=frozen, requests=InMemoryRequestStore(), results=InMemoryResultStore(),
                 signers=signers, calendars=[cal], headers=hdr, dns=dns,
                 preship=PreShip(frozen, window.trust_base), clock=clock)
    iss.wakes = wakes
    workers = {s: StandInSigner(s, k, *queues[s], clock, sign_until=window.sign_until, fetch=iss.results.get_ref)
               for s, k in (("kms", world.kms_key), ("gpg", world.gpg_key))}
    return Local(iss, world, workers, clock)


def main():
    import uuid
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--freeze", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--content", default="TEST content for a local stand-in issuance\n")
    a = ap.parse_args()
    loc = build(a.freeze)
    key = str(uuid.uuid4())
    r = api.submit(loc.iss, "local-credential", key, a.content.encode())
    print(r.status, json.dumps(r.body))
    rec = loc.run_until_done(api.record_id("local-credential", key))
    print(json.dumps(api.view(rec, loc.clock())))
nowhere. A9.7 row 12 (`:476`) replaces A3's refusal-record decomposition (`phase-0-prereg-amendment-3.md:572-581`: a
portable record, a public commitment, and delivery and publication states) with "Bounded local refusal returned
by the API", class **C**: a capability not offered by V1. A9.3 (`:238`) moves the portable form to the later
"Portable refusal records".

**Reading.** In V1 a refusal is *local*: it is returned by the API to the requesting credential and kept as
operator state. It is not a signed or portable record, and it carries no commitment and no publication. It is
*bounded* in three ways:

1. **Closed reasons.** Refusals are typed from a fixed set. At submission: REFUSED with `TOO_LARGE`,
   `OUTSIDE_WINDOW`, `CLOSING`, `SIGNING_UNAVAILABLE` or `BAD_REQUEST`. After acceptance: REFUSED with
   `ATTEMPTS_EXHAUSTED`, `SIGNING_CLOSED` or `CONTENT_UNAVAILABLE` (the content was lost after an attempt was
   allocated and could not be recovered). Each ended attempt's reason is listed:
   - `EXPIRED` and `DISCARDED`, each with its cause: a failed conjunct on complete evidence;
     `EVIDENCE_CONTRADICTED`; `SNAPSHOT_IMPOSSIBLE`; `T_AFTER_NOT_AFTER` (A9 issuer invariant); `PRESHIP:INVALID/<code>@<row>` for a failure in the
     attempt's frozen material; or `SIGNER_REFUSED:<reason>`;
   - an unrecognised or oversized signer reason, reported as `UNRECOGNIZED_REASON`.

   One case precedes any attempt: FAILED `CONTENT_UNAVAILABLE`, when an accepted upload never completed. Nothing
   else is said about a refused request. *(Revised 2026-10-29 and 2026-10-30, Amendment 11 c016 and the issuer
   implementation review ILI-01 to ILI-08: FAILED is withdrawn after acceptance, except before any attempt.)*
2. **Bounded by the registered lifecycle, not by a clock.** An accepted request ends only as A2.1 and A2.3 allow:
   at most N = 3 attempts, each expiring only after `declared + δ + S` and only on complete negative evidence. N ×
   (δ + S) is a nominal budget, not a bound. *(Narrowed 2026-10-29: the earlier "within 24 hours of acceptance (S4)"
   is withdrawn, because it contradicted A2. While the author's decision on unobtainable evidence is pending, an
   attempt whose evidence never completes stays open, so no time bound is claimed;
   `docs/decisions/2026-10-29-issuance-lifecycle.md`, step 5 and "Implementation boundary".)*
3. **Bounded in scope.** By A9's issuer invariant, a refusal never concerns a shipped receipt
   (`phase-0-prereg-amendment-9.md:165`).

**Evidence.** The issuer's state and refusal tests (`service/issuer/tests/`) show it locally. The E10 issuing
