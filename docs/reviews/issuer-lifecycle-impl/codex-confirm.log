        rank={r:i for i,r in enumerate(ROWS)}
        for kind,verdict in [('invalid','INVALID'),('unknown','UNVERIFIABLE')]:
            candidates=[c for c in self.checks if c.status==kind and c.reason]
            if candidates:
                winner=min(candidates,key=lambda c:(rank[c.row],c.tie))
                return stable(verdict,winner.reason,t)
        return stable('VALID_STRICT','OK',t)
    def diagnostics(self):
        result=[]
        for row in ROWS:
            seen=[c for c in self.checks if c.row==row]
            result.extend(seen or [Check(row,'blocked')])
        return result

def stable(verdict,reason,t=None):
    return {'historical_security':'NOT_EVALUATED','reason':reason,'revocation':'NOT_EVALUATED',
            'standing':'ABSENT/NOT_ISSUED_IN_PROFILE','T':isotime(t) if t is not None else None,'verdict':verdict}

# A10.1.1 / profile 7.4: conditional UTC assessment. Outside the stable six; never enters a verdict.
# Delta and m are read from the (parsed, authenticated) catalog entry; nothing in this module supplies them.

def utc_assessment(selected=None,catalog=None):
    entry=next(iter(catalog.values()))
    delta,m=int(entry['utc_delta_s']),int(entry['utc_m'])
    # Null exactly when T is null: callers pass the selected anchor only when T is reported.
    # Python ints never wrap, so Delta + max(uint32 nTime) is the 64-bit sum without reduction mod 2^32.
    bound=None if selected is None else isotime(delta+selected.latest)
    return {'assumption_id':f'A-UTC-{delta}-{m}','utc_upper_bound':bound}

BINARY={'a_sig','manifest','spec','vectors','preamble','dependency_manifest'}
NESTED={'possession':{'kms','gpg'},'keys':{'kms','gpg'},'receipt_anchor':{'ots','txid'},
        'dns':{'ots','snapshot_body'},'git':{'blob','commit','object_format','ots','trees'},
        'issuer_record':{'observed_anchor_delay_s','policy_version'}}
REQUIRED=BINARY|set(NESTED)-{'issuer_record'}|{'headers'}
DEC=re.compile(r'(?:0|[1-9][0-9]*)\Z')

def decimal_string(v): return isinstance(v,str) and not isinstance(v,Literal) and len(v)<=10 and DEC.fullmatch(v) and int(v)<=4294967295

def container_schema(obj,ledger):
    raw={}; layer=obj['layers'][0]
    if set(obj)!={'profile','layers'}: ledger.fault('2.4','CONTAINER_SCHEMA',('top',))
    if not isinstance(layer,dict): ledger.fault('2.4','CONTAINER_SCHEMA',('layer',)); return raw
    def missing(path): ledger.fault('2.2','GIT_OBJECT_FORMAT_MISSING' if path=='git.object_format' else 'MEMBER_MISSING:'+path,(path.encode('utf-16be'),),True)
    def bad(path): ledger.fault('2.4','CONTAINER_SCHEMA',(path.encode('utf-16be'),))
    def binary(value,path):
        try: raw[path]=b64(value)
        except Fault: bad(path)
    for k in sorted(REQUIRED):
        if k not in layer: missing(k)
    for k,value in layer.items():
        if k in BINARY: binary(value,k)
        elif k in NESTED:
            if not isinstance(value,dict): bad(k); continue
            for f in sorted(NESTED[k]):
                path=k+'.'+f
                if f not in value:
                    if k=='issuer_record': bad(path)
                    else: missing(path)
"""Message queues behind one interface: in memory (tests, local runs) and SQS (AWS). The in-memory queue enforces
SQS's message size limit."""
import itertools
from dataclasses import dataclass


@dataclass
class Message:
    id: str
    body: str
    handle: str


SQS_MAX_BYTES = 1048576              # SendMessage maximum message size


class Queue:
    def send(self, body):
        raise NotImplementedError

    def receive(self, max_messages=10, wait_s=0):
        raise NotImplementedError

    def delete(self, handle):
        raise NotImplementedError


class InMemoryQueue(Queue):
    """At-least-once queue with a visibility timeout, like SQS: a received message is hidden until it is deleted or
    its visibility timeout passes (measured on the given clock)."""

    def __init__(self, clock, visibility_s=300, max_bytes=SQS_MAX_BYTES):
        self.clock, self.visibility_s, self.max_bytes = clock, visibility_s, max_bytes
        self.msgs = {}                       # id -> {"body", "visible_at", "handle"}
        self._ids = itertools.count(1)

    def send(self, body):
        if len(body.encode()) > self.max_bytes:          # as SQS does (IS-09): the stand-in must not hide it
            raise ValueError(f"message of {len(body.encode())} bytes exceeds {self.max_bytes}")
        mid = f"m{next(self._ids)}"
        self.msgs[mid] = {"body": body, "visible_at": 0, "handle": None}
        return mid

    def receive(self, max_messages=10, wait_s=0):
        now, out = self.clock(), []
        for mid, m in self.msgs.items():
            if len(out) >= max_messages:
                break
            if m["visible_at"] <= now:
                m["visible_at"] = now + self.visibility_s
                m["handle"] = f"{mid}:{next(self._ids)}"
                out.append(Message(mid, m["body"], m["handle"]))
        return out

    def delete(self, handle):
        mid = handle.split(":")[0]
        m = self.msgs.get(mid)
        if m is not None and m["handle"] == handle:
            del self.msgs[mid]

    def __len__(self):
        return len(self.msgs)


class SqsQueue(Queue):
    """SQS through an injected boto3-style client (`boto3.client("sqs")`)."""

    def __init__(self, client, url):
        self.client, self.url = client, url

    def send(self, body):
        return self.client.send_message(QueueUrl=self.url, MessageBody=body)["MessageId"]

    def receive(self, max_messages=10, wait_s=0):
        r = self.client.receive_message(QueueUrl=self.url, MaxNumberOfMessages=max(1, min(10, max_messages)),
                                        WaitTimeSeconds=wait_s)
        return [Message(m["MessageId"], m["Body"], m["ReceiptHandle"]) for m in r.get("Messages", [])]

    def delete(self, handle):
        self.client.delete_message(QueueUrl=self.url, ReceiptHandle=handle)
