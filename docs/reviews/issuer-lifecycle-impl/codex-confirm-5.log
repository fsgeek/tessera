# ------------------------------------------------------------------------------------------------ the poller
def poll(iss, budget_s=None):
    """One scheduled tick under one deadline (ILC-I-02; its clock is monotonic, ILC-I2-01). Work classes share the
    invocation (ILC-I2-04): draining signer responses may use at most DRAIN_SHARE of it; requests then get the rest.
    Requests are enumerated in bounded pages from a DURABLE continuation position (RequestStore.active_page and the
    poller cursor), and the position is moved past a request BEFORE it is worked on, so neither a long active list
    nor a request that exhausts (or kills) an invocation takes the others' turns. -> summary dict."""
    wall_start = iss.clock()                           # ILC-I4-01: the invocation's start reading (schedule window)
    d = deadline.Deadline(getattr(iss, "elapsed_clock", None) or iss.clock,          # ILC-I2-01: monotonic
                          iss.budget_s if budget_s is None else budget_s, POLL_RESERVE_S)
    out = {"drained": 0, "advanced": {}, "cleaned": 0}
    with deadline.Installed(d):
        try:
            out["drained"] = drain(iss, share_s=DRAIN_SHARE * d.limit, wall_start=wall_start)
            _serve_requests(iss, d, out)
            if d.available() >= MIN_REQUEST_S:
                out["cleaned"] = cleanup(iss)
        except OutOfBudget as e:                       # out of time outside a request's turn: resumed next poll
            iss.note("poll out of time:", e)
            out["out_of_time"] = True
    return out


def _serve_requests(iss, d, out):
    store = iss.requests
    position = _position(iss)
    keep = {k: v for k, v in position.items() if k not in ("token", "skip", "drain_turn")}

    def put(pos):
        store.cursor_put(dict(keep, **pos))
    cur = {"token": position.get("token"), "skip": position.get("skip", 0)}
    seen, served, wrapped = set(), 0, False
    while True:
        rids, nxt = store.active_page(cur["token"], ENUM_PAGE)
        if not rids and cur["token"] is not None and not wrapped:
            cur, wrapped = {"token": None, "skip": 0}, True            # end of the list: start again from the top
            continue
        for i in range(cur["skip"], len(rids)):
# ------------------------------------------------------------------------------------------------ E-02 drain
def _position(iss):
    cur = iss.requests.cursor_get()
    return cur if isinstance(cur, dict) else {}


def _drain_start_slot(iss, wall_start, n):
    """ILC-I3-01 / ILC-I4-01 (owner decision): the signer slot the drain starts with is derived from the poll's
    SCHEDULED time: floor(wall-clock start reading / poll interval) mod the number of slots. It needs no write (so no
    budget can be spent before it takes effect), survives cold starts, and alternates across the 10-minute schedule
    windows; two polls in one window may start with the same slot, and the next window alternates."""
    return (int(wall_start) // POLL_INTERVAL_S) % max(1, n)


def drain(iss, max_batches=50, share_s=float("inf"), wall_start=None):
    """Read every slot's response queue. Every response is logged (request id, slot, status, frame hash when the
    id is known, signature hash) whether or not it is used, and then deleted from the queue. ILC-I2-04: draining
    stops once it has used `share_s` of the invocation (or the deadline refuses a request); what is left stays queued
    and is delivered again, so a continuously replenished queue cannot starve request work."""
    n, d = 0, _deadline(iss)
    start = d.clock()

    def over():
        return d.clock() - start >= share_s or d.available() < MIN_REQUEST_S
    slots = list(iss.signers.items())
    turn = _drain_start_slot(iss, iss.clock() if wall_start is None else wall_start, len(slots))
    try:
        for slot, signer in slots[turn:] + slots[:turn]:
            for _ in range(max_batches):
                if over():
                    return n
                batch = signer.receive(10)
                if not batch:
                    break
                for handle, body in batch:
                    if over():
                        return n                   # not acknowledged: delivered again after the visibility timeout
                    try:
                        _take(iss, slot, signer, body)
                    except OutOfBudget:
                        raise
                    except Exception as e:  # noqa: BLE001  not acknowledged: the queue delivers it again
                        iss.note("response", slot, "not taken:", type(e).__name__, e)
                        continue
                    signer.ack(handle)
                    n += 1
    except OutOfBudget as e:
        iss.note("drain out of time:", e)
    return n


def _bounded(raw):
    assert end["reason"] == "SNAPSHOT_IMPOSSIBLE" and end["evidence"]["snapshot_reason"] == "NO_SNAPSHOT"


# ================================================================================================ ILC-I3-01
def test_ILCI3_01_the_drain_rotation_survives_cold_starts(monkeypatch):
    """Codex's eight-cold-start probe (docs/reviews/issuer-lifecycle-impl/CODEX-CONFIRM-3.md): 20 s SQS calls, the
    KMS response queue refilled before every poll, and a cold start (a fresh issuer object: in-memory state lost,
    signers rebuilt KMS first) before every poll. The starting slot is persisted with the poller's position, so the
    GPG queue gets its turns and the request reaches stamp."""
    monkeypatch.setitem(SLOW, "sqs", 20)
    loc, _ = aws_wire("sqs")
    _, rid = submit(loc, str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values():
        wk.process()
    junk = json.dumps({"request_id": "req-" + "0" * 40, "status": "SIGNED", "sig_b64": "AAAA"})
    for _ in range(8):
        for _ in range(100):
            loc.workers["kms"].responses.send(junk)
        for attr in ("drain_turn",):                      # a cold start: nothing kept in memory
            loc.iss.__dict__.pop(attr, None)
        pipeline.poll(loc.iss)
        if get(loc, rid)["stage"] != "signing":
            break
    assert get(loc, rid)["stage"] in ("stamp", "evidence")


# ================================================================================================ ILC-I4-01
def test_ILCI4_01_an_empty_first_queue_under_a_reduced_budget_does_not_starve_the_other_signer(monkeypatch):
    """Codex's reduced-budget probe (docs/reviews/issuer-lifecycle-impl/CODEX-CONFIRM-4.md): only valid GPG replies
    wait; every SQS request takes 60 s; every poll has a 190 s budget. The starting slot is derived from the poll's
    scheduled time (no write to spend budget on), so it alternates across schedule windows and GPG is served."""
    monkeypatch.setitem(SLOW, "sqs", 0)
    loc, _ = aws_wire("sqs")
    _, rid = submit(loc, str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values():
        wk.process()
    for handle, body in loc.iss.signers["kms"].receive():         # KMS delivered; only GPG replies wait
        pipeline._take(loc.iss, "kms", loc.iss.signers["kms"], body)
        loc.iss.signers["kms"].ack(handle)
    for signer in loc.iss.signers.values():
        signer.responses.client._client._delay = 60
    for _ in range(12):
        pipeline.poll(loc.iss, budget_s=190)
        if all(v["sig_sha256"] for v in att(get(loc, rid))["jobs"].values()):
            break
    assert all(v["sig_sha256"] for k, v in att(get(loc, rid))["jobs"].items() if "gpg" in k)


def test_ILCI4_01_the_starting_slot_alternates_by_schedule_window(loc):
    starts = []
    real = pipeline._drain_start_slot

    def record(iss, wall, n):
        starts.append(real(iss, wall, n))
        return starts[-1]
    pipeline._drain_start_slot = record
    try:
        for _ in range(4):
            pipeline.poll(loc.iss)
            loc.clock.advance(600)
    finally:
        pipeline._drain_start_slot = real
    assert starts == [starts[0], 1 - starts[0], starts[0], 1 - starts[0]]
