# ------------------------------------------------------------------------------------------------ request store
resource "aws_dynamodb_table" "requests" {
  name         = "${var.name}-requests"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"

  attribute {
    name = "pk"
    type = "S"
  }

  attribute {
    name = "pending_shard"
    type = "S"
  }

  global_secondary_index {
    name            = "pending-index"
    hash_key        = "pending_shard"
    projection_type = "KEYS_ONLY"
  }

  # S5/S6: records expire 30 days after the request ends; key tombstones after issuance closes.
  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }

  point_in_time_recovery {
    enabled = true
  }

  server_side_encryption {
    enabled = false # AWS-owned key; the issuer has no KMS permissions
  }
}

# ------------------------------------------------------------------------------------------------ result store
resource "aws_s3_bucket" "results" {
  bucket_prefix = "${var.name}-results-"
}

resource "aws_s3_bucket_public_access_block" "results" {
  bucket                  = aws_s3_bucket.results.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "results" {
  bucket = aws_s3_bucket.results.id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "results" {
  bucket = aws_s3_bucket.results.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256" # SSE-S3, not SSE-KMS
    }
  }
}

resource "aws_s3_bucket_versioning" "results" {
  bucket = aws_s3_bucket.results.id
  versioning_configuration {
    status = "Disabled" # S6: no hidden copies outlive the 30-day deletion
  }
}

# Storage lifetime (docs/decisions/2026-10-29-issuance-lifecycle.md, revision 5.3.1; ILC3-04, ILC4-01). No age rule
# applies to a live request's objects: an attempt may stay open far longer than any fixed age, and its frozen material
# and preserved presentation must survive. Deletion is keyed to the request's persisted end (S6): the poller's cleanup
# obligation (IS-07) deletes content, work files and frames at the end and the receipt 30 days after ended_at, and
# just before deleting it tags the objects cleanup-due. This rule is only the backstop for deletions that keep
# failing: it expires TAGGED objects only, so an object's creation age never makes it deletable early.
resource "aws_s3_bucket_lifecycle_configuration" "results" {
  bucket = aws_s3_bucket.results.id

  rule {
    id     = "expire-cleanup-due"
    status = "Enabled"
    filter {
      tag {
        key   = "cleanup-due"
        value = "true"
      }
    }
    expiration {
      days = 1
    }
  }

  # Incomplete multipart uploads are never live objects (AWS does not allow this action with a tag filter).
  rule {
    id     = "abort-incomplete-multipart-uploads"
    status = "Enabled"
    filter {
      prefix = ""
    }
    abort_incomplete_multipart_upload {
      days_after_initiation = 1
    }
  }
}

resource "aws_s3_bucket_policy" "results_tls_only" {
  bucket = aws_s3_bucket.results.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "DenyInsecureTransport"
      Effect    = "Deny"
      Principal = "*"
      Action    = "s3:*"
      Resource  = [aws_s3_bucket.results.arn, "${aws_s3_bucket.results.arn}/*"]
      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    }]
  })
}

# ------------------------------------------------------------------------------------------------ signer queues
resource "aws_sqs_queue" "requests" {
  for_each                   = toset(local.slots)
  name                       = "${var.name}-${each.key}-requests"
  message_retention_seconds  = 86400
  visibility_timeout_seconds = 120
  sqs_managed_sse_enabled    = true
}

resource "aws_sqs_queue" "responses" {
  for_each                   = toset(local.slots)
  name                       = "${var.name}-${each.key}-responses"
  message_retention_seconds  = 1209600 # 14 days: late answers stay until the poller logs and deletes them (E-02)
  visibility_timeout_seconds = 60
  sqs_managed_sse_enabled    = true
}

# E-01: the issuer wakes a slot's signer on demand; the signer side subscribes.
resource "aws_sns_topic" "wake" {
  for_each = toset(local.slots)
  name     = "${var.name}-${each.key}-wake"
}

# ------------------------------------------------------------------------------------------------ IAM
data "aws_iam_policy_document" "lambda_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "api" {
  name               = "${var.name}-api"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

resource "aws_iam_role" "poller" {
  name               = "${var.name}-poller"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

# No statement in either issuer policy grants any kms: action (tests/test_infra.py checks this).
data "aws_iam_policy_document" "api" {
  statement {
    sid       = "Requests"
    actions   = ["dynamodb:GetItem", "dynamodb:PutItem"]
    resources = [aws_dynamodb_table.requests.arn]
  }
  # IS-10: the API writes submitted content (and removes it if its request ended meanwhile) and reads receipts.
  statement {
    sid       = "WriteContent"
    actions   = ["s3:PutObject", "s3:DeleteObject"]
    resources = ["${aws_s3_bucket.results.arn}/content/*"]
  }
  statement {
    sid       = "ReadResults"
    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.results.arn}/result/*"]
  }
  statement {
    sid       = "ListContent"
    actions   = ["s3:ListBucket"]
    resources = [aws_s3_bucket.results.arn]
    condition {
      test     = "StringLike"
      variable = "s3:prefix"
      values   = ["content/*"]
    }
  }
  statement {
    sid       = "Config"
    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.results.arn}/config/*"]
  }
  statement {
    sid       = "Logs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.api.arn}:*"]
  }
}

data "aws_iam_policy_document" "poller" {
  statement {
    sid       = "Requests"
    actions   = ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan"]
    resources = [aws_dynamodb_table.requests.arn, "${aws_dynamodb_table.requests.arn}/index/pending-index"]
  }
  # IS-10: mutation only in the operational namespaces; configuration is read-only. PutObjectTagging: the cleanup
  # obligation tags objects cleanup-due once their deletion is due (5.3.1).
  statement {
    sid       = "Objects"
    actions   = ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:PutObjectTagging"]
    resources = ["${aws_s3_bucket.results.arn}/content/*", "${aws_s3_bucket.results.arn}/work/*", "${aws_s3_bucket.results.arn}/frames/*", "${aws_s3_bucket.results.arn}/result/*"]
  }
  statement {
    sid       = "Config"
    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.results.arn}/config/*"]
  }
  statement {
    sid       = "List"
    actions   = ["s3:ListBucket"]
    resources = [aws_s3_bucket.results.arn]
  }
  statement {
    sid       = "SignerRequests"
    actions   = ["sqs:SendMessage"]
    resources = [for q in aws_sqs_queue.requests : q.arn]
  }
  statement {
    sid       = "SignerResponses"
    actions   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
    resources = [for q in aws_sqs_queue.responses : q.arn]
  }
  statement {
    sid       = "Wake"
    actions   = ["sns:Publish"]
    resources = [for t in aws_sns_topic.wake : t.arn]
  }
  statement {
    sid       = "Logs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.poller.arn}:*"]
  }
}

resource "aws_iam_role_policy" "api" {
  name   = "issuer-api"
  role   = aws_iam_role.api.id
  policy = data.aws_iam_policy_document.api.json
}

resource "aws_iam_role_policy" "poller" {
  name   = "issuer-poller"
  role   = aws_iam_role.poller.id
  policy = data.aws_iam_policy_document.poller.json
}

# The remote signers' queue access (each slot sees only its own queues). Their signing keys are elsewhere.
data "aws_iam_policy_document" "signer_assume" {
  for_each = var.signer_principals
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "AWS"
      identifiers = [each.value]
    }
  }
}

resource "aws_iam_role" "signer" {
  for_each           = var.signer_principals
  name               = "${var.name}-signer-${each.key}"
  assume_role_policy = data.aws_iam_policy_document.signer_assume[each.key].json
}

data "aws_iam_policy_document" "signer" {
  for_each = var.signer_principals
  statement {
    actions   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
    resources = [aws_sqs_queue.requests[each.key].arn]
  }
  statement {
    actions   = ["sqs:SendMessage"]
    resources = [aws_sqs_queue.responses[each.key].arn]
  }
  # IS-09: frames too large for a queue message are read by digest-bound reference.
  statement {
    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.results.arn}/frames/*"]
  }
}

resource "aws_iam_role_policy" "signer" {
  for_each = var.signer_principals
  name     = "signer-queues"
  role     = aws_iam_role.signer[each.key].id
  policy   = data.aws_iam_policy_document.signer[each.key].json
}

# ------------------------------------------------------------------------------------------------ Lambda
resource "aws_cloudwatch_log_group" "api" {
  name              = "/aws/lambda/${var.name}-api"
  retention_in_days = 30
}

resource "aws_cloudwatch_log_group" "poller" {
  name              = "/aws/lambda/${var.name}-poller"
  retention_in_days = 30
}

resource "aws_lambda_function" "api" {
  function_name    = "${var.name}-api"
  role             = aws_iam_role.api.arn
  runtime          = var.lambda_runtime
  handler          = "tessera_issue.lambda_app.api_handler"
  filename         = var.lambda_zip
  source_code_hash = filebase64sha256(var.lambda_zip)
  timeout          = 29
  memory_size      = 512
  environment {
    variables = local.lambda_env
  }
  depends_on = [aws_cloudwatch_log_group.api]
}

resource "aws_lambda_function" "poller" {
  function_name                  = "${var.name}-poller"
  role                           = aws_iam_role.poller.arn
  runtime                        = var.lambda_runtime
  handler                        = "tessera_issue.lambda_app.poller_handler"
  filename                       = var.lambda_zip
  source_code_hash               = filebase64sha256(var.lambda_zip)
  timeout                        = 300
  memory_size                    = 1024
  reserved_concurrent_executions = 1 # one poller at a time; records are also compare-and-set
  environment {
    variables = local.lambda_env
  }
  depends_on = [aws_cloudwatch_log_group.poller]
}

resource "aws_cloudwatch_event_rule" "poll" {
  name                = "${var.name}-poll"
  schedule_expression = "rate(10 minutes)"
}

resource "aws_cloudwatch_event_target" "poll" {
  rule = aws_cloudwatch_event_rule.poll.name
  arn  = aws_lambda_function.poller.arn
}

resource "aws_lambda_permission" "poll" {
  statement_id  = "AllowSchedule"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.poller.function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_cloudwatch_event_rule.poll.arn
}

# ------------------------------------------------------------------------------------------------ API Gateway
resource "aws_api_gateway_rest_api" "issuer" {
  name               = var.name
  binary_media_types = ["*/*"] # request bodies arrive base64-encoded, byte-exact
  endpoint_configuration {
    types = ["REGIONAL"]
  }
}

resource "aws_api_gateway_resource" "v1" {
  rest_api_id = aws_api_gateway_rest_api.issuer.id
  parent_id   = aws_api_gateway_rest_api.issuer.root_resource_id
  path_part   = "v1"
}

resource "aws_api_gateway_resource" "requests" {
  rest_api_id = aws_api_gateway_rest_api.issuer.id
  parent_id   = aws_api_gateway_resource.v1.id
  path_part   = "requests"
}

resource "aws_api_gateway_resource" "request" {
  rest_api_id = aws_api_gateway_rest_api.issuer.id
  parent_id   = aws_api_gateway_resource.requests.id
  path_part   = "{key}"
}

resource "aws_api_gateway_resource" "receipt" {
  rest_api_id = aws_api_gateway_rest_api.issuer.id
  parent_id   = aws_api_gateway_resource.request.id
  path_part   = "receipt"
}

locals {
  routes = {
    submit  = { resource = aws_api_gateway_resource.requests.id, method = "POST" }
    status  = { resource = aws_api_gateway_resource.request.id, method = "GET" }
    receipt = { resource = aws_api_gateway_resource.receipt.id, method = "GET" }
  }
}

resource "aws_api_gateway_method" "route" {
  for_each         = local.routes
  rest_api_id      = aws_api_gateway_rest_api.issuer.id
  resource_id      = each.value.resource
  http_method      = each.value.method
  authorization    = "NONE"
  api_key_required = true # API keys are the client credentials
}

resource "aws_api_gateway_integration" "route" {
  for_each                = local.routes
  rest_api_id             = aws_api_gateway_rest_api.issuer.id
  resource_id             = each.value.resource
  http_method             = aws_api_gateway_method.route[each.key].http_method
  integration_http_method = "POST"
  type                    = "AWS_PROXY"
  uri                     = aws_lambda_function.api.invoke_arn
}

resource "aws_lambda_permission" "api" {
  statement_id  = "AllowApiGateway"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.api.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.issuer.execution_arn}/*/*"
}

resource "aws_api_gateway_deployment" "issuer" {
  rest_api_id = aws_api_gateway_rest_api.issuer.id
  triggers = {
    redeploy = sha1(jsonencode([aws_api_gateway_method.route, aws_api_gateway_integration.route]))
  }
  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_api_gateway_stage" "v1" {
  rest_api_id   = aws_api_gateway_rest_api.issuer.id
  deployment_id = aws_api_gateway_deployment.issuer.id
  stage_name    = "v1"
}

resource "aws_api_gateway_usage_plan" "clients" {
  name = "${var.name}-clients"
  api_stages {
    api_id = aws_api_gateway_rest_api.issuer.id
    stage  = aws_api_gateway_stage.v1.stage_name
  }
  throttle_settings {
    burst_limit = 20
    rate_limit  = 5
  }
}

resource "aws_api_gateway_api_key" "client" {
  for_each = toset(var.client_names)
  name     = "${var.name}-${each.key}"
}

resource "aws_api_gateway_usage_plan_key" "client" {
  for_each      = aws_api_gateway_api_key.client
  key_id        = each.value.id
  key_type      = "API_KEY"
  usage_plan_id = aws_api_gateway_usage_plan.clients.id
}

# SG-05: pin both functions (both load the verifier's install record) to the runtime the record was made on.
resource "aws_lambda_runtime_management_config" "pinned" {
  for_each            = var.runtime_version_arn == "" ? {} : { api = aws_lambda_function.api.function_name, poller = aws_lambda_function.poller.function_name }
  function_name       = each.value
  update_runtime_on   = "Manual"
  runtime_version_arn = var.runtime_version_arn
}
data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

data "aws_sqs_queue" "requests" {
  name = "${var.issuer_name}-kms-requests"
}

data "aws_sqs_queue" "responses" {
  name = "${var.issuer_name}-kms-responses"
}

locals {
  account   = data.aws_caller_identity.current.account_id
  root      = "arn:${data.aws_partition.current.partition}:iam::${local.account}:root"
  trail_arn = "arn:${data.aws_partition.current.partition}:cloudtrail:${var.region}:${local.account}:trail/${var.name}-trail"
  signer_env = {
    KMS_KEY_ID         = data.aws_kms_key.signer.arn
    KEY_FP             = var.key_fp
    SIGN_UNTIL         = var.sign_until
    RESPONSE_QUEUE_URL = data.aws_sqs_queue.responses.url
    FRAMES_BUCKET      = var.frames_bucket
  }
}

# ------------------------------------------------------------------------------------------------ the key
# The window's kms key already exists (kms_key_id); this module never creates one. (The provider pinned here,
# hashicorp/aws 5.100, does not accept customer_master_key_spec = "ML_DSA_65", so a new key is made outside
# Terraform, and is a new window key: new key assertion, new DNS record.)
data "aws_kms_key" "signer" {
  key_id = var.kms_key_id
}

# The signer role is the only principal allowed kms:Sign (and kms:GetPublicKey). Account administration keeps the
# key manageable but holds neither; the Deny makes an IAM grant of kms:Sign to any other principal ineffective, so
# obtaining a signature otherwise needs PutKeyPolicy or a change to the signer role or its code: management events,
# recorded by the trail below. That an IAM administrator can do those is C3 (README "Who can cause a signature").
data "aws_iam_policy_document" "key" {
  statement {
    sid = "KeyAdministrationWithoutSign"
    actions = [
      "kms:CancelKeyDeletion", "kms:CreateAlias", "kms:DeleteAlias", "kms:DescribeKey", "kms:DisableKey",
      "kms:EnableKey", "kms:GetKeyPolicy", "kms:GetKeyRotationStatus", "kms:ListAliases", "kms:ListGrants",
      "kms:ListKeyPolicies", "kms:ListResourceTags", "kms:PutKeyPolicy", "kms:RetireGrant", "kms:RevokeGrant",
      "kms:ScheduleKeyDeletion", "kms:TagResource", "kms:UntagResource", "kms:UpdateAlias", "kms:UpdateKeyDescription",
    ]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = [local.root]
    }
  }
  statement {
    sid       = "SignerRoleOnly"
    actions   = ["kms:Sign", "kms:GetPublicKey"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = [aws_iam_role.signer.arn]
    }
  }
  statement {
    sid       = "DenySignToEveryoneElse"
    effect    = "Deny"
    actions   = ["kms:Sign"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = ["*"]
    }
    condition {
      test     = "ArnNotEquals"
      variable = "aws:PrincipalArn"
      values   = [aws_iam_role.signer.arn]
    }
  }
}

resource "aws_kms_key_policy" "signer" {
  key_id = data.aws_kms_key.signer.id
  policy = data.aws_iam_policy_document.key.json
}

# ------------------------------------------------------------------------------------------------ signer role
data "aws_iam_policy_document" "lambda_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "signer" {
  name               = "${var.name}-role"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

# Queues, frames and logs only. Signing rights come from the key policy above, not from IAM.
data "aws_iam_policy_document" "signer" {
  statement {
    sid       = "Requests"
    actions   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
    resources = [data.aws_sqs_queue.requests.arn]
  }
  statement {
    sid       = "Responses"
    actions   = ["sqs:SendMessage"]
    resources = [data.aws_sqs_queue.responses.arn]
  }
  # IS-09: frames too large for a queue message are read by digest-bound reference.
  statement {
    sid       = "Frames"
    actions   = ["s3:GetObject"]
    resources = ["arn:${data.aws_partition.current.partition}:s3:::${var.frames_bucket}/frames/*"]
  }
  statement {
    sid       = "Logs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.signer.arn}:*"]
  }
}

resource "aws_iam_role_policy" "signer" {
  name   = "signer-kms"
  role   = aws_iam_role.signer.id
  policy = data.aws_iam_policy_document.signer.json
}

# ------------------------------------------------------------------------------------------------ Lambda
resource "aws_cloudwatch_log_group" "signer" {
  name              = "/aws/lambda/${var.name}"
  retention_in_days = var.log_retention_days
}

resource "aws_lambda_function" "signer" {
  function_name    = var.name
  role             = aws_iam_role.signer.arn
  runtime          = var.lambda_runtime
  handler          = "tessera_sign_kms.lambda_app.handler"
  filename         = var.lambda_zip
  source_code_hash = filebase64sha256(var.lambda_zip)
  timeout          = 60 # within the request queue's 120 s visibility timeout
  memory_size      = 512
  environment {
    variables = local.signer_env
  }
  depends_on = [aws_cloudwatch_log_group.signer, aws_iam_role_policy.signer]
}

resource "aws_lambda_event_source_mapping" "requests" {
  event_source_arn        = data.aws_sqs_queue.requests.arn
  function_name           = aws_lambda_function.signer.arn
  batch_size              = 10
  function_response_types = ["ReportBatchItemFailures"] # transient failures are redelivered, not dropped
  scaling_config {
    maximum_concurrency = 2
  }
}

# ------------------------------------------------------------------------------------------------ CloudTrail
# Management events, read and write, KMS not excluded: kms:Sign and kms:GetPublicKey are KMS management (read)
# events in CloudTrail, as are PutKeyPolicy, IAM and Lambda changes and StopLogging. Object Lock COMPLIANCE: what
# is written cannot be deleted or overwritten by anyone until its retention ends; stopping the trail is itself logged.
resource "aws_s3_bucket" "trail" {
  bucket_prefix       = "${var.name}-trail-"
  object_lock_enabled = true
}

resource "aws_s3_bucket_versioning" "trail" {
  bucket = aws_s3_bucket.trail.id
  versioning_configuration {
    status = "Enabled" # required by Object Lock
  }
}

resource "aws_s3_bucket_object_lock_configuration" "trail" {
  bucket = aws_s3_bucket.trail.id
  rule {
    default_retention {
      mode = "COMPLIANCE"
      days = var.trail_retention_days
    }
  }
  depends_on = [aws_s3_bucket_versioning.trail]
}

resource "aws_s3_bucket_public_access_block" "trail" {
  bucket                  = aws_s3_bucket.trail.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "trail" {
  bucket = aws_s3_bucket.trail.id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "trail" {
  bucket = aws_s3_bucket.trail.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256" # SSE-S3
    }
  }
}

data "aws_iam_policy_document" "trail_bucket" {
  statement {
    sid       = "CloudTrailAclCheck"
    actions   = ["s3:GetBucketAcl"]
    resources = [aws_s3_bucket.trail.arn]
    principals {
      type        = "Service"
      identifiers = ["cloudtrail.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "aws:SourceArn"
      values   = [local.trail_arn]
    }
  }
  statement {
    sid       = "CloudTrailWrite"
    actions   = ["s3:PutObject"]
    resources = ["${aws_s3_bucket.trail.arn}/AWSLogs/${local.account}/*"]
    principals {
      type        = "Service"
      identifiers = ["cloudtrail.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "s3:x-amz-acl"
      values   = ["bucket-owner-full-control"]
    }
    condition {
      test     = "StringEquals"
      variable = "aws:SourceArn"
      values   = [local.trail_arn]
    }
  }
  statement {
    sid       = "DenyInsecureTransport"
    effect    = "Deny"
    actions   = ["s3:*"]
    resources = [aws_s3_bucket.trail.arn, "${aws_s3_bucket.trail.arn}/*"]
    principals {
      type        = "*"
      identifiers = ["*"]
    }
    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

resource "aws_s3_bucket_policy" "trail" {
  bucket     = aws_s3_bucket.trail.id
  policy     = data.aws_iam_policy_document.trail_bucket.json
  depends_on = [aws_s3_bucket_public_access_block.trail]
}

resource "aws_cloudtrail" "signer" {
  name                          = "${var.name}-trail"
  s3_bucket_name                = aws_s3_bucket.trail.id
  is_multi_region_trail         = true
  include_global_service_events = true
  enable_log_file_validation    = true

  advanced_event_selector {
    name = "Management events, read and write, KMS included"
    field_selector {
      field  = "eventCategory"
      equals = ["Management"]
    }
  }

  depends_on = [aws_s3_bucket_policy.trail, aws_s3_bucket_object_lock_configuration.trail]
}
import copy
import pytest
from conftest import loc,key
from test_lifecycle import get,att,poll,sign
from helpers import submit
from tessera_issue import pipeline
