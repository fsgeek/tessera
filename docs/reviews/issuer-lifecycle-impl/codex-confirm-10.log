from test_lifecycle_confirm import aws_wire, SLOW, SlowClient
from test_lifecycle import get, att
from helpers import submit
from tessera_issue import pipeline, deadline

@pytest.mark.parametrize('first',[0,1])
@pytest.mark.parametrize('repeats',[0,12])
def test_actual_fit_but_save_never_admitted(monkeypatch,first,repeats):
    monkeypatch.setitem(SLOW,'sqs',0)
    loc,_=aws_wire('sqs')
    _,rid=submit(loc,str(uuid.uuid4()))
    pipeline.poll(loc.iss)
    for wk in loc.workers.values(): wk.process()
    object.__setattr__(loc.iss.requests.c,'_client',SlowClient(loc.iss.requests.c._client,loc.clock,24,[]))
    object.__setattr__(loc.iss.results.c,'_client',SlowClient(loc.iss.results.c._client,loc.clock,47,[]))
    for signer in loc.iss.signers.values(): signer.responses.client._client._delay=20
    loc.iss.rng=type('Fixed',(),{'randrange':lambda self,n:first})()
    for i in range(repeats):
        loc.clock.advance(600)
        start=loc.clock()
        out=pipeline.poll(loc.iss)
        flags=[bool(v['sig_sha256']) for v in att(get(loc,rid))['jobs'].values()]
        print('BLOCKED',first,i,loc.clock()-start,out,flags,loc.iss.log[-2:])
        assert not any(flags)
    # Same actual dependencies, sufficient invocation budget: last call may begin with 73 seconds left.
    loc.clock.advance(600)
    with deadline.Installed(deadline.Deadline(loc.iss.elapsed_clock,400,10)):
        start=loc.clock()
        n=pipeline.drain(loc.iss,share_s=0)
        span=loc.clock()-start
    print('CONTROL',first,n,span)
    assert n==1 and span==(278 if repeats else 254)
    assert any(v['sig_sha256'] for v in att(get(loc,rid))['jobs'].values())
