            and is_str(v["alg"], r"[A-Z0-9][A-Z0-9-]{0,63}") and is_domain(v["issuer"])
            and is_str(v["key_fp"], KMSFP) and isinstance(v["sset"], list) and len(v["sset"]) == 1
            and is_str(v["sset"][0], GPGFP) and v["ver"] == "map-v1")
