    if op < 0.4:
        b = bytearray(bytes.fromhex(g['bytes_hex'])); regs = regions(g)
        for _ in range(rnd.randint(1, 3)):
            if rnd.random() < 0.8:
                at, ln = rnd.choice([regs[i] for i in (0, 2, 3, 4, 6, 7)]); p = at + rnd.randrange(max(ln, 1))
            else:
