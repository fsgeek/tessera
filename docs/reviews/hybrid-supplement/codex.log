            val = (b2 << 16) + (b1 << 8) + b0
            if val < MQ:
                got.append(val)
            if len(got) == 256:
                break
        need_bytes += 1024
    return got


def m_challenge(ct):
    tau, stream, need_bytes = 49, b"", 512
    while True:
        stream = hashlib.shake_256(ct).digest(need_bytes)
        sign_bits = [(stream[q // 8] >> (q % 8)) & 1 for q in range(64)]
        c, p, done = [0] * 256, 8, True
        for i in range(256 - tau, 256):
            while p < len(stream) and stream[p] > i:
                p += 1
            if p == len(stream):
                done = False
                break
            j = stream[p]
            p += 1
            c[i] = c[j]
            c[j] = MQ - 1 if sign_bits[i - (256 - tau)] else 1
        if done:
            return c
        need_bytes *= 2


def m_split(r):
    """Decompose with gamma2 = (q-1)/32: (r1, r0), r = r1 * 2*gamma2 + r0 (mod q)."""
    two_g2 = (MQ - 1) // 16
    r = r % MQ
                   "bytes_hex": H(a_), "sha256": sha(a_)})
    keys_h = {"kms": {"spki_der_hex": H(spki_h)}, "gpg": keys_input["gpg"]}

    def keys_of_h(ki):
        k = ki["kms"]
        kms = bytes.fromhex(k["spki_der_hex"]) if "spki_der_hex" in k else (int(k["x"], 16), int(k["y"], 16))
        return kms, (int(ki["gpg"]["x"], 16), int(ki["gpg"]["y"], 16), ki["gpg"]["created"])

    for gid, (a, sa, b, sb), a_, note in [
            ("R-H1", (fh0, sh0, fh1, sh1), anch, "hybrid receipt: codec checks pass; the committed ML-DSA-65 (kms) and "
                                                 "P-256 (gpg) signatures verify under the slot keys"),
            ("R-H2", (fb0, sb0, fb1, sb1), anchb, "hybrid receipt over frames above 4096 bytes (kms signed via external mu)")]:
        check_receipt(fmh, a, sa, b, sb, a_, keys_of_h(keys_h))
        hg.append({"id": gid, "kind": "receipt", "note": note,
                   "input": {"manifest_hex": H(fmh), "f0_hex": H(a), "s0_hex": H(sa), "f1_hex": H(b), "s1_hex": H(sb),
                             "anchor_hex": H(a_), "keys": keys_h},
                   "anchor_sha256": sha(a_)})
    ph0, ph1 = mldsa65_sign(priv_h, fmh), sign_gpg(fmh)
    for gid, slot, s_, key, note in [
            ("P-H1", 0, ph0, spki_h, "kms possession: rule R (raw ML-DSA-65) over F_manifest M-H1"),
            ("P-H2", 1, ph1, (g2[0], g2[1], created), "gpg possession: rule O over F_manifest M-H1")]:
        check_possession(fmh, slot, s_, key)
        kin = {"spki_der_hex": H(spki_h)} if slot == 0 else keys_input["gpg"]
        hg.append({"id": gid, "kind": "possession", "note": note,
                   "input": {"manifest_hex": H(fmh), "slot": ["kms", "gpg"][slot], "key": kin}, "bytes_hex": H(s_)})

    # ---- rejections: hybrid A_sig codec (rule R lengths; wrong-slot rules) ----------------------------
    def rah(rid, data, code, note):
        expect_reject(lambda: decode_anchor(data), code)
        hr.append({"id": rid, "entry": "anchor", "input": {"bytes_hex": H(data)}, "expect": code, "note": note})

    ALG_NEAR = "KMS-MLDSA65-PURE-GPG-OPENPGP4-ECDSA-P256-SHA384"     # well-formed, unregistered
    fn0 = encode_attest(common(alg=ALG_NEAR, mh=sha(fmh)), FP_H)
    fn1 = encode_attest(common(alg=ALG_NEAR, mh=sha(fmh)), FP_GPG)
    s_rule_o_kms = sign_kms(fh0)                                       # a rule-O packet over F-H1
    rah("XH-01", slots(fh0, sh0[:-1], fh1, sh1), "SIG_FORMAT", "rule R: ML-DSA-65 signature truncated to 3308 bytes (prefix consistent)")
    rah("XH-02", slots(fh0, sh0 + b"\x00", fh1, sh1), "LENGTH_CAP", "rule R: one trailing byte (3310 > the exact-length cap)")
    rah("XH-03", ah + bytes([2]) + P4(fh0) + struct.pack(">I", len(sh0) + 1) + sh0 + P4(fh1) + P4(sh1), "LENGTH_CAP",
        "rule R: slot length 3310 over a 3309-byte signature (the slot would swallow a prefix byte)")
    rah("XH-04", ah + bytes([2]) + P4(fh0) + struct.pack(">I", len(sh0) - 1) + sh0 + P4(fh1) + P4(sh1), "SIG_FORMAT",
        "rule R: slot length 3308; the signature's last byte would be read as the next prefix")
    rah("XH-05", slots(fh0, b"", fh1, sh1), "SIG_EMPTY", "rule R: empty signature")
    rah("XH-06", slots(fh0, sh0 + sh0, fh1, sh1), "LENGTH_CAP", "rule R: two signatures in the kms slot")
    rah("XH-07", slots(fh0, sh0[:2420], fh1, sh1), "SIG_FORMAT", "rule R: an ML-DSA-44-sized signature (2420 bytes)")
    rah("XH-08", slots(fh0, sh0 + sh0[:1318], fh1, sh1), "LENGTH_CAP", "rule R: an ML-DSA-87-sized signature (4627 bytes)")
    rah("XH-09", slots(fh0, s_rule_o_kms, fh1, sh1), "SIG_FORMAT",
        "wrong-slot rule: a valid OpenPGP P-256 packet in the kms slot under the hybrid id (rule R wants 3309 raw bytes)")
    rah("XH-10", slots(fh0, sh0, fh1, sh0), "LENGTH_CAP",
        "wrong-slot rule: an ML-DSA-65 signature in the gpg slot under the hybrid id (rule O cap 1024)")
    rah("XH-11", slots(fh0, sh1, fh1, sh0), "SIG_FORMAT", "the two slots' signatures swapped: kms holds a 119-byte packet")
    rah("XH-12", slots(f0, sh0, f1, s1), "LENGTH_CAP",
        "wrong id: an ML-DSA-65 signature in the kms slot of classical-id frames (rule O cap 1024)")
    rah("XH-13", slots(fh0, base64.b64encode(sh0), fh1, sh1), "LENGTH_CAP", "rule R: base64 text of the signature (4412 bytes)")
    rah("XH-14", slots(fn0, b"\x00" * (SIG_CAP_OPAQUE + 1), fn1, sh1), "LENGTH_CAP",
        "unknown id (near-miss pair id ending SHA384): opaque codec, cap 65536")

    # ---- rejections: hybrid receipts (codec, keys, verification of the committed signatures) --------
    stamped_h = sha(anch)

    def rrh(rid, m, a, sa, b, sb, p, code, note, ki=keys_h, control=None):
        expect_reject(lambda: check_receipt(m, a, sa, b, sb, p, keys_of_h(ki)), code)
        v = {"id": rid, "entry": "receipt",
             "input": {"manifest_hex": H(m), "f0_hex": H(a), "s0_hex": H(sa), "f1_hex": H(b), "s1_hex": H(sb),
                       "anchor_hex": H(p), "keys": ki},
             "expect": code, "note": note}
        if control is not None:
            assert control == "kms" and mldsa65_verify(pk_h, a, sa), rid
            assert sha(encode_anchor(a, sa, b, sb)) != stamped_h, rid
            v["control"] = {"slot": control, "presented_sig_verifies": True, "stamped_anchor_sha256": stamped_h}
        hr.append(v)

    sh0_hedged = mldsa65_sign(priv_h, fh0, rnd=hashlib.sha256(b"hedged signing randomness, illustrative").digest())
    assert sh0_hedged != sh0
    rrh("XHR-01", fmh, fh0, sh0_hedged, fh1, sh1, anch, "RECEIPT_ANCHOR_MISMATCH",
        "NEGATIVE CONTROL: a second valid ML-DSA-65 signature over F-H1 (hedged rnd); it verifies, but the stamp commits "
        "SIG-H1", control="kms")
    s_other = mldsa65_sign(priv_h, fh1)
    rrh("XHR-02", fmh, fh0, s_other, fh1, sh1, encode_anchor(fh0, s_other, fh1, sh1), "SIG_INVALID",
        "kms slot holds a valid ML-DSA-65 signature over the gpg frame F-H2 (anchor rebuilt): not over its own frame")
    flip = bytearray(sh0)
    flip[0] ^= 1
    rrh("XHR-03", fmh, fh0, bytes(flip), fh1, sh1, encode_anchor(fh0, bytes(flip), fh1, sh1), "SIG_INVALID",
        "one bit of the ML-DSA-65 commitment hash c~ flipped (anchor rebuilt): codec accepts, verification fails")
    hb = bytearray(sh0)
    hint_at = 48 + 3200
    cnt = hb[hint_at + 55]                                                   # hints in the first polynomial
    assert cnt >= 2
    hb[hint_at], hb[hint_at + 1] = hb[hint_at + 1], hb[hint_at]              # positions out of order
    rrh("XHR-04", fmh, fh0, bytes(hb), fh1, sh1, encode_anchor(fh0, bytes(hb), fh1, sh1), "SIG_INVALID",
        "hint positions out of order (FIPS 204 HintBitUnpack returns failure): a verification failure, not SIG_FORMAT")
    zb = bytearray(sh0)
    zb[48:51] = b"\x00\x00\x00"                                              # first z coefficient field = 0: z = gamma1
    rrh("XHR-05", fmh, fh0, bytes(zb), fh1, sh1, encode_anchor(fh0, bytes(zb), fh1, sh1), "SIG_INVALID",
        "a z coefficient at gamma1 (infinity-norm bound fails): a verification failure, not SIG_FORMAT")
    s_big_z = mldsa65_sign_mu(priv_h, mldsa65_external_mu(pk_h, fh0), _large_z=True)
    assert mldsa65_verify(pk_h, fh0, s_big_z, _norm=False) and not mldsa65_verify(pk_h, fh0, s_big_z)
    rrh("XHR-12", fmh, fh0, s_big_z, fh1, sh1, encode_anchor(fh0, s_big_z, fh1, sh1), "SIG_INVALID",
        "z infinity norm at or above gamma1 - beta, every other verification step consistent (made from a signing "
        "iteration FIPS 204 rejects): isolates the verifier's norm bound")
    p256_spki_hex = H(spki_der(pt_kms))
    rrh("XHR-06", fmh, fh0, sh0, fh1, sh1, anch, "KEY_FORMAT", "a P-256 SPKI presented as the kms key under the hybrid id",
        ki={"kms": {"spki_der_hex": p256_spki_hex}, "gpg": keys_input["gpg"]})
    rrh("XHR-07", fmh, fh0, sh0, fh1, sh1, anch, "KEY_MISMATCH",
def v4_body(x, y, created):
    pt = b"\x04" + x.to_bytes(32, "big") + y.to_bytes(32, "big")
    o = oid("1.2.840.10045.3.1.7")
    bits = 8 * len(pt) - 5          # 0x04 has three significant bits
    return b"\x04" + created.to_bytes(4, "big") + b"\x13" + bytes([len(o)]) + o + bits.to_bytes(2, "big") + pt


# ===================================== the agreement run =====================================
def main():
    here = os.path.dirname(os.path.abspath(__file__))
    bad = False
    for label, gname, rname in (("", "golden.json", "reject.json"),
                                (" (hybrid supplement)", "hybrid-golden.json", "hybrid-reject.json")):
        golden = json.load(open(os.path.join(here, gname)))["vectors"]
        reject = json.load(open(os.path.join(here, rname)))["vectors"]
        bad = agreement(golden, reject, label) or bad
    sys.exit(1 if bad else 0)


def agreement(golden, reject, label):
    fails = []
    hx = bytes.fromhex
    sha = lambda b: hashlib.sha256(b).hexdigest()

    def rargs(i):
        return [hx(i[n]) for n in ("manifest_hex", "f0_hex", "s0_hex", "f1_hex", "s1_hex", "anchor_hex")]

    def common_from(inp):
        c = {k: v for k, v in inp.items() if k != "content_text_hex"}
        c["content"] = ingest(hx(inp["content_text_hex"]))
        return c

    for g in golden:
        k, i = g["kind"], g.get("input", {})
        try:
            if k == "fingerprint-kms":
                x, y = int(i["x"], 16), int(i["y"], 16)
                assert on_curve(x, y)
                d = spki(x, y)
                assert d.hex() == g["spki_der_hex"] and "spki-sha256:" + sha(d) == g["key_fp"]
            elif k == "fingerprint-gpg":
                x, y = int(i["x"], 16), int(i["y"], 16)
                assert on_curve(x, y)
                body = v4_body(x, y, i["created"])
                fp = hashlib.sha256(body).hexdigest()
                assert body.hex() == g["key_packet_body_hex"] and "gpg-sha256:" + fp == g["key_fp"]
            elif k == "number":
                f = struct.unpack(">d", hx(i["binary64_hex"]))[0]
                assert es_string(f) == g["string"]
            elif k == "content":
                want = hx(g["bytes_hex"])
                assert jcs(ingest(hx(i["text_hex"]))) == want
                assert jcs(payload_value(want)) == want
            elif k == "frame-manifest":
                b = hx(g["bytes_hex"])
                v = frame_decode(b, "manifest")
                assert v == {**i, "ver": "map-v1"} and frame_encode("manifest", v) == b and sha(b) == g["sha256"]
            elif k == "frame-attest":
                b = hx(g["bytes_hex"])
                v = frame_decode(b, "attest")
                mine = {"common": common_from(i["common"]), "signer": {"key_fp": i["key_fp"]}}
                assert jcs(v) == jcs(mine) and frame_encode("attest", mine) == b and sha(b) == g["sha256"]
            elif k == "signature":
                fr, sg = hx(i["frame_hex"]), hx(g["bytes_hex"])
                slot = {"kms": 0, "gpg": 1}[i["slot"]]
                sig_check(sg, i["alg"], slot)
                assert pgp4_verify(fr, sg, (int(i["x"], 16), int(i["y"], 16))) is g["verifies"]
                if "created" in i:          # a real slot-2 capture: its frame names this key's gpg-sha256
                    fp = "gpg-sha256:" + sha(v4_body(int(i["x"], 16), int(i["y"], 16), i["created"]))
                    assert frame_decode(fr, "attest")["signer"]["key_fp"] == fp
            elif k == "signature-mldsa65":
                msg, sg, der_key = hx(i["message_hex"]), hx(g["bytes_hex"]), hx(i["spki_der_hex"])
                sig_check(sg, i["alg"], {"kms": 0, "gpg": 1}[i["slot"]])
                pk = mldsa_spki(der_key)
                assert mldsa65_ok(pk, msg, sg) is g["verifies"]
                if "mu_hex" in i:           # the issuer-side external mu, recomputed here
                    tr = hashlib.shake_256(pk).digest(64)
                    assert hashlib.shake_256(tr + b"\x00\x00" + msg).digest(64) == hx(i["mu_hex"])
            elif k == "fingerprint-kms-spki":
                d = hx(g["spki_der_hex"])
                mldsa_spki(d)
                assert "spki-sha256:" + sha(d) == g["key_fp"]
            elif k == "possession":
                possession(hx(i["manifest_hex"]), {"kms": 0, "gpg": 1}[i["slot"]], hx(g["bytes_hex"]), one_key(i["key"]))
            elif k == "anchor":
                b = hx(g["bytes_hex"])
                parts = [hx(i[n]) for n in ("f0_hex", "s0_hex", "f1_hex", "s1_hex")]
                assert anchor_decode(b) == [(parts[0], parts[1]), (parts[2], parts[3])]
                assert anchor_encode(*parts) == b and sha(b) == g["sha256"]
            elif k == "snapshot":
                b = hx(g["bytes_hex"])
                s = hx(i["snapshot_hex"])
                assert snapshot_decode(b) == s and snapshot_encode(s) == b and sha(b) == g["sha256"]
            elif k == "receipt":
                receipt(*rargs(i), keys_from(i["keys"]))
                assert sha(hx(i["anchor_hex"])) == g["anchor_sha256"]
            elif k == "dns":
                rr = [hx(r) for r in g["rdata_hex"]]
                d = dns_decode(i["D"], hx(g["owner_hex"]), rr)
                want = f"v=tessera1;profile=tessera-v1-strict;kms={i['kms']};gpg={i['gpg']}"
                if i["issuance_not_before"]:
                    want += f";issuance-not-before={i['issuance_not_before']}"
                want += f";issuance-not-after={i['issuance_not_after']}"
                assert want == g["value"] and rr == [bytes([len(want)]) + want.encode()]
                assert d["kms"] == i["kms"] and d["gpg"] == i["gpg"] and d.get("issuance-not-before") == i["issuance_not_before"]
                assert d["issuance-not-after"] == i["issuance_not_after"]
                if g["id"] != "DNS-03":
                    assert hx(g["owner_hex"]) == owner_wire("_tessera-v1." + i["D"])
            elif k == "window":
                window(i["D"], hx(i["owner_hex"]), [hx(r) for r in i["rdata_hex"]], i["declared_issue_time"], i["t_anchor"])
            else:
                raise AssertionError("unknown kind " + k)
        except (AssertionError, Bad) as e:
            fails.append(f"golden {g['id']}: {e!r}")

    entries = {
        "content": lambda i: ingest(hx(i["text_hex"])),
        "frame-attest": lambda i: frame_decode(hx(i["bytes_hex"]), "attest"),
        "frame-manifest": lambda i: frame_decode(hx(i["bytes_hex"]), "manifest"),
        "anchor": lambda i: anchor_decode(hx(i["bytes_hex"])),
        "snapshot": lambda i: snapshot_decode(hx(i["bytes_hex"])),
        "receipt": lambda i: receipt(*rargs(i), keys_from(i["keys"])),
        "dns": lambda i: dns_decode(i["D"], hx(i["owner_hex"]), [hx(r) for r in i["rdata_hex"]]),
        "window": lambda i: window(i["D"], hx(i["owner_hex"]), [hx(r) for r in i["rdata_hex"]],
                                   i["declared_issue_time"], i["t_anchor"]),
        "key-kms": lambda i: key_kms(hx(i["spki_der_hex"]), i["key_fp"]),
        "possession": lambda i: possession(hx(i["manifest_hex"]), {"kms": 0, "gpg": 1}[i["slot"]], hx(i["sig_hex"]),
                                           one_key(i["key"])),
        "signature-r": lambda i: sig_r(hx(i["message_hex"]), hx(i["sig_hex"]), hx(i["spki_der_hex"])),
    }
    agree = controls = 0
    for r in reject:
        if "control" in r:
            # Negative control: the presented signature verifies (B's own ECDSA), and the anchor over the
            # presented bytes is not the stamped one; the expected rejection is then checked below.
            i, c = r["input"], r["control"]
            kq, gq, _ = keys_from(i["keys"])
            slot = 0 if c["slot"] == "kms" else 1
            fr, sg, q = (hx(i["f0_hex"]), hx(i["s0_hex"]), kq) if slot == 0 else (hx(i["f1_hex"]), hx(i["s1_hex"]), gq)
            alg = frame_decode(fr, "attest")["common"]["alg"]
            if isinstance(q, bytes):
                q = mldsa_spki(q)
            ok = slot_verify(alg, slot, fr, sg, q) is c["presented_sig_verifies"]
            ok = ok and sha(anchor_encode(*rargs(i)[1:5])) != c["stamped_anchor_sha256"]
            if ok:
                controls += 1
            else:
                fails.append(f"control {r['id']}: presented signature did not verify, or its anchor equals the stamped one")
        try:
            entries[r["entry"]](r["input"])
            fails.append(f"reject {r['id']}: ACCEPTED by implementation B (expected {r['expect']})")
        except Bad as e:
            if e.code == r["expect"]:
                agree += 1
            else:
                fails.append(f"reject {r['id']}: rejected as {e.code}, implementation A says {r['expect']}")

    print(f"implementation B{label}: golden {len(golden) - sum(f.startswith('golden') for f in fails)}/{len(golden)} round-trip; "
          f"rejection {agree}/{len(reject)} rejected with the same reason code; "
          f"negative controls {controls}/{sum('control' in r for r in reject)} (signature verifies, anchor check fails)")
    for f in fails:
        print("  FAIL", f)
    return bool(fails)


if __name__ == "__main__":
    main()
