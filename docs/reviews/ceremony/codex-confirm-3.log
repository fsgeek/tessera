import urllib.request
for f,a,b in [('scd/app-openpgp.c',1238,1335),('scd/app-openpgp.c',650,760),('agent/call-scd.c',1110,1215),('tools/gpg-connect-agent.c',2100,2200),('g10/card-util.c',2235,2275)]:
