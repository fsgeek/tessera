716: /* Count the number of bits, assuming the A represents an unsigned big
717:    integer of length LEN bytes. */
718: static unsigned int
719: count_bits (const unsigned char *a, size_t len)
720: {
721:   unsigned int n = len * 8;
722:   int i;
723: 
724:   for (; len && !*a; len--, a++, n -=8)
725:     ;
726:   if (len)
727:     {
728:       for (i=7; i && !(*a & (1<<i)); i--)
729:         n--;
730:     }
731:   return n;
732: }
