    c=Cursor(raw); tag(c,expected); demand(c.uint(2)==1,'CV_UNKNOWN'); n=c.uint(4)
    demand(n<=2**24,'LENGTH_CAP'); payload=c.take(n); c.end()
    obj=parse_json(payload,canonical=True)
