    11	STATE=/tmp/tessera-ceremony.env
    12	EMAIL=tessera@wamason.com
    13	
    14	pass() { printf '\n==> PASS: %s\n\n' "$*"; exit 0; }
    15	fail() { printf '\n==> FAIL: %s\n    Nothing was deleted. Fix the cause and run this step again.\n\n' "$*"; exit 1; }
    16	say()  { printf '\n%s\n' "$*"; }
    17	load() { [ -f "$STATE" ] || fail "no state: run 'start' first (Part 1) or 'verify' (Part 2)"; . "$STATE"; export GNUPGHOME; }
