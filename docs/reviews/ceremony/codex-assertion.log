# The window's service keys (service/issuer/DEPLOY-RUN.md, 2026-10-30 production keys).
KMS_FP = "spki-sha256:a33c216e4151f7202b4863f9edebf060b374ee1bb91ff9ca5734b8e7ba75679f"
GPG_FP = "gpg-sha256:6a2d7e757b99b46e469dd81f293387b7cfdbe3a1cab2b614dd2d26ecc79dda59"
IDENT = b"Tessera repository root <tessera@wamason.com>"


def oid(kind, body):
    return hashlib.sha1(kind.encode() + b" " + str(len(body)).encode() + b"\x00" + body).digest()


def objects(value):
    blob = value
    sub = b"100644 key-assertion\x00" + oid("blob", blob)
    root = b"40000 tessera-v1\x00" + oid("tree", sub)
    return blob, sub, root


def build(a):
    value = assertion_value(KMS_FP, GPG_FP, a.not_before, a.not_after)
    blob, sub, root = objects(value)
    when = int(datetime.now(timezone.utc).timestamp())
    payload = (b"tree " + oid("tree", root).hex().encode() + b"\n"
               + b"author " + IDENT + b" %d +0000\n" % when
               + b"committer " + IDENT + b" %d +0000\n" % when
               + b"\nTessera V1 key assertion\n\n" + value + b"\n")
    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
    for name, data in (("value.txt", value), ("blob.bin", blob), ("tree-sub.bin", sub), ("tree-root.bin", root),
                       ("payload.txt", payload)):
        (out / name).write_bytes(data)
    rec = {"kms_fp": KMS_FP, "gpg_fp": GPG_FP, "not_before": a.not_before, "not_after": a.not_after,
           "tree": oid("tree", root).hex(),
           "sha256": {n: hashlib.sha256((out / n).read_bytes()).hexdigest()
                      for n in ("value.txt", "blob.bin", "tree-sub.bin", "tree-root.bin", "payload.txt")}}
    (out / "build.json").write_text(json.dumps(rec, indent=1) + "\n")
    print(payload.decode())
    print("payload.txt sha256", rec["sha256"]["payload.txt"])


def assemble(a):
    from tessera_verify.codec import public_key, signature_verifies
    from tessera_verify.git_channel import dearmor, object_id, parse_commit, verify_path
    out = Path(a.out)
    payload = (out / "payload.txt").read_bytes()
    armor = Path(a.sig).read_bytes().replace(b"\r\n", b"\n").rstrip(b"\n").split(b"\n")
    head, _, message = payload.partition(b"\n\n")
    signed = head + b"\ngpgsig " + b"\n ".join(armor) + b"\n\n" + message
    tree, payload_back, armor_back = parse_commit(signed)
    if payload_back != payload:
        sys.exit("FAIL: the signed commit's payload is not the unsigned payload")
    sig = dearmor(armor_back)
    pub = Path(a.root_pub).read_bytes()
    import base64
    lines = [ln for ln in pub.decode().splitlines() if ln and not ln.startswith(("-----", "=")) and ":" not in ln]
    raw = base64.b64decode("".join(lines))
    if raw[0] != 0x98:
        sys.exit("FAIL: unexpected public-key packet header")
    body = raw[2:2 + raw[1]]
    if not signature_verifies(payload, sig, public_key(body, "gpg")):
        sys.exit("FAIL: the signature does not verify over the payload under the root key")
    root, sub, blob = ((out / n).read_bytes() for n in ("tree-root.bin", "tree-sub.bin", "blob.bin"))
    verify_path(tree, (root, sub), blob)
    cid = object_id("commit", signed)
    (out / "commit.bin").write_bytes(signed)
    (out / "git-stamp.txt").write_bytes((cid + "\n").encode())
    fpr = hashlib.sha1(b"\x99" + len(body).to_bytes(2, "big") + body).hexdigest().upper()
    print(f"PASS: commit {cid} signed by the repository root {fpr}; path and signature checked by the verifier's code")


def main():
    p = argparse.ArgumentParser()
    s = p.add_subparsers(dest="cmd", required=True)
    b = s.add_parser("build"); b.add_argument("--not-before", required=True); b.add_argument("--not-after", required=True)
    b.add_argument("--out", required=True)
    m = s.add_parser("assemble"); m.add_argument("--out", required=True); m.add_argument("--sig", required=True)
    m.add_argument("--root-pub", required=True)
    a = p.parse_args()
    {"build": build, "assemble": assemble}[a.cmd](a)


if __name__ == "__main__":
    main()
#!/usr/bin/env bash
# Sign the window's key-assertion commit with the repository root (YubiKey A), offline on Tails (owner, 2026-11-10).
#   bash /tmp/s.sh
# Reads /media/amnesia/INPUT/{payload.txt, root.pub.asc}; writes /media/amnesia/OUT/payload.sig.asc.
# Before signing it shows the commit text and recomputes the commit's tree from the 255-byte value in the message:
# if the tree does not match the value you read, it refuses. Read this script before running it.
set -u
export LC_ALL=C LANG=C
ROOT_FPR=6BDA21559F18D5DB8E1312C363210B5FF92AD30A
IN=/media/amnesia/INPUT; OUT=/media/amnesia/OUT
fail() { printf '\n==> FAIL: %s\n\n' "$*"; exit 1; }
say()  { printf '\n%s\n' "$*"; }

say "Session checks:"
for i in /sys/class/net/*; do
  [ -e "$i/device" ] || continue
  [ "$(cat "$i/operstate")" = down ] || fail "hardware network interface $(basename "$i") is not down"
done
[ -z "$(ip route show default)$(ip -6 route show default)" ] || fail "a default route exists"
[ "$(awk 'NR>1 && $1 !~ /^\/dev\/zram/' /proc/swaps | wc -l)" -eq 0 ] || fail "non-zram swap is active"
command -v python3 >/dev/null || fail "python3 is not available (tell the owner)"
export GNUPGHOME=$(mktemp -d /tmp/gnupg.XXXXXX) && chmod 700 "$GNUPGHOME"
[ "$(findmnt -n -o FSTYPE --target "$GNUPGHOME")" = tmpfs ] || fail "keyring is not on tmpfs"
[ -s "$IN/payload.txt" ] && [ -s "$IN/root.pub.asc" ] || fail "INPUT must hold payload.txt and root.pub.asc"
[ "$(findmnt -n -o TARGET --target "$OUT" 2>/dev/null)" = "$OUT" ] || fail "$OUT is not mounted (format a stick FAT, volume name OUT)"
echo "ok"

say "What you are about to sign (read the kms=, gpg= and dates):"
echo "------------------------------------------------------------"
cat "$IN/payload.txt"
echo "------------------------------------------------------------"
sha256sum "$IN/payload.txt"

say "Recomputing the tree from the value in the message:"
python3 - "$IN/payload.txt" <<'EOF' || fail "the commit's tree does not match the value in its message: DO NOT SIGN"
import hashlib, sys
p = open(sys.argv[1], 'rb').read()
head, msg = p.split(b'\n\n', 1)
tree = head.split(b'\n')[0]
assert tree.startswith(b'tree '), 'no tree line'
lines = msg.split(b'\n')
value = [l for l in lines if l.startswith(b'v=tessera1;')]
assert len(value) == 1 and len(value[0]) == 255, 'message must hold exactly one 255-byte value'
def oid(k, b): return hashlib.sha1(k + b' ' + str(len(b)).encode() + b'\0' + b).digest()
sub = b'100644 key-assertion\0' + oid(b'blob', value[0])
root = b'40000 tessera-v1\0' + oid(b'tree', sub)
want = oid(b'tree', root).hex().encode()
print('tree in commit:   ', tree[5:].decode()); print('tree from value:  ', want.decode())
assert tree[5:] == want, 'mismatch'
print('MATCH')
EOF

printf '\nDoes the text above name the right keys and dates? Type yes to sign: '; read -r ok
[ "$ok" = yes ] || fail "not confirmed; nothing signed"

gpg --import "$IN/root.pub.asc" || fail "root public key import failed"
say "Insert YubiKey A now, then press Enter."; read -r _
card=$(gpg --with-colons --card-status 2>/dev/null | awk -F: '$1=="fpr"{print toupper($2)}')
[ "$card" = "$ROOT_FPR" ] || fail "the card is not YubiKey A (card holds '$card')"
say "Signing: enter the user PIN, then touch the key when it blinks."
gpg --local-user "$ROOT_FPR" --digest-algo SHA256 --armor --output /tmp/payload.sig.asc --detach-sign "$IN/payload.txt" || fail "signing failed"
gpg --verify /tmp/payload.sig.asc "$IN/payload.txt" || fail "signature does not verify"
cp /tmp/payload.sig.asc "$OUT/payload.sig.asc" && sync || fail "could not write to $OUT"
sha256sum "$OUT/payload.sig.asc"
printf '\n==> PASS: signed. Eject OUT and INPUT, remove YubiKey A, shut down. OUT goes to the owner.\n\n'
# Signing the key assertion — operator sheet (one short sitting)

YubiKey A signs one git commit that names the window's two service keys and dates. The NUC built the commit; the
script shows it to you, checks it, and signs only if you type `yes`.

Sticks: **INPUT** and **OUT**, both never in the NUC (the reformatted purple rehearsal sticks will do).
**[PHOTO]** = photograph the screen. Nothing secret appears on screen except the PIN prompt.

## 1. Fetch (a networked Tails boot)

The owner names a commit and three SHA-256 values: `sign-assertion.sh`, `payload.txt` and `root.pub.asc`.
```
git clone https://github.com/fsgeek/tessera.git
```
```
cd tessera
```
```
git checkout <the commit>
```
```
sha256sum docs/ceremony/sign-assertion.sh docs/ceremony/assertion/payload.txt docs/ceremony/assertion/root.pub.asc
```
All three must equal the owner's values. Format INPUT (FAT, volume name `INPUT`), open it in *Files*, then:
```
cp docs/ceremony/sign-assertion.sh docs/ceremony/assertion/payload.txt docs/ceremony/assertion/root.pub.asc /media/amnesia/INPUT/
```
Eject; shut down.

## 2. Sign (an offline Tails boot)

Network off. Insert INPUT and OUT (format OUT: FAT, volume name `OUT`); open both in *Files*. Not YubiKey A yet.
```
cp /media/amnesia/INPUT/sign-assertion.sh /tmp/s.sh
```
```
sha256sum /tmp/s.sh
```
Same as the owner's value. Read it (`less /tmp/s.sh`). Then:
```
bash /tmp/s.sh
```
**[PHOTO]** the commit text and the `MATCH` line. Read the text: `kms=a33c216e…`, `gpg=6a2d7e75…`, and the two
dates the owner gave you. If they are right, type `yes`, insert YubiKey A when asked, enter the PIN, touch when it
blinks. Want `==> PASS`. **[PHOTO]**. Eject both sticks, remove YubiKey A, shut down. OUT goes to the owner.

If anything fails: nothing has been signed or changed on the card. Photograph it and stop.

