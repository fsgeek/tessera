   135	GNUPGHOME="$T" gpg --batch --import "$B/secret.asc" && GNUPGHOME="$T" gpg --list-secret-keys --with-colons | grep "^fpr:::::::::$FPR:" >/dev/null && echo FPR-MATCH || echo FAIL
