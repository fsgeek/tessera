        if not sha1dc.available(): ledger.fault('14.4','INDEPENDENT_SHA1DC_UNAVAILABLE',unknown=True)
        else:
            for i,(kind,body) in enumerate([('commit',commit),('tree',trees[0]),('tree',trees[1]),('blob',blob)]):
