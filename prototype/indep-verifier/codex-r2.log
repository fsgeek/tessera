REQUIRED=BINARY|set(NESTED)-{'issuer_record'}|{'headers'}
DEC=re.compile(r'(?:0|[1-9][0-9]*)\Z')

def decimal_string(v): return isinstance(v,str) and not isinstance(v,Literal) and len(v)<=10 and DEC.fullmatch(v) and int(v)<=4294967295

def container_schema(obj,ledger):
    raw={}; layer=obj['layers'][0]
    if set(obj)!={'profile','layers'}: ledger.fault('2.4','CONTAINER_SCHEMA',('top',))
    if not isinstance(layer,dict): ledger.fault('2.4','CONTAINER_SCHEMA',('layer',)); return raw
    def missing(path): ledger.fault('2.2','GIT_OBJECT_FORMAT_MISSING' if path=='git.object_format' else 'MEMBER_MISSING:'+path,(path.encode('utf-16be'),),True)
    def bad(path): ledger.fault('2.4','CONTAINER_SCHEMA',(path.encode('utf-16be'),))
    def binary(value,path):
        try: raw[path]=b64(value)
        except Fault: bad(path)
    for k in sorted(REQUIRED):
        if k not in layer: missing(k)
    for k,value in layer.items():
        if k in BINARY: binary(value,k)
        elif k in NESTED:
            if not isinstance(value,dict): bad(k); continue
            for f in sorted(NESTED[k]):
                path=k+'.'+f
                if f not in value:
                    if k=='issuer_record': bad(path)
                    else: missing(path)
                    continue
                v=value[f]
                if path=='git.object_format':
                    if not isinstance(v,str) or isinstance(v,Literal): bad(path)
                    else: raw[path]=v; ledger.add('2.3',v=='sha1','GIT_OBJECT_FORMAT',unknown=True)
                elif path=='receipt_anchor.txid':
                    if isinstance(v,str) and not isinstance(v,Literal) and re.fullmatch(r'[0-9a-f]{64}',v): raw[path]=v
                    else: bad(path)
                elif path=='git.trees':
                    if not isinstance(v,list): bad(path)
                    else:
                        if len(v)!=2: bad(path)
                        for i,x in enumerate(v[:2]): binary(x,f'{path}.{i}')
                        for i in range(len(v),2): missing(f'{path}.{i}')
                elif path=='issuer_record.observed_anchor_delay_s':
                    if not decimal_string(v): bad(path)
                elif path=='issuer_record.policy_version':
                    if not isinstance(v,str) or isinstance(v,Literal) or not re.fullmatch(r'tessera-v1-issue-policy/(?:0|[1-9][0-9]*)',v): bad(path)
                else: binary(v,path)
            for f in set(value)-NESTED[k]: bad(k+'.'+f)
        elif k=='headers':
            if not isinstance(value,dict) or not value: bad(k); continue
            for h,v in value.items():
                if not decimal_string(h) or not isinstance(v,str) or isinstance(v,Literal) or not re.fullmatch(r'[0-9a-f]{160}',v): bad('headers.'+h)
                else: raw['headers.'+h]=bytes.fromhex(v)
        else: bad(k)
    for row in ('2.2','2.4'):
        if not any(c.row==row for c in ledger.checks): ledger.add(row,True,'')
    return raw

@dataclass
class AnchorResult:
    selected:object|None
    usable:bool

def anchor_checks(ledger,row,data,expected,headers,pins,kind,txid=None):
        if possession is not None:
            alg=co['alg'] if co else (manifest['alg'] if manifest else None)
            if alg is not None:
                parsed=ledger.run('9.3',parse_signature,possession,alg,slot,tie=(i,))
                codec_ok=ledger.checks[-1].status=='pass'
                if codec_ok and supported.get(i):
                    ledger.run('9.4',sig_policy,parsed,tie=(i,)); policy_ok=ledger.checks[-1].status=='pass'
                    if policy_ok and keys.get(slot) is not None and bound.get(slot) and manifest:
                        ledger.add('9.5',signature_verifies(raw['manifest'],parsed,keys[slot]),'POSSESSION_INVALID',(i,))
    for h,header in sorted(headers.items()):
        if h in pins: ledger.add('10.1',sha256d(header)[::-1].hex()==pins[h],'HEADER_CONFLICTS_PIN',(h,))
        ledger.add('10.2',h in pins,'HEADERS_NOT_COVERED',(h,),True)
        if h+1 in headers: ledger.add('10.3',headers[h+1][4:36]==sha256d(header),'HEADER_CHAIN_BROKEN',(h,))
    receipt=anchor_checks(ledger,None,raw.get('receipt_anchor.ots'),raw.get('a_sig'),headers,pins,'receipt',raw.get('receipt_anchor.txid'))
    t=receipt.selected.time if receipt.usable else None
    declared=utc(commons[0]['declared_issue_time']) if commons else None
# Independent V1 verifier instrument report

Date: 2026-10-14. Status: implemented differential instrument with explicit
fail-closed gaps; **not a fully conformant positive V1 verifier**.

All added code, tests, examples, documentation and the local Python environment
are under `prototype/indep-verifier/`. No other Tessera implementation,
formal model, vector file or independent-verifier review was read or imported.
The three authorized documents supplied the requirements, with Amendment 9
as governor. Workflow skill instructions were consulted separately; they were
not normative implementation evidence. No memory files were read.

## Outcome and material limitations

The requested CLI exists:

```sh
python verify.py --trust TRUST_CONFIG --bundle BUNDLE [--catalog CATALOG]
```

It prints the exact six stable fields as canonical JSON after successful
startup. T is determined independently of unrelated checks. INVALID dominates
UNVERIFIABLE, and the reported reason follows the expanded §15.7 row order,
then each row's tie order. No network is used at verification time.

There are **60 expanded numbered check ids** in the implementation ledger.
59 have executable checks; **14.4 is explicitly unperformable** because a
pinned SHA-1DC implementation/version is not supplied in these normative
inputs. Ordinary SHA-1 is used only to reconstruct the proposed links and
stamp target; it never establishes collision detection. With obtainable git
objects this build contributes the visible instrument-specific reason
`INDEPENDENT_SHA1DC_UNAVAILABLE`. Accordingly **a complete otherwise valid
bundle returns UNVERIFIABLE, never VALID_STRICT, in this build**. This prevents
unsafe acceptance but also prevents testing honest positive V1 acceptance.
It does not meet the registered false-reject bar and is not C-row discharge.

Actual authenticated trust configuration, frozen catalog/spec/vector hashes,
release authentication, final hybrid registration, and official pinned UCD /
ECMA dependency artifacts are not furnished by the allowed sources. These are
build/release inputs, not policy to infer from bundles. The checked-in release
is unprovisioned and refuses to emit a verdict until explicit local instrument
provisioning. That step does not prove release authenticity or custody.

**AMBIGUITIES count: 13**, A01–A13 in [AMBIGUITIES.md](AMBIGUITIES.md), including
missing normative build inputs and explicit choices where rejection mapping
or framing remains underdetermined. They are instrument readings, not new
Tessera decisions. Their implemented locations and normative locators are
listed there.

## Check-table coverage

"Implemented" means code exists and the synthetic complete evidence path was
exercised; it does not mean every rejection combination has been covered or
that conformance has been discharged.

