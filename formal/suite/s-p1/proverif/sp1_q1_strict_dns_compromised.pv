(* --- model-local declarations (library terms are not redeclared) ---- *)
fun framed(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring): bitstring [data].
  (* objType, alg, issuerId, kfp, manifestHash, canonVer, payload *)
free canonVerH: bitstring.
free issuerId2: bitstring.        (* second honest issuer's identity (N2) *)

(* judge channels (registered encoding) *)
free honestKeyCh: channel [private]. (* main -> judge H : honest issuer key *)
free honestCh: channel [private].    (* issuer -> judge N1 : (signer key, framed bytes) *)
free acceptCh: channel [private].    (* verifier -> judges : (accepted key, framed bytes) *)
event AcceptedUnderHonestKey(pkey, bitstring).
event HonestAccepted(pkey, bitstring).

(* (i) unrestricted: every acceptance is under a key that signed these bytes *)
query t: bitstring, k: pkey, fb: bitstring, evD: bitstring, evR: bitstring;
  event(Accept(evD, evR, t, k, fb)) ==> event(IssuerSigned(k, fb)).

(* (ii) HEADLINE: accepted under an honest key ==> that key signed exactly these bytes *)
query k: pkey, fb: bitstring;
  event(AcceptedUnderHonestKey(k, fb)) ==> event(IssuerSigned(k, fb)).

(* (iii) N1 honest-flow witness: must be REACHABLE *)
query k: pkey, fb: bitstring;
  event(HonestAccepted(k, fb)).

let AuthorityDNS(skD: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT_DIGEST, h(t)), skD)).

let AuthorityRepo(skR: skey, t: bitstring) =
  event AuthorityPublishedRepo(t);
  out(c, sign((STMT_DIGEST, h(t)), skR)).

let Issuer(skI: skey, id: bitstring, m: bitstring) =
  in(c, payload: bitstring);
  event IssuerPossession(pk(skI));
  let ppf = sign((POSS, m), skI) in
  out(c, ppf);
  let fb = framed(OT_ATTEST, algH, id, fp(pk(skI)), h(m), canonVerH, payload) in
  event IssuerSigned(pk(skI), fb);
  ( out(honestCh, (pk(skI), fb))
  | out(c, sign((BYTES, fb), skI)) ).

(* Verifier: the S-P3 Q1 strict verifier, unchanged. *)
let Verifier(pkD: pkey, pkR: pkey) =
  in(c, (t: bitstring, evD: bitstring, evR: bitstring,
         kX: pkey, ppf: bitstring, sg: bitstring, fb: bitstring));
  (* first link, strict: both channels' evidence binds this exact tuple *)
  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkD) in
  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkR) in
  let authTuple(id, kfpr, ss, alg, ver) = t in
  if fp(kX) = kfpr then
  let (=POSS, =t) = checksign(ppf, kX) in
  (* LOAD-BEARING: the presented key signed exactly the PRESENTED bytes *)
  let (=BYTES, =fb) = checksign(sg, kX) in
  let framed(ot, =alg, =id, =fp(kX), mh, cv, pl) = fb in
  if mh = h(t) then
  event Accept(evD, evR, t, kX, fb);
  out(acceptCh, (kX, fb)).

let JudgeH =
  in(honestKeyCh, kH: pkey);
  in(acceptCh, (=kH, fbAcc: bitstring));
  event AcceptedUnderHonestKey(kH, fbAcc).

let JudgeN1 =
  in(honestCh, (kH: pkey, fbHon: bitstring));
  in(acceptCh, (=kH, =fbHon));
  event HonestAccepted(kH, fbHon).

process
  new skD: skey; new skR: skey; new skI: skey; new skI2: skey;
  let m  = authTuple(issuerId,  fp(pk(skI)),  ssetH, algH, verH) in
  let m2 = authTuple(issuerId2, fp(pk(skI2)), ssetH, algH, verH) in
  out(c, pk(skD)); out(c, pk(skR)); out(c, pk(skI)); out(c, pk(skI2));
  out(c, m); out(c, m2);
  (* VARIANT: DNS channel compromised — its signing key is public *)
  out(c, skD);
  ( !out(honestKeyCh, pk(skI)) | !out(honestKeyCh, pk(skI2))
  | !AuthorityDNS(skD, m)  | !AuthorityDNS(skD, m2)
  | !AuthorityRepo(skR, m) | !AuthorityRepo(skR, m2)
  | !Issuer(skI, issuerId, m) | !Issuer(skI2, issuerId2, m2)
  | !Verifier(pk(skD), pk(skR))
  | !JudgeH | !JudgeN1 )

