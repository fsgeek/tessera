(* ====================================================================== *)
(* STATUS: PROPOSED — 2026-09-06 — produced by the AI collaborator;       *)
(* not adopted; the commit is the author's.                               *)
(*                                                                        *)
(* S-STANDING.Q3 — COMPANION B: entitled key established only via the     *)
(* envelope. Strict mode, DNS compromised (matches Q1's DNS variant).     *)
(* Plan: PREDICTIONS.md SS.Q3 (frozen 5188e7a); ENUMERATION note 4        *)
(* item 2 (blind re-scoring conformance note): a companion that           *)
(* establishes the entitled-key link only through the envelope MUST       *)
(* fail.                                                                  *)
(*                                                                        *)
(* MUTATION (the only difference from ss_q1_strict_dns_compromised.pv):   *)
(* the standing path no longer compares fp(kT) against the evidenced      *)
(* tuple's kfpr; it checks only that the TLR key equals the key the       *)
(* artifact presents (tlr.pub = core.pub, the probe fixture's shape)      *)
(* and verifies the TLR signature. The envelope path keeps its            *)
(* fp(kX) = kfpr check unchanged.                                         *)
(*                                                                        *)
(* Registered requirement: StandingUnentitled REACHABLE — an adversary-   *)
(* built artifact under the adversary's own key, with a TLR under that    *)
(* key, presented with an HONEST evidenced tuple: the envelope path       *)
(* stops at KEY_FINGERPRINT_MISMATCH and the standing path reports        *)
(* ESTABLISHED against an unentitled key. Correspondence (i) violated     *)
(* by the same adversary-key trace shape as Q1d; (ii) stays true (no      *)
(* honest key involved). The discriminating result is the judge, not      *)
(* (i). Prediction: violation found (p~0.7; p~0.2 the companion cannot    *)
(* fail because the envelope shadows the missing check — an encoding      *)
(* defect against the registered orthogonality abstraction; p~0.1         *)
(* timeout). Box 15 min.                                                  *)
(*                                                                        *)
(* This model proves: that Q1's checking arrangement DETECTS the          *)
(* envelope-only entitled-key defect the blind re-scoring found in the    *)
(* probe fixture; with the two paths structurally parallel, the           *)
(* envelope's fingerprint check cannot shadow the standing path's         *)
(* missing one. Discharges nothing of the property.                       *)
(* This model does not prove: anything the correct form does not.         *)
(* LOAD-BEARING for the red: the removed check. Everything else as Q1.    *)
(*                                                                        *)
(* Theory: formal/suite/lib/tessera_theory.pvl (D-3 possession over       *)
(* manifest; D-4 DSKS; D-5 OT_* constants; D-6 TLR tag — per ruling A6    *)
(* the LIBRARY constant TLR is used; the plan's model-local-tag branch    *)
(* no longer applies). Frame: S-P3's seven-field framed(...), copied      *)
(* verbatim (library note "NOT promoted").                                *)
(* Suite rules from S-P3: judge reports parallel with continuations;      *)
(* N1 witness is judge-emitted; judge locals never shadow library names.  *)
(*                                                                        *)
(* Run: timeout 900 proverif -lib ../../lib/tessera_theory.pvl \          *)
(*        ss_q3_companionB_entitled_via_envelope.pv                       *)
(* ==================================================================== *)

(* --- model-local declarations (library terms are not redeclared) ---- *)

(* S-P3's frame, verbatim: objType, alg, issuerId, kfp, manifestHash, canonVer, payload *)
fun framed(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring): bitstring [data].
free canonVerH: bitstring.
free issuerId2: bitstring.          (* second honest issuer's identity (N2) *)

(* honest issuer keys: private free names so queries can name their public keys *)
free skH1: skey [private].
free skH2: skey [private].

(* attempt = signed core; identity is DERIVED: aid = h(attemptCore(...)) *)
fun attemptCore(bitstring, bitstring, bitstring, bitstring): bitstring [data].
  (* evidenced tuple t, possession proof ppf, attestation signature sg, declared time decl *)
(* wrapper-shaped outer artifact (ruling A7): an outer core over an inner core; *)
(* no honest process builds one; the adversary may (transparent).           *)
fun wrapCore(bitstring, bitstring): bitstring [data].
  (* inner core, outer declared time / payload *)

(* lineage of exactly two entries; per-entry and terminal dispositions named apart *)
fun entry(bitstring, bitstring): bitstring [data].          (* attempt identity, disposition *)
fun lineage2(bitstring, bitstring): bitstring [data].
const DISP_ABANDONED: bitstring.
const DISP_SHIPPED: bitstring.
fun TERM_SHIPPED(bitstring): bitstring [data].              (* SHIPPED <attempt> *)
const TERM_REFUSED: bitstring.                              (* REFUSED *)

(* standing evidence as carried in the bundle: absent, or (TLR key, TLR, anchor proof) *)
const noTLR: bitstring.
fun withTLR(pkey, bitstring, bitstring): bitstring [data].
(* anchoring is a public oracle (A1.3 item 5): a proof is any term over h(TLR) *)
fun anchorProof(bitstring): bitstring [data].

(* standing report vocabulary: verdicts and reason codes *)
const ESTABLISHED: bitstring.
const ABSENT: bitstring.
const UNVERIFIABLE: bitstring.
const TERMINAL_DISPOSITION_SHOWN: bitstring.        (* S1 *)
const SUPERSEDED: bitstring.                        (* S2 *)
const NO_TERMINAL_DISPOSITION_EVIDENCE: bitstring.  (* S3 *)
const ISSUANCE_REFUSED: bitstring.                  (* S4 *)
const STANDING_EVIDENCE_MALFORMED: bitstring.       (* SC-3 *)
const STANDING_EVIDENCE_TEMPORAL_MISMATCH: bitstring. (* SC-3; content is ledger C-2 *)
const STANDING_EVIDENCE_MISMATCH: bitstring.        (* probe-recorded *)
const STANDING_EVIDENCE_SIGNATURE_INVALID: bitstring. (* probe-recorded *)
(* which verifier branch emitted a no-standing code (B9 discrimination judge) *)
const PATH_S2: bitstring.
const PATH_S3: bitstring.
const PATH_S4: bitstring.

(* judge channels (spike Q4 pattern; S-P3 idiom) *)
free designCh: channel [private].   (* issuer -> judge : (key, shipped attempt identity) *)
free estCh: channel [private].      (* standing path -> judge : (key, evidenced tuple, identity) *)
free reasonCh: channel [private].   (* standing path -> reason judge : (branch, reason code) *)

event Designated(pkey, bitstring).
  (* honest issuer holding this key designated this DERIVED identity as shipped, before releasing the TLR *)
event Established(pkey, bitstring, bitstring).
  (* standing path reported ESTABLISHED: key computed against, evidenced tuple, derived identity *)
event StandingReport(bitstring, bitstring, pkey, bitstring, bitstring).
  (* verdict, reason, key, tuple, derived identity — vocabulary-liveness witnesses, NOT N1 *)
event StandingUnentitled(pkey, bitstring).
  (* judge: ESTABLISHED computed against a key the evidenced tuple does not name *)
event HonestStandingEstablished(pkey, bitstring).
  (* judge: N1 witness — ESTABLISHED under an entitled key for an identity that key's holder designated *)
event ReasonCollapsed(bitstring, bitstring, bitstring).
  (* reason judge: two different no-standing branches emitted the same reason code (B9) *)

(* Review-only structural join projection, depth 1; no outer signature checks. *)
fun wrap(bitstring, bitstring): bitstring [data].
free standingIn: channel [private].
free envelopeIn: channel [private].
const L1: bitstring.
event EstablishedWrapped(bitstring, bitstring, bitstring, pkey, bitstring, bitstring).
event Substituted(bitstring, bitstring).
event ScopeMisreported(pkey,pkey).
query realK: pkey, reportK: pkey; event(ScopeMisreported(realK,reportK)).
query a: bitstring, t: bitstring, k: pkey, co: bitstring;
 event(EstablishedWrapped(a,L1,t,k,co,ESTABLISHED)) ==> event(Designated(k,h(co))).
query a: bitstring, t: bitstring, co: bitstring;
 event(EstablishedWrapped(a,L1,t,pk(skH1),co,ESTABLISHED)) ==> event(Designated(pk(skH1),h(co))).
query co: bitstring, expected: bitstring; event(Substituted(co,expected)).

(* --- queries ---------------------------------------------------------- *)

(* (i) the A3.7.1 sentence for EVERY accepted standing claim *)
query kX: pkey, t: bitstring, aid: bitstring;
  event(Established(kX, t, aid)) ==> event(Designated(kX, aid)).

(* (ii) the sentence for each honest issuer *)
query t: bitstring, aid: bitstring;
  event(Established(pk(skH1), t, aid)) ==> event(Designated(pk(skH1), aid)).
query t: bitstring, aid: bitstring;
  event(Established(pk(skH2), t, aid)) ==> event(Designated(pk(skH2), aid)).

(* (iii) entitled key inside the standing path: must be UNREACHABLE *)
query kX: pkey, t: bitstring;
  event(StandingUnentitled(kX, t)).

(* (iv) N1 honest-flow witness: must be REACHABLE ("not event(...) is false") *)
query k: pkey, aid: bitstring;
  event(HonestStandingEstablished(k, aid)).

(* (iv) vocabulary-liveness witnesses (reachability only; not N1): S1, S2, S3, S4, and G1's correct-side polarity *)
query k: pkey, t: bitstring, a: bitstring;
  event(StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, k, t, a)).
query k: pkey, t: bitstring, a: bitstring;
  event(StandingReport(ABSENT, SUPERSEDED, k, t, a)).
query k: pkey, t: bitstring, a: bitstring;
  event(StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, k, t, a)).
query k: pkey, t: bitstring, a: bitstring;
  event(StandingReport(ABSENT, ISSUANCE_REFUSED, k, t, a)).
query k: pkey, t: bitstring, a: bitstring;
  event(StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, k, t, a)).

(* B9: reason-code discrimination — two distinct no-standing branches with one code: must be UNREACHABLE *)
query p1: bitstring, p2: bitstring, r: bitstring;
  event(ReasonCollapsed(p1, p2, r)).

(* --- authority channels (first link, selected form: transcription binding, digest) --- *)
let AuthorityDNS(skD: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT_DIGEST, h(t)), skD)).

let AuthorityRepo(skR: skey, t: bitstring) =
  event AuthorityPublishedRepo(t);
  out(c, sign((STMT_DIGEST, h(t)), skR)).

(* --- honest issuers: two lineage shapes ------------------------------- *)
(* ShipIssuer: attempt 1 abandoned, attempt 2 shipped; TLR terminal      *)
(* TERM_SHIPPED(aid2). Designated fires BEFORE the TLR is released.       *)
let ShipIssuer(skI: skey, id: bitstring, m: bitstring) =
  in(c, (p1: bitstring, p2: bitstring));
  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
  event IssuerPossession(pk(skI));
  let ppf = sign((POSS, m), skI) in
  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(skI)), h(m), canonVerH, p1) in
  let sg1 = sign((BYTES, fb1), skI) in
  let core1 = attemptCore(m, ppf, sg1, decl1) in
  event IssuerSigned(pk(skI), fb1);
  out(c, (core1, fb1));                         (* attempt 1 public (A2.0 premise) *)
  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(skI)), h(m), canonVerH, p2) in
  let sg2 = sign((BYTES, fb2), skI) in
  let core2 = attemptCore(m, ppf, sg2, decl2) in
  event IssuerSigned(pk(skI), fb2);
  out(c, (core2, fb2));                         (* attempt 2 public *)
  let aid1 = h(core1) in
  let aid2 = h(core2) in
  event Designated(pk(skI), aid2);
  let body = (lineage2(entry(aid1, DISP_ABANDONED), entry(aid2, DISP_SHIPPED)),
              TERM_SHIPPED(aid2), declT) in
  ( out(designCh, (pk(skI), aid2))
  | out(c, sign((TLR, body), skI)) ).

(* RefuseIssuer: both attempts abandoned; TLR terminal TERM_REFUSED; nothing designated. *)
let RefuseIssuer(skI: skey, id: bitstring, m: bitstring) =
  in(c, (p1: bitstring, p2: bitstring));
  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
  event IssuerPossession(pk(skI));
  let ppf = sign((POSS, m), skI) in
  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(skI)), h(m), canonVerH, p1) in
  let sg1 = sign((BYTES, fb1), skI) in
  let core1 = attemptCore(m, ppf, sg1, decl1) in
  event IssuerSigned(pk(skI), fb1);
  out(c, (core1, fb1));
  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(skI)), h(m), canonVerH, p2) in
  let sg2 = sign((BYTES, fb2), skI) in
  let core2 = attemptCore(m, ppf, sg2, decl2) in
  event IssuerSigned(pk(skI), fb2);
  out(c, (core2, fb2));
  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_ABANDONED)),
              TERM_REFUSED, declT) in
  out(c, sign((TLR, body), skI)).

(* --- the standing path ------------------------------------------------ *)
(* Lineage lookup as a model-local destructor: the disposition recorded   *)
(* for identity a in a two-entry lineage; fails (-> else branch) when a   *)
(* is in neither entry. This is the case split the plan predicted the    *)
(* two-entry structure would need (SS.Q1 prediction, "encoding recut").  *)
fun lookup2(bitstring, bitstring): bitstring
  reduc forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
          lookup2(a, lineage2(entry(a, d1), entry(b, d2))) = d1
  otherwise forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
          lookup2(b, lineage2(entry(a, d1), entry(b, d2))) = d2.

(* Terminal decision once the derived identity aid is found in the        *)
(* lineage with per-entry disposition d.                                  *)
let StandingDecide(kT: pkey, t: bitstring, aid: bitstring, d: bitstring, terminal: bitstring, intake: bitstring, core: bitstring, expected: bitstring) =
  if terminal = TERM_REFUSED then
    ( event StandingReport(ABSENT, ISSUANCE_REFUSED, kT, t, aid);          (* S4 *)
      out(reasonCh, (PATH_S4, ISSUANCE_REFUSED)) )
  else
    ( let TERM_SHIPPED(shippedId) = terminal in
      ( if shippedId = aid then
          ( if d = DISP_SHIPPED then
              ( (if core <> expected then event Substituted(core,expected)) |
                (event EstablishedWrapped(intake,L1,t,kT,core,ESTABLISHED);
                event Established(kT, t, aid);
                event StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, kT, t, aid);  (* S1 *)
                out(estCh, (kT, t, aid)) ))
            else
              (* carried: well-formedness (SC-3 / probe F1) *)
              event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aid) )
        else
          ( event StandingReport(ABSENT, SUPERSEDED, kT, t, aid);         (* S2 *)
            out(reasonCh, (PATH_S2, SUPERSEDED)) ) )
      else
        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aid) ).

(* Bundle: (t, evD, evR, kX, core, fb, se). The standing path evaluates the   *)
(* evidenced tuple and the entitled key ITSELF (ENUMERATION note 4 item 2);  *)
(* it inherits nothing from the envelope path.                               *)
let StandingPath(pkD: pkey, pkR: pkey) =
  in(standingIn, (intake: bitstring, t: bitstring, evD: bitstring, evR: bitstring, kX: pkey,
         core: bitstring, fbW: bitstring, ppfI: bitstring, se: bitstring));
  let framed(=OT_WRAPPER, aw, iw, kw, mw, cw, wrap(cwi, (fb: bitstring, sgI: bitstring))) = fbW in
  let attemptCore(=t, =ppfI, =sgI, decl) = core in
  (
  (* strict first link: both channels' evidence binds this exact tuple *)
  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkD) in
  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkR) in
  let authTuple(id, kfpr, ss, alg, ver) = t in
  (* identity is DERIVED by the verifier from the core it holds, never read *)
  if fp(kX) = kfpr then
  let aid = h(core) in
  if se = noTLR then
    ( event StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, kX, t, aid);   (* S3 *)
      out(reasonCh, (PATH_S3, NO_TERMINAL_DISPOSITION_EVIDENCE)) )
  else
    ( let withTLR(kT, tlrSig, ap) = se in
      (* MUTATION (companion B): NO fp(kT) = kfpr check in the standing path. The *)
      (* only key check here is the probe fixture's tlr.pub = core.pub; the      *)
      (* entitled-key determination is left to the envelope path.               *)
        ( if kT = kX then
          (* the TLR verifies under the entitled key, under the library tag TLR (D-6) *)
          let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) = checksign(tlrSig, kT) in
            ( (* carried: the anchor proof presented is over the TLR presented (C-2 content) *)
              let anchorProof(=h(tlrSig)) = ap in
                ( (* the derived identity is looked up in the lineage; absent -> mismatch *)
                  let d = lookup2(aid, lin) in
                    StandingDecide(kT, t, aid, d, terminal, intake, core, attemptCore(t,ppfI,sgI,decl))
                  else
                    event StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, kT, t, aid) )
              else
                event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_TEMPORAL_MISMATCH, kT, t, aid) )
          else
            event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aid) )
      )).

(* --- the envelope path (P4's verdict; S-P3's strict verifier verbatim) --- *)
(* Same bundle input, separate process, run in parallel: A3.7.1's           *)
(* orthogonality is structural. Not queried in this model.                  *)
let EnvelopePath(pkD: pkey, pkR: pkey) =
  in(envelopeIn, (intake: bitstring, t: bitstring, evD: bitstring, evR: bitstring, kX: pkey,
         core: bitstring, fbW: bitstring, ppfI: bitstring, se: bitstring));
  let framed(=OT_WRAPPER, aw, iw, kw, mw, cw, wrap(cwi, (fb: bitstring, sgI: bitstring))) = fbW in
  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkD) in
  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkR) in
  let authTuple(id, kfpr, ss, alg, ver) = t in
  if fp(kX) = kfpr then
  let attemptCore(=t, ppf, sg, decl) = core in
  let (=POSS, =t) = checksign(ppf, kX) in
  let (=BYTES, =fb) = checksign(sg, kX) in
  let framed(ot, =alg, =id, =fp(kX), mh, cv, pl) = fb in
  if mh = h(t) then
  (* Projection of Q5c: all inner verification retained; attributed key alone changed. *)
  let reportK = pk(dsks(sg, decl)) in
  (if reportK <> kX then event ScopeMisreported(kX,reportK)) |
  event Accept(evD, evR, t, reportK, fb).

(* --- judges ------------------------------------------------------------ *)
(* Entitled-key judge (plan §"The judge and the correspondence" item 2).   *)
(* Locals named apart from the library's issuerId/ssetH/algH/verH/fbH.     *)
let Judge =
  in(estCh, (kX: pkey, t: bitstring, aid: bitstring));
  let authTuple(idJ, kfprJ, ssJ, algJ, verJ) = t in
  if fp(kX) <> kfprJ then event StandingUnentitled(kX, t)
  else
    ( in(designCh, (=kX, =aid));
      event HonestStandingEstablished(kX, aid) ).

(* Reason-code discrimination judge (B9): two different no-standing branches, one code. *)
let ReasonJudge =
  in(reasonCh, (p1: bitstring, r1: bitstring));
  in(reasonCh, (p2: bitstring, =r1));
  if p1 <> p2 then event ReasonCollapsed(p1, p2, r1).

let Front =
 in(c, bundle: bitstring);
 new intake: bitstring;
 let (t: bitstring, evD: bitstring, evR: bitstring, kX: pkey, core: bitstring,
      fbW: bitstring, ppfI: bitstring, se: bitstring) = bundle in
 (out(standingIn,(intake,t,evD,evR,kX,core,fbW,ppfI,se)) |
  out(envelopeIn,(intake,t,evD,evR,kX,core,fbW,ppfI,se))).

process
  new skD: skey; new skR: skey;
  let m  = authTuple(issuerId,  fp(pk(skH1)), ssetH, algH, verH) in
  let m2 = authTuple(issuerId2, fp(pk(skH2)), ssetH, algH, verH) in
  out(c, pk(skD)); out(c, pk(skR)); out(c, pk(skH1)); out(c, pk(skH2));
  out(c, m); out(c, m2);
  (* VARIANT: DNS channel compromised — its signing key is public *)
  out(c, skD);
  ( !AuthorityDNS(skD, m)  | !AuthorityDNS(skD, m2)
  | !AuthorityRepo(skR, m) | !AuthorityRepo(skR, m2)
  | !ShipIssuer(skH1, issuerId, m)   | !RefuseIssuer(skH1, issuerId, m)
  | !ShipIssuer(skH2, issuerId2, m2) | !RefuseIssuer(skH2, issuerId2, m2)
  | !Front | !StandingPath(pk(skD), pk(skR)) | !EnvelopePath(pk(skD), pk(skR))
  | !Judge | !ReasonJudge )
