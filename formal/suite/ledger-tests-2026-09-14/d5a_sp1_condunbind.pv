(* --- model-local declarations (library terms are not redeclared) ---- *)
fun framed(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring): bitstring [data].
  (* objType, alg, issuerId, kfp, manifestHash, canonVer, payload *)
free canonVerH: bitstring.
free issuerId2: bitstring.        (* second honest issuer's identity (N2) *)

(* judge channels (registered encoding) *)
free honestKeyCh: channel [private]. (* main -> judge H : honest issuer key *)
free honestCh: channel [private].    (* issuer -> judge N1 : (signer key, framed bytes) *)
free acceptCh: channel [private].    (* verifier -> judges : (accepted key, framed bytes) *)
event AcceptedUnderHonestKey(pkey, bitstring).
  (* judge H: bytes accepted under a key that is an honest issuer's *)
event HonestAccepted(pkey, bitstring).
  (* judge N1 witness: honest bytes accepted under their signer's key *)

(* (i) HEADLINE — the registered P1 [model] claim for this leg:        *)
(* accepted under an honest key ==> that key's holder signed exactly   *)
(* these bytes. Non-injective by registration (§A3.1 item 1).          *)
query k: pkey, fb: bitstring;
  event(AcceptedUnderHonestKey(k, fb)) ==> event(IssuerSigned(k, fb)).

(* (iii) N1 honest-flow witness: must be REACHABLE *)
query k: pkey, fb: bitstring;
  event(HonestAccepted(k, fb)).

let AuthorityS(skS: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT_DIGEST, h(t)), skS)).

(* Degraded first link (A3.2 VALID_DEGRADED, never-zero evidences):     *)
(* the SOLE accepted evidence binds h(t). Event AcceptS is model-local  *)
(* (spike Q5 shape): evidence, tuple, accepted key, bytes.              *)
event AcceptS(bitstring, bitstring, pkey, bitstring).

(* (ii) unrestricted contrast — REGISTERED RED: the adversary's own key *)
(* is vouched for by the compromised sole channel (impersonation, the  *)
(* degraded-mode cost; s-p3/RESULTS.md F8, RULED (author) 2026-09-05). *)
query t: bitstring, k: pkey, fb: bitstring, ev: bitstring;
  event(AcceptS(ev, t, k, fb)) ==> event(IssuerSigned(k, fb)).

(* Verifier: the S-P3 Q2 verifier, unchanged (PREDICTIONS.md: "the   *)
(* same verifier S-P3 checked, not a subset of it").                    *)
(* MUTATION (D5-A, 2026-09-15 scratch): the tail of the committed       *)
(* VerifierS, byte-for-byte from the frame destructuring onward.        *)
let VerifierTailD5(ev: bitstring, t: bitstring, alg: bitstring, id: bitstring,
                   kX: pkey, fb: bitstring) =
  let framed(ot, =alg, =id, =fp(kX), mh, cv, pl) = fb in
  if mh = h(t) then
  event AcceptS(ev, t, kX, fb);
  out(acceptCh, (kX, fb)).

let VerifierS(pkS: pkey) =
  in(c, (t: bitstring, ev: bitstring,
         kX: pkey, ppf: bitstring, sg: bitstring, fb: bitstring));
  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkS) in
  let authTuple(id, kfpr, ss, alg, ver) = t in
  if fp(kX) = kfpr then
  (* possession OVER THE MANIFEST under that key (D-3) *)
  let (=POSS, =t) = checksign(ppf, kX) in
  (* MUTATION (D5-A): CONDITIONAL byte binding. The signature must still *)
  (* verify under the presented key, and when the signed frame's own     *)
  (* kfp field matches that key the presented bytes must be exactly the  *)
  (* signed bytes (so honest-key authorship is untouched); when it does  *)
  (* not match, the binding to the presented bytes is dropped.           *)
  let (=BYTES, anyb: bitstring) = checksign(sg, kX) in
  let framed(otb, algb, idb, kfpb, mhb, cvb, plb) = anyb in
  ( (if kfpb = fp(kX) then (if anyb = fb then VerifierTailD5(ev, t, alg, id, kX, fb)))
  | (if kfpb <> fp(kX) then VerifierTailD5(ev, t, alg, id, kX, fb)) ).

(* Issuer: manifest m names its own key; possession is over m (D-3);   *)
(* the framed bytes carry the P3 binding fields; payload chosen by the  *)
(* adversary (chosen-message issuer). IssuerSigned is emitted           *)
(* immediately before the signature is released.                        *)
let Issuer(skI: skey, id: bitstring, m: bitstring) =
  in(c, payload: bitstring);
  event IssuerPossession(pk(skI));
  let ppf = sign((POSS, m), skI) in
  out(c, ppf);
  let fb = framed(OT_ATTEST, algH, id, fp(pk(skI)), h(m), canonVerH, payload) in
  event IssuerSigned(pk(skI), fb);
  ( out(honestCh, (pk(skI), fb))
  | out(c, sign((BYTES, fb), skI)) ).

(* Judge H (headline): an acceptance whose key is an honest issuer's.  *)
let JudgeH =
  in(honestKeyCh, kH: pkey);
  in(acceptCh, (=kH, fbAcc: bitstring));
  event AcceptedUnderHonestKey(kH, fbAcc).

(* Judge N1 (witness): honest bytes accepted under their signer's key. *)
let JudgeN1 =
  in(honestCh, (kH: pkey, fbHon: bitstring));
  in(acceptCh, (=kH, =fbHon));
  event HonestAccepted(kH, fbHon).

process
  new skS: skey; new skI: skey; new skI2: skey;
  let m  = authTuple(issuerId,  fp(pk(skI)),  ssetH, algH, verH) in
  let m2 = authTuple(issuerId2, fp(pk(skI2)), ssetH, algH, verH) in
  out(c, pk(skS)); out(c, pk(skI)); out(c, pk(skI2));
  out(c, m); out(c, m2);
  (* DEGRADED MODE, SOLE CHANNEL COMPROMISED: its signing key is public *)
  out(c, skS);
  ( !out(honestKeyCh, pk(skI)) | !out(honestKeyCh, pk(skI2))
  | !AuthorityS(skS, m) | !AuthorityS(skS, m2)
  | !Issuer(skI, issuerId, m) | !Issuer(skI2, issuerId2, m2)
  | !VerifierS(pk(skS))
  | !JudgeH | !JudgeN1 )

