(* MUTATES: VerifierS's `let (=BYTES, =fb) = checksign(sg, kX)` is      *)
(*   replaced by a CONDITIONAL byte binding (the Codex 2026-09-15       *)
(*   full-review diagnostic, reproduced on the PRODUCER model): the     *)
(*   presented bytes must equal the signed bytes only when the signed   *)
(*   frame's kfp field matches the verifying key; otherwise the         *)
(*   signature-to-presented-bytes binding is dropped. Nothing else is   *)
(*   changed. Purpose: test whether S-P1 Q2(i)                          *)
(*   AcceptedUnderHonestKey ==> IssuerSigned still holds under a        *)
(*   mutation that severs the signature-to-presented-bytes relation     *)
(*   S-P7's InnerSigTransplanted consumes. Registers/discharges         *)
(*   nothing; no repository model was edited or run.                    *)
