  */

rule (modulo E) Link6aJudge:
   [ !Link6a( lyr, otP, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ) ) ]
  --[ Neq( otJ, otP ), ChainBroken( lyr, 'LINK_6A' ) ]->
   [ ]

  /*
  rule (modulo AC) Link6aJudge:
     [ !Link6a( lyr, otP, <'framed', otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ> ) ]
    --[ Neq( otJ, otP ), ChainBroken( lyr, 'LINK_6A' ) ]->
     [ ]
  */

rule (modulo E) Link6bJudge_k:
   [
   !Link6b( aidJ, lyr, kAt, idAt,
            framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ)
   )
   ]
