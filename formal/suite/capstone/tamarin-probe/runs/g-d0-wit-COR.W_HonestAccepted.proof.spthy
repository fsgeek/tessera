    --[
    IssuerPossession( pk(sk) ),
    IssuerSigned( pk(sk),
                  <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1>
    ),
    IssuerSigned( pk(sk),
                  <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2>
    ),
    Designated( pk(sk),
                h(<'attemptCore', m, sign(<'POSS', m>, sk), 
                   sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                         p2>,
                        sk), 
