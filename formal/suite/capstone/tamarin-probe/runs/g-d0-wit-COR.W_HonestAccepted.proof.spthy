rule (modulo E) AttestTwo_parse_correct:
   [
   !AS1( aid, lyr, ctx,
         framed('OT_ATTEST', al, id, fp(kA),
                h(authTuple(id, fp(kA), signers1(fp(kB)), al, ver)), cvs, pl),
         sgA,
         framed('OT_ATTEST', al, id, fp(kB),
                h(authTuple(id, fp(kA), signers1(fp(kB)), al, ver)), cvs, pl),
         sgB, authTuple(id, fp(kA), signers1(fp(kB)), al, ver), ev, kA, ppfA, kB,
         ppfB
   )
   ]
  -->
   [
   !A2s0( aid, lyr, ctx,
          framed('OT_ATTEST', al, id, fp(kA),
                 h(authTuple(id, fp(kA), signers1(fp(kB)), al, ver)), cvs, pl),
          sgA,
          framed('OT_ATTEST', al, id, fp(kB),
                 h(authTuple(id, fp(kA), signers1(fp(kB)), al, ver)), cvs, pl),
          sgB, authTuple(id, fp(kA), signers1(fp(kB)), al, ver), ev, kA, ppfA, kB,
          ppfB
   )
   ]

