     !Link5( lyr, <'authTuple', id, fpt_, sst_, alt_, vert_>, kA, fbA ),
     !Link5( lyr, <'authTuple', id, fpt_, sst_, alt_, vert_>, kB, fbB ),
     !Link5c( lyr, fbA, fbB ), !Link6a( lyr, 'OT_ATTEST', fbA ),
     !Link6a( lyr, 'OT_ATTEST', fbB ), !Link6b( aid, lyr, kA, id, fbA ),
     !TypeCh( 'OT_ATTEST', fbA ), !TypeCh( 'OT_ATTEST', fbB ),
     !SlotCh( <'authTuple', id, fpt_, sst_, alt_, vert_>, fp(kA), kA ),
     !SlotCh( <'authTuple', id, fpt_, sst_, alt_, vert_>, fp(kB), kB ),
     !SetCh( <'authTuple', id, fpt_, sst_, alt_, vert_>, <'verified2', kA, kB>
     ),
     !AcceptCh( ctx, 'SLOT_A', kA, id, fbA ),
     !AcceptCh( ctx, 'SLOT_B', kB, id, fbB ), !AcceptKey( kA, fbA ),
