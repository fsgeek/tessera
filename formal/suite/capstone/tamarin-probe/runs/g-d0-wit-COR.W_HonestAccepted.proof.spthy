     !ScopeCh( ctx, kB, id, fbB ), !SigCh( ctx, kA, sgA ),
     !SigCh( ctx, kB, sgB ), !Gsig( kA, sgA ), !Gsig( kB, sgB ),
     !ChainCh( lyr, kA, <'authTuple', id, fpt_, sst_, alt_, vert_>, fbA ),
     !ChainCh( lyr, kB, <'authTuple', id, fpt_, sst_, alt_, vert_>, fbB ),
     !ContentCh( <'authTuple', id, fpt_, sst_, alt_, vert_>, fbA, fbB ),
     !ScopeEnvelope( aid, lyr, kA, id )
     ]
  */

rule (modulo E) StandingPathIn_L0:
   [
   !AuthKey( skS ), !SStageL0( intake, lyr, fbI, sgI, fbIB, sgIB ),
   !StdMat( intake, lyr, authTuple(idS, kfpr, ss, al, ver),
            sign(<'STMT_DIGEST', h(authTuple(idS, kfpr, ss, al, ver))>, skS), kX,
            ppfI, kBs, ppfBs
   ),
   !StandCore( intake,
               attemptCore(authTuple(idS, kfpr, ss, al, ver), ppfI, sgI, declS), se
   )
   ]
  --[
  Neq( <fst(fbI), fst(snd(fbI)), 
        fst(snd(snd(snd(snd(snd(snd(snd(fbI))))))))>,
       <'framed', 'OT_WRAPPER', 'wrap'>
  )
  ]->
   [
   !SP1( intake, lyr, authTuple(idS, kfpr, ss, al, ver), kX,
         attemptCore(authTuple(idS, kfpr, ss, al, ver), ppfI, sgI, declS), se,
         idS, kfpr
   )
   ]

  /*
  rule (modulo AC) StandingPathIn_L0:
     [
     !AuthKey( skS ), !SStageL0( intake, lyr, fbI, sgI, fbIB, sgIB ),
     !StdMat( intake, lyr, <'authTuple', idS, kfpr, ss, al, ver>,
              sign(<'STMT_DIGEST', h(<'authTuple', idS, kfpr, ss, al, ver>)>, skS), kX,
              ppfI, kBs, ppfBs
     ),
     !StandCore( intake,
                 <'attemptCore', <'authTuple', idS, kfpr, ss, al, ver>, ppfI, sgI, declS>,
                 se
     )
     ]
    --[ Neq( <z, z.1, z.2>, <'framed', 'OT_WRAPPER', 'wrap'> ) ]->
     [
     !SP1( intake, lyr, <'authTuple', idS, kfpr, ss, al, ver>, kX,
           <'attemptCore', <'authTuple', idS, kfpr, ss, al, ver>, ppfI, sgI, declS>,
           se, idS, kfpr
     )
     ]
    variants (modulo AC)
    1. fbI   = fbI.26
       z     = fst(fbI.26)
       z.1   = fst(snd(fbI.26))
       z.2   = fst(snd(snd(snd(snd(snd(snd(snd(fbI.26))))))))
    
    2. fbI   = <z.57, x.91>
       z     = z.57
       z.1   = fst(x.91)
       z.2   = fst(snd(snd(snd(snd(snd(snd(x.91)))))))
    
    3. fbI   = <z.58, z.59, x.93>
       z     = z.58
       z.1   = z.59
       z.2   = fst(snd(snd(snd(snd(snd(x.93))))))
    
    4. fbI   = <z.59, z.60, x.94, x.95>
       z     = z.59
       z.1   = z.60
       z.2   = fst(snd(snd(snd(snd(x.95)))))
    
    5. fbI   = <z.60, z.61, x.95, x.96, x.97>
       z     = z.60
       z.1   = z.61
       z.2   = fst(snd(snd(snd(x.97))))
    
    6. fbI   = <z.61, z.62, x.96, x.97, x.98, x.99>
       z     = z.61
       z.1   = z.62
       z.2   = fst(snd(snd(x.99)))
    
    7. fbI   = <z.62, z.63, x.97, x.98, x.99, x.100, x.101>
       z     = z.62
       z.1   = z.63
       z.2   = fst(snd(x.101))
    
    8. fbI   = <z.63, z.64, x.98, x.99, x.100, x.101, x.102, x.103>
       z     = z.63
       z.1   = z.64
       z.2   = fst(x.103)
    
    9. fbI   = <z.64, z.65, x.99, x.100, x.101, x.102, x.103, z.66, x.105>
       z     = z.64
       z.1   = z.65
       z.2   = z.66
  */

rule (modulo E) Standing_S3_noTLR:
   [ !SP1( intake, lyr, t, kX, core, 'noTLR', idS, kfpr ) ]
  --[
  StandingReport( 'ABSENT', 'NO_TERMINAL_DISPOSITION_EVIDENCE', kX, t,
                  h(core)
  )
  ]->
   [ !ReasonCh( 'PATH_S3', 'NO_TERMINAL_DISPOSITION_EVIDENCE' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Standing_badKeyFp:
   [ !SP1( intake, lyr, t, kX, core, withTLR(kT, tlrSig, ap), idS, kfpr ) ]
  --[
  Neq( fp(kT), kfpr ),
  StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID',
                  kT, t, h(core)
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Standing_badKeyFp:
     [
     !SP1( intake, lyr, t, kX, core, <'withTLR', kT, tlrSig, ap>, idS, kfpr )
     ]
    --[
    Neq( fp(kT), kfpr ),
    StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID',
                    kT, t, h(core)
    )
    ]->
     [ ]
  */

rule (modulo E) Standing_badKeyEq:
   [ !SP1( intake, lyr, t, kX, core, withTLR(kT, tlrSig, ap), idS, fp(kT) )
   ]
  --[
  Neq( kT, kX ),
  StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID',
                  kT, t, h(core)
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Standing_badKeyEq:
     [
     !SP1( intake, lyr, t, kX, core, <'withTLR', kT, tlrSig, ap>, idS, fp(kT)
     )
     ]
    --[
    Neq( kT, kX ),
    StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID',
                    kT, t, h(core)
    )
    ]->
     [ ]
  */

rule (modulo E) Standing_tagOK:
   [
   !SP1( intake, lyr, t, pk(skT), core,
         withTLR(pk(skT), sign(<'TLR', lin, terminal, declT>, skT), ap), idS,
         fp(pk(skT))
   )
   ]
  -->
   [
   !TagCh( pk(skT), 'TLR' ),
   !SP2( intake, lyr, t, pk(skT), core,
         sign(<'TLR', lin, terminal, declT>, skT), ap, lin, terminal, idS
   )
   ]

  /*
  rule (modulo AC) Standing_tagOK:
     [
     !SP1( intake, lyr, t, pk(skT), core,
           <'withTLR', pk(skT), sign(<'TLR', lin, terminal, declT>, skT), ap>, idS,
           fp(pk(skT))
     )
     ]
    -->
     [
     !TagCh( pk(skT), 'TLR' ),
     !SP2( intake, lyr, t, pk(skT), core,
           sign(<'TLR', lin, terminal, declT>, skT), ap, lin, terminal, idS
     )
     ]
  */

rule (modulo E) Standing_tagOK_dsks:
   [
   !SP1( intake, lyr, t,
         pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), core,
         withTLR(pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)),
                 sign(<'TLR', lin, terminal, declT>, k0), ap),
         idS, fp(pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)))
   )
   ]
  -->
   [
   !TagCh( pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), 'TLR' ),
   !SP2( intake, lyr, t,
         pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), core,
         sign(<'TLR', lin, terminal, declT>, k0), ap, lin, terminal, idS
   )
   ]

  /*
  rule (modulo AC) Standing_tagOK_dsks:
     [
     !SP1( intake, lyr, t,
           pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), core,
           <'withTLR', pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), 
            sign(<'TLR', lin, terminal, declT>, k0), ap>,
           idS, fp(pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)))
     )
     ]
    -->
     [
     !TagCh( pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), 'TLR' ),
     !SP2( intake, lyr, t,
           pk(dsks(sign(<'TLR', lin, terminal, declT>, k0), r)), core,
           sign(<'TLR', lin, terminal, declT>, k0), ap, lin, terminal, idS
     )
     ]
  */

rule (modulo E) Standing_tagBad:
   [ !SP1( intake, lyr, t, kX, core, withTLR(kX, tlrSig, ap), idS, fp(kX) )
   ]
  --[
  Neq( fst(checksign(tlrSig, kX)), 'TLR' ),
  StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID',
                  kX, t, h(core)
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Standing_tagBad:
     [
     !SP1( intake, lyr, t, kX, core, <'withTLR', kX, tlrSig, ap>, idS, fp(kX)
     )
     ]
    --[
    Neq( z, 'TLR' ),
    StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID',
                    kX, t, h(core)
    )
    ]->
     [ ]
    variants (modulo AC)
    1. kX    = kX.15
       tlrSig
             = tlrSig.18
       z     = fst(checksign(tlrSig.18, kX.15))
    
    2. kX    = pk(x.15)
       tlrSig
             = sign(x.18, x.15)
       z     = fst(x.18)
    
    3. kX    = pk(x.41)
       tlrSig
             = sign(<z.28, x.45>, x.41)
       z     = z.28
    
    4. kX    = pk(dsks(sign(x.14, x.15), x.16))
       tlrSig
             = sign(x.14, x.15)
       z     = fst(x.14)
    
    5. kX    = pk(dsks(sign(<z.27, x.41>, x.42), x.43))
       tlrSig
             = sign(<z.27, x.41>, x.42)
       z     = z.27
  */

rule (modulo E) Standing_anchorBad:
   [ !SP2( intake, lyr, t, kT, core, tlrSig, ap, lin, terminal, idS ) ]
  --[
  Neq( ap, anchorProof(h(tlrSig)) ),
  StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_TEMPORAL_MISMATCH',
                  kT, t, h(core)
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Standing_anchorBad:
     [ !SP2( intake, lyr, t, kT, core, tlrSig, ap, lin, terminal, idS ) ]
    --[
    Neq( ap, <'anchorProof', h(tlrSig)> ),
    StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_TEMPORAL_MISMATCH',
                    kT, t, h(core)
    )
    ]->
     [ ]
  */

rule (modulo E) Standing_lookup1:
   [
   !SP2( intake, lyr, t, kT, core, tlrSig, anchorProof(h(tlrSig)),
         lineage2(entry(h(core), d1), entry(b, d2)), terminal, idS
   )
   ]
  -->
   [ !SD( kT, t, h(core), d1, terminal, intake, lyr, core, idS ) ]

  /*
  rule (modulo AC) Standing_lookup1:
     [
     !SP2( intake, lyr, t, kT, core, tlrSig, <'anchorProof', h(tlrSig)>,
           <'lineage2', <'entry', h(core), d1>, 'entry', b, d2>, terminal, idS
     )
     ]
    -->
     [ !SD( kT, t, h(core), d1, terminal, intake, lyr, core, idS ) ]
  */

rule (modulo E) Standing_lookup2:
   [
   !SP2( intake, lyr, t, kT, core, tlrSig, anchorProof(h(tlrSig)),
         lineage2(entry(a, d1), entry(h(core), d2)), terminal, idS
   )
   ]
  --[ Neq( a, h(core) ) ]->
   [ !SD( kT, t, h(core), d2, terminal, intake, lyr, core, idS ) ]

  /*
  rule (modulo AC) Standing_lookup2:
     [
     !SP2( intake, lyr, t, kT, core, tlrSig, <'anchorProof', h(tlrSig)>,
           <'lineage2', <'entry', a, d1>, 'entry', h(core), d2>, terminal, idS
     )
     ]
    --[ Neq( a, h(core) ) ]->
     [ !SD( kT, t, h(core), d2, terminal, intake, lyr, core, idS ) ]
  */

rule (modulo E) Standing_lookupMiss:
   [
   !SP2( intake, lyr, t, kT, core, tlrSig, anchorProof(h(tlrSig)),
         lineage2(entry(a, d1), entry(b, d2)), terminal, idS
   )
   ]
  --[
  Neq( a, h(core) ), Neq( b, h(core) ),
  StandingReport( 'ABSENT', 'STANDING_EVIDENCE_MISMATCH', kT, t, h(core) )
  ]->
   [ ]

  /*
  rule (modulo AC) Standing_lookupMiss:
     [
     !SP2( intake, lyr, t, kT, core, tlrSig, <'anchorProof', h(tlrSig)>,
           <'lineage2', <'entry', a, d1>, 'entry', b, d2>, terminal, idS
     )
     ]
    --[
    Neq( a, h(core) ), Neq( b, h(core) ),
    StandingReport( 'ABSENT', 'STANDING_EVIDENCE_MISMATCH', kT, t, h(core) )
    ]->
     [ ]
  */

rule (modulo E) Decide_S4:
   [ !SD( kT, t, aidD, d, 'TERM_REFUSED', intake, lyr, core, idS ) ]
  --[ StandingReport( 'ABSENT', 'ISSUANCE_REFUSED', kT, t, aidD ) ]->
   [ !ReasonCh( 'PATH_S4', 'ISSUANCE_REFUSED' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Decide_Established:
   [
   !SD( kT, t, aidD, 'DISP_SHIPPED', TERM_SHIPPED(aidD), intake, lyr, core,
        idS
   )
   ]
  --[
  Established( kT, t, aidD ),
  StandingReport( 'ESTABLISHED', 'TERMINAL_DISPOSITION_SHOWN', kT, t, aidD
  )
  ]->
   [
   !EstW( intake, lyr, t, kT, core ), !EstCh( intake, lyr, kT, t, aidD ),
   !ScopeStanding( intake, lyr, kT, idS, aidD )
   ]

  /*
  rule (modulo AC) Decide_Established:
     [
     !SD( kT, t, aidD, 'DISP_SHIPPED', <'TERM_SHIPPED', aidD>, intake, lyr,
          core, idS
     )
     ]
    --[
    Established( kT, t, aidD ),
    StandingReport( 'ESTABLISHED', 'TERMINAL_DISPOSITION_SHOWN', kT, t, aidD
    )
    ]->
     [
     !EstW( intake, lyr, t, kT, core ), !EstCh( intake, lyr, kT, t, aidD ),
     !ScopeStanding( intake, lyr, kT, idS, aidD )
     ]
  */

rule (modulo E) Decide_EstablishedWrapped:
   [ !EstW( intake, lyr, t, kT, core ) ]
  --[
  Neq( lyr, 'L0' ),
  EstablishedWrapped( intake, lyr, t, kT, core, 'ESTABLISHED' )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Decide_badDisp:
   [ !SD( kT, t, aidD, d, TERM_SHIPPED(aidD), intake, lyr, core, idS ) ]
  --[
  Neq( d, 'DISP_SHIPPED' ),
  StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_MALFORMED', kT, t,
                  aidD
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Decide_badDisp:
     [ !SD( kT, t, aidD, d, <'TERM_SHIPPED', aidD>, intake, lyr, core, idS ) ]
    --[
    Neq( d, 'DISP_SHIPPED' ),
    StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_MALFORMED', kT, t,
                    aidD
    )
    ]->
     [ ]
  */

rule (modulo E) Decide_S2:
   [ !SD( kT, t, aidD, d, TERM_SHIPPED(shippedId), intake, lyr, core, idS )
   ]
  --[
  Neq( shippedId, aidD ),
  StandingReport( 'ABSENT', 'SUPERSEDED', kT, t, aidD )
  ]->
   [ !ReasonCh( 'PATH_S2', 'SUPERSEDED' ) ]

  /*
  rule (modulo AC) Decide_S2:
     [
     !SD( kT, t, aidD, d, <'TERM_SHIPPED', shippedId>, intake, lyr, core, idS
     )
     ]
    --[
    Neq( shippedId, aidD ),
    StandingReport( 'ABSENT', 'SUPERSEDED', kT, t, aidD )
    ]->
     [ !ReasonCh( 'PATH_S2', 'SUPERSEDED' ) ]
  */

rule (modulo E) Decide_badTerminal:
   [ !SD( kT, t, aidD, d, terminal, intake, lyr, core, idS ) ]
  --[
  Neq( terminal, 'TERM_REFUSED' ), Neq( fst(terminal), 'TERM_SHIPPED' ),
  StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_MALFORMED', kT, t,
                  aidD
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Decide_badTerminal:
     [ !SD( kT, t, aidD, d, terminal, intake, lyr, core, idS ) ]
    --[
    Neq( terminal, 'TERM_REFUSED' ), Neq( z, 'TERM_SHIPPED' ),
    StandingReport( 'UNVERIFIABLE', 'STANDING_EVIDENCE_MALFORMED', kT, t,
                    aidD
    )
    ]->
     [ ]
    variants (modulo AC)
    1. terminal
             = terminal.13
       z     = fst(terminal.13)
    
    2. terminal
             = <z.26, x.40>
       z     = z.26
  */

rule (modulo E) Link1aJudge:
   [ !AuthKey( skS ), !Link1a( lyr, t, ev ) ]
  --[
  Neq( checksign(ev, pk(skS)), <'STMT_DIGEST', h(t)> ),
  Neq( checksign(ev, pk(skS)), <'STMT_DIRECT', t> ),
  ChainBroken( lyr, 'LINK_1A' )
  ]->
   [ ]

  /*
  rule (modulo AC) Link1aJudge:
     [ !AuthKey( skS ), !Link1a( lyr, t, ev ) ]
    --[
    Neq( z, <'STMT_DIGEST', h(t)> ), Neq( z, <'STMT_DIRECT', t> ),
    ChainBroken( lyr, 'LINK_1A' )
    ]->
     [ ]
    variants (modulo AC)
    1. ev    = ev.9
       skS   = skS.11
       z     = checksign(ev.9, pk(skS.11))
    
    2. ev    = sign(z.11, skS.9)
       skS   = skS.9
       z     = z.11
    
    3. ev    = sign(z.18, x.28)
       skS   = dsks(sign(z.18, x.28), x.30)
       z     = z.18
  */

rule (modulo E) Link2aJudge_fp:
   [ !Link2a( lyr, t, slotfp, kX ) ]
  --[ Neq( fp(kX), slotfp ), ChainBroken( lyr, 'LINK_2A' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Link2aJudge_notB:
   [
   !Link2a( lyr, authTuple(idJ, fpAJ, signers1(fpBJ), algJ, verJ), fp(kX),
            kX
   )
   ]
  --[
  Neq( fp(kX), fpAJ ), Neq( fp(kX), fpBJ ), ChainBroken( lyr, 'LINK_2A' )
  ]->
   [ ]

  /*
  rule (modulo AC) Link2aJudge_notB:
     [
     !Link2a( lyr, <'authTuple', idJ, fpAJ, <'signers1', fpBJ>, algJ, verJ>,
              fp(kX), kX
     )
     ]
    --[
    Neq( fp(kX), fpAJ ), Neq( fp(kX), fpBJ ), ChainBroken( lyr, 'LINK_2A' )
    ]->
     [ ]
  */

rule (modulo E) Link2aJudge_s0:
   [
   !Link2a( lyr, authTuple(idJ, fpAJ, 'signers0', algJ, verJ), fp(kX), kX )
   ]
  --[ Neq( fp(kX), fpAJ ), ChainBroken( lyr, 'LINK_2A' ) ]->
   [ ]

  /*
  rule (modulo AC) Link2aJudge_s0:
     [
     !Link2a( lyr, <'authTuple', idJ, fpAJ, 'signers0', algJ, verJ>, fp(kX),
              kX
     )
     ]
    --[ Neq( fp(kX), fpAJ ), ChainBroken( lyr, 'LINK_2A' ) ]->
     [ ]
  */

rule (modulo E) PossJudge:
   [ !PossCh( lyr, kX, t, ppf ) ]
  --[
  Neq( checksign(ppf, kX), <'POSS', t> ), ChainBroken( lyr, 'LINK_3' ),
  PossessionUnbound( kX, t, ppf )
  ]->
   [ ]

  /*
  rule (modulo AC) PossJudge:
     [ !PossCh( lyr, kX, t, ppf ) ]
    --[
    Neq( z, <'POSS', t> ), ChainBroken( lyr, 'LINK_3' ),
    PossessionUnbound( kX, t, ppf )
    ]->
     [ ]
    variants (modulo AC)
    1. kX    = kX.9
       ppf   = ppf.11
       z     = checksign(ppf.11, kX.9)
    
    2. kX    = pk(x.14)
       ppf   = sign(z.10, x.14)
       z     = z.10
    
    3. kX    = pk(dsks(sign(z.12, x.17), x.18))
       ppf   = sign(z.12, x.17)
       z     = z.12
  */

rule (modulo E) BytesJudge:
   [ !BytesCh( lyr, kX, sg, fb ) ]
  --[
  Neq( checksign(sg, kX), <'BYTES', fb> ), ChainBroken( lyr, 'LINK_4' ),
  SigBytesUnbound( kX, sg, fb )
  ]->
   [ ]

  /*
  rule (modulo AC) BytesJudge:
     [ !BytesCh( lyr, kX, sg, fb ) ]
    --[
    Neq( z, <'BYTES', fb> ), ChainBroken( lyr, 'LINK_4' ),
    SigBytesUnbound( kX, sg, fb )
    ]->
     [ ]
    variants (modulo AC)
    1. kX    = kX.9
       sg    = sg.11
       z     = checksign(sg.11, kX.9)
    
    2. kX    = pk(x.14)
       sg    = sign(z.10, x.14)
       z     = z.10
    
    3. kX    = pk(dsks(sign(z.12, x.17), x.18))
       sg    = sign(z.12, x.17)
       z     = z.12
  */

rule (modulo E) Link5Judge_kfp:
   [ !Link5( lyr, t, kX, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ) ) ]
  --[
  Neq( kfpJ, fp(kX) ), Link5FrameToKey( lyr, kX, kfpJ ),
  ChainBroken( lyr, 'LINK_5' )
  ]->
   [ ]

  /*
  rule (modulo AC) Link5Judge_kfp:
     [ !Link5( lyr, t, kX, <'framed', otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ> ) ]
    --[
    Neq( kfpJ, fp(kX) ), Link5FrameToKey( lyr, kX, kfpJ ),
