rule (modulo E) AttestOne_accept:
   [
   !A1s2( aid, lyr, ctx, fbA, sgA, fbB, sgB,
          authTuple(id, fpt_, sst_, alt_, vert_), ev, kA, ppfA, kB, ppfB
   )
   ]
