                     sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                           p1>,
                          sk), 
                     ~decl1>), 
                  'DISP_ABANDONED'>, 
                 'entry', 
                 h(<'attemptCore', m, sign(<'POSS', m>, sk), 
                    sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                          p2>,
                         sk), 
                    ~decl2>), 
                 'DISP_SHIPPED'>, 
                <'TERM_SHIPPED', 
                 h(<'attemptCore', m, sign(<'POSS', m>, sk), 
                    sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                          p2>,
                         sk), 
                    ~decl2>)
                >, 
                ~declT>,
               sk)
     ),
     !HonestType( 'OT_ATTEST',
                  <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1>
     ),
     !HonestType( 'OT_ATTEST',
                  <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2>
     ),
     !HonestCh( pk(sk),
                <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1>
     ),
     !HonestCh( pk(sk),
                <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2>
     ),
     !HonestInner( pk(sk), id,
                   <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1>
     ),
     !HonestInner( pk(sk), id,
                   <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2>
     ),
     !HonestSig( pk(sk),
                 sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                       p1>,
                      sk)
     ),
     !HonestSig( pk(sk),
                 sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
