                   fp(kB)
    ),
    AcceptanceComplete( aid, lyr, <'authTuple', id, fpt_, sst_, alt_, vert_>
    ),
    AcceptS( ev, <'authTuple', id, fpt_, sst_, alt_, vert_>, kA, fbA ),
    AcceptS( ev, <'authTuple', id, fpt_, sst_, alt_, vert_>, kB, fbB ),
    ScopeReported( aid, lyr, kA, id )
    ]->
     [
     !Link1a( lyr, <'authTuple', id, fpt_, sst_, alt_, vert_>, ev ),
     !Link2a( lyr, <'authTuple', id, fpt_, sst_, alt_, vert_>, fp(kA), kA ),
