                 fp(kA), kA, ppfA, sgA, fbA
  ),
  LayerAccepted( aid, lyr, authTuple(id, fpt_, sst_, alt_, vert_), ev,
                 fp(kB), kB, ppfB, sgB, fbB
  ),
  SlotSatisfied( aid, lyr, authTuple(id, fpt_, sst_, alt_, vert_), fp(kA)
  ),
  SlotSatisfied( aid, lyr, authTuple(id, fpt_, sst_, alt_, vert_), fp(kB)
  ),
  AcceptanceComplete( aid, lyr, authTuple(id, fpt_, sst_, alt_, vert_) ),
  AcceptS( ev, authTuple(id, fpt_, sst_, alt_, vert_), kA, fbA ),
  AcceptS( ev, authTuple(id, fpt_, sst_, alt_, vert_), kB, fbB ),
  ScopeReported( aid, lyr, kA, id )
  ]->
   [
   !Link1a( lyr, authTuple(id, fpt_, sst_, alt_, vert_), ev ),
   !Link2a( lyr, authTuple(id, fpt_, sst_, alt_, vert_), fp(kA), kA ),
   !Link2a( lyr, authTuple(id, fpt_, sst_, alt_, vert_), fp(kB), kB ),
   !PossCh( lyr, kA, authTuple(id, fpt_, sst_, alt_, vert_), ppfA ),
   !PossCh( lyr, kB, authTuple(id, fpt_, sst_, alt_, vert_), ppfB ),
   !BytesCh( lyr, kA, sgA, fbA ), !BytesCh( lyr, kB, sgB, fbB ),
   !Link5( lyr, authTuple(id, fpt_, sst_, alt_, vert_), kA, fbA ),
   !Link5( lyr, authTuple(id, fpt_, sst_, alt_, vert_), kB, fbB ),
   !Link5c( lyr, fbA, fbB ), !Link6a( lyr, 'OT_ATTEST', fbA ),
   !Link6a( lyr, 'OT_ATTEST', fbB ), !Link6b( aid, lyr, kA, id, fbA ),
   !TypeCh( 'OT_ATTEST', fbA ), !TypeCh( 'OT_ATTEST', fbB ),
   !SlotCh( authTuple(id, fpt_, sst_, alt_, vert_), fp(kA), kA ),
   !SlotCh( authTuple(id, fpt_, sst_, alt_, vert_), fp(kB), kB ),
   !SetCh( authTuple(id, fpt_, sst_, alt_, vert_), verified2(kA, kB) ),
   !AcceptCh( ctx, 'SLOT_A', kA, id, fbA ),
   !AcceptCh( ctx, 'SLOT_B', kB, id, fbB ), !AcceptKey( kA, fbA ),
   !AcceptKey( kB, fbB ), !ScopeCh( ctx, kA, id, fbA ),
   !ScopeCh( ctx, kB, id, fbB ), !SigCh( ctx, kA, sgA ),
   !SigCh( ctx, kB, sgB ), !Gsig( kA, sgA ), !Gsig( kB, sgB ),
   !ChainCh( lyr, kA, authTuple(id, fpt_, sst_, alt_, vert_), fbA ),
   !ChainCh( lyr, kB, authTuple(id, fpt_, sst_, alt_, vert_), fbB ),
   !ContentCh( authTuple(id, fpt_, sst_, alt_, vert_), fbA, fbB ),
   !ScopeEnvelope( aid, lyr, kA, id )
   ]

