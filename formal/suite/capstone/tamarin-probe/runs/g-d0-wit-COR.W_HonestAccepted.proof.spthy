            framed(ob, ab, ib, kb, mb, cb, pb)
   )
   ]
  --[ Neq( pa, pb ), ChainBroken( lyr, 'LINK_5' ) ]->
   [ ]

  /*
  rule (modulo AC) Link5cJudge_pl:
     [
     !Link5c( lyr, <'framed', oa, aa, ia, ka, ma, ca, pa>,
              <'framed', ob, ab, ib, kb, mb, cb, pb>
     )
     ]
    --[ Neq( pa, pb ), ChainBroken( lyr, 'LINK_5' ) ]->
