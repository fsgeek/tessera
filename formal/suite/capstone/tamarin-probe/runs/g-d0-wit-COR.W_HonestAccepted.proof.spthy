rule (modulo E) Front:
   [
   In( <fbA, sgA, fbB, sgB, t0, ev0, kA0, ppfA0, kB0, ppfB0, t1, ev1, kA1, 
        ppfA1, kB1, ppfB1, t2, ev2, kA2, ppfA2, kB2, ppfB2, coreIn, seIn>
   ),
   Fr( ~aid )
   ]
  --[ Intake( ~aid ) ]->
   [
   !StageL0( ~aid, 'L0', 'BASE', 'kNone', 'idAdv', fbA, sgA, fbB, sgB ),
   !SStageL0( ~aid, 'L0', fbA, sgA, fbB, sgB ),
   !EnvMat( ~aid, 'L0', t0, ev0, kA0, ppfA0, kB0, ppfB0 ),
   !EnvMat( ~aid, 'L1', t1, ev1, kA1, ppfA1, kB1, ppfB1 ),
   !EnvMat( ~aid, 'L2', t2, ev2, kA2, ppfA2, kB2, ppfB2 ),
   !StdMat( ~aid, 'L0', t0, ev0, kA0, ppfA0, kB0, ppfB0 ),
   !StdMat( ~aid, 'L1', t1, ev1, kA1, ppfA1, kB1, ppfB1 ),
   !StdMat( ~aid, 'L2', t2, ev2, kA2, ppfA2, kB2, ppfB2 ),
   !StandCore( ~aid, coreIn, seIn )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AttestCheck1_L0:
   [
   !AuthKey( skS ),
   !StageL0( aid, lyr, ctx, kEnc, idEnc, fbA, sgA, fbB, sgB ),
   !EnvMat( aid, lyr, authTuple(id, kfprA, ss, al, ver),
            sign(<'STMT_DIGEST', h(authTuple(id, kfprA, ss, al, ver))>, skS), kA,
            ppfA, kB, ppfB
   )
   ]
  --[
  AuthorityEvidence( authTuple(id, kfprA, ss, al, ver),
                     sign(<'STMT_DIGEST', h(authTuple(id, kfprA, ss, al, ver))>, skS), pk(skS)
  )
  ]->
   [
   !AS1( aid, lyr, ctx, fbA, sgA, fbB, sgB,
         authTuple(id, kfprA, ss, al, ver),
         sign(<'STMT_DIGEST', h(authTuple(id, kfprA, ss, al, ver))>, skS), kA,
         ppfA, kB, ppfB
   )
   ]

