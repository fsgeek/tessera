lemma W_HonestAccepted:
  exists-trace "∃ k fb #i. HonestAccepted( k, fb ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ k fb #i. (HonestAccepted( k, fb ) @ #i)"
*/
simplify
solve( !HonestCh( k, fb ) ▶₀ #i )
  case Attester
  solve( !AcceptCh( 'BASE', role, pk(~skB2), idX,
                    <'framed', 'OT_ATTEST', 'algH', 'issuerId2', fp(pk(~skB2)), 
                     h(<'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
                        'algH', 'verH'>), 
                     'cvA', payload>
         ) ▶₁ #i )
    case AttestTwo_accept
    solve( !KU( sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', 'issuerId2', 
                      fp(pk(~skI)), 
                      h(<'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
                         'algH', 'verH'>), 
                      'cvA', payload>,
                     ~skI)
           ) @ #vk.5 )
      case ShipIssuer_case_1
      solve( !KU( sign(<'STMT_DIGEST', 
                        h(<'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
                           'algH', 'verH'>)
                       >,
                       ~skS)
             ) @ #vk.15 )
        case AuthorityS
        solve( !KU( sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', 'issuerId2', 
                          fp(pk(~skB2)), 
                          h(<'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
                             'algH', 'verH'>), 
                          'cvA', payload>,
                         ~skB2)
               ) @ #vk.14 )
          case Attester
          solve( !KU( sign(<'POSS', 'authTuple', 'issuerId2', fp(pk(~skI)), 
                            <'signers1', fp(pk(~skB2))>, 'algH', 'verH'>,
                           ~skI)
                 ) @ #vk.23 )
            case ShipIssuer_case_1
            solve( !KU( sign(<'POSS', 'authTuple', 'issuerId2', fp(pk(~skI)), 
                              <'signers1', fp(pk(~skB2))>, 'algH', 'verH'>,
                             ~skB2)
                   ) @ #vk.29 )
              case Attester
              solve( !KU( pk(~skI) ) @ #vk.28 )
                case Init
                solve( !KU( pk(~skB2) ) @ #vk.31 )
                  case Init
                  solve( !KU( fp(pk(~skI)) ) @ #vk.67 )
                    case Attester_case_1
                    solve( !KU( h(<'authTuple', 'issuerId2', fp(pk(~skI)), 
                                   <'signers1', fp(pk(~skB2))>, 'algH', 'verH'>)
                           ) @ #vk.68 )
                      case Attester_case_1
                      solve( !KU( fp(pk(~skB2)) ) @ #vk.70 )
                        case Attester_case_1
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

