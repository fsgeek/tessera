// EXPLORATORY PROBE 2026-10-04 — non-discharging; not part of any registration
theory cap_cc02_d_probe

begin

// Function signature and definition of the equational theory E

functions: checksign/2, dsks/2, fp/1, fst/1, h/1, pair/2, pk/1, sign/2,
           snd/1
equations:
    checksign(sign(m, k), pk(k)) = m,
    checksign(sign(m, k), pk(dsks(sign(m, k), r))) = m,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

macros: framed( ot, al, id, kfp, mh, cv, pl ) =  <'framed', ot, al, id, 
                                                  kfp, mh, cv, pl>,
        authTuple( id, f, ss, al, ver ) =  <'authTuple', id, f, ss, al, ver>,
        signers1( x ) =  <'signers1', x>,
        verified1( k ) =  <'verified1', k>,
        verified2( k1, k2 ) =  <'verified2', k1, k2>,
        wrap( cv, blob ) =  <'wrap', cv, blob>,
        wctx( k, id, fb ) =  <'wctx', k, id, fb>,
        attemptCore( t, ppf, sg, dcl ) =  <'attemptCore', t, ppf, sg, dcl>,
        entry( a, d ) =  <'entry', a, d>,
        lineage2( e1, e2 ) =  <'lineage2', e1, e2>,
        TERM_SHIPPED( x ) =  <'TERM_SHIPPED', x>,
        withTLR( k, s, ap ) =  <'withTLR', k, s, ap>,
        anchorProof( x ) =  <'anchorProof', x>,
        M1( skI2 ) =  <'authTuple', 'issuerId', fp(pk(skI2)), 'signers0', 
                       'algH', 'verH'>,
        M2( skI, skB2 ) =  <'authTuple', 'issuerId2', fp(pk(skI)), 
                            <'signers1', fp(pk(skB2))>, 'algH', 'verH'>,
        MW( skW ) =  <'authTuple', 'idW', fp(pk(skW)), 'signers0', 'algH', 'verH'
                     >,
        MA( skAdv ) =  <'authTuple', 'idAdv', fp(pk(skAdv)), 'signers0', 'algH', 
                        'verH'>

restriction Eq:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction Neq:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  */

restriction Once:
  "∀ #i #j. ((Once( ) @ #i) ∧ (Once( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((Once( ) @ #i) ∧ (Once( ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Init:
   [
   Fr( ~skS ), Fr( ~skAdv ), Fr( ~skI ), Fr( ~skB2 ), Fr( ~skI2 ),
   Fr( ~skW )
   ]
  --[ Once( ), Fixture( ~skS, ~skI, ~skB2, ~skI2, ~skW, ~skAdv ) ]->
   [
   Out( pk(~skS) ), Out( pk(~skI) ), Out( pk(~skB2) ), Out( pk(~skI2) ),
   Out( pk(~skW) ), Out( M1(~skI2) ), Out( M2(~skI, ~skB2) ),
   Out( MW(~skW) ), Out( ~skAdv ), Out( MA(~skAdv) ), Out( ~skS ),
   !AuthKey( ~skS ), !HonestKey( pk(~skI) ), !HonestKey( pk(~skB2) ),
   !HonestKey( pk(~skI2) ), !HonestKey( pk(~skW) ),
   !HonestMember( pk(~skI), M2(~skI, ~skB2) ),
   !HonestMember( pk(~skB2), M2(~skI, ~skB2) ),
   !HonestMember( pk(~skI2), M1(~skI2) ),
   !HonestMember( pk(~skW), MW(~skW) ), !HonestSet( M1(~skI2) ),
   !HonestSet( M2(~skI, ~skB2) ), !HonestSet( MW(~skW) ),
   !AuthTask( M1(~skI2) ), !AuthTask( M2(~skI, ~skB2) ),
   !AuthTask( MW(~skW) ),
   !ShipI( ~skI, 'issuerId2', M2(~skI, ~skB2), 'cvA' ),
   !RefI( ~skI, 'issuerId2', M2(~skI, ~skB2), 'cvA' ),
   !ShipI( ~skI2, 'issuerId', M1(~skI2), 'cvA' ),
   !RefI( ~skI2, 'issuerId', M1(~skI2), 'cvA' ),
   !AttI( ~skB2, 'issuerId2', M2(~skI, ~skB2), 'cvA' ), !ForI( ~skI ),
   !WrapI( ~skI, 'issuerId2', M2(~skI, ~skB2), 'cvB' ),
   !WrapI( ~skB2, 'issuerId2', M2(~skI, ~skB2), 'cvB' ),
   !WrapI( ~skW, 'idW', MW(~skW), 'cvB' )
   ]

  /*
  rule (modulo AC) Init:
     [
     Fr( ~skS ), Fr( ~skAdv ), Fr( ~skI ), Fr( ~skB2 ), Fr( ~skI2 ),
     Fr( ~skW )
     ]
    --[ Once( ), Fixture( ~skS, ~skI, ~skB2, ~skI2, ~skW, ~skAdv ) ]->
     [
     Out( pk(~skS) ), Out( pk(~skI) ), Out( pk(~skB2) ), Out( pk(~skI2) ),
     Out( pk(~skW) ),
     Out( <'authTuple', 'issuerId', fp(pk(~skI2)), 'signers0', 'algH', 'verH'>
     ),
     Out( <'authTuple', 'issuerId2', fp(pk(~skI)), 
           <'signers1', fp(pk(~skB2))>, 'algH', 'verH'>
     ),
     Out( <'authTuple', 'idW', fp(pk(~skW)), 'signers0', 'algH', 'verH'> ),
     Out( ~skAdv ),
     Out( <'authTuple', 'idAdv', fp(pk(~skAdv)), 'signers0', 'algH', 'verH'>
     ),
     Out( ~skS ), !AuthKey( ~skS ), !HonestKey( pk(~skI) ),
     !HonestKey( pk(~skB2) ), !HonestKey( pk(~skI2) ), !HonestKey( pk(~skW) ),
     !HonestMember( pk(~skI),
                    <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
                     'algH', 'verH'>
     ),
     !HonestMember( pk(~skB2),
                    <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
                     'algH', 'verH'>
     ),
     !HonestMember( pk(~skI2),
                    <'authTuple', 'issuerId', fp(pk(~skI2)), 'signers0', 'algH', 'verH'>
     ),
     !HonestMember( pk(~skW),
                    <'authTuple', 'idW', fp(pk(~skW)), 'signers0', 'algH', 'verH'>
     ),
     !HonestSet( <'authTuple', 'issuerId', fp(pk(~skI2)), 'signers0', 'algH', 
                  'verH'>
     ),
     !HonestSet( <'authTuple', 'issuerId2', fp(pk(~skI)), 
                  <'signers1', fp(pk(~skB2))>, 'algH', 'verH'>
     ),
     !HonestSet( <'authTuple', 'idW', fp(pk(~skW)), 'signers0', 'algH', 'verH'
                 >
     ),
     !AuthTask( <'authTuple', 'issuerId', fp(pk(~skI2)), 'signers0', 'algH', 
                 'verH'>
     ),
     !AuthTask( <'authTuple', 'issuerId2', fp(pk(~skI)), 
                 <'signers1', fp(pk(~skB2))>, 'algH', 'verH'>
     ),
     !AuthTask( <'authTuple', 'idW', fp(pk(~skW)), 'signers0', 'algH', 'verH'>
     ),
     !ShipI( ~skI, 'issuerId2',
             <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
              'algH', 'verH'>,
             'cvA'
     ),
     !RefI( ~skI, 'issuerId2',
            <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
             'algH', 'verH'>,
            'cvA'
     ),
     !ShipI( ~skI2, 'issuerId',
             <'authTuple', 'issuerId', fp(pk(~skI2)), 'signers0', 'algH', 'verH'>,
             'cvA'
     ),
     !RefI( ~skI2, 'issuerId',
            <'authTuple', 'issuerId', fp(pk(~skI2)), 'signers0', 'algH', 'verH'>,
            'cvA'
     ),
     !AttI( ~skB2, 'issuerId2',
            <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
             'algH', 'verH'>,
            'cvA'
     ),
     !ForI( ~skI ),
     !WrapI( ~skI, 'issuerId2',
             <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
              'algH', 'verH'>,
             'cvB'
     ),
     !WrapI( ~skB2, 'issuerId2',
             <'authTuple', 'issuerId2', fp(pk(~skI)), <'signers1', fp(pk(~skB2))>, 
              'algH', 'verH'>,
             'cvB'
     ),
     !WrapI( ~skW, 'idW',
             <'authTuple', 'idW', fp(pk(~skW)), 'signers0', 'algH', 'verH'>, 'cvB'
     )
     ]
  */

rule (modulo E) AuthorityS:
   [ !AuthKey( skS ), !AuthTask( t ) ]
  --[ AuthorityPublishedDNS( t ) ]->
   [ Out( sign(<'STMT_DIGEST', h(t)>, skS) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Attester:
   [ !AttI( sk, id, m, cv ), In( payload ) ]
  --[
  IssuerPossession( pk(sk) ),
  IssuerSigned( pk(sk),
                framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)
  )
  ]->
   [
   Out( sign(<'POSS', m>, sk) ),
   !HonestType( 'OT_ATTEST',
                framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)
   ),
   !HonestCh( pk(sk),
              framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)
   ),
   !HonestInner( pk(sk), id,
                 framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)
   ),
   !HonestSig( pk(sk),
               sign(<'BYTES', 
                     framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)>,
                    sk)
   ),
   !GsigHon( pk(sk),
             sign(<'BYTES', 
                   framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)>,
                  sk)
   ),
   !HonestChainCh( pk(sk), m,
                   framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)
   ),
   Out( sign(<'BYTES', 
              framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)>,
             sk)
   )
   ]

  /*
  rule (modulo AC) Attester:
     [ !AttI( sk, id, m, cv ), In( payload ) ]
    --[
    IssuerPossession( pk(sk) ),
    IssuerSigned( pk(sk),
                  <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload>
    )
    ]->
     [
     Out( sign(<'POSS', m>, sk) ),
     !HonestType( 'OT_ATTEST',
                  <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload>
     ),
     !HonestCh( pk(sk),
                <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload>
     ),
     !HonestInner( pk(sk), id,
                   <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload>
     ),
     !HonestSig( pk(sk),
                 sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                       payload>,
                      sk)
     ),
     !GsigHon( pk(sk),
               sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, 
                     payload>,
                    sk)
     ),
     !HonestChainCh( pk(sk), m,
                     <'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload>
     ),
     Out( sign(<'BYTES', 'framed', 'OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), 
                cv, payload>,
               sk)
     )
     ]
  */

rule (modulo E) ShipIssuer:
   [
   !ShipI( sk, id, m, cv ), In( <p1, p2> ), Fr( ~decl1 ), Fr( ~decl2 ),
   Fr( ~declT )
   ]
  --[
  IssuerPossession( pk(sk) ),
  IssuerSigned( pk(sk),
                framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
  ),
  IssuerSigned( pk(sk),
                framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
  ),
  Designated( pk(sk),
              h(attemptCore(m, sign(<'POSS', m>, sk),
                            sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
                                 >,
                                 sk),
                            ~decl2))
  )
  ]->
   [
   Out( sign(<'POSS', m>, sk) ),
   Out( <
         attemptCore(m, sign(<'POSS', m>, sk),
                     sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
                          >,
                          sk),
                     ~decl1), 
         framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1), 
         sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
              >,
              sk)
        >
   ),
   Out( <
         attemptCore(m, sign(<'POSS', m>, sk),
                     sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
                          >,
                          sk),
                     ~decl2), 
         framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2), 
         sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
              >,
              sk)
        >
   ),
   !Design( pk(sk),
            h(attemptCore(m, sign(<'POSS', m>, sk),
                          sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
                               >,
                               sk),
                          ~decl2))
   ),
   Out( sign(<'TLR', 
              lineage2(entry(h(attemptCore(m, sign(<'POSS', m>, sk),
                                           sign(<'BYTES', 
                                                 framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)>,
                                                sk),
                                           ~decl1)),
                             'DISP_ABANDONED'),
                       entry(h(attemptCore(m, sign(<'POSS', m>, sk),
                                           sign(<'BYTES', 
                                                 framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)>,
                                                sk),
                                           ~decl2)),
                             'DISP_SHIPPED')), 
              TERM_SHIPPED(h(attemptCore(m, sign(<'POSS', m>, sk),
                                         sign(<'BYTES', 
                                               framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)>,
                                              sk),
                                         ~decl2))), 
              ~declT>,
             sk)
   ),
   !HonestType( 'OT_ATTEST',
                framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
   ),
   !HonestType( 'OT_ATTEST',
                framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
   ),
   !HonestCh( pk(sk),
              framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
   ),
   !HonestCh( pk(sk),
              framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
   ),
   !HonestInner( pk(sk), id,
                 framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
   ),
   !HonestInner( pk(sk), id,
                 framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
   ),
   !HonestSig( pk(sk),
               sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
                    >,
                    sk)
   ),
   !HonestSig( pk(sk),
               sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
                    >,
                    sk)
   ),
   !GsigHon( pk(sk),
             sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
                  >,
                  sk)
   ),
   !GsigHon( pk(sk),
             sign(<'BYTES', framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
                  >,
                  sk)
   ),
   !HonestChainCh( pk(sk), m,
                   framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
   ),
   !HonestChainCh( pk(sk), m,
                   framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
   )
   ]

