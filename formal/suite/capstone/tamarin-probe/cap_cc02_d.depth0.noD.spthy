theory cap_cc02_d_probe
begin

functions: pk/1, sign/2, checksign/2, dsks/2, fp/1, h/1

equations:
  // tessera_theory.pvl: checksign reduc, with the D-4 dsks `otherwise` rule
  checksign(sign(m, k), pk(k)) = m,
  checksign(sign(m, k), pk(dsks(sign(m, k), r))) = m

macros:
  framed(ot, al, id, kfp, mh, cv, pl) = <'framed', ot, al, id, kfp, mh, cv, pl>,
  authTuple(id, f, ss, al, ver)       = <'authTuple', id, f, ss, al, ver>,
  signers1(x)                         = <'signers1', x>,
  verified1(k)                        = <'verified1', k>,
  verified2(k1, k2)                   = <'verified2', k1, k2>,
  wrap(cv, blob)                      = <'wrap', cv, blob>,
  wctx(k, id, fb)                     = <'wctx', k, id, fb>,
  attemptCore(t, ppf, sg, dcl)        = <'attemptCore', t, ppf, sg, dcl>,
  entry(a, d)                         = <'entry', a, d>,
  lineage2(e1, e2)                    = <'lineage2', e1, e2>,
  TERM_SHIPPED(x)                     = <'TERM_SHIPPED', x>,
  withTLR(k, s, ap)                   = <'withTLR', k, s, ap>,
  anchorProof(x)                      = <'anchorProof', x>,
  M1(skI2)  = <'authTuple', 'issuerId',  fp(pk(skI2)), 'signers0', 'algH', 'verH'>,
  M2(skI, skB2) = <'authTuple', 'issuerId2', fp(pk(skI)), <'signers1', fp(pk(skB2))>, 'algH', 'verH'>,
  MW(skW)   = <'authTuple', 'idW',       fp(pk(skW)),  'signers0', 'algH', 'verH'>,
  MA(skAdv) = <'authTuple', 'idAdv',     fp(pk(skAdv)), 'signers0', 'algH', 'verH'>

restriction Eq:   "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Neq:  "All x y #i. Neq(x, y) @ #i ==> not (x = y)"
restriction Once: "All #i #j. Once() @ #i & Once() @ #j ==> #i = #j"

/* ==================================================================== */
/* THE FIXTURE (the .pv's top-level `process`)                          */
/* ==================================================================== */
rule Init:
  [ Fr(~skS), Fr(~skAdv), Fr(~skI), Fr(~skB2), Fr(~skI2), Fr(~skW) ]
--[ Once(), Fixture(~skS, ~skI, ~skB2, ~skI2, ~skW, ~skAdv) ]->
  [ Out(pk(~skS)),
    Out(pk(~skI)), Out(pk(~skB2)), Out(pk(~skI2)), Out(pk(~skW)),
    Out(M1(~skI2)), Out(M2(~skI, ~skB2)), Out(MW(~skW)),
    Out(~skAdv), Out(MA(~skAdv)),
    Out(~skS),                                  // CASE (d): the sole channel key is public
    !AuthKey(~skS),
    !HonestKey(pk(~skI)), !HonestKey(pk(~skB2)), !HonestKey(pk(~skI2)), !HonestKey(pk(~skW)),
    !HonestMember(pk(~skI), M2(~skI, ~skB2)), !HonestMember(pk(~skB2), M2(~skI, ~skB2)),
    !HonestMember(pk(~skI2), M1(~skI2)), !HonestMember(pk(~skW), MW(~skW)),
    !HonestSet(M1(~skI2)), !HonestSet(M2(~skI, ~skB2)), !HonestSet(MW(~skW)),
    !AuthTask(M1(~skI2)), !AuthTask(M2(~skI, ~skB2)), !AuthTask(MW(~skW)),
    !ShipI(~skI, 'issuerId2', M2(~skI, ~skB2), 'cvA'), !RefI(~skI, 'issuerId2', M2(~skI, ~skB2), 'cvA'),
    !ShipI(~skI2, 'issuerId', M1(~skI2), 'cvA'),       !RefI(~skI2, 'issuerId', M1(~skI2), 'cvA'),
    !AttI(~skB2, 'issuerId2', M2(~skI, ~skB2), 'cvA'),
    !ForI(~skI),
    !WrapI(~skI,  'issuerId2', M2(~skI, ~skB2), 'cvB'),
    !WrapI(~skB2, 'issuerId2', M2(~skI, ~skB2), 'cvB'),
    !WrapI(~skW,  'idW',       MW(~skW),        'cvB')
  ]

/* ---- AuthorityS(skS, t), replicated for M1, M2, MW ------------------ */
rule AuthorityS:
  [ !AuthKey(skS), !AuthTask(t) ]
--[ AuthorityPublishedDNS(t) ]->
  [ Out(sign(<'STMT_DIGEST', h(t)>, skS)) ]

/* ---- Attester(skB2, issuerId2, M2, cvA) ------------------------------ */
rule Attester:
  let fb = framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, payload)
      sg = sign(<'BYTES', fb>, sk)
  in
  [ !AttI(sk, id, m, cv), In(payload) ]
--[ IssuerPossession(pk(sk)), IssuerSigned(pk(sk), fb) ]->
  [ Out(sign(<'POSS', m>, sk)),
    !HonestType('OT_ATTEST', fb), !HonestCh(pk(sk), fb), !HonestInner(pk(sk), id, fb),
    !HonestSig(pk(sk), sg), !GsigHon(pk(sk), sg), !HonestChainCh(pk(sk), m, fb),
    Out(sg) ]

/* ---- ShipIssuer(sk, id, m, cv) --------------------------------------- */
rule ShipIssuer:
  let ppf   = sign(<'POSS', m>, sk)
      fb1   = framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
      sg1   = sign(<'BYTES', fb1>, sk)
      core1 = attemptCore(m, ppf, sg1, ~decl1)
      fb2   = framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
      sg2   = sign(<'BYTES', fb2>, sk)
      core2 = attemptCore(m, ppf, sg2, ~decl2)
      body  = <lineage2(entry(h(core1), 'DISP_ABANDONED'), entry(h(core2), 'DISP_SHIPPED')),
               TERM_SHIPPED(h(core2)), ~declT>
  in
  [ !ShipI(sk, id, m, cv), In(<p1, p2>), Fr(~decl1), Fr(~decl2), Fr(~declT) ]
--[ IssuerPossession(pk(sk)), IssuerSigned(pk(sk), fb1), IssuerSigned(pk(sk), fb2),
    Designated(pk(sk), h(core2)) ]->
  [ Out(ppf), Out(<core1, fb1, sg1>), Out(<core2, fb2, sg2>),
    !Design(pk(sk), h(core2)),
    Out(sign(<'TLR', body>, sk)),
    !HonestType('OT_ATTEST', fb1), !HonestType('OT_ATTEST', fb2),
    !HonestCh(pk(sk), fb1), !HonestCh(pk(sk), fb2),
    !HonestInner(pk(sk), id, fb1), !HonestInner(pk(sk), id, fb2),
    !HonestSig(pk(sk), sg1), !HonestSig(pk(sk), sg2),
    !GsigHon(pk(sk), sg1), !GsigHon(pk(sk), sg2),
    !HonestChainCh(pk(sk), m, fb1), !HonestChainCh(pk(sk), m, fb2) ]

/* ---- RefuseIssuer(sk, id, m, cv) ------------------------------------- */
rule RefuseIssuer:
  let ppf   = sign(<'POSS', m>, sk)
      fb1   = framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p1)
      sg1   = sign(<'BYTES', fb1>, sk)
      core1 = attemptCore(m, ppf, sg1, ~decl1)
      fb2   = framed('OT_ATTEST', 'algH', id, fp(pk(sk)), h(m), cv, p2)
      sg2   = sign(<'BYTES', fb2>, sk)
      core2 = attemptCore(m, ppf, sg2, ~decl2)
      body  = <lineage2(entry(h(core1), 'DISP_ABANDONED'), entry(h(core2), 'DISP_ABANDONED')),
               'TERM_REFUSED', ~declT>
  in
  [ !RefI(sk, id, m, cv), In(<p1, p2>), Fr(~decl1), Fr(~decl2), Fr(~declT) ]
--[ IssuerPossession(pk(sk)), IssuerSigned(pk(sk), fb1), IssuerSigned(pk(sk), fb2) ]->
  [ Out(ppf), Out(<core1, fb1, sg1>), Out(<core2, fb2, sg2>),
    Out(sign(<'TLR', body>, sk)),
    !HonestType('OT_ATTEST', fb1), !HonestType('OT_ATTEST', fb2),
    !HonestCh(pk(sk), fb1), !HonestCh(pk(sk), fb2),
    !HonestInner(pk(sk), id, fb1), !HonestInner(pk(sk), id, fb2),
    !HonestSig(pk(sk), sg1), !HonestSig(pk(sk), sg2),
    !GsigHon(pk(sk), sg1), !GsigHon(pk(sk), sg2),
    !HonestChainCh(pk(sk), m, fb1), !HonestChainCh(pk(sk), m, fb2) ]

/* ---- Wrapper(sk, id, m, cv) ------------------------------------------ */
rule Wrapper:
  let fb = framed('OT_WRAPPER', 'algH', id, fp(pk(sk)), h(m), cv,
                  wrap(cvIw, <fbIA, sgIA, fbIB, sgIB>))
      sg = sign(<'BYTES', fb>, sk)
  in
  [ !WrapI(sk, id, m, cv), In(<cvIw, fbIA, sgIA, fbIB, sgIB>) ]
--[ IssuerPossession(pk(sk)), IssuerSigned(pk(sk), fb) ]->
  [ Out(sign(<'POSS', m>, sk)),
    !HonestType('OT_WRAPPER', fb), !HonestCh(pk(sk), fb),
    !HonestChainCh(pk(sk), m, fb), !GsigHon(pk(sk), sg),
    Out(sg) ]

/* ---- ForeignIssuer(skI) ---------------------------------------------- */
rule ForeignIssuer:
  let body = <lineage2(entry(h(foreignCore), 'DISP_SHIPPED'), entry('fbH', 'DISP_ABANDONED')),
              TERM_SHIPPED(h(foreignCore)), 'fbH'>
  in
  [ !ForI(sk), In(foreignCore) ]
  -->
  [ Out(sign(<'REFUSAL', body>, sk)) ]

/* ==================================================================== */
/* THE FRONT END                                                         */
/* ==================================================================== */
rule Front:
  [ In(<fbA, sgA, fbB, sgB,
        t0, ev0, kA0, ppfA0, kB0, ppfB0,
        t1, ev1, kA1, ppfA1, kB1, ppfB1,
        t2, ev2, kA2, ppfA2, kB2, ppfB2,
        coreIn, seIn>), Fr(~aid) ]
--[ Intake(~aid) ]->
  [ !StageL0(~aid, 'L0', 'BASE', 'kNone', 'idAdv', fbA, sgA, fbB, sgB),
    !SStageL0(~aid, 'L0', fbA, sgA, fbB, sgB),
    !EnvMat(~aid, 'L0', t0, ev0, kA0, ppfA0, kB0, ppfB0),
    !EnvMat(~aid, 'L1', t1, ev1, kA1, ppfA1, kB1, ppfB1),
    !EnvMat(~aid, 'L2', t2, ev2, kA2, ppfA2, kB2, ppfB2),
    !StdMat(~aid, 'L0', t0, ev0, kA0, ppfA0, kB0, ppfB0),
    !StdMat(~aid, 'L1', t1, ev1, kA1, ppfA1, kB1, ppfB1),
    !StdMat(~aid, 'L2', t2, ev2, kA2, ppfA2, kB2, ppfB2),
    !StandCore(~aid, coreIn, seIn) ]

/* ==================================================================== */
/* THE ENVELOPE PATH — AttestStage(pk(skS))                              */
/* ==================================================================== */
// CHECK 1 and the authTuple parse, shared by both branches.
rule AttestCheck1_L0:
  let t  = authTuple(id, kfprA, ss, al, ver)
      ev = sign(<'STMT_DIGEST', h(t)>, skS)
  in
  [ !AuthKey(skS),
    !StageL0(aid, lyr, ctx, kEnc, idEnc, fbA, sgA, fbB, sgB),
    !EnvMat(aid, lyr, t, ev, kA, ppfA, kB, ppfB) ]
--[ AuthorityEvidence(t, ev, pk(skS)) ]->
  [ !AS1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

// ENCODING NOTE (FIDELITY.md A4b): each acceptance branch is a PARSE rule
// (premise patterns = every equality / pin / type check), then ONE STEP PER
// SIGNATURE CHECK in the .pv's order (POSS A, [POSS B,] BYTES A, [BYTES B]),
// each step written as TWO rules, _H and _D, one per rewrite rule of
// checksign (the reduc and its dsks `otherwise`): together exactly
// `let (=TAG, =x) = checksign(sig, k)`.  (Replaced an Eq restriction whose
// variant order sent depth-first search down the dsks case first.)
// then an ACCEPT rule carrying every event and output.  Intermediate facts
// are internal.  This replaced a one-rule-per-branch form whose 2^4 rule
// variants per two-signer rule exhausted memory (REPORT.md, attempts 1-3).

// ---------------- the one-signer branch (NOT mutated) ----------------
rule AttestOne_parse:
  let t   = authTuple(id, fp(kA), 'signers0', al, ver)
      fbA = framed('OT_ATTEST', al, id, fp(kA), h(t), cvsA, plA)
  in
  [ !AS1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A1s0(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule A1_chk1_possA_H:  // checksign's first rewrite rule (honest key)
  let ppfA = sign(<'POSS', t>, skH_)
      kA = pk(skH_)
  in
  [ !A1s0(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A1s1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule A1_chk2_bytesA_H:  // checksign's first rewrite rule (honest key)
  let sgA = sign(<'BYTES', fbA>, skH_)
      kA = pk(skH_)
  in
  [ !A1s1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A1s2(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule AttestOne_accept:
  let t = authTuple(id, fpt_, sst_, alt_, vert_)
  in
  [ !A1s2(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
--[ LayerAccepted(aid, lyr, t, ev, fp(kA), kA, ppfA, sgA, fbA),
    SlotSatisfied(aid, lyr, t, fp(kA)),
    AcceptanceComplete(aid, lyr, t),
    AcceptS(ev, t, kA, fbA),
    ScopeReported(aid, lyr, kA, id) ]->
  [ !Link1a(lyr, t, ev), !Link2a(lyr, t, fp(kA), kA),
    !PossCh(lyr, kA, t, ppfA), !BytesCh(lyr, kA, sgA, fbA),
    !Link5(lyr, t, kA, fbA),
    !Link6a(lyr, 'OT_ATTEST', fbA), !Link6b(aid, lyr, kA, id, fbA),
    !TypeCh('OT_ATTEST', fbA), !SlotCh(t, fp(kA), kA), !SetCh(t, verified1(kA)),
    !AcceptCh(ctx, 'SLOT_A', kA, id, fbA), !AcceptKey(kA, fbA),
    !ScopeCh(ctx, kA, id, fbA), !SigCh(ctx, kA, sgA), !Gsig(kA, sgA),
    !ChainCh(lyr, kA, t, fbA), !ScopeEnvelope(aid, lyr, kA, id) ]

// ---------------- the two-signer branch: THE MUTATION SITE -----------
#ifdef CORRECT
rule AttestTwo_parse_correct:
  let t   = authTuple(id, fp(kA), signers1(fp(kB)), al, ver)
      fbA = framed('OT_ATTEST', al, id, fp(kA), h(t), cvs, pl)
      fbB = framed('OT_ATTEST', al, id, fp(kB), h(t), cvs, pl)
  in
  [ !AS1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A2s0(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
#else
rule AttestTwo_parse_mutated:
  // C-C2: the frame's =fp(k_) pin AND mh = h(t) removed, both slots
  let t   = authTuple(id, fp(kA), signers1(fp(kB)), al, ver)
      fbA = framed('OT_ATTEST', al, id, kfpxA, mhA, cvs, pl)
      fbB = framed('OT_ATTEST', al, id, kfpxB, mhB, cvs, pl)
  in
  [ !AS1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A2s0(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
#endif

rule A2_chk1_possA_H:  // checksign's first rewrite rule (honest key)
  let ppfA = sign(<'POSS', t>, skH_)
      kA = pk(skH_)
  in
  [ !A2s0(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A2s1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule A2_chk2_possB_H:  // checksign's first rewrite rule (honest key)
  let ppfB = sign(<'POSS', t>, skH_)
      kB = pk(skH_)
  in
  [ !A2s1(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A2s2(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule A2_chk3_bytesA_H:  // checksign's first rewrite rule (honest key)
  let sgA = sign(<'BYTES', fbA>, skH_)
      kA = pk(skH_)
  in
  [ !A2s2(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A2s3(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule A2_chk4_bytesB_H:  // checksign's first rewrite rule (honest key)
  let sgB = sign(<'BYTES', fbB>, skH_)
      kB = pk(skH_)
  in
  [ !A2s3(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
  -->
  [ !A2s4(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]

rule AttestTwo_accept:
  let t = authTuple(id, fpt_, sst_, alt_, vert_)
  in
  [ !A2s4(aid, lyr, ctx, fbA, sgA, fbB, sgB, t, ev, kA, ppfA, kB, ppfB) ]
--[ LayerAccepted(aid, lyr, t, ev, fp(kA), kA, ppfA, sgA, fbA),
    LayerAccepted(aid, lyr, t, ev, fp(kB), kB, ppfB, sgB, fbB),
    SlotSatisfied(aid, lyr, t, fp(kA)),
    SlotSatisfied(aid, lyr, t, fp(kB)),
    AcceptanceComplete(aid, lyr, t),
    AcceptS(ev, t, kA, fbA),
    AcceptS(ev, t, kB, fbB),
    ScopeReported(aid, lyr, kA, id) ]->
  [ !Link1a(lyr, t, ev),
    !Link2a(lyr, t, fp(kA), kA), !Link2a(lyr, t, fp(kB), kB),
    !PossCh(lyr, kA, t, ppfA), !PossCh(lyr, kB, t, ppfB),
    !BytesCh(lyr, kA, sgA, fbA), !BytesCh(lyr, kB, sgB, fbB),
    !Link5(lyr, t, kA, fbA), !Link5(lyr, t, kB, fbB),
    !Link5c(lyr, fbA, fbB),
    !Link6a(lyr, 'OT_ATTEST', fbA), !Link6a(lyr, 'OT_ATTEST', fbB),
    !Link6b(aid, lyr, kA, id, fbA),
    !TypeCh('OT_ATTEST', fbA), !TypeCh('OT_ATTEST', fbB),
    !SlotCh(t, fp(kA), kA), !SlotCh(t, fp(kB), kB),
    !SetCh(t, verified2(kA, kB)),
    !AcceptCh(ctx, 'SLOT_A', kA, id, fbA), !AcceptCh(ctx, 'SLOT_B', kB, id, fbB),
    !AcceptKey(kA, fbA), !AcceptKey(kB, fbB),
    !ScopeCh(ctx, kA, id, fbA), !ScopeCh(ctx, kB, id, fbB),
    !SigCh(ctx, kA, sgA), !SigCh(ctx, kB, sgB),
    !Gsig(kA, sgA), !Gsig(kB, sgB),
    !ChainCh(lyr, kA, t, fbA), !ChainCh(lyr, kB, t, fbB),
    !ContentCh(t, fbA, fbB),
    !ScopeEnvelope(aid, lyr, kA, id) ]

/* ==================================================================== */
/* THE WRAPPER LAYER — WrapStage(pk(skS), L0, L1) and (L1, L2)           */
/* ==================================================================== */
// UNROLLED (FIDELITY.md A11): WrapStage is instantiated for (L0,L1) and
// (L1,L2) exactly as the .pv instantiates it twice; the hand-down fact is
// per layer (!StageL0/L1/L2) so the fact graph is acyclic.  The recursive
// form (one !Stage fact) sent Tamarin's source precomputation into a
// <<loop>> / unbounded memory (REPORT.md).

// ---------------- the one-signer wrapper layer (NOT mutated) ---------
// The inner version pattern (=cvIw in fbIA) sits in the parse; in the .pv
// it comes after the signature checks, with no event or output between,
// so the order is immaterial.
// ---------------- the two-signer wrapper layer: THE MUTATION SITE ----
#ifdef CORRECT
#else
#endif

// ---------------- the one-signer wrapper layer (NOT mutated) ---------
// The inner version pattern (=cvIw in fbIA) sits in the parse; in the .pv
// it comes after the signature checks, with no event or output between,
// so the order is immaterial.
// ---------------- the two-signer wrapper layer: THE MUTATION SITE ----
#ifdef CORRECT
#else
#endif

/* ==================================================================== */
/* THE STANDING PATH (check 7), parallel to the envelope path            */
/* ==================================================================== */
// BF-5 innermost selection: proceed only where SUnwrap's pattern does NOT
// match.  APPROXIMATED (FIDELITY.md A7): "not a wrapper frame" is tested
// on the three tags only ('framed', 'OT_WRAPPER', 'wrap'), not on the
// arity of the inner 4-tuple.
rule StandingPathIn_L0:
  let t    = authTuple(idS, kfpr, ss, al, ver)
      ev   = sign(<'STMT_DIGEST', h(t)>, skS)
      core = attemptCore(t, ppfI, sgI, declS)
  in
  [ !AuthKey(skS),
    !SStageL0(intake, lyr, fbI, sgI, fbIB, sgIB),
    !StdMat(intake, lyr, t, ev, kX, ppfI, kBs, ppfBs),
    !StandCore(intake, core, se) ]
--[ Neq(<fst(fbI), fst(snd(fbI)), fst(snd(snd(snd(snd(snd(snd(snd(fbI))))))))>,
        <'framed', 'OT_WRAPPER', 'wrap'>) ]->
  [ !SP1(intake, lyr, t, kX, core, se, idS, kfpr) ]

rule Standing_S3_noTLR:
  [ !SP1(intake, lyr, t, kX, core, 'noTLR', idS, kfpr) ]
--[ StandingReport('ABSENT', 'NO_TERMINAL_DISPOSITION_EVIDENCE', kX, t, h(core)) ]->
  [ !ReasonCh('PATH_S3', 'NO_TERMINAL_DISPOSITION_EVIDENCE') ]

rule Standing_badKeyFp:
  [ !SP1(intake, lyr, t, kX, core, withTLR(kT, tlrSig, ap), idS, kfpr) ]
--[ Neq(fp(kT), kfpr),
    StandingReport('UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID', kT, t, h(core)) ]->
  [ ]

rule Standing_badKeyEq:
  [ !SP1(intake, lyr, t, kX, core, withTLR(kT, tlrSig, ap), idS, fp(kT)) ]
--[ Neq(kT, kX),
    StandingReport('UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID', kT, t, h(core)) ]->
  [ ]

// The TLR destructor's success, written as its two reduction cases
// (honest rule; dsks `otherwise` rule) because lin/terminal/declT must be
// bound in the premise.
rule Standing_tagOK:
  let tlrSig = sign(<'TLR', <lin, terminal, declT>>, skT)
  in
  [ !SP1(intake, lyr, t, pk(skT), core, withTLR(pk(skT), tlrSig, ap), idS, fp(pk(skT))) ]
  -->
  [ !TagCh(pk(skT), 'TLR'),
    !SP2(intake, lyr, t, pk(skT), core, tlrSig, ap, lin, terminal, idS) ]
rule Standing_tagOK_dsks:
  let tlrSig = sign(<'TLR', <lin, terminal, declT>>, k0)
      kT     = pk(dsks(sign(<'TLR', <lin, terminal, declT>>, k0), r))
  in
  [ !SP1(intake, lyr, t, kT, core, withTLR(kT, tlrSig, ap), idS, fp(kT)) ]
  -->
  [ !TagCh(kT, 'TLR'),
    !SP2(intake, lyr, t, kT, core, tlrSig, ap, lin, terminal, idS) ]

// APPROXIMATED (A8): else-branch of the TLR destructor tested on the tag only.
rule Standing_tagBad:
  [ !SP1(intake, lyr, t, kX, core, withTLR(kX, tlrSig, ap), idS, fp(kX)) ]
--[ Neq(fst(checksign(tlrSig, kX)), 'TLR'),
    StandingReport('UNVERIFIABLE', 'STANDING_EVIDENCE_SIGNATURE_INVALID', kX, t, h(core)) ]->
  [ ]

rule Standing_anchorBad:
  [ !SP2(intake, lyr, t, kT, core, tlrSig, ap, lin, terminal, idS) ]
--[ Neq(ap, anchorProof(h(tlrSig))),
    StandingReport('UNVERIFIABLE', 'STANDING_EVIDENCE_TEMPORAL_MISMATCH', kT, t, h(core)) ]->
  [ ]

rule Standing_lookup1:
  [ !SP2(intake, lyr, t, kT, core, tlrSig, anchorProof(h(tlrSig)),
         lineage2(entry(h(core), d1), entry(b, d2)), terminal, idS) ]
  -->
  [ !SD(kT, t, h(core), d1, terminal, intake, lyr, core, idS) ]

rule Standing_lookup2:
  [ !SP2(intake, lyr, t, kT, core, tlrSig, anchorProof(h(tlrSig)),
         lineage2(entry(a, d1), entry(h(core), d2)), terminal, idS) ]
--[ Neq(a, h(core)) ]->
  [ !SD(kT, t, h(core), d2, terminal, intake, lyr, core, idS) ]

// APPROXIMATED (A9): a lineage that is not lineage2(entry,entry) gets no
// report (the .pv's lookup2 would fail and report MISMATCH).
rule Standing_lookupMiss:
  [ !SP2(intake, lyr, t, kT, core, tlrSig, anchorProof(h(tlrSig)),
         lineage2(entry(a, d1), entry(b, d2)), terminal, idS) ]
--[ Neq(a, h(core)), Neq(b, h(core)),
    StandingReport('ABSENT', 'STANDING_EVIDENCE_MISMATCH', kT, t, h(core)) ]->
  [ ]

rule Decide_S4:
  [ !SD(kT, t, aidD, d, 'TERM_REFUSED', intake, lyr, core, idS) ]
--[ StandingReport('ABSENT', 'ISSUANCE_REFUSED', kT, t, aidD) ]->
  [ !ReasonCh('PATH_S4', 'ISSUANCE_REFUSED') ]

rule Decide_Established:
  [ !SD(kT, t, aidD, 'DISP_SHIPPED', TERM_SHIPPED(aidD), intake, lyr, core, idS) ]
--[ Established(kT, t, aidD),
    StandingReport('ESTABLISHED', 'TERMINAL_DISPOSITION_SHOWN', kT, t, aidD) ]->
  [ !EstW(intake, lyr, t, kT, core),
    !EstCh(intake, lyr, kT, t, aidD),
    !ScopeStanding(intake, lyr, kT, idS, aidD) ]

rule Decide_EstablishedWrapped:
  [ !EstW(intake, lyr, t, kT, core) ]
--[ Neq(lyr, 'L0'), EstablishedWrapped(intake, lyr, t, kT, core, 'ESTABLISHED') ]->
  [ ]

rule Decide_badDisp:
  [ !SD(kT, t, aidD, d, TERM_SHIPPED(aidD), intake, lyr, core, idS) ]
--[ Neq(d, 'DISP_SHIPPED'),
    StandingReport('UNVERIFIABLE', 'STANDING_EVIDENCE_MALFORMED', kT, t, aidD) ]->
  [ ]

rule Decide_S2:
  [ !SD(kT, t, aidD, d, TERM_SHIPPED(shippedId), intake, lyr, core, idS) ]
--[ Neq(shippedId, aidD),
    StandingReport('ABSENT', 'SUPERSEDED', kT, t, aidD) ]->
  [ !ReasonCh('PATH_S2', 'SUPERSEDED') ]

// APPROXIMATED (A10): "terminal is neither TERM_REFUSED nor TERM_SHIPPED(_)" tested on the tag.
rule Decide_badTerminal:
  [ !SD(kT, t, aidD, d, terminal, intake, lyr, core, idS) ]
--[ Neq(terminal, 'TERM_REFUSED'), Neq(fst(terminal), 'TERM_SHIPPED'),
    StandingReport('UNVERIFIABLE', 'STANDING_EVIDENCE_MALFORMED', kT, t, aidD) ]->
  [ ]

/* ==================================================================== */
/* THE JUDGES                                                            */
/* ==================================================================== */

// ---- C-Q1 link 1a: the else of BOTH destructors -------------------
rule Link1aJudge:
  [ !AuthKey(skS), !Link1a(lyr, t, ev) ]
--[ Neq(checksign(ev, pk(skS)), <'STMT_DIGEST', h(t)>),
    Neq(checksign(ev, pk(skS)), <'STMT_DIRECT', t>),
    ChainBroken(lyr, 'LINK_1A') ]->
  [ ]

// ---- C-Q1 link 2a (t is always an authTuple from a stage) ----------
rule Link2aJudge_fp:
  [ !Link2a(lyr, t, slotfp, kX) ]
--[ Neq(fp(kX), slotfp), ChainBroken(lyr, 'LINK_2A') ]-> [ ]
rule Link2aJudge_notB:
  [ !Link2a(lyr, authTuple(idJ, fpAJ, signers1(fpBJ), algJ, verJ), fp(kX), kX) ]
--[ Neq(fp(kX), fpAJ), Neq(fp(kX), fpBJ), ChainBroken(lyr, 'LINK_2A') ]-> [ ]
rule Link2aJudge_s0:
  [ !Link2a(lyr, authTuple(idJ, fpAJ, 'signers0', algJ, verJ), fp(kX), kX) ]
--[ Neq(fp(kX), fpAJ), ChainBroken(lyr, 'LINK_2A') ]-> [ ]

// ---- C-Q1 link 3 AND C-Q9 ----------------------------------------
rule PossJudge:
  [ !PossCh(lyr, kX, t, ppf) ]
--[ Neq(checksign(ppf, kX), <'POSS', t>),
    ChainBroken(lyr, 'LINK_3'), PossessionUnbound(kX, t, ppf) ]-> [ ]

// ---- C-Q1 link 4 AND C-Q8 ----------------------------------------
rule BytesJudge:
  [ !BytesCh(lyr, kX, sg, fb) ]
--[ Neq(checksign(sg, kX), <'BYTES', fb>),
    ChainBroken(lyr, 'LINK_4'), SigBytesUnbound(kX, sg, fb) ]-> [ ]

// ---- C-Q1 link 5, the FRAME-TO-KEY half --------------------------
// fb on !Link5 is always a framed(...) term (every producer parsed it),
// so the .pv's `else` is exactly "kfp <> fp(kX) or mh <> h(t)".
rule Link5Judge_kfp:
  [ !Link5(lyr, t, kX, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ)) ]
--[ Neq(kfpJ, fp(kX)), Link5FrameToKey(lyr, kX, kfpJ), ChainBroken(lyr, 'LINK_5') ]-> [ ]
rule Link5Judge_mh:
  [ !Link5(lyr, t, kX, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ)) ]
--[ Neq(mhJ, h(t)), Link5ManifestHash(lyr, t, mhJ), ChainBroken(lyr, 'LINK_5') ]-> [ ]

// ---- C-Q1 link 5, the CROSS-SLOT common-content half ---------------
rule Link5cJudge_ot:
  [ !Link5c(lyr, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]
--[ Neq(oa, ob), ChainBroken(lyr, 'LINK_5') ]-> [ ]
rule Link5cJudge_cv:
  [ !Link5c(lyr, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]
--[ Neq(ca, cb), ChainBroken(lyr, 'LINK_5') ]-> [ ]
rule Link5cJudge_pl:
  [ !Link5c(lyr, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]
--[ Neq(pa, pb), ChainBroken(lyr, 'LINK_5') ]-> [ ]

// ---- C-Q1 link 6a -------------------------------------------------
rule Link6aJudge:
  [ !Link6a(lyr, otP, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ)) ]
--[ Neq(otJ, otP), ChainBroken(lyr, 'LINK_6A') ]-> [ ]

// ---- C-Q1 link 6b -------------------------------------------------
rule Link6bJudge_k:
  [ !Link6b(aidJ, lyr, kAt, idAt, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ)) ]
--[ Neq(lyr, 'L0'), Neq(kfpJ, fp(kAt)), ChainBroken(lyr, 'LINK_6B') ]-> [ ]
rule Link6bJudge_id:
  [ !Link6b(aidJ, lyr, kAt, idAt, framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ)) ]
--[ Neq(lyr, 'L0'), Neq(idJ, idAt), ChainBroken(lyr, 'LINK_6B') ]-> [ ]

// ---- the retained S-P1 honest-key judge ----------------------------
rule JudgeH:
  [ !HonestKey(kH), !AcceptKey(kH, fbAcc) ]
--[ AcceptedUnderHonestKey(kH, fbAcc) ]-> [ ]

// ---- C-Q3: S-P3's judge, PER ROLE ----------------------------------
rule SP3Judge_honest:
  [ !HonestCh(kH, fbHon), !AcceptCh('BASE', role, kH, idX, fbHon) ]
--[ HonestAccepted(kH, fbHon) ]-> [ ]
rule SP3Judge_reA:
  [ !HonestCh(kH, fbHon), !AcceptCh(ctxJ, 'SLOT_A', kX, idX, fbHon) ]
--[ Neq(kX, kH), ReattributedA(kX, kH, fbHon) ]-> [ ]
rule SP3Judge_reB:
  [ !HonestCh(kH, fbHon), !AcceptCh(ctxJ, role, kX, idX, fbHon) ]
--[ Neq(kX, kH), Neq(role, 'SLOT_A'), ReattributedB(kX, kH, fbHon) ]-> [ ]

// ---- S-P2's SetJudge ------------------------------------------------
rule SetJudge_complete2:
  [ !HonestSet(authTuple(idJ, fp(kA), signers1(fp(kB)), algJ, verJ)),
    !SetCh(authTuple(idJ, fp(kA), signers1(fp(kB)), algJ, verJ), verified2(kA, kB)) ]
--[ HonestComplete(authTuple(idJ, fp(kA), signers1(fp(kB)), algJ, verJ), verified2(kA, kB)) ]-> [ ]
rule SetJudge_stripped:
  [ !HonestSet(authTuple(idJ, fpAJ, signers1(fpBJ), algJ, verJ)),
    !SetCh(authTuple(idJ, fpAJ, signers1(fpBJ), algJ, verJ), verified1(kA)) ]
--[ Stripped(authTuple(idJ, fpAJ, signers1(fpBJ), algJ, verJ), verified1(kA)) ]-> [ ]
rule SetJudge_complete1:
  [ !HonestSet(authTuple(idJ, fp(kA), 'signers0', algJ, verJ)),
    !SetCh(authTuple(idJ, fp(kA), 'signers0', algJ, verJ), verified1(kA)) ]
--[ HonestComplete(authTuple(idJ, fp(kA), 'signers0', algJ, verJ), verified1(kA)) ]-> [ ]

// ---- S-P2's MemberJudge ---------------------------------------------
rule MemberJudge_forged:
  [ !HonestMember(kH, mH), !SlotCh(mH, fp(kH), kUsed) ]
--[ Neq(kUsed, kH), SignerForged(mH, kUsed) ]-> [ ]
rule MemberJudge_altered:
  [ !HonestMember(kH, mH), !SlotCh(tS, fpS, kH) ]
--[ Neq(tS, mH), SetAltered(kH, mH, tS) ]-> [ ]

// ---- S-P2 Q6's ContentJudge -----------------------------------------
rule ContentJudge_ot:
  [ !ContentCh(tJ, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]
--[ Neq(oa, ob), Spliced(tJ, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]-> [ ]
rule ContentJudge_cv:
  [ !ContentCh(tJ, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]
--[ Neq(ca, cb), Spliced(tJ, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]-> [ ]
rule ContentJudge_pl:
  [ !ContentCh(tJ, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]
--[ Neq(pa, pb), Spliced(tJ, framed(oa, aa, ia, ka, ma, ca, pa), framed(ob, ab, ib, kb, mb, cb, pb)) ]-> [ ]

// ---- S-P7's TypeJudge -----------------------------------------------
rule TypeJudge:
  [ !HonestType(otS, fbT), !TypeCh(otA, fbT) ]
--[ Neq(otS, otA), TypeConfused(otS, otA, fbT) ]-> [ ]

// ---- C-Q4: S-P7's ScopeJudge ----------------------------------------
rule ScopeJudge_honest:
  [ !HonestInner(kH, idH, fbHon), !ScopeCh(wctx(kWj, idWj, fbWj), kH, idH, fbHon) ]
--[ HonestWrappedAccepted(kH, fbHon, kWj) ]-> [ ]
rule ScopeJudge_k:
  [ !HonestInner(kH, idH, fbHon), !ScopeCh(wctx(kWj, idWj, fbWj), kIrep, idIrep, fbHon) ]
--[ Neq(kIrep, kH), Rescoped(kIrep, idIrep, kH, idH, fbHon) ]-> [ ]
rule ScopeJudge_id:
  [ !HonestInner(kH, idH, fbHon), !ScopeCh(wctx(kWj, idWj, fbWj), kIrep, idIrep, fbHon) ]
--[ Neq(idIrep, idH), Rescoped(kIrep, idIrep, kH, idH, fbHon) ]-> [ ]

// ---- C-Q4: S-P7's SigJudge ------------------------------------------
rule SigJudge:
  [ !HonestSig(kH, sgH), !SigCh(wctx(kWj, idWj, fbWj), kIrep, sgH) ]
--[ Neq(kIrep, kH), InnerSigTransplanted(kIrep, sgH) ]-> [ ]

// ---- C-Q7 -----------------------------------------------------------
rule GenericSigJudge:
  [ !GsigHon(kH, sgH), !Gsig(kX, sgH) ]
--[ Neq(kX, kH), SigTransplanted(kX, sgH) ]-> [ ]

// ---- the retained S-P7 VersionJudge -------------------------------
rule VersionJudge:
  [ !VersionCh(fbWv, cvIwv, framed(otJv, algJv, idJv, kfpJv, mhJv, cvI, plJv)) ]
--[ Neq(cvIwv, cvI), VersionLied(fbWv, cvIwv, cvI) ]-> [ ]

// ---- C-N1: the HonestChain witness ---------------------------------
rule ChainWitnessJudge:
  [ !HonestChainCh(kH, mH, fbHon), !ChainCh(lyr, kH, mH, fbHon) ]
--[ HonestChain(lyr, mH) ]-> [ ]

// ---- C-Q6 conjunct 2 and the honest standing witness ---------------
rule StandingJudge_unentitled:
  [ !EstCh(intake, lyr, kX, authTuple(idJ, kfprJ, ssJ, algJ, verJ), aidD) ]
--[ Neq(fp(kX), kfprJ), Neq(lyr, 'L0'),
    StandingUnentitledWrapped(kX, authTuple(idJ, kfprJ, ssJ, algJ, verJ)) ]-> [ ]
rule StandingJudge_honest:
  [ !EstCh(intake, lyr, kX, authTuple(idJ, fp(kX), ssJ, algJ, verJ), aidD), !Design(kX, aidD) ]
--[ Neq(lyr, 'L0'), HonestStandingEstablished(kX, aidD) ]-> [ ]

// ---- C-Q6 conjunct 3 and the two isolation observers ---------------
rule ScopeAgreement_mis:
  [ !ScopeStanding(a, l, k, idS, derived), !ScopeEnvelope(a, l, ka, ia) ]
--[ Neq(<ka, ia>, <k, idS>), ScopeMisreported(a, l, k, idS, ka, ia) ]-> [ ]
rule ScopeAgreement_agree:
  [ !ScopeStanding(a, l, k, idS, derived), !ScopeEnvelope(a, l, k, idS), !Design(k, derived) ]
--[ Neq(l, 'L0'), HonestWrappedStandingAgreed(a, l) ]-> [ ]
rule ScopeKeyOnly:
  [ !ScopeStanding(a, l, k, idS, derived), !ScopeEnvelope(a, l, ka, ia) ]
--[ Neq(ka, k), ScopeKeyOnly(a, l, k, ka) ]-> [ ]
rule ScopeIdentityOnly:
  [ !ScopeStanding(a, l, k, idS, derived), !ScopeEnvelope(a, l, ka, ia) ]
--[ Neq(ia, idS), ScopeIdentityOnly(a, l, idS, ia) ]-> [ ]

// ---- C-Q10 ----------------------------------------------------------
rule TagJudge:
  [ !TagCh(kJ, tagJ) ]
--[ Neq(tagJ, 'TLR'), TagConfused(kJ, tagJ) ]-> [ ]

/* ==================================================================== */
/* LEMMAS                                                                */
/* ==================================================================== */
// --- C-C2's registered (d) red set (1) -------------------------------
// C-Q3, per role.  Registered RED in the companion; GREEN in the correct form.
lemma CQ3_ReattributedA:
  "not (Ex kX kH fb #i. ReattributedA(kX, kH, fb) @ #i)"
lemma CQ3_ReattributedB:
  "not (Ex kX kH fb #i. ReattributedB(kX, kH, fb) @ #i)"
// C-Q1 link 5 (the registered query is the whole ChainBroken(l, LINK_5);
// the frame-to-key half is the one in set (1)).
lemma Link5:
  "not (Ex l #i. ChainBroken(l, 'LINK_5') @ #i)"
// The frame-to-key half alone (instrumentation event, not a .pv query).
lemma Link5_frameToKey_only:
  "not (Ex l k f #i. Link5FrameToKey(l, k, f) @ #i)"

// --- the query ProVerif stalled on (predicted GREEN, not in set (1)) --
lemma Link1a:
  "not (Ex l #i. ChainBroken(l, 'LINK_1A') @ #i)"

// --- sanity anchors ----------------------------------------------------
// A4.6 registered red in (d), BOTH forms: unrestricted AcceptS ==> IssuerSigned.
lemma A46_AcceptS_IssuerSigned:
  "All ev t k fb #i. AcceptS(ev, t, k, fb) @ #i ==> (Ex #j. IssuerSigned(k, fb) @ #j & #j < #i)"
// C-N1 witnesses (must be REACHABLE in both forms).
lemma W_HonestAccepted: exists-trace
  "Ex k fb #i. HonestAccepted(k, fb) @ #i"
lemma W_HonestChain_L0: exists-trace
  "Ex t #i. HonestChain('L0', t) @ #i"
lemma W_HonestChain_L1: exists-trace
  "Ex t #i. HonestChain('L1', t) @ #i"
lemma W_HonestComplete2: exists-trace
  "Ex t a b #i. HonestComplete(t, <'verified2', a, b>) @ #i"

end
