(* TOY syntax check only: two-event reachability (witness). Not derived from any capstone file. *)
free c: channel.
type key.
event Std(bitstring, key).
event Acc(bitstring, key).
query a: bitstring, k1: key; event(Std(a, k1)) && event(Acc(a, k1)).
process
  ( in(c, (k: key)); new a: bitstring; event Std(a, k); event Acc(a, k) )
