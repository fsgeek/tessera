(* ==================================================================== *)
(* ==== THE FIXTURE'S HONEST PROCESSES (§1.1) ========================= *)
(* ==================================================================== *)

(* --- the two authority channels, strict form (D-1, digest binding) --- *)
let AuthorityS(skSp: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT_DIGEST, h(t)), skSp)).

(* --- an honest attester: ONE KEY, ONE MANIFEST (§1.1) ---------------- *)
let Attester(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, payload: bitstring);
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, fp(pk(sk))), sk) in
  out(c, ppf);
  let fb = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, payload) in
  let sg = sign((BYTES, fb), sk) in
  event IssuerSigned(pk(sk), fb);
  ( out(honestTypeCh, (OT_ATTEST, fb))
  | out(honestCh, (pk(sk), fb))
  | out(honestInnerCh, (pk(sk), id, fb))
  | out(honestSigCh, (pk(sk), sg))
  | out(gsigHonCh, (pk(sk), sg))
  | out(honestChainCh, (pk(sk), m, fb))
  | out(c, sg) ).

(* --- an honest issuer with a two-entry lineage: S-STANDING's          *)
(* ShipIssuer, emitting the honest reports an Attester does for both    *)
(* attempts, so the composed judges can pair with them.                 *)
let ShipIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, (p1: bitstring, p2: bitstring));
  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, fp(pk(sk))), sk) in
  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
  let sg1 = sign((BYTES, fb1), sk) in
  let core1 = attemptCore(m, ppf, sg1, decl1) in
  event IssuerSigned(pk(sk), fb1);
  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
  let sg2 = sign((BYTES, fb2), sk) in
  let core2 = attemptCore(m, ppf, sg2, decl2) in
  event IssuerSigned(pk(sk), fb2);
  event Designated(pk(sk), h(core2));
  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_SHIPPED)),
              TERM_SHIPPED(h(core2)), declT) in
  ( out(c, ppf)
  | out(c, (core1, fb1, sg1))
  | out(c, (core2, fb2, sg2))
  | out(designCh, (pk(sk), h(core2)))
  | out(c, sign((TLR, body), sk))
  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).

(* --- the second terminal disposition: both attempts abandoned -------- *)
let RefuseIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, (p1: bitstring, p2: bitstring));
  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, fp(pk(sk))), sk) in
  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
  let sg1 = sign((BYTES, fb1), sk) in
  let core1 = attemptCore(m, ppf, sg1, decl1) in
  event IssuerSigned(pk(sk), fb1);
  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
  let sg2 = sign((BYTES, fb2), sk) in
  let core2 = attemptCore(m, ppf, sg2, decl2) in
  event IssuerSigned(pk(sk), fb2);
  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_ABANDONED)),
              TERM_REFUSED, declT) in
  ( out(c, ppf)
  | out(c, (core1, fb1, sg1))
  | out(c, (core2, fb2, sg2))
  | out(c, sign((TLR, body), sk))
  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).

(* --- an honest wrapper: frames an adversary-chosen inner blob -------- *)
let Wrapper(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, (cvIw: bitstring, fbIA: bitstring, sgIA: bitstring,
         fbIB: bitstring, sgIB: bitstring));
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, fp(pk(sk))), sk) in
  out(c, ppf);
  let fb = framed(OT_WRAPPER, algH, id, fp(pk(sk)), h(m), cv,
                  wrap(cvIw, (fbIA, sgIA, fbIB, sgIB))) in
  let sg = sign((BYTES, fb), sk) in
  event IssuerSigned(pk(sk), fb);
  ( out(honestTypeCh, (OT_WRAPPER, fb))
  | out(honestCh, (pk(sk), fb))
  | out(honestChainCh, (pk(sk), m, fb))
  | out(gsigHonCh, (pk(sk), sg))
  | out(c, sg) ).

(* --- the FOREIGN-TAG SIGNER (§1.1, AMENDMENT 2026-09-18) ------------- *)
(* The honest issuer key emits sign((REFUSAL, body), skI) for an         *)
(* adversary-chosen core, body a TLR-shaped triple. It is a FOREIGN-TAG  *)
(* SOURCE and nothing else: its body is opaque to every check while the  *)
(* tag check stands, and chosen TLR-shaped as the worst case for         *)
(* separation. It models NOTHING about the refusal record (A3 §A3.7.2,   *)
(* L2-n, BAND0-EXIT E6). REFUSAL is exercised as a signing DOMAIN and    *)
(* unexercised as a RECORD. Copied from the 2026-09-06 reviewer fixture  *)
(* a_foreign_tag.pv:339-342.                                             *)
let ForeignIssuer(sk: skey) =
  in(c, foreignCore: bitstring);
  let body = (lineage2(entry(h(foreignCore), DISP_SHIPPED), entry(fbH, DISP_ABANDONED)),
              TERM_SHIPPED(h(foreignCore)), fbH) in
  out(c, sign((REFUSAL, body), sk)).

(* ==================================================================== *)
(* ==== THE FRONT END: one fresh aid per PRESENTATION, at INTAKE ====== *)
(* (§1.3). It reads the presented bundle once and forwards it on private *)
(* channels to the envelope path and the standing path IN PARALLEL       *)
(* (§1.2 "parallel to, never sequenced behind"; encoding rule (1)).      *)
(* The name exists BEFORE any check runs, so a path may carry it without *)
(* thereby asserting that the other path succeeded.                      *)
(* ==================================================================== *)
let Front =
  (* ONE read of the presented bundle: the frames and signatures of the
     outermost object, the per-layer verification material for L0, L1 and L2,
     and the standing path's core and standing evidence.  Everything a path
     uses below comes from THIS read.                                          *)
  in(c, (fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring,
         t0: bitstring, ev0: bitstring,
         kA0: pkey, ppfA0: bitstring, kB0: pkey, ppfB0: bitstring,
         t1: bitstring, ev1: bitstring,
         kA1: pkey, ppfA1: bitstring, kB1: pkey, ppfB1: bitstring,
         t2: bitstring, ev2: bitstring,
         kA2: pkey, ppfA2: bitstring, kB2: pkey, ppfB2: bitstring,
         coreIn: bitstring, seIn: bitstring));
  new aid: bitstring;
  ( out(stageCh,  (aid, L0, BASE, kNone, idAdv, fbA, sgA, fbB, sgB))
  | out(sStageCh, (aid, L0, fbA, sgA, fbB, sgB))
  | !out(envMat, (aid, L0, t0, ev0, kA0, ppfA0, kB0, ppfB0))
  | !out(envMat, (aid, L1, t1, ev1, kA1, ppfA1, kB1, ppfB1))
  | !out(envMat, (aid, L2, t2, ev2, kA2, ppfA2, kB2, ppfB2))
  | !out(stdMat, (aid, L0, t0, ev0, kA0, ppfA0, kB0, ppfB0))
  | !out(stdMat, (aid, L1, t1, ev1, kA1, ppfA1, kB1, ppfB1))
  | !out(stdMat, (aid, L2, t2, ev2, kA2, ppfA2, kB2, ppfB2))
  | !out(standCore, (aid, coreIn, seIn)) ).

(* ==================================================================== *)
(* ==== THE ENVELOPE PATH: one acceptance path per layer (§1.2) ======= *)
(*                                                                      *)
(* AttestStage is the capstone's InnerCheck: it accepts ONE layer whose  *)
(* object type is OT_ATTEST, with the layer index carried on stageCh.    *)
(* It is SHARED by the base path (L0) and by the innermost layer of a    *)
(* wrapped presentation (L1 at depth 1, L2 at depth 2), exactly as       *)
(* S-P7's InnerCheck is shared by VerifierBase and VerifierWrapped.      *)
(*                                                                      *)
(* Checks, in §1.2's order:                                             *)
(*  1 accepted authority evidence, per channel, checksign(ev,kCh) =     *)
(*    (STMT_DIGEST, h(t))                            [S-P1 / first link] *)
(*  2 key binding: the frame's kfp is fp(kX), and mh = h(t)     [S-P3]   *)
(*  3 set logic: the signed t's required set names the slot,            *)
(*    fp(kX) = kfpr, every required slot satisfied              [S-P2]   *)
(*  4 common content: ota = otb, cva = cvb, pla = plb, plus alg, id     *)
(*    pinned through t                                       [S-P2 Q6]   *)
(*  5 type, opacity and recorded-version checks                 [S-P7]   *)
(*  6 possession over the ACCEPTED MANIFEST under the ACCEPTING KEY,    *)
(*    checksign(ppf,kX) = (POSS,t)                       [S-P3 / S-P2]   *)
(* (7 is the standing path, which runs in parallel — below.)            *)
(* ==================================================================== *)
let AttestStage(pkSv: pkey) =
  in(stageCh, (aid: bitstring, lyr: bitstring, ctx: bitstring,
               kEnc: pkey, idEnc: bitstring,
               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
  in(envMat, (=aid, =lyr, t: bitstring, ev: bitstring,
              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
  (* CHECK 1 *)
  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in
  event AuthorityEvidence(t, ev, pkSv);
  let authTuple(id, kfprA, ss, alg, ver) = t in
  ( (* ---------------- the one-signer branch ---------------- *)
    ( if ss = signers0 then
      if fp(kA) = kfprA then                                            (* 3 *)
      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
      if otA = OT_ATTEST then                                           (* 5 *)
      let (=POSS, =fp(kA)) = checksign(ppfA, kA) in                          (* 6 *)
      let (=BYTES, =fbA) = checksign(sgA, kA) in
      event LayerAccepted(aid, lyr, t, ev, kfprA, kA, ppfA, sgA, fbA);
      event SlotSatisfied(aid, lyr, t, kfprA);
      event AcceptanceComplete(aid, lyr, t);
      event AcceptS(ev, t, kA, fbA);
      event ScopeReported(aid, lyr, kA, id);
      ( out(link1aCh, (lyr, t, ev))
      | out(link2aCh, (lyr, t, kfprA, kA))
      | out(possCh, (lyr, kA, t, ppfA))
      | out(bytesCh, (lyr, kA, sgA, fbA))
      | out(link5Ch, (lyr, t, kA, fbA))
      | out(link6aCh, (lyr, OT_ATTEST, fbA))
      | out(link6bCh, (aid, lyr, kA, id, fbA))
      | out(typeCh, (OT_ATTEST, fbA))
      | out(slotCh, (t, kfprA, kA))
      | out(setCh, (t, verified1(kA)))
      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
      | out(acceptKeyCh, (kA, fbA))
      | out(scopeCh, (ctx, kA, id, fbA))
      | out(sigCh, (ctx, kA, sgA))
      | out(gsigCh, (kA, sgA))
      | out(chainCh, (lyr, kA, t, fbA))
      | out(scopeEnvelope, (aid, lyr, kA, id)) ) )
  | (* ---------------- the two-signer branch ---------------- *)
    ( let signers1(kfprB) = ss in
      if fp(kA) = kfprA then                                            (* 3 *)
      if fp(kB) = kfprB then                                            (* 3 *)
      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
      let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in      (* 2 *)
      if otA = OT_ATTEST then                                           (* 5 *)
      if otB = OT_ATTEST then                                           (* 5 *)
      if otA = otB then                                                 (* 4 *)
      if cvsA = cvsB then                                               (* 4 *)
      if plA = plB then                                                 (* 4 *)
      let (=POSS, =fp(kA)) = checksign(ppfA, kA) in                          (* 6 *)
      let (=POSS, =fp(kB)) = checksign(ppfB, kB) in                          (* 6 *)
      let (=BYTES, =fbA) = checksign(sgA, kA) in
      let (=BYTES, =fbB) = checksign(sgB, kB) in
      event LayerAccepted(aid, lyr, t, ev, kfprA, kA, ppfA, sgA, fbA);
      event LayerAccepted(aid, lyr, t, ev, kfprB, kB, ppfB, sgB, fbB);
      event SlotSatisfied(aid, lyr, t, kfprA);
      event SlotSatisfied(aid, lyr, t, kfprB);
      event AcceptanceComplete(aid, lyr, t);
      event AcceptS(ev, t, kA, fbA);
      event AcceptS(ev, t, kB, fbB);
      event ScopeReported(aid, lyr, kA, id);
      ( out(link1aCh, (lyr, t, ev))
      | out(link2aCh, (lyr, t, kfprA, kA)) | out(link2aCh, (lyr, t, kfprB, kB))
      | out(possCh, (lyr, kA, t, ppfA)) | out(possCh, (lyr, kB, t, ppfB))
      | out(bytesCh, (lyr, kA, sgA, fbA)) | out(bytesCh, (lyr, kB, sgB, fbB))
      | out(link5Ch, (lyr, t, kA, fbA)) | out(link5Ch, (lyr, t, kB, fbB))
      | out(link5cCh, (lyr, fbA, fbB))
      | out(link6aCh, (lyr, OT_ATTEST, fbA)) | out(link6aCh, (lyr, OT_ATTEST, fbB))
      | out(link6bCh, (aid, lyr, kA, id, fbA))
      | out(typeCh, (OT_ATTEST, fbA)) | out(typeCh, (OT_ATTEST, fbB))
      | out(slotCh, (t, kfprA, kA)) | out(slotCh, (t, kfprB, kB))
      | out(setCh, (t, verified2(kA, kB)))
      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
      | out(acceptCh, (ctx, SLOT_B, kB, id, fbB))
      | out(acceptKeyCh, (kA, fbA)) | out(acceptKeyCh, (kB, fbB))
      | out(scopeCh, (ctx, kA, id, fbA)) | out(scopeCh, (ctx, kB, id, fbB))
      | out(sigCh, (ctx, kA, sgA)) | out(sigCh, (ctx, kB, sgB))
      | out(gsigCh, (kA, sgA)) | out(gsigCh, (kB, sgB))
      | out(chainCh, (lyr, kA, t, fbA)) | out(chainCh, (lyr, kB, t, fbB))
      | out(contentCh, (t, fbA, fbB))
      | out(scopeEnvelope, (aid, lyr, kA, id)) ) ) ).

(* ==================================================================== *)
(* ==== THE WRAPPER LAYER (S-P7's outer check, per layer) ============= *)
(* Checks the outer object as the attestation path would, with          *)
(* objType = OT_WRAPPER; checks the recorded inner canonicalization     *)
(* version (A5.5); then hands the inner blob to the NEXT layer on       *)
(* stageCh, with the context wctx(this wrapper's key, id, bytes).       *)
(* Instantiated twice — (L0 -> L1) and (L1 -> L2) — which is what       *)
(* bounds the depth at 2 (L-13's named scoping).                        *)
(* ==================================================================== *)
let WrapStage(pkSv: pkey, lyrIn: bitstring, lyrOut: bitstring) =
  in(stageCh, (aid: bitstring, =lyrIn, ctx: bitstring,
               kEnc: pkey, idEnc: bitstring,
               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
  in(envMat, (=aid, =lyrIn, t: bitstring, ev: bitstring,
              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in
  event AuthorityEvidence(t, ev, pkSv);
  let authTuple(id, kfprA, ss, alg, ver) = t in
  ( (* ---------------- the one-signer wrapper layer ---------------- *)
    ( if ss = signers0 then
      if fp(kA) = kfprA then
      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA,
                 wrap(cvIw: bitstring, (fbIA: bitstring, sgIA: bitstring,
                                        fbIB: bitstring, sgIB: bitstring))) = fbA in
      if otA = OT_WRAPPER then
      let (=POSS, =fp(kA)) = checksign(ppfA, kA) in
      let (=BYTES, =fbA) = checksign(sgA, kA) in
      let framed(otIv, algIv, idIv, kfpIv, mhIv, =cvIw, plIv) = fbIA in
      event LayerAccepted(aid, lyrIn, t, ev, kfprA, kA, ppfA, sgA, fbA);
      event SlotSatisfied(aid, lyrIn, t, kfprA);
      event AcceptanceComplete(aid, lyrIn, t);
      event AcceptS(ev, t, kA, fbA);
      event ScopeReported(aid, lyrIn, kA, id);
      ( out(link1aCh, (lyrIn, t, ev))
      | out(link2aCh, (lyrIn, t, kfprA, kA))
      | out(possCh, (lyrIn, kA, t, ppfA))
      | out(bytesCh, (lyrIn, kA, sgA, fbA))
      | out(link5Ch, (lyrIn, t, kA, fbA))
      | out(link6aCh, (lyrIn, OT_WRAPPER, fbA))
      | out(link6bCh, (aid, lyrIn, kA, id, fbA))
      | out(typeCh, (OT_WRAPPER, fbA))
      | out(slotCh, (t, kfprA, kA))
      | out(setCh, (t, verified1(kA)))
      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
      | out(acceptKeyCh, (kA, fbA))
      | out(gsigCh, (kA, sgA))
      | out(chainCh, (lyrIn, kA, t, fbA))
      | out(versionCh, (fbA, cvIw, fbIA))
      | out(scopeEnvelope, (aid, lyrIn, kA, id))
      | out(stageCh, (aid, lyrOut, wctx(kA, id, fbA), kA, id,
                      fbIA, sgIA, fbIB, sgIB)) ) )
  | (* ---------------- the two-signer wrapper layer ---------------- *)
    ( let signers1(kfprB) = ss in
      if fp(kA) = kfprA then
      if fp(kB) = kfprB then
      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA,
                 wrap(cvIw: bitstring, (fbIA: bitstring, sgIA: bitstring,
                                        fbIB: bitstring, sgIB: bitstring))) = fbA in
      let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in
      if otA = OT_WRAPPER then
      if otB = OT_WRAPPER then
      if otA = otB then
      if cvsA = cvsB then
      if wrap(cvIw, (fbIA, sgIA, fbIB, sgIB)) = plB then
      let (=POSS, =fp(kA)) = checksign(ppfA, kA) in
      let (=POSS, =fp(kB)) = checksign(ppfB, kB) in
      let (=BYTES, =fbA) = checksign(sgA, kA) in
      let (=BYTES, =fbB) = checksign(sgB, kB) in
      let framed(otIv, algIv, idIv, kfpIv, mhIv, =cvIw, plIv) = fbIA in
      event LayerAccepted(aid, lyrIn, t, ev, kfprA, kA, ppfA, sgA, fbA);
      event LayerAccepted(aid, lyrIn, t, ev, kfprB, kB, ppfB, sgB, fbB);
      event SlotSatisfied(aid, lyrIn, t, kfprA);
      event SlotSatisfied(aid, lyrIn, t, kfprB);
      event AcceptanceComplete(aid, lyrIn, t);
      event AcceptS(ev, t, kA, fbA);
      event AcceptS(ev, t, kB, fbB);
      event ScopeReported(aid, lyrIn, kA, id);
      ( out(link1aCh, (lyrIn, t, ev))
      | out(link2aCh, (lyrIn, t, kfprA, kA)) | out(link2aCh, (lyrIn, t, kfprB, kB))
      | out(possCh, (lyrIn, kA, t, ppfA)) | out(possCh, (lyrIn, kB, t, ppfB))
      | out(bytesCh, (lyrIn, kA, sgA, fbA)) | out(bytesCh, (lyrIn, kB, sgB, fbB))
      | out(link5Ch, (lyrIn, t, kA, fbA)) | out(link5Ch, (lyrIn, t, kB, fbB))
      | out(link5cCh, (lyrIn, fbA, fbB))
      | out(link6aCh, (lyrIn, OT_WRAPPER, fbA)) | out(link6aCh, (lyrIn, OT_WRAPPER, fbB))
      | out(link6bCh, (aid, lyrIn, kA, id, fbA))
      | out(typeCh, (OT_WRAPPER, fbA)) | out(typeCh, (OT_WRAPPER, fbB))
      | out(slotCh, (t, kfprA, kA)) | out(slotCh, (t, kfprB, kB))
      | out(setCh, (t, verified2(kA, kB)))
      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
      | out(acceptCh, (ctx, SLOT_B, kB, id, fbB))
      | out(acceptKeyCh, (kA, fbA)) | out(acceptKeyCh, (kB, fbB))
      | out(gsigCh, (kA, sgA)) | out(gsigCh, (kB, sgB))
      | out(chainCh, (lyrIn, kA, t, fbA)) | out(chainCh, (lyrIn, kB, t, fbB))
      | out(contentCh, (t, fbA, fbB))
      | out(versionCh, (fbA, cvIw, fbIA))
      | out(scopeEnvelope, (aid, lyrIn, kA, id))
      | out(stageCh, (aid, lyrOut, wctx(kA, id, fbA), kA, id,
                      fbIA, sgIA, fbIB, sgIB)) ) ) ).

(* ==================================================================== *)
(* ==== THE STANDING PATH (check 7), PARALLEL to the envelope path ==== *)
(*                                                                      *)
(* (E1) SAME PRESENTATION: the standing path computes over the          *)
(* innermost (t, ppf, sg, fb) that IT extracts STRUCTURALLY, ITSELF,    *)
(* from the same bundle the front-end forwarded to it, under the same   *)
(* intake aid. It neither waits for nor is conditioned on               *)
(* LayerAccepted: no event of the envelope path, and no success of it,  *)
(* is a precondition of EstablishedWrapped.                             *)
(* (E2) SAME CORE: core = attemptCore(t, ppf, sg, decl) for exactly the *)
(* t, ppf and sg of (E1) — the five term equalities of §3 C-Q6 (3),     *)
(* which are IMMUTABLE and define the join.                             *)
(* (E3) DERIVED IDENTITY: h(core), derived, never read from the bundle. *)
(* (E4) WRAPPED: lyr <> L0, from the structural parse below.            *)
(* (E5 was WITHDRAWN from the emission contract and lives only as       *)
(* check 7's entitled-key comparison, which C-C12 removes.)             *)
(* ==================================================================== *)

(* the standing path's OWN structural unwrapping — no verifier check,   *)
(* no signature, no authority: S-P7's wrap() destructuring performed on *)
(* the standing path's own copy of the bundle.                          *)
let SUnwrap(lyrIn: bitstring, lyrOut: bitstring) =
  in(sStageCh, (aid: bitstring, =lyrIn, fbA: bitstring, sgA: bitstring,
                fbB: bitstring, sgB: bitstring));
  let framed(=OT_WRAPPER, awz, iwz, kwz, mwz, cwz,
             wrap(cwi, (fbIA: bitstring, sgIA: bitstring,
                        fbIB: bitstring, sgIB: bitstring))) = fbA in
  out(sStageCh, (aid, lyrOut, fbIA, sgIA, fbIB, sgIB)).

(* lineage lookup over the two-entry structure (S-STANDING, verbatim) *)
fun lookup2(bitstring, bitstring): bitstring
  reduc forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
          lookup2(a, lineage2(entry(a, d1), entry(b, d2))) = d1
  otherwise forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
          lookup2(b, lineage2(entry(a, d1), entry(b, d2))) = d2.

let StandingDecide(kT: pkey, t: bitstring, aidD: bitstring, d: bitstring,
                   terminal: bitstring, intake: bitstring, lyr: bitstring,
                   core: bitstring, idS: bitstring) =
  if terminal = TERM_REFUSED then
    ( event StandingReport(ABSENT, ISSUANCE_REFUSED, kT, t, aidD);       (* S4 *)
      out(reasonCh, (PATH_S4, ISSUANCE_REFUSED)) )
  else
    ( let TERM_SHIPPED(shippedId) = terminal in
      ( if shippedId = aidD then
          ( if d = DISP_SHIPPED then
              ( event Established(kT, t, aidD);
                event StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, kT, t, aidD);
                ( ( if lyr <> L0 then
                      event EstablishedWrapped(intake, lyr, t, kT, core, ESTABLISHED) )
                | out(estCh, (intake, lyr, kT, t, aidD))
                | out(scopeStanding, (intake, lyr, kT, idS, aidD)) ) )
            else
              event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aidD) )
        else
          ( event StandingReport(ABSENT, SUPERSEDED, kT, t, aidD);       (* S2 *)
            out(reasonCh, (PATH_S2, SUPERSEDED)) ) )
      else
        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aidD) ).

let StandingPath(pkSv: pkey) =
  in(sStageCh, (intake: bitstring, lyr: bitstring, fbI: bitstring, sgI: bitstring,
                fbIB: bitstring, sgIB: bitstring));
  (* BF-5 REPAIR 2026-10-01 -- STRUCTURAL SELECTION OF THE INNERMOST LAYER.
     Registered: lyr "For C-Q6 ... is the **innermost** layer of the wrapped
     presentation" (PREDICTIONS.md:782); "(E4) Wrapped. lyr <> L0; at depth 2
     the innermost layer is L2" (:939-940); the wrapped flag is "the
     front-end's structural parse of the outer frame -- an OT_WRAPPER frame
     whose payload field is a wrap() term" (:942-944); and (E1) the standing
     path "computes over the innermost (t, ppf, sg, fb) that it extracts
     structurally, itself" (:892-894).  So a layer is innermost exactly when
     that SAME parse does NOT match its frame -- i.e. SUnwrap would not descend
     from it.  This is the complement of SUnwrap's own pattern and nothing
     more: no type check, no signature, no authority, and no envelope event or
     success (E1).  Before this repair StandingPath consumed every layer
     SUnwrap reached, so standing could establish at an intermediate wrapper
     (review finding 2, dev/codex/scratch/capstone_d_noninnermost_attest.out
     :3010).                                                                 *)
  let framed(=OT_WRAPPER, awi, iwi, kwi, mwi, cwi,
             wrap(cwii, (fbNA: bitstring, sgNA: bitstring,
                         fbNB: bitstring, sgNB: bitstring))) = fbI in 0
  else
  in(stdMat, (=intake, =lyr, t: bitstring, ev: bitstring,
              kX: pkey, ppfI: bitstring, kBs: pkey, ppfBs: bitstring));
  in(standCore, (=intake, core: bitstring, se: bitstring));
  (* (E2), and the five immutable term equalities of §3 C-Q6 (3):
     t = tI, ppf = ppfI, sg = sgI (a TERM equality, not a verification
     equality — this is what denies the D-4 dsks route a second
     (key, signature) pairing), fb = fbI, kX = kI.                       *)
  let attemptCore(=t, =ppfI, =sgI, declS) = core in
  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in
  let authTuple(idS, kfpr, ss, alg, ver) = t in
  let aidD = h(core) in                                            (* (E3) *)
  if se = noTLR then
    ( event StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, kX, t, aidD);
      out(reasonCh, (PATH_S3, NO_TERMINAL_DISPOSITION_EVIDENCE)) )       (* S3 *)
  else
    ( let withTLR(kT, tlrSig, ap) = se in
      (* CHECK 7, the entitled-key comparison: the TLR key is the key the
         evidenced tuple names.  C-C12 removes `fp(kT) = kfpr` ONLY and
         RETAINS `kT = kX`.                                              *)
      if fp(kT) = kfpr then
        ( if kT = kX then
          (* the D-6 TLR TAG CHECK — the check C-C18 unbinds *)
          let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) =
                checksign(tlrSig, kT) in
            ( out(tagCh, (kT, TLR))
            | ( let anchorProof(=h(tlrSig)) = ap in
                  ( let d = lookup2(aidD, lin) in
                      StandingDecide(kT, t, aidD, d, terminal, intake, lyr, core, idS)
                    else
                      event StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, kT, t, aidD) )
                else
                  event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_TEMPORAL_MISMATCH, kT, t, aidD) ) )
          else
            event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) )
      else
        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) ).

(* ==================================================================== *)
(* ==== THE JUDGES (private channels; never verifier checks) ========== *)
(* ==================================================================== *)

(* ---- C-Q1 link 1a: each carried evidence term verifies over the
        consumed t under its OWN channel key, INCLUDING the case where a
        carried term does not verify at all (the destructor's else).     *)
let Link1aJudge(pkSv: pkey) =
  in(link1aCh, (lyr: bitstring, t: bitstring, ev: bitstring));
  ( let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in 0
    else ( let (=STMT_DIRECT, =t) = checksign(ev, pkSv) in 0
           else event ChainBroken(lyr, LINK_1A) ) ).

(* ---- C-Q1 link 2a: t's signer set names slot, and fp(kX) = slot ----- *)
let Link2aJudge =
  in(link2aCh, (lyr: bitstring, t: bitstring, slotfp: bitstring, kX: pkey));
  ( let authTuple(idJ, fpAJ, ssJ, algJ, verJ) = t in
      ( if fp(kX) <> slotfp then event ChainBroken(lyr, LINK_2A)
        else
          ( if slotfp = fpAJ then 0
            else
              ( let signers1(fpBJ) = ssJ in
                  ( if slotfp = fpBJ then 0 else event ChainBroken(lyr, LINK_2A) )
                else event ChainBroken(lyr, LINK_2A) ) ) )
    else event ChainBroken(lyr, LINK_2A) ).

(* ---- C-Q1 link 3 AND C-Q9: the possession message over the accepted
        manifest under the accepting key. One relation, two registered
        names (§9, "link 3's relation IS C-Q9's").                       *)
let PossJudge =
  in(possCh, (lyr: bitstring, kX: pkey, t: bitstring, ppf: bitstring));
  let (=POSS, =t) = checksign(ppf, kX) in 0
  else ( event ChainBroken(lyr, LINK_3) | event PossessionUnbound(kX, t, ppf) ).

(* ---- C-Q1 link 4 AND C-Q8: the signature over the PRESENTED bytes.
        No honest-signature filter; fires including the case where sg
        does not verify under kX at all.                                 *)
let BytesJudge =
  in(bytesCh, (lyr: bitstring, kX: pkey, sg: bitstring, fb: bitstring));
  let (=BYTES, =fb) = checksign(sg, kX) in 0
  else ( event ChainBroken(lyr, LINK_4) | event SigBytesUnbound(kX, sg, fb) ).

(* ---- C-Q1 link 5, the frame-to-key half ---------------------------- *)
let Link5Judge =
  in(link5Ch, (lyr: bitstring, t: bitstring, kX: pkey, fb: bitstring));
  let framed(otJ, algJ, idJ, =fp(kX), =h(t), cvJ, plJ) = fb in 0
  else event ChainBroken(lyr, LINK_5).

(* ---- C-Q1 link 5, the CROSS-SLOT common-content half (D7's
        common-content consumer, the three §A5.4 guards)                 *)
let Link5cJudge =
  in(link5cCh, (lyr: bitstring, fbA: bitstring, fbB: bitstring));
  let framed(otaJ, algaJ, idaJ, kfpaJ, mhaJ, cvaJ, plaJ) = fbA in
  let framed(otbJ, algbJ, idbJ, kfpbJ, mhbJ, cvbJ, plbJ) = fbB in
  if otaJ <> otbJ || cvaJ <> cvbJ || plaJ <> plbJ then
  event ChainBroken(lyr, LINK_5).

(* ---- C-Q1 link 6a: ot is the object type this layer was processed AS *)
let Link6aJudge =
  in(link6aCh, (lyr: bitstring, otProcessed: bitstring, fb: bitstring));
  ( let framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ) = fb in
      ( if otJ <> otProcessed then event ChainBroken(lyr, LINK_6A) )
    else event ChainBroken(lyr, LINK_6A) ).

(* ---- C-Q1 link 6b: the ENVELOPE path's own attribution report names
        the INNERMOST frame's (fp(kX), id). One path, no join, asserted
        unconditionally wherever lyr <> L0.                              *)
let Link6bJudge =
  in(link6bCh, (aidJ: bitstring, lyr: bitstring, kAt: pkey, idAt: bitstring,
                fb: bitstring));
  if lyr <> L0 then
  ( let framed(otJ, algJ, idJ, kfpJ, mhJ, cvJ, plJ) = fb in
      ( if kfpJ <> fp(kAt) || idJ <> idAt then event ChainBroken(lyr, LINK_6B) )
    else event ChainBroken(lyr, LINK_6B) ).

(* ---- the retained S-P1 honest-key judge ----------------------------- *)
let JudgeH =
  in(honestKeyCh, kH: pkey);
  in(acceptKeyCh, (=kH, fbAcc: bitstring));
  event AcceptedUnderHonestKey(kH, fbAcc).

(* ---- C-Q3: S-P3's judge, transcribed, PER ROLE (encoding rule 2) ---- *)
let SP3Judge =
  in(honestCh, (kH: pkey, fbHon: bitstring));
  in(acceptCh, (ctxJ: bitstring, role: bitstring, kX: pkey, idX: bitstring, =fbHon));
  if kX = kH then
    ( if ctxJ = BASE then event HonestAccepted(kX, fbHon) )
  else
    ( if role = SLOT_A then event ReattributedA(kX, kH, fbHon)
      else event ReattributedB(kX, kH, fbHon) ).

(* ---- S-P2's SetJudge: completeness and the C-Q5w witnesses ---------- *)
let SetJudge =
  in(honestSetCh, mJ: bitstring);
  in(setCh, (=mJ, vJ: bitstring));
  let authTuple(idJ, fpAJ, ssJ, algJ, verJ) = mJ in
  ( let signers1(fpBJ) = ssJ in
      ( let verified2(kA: pkey, kB: pkey) = vJ in
          ( if fp(kA) = fpAJ && fp(kB) = fpBJ then event HonestComplete(mJ, vJ) )
        else
          let verified1(kA: pkey) = vJ in
          event Stripped(mJ, vJ) )
    else
      if ssJ = signers0 then
      let verified1(kA: pkey) = vJ in
      if fp(kA) = fpAJ then event HonestComplete(mJ, vJ) ).

(* ---- S-P2's MemberJudge: SignerForged and C-Q5's SetAltered --------- *)
let MemberJudge =
  in(honestMemberCh, (kH: pkey, mH: bitstring));
  in(slotCh, (tS: bitstring, fpS: bitstring, kUsed: pkey));
  if tS = mH then
    ( if fpS = fp(kH) && kUsed <> kH then event SignerForged(tS, kUsed) )
  else
    ( if kUsed = kH then event SetAltered(kH, mH, tS) ).

(* ---- S-P2 Q6's ContentJudge: the retained Spliced ------------------- *)
let ContentJudge =
  in(contentCh, (tJ: bitstring, faJ: bitstring, fbJ: bitstring));
  let framed(otaJ, algaJ, idaJ, kfpaJ, mhaJ, cvaJ, plaJ) = faJ in
  let framed(otbJ, algbJ, idbJ, kfpbJ, mhbJ, cvbJ, plbJ) = fbJ in
  if otaJ <> otbJ || cvaJ <> cvbJ || plaJ <> plbJ then
  event Spliced(tJ, faJ, fbJ).

(* ---- S-P7's TypeJudge: the retained TypeConfused -------------------- *)
let TypeJudge =
  in(honestTypeCh, (otS: bitstring, fbT: bitstring));
  in(typeCh, (otA: bitstring, =fbT));
  if otS = otA then 0 else event TypeConfused(otS, otA, fbT).

(* ---- C-Q4: S-P7's ScopeJudge (Rescoped / HonestWrappedAccepted) ----- *)
let ScopeJudge =
  in(honestInnerCh, (kH: pkey, idH: bitstring, fbHon: bitstring));
  in(scopeCh, (ctxJ: bitstring, kIrep: pkey, idIrep: bitstring, =fbHon));
  let wctx(kWj: pkey, idWj: bitstring, fbWj: bitstring) = ctxJ in
  ( if kIrep = kH && idIrep = idH then event HonestWrappedAccepted(kH, fbHon, kWj)
    else event Rescoped(kIrep, idIrep, kH, idH, fbHon) ).

(* ---- C-Q4: S-P7's SigJudge (InnerSigTransplanted), wrapped only ----- *)
let SigJudge =
  in(honestSigCh, (kH: pkey, sgH: bitstring));
  in(sigCh, (ctxJ: bitstring, kIrep: pkey, =sgH));
  let wctx(kWj: pkey, idWj: bitstring, fbWj: bitstring) = ctxJ in
  ( if kIrep = kH then 0 else event InnerSigTransplanted(kIrep, sgH) ).

(* ---- C-Q7: the signature-TERM judge, generic over every acceptance -- *)
let GenericSigJudge =
  in(gsigHonCh, (kH: pkey, sgH: bitstring));
  in(gsigCh, (kX: pkey, =sgH));
  if kX = kH then 0 else event SigTransplanted(kX, sgH).

(* ---- the retained S-P7 VersionJudge --------------------------------- *)
let VersionJudge =
  in(versionCh, (fbWv: bitstring, cvIwv: bitstring, fbIv: bitstring));
  let framed(otJv, algJv, idJv, kfpJv, mhJv, cvI, plJv) = fbIv in
  if cvIwv = cvI then 0 else event VersionLied(fbWv, cvIwv, cvI).

(* ---- C-Q2: the §A3.2.1 two-worlds boundary judge, PAIR FORM --------- *)
(* C-Q2 is stated for (a) and (b) only (§3); its judge is not built here. *)

(* ---- C-N1: the HonestChain witness, per layer (encoding rule 7) ----- *)
let ChainWitnessJudge =
  in(honestChainCh, (kH: pkey, mH: bitstring, fbHon: bitstring));
  in(chainCh, (lyr: bitstring, kX: pkey, tX: bitstring, =fbHon));
  if kX = kH && tX = mH then event HonestChain(lyr, tX).

(* ---- C-Q6 conjunct 2 and the honest standing witness ---------------- *)
let StandingJudge =
  in(estCh, (intake: bitstring, lyr: bitstring, kX: pkey, t: bitstring,
             aidD: bitstring));
  let authTuple(idJ, kfprJ, ssJ, algJ, verJ) = t in
  if fp(kX) <> kfprJ then
    ( if lyr <> L0 then event StandingUnentitledWrapped(kX, t) )
  else
    ( in(designCh, (=kX, =aidD));
      (* BF-6 REPAIR 2026-10-01: registered "HonestStandingEstablished over
         a **wrapped** presentation" (PREDICTIONS.md:1341); lyr is in scope
         here (estCh carries it), so the emission is guarded to wrapped
         layers, as StandingUnentitledWrapped's already is.  No query and no
         event signature changes.                                        *)
      if lyr <> L0 then event HonestStandingEstablished(kX, aidD) ).

(* ---- C-Q6 conjunct 3: scope agreement, the ONE registered PAIR judge,
        with the TWO ISOLATION OBSERVERS beside it. The judge waits for
        both reports; NEITHER PATH WAITS FOR THE OTHER.                  *)
let ScopeAgreementJudge =
  in(scopeStanding, (a: bitstring, l: bitstring, k: pkey, idS: bitstring,
                     derived: bitstring));
  in(scopeEnvelope, (=a, =l, ka: pkey, ia: bitstring));
  ( ( if (ka, ia) <> (k, idS) then event ScopeMisreported(a, l, k, idS, ka, ia)
      (* BF-6 REPAIR 2026-10-01: the witness is registered for "an honest
         wrapped acceptance" (PREDICTIONS.md:1210-1212); emitted only at
         l <> L0.  The pair judge ScopeMisreported is NOT guarded.       *)
      else ( in(designCh, (=k, =derived));
             if l <> L0 then event HonestWrappedStandingAgreed(a, l) ) )
  | ( if ka <> k then event ScopeKeyOnly(a, l, k, ka) )
  | ( if ia <> idS then event ScopeIdentityOnly(a, l, idS, ia) ) ).

(* ---- C-Q10: the D-6 tag-separation judge --------------------------- *)
let TagJudge =
  in(tagCh, (kJ: pkey, tagJ: bitstring));
  if tagJ <> TLR then event TagConfused(kJ, tagJ).

(* ---- reason-code sink (B9 is not a registered capstone query; the
        channel needs a reader so no report output blocks)               *)
let ReasonSink =
  in(reasonCh, (pJ: bitstring, rJ: bitstring)); 0.

(* ==================================================================== *)
(* ==== THE FIXTURE (§1.1) ============================================ *)
(* ==================================================================== *)
process
  new skS: skey; new skAdv: skey;
  let M1 = authTuple(issuerId,  fp(pk(skI2)), signers0,               algH, verH) in
  let M2 = authTuple(issuerId2, fp(pk(skI)),  signers1(fp(pk(skB2))), algH, verH) in
  let MW = authTuple(idW,       fp(pk(skW)),  signers0,               algH, verH) in
  let MA = authTuple(idAdv,     fp(pk(skAdv)), signers0,              algH, verH) in
  out(c, pk(skS));
  out(c, pk(skI)); out(c, pk(skB2)); out(c, pk(skI2)); out(c, pk(skW));
  out(c, M1); out(c, M2); out(c, MW);
  (* the ADVERSARY-ENROLLED issuer key of §1.1: the adversary holds skAdv
     and a SELF-SIGNED manifest MA. Authority evidence for MA exists ONLY
     where the compromise supplies it — no honest authority process
     publishes MA — so in (a)/(b) it is mintable on the ONE compromised
     channel alone, which is the SOLE channel in (d), which is the A4.6 cost.   *)
  out(c, skAdv); out(c, MA);
  (* CASE (d): DEGRADED, the SOLE authority channel compromised — its signing key is public *)
  out(c, skS);
  ( !out(honestMemberCh, (pk(skI), M2))
  | !out(honestMemberCh, (pk(skB2), M2))
  | !out(honestMemberCh, (pk(skI2), M1))
  | !out(honestMemberCh, (pk(skW), MW))
  | !Attester(skB2, issuerId2, M2, cvA)
  | !Front
  | !AttestStage(pk(skS))
  | !MemberJudge )
