(* ==== model-local declarations (library terms are NOT redeclared) ==== *)

(* S-P3's seven-field frame, copied VERBATIM (library header: "NOT       *)
(* promoted; shared by copy"); encoding rule (4).                        *)
fun framed(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring): bitstring [data].
  (* objType, alg, issuerId, kfp, manifestHash, canonVer, payload *)

(* S-P7's opaque embedding, widened to the inner OBJECT's signer slots:  *)
(* the inner blob is (fbA, sgA, fbB, sgB) where S-P7 carried (fbI, sgI). *)
(* Encoding note 1 in RESULTS.md: the capstone's inner layer performs    *)
(* S-P2's set logic, so a wrapped inner object of a two-signer manifest  *)
(* has two frames and two signatures. Same idiom, wider blob.            *)
fun wrap(bitstring, bitstring): bitstring [data].
  (* cvInner, inner blob *)

(* verifier-path context handed to the judges (S-P7's wctx): the         *)
(* IMMEDIATELY ENCLOSING wrapper. Depth is carried by the layer index.   *)
fun wctx(pkey, bitstring, bitstring): bitstring [data].
const BASE: bitstring.

(* the signer-set field of the map-v1 tuple: a bounded family, n <= 2    *)
(* (S-P2, verbatim)                                                      *)
const signers0: bitstring.
fun signers1(bitstring): bitstring [data].
fun verified1(pkey): bitstring [data].
fun verified2(pkey, pkey): bitstring [data].

(* layer indices, depth bounded at 2 (§1.3, L-13's named scoping) *)
const L0: bitstring.
const L1: bitstring.
const L2: bitstring.

(* signer-slot roles — encoding rule (2), per-role judges *)
const SLOT_A: bitstring.
const SLOT_B: bitstring.

(* the link names ChainBroken carries (§1.3) *)
const LINK_1A: bitstring.
const LINK_2A: bitstring.
const LINK_3: bitstring.
const LINK_4: bitstring.
const LINK_5: bitstring.
const LINK_6A: bitstring.
const LINK_6B: bitstring.

(* fixture names *)
free canonVerH: bitstring.
free cvA: bitstring.
free cvB: bitstring.
free issuerId2: bitstring.        (* M2's issuer identity (N2) *)
free idW: bitstring.              (* the separate honest wrapper's identity *)
free idAdv: bitstring.            (* the adversary's own identity *)
free kNone: pkey.                 (* placeholder enclosing key at BASE *)

(* honest keys: private free names so queries can cite them (S-P2 idiom) *)
free skI: skey [private].    (* slot A of M2; ALSO wraps its own attestation *)
free skB2: skey [private].   (* slot B of M2 *)
free skI2: skey [private].   (* the sole slot of M1; signs M1 and nothing else *)
free skW: skey [private].    (* the separate honest wrapper key; MW *)

(* S-STANDING's standing vocabulary, transcribed *)
fun attemptCore(bitstring, bitstring, bitstring, bitstring): bitstring [data].
fun wrapCore(bitstring, bitstring): bitstring [data].
fun entry(bitstring, bitstring): bitstring [data].
fun lineage2(bitstring, bitstring): bitstring [data].
const DISP_ABANDONED: bitstring.
const DISP_SHIPPED: bitstring.
fun TERM_SHIPPED(bitstring): bitstring [data].
const TERM_REFUSED: bitstring.
const noTLR: bitstring.
fun withTLR(pkey, bitstring, bitstring): bitstring [data].
fun anchorProof(bitstring): bitstring [data].
const ESTABLISHED: bitstring.
const ABSENT: bitstring.
const UNVERIFIABLE: bitstring.
const TERMINAL_DISPOSITION_SHOWN: bitstring.        (* S1 *)
const SUPERSEDED: bitstring.                        (* S2 *)
const NO_TERMINAL_DISPOSITION_EVIDENCE: bitstring.  (* S3 *)
const ISSUANCE_REFUSED: bitstring.                  (* S4 *)
const STANDING_EVIDENCE_MALFORMED: bitstring.
const STANDING_EVIDENCE_TEMPORAL_MISMATCH: bitstring.
const STANDING_EVIDENCE_MISMATCH: bitstring.
const STANDING_EVIDENCE_SIGNATURE_INVALID: bitstring.
const PATH_S2: bitstring.
const PATH_S3: bitstring.
const PATH_S4: bitstring.

(* ==== judge channels (private; S-P3 idiom, one per judge) ============ *)
free stageCh: channel [private].      (* front-end / wrapper layer -> next layer *)
free sStageCh: channel [private].     (* the STANDING path's own structural parse *)
(* §1.3's front-end contract: the bundle is read ONCE at intake and forwarded on
   private channels to the envelope path and the standing path IN PARALLEL.  The
   per-layer material of the ONE presented bundle is therefore forwarded on these
   three channels, one copy to each path, so both paths consume the SAME presented
   terms.  Without this the two paths read independent copies from `c`, which is
   exactly the artifact-A / artifact-B substitution §3 C-Q6 (4) says the join must
   exclude, and which (E1) excludes "by the shared fresh intake name and the
   structural extraction".  Neither path waits for the other: each consumes its
   own copy, and no report of either is a precondition of the other's.          *)
free envMat: channel [private].       (* intake -> envelope path : this layer's material *)
free stdMat: channel [private].       (* intake -> standing path : the same terms *)
free standCore: channel [private].    (* intake -> standing path : core and standing evidence *)
free link1aCh: channel [private].
free link2aCh: channel [private].
free possCh: channel [private].       (* link 3 + C-Q9 *)
free bytesCh: channel [private].      (* link 4 + C-Q8 *)
free link5Ch: channel [private].
free link5cCh: channel [private].
free link6aCh: channel [private].
free link6bCh: channel [private].
free honestKeyCh: channel [private].
free acceptKeyCh: channel [private].
free honestCh: channel [private].
free acceptCh: channel [private].
free honestMemberCh: channel [private].
free slotCh: channel [private].
free honestSetCh: channel [private].
free setCh: channel [private].
free contentCh: channel [private].
free honestTypeCh: channel [private].
free typeCh: channel [private].
free honestInnerCh: channel [private].
free scopeCh: channel [private].
free honestSigCh: channel [private].
free sigCh: channel [private].
free gsigHonCh: channel [private].
free gsigCh: channel [private].
free versionCh: channel [private].
free twoWorldsCh: channel [private].
free honestChainCh: channel [private].
free chainCh: channel [private].
free designCh: channel [private].
free estCh: channel [private].
free reasonCh: channel [private].
free tagCh: channel [private].
free scopeStanding: channel [private].
free scopeEnvelope: channel [private].

(* ==== events (§1.3, exactly as LEDGER §6 fixes them) ================= *)
event LayerAccepted(bitstring, bitstring, bitstring, bitstring,
                    bitstring, pkey, bitstring, bitstring, bitstring).
  (* aid, lyr, t, ev, slot, kX, ppf, sg, fb.  ev in STRICT is the PAIR   *)
  (* of evidence terms, one per channel (§1.3 "ev IN STRICT IS THE       *)
  (* PAIR"); the signature is unchanged.                                 *)
event AcceptanceComplete(bitstring, bitstring, bitstring).   (* aid, lyr, t *)
event AuthorityEvidence(bitstring, bitstring, pkey).         (* t, ev, channel key *)
event ScopeReported(bitstring, bitstring, pkey, bitstring).  (* aid, lyr, kA, idA *)
event ChainBroken(bitstring, bitstring).                     (* lyr, link name *)
event HonestChain(bitstring, bitstring).                     (* lyr, t — witness *)
event SlotSatisfied(bitstring, bitstring, bitstring, bitstring).
  (* aid, lyr, t, slot — link 2b's permitted projection, RETAINING lyr   *)

event AcceptS(bitstring, bitstring, pkey, bitstring).   (* degraded-form acceptance; unused in strict *)
event AcceptedUnderHonestKey(pkey, bitstring).
event HonestAccepted(pkey, bitstring).
event ReattributedA(pkey, pkey, bitstring).
event ReattributedB(pkey, pkey, bitstring).
event Stripped(bitstring, bitstring).
event SignerForged(bitstring, pkey).
event SetAltered(pkey, bitstring, bitstring).
event HonestComplete(bitstring, bitstring).
event Spliced(bitstring, bitstring, bitstring).
event TypeConfused(bitstring, bitstring, bitstring).
event VersionLied(bitstring, bitstring, bitstring).
event Rescoped(pkey, bitstring, pkey, bitstring, bitstring).
event HonestWrappedAccepted(pkey, bitstring, pkey).
event InnerSigTransplanted(pkey, bitstring).
event SigTransplanted(pkey, bitstring).
event SigBytesUnbound(pkey, bitstring, bitstring).
event PossessionUnbound(pkey, bitstring, bitstring).
event TwoWorldsBroken(bitstring, bitstring, bitstring, bitstring).
event TagConfused(pkey, bitstring).

(* standing *)
event Designated(pkey, bitstring).
event Established(pkey, bitstring, bitstring).
event EstablishedWrapped(bitstring, bitstring, bitstring, pkey, bitstring, bitstring).
  (* aid, lyr, t, kX, core, verdict *)
event StandingReport(bitstring, bitstring, pkey, bitstring, bitstring).
event StandingUnentitledWrapped(pkey, bitstring).
event HonestStandingEstablished(pkey, bitstring).
event ScopeMisreported(bitstring, bitstring, pkey, bitstring, pkey, bitstring).
event HonestWrappedStandingAgreed(bitstring, bitstring).
(* the TWO ISOLATION OBSERVERS (§3, C-Q6 (1)). Observers, not queries:   *)
(* fired here, queried ONLY in the configuration that names them         *)
(* (C-C15(iii)); never timeboxed, never a discharge.                     *)
event ScopeKeyOnly(bitstring, bitstring, pkey, pkey).
event ScopeIdentityOnly(bitstring, bitstring, bitstring, bitstring).

