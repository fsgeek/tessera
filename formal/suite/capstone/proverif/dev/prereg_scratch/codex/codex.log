    87	(* --- public channel ------------------------------------------------- *)
    88	free c: channel.
    89	
    90	(* --- signature primitives ------------------------------------------- *)
    91	(* Dolev–Yao signatures, deterministic, with message recovery, PLUS the  *)
    92	(* registered A1.3 item 3 capability (D-4): from any ONE seen signature  *)
    93	(* s = sign(m, k) and a fresh value r, the adversary derives a private   *)
    94	(* key dsks(s, r) it holds, whose public key verifies s to the same m.   *)
    95	(* What this grants: choosing a keypair AFTER seeing a valid signature   *)
    96	(* so that the existing message–signature pair verifies under it (the   *)
    97	(* registered P3 threat, exclusive-ownership failure).                   *)
    98	(* What it does not grant: forging a signature under a key the          *)
    99	(* adversary does not hold; making a derived key verify any OTHER        *)
   100	(* signature by k; key recovery. A derived key signs freely (possession  *)
   101	(* is free to the adversary, P10).                                       *)
   102	(* Modeled as a second rewrite rule tried when the honest rule does not  *)
   103	(* apply. Signatures are deterministic here: the judge pattern equates   *)
   104	(* more evidence than a byte-level judge would, so unreachability in the *)
   105	(* model is conservative for the real judge (guide A2).                  *)
   106	type skey.
   107	type pkey.
   108	fun pk(skey): pkey.
   109	fun sign(bitstring, skey): bitstring.
   110	fun dsks(bitstring, bitstring): skey.
   111	fun checksign(bitstring, pkey): bitstring
   112	  reduc forall m: bitstring, k: skey;
   113	          checksign(sign(m, k), pk(k)) = m
   114	  otherwise forall m: bitstring, k: skey, r: bitstring;
   115	          checksign(sign(m, k), pk(dsks(sign(m, k), r))) = m.
