(* ==================================================================== *)
(* ==== THE STANDING PATH (check 7), PARALLEL to the envelope path ==== *)
(*                                                                      *)
(* (E1) SAME PRESENTATION: the standing path computes over the          *)
(* innermost (t, ppf, sg, fb) that IT extracts STRUCTURALLY, ITSELF,    *)
(* from the same bundle the front-end forwarded to it, under the same   *)
(* intake aid. It neither waits for nor is conditioned on               *)
(* LayerAccepted: no event of the envelope path, and no success of it,  *)
(* is a precondition of EstablishedWrapped.                             *)
(* (E2) SAME CORE: core = attemptCore(t, ppf, sg, decl) for exactly the *)
(* t, ppf and sg of (E1) — the five term equalities of §3 C-Q6 (3),     *)
(* which are IMMUTABLE and define the join.                             *)
(* (E3) DERIVED IDENTITY: h(core), derived, never read from the bundle. *)
(* (E4) WRAPPED: lyr <> L0, from the structural parse below.            *)
(* (E5 was WITHDRAWN from the emission contract and lives only as       *)
(* check 7's entitled-key comparison, which C-C12 removes.)             *)
(* ==================================================================== *)

(* the standing path's OWN structural unwrapping — no verifier check,   *)
(* no signature, no authority: S-P7's wrap() destructuring performed on *)
(* the standing path's own copy of the bundle.                          *)
let SUnwrap(lyrIn: bitstring, lyrOut: bitstring) =
  in(sStageCh, (aid: bitstring, =lyrIn, fbA: bitstring, sgA: bitstring,
                fbB: bitstring, sgB: bitstring));
  let framed(=OT_WRAPPER, awz, iwz, kwz, mwz, cwz,
             wrap(cwi, (fbIA: bitstring, sgIA: bitstring,
                        fbIB: bitstring, sgIB: bitstring))) = fbA in
  out(sStageCh, (aid, lyrOut, fbIA, sgIA, fbIB, sgIB)).

(* lineage lookup over the two-entry structure (S-STANDING, verbatim) *)
fun lookup2(bitstring, bitstring): bitstring
  reduc forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
          lookup2(a, lineage2(entry(a, d1), entry(b, d2))) = d1
  otherwise forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
          lookup2(b, lineage2(entry(a, d1), entry(b, d2))) = d2.

let StandingDecide(kT: pkey, t: bitstring, aidD: bitstring, d: bitstring,
                   terminal: bitstring, intake: bitstring, lyr: bitstring,
                   core: bitstring, idS: bitstring) =
  if terminal = TERM_REFUSED then
    ( event StandingReport(ABSENT, ISSUANCE_REFUSED, kT, t, aidD);       (* S4 *)
      out(reasonCh, (PATH_S4, ISSUANCE_REFUSED)) )
  else
    ( let TERM_SHIPPED(shippedId) = terminal in
      ( if shippedId = aidD then
          ( if d = DISP_SHIPPED then
              ( event Established(kT, t, aidD);
                event StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, kT, t, aidD);
                ( ( if lyr <> L0 then
                      event EstablishedWrapped(intake, lyr, t, kT, core, ESTABLISHED) )
                | out(estCh, (intake, lyr, kT, t, aidD))
                | out(scopeStanding, (intake, lyr, kT, idS, aidD)) ) )
            else
              event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aidD) )
        else
          ( event StandingReport(ABSENT, SUPERSEDED, kT, t, aidD);       (* S2 *)
            out(reasonCh, (PATH_S2, SUPERSEDED)) ) )
      else
        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aidD) ).

let StandingPath(pkDv: pkey, pkRv: pkey) =
  in(sStageCh, (intake: bitstring, lyr: bitstring, fbI: bitstring, sgI: bitstring,
                fbIB: bitstring, sgIB: bitstring));
  (* BF-5 REPAIR 2026-10-01 -- STRUCTURAL SELECTION OF THE INNERMOST LAYER.
     Registered: lyr "For C-Q6 ... is the **innermost** layer of the wrapped
     presentation" (PREDICTIONS.md:782); "(E4) Wrapped. lyr <> L0; at depth 2
     the innermost layer is L2" (:939-940); the wrapped flag is "the
     front-end's structural parse of the outer frame -- an OT_WRAPPER frame
     whose payload field is a wrap() term" (:942-944); and (E1) the standing
     path "computes over the innermost (t, ppf, sg, fb) that it extracts
     structurally, itself" (:892-894).  So a layer is innermost exactly when
     that SAME parse does NOT match its frame -- i.e. SUnwrap would not descend
     from it.  This is the complement of SUnwrap's own pattern and nothing
     more: no type check, no signature, no authority, and no envelope event or
     success (E1).  Before this repair StandingPath consumed every layer
     SUnwrap reached, so standing could establish at an intermediate wrapper
     (review finding 2, dev/codex/scratch/capstone_d_noninnermost_attest.out
     :3010).                                                                 *)
  let framed(=OT_WRAPPER, awi, iwi, kwi, mwi, cwi,
             wrap(cwii, (fbNA: bitstring, sgNA: bitstring,
                         fbNB: bitstring, sgNB: bitstring))) = fbI in 0
  else
  in(stdMat, (=intake, =lyr, t: bitstring, evD: bitstring, evR: bitstring,
              kX: pkey, ppfI: bitstring, kBs: pkey, ppfBs: bitstring));
  in(standCore, (=intake, core: bitstring, se: bitstring));
  (* (E2), and the five immutable term equalities of §3 C-Q6 (3):
     t = tI, ppf = ppfI, sg = sgI (a TERM equality, not a verification
     equality — this is what denies the D-4 dsks route a second
     (key, signature) pairing), fb = fbI, kX = kI.                       *)
  let attemptCore(=t, =ppfI, =sgI, declS) = core in
  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in
  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in
  let authTuple(idS, kfpr, ss, alg, ver) = t in
  let aidD = h(core) in                                            (* (E3) *)
  if se = noTLR then
    ( event StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, kX, t, aidD);
      out(reasonCh, (PATH_S3, NO_TERMINAL_DISPOSITION_EVIDENCE)) )       (* S3 *)
  else
    ( let withTLR(kT, tlrSig, ap) = se in
      (* CHECK 7, the entitled-key comparison: the TLR key is the key the
         evidenced tuple names.  C-C12 removes `fp(kT) = kfpr` ONLY and
         RETAINS `kT = kX`.                                              *)
      if fp(kT) = kfpr then
        ( if kT = kX then
          (* the D-6 TLR TAG CHECK — the check C-C18 unbinds *)
          let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) =
                checksign(tlrSig, kT) in
            ( out(tagCh, (kT, TLR))
            | ( let anchorProof(=h(tlrSig)) = ap in
                  ( let d = lookup2(aidD, lin) in
                      StandingDecide(kT, t, aidD, d, terminal, intake, lyr, core, idS)
                    else
                      event StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, kT, t, aidD) )
                else
                  event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_TEMPORAL_MISMATCH, kT, t, aidD) ) )
          else
            event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) )
      else
        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) ).

