   117	(* --- key fingerprint -------------------------------------------------- *)
   118	(* IDEALIZATION (guide READ-AND-CHALLENGE A1 — the spike ledger named   *)
   119	(* h's residual and not fp's; this header closes that gap): fp is a     *)
   120	(* free constructor — injective, no collisions, no preimages. A model    *)
   121	(* check `fp(kX) = kfpr` is therefore equivalent to `kX = the key whose  *)
   122	(* fingerprint was published`. In the implementation it is a byte        *)
   123	(* comparison whose strength is the fingerprint function's collision     *)
   124	(* resistance and the P8 question of what bytes a fingerprint hashes.    *)
   125	(* Layer 2 residual; every ledger entry that consumes a fingerprint      *)
   126	(* match must cite it. What a concrete fingerprint hashes is P8's        *)
   127	(* business (spike fixture note).                                        *)
   128	fun fp(pkey): bitstring.
   129	
   130	(* --- hash ------------------------------------------------------------- *)
   131	(* IDEALIZATION (must be cited by every consumer ledger entry, spike     *)
   132	(* ledger entry 1/3 residual, DECISION.md remediation 5): h is a free    *)
   133	(* constructor — injective by construction, no collisions, no            *)
   134	(* preimages, no length or encoding structure. This erases (a) concrete *)
   135	(* collision behavior — collision resistance of the real digest is a    *)
   136	(* Layer 2 assumption discharged by cited external hardness results,    *)
   137	(* never by a model including this file; and (b) encoding ambiguity —   *)
   138	(* two byte-strings canonicalizing to one input, which is P8's          *)
   139	(* injectivity obligation, not this library's. Any query whose truth    *)
   140	(* depends on h being hard to invert or collide is proving a symbolic   *)
