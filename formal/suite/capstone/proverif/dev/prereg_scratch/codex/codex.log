     1	# EXPLORATORY PROBE 2026-10-04 — non-discharging; not part of any registration
     2	#
     3	# Derives a PROCESS SLICE of a capstone .pv file by DELETING top-level parallel
     4	# components of the main process (never editing a process body, a declaration, a
     5	# destructor or a `set` line), and by keeping ONE query (deleting the other query
     6	# declarations; queries do not change the model).
     7	#
     8	#   python3 slice.py SRC.pv SLICE QUERY OUT.pv
     9	#     SLICE in: none | depth{0,1,2} | depth{0,1,2}.attOnly | depth{0,1,2}.cone
    10	#     QUERY in: all | a key of QUERY_RE below
    11	#   python3 slice.py --identity SRC.pv   (checks that `none`+`all` reproduces SRC byte-for-byte
    12	#                                         after the one banner line)
    13	#
    14	# Deleting a replicated component only removes traces (see REPORT.md section 2), so a
    15	# reconstructed attack ("is false" + "A trace has been found.") in a slice is an
    16	# attack on SRC; a "true" in a slice says nothing about SRC.
    17	import re, sys
    18	
    19	BANNER = "(* EXPLORATORY PROBE 2026-10-04 — non-discharging; not part of any registration *)\n"
    20	
    21	# Tamarin slice.py correspondence:
    22	#   depth0   ~ Tamarin depth0  : no wrapped layer (both WrapStage, both SUnwrap)
    23	#   attOnly  ~ Tamarin attOnly : the honest processes other than Attester deleted
    24	#              (ShipIssuer, RefuseIssuer, ForeignIssuer, Wrapper).  Tamarin's attOnly ALSO
    25	#              deletes the dsks reductions of the POSS checks; that is NOT a deletion of
    26	#              behaviour in ProVerif (removing a destructor rewrite rule makes `else`
    27	#              branches reachable), so it is not mirrored here.
    28	#   cone     = attOnly + every process the query's event cannot depend on
    29	WRAP = r'WrapStage|SUnwrap'
    30	OTHERS = r'ShipIssuer|RefuseIssuer|ForeignIssuer|Wrapper'
    31	# what a cone keeps (by component head name) for each query; everything else goes
    32	CORE = {'Front', 'AttestStage', 'WrapStage', 'SUnwrap'}
    33	CONE_KEEP = {
    34	    # C-C2's set (1) and the A4.6 control
    35	    'cq3a':  CORE | {'Attester', 'SP3Judge'},
    36	    'cq3b':  CORE | {'Attester', 'SP3Judge'},
    37	    'link5': CORE | {'Link5Judge'},
    38	    'a46':   CORE,
    39	    # EXTENSION (beyond the brief; section 4 of REPORT.md): one set-(1) member per other
    40	    # degraded mechanism failure.  'out:CH' keeps the fixture's `!out(CH, ...)` components.
    41	    'cq5':    CORE | {'Attester', 'MemberJudge', 'out:honestMemberCh'},
    42	    'sf':     CORE | {'Attester', 'MemberJudge', 'out:honestMemberCh'},
    43	    'cq9':    CORE | {'Attester', 'PossJudge'},
    44	    'cq8':    CORE | {'Attester', 'BytesJudge'},
    45	    'cq7':    CORE | {'Attester', 'GenericSigJudge'},
    46	    'cq4r':   CORE | {'Attester', 'ScopeJudge'},
    47	    'cq4s':   CORE | {'Attester', 'SigJudge'},
    48	    'link6b': CORE | {'Attester', 'Link6bJudge'},
    49	    'link2a': CORE | {'Link2aJudge'},
    50	    'link3':  CORE | {'Attester', 'PossJudge'},
    51	    'link4':  CORE | {'Attester', 'BytesJudge'},
    52	    'auhk':   CORE | {'Attester', 'JudgeH', 'out:honestKeyCh'},
    53	}
    54	QUERY_RE = {
    55	    'cq3a':  r'event\(ReattributedA\(',
    56	    'cq3b':  r'event\(ReattributedB\(',
    57	    'link5': r'event\(ChainBroken\(l, LINK_5\)\)',
    58	    'a46':   r'event\(AcceptS\(ev, t, k, fb\)\) ==> event\(IssuerSigned\(k, fb\)\)',
    59	    'cq5':    r'event\(SetAltered\(',
    60	    'sf':     r'event\(SignerForged\(',
    61	    'cq9':    r'event\(PossessionUnbound\(',
    62	    'cq8':    r'event\(SigBytesUnbound\(',
    63	    'cq7':    r'event\(SigTransplanted\(',
    64	    'cq4r':   r'event\(Rescoped\(',
    65	    'cq4s':   r'event\(InnerSigTransplanted\(',
    66	    'link6b': r'event\(ChainBroken\(l, LINK_6B\)\)',
    67	    'link2a': r'event\(ChainBroken\(l, LINK_2A\)\)',
    68	    'link3':  r'event\(ChainBroken\(l, LINK_3\)\)',
    69	    'link4':  r'event\(ChainBroken\(l, LINK_4\)\)',
    70	    'auhk':   r'event\(AcceptedUnderHonestKey\(k, fb\)\) ==>',
    71	}
    72	# depth1 (extension): only the (L1 -> L2) wrapper layer and its standing-side unwrap go
    73	DEPTH1 = r'!WrapStage\(pk\(skS\), L1, L2\)|!SUnwrap\(L1, L2\)'
    74	
    75	def head(comp):
    76	    m = re.match(r'!?\s*(\w+)\s*(?:\(\s*(\w*))?', comp)
    77	    return (m.group(1), m.group(2)) if m else (comp, '')
    78	
    79	def drop_pred(slice_, query):
    80	    def pred(comp):
    81	        name, arg0 = head(comp)
    82	        if slice_ == 'none':
    83	            return False
    84	        depth, _, guide = slice_.partition('.')
    85	        if depth == 'depth0' and re.fullmatch(WRAP, name):
    86	            return True
    87	        if depth == 'depth1' and re.fullmatch(DEPTH1, comp):
    88	            return True
    89	        if guide == 'attOnly' and re.fullmatch(OTHERS, name):
    90	            return True
    91	        if guide == 'cone':
    92	            keep = CONE_KEEP[query]
    93	            return name not in keep and (name + ':' + (arg0 or '')) not in keep
    94	        return False
    95	    return pred
    96	
    97	def split_top(block):
    98	    # block is "( c1 | c2 | ... )" ; split on '|' at depth 1, '||' excluded (none at top)
    99	    assert block.startswith('(') and block.rstrip().endswith(')')
   100	    inner = block[1:block.rstrip().rfind(')')]
   101	    comps, depth, cur = [], 0, ''
   102	    for ch in inner:
   103	        if ch == '(':
   104	            depth += 1
   105	        elif ch == ')':
   106	            depth -= 1
   107	        if ch == '|' and depth == 0:
   108	            comps.append(cur); cur = ''
   109	        else:
   110	            cur += ch
   111	    comps.append(cur)
   112	    return [c.strip() for c in comps]
   113	
   114	def make(src_text, slice_, query):
   115	    txt = src_text
   116	    dropped_q = 0
   117	    if query != 'all':
   118	        qre = re.compile(QUERY_RE[query])
   119	        def qsub(m):
   120	            nonlocal dropped_q
   121	            if qre.search(m.group(0)):
   122	                return m.group(0)
   123	            dropped_q += 1
   124	            return '(* query deleted by slice.py *)'
   125	        txt = re.sub(r'(?ms)^query\b.*?\.[ \t]*$', qsub, txt)
   126	        kept = len(re.findall(r'(?m)^query\b', txt))
   127	        assert kept == 1, (query, kept)
   128	    dropped = []
   129	    if slice_ != 'none':
   130	        # the main process's parallel block: from "\n  ( !out(honestKeyCh" to EOF
   131	        i = txt.index('\n  ( !out(honestKeyCh')
   132	        pre, block = txt[:i + 1], txt[i + 1:].strip()
   133	        comps = split_top(block)
   134	        pred = drop_pred(slice_, query)
   135	        keep = [c for c in comps if not pred(c)]
   136	        dropped = [c for c in comps if pred(c)]
   137	        txt = pre + '  ( ' + '\n  | '.join(keep) + ' )\n'
   138	    return txt, dropped, dropped_q
   139	
   140	if __name__ == '__main__':
   141	    if sys.argv[1] == '--identity':
   142	        src = open(sys.argv[2]).read()
   143	        out, d, dq = make(src, 'none', 'all')
   144	        ok = (out == src and not d and dq == 0)
   145	        print('identity', sys.argv[2], 'OK' if ok else 'MISMATCH')
   146	        sys.exit(0 if ok else 1)
   147	    srcp, slice_, query, outp = sys.argv[1:5]
   148	    src = open(srcp).read()
   149	    out, dropped, dq = make(src, slice_, query)
   150	    note = (f"(* GENERATED by slice.py from {srcp.split('/')[-1]}: slice={slice_} query={query}; "
   151	            f"{dq} query declarations deleted; {len(dropped)} process components deleted: "
   152	            f"{' ; '.join(dropped) if dropped else '(none)'} *)\n")
   153	    open(outp, 'w').write(BANNER + note + out)
   154	    print(outp, 'queries-deleted', dq, 'components-deleted', len(dropped))
     1	# Scratch (prereg_scratch): derives the A8.4 files. SRC.pv -> a84_SRC.pv.
     2	# (1) header comment line prepended; (2) every query declaration replaced by a comment
     3	# (slice.py's regex); (3) BLOCK inserted before the REQUIRED-retained-queries comment line.
     4	# Nothing else changes.
     5	import re, sys
     6	ANCHOR = '(* ---- the REQUIRED retained queries'
     7	BLOCK = '''(* ---- A8.4 — standing key = the key the innermost acceptance verified under *)
     8	(* Joined on intake aid, layer lyr, the evidenced tuple t, slot A (the slot   *)
     9	(* argument is t's kfpr) and the signature TERM sg of the standing core.     *)
    10	query aid: bitstring, lyr: bitstring, id: bitstring, kf: bitstring, ss: bitstring,
    11	      al: bitstring, vr: bitstring, kS: pkey, ppf: bitstring, sg: bitstring,
    12	      dcl: bitstring, ev: bitstring, kV: pkey, ppfV: bitstring, fb: bitstring;
    13	  event(EstablishedWrapped(aid, lyr, authTuple(id, kf, ss, al, vr), kS,
    14	          attemptCore(authTuple(id, kf, ss, al, vr), ppf, sg, dcl), ESTABLISHED))
    15	  && event(LayerAccepted(aid, lyr, authTuple(id, kf, ss, al, vr), ev, kf, kV, ppfV, sg, fb))
    16	  ==> kS = kV.
    17	(* ---- A8.4w — vacuity witness: both events, same join, same key; REACHABLE *)
    18	query aid: bitstring, lyr: bitstring, id: bitstring, kf: bitstring, ss: bitstring,
    19	      al: bitstring, vr: bitstring, kS: pkey, ppf: bitstring, sg: bitstring,
    20	      dcl: bitstring, ev: bitstring, ppfV: bitstring, fb: bitstring;
    21	  event(EstablishedWrapped(aid, lyr, authTuple(id, kf, ss, al, vr), kS,
    22	          attemptCore(authTuple(id, kf, ss, al, vr), ppf, sg, dcl), ESTABLISHED))
    23	  && event(LayerAccepted(aid, lyr, authTuple(id, kf, ss, al, vr), ev, kf, kS, ppfV, sg, fb)).
    24	
    25	'''
    26	src, out = sys.argv[1:3]
    27	txt = open(src).read()
    28	n0 = len(re.findall(r'(?m)^query\b', txt))
    29	txt, nq = re.subn(r'(?ms)^query\b.*?\.[ \t]*$', '(* query deleted for A8.4 *)', txt)
    30	assert nq == n0 and txt.count(ANCHOR) == 1
    31	txt = txt.replace(ANCHOR, BLOCK + ANCHOR)
    32	hdr = f"(* A8.4 DERIVED FILE from {src.split('/')[-1]}: {nq} query declarations deleted; the A8.4 query and its witness added; no process, declaration or set line changed *)\n"
    33	open(out, 'w').write(hdr + txt)
    34	print(out, nq)

