(* ==== THE WRAPPER LAYER (S-P7's outer check, per layer) ============= *)
(* Checks the outer object as the attestation path would, with          *)
(* objType = OT_WRAPPER; checks the recorded inner canonicalization     *)
(* version (A5.5); then hands the inner blob to the NEXT layer on       *)
let AuthorityDNS(skDp: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT_DIGEST, h(t)), skDp)).

let AuthorityRepo(skRp: skey, t: bitstring) =
  event AuthorityPublishedRepo(t);
  out(c, sign((STMT_DIGEST, h(t)), skRp)).

(* --- an honest attester: ONE KEY, ONE MANIFEST (§1.1) ---------------- *)
let Attester(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, payload: bitstring);
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, m), sk) in
  out(c, ppf);
  let fb = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, payload) in
  let sg = sign((BYTES, fb), sk) in
  event IssuerSigned(pk(sk), fb);
  ( out(honestTypeCh, (OT_ATTEST, fb))
  | out(honestCh, (pk(sk), fb))
  | out(honestInnerCh, (pk(sk), id, fb))
  | out(honestSigCh, (pk(sk), sg))
  | out(gsigHonCh, (pk(sk), sg))
  | out(honestChainCh, (pk(sk), m, fb))
  | out(c, sg) ).

(* --- an honest issuer with a two-entry lineage: S-STANDING's          *)
(* ShipIssuer, emitting the honest reports an Attester does for both    *)
(* attempts, so the composed judges can pair with them.                 *)
let ShipIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, (p1: bitstring, p2: bitstring));
  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, m), sk) in
  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
  let sg1 = sign((BYTES, fb1), sk) in
  let core1 = attemptCore(m, ppf, sg1, decl1) in
  event IssuerSigned(pk(sk), fb1);
  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
  let sg2 = sign((BYTES, fb2), sk) in
  let core2 = attemptCore(m, ppf, sg2, decl2) in
  event IssuerSigned(pk(sk), fb2);
  event Designated(pk(sk), h(core2));
  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_SHIPPED)),
              TERM_SHIPPED(h(core2)), declT) in
  ( out(c, ppf)
  | out(c, (core1, fb1, sg1))
  | out(c, (core2, fb2, sg2))
  | out(designCh, (pk(sk), h(core2)))
  | out(c, sign((TLR, body), sk))
  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).

(* --- the second terminal disposition: both attempts abandoned -------- *)
let RefuseIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
  in(c, (p1: bitstring, p2: bitstring));
  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, m), sk) in
  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
  let sg1 = sign((BYTES, fb1), sk) in
  let core1 = attemptCore(m, ppf, sg1, decl1) in
  event IssuerSigned(pk(sk), fb1);
  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
  let sg2 = sign((BYTES, fb2), sk) in
  let core2 = attemptCore(m, ppf, sg2, decl2) in
  event IssuerSigned(pk(sk), fb2);
  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_ABANDONED)),
              TERM_REFUSED, declT) in
  ( out(c, ppf)
  | out(c, (core1, fb1, sg1))
  | out(c, (core2, fb2, sg2))
  | out(c, sign((TLR, body), sk))
  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).

