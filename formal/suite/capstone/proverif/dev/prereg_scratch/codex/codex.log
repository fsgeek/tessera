     2	# (run with: bash run.sh ...)
     3	# usage: run.sh MEMMAX BOXSEC JOBS file1.pv file2.pv ...   (paths under gen/)
     4	# Runs as a pool of JOBS concurrent jobs (xargs -P). Each run: its own systemd user scope (MemoryMax, no swap), `timeout`, /usr/bin/time %M.
     5	cd "$(dirname "$0")"
     6	LIB=../../../../lib/tessera_theory.pvl
     7	MEM=$1 BOX=$2 JOBS=$3; shift 3
     8	mkdir -p out
     9	one() {
    10	  local f=$1 b; b=$(basename "$f" .pv); local s=$(date +%s.%N)
    11	  systemd-run --user --scope -q -p MemoryMax=$MEM -p MemorySwapMax=0 \
    12	    /usr/bin/time -f %M -o out/$b.rss timeout $BOX nice -n 10 ~/.local/bin/proverif -lib $LIB "$f" > out/$b.out 2>&1
    13	  local rc=$?; local e=$(date +%s.%N)
    14	  local res=$(grep -E '^RESULT' out/$b.out | sed 's/^RESULT //' | tr '\n' ' ')
    15	  local tr=$(grep -c 'A trace has been found' out/$b.out)
    16	  echo "$b rc=$rc wall=$(printf '%.1f' $(echo "$e-$s"|bc)) peakRSSkB=$(tail -1 out/$b.rss 2>/dev/null) mem=$MEM box=${BOX}s traceFound=$tr blob=$(git hash-object $f) result=[$res]" >> runs.log
    17	}
    18	export -f one; export LIB MEM BOX
    19	printf '%s\n' "$@" | xargs -P "$JOBS" -I{} bash -c 'one "$1"' _ {}
