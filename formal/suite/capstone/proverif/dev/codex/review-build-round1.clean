    86	 "link3": "link 3", "link4": "link 4", "link5": "link 5", "link6a": "link 6a", "link6b": "link 6b",
    87	 "C-Q2": "C-Q2", "C-Q3-A": "C-Q3 `ReattributedA`", "C-Q3-B": "C-Q3 `ReattributedB`",
    88	 "C-Q4-Rescoped": "C-Q4 `Rescoped`", "C-Q4-InnerSig": "C-Q4 `InnerSigTransplanted`",
    89	 "C-Q5": "C-Q5", "C-Q5w-1": "`HonestComplete` (1-signer)", "C-Q5w-2": "`HonestComplete` (2-signer)",
    90	 "C-Q10": "C-Q10", "C-Q6-c1-unres": "C-Q6 c1 unrestricted", "C-Q6-c1-skI": "C-Q6 c1 `skI`",
    91	 "C-Q6-c1-skI2": "C-Q6 c1 `skI2`", "C-Q6-c2": "C-Q6 c2", "C-Q6-c3": "C-Q6 c3 `ScopeMisreported`",
    92	 "RET-accept": "`Accept(S) => IssuerSigned`", "RET-honestkey": "`AcceptedUnderHonestKey => IssuerSigned`",
    93	 "RET-Stripped": "`Stripped`", "RET-SignerForged": "`SignerForged`", "RET-Spliced": "`Spliced`",
    94	 "RET-TypeConfused": "`TypeConfused`", "RET-VersionLied": "`VersionLied`",
    95	 "W-HonestChainL0": "`HonestChain(L0)`", "W-HonestChainL1": "`HonestChain(L1)`",
    96	 "W-HonestChainL2": "`HonestChain(L2)`", "W-HonestAccepted": "`HonestAccepted`",
    97	 "W-HonestWrapped": "`HonestWrappedAccepted`", "W-HonestStanding": "`HonestStandingEstablished`",
    98	 "W-Agreed": "`HonestWrappedStandingAgreed`", "V-S1": "S1", "V-S2": "S2", "V-S3": "S3",
    99	 "V-S4": "S4", "V-MIS": "MISMATCH", "OBS-key": "observer `ScopeKeyOnly`",
   100	 "OBS-identity": "observer `ScopeIdentityOnly`",
   101	}
   102	HONEST_W = ["C-Q5w-1", "C-Q5w-2", "W-HonestChainL0", "W-HonestChainL1", "W-HonestChainL2",
   103	            "W-HonestAccepted", "W-HonestWrapped", "W-HonestStanding", "W-Agreed"]
   104	VOCAB_W = ["V-S1", "V-S2", "V-S3", "V-S4", "V-MIS"]
   105	WITNESS = HONEST_W + VOCAB_W
   106	SAFETY = [k for k, _ in KEYS if k not in WITNESS]          # includes the two observers
   107	C_Q3 = ("C-Q3-A", "C-Q3-B")
   108	
   109	NORM = re.compile(r"(^|[^K])_[0-9]+")
   110	
   111	
   112	def norm(ln):
   113	    prev = None
   114	    while prev != ln:
   115	        prev, ln = ln, NORM.sub(r"\1", ln)
   116	    return ln
   117	
   118	
   119	def parse(path):
   120	    """key -> (line, 'true'|'false').  Stops on an unkeyed or doubly-keyed RESULT line."""
   121	    d = {}
   122	    for n, ln in enumerate(open(path, errors="replace"), 1):
   123	        if not ln.startswith("RESULT"):
   124	            continue
   125	        s = norm(ln.rstrip())
   126	        v = "true" if s.endswith("is true.") else "false" if s.endswith("is false.") else None
   127	        if v is None:
   128	            sys.exit("UNREADABLE VERDICT %s:%d %s" % (path, n, s[-80:]))
   129	        hit = [k for k, r in KRE if r.search(s)]
   130	        if len(hit) != 1:
   131	            sys.exit("KEYING FAILURE %s:%d %s -> %s" % (path, n, s[:160], hit))
   132	        if hit[0] in d:
   133	            sys.exit("DUPLICATE KEY %s:%d %s (first :%d)" % (path, n, hit[0], d[hit[0]][0]))
   134	        d[hit[0]] = (n, v)
   135	    return d
   136	
   137	
   138	# ---------------------------------------------------------------------------------------------
   139	# 2. Ladder logs.
   140	# BROKEN-FIXTURE REPAIRS (added 2026-10-01, BF-4).  A ladder.log comment line
   141	#   "# BF-n REPAIR <UTC>: cap_x_{a,b,d} regenerated ..."
   142	# SUPERSEDES every earlier run of the named stems: those runs were of a broken fixture, so no
   143	# cell is filled from them (their .out/.rss are under ladder2-superseded/).  They are kept in
   144	# SUPERSEDED and still COUNT in the ceiling, which bounds what the ladder spent.
   145	BFRE = re.compile(r"^# (BF-\d+) REPAIR (\S+): (\S+) regenerated")
   146	SUPERSEDED = {}      # stem -> (BF id, [(logline, dict), ...])
   147	SUPDIR = os.path.join(PROV, "ladder2-superseded")
   148	
   149	
   150	def _expand(spec):
   151	    m = re.match(r"^(.*)\{([^}]*)\}(.*)$", spec)
   152	    return [m.group(1) + x + m.group(3) for x in m.group(2).split(",")] if m else [spec]
   153	
   154	
   155	def ladder(path, repairs=False):
   156	    """stem -> list of (logline, dict); and the list of '#' lines with numbers."""
   157	    runs = collections.defaultdict(list)
   158	    for n, ln in enumerate(open(path), 1):
   159	        m = BFRE.match(ln)
   160	        if repairs and m:
   161	            for stem in _expand(m.group(3)):
   162	                SUPERSEDED[stem] = (m.group(1), runs.pop(stem, []))
   163	            continue
   164	        if ln.startswith("#") or " rc=" not in ln:
   165	            continue
   166	        parts = ln.split()
   167	        dd = {}
   168	        for x in parts[1:]:
   169	            if "=" in x and not x.startswith("note="):
   170	                a, b = x.split("=", 1)
   171	                dd.setdefault(a, b)
   172	        runs[parts[0]].append((n, dd))
   173	    return runs
   174	
   175	
   176	L2RUNS = ladder(os.path.join(PROV, "ladder.log"), repairs=True)
   177	L1RUNS = ladder(os.path.join(L1, "ladder.log"))
   178	STEMS = sorted(os.path.basename(f)[:-3] for f in glob.glob(os.path.join(PROV, "*.pv")))
   179	
