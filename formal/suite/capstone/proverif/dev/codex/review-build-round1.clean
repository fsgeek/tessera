   181	def final(stem):
   182	    """The run's disposition under ladder 2: ('landed'|'timeout'|'memory', logline(s), dict)."""
   183	    rs = L2RUNS.get(stem, [])
   184	    if not rs:
   185	        return ("not run", [], {})
   186	    lines = [n for n, _ in rs]
   187	    n, d = rs[-1]
   188	    rc = d.get("rc")
   189	    if rc == "0":
   190	        return ("landed", lines, d)
   191	    if rc == "124":
   192	        return ("timeout", lines, d)
   193	    if rc in ("143", "MECHFAIL-MEMORY"):
   194	        # the seconds and peak of a MECHFAIL line are those of the rc=143 run it records
   195	        for nn, dd in rs:
     1	#!/usr/bin/env bash
     2	# STATUS: PROPOSED - 2026-09-19 - produced by the AI collaborator (Claude Opus 5,
     3	# builder, directed by the owner instance); not adopted; the commit is the author's.
     4	#
     5	# The capstone ladder runner.  Pattern: s-standing/proverif/run_ladder.sh.
     6	# Exit 124 from `timeout` = the registered TIMEOUT outcome (a mechanism-viability
     7	# failure, evidence about the tool or the encoding and NEVER about the property;
     8	# disposed by PREDICTIONS.md §3's ablation order, never by raising the box).
     9	#
    10	# ORDERING RULE (PREDICTIONS.md §3): "C-Q1's links before every companion;
    11	# (a), (b), (d) before (c); C-Q7, C-Q8, C-Q9 before links 3 and 4 and before
    12	# C-Q6."  The last clause is a QUERY order and is honoured by the declaration
    13	# order inside capstone.pv.  The first two are RUN order and are honoured here:
    14	# the three correct-form runs complete (a barrier) before any companion starts,
    15	# and case (c) - which IS companion C-C1 - runs after them.
    16	#
    17	# TIMEBOXES (PREDICTIONS.md §3 "Timeboxes declared").  Each .pv here carries
    18	# EVERY registered query of its case, so each run is given the PER-CASE SUM of
    19	# the registered boxes: 1185 min for a strict case (27 entries), 1095 min for
    20	# the degraded case (which asserts neither C-Q1 link 1b nor C-Q2).  Because the
    21	# whole-model wall clock is an upper bound on every query's own time, a run that
    22	# finishes under 30 minutes is inside the smallest registered box for every
    23	# query it carries; run_ladder.sh records the seconds so that can be checked.
    24	# No companion carries a box of its own (§4, "The count"): it runs inside the
    25	# box of the query it is predicted to red, and a fortiori inside the sum.
    26	#
    27	# PARALLELISM (scheduling only; no box, model, query or prediction changes).
    28	# JOBS was 6 and is now 3, at the owner instance's instruction after the
    29	# 19:11:24 UTC memory event: 12 cores is not this machine's limit, 31 GB is.
    30	# A companion's ProVerif process grows to 3-9 GB -- eight concurrent runs took
    31	# the machine to 0 GB available and 5.4 GB of swap, and the kernel OOM killer
    32	# would have chosen a victim for us within minutes, at random and unrecorded.
    33	# Each run still gets its own process and its own `timeout`, so no run's box is
    34	# shortened by another's.
    35	#
    36	# KILLED RUNS ARE RERUN.  A ladder.log line whose rc is 137 (SIGKILL) or 143
    37	# (SIGTERM) records a run that was killed, not a result.  It STAYS in the log as
    38	# history, and the file is run again -- the skip guard below ignores such lines.
    39	# Any other logged rc means the run landed, and the file is skipped.

exec
