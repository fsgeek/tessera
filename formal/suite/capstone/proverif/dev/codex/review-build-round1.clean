   674	OBSQ = """
   675	(* ---- the TWO ISOLATION OBSERVERS, queried HERE AND NOWHERE ELSE.
   676	   They are observers, not queries: never counted among the 27 registered
   677	   entries, never timeboxed on their own, and no discharge of any matrix row
   678	   rests on either of them.  Configuration (iii) requires the IDENTITY
   679	   observer REACHABLE and the KEY observer UNREACHABLE. *)
   680	query a: bitstring, l: bitstring, k: pkey, ka: pkey; event(ScopeKeyOnly(a, l, k, ka)).
   681	query a: bitstring, l: bitstring, i1: bitstring, i2: bitstring;
   682	  event(ScopeIdentityOnly(a, l, i1, i2)).
   683	"""
