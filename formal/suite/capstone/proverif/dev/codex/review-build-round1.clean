    55	def edit(text, block, old, new, count=None):
    56	    """Replace `old` by `new` everywhere inside `block`.  At least one block of a
    57	    group must contain it; fails loudly if none does."""
    58	    blocks = BLOCKGROUPS.get(block, [block])
    59	    total = 0
    60	    for b in blocks:
    61	        s, e = MARKS[b]
    62	        i = 0 if s is None else text.index(s)
    63	        j = len(text) if e is None else text.index(e, i)
    64	        seg = text[i:j]
    65	        total += seg.count(old)
    66	        text = text[:i] + seg.replace(old, new) + text[j:]
    67	    if total == 0:
    68	        raise SystemExit("derive.py: not found in %s: %r" % (block, old[:70]))
    69	    if count is not None and total != count:
    70	        raise SystemExit("derive.py: %d occurrences (wanted %d) in %s: %r"
    71	                         % (total, count, block, old[:70]))
    72	    return text
    73	
    74	
    75	def drop(text, block, line):
    76	    """Delete a whole source line (matched by its stripped prefix).  A line may
    77	    be absent from some blocks of a group (the one-signer branches have no slot
    78	    B); at least one block must contain it."""
    79	    blocks = BLOCKGROUPS.get(block, [block])
    80	    total = 0
    81	    for b in blocks:
    82	        s, e = MARKS[b]
    83	        i = 0 if s is None else text.index(s)
    84	        j = len(text) if e is None else text.index(e, i)
    85	        seg = text[i:j]
    86	        keep = []
    87	        for ln in seg.split("\n"):
    88	            if ln.strip().startswith(line):
    89	                total += 1
    90	                continue
    91	            keep.append(ln)
    92	        text = text[:i] + "\n".join(keep) + text[j:]
    93	    if total == 0:
    94	        raise SystemExit("derive.py: no line starting %r in %s" % (line, block))
    95	    return text
