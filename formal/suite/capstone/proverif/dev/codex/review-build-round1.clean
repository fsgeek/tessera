   319	query l: bitstring; event(ChainBroken(l, LINK_6A)).
   320	
   321	(* ---- C-Q1 link 6b — bytes -> innermost-issuer SCOPE ----------------- *)
   322	query l: bitstring; event(ChainBroken(l, LINK_6B)).
   323	
   324	(* ---- C-Q2 — the §A3.2.1 boundary judge, PAIR FORM (D9) -------------- *)
   325	query evD: bitstring, evR: bitstring, t1: bitstring, t2: bitstring;
   326	  event(TwoWorldsBroken(evD, evR, t1, t2)).
   327	
   328	(* ---- C-Q3 — the multi-signer key-binding judge, PER ROLE (D1) ------- *)
   329	query kX: pkey, kH: pkey, fb: bitstring; event(ReattributedA(kX, kH, fb)).
   330	query kX: pkey, kH: pkey, fb: bitstring; event(ReattributedB(kX, kH, fb)).
   331	
   332	(* ---- C-Q4 — the wrapped-attribution judges (D2, D5) ----------------- *)
   333	query kX: pkey, idX: bitstring, kH: pkey, idH: bitstring, fb: bitstring;
   334	  event(Rescoped(kX, idX, kH, idH, fb)).
   335	query kX: pkey, s: bitstring; event(InnerSigTransplanted(kX, s)).
   336	
   337	(* ---- C-Q5 — SetAltered (D10) ---------------------------------------- *)
   338	query kH: pkey, m: bitstring, t: bitstring; event(SetAltered(kH, m, t)).
   339	
   340	(* ---- C-Q5w — the honest-flow witness for C-Q5, one per set size ----- *)
   341	query k1: pkey;
   342	  event(HonestComplete(authTuple(issuerId, fp(pk(skI2)), signers0, algH, verH),
   343	                       verified1(k1))).
   344	query k1: pkey, k2: pkey;
   345	  event(HonestComplete(authTuple(issuerId2, fp(pk(skI)), signers1(fp(pk(skB2))), algH, verH),
   346	                       verified2(k1, k2))).
   347	
   348	(* ---- C-Q10 — the D-6 tag-separation judge --------------------------- *)
   349	query k: pkey, tg: bitstring; event(TagConfused(k, tg)).
   350	
   351	(* ---- C-Q6 — the wrapped-standing composition, formulation W --------- *)
   352	(* conjunct 1, the standing verdict (D12): unrestricted, then the two    *)
   353	(* honest-key forms (ENUM note 3's two-honest-values rule)               *)
   354	query aid: bitstring, lyr: bitstring, t: bitstring, kX: pkey, co: bitstring;
   355	  event(EstablishedWrapped(aid, lyr, t, kX, co, ESTABLISHED))
   356	    ==> event(Designated(kX, h(co))).
   357	query aid: bitstring, lyr: bitstring, t: bitstring, co: bitstring;
   358	  event(EstablishedWrapped(aid, lyr, t, pk(skI), co, ESTABLISHED))
   359	    ==> event(Designated(pk(skI), h(co))).
   360	query aid: bitstring, lyr: bitstring, t: bitstring, co: bitstring;
   361	  event(EstablishedWrapped(aid, lyr, t, pk(skI2), co, ESTABLISHED))
   362	    ==> event(Designated(pk(skI2), h(co))).
   363	(* conjunct 2, the entitled key (D13) *)
   364	query kX: pkey, t: bitstring; event(StandingUnentitledWrapped(kX, t)).
   365	(* conjunct 3, scope agreement (D11's conditional half) — the PAIR judge *)
   366	query a: bitstring, l: bitstring, k: pkey, ii: bitstring, ka: pkey, ia: bitstring;
   367	  event(ScopeMisreported(a, l, k, ii, ka, ia)).
   368	
   369	(* ---- the REQUIRED retained queries (LEDGER.md:1425-1447) ------------ *)
   370	query evD: bitstring, evR: bitstring, t: bitstring, k: pkey, fb: bitstring;
   371	  event(Accept(evD, evR, t, k, fb)) ==> event(IssuerSigned(k, fb)).
   372	query k: pkey, fb: bitstring;
   373	  event(AcceptedUnderHonestKey(k, fb)) ==> event(IssuerSigned(k, fb)).
   374	query t: bitstring, v: bitstring; event(Stripped(t, v)).
   375	query t: bitstring, k: pkey; event(SignerForged(t, k)).
   376	query t: bitstring, fa: bitstring, fb: bitstring; event(Spliced(t, fa, fb)).
   377	query otS: bitstring, otA: bitstring, fb: bitstring; event(TypeConfused(otS, otA, fb)).
   378	query fbq: bitstring, cvRec: bitstring, cvAct: bitstring;
   379	  event(VersionLied(fbq, cvRec, cvAct)).
   380	
   381	(* ---- C-N1 — the vacuity witnesses: must be REACHABLE ---------------- *)
   382	query t: bitstring; event(HonestChain(L0, t)).
   383	query t: bitstring; event(HonestChain(L1, t)).
   384	query t: bitstring; event(HonestChain(L2, t)).
   385	query k: pkey, fb: bitstring; event(HonestAccepted(k, fb)).
   386	query kH: pkey, fb: bitstring, kW: pkey; event(HonestWrappedAccepted(kH, fb, kW)).
   387	query k: pkey, aid: bitstring; event(HonestStandingEstablished(k, aid)).
   388	query a: bitstring, l: bitstring; event(HonestWrappedStandingAgreed(a, l)).
   389	
   390	(* ---- the five VOCABULARY witnesses (§3, C-N1's two kinds) ----------- *)
   391	query k: pkey, t: bitstring, a: bitstring;
   392	  event(StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, k, t, a)).
   393	query k: pkey, t: bitstring, a: bitstring;
   394	  event(StandingReport(ABSENT, SUPERSEDED, k, t, a)).
   395	query k: pkey, t: bitstring, a: bitstring;
   396	  event(StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, k, t, a)).
   397	query k: pkey, t: bitstring, a: bitstring;
   398	  event(StandingReport(ABSENT, ISSUANCE_REFUSED, k, t, a)).
   399	query k: pkey, t: bitstring, a: bitstring;
   400	  event(StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, k, t, a)).
   401	
   402	(* ==================================================================== *)
   403	(* ==== THE FIXTURE'S HONEST PROCESSES (§1.1) ========================= *)
   404	(* ==================================================================== *)
   405	
   406	(* --- the two authority channels, strict form (D-1, digest binding) --- *)
   407	let AuthorityDNS(skDp: skey, t: bitstring) =
   408	  event AuthorityPublishedDNS(t);
   409	  out(c, sign((STMT_DIGEST, h(t)), skDp)).
   410	
   411	let AuthorityRepo(skRp: skey, t: bitstring) =
   412	  event AuthorityPublishedRepo(t);
   413	  out(c, sign((STMT_DIGEST, h(t)), skRp)).
   414	
   415	(* --- an honest attester: ONE KEY, ONE MANIFEST (§1.1) ---------------- *)
   416	let Attester(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   417	  in(c, payload: bitstring);
   418	  event IssuerPossession(pk(sk));
   419	  let ppf = sign((POSS, m), sk) in
   420	  out(c, ppf);
   421	  let fb = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, payload) in
   422	  let sg = sign((BYTES, fb), sk) in
   423	  event IssuerSigned(pk(sk), fb);
   424	  ( out(honestTypeCh, (OT_ATTEST, fb))
   425	  | out(honestCh, (pk(sk), fb))
   426	  | out(honestInnerCh, (pk(sk), id, fb))
   427	  | out(honestSigCh, (pk(sk), sg))
   428	  | out(gsigHonCh, (pk(sk), sg))
   429	  | out(honestChainCh, (pk(sk), m, fb))
   430	  | out(c, sg) ).
   431	
   432	(* --- an honest issuer with a two-entry lineage: S-STANDING's          *)
   433	(* ShipIssuer, emitting the honest reports an Attester does for both    *)
   434	(* attempts, so the composed judges can pair with them.                 *)
   435	let ShipIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   436	  in(c, (p1: bitstring, p2: bitstring));
   437	  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
   438	  event IssuerPossession(pk(sk));
   439	  let ppf = sign((POSS, m), sk) in
   440	  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
   441	  let sg1 = sign((BYTES, fb1), sk) in
   442	  let core1 = attemptCore(m, ppf, sg1, decl1) in
   443	  event IssuerSigned(pk(sk), fb1);
   444	  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
   445	  let sg2 = sign((BYTES, fb2), sk) in
   446	  let core2 = attemptCore(m, ppf, sg2, decl2) in
   447	  event IssuerSigned(pk(sk), fb2);
   448	  event Designated(pk(sk), h(core2));
   449	  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_SHIPPED)),
   450	              TERM_SHIPPED(h(core2)), declT) in
   451	  ( out(c, ppf)
   452	  | out(c, (core1, fb1, sg1))
   453	  | out(c, (core2, fb2, sg2))
   454	  | out(designCh, (pk(sk), h(core2)))
   455	  | out(c, sign((TLR, body), sk))
   456	  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
   457	  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
   458	  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
   459	  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
   460	  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
   461	  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).
   462	
   463	(* --- the second terminal disposition: both attempts abandoned -------- *)
   464	let RefuseIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   465	  in(c, (p1: bitstring, p2: bitstring));
   466	  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
   467	  event IssuerPossession(pk(sk));
   468	  let ppf = sign((POSS, m), sk) in
   469	  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
   470	  let sg1 = sign((BYTES, fb1), sk) in
   471	  let core1 = attemptCore(m, ppf, sg1, decl1) in
   472	  event IssuerSigned(pk(sk), fb1);
   473	  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
   474	  let sg2 = sign((BYTES, fb2), sk) in
   475	  let core2 = attemptCore(m, ppf, sg2, decl2) in
   476	  event IssuerSigned(pk(sk), fb2);
   477	  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_ABANDONED)),
   478	              TERM_REFUSED, declT) in
   479	  ( out(c, ppf)
   480	  | out(c, (core1, fb1, sg1))
   481	  | out(c, (core2, fb2, sg2))
   482	  | out(c, sign((TLR, body), sk))
   483	  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
   484	  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
   485	  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
   486	  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
   487	  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
   488	  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).
   489	
   490	(* --- an honest wrapper: frames an adversary-chosen inner blob -------- *)
   491	let Wrapper(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   492	  in(c, (cvIw: bitstring, fbIA: bitstring, sgIA: bitstring,
   493	         fbIB: bitstring, sgIB: bitstring));
   494	  event IssuerPossession(pk(sk));
   495	  let ppf = sign((POSS, m), sk) in
   496	  out(c, ppf);
   497	  let fb = framed(OT_WRAPPER, algH, id, fp(pk(sk)), h(m), cv,
   498	                  wrap(cvIw, (fbIA, sgIA, fbIB, sgIB))) in
   499	  let sg = sign((BYTES, fb), sk) in
   500	  event IssuerSigned(pk(sk), fb);
   501	  ( out(honestTypeCh, (OT_WRAPPER, fb))
   502	  | out(honestCh, (pk(sk), fb))
   503	  | out(honestChainCh, (pk(sk), m, fb))
   504	  | out(gsigHonCh, (pk(sk), sg))
   505	  | out(c, sg) ).
   506	
   507	(* --- the FOREIGN-TAG SIGNER (§1.1, AMENDMENT 2026-09-18) ------------- *)
   508	(* The honest issuer key emits sign((REFUSAL, body), skI) for an         *)
   509	(* adversary-chosen core, body a TLR-shaped triple. It is a FOREIGN-TAG  *)
   510	(* SOURCE and nothing else: its body is opaque to every check while the  *)
   511	(* tag check stands, and chosen TLR-shaped as the worst case for         *)
   512	(* separation. It models NOTHING about the refusal record (A3 §A3.7.2,   *)
   513	(* L2-n, BAND0-EXIT E6). REFUSAL is exercised as a signing DOMAIN and    *)
   514	(* unexercised as a RECORD. Copied from the 2026-09-06 reviewer fixture  *)
   515	(* a_foreign_tag.pv:339-342.                                             *)
   516	let ForeignIssuer(sk: skey) =
   517	  in(c, foreignCore: bitstring);
   518	  let body = (lineage2(entry(h(foreignCore), DISP_SHIPPED), entry(fbH, DISP_ABANDONED)),
   519	              TERM_SHIPPED(h(foreignCore)), fbH) in
   520	  out(c, sign((REFUSAL, body), sk)).
   521	
   522	(* ==================================================================== *)
   523	(* ==== THE FRONT END: one fresh aid per PRESENTATION, at INTAKE ====== *)
   524	(* (§1.3). It reads the presented bundle once and forwards it on private *)
   525	(* channels to the envelope path and the standing path IN PARALLEL       *)
   526	(* (§1.2 "parallel to, never sequenced behind"; encoding rule (1)).      *)
   527	(* The name exists BEFORE any check runs, so a path may carry it without *)
   528	(* thereby asserting that the other path succeeded.                      *)
   529	(* ==================================================================== *)
   530	let Front =
   531	  (* ONE read of the presented bundle: the frames and signatures of the
   532	     outermost object, the per-layer verification material for L0, L1 and L2,
   533	     and the standing path's core and standing evidence.  Everything a path
   534	     uses below comes from THIS read.                                          *)
   535	  in(c, (fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring,
   536	         t0: bitstring, ev0D: bitstring, ev0R: bitstring,
   537	         kA0: pkey, ppfA0: bitstring, kB0: pkey, ppfB0: bitstring,
   538	         t1: bitstring, ev1D: bitstring, ev1R: bitstring,
   539	         kA1: pkey, ppfA1: bitstring, kB1: pkey, ppfB1: bitstring,
   540	         t2: bitstring, ev2D: bitstring, ev2R: bitstring,
   541	         kA2: pkey, ppfA2: bitstring, kB2: pkey, ppfB2: bitstring,
   542	         coreIn: bitstring, seIn: bitstring));
   543	  new aid: bitstring;
   544	  ( out(stageCh,  (aid, L0, BASE, kNone, idAdv, fbA, sgA, fbB, sgB))
   545	  | out(sStageCh, (aid, L0, fbA, sgA, fbB, sgB))
   546	  | !out(envMat, (aid, L0, t0, ev0D, ev0R, kA0, ppfA0, kB0, ppfB0))
   547	  | !out(envMat, (aid, L1, t1, ev1D, ev1R, kA1, ppfA1, kB1, ppfB1))
   548	  | !out(envMat, (aid, L2, t2, ev2D, ev2R, kA2, ppfA2, kB2, ppfB2))
   549	  | !out(stdMat, (aid, L0, t0, ev0D, ev0R, kA0, ppfA0, kB0, ppfB0))
   550	  | !out(stdMat, (aid, L1, t1, ev1D, ev1R, kA1, ppfA1, kB1, ppfB1))
   551	  | !out(stdMat, (aid, L2, t2, ev2D, ev2R, kA2, ppfA2, kB2, ppfB2))
   552	  | !out(standCore, (aid, coreIn, seIn)) ).
   553	
   554	(* ==================================================================== *)
   555	(* ==== THE ENVELOPE PATH: one acceptance path per layer (§1.2) ======= *)
   556	(*                                                                      *)
   557	(* AttestStage is the capstone's InnerCheck: it accepts ONE layer whose  *)
   558	(* object type is OT_ATTEST, with the layer index carried on stageCh.    *)
   559	(* It is SHARED by the base path (L0) and by the innermost layer of a    *)
   560	(* wrapped presentation (L1 at depth 1, L2 at depth 2), exactly as       *)
   561	(* S-P7's InnerCheck is shared by VerifierBase and VerifierWrapped.      *)
   562	(*                                                                      *)
   563	(* Checks, in §1.2's order:                                             *)
   564	(*  1 accepted authority evidence, per channel, checksign(ev,kCh) =     *)
   565	(*    (STMT_DIGEST, h(t))                            [S-P1 / first link] *)
   566	(*  2 key binding: the frame's kfp is fp(kX), and mh = h(t)     [S-P3]   *)
   567	(*  3 set logic: the signed t's required set names the slot,            *)
   568	(*    fp(kX) = kfpr, every required slot satisfied              [S-P2]   *)
   569	(*  4 common content: ota = otb, cva = cvb, pla = plb, plus alg, id     *)
   570	(*    pinned through t                                       [S-P2 Q6]   *)
   571	(*  5 type, opacity and recorded-version checks                 [S-P7]   *)
   572	(*  6 possession over the ACCEPTED MANIFEST under the ACCEPTING KEY,    *)
   573	(*    checksign(ppf,kX) = (POSS,t)                       [S-P3 / S-P2]   *)
   574	(* (7 is the standing path, which runs in parallel — below.)            *)
   575	(* ==================================================================== *)
   576	let AttestStage(pkDv: pkey, pkRv: pkey) =
   577	  in(stageCh, (aid: bitstring, lyr: bitstring, ctx: bitstring,
   578	               kEnc: pkey, idEnc: bitstring,
   579	               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
   580	  in(envMat, (=aid, =lyr, t: bitstring, evD: bitstring, evR: bitstring,
   581	              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
   582	  (* CHECK 1 *)
   583	  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in
   584	  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in
   585	  event AuthorityEvidence(t, evD, pkDv);
   586	  event AuthorityEvidence(t, evR, pkRv);
   587	  let authTuple(id, kfprA, ss, alg, ver) = t in
   588	  ( (* ---------------- the one-signer branch ---------------- *)
   589	    ( if ss = signers0 then
   590	      if fp(kA) = kfprA then                                            (* 3 *)
   591	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
   592	      if mhA = h(t) then                                                (* 2 *)
   593	      if otA = OT_ATTEST then                                           (* 5 *)
   594	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   595	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   596	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   597	      event SlotSatisfied(aid, lyr, t, kfprA);
   598	      event AcceptanceComplete(aid, lyr, t);
   599	      event Accept(evD, evR, t, kA, fbA);
   600	      event ScopeReported(aid, lyr, kA, id);
   601	      ( out(link1aCh, (lyr, t, evD, evR))
   602	      | out(link2aCh, (lyr, t, kfprA, kA))
   603	      | out(possCh, (lyr, kA, t, ppfA))
   604	      | out(bytesCh, (lyr, kA, sgA, fbA))
   605	      | out(link5Ch, (lyr, t, kA, fbA))
   606	      | out(link6aCh, (lyr, OT_ATTEST, fbA))
   607	      | out(link6bCh, (aid, lyr, kA, id, fbA))
   608	      | out(typeCh, (OT_ATTEST, fbA))
   609	      | out(slotCh, (t, kfprA, kA))
   610	      | out(setCh, (t, verified1(kA)))
   611	      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
   612	      | out(acceptKeyCh, (kA, fbA))
   613	      | out(scopeCh, (ctx, kA, id, fbA))
   614	      | out(sigCh, (ctx, kA, sgA))
   615	      | out(gsigCh, (kA, sgA))
   616	      | out(twoWorldsCh, (evD, evR, t))
   617	      | out(chainCh, (lyr, kA, t, fbA))
   618	      | out(scopeEnvelope, (aid, lyr, kA, id)) ) )
   619	  | (* ---------------- the two-signer branch ---------------- *)
   620	    ( let signers1(kfprB) = ss in
   621	      if fp(kA) = kfprA then                                            (* 3 *)
   622	      if fp(kB) = kfprB then                                            (* 3 *)
   623	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
   624	      if mhA = h(t) then                                                (* 2 *)
   625	      let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in      (* 2 *)
   626	      if mhB = h(t) then                                                (* 2 *)
   627	      if otA = OT_ATTEST then                                           (* 5 *)
   628	      if otB = OT_ATTEST then                                           (* 5 *)
   629	      if otA = otB then                                                 (* 4 *)
   630	      if cvsA = cvsB then                                               (* 4 *)
   631	      if plA = plB then                                                 (* 4 *)
   632	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   633	      let (=POSS, =t) = checksign(ppfB, kB) in                          (* 6 *)
   634	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   635	      let (=BYTES, =fbB) = checksign(sgB, kB) in
   636	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   637	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprB, kB, ppfB, sgB, fbB);
   638	      event SlotSatisfied(aid, lyr, t, kfprA);
   639	      event SlotSatisfied(aid, lyr, t, kfprB);
   640	      event AcceptanceComplete(aid, lyr, t);
   641	      event Accept(evD, evR, t, kA, fbA);
   642	      event Accept(evD, evR, t, kB, fbB);
   643	      event ScopeReported(aid, lyr, kA, id);
   644	      ( out(link1aCh, (lyr, t, evD, evR))
   645	      | out(link2aCh, (lyr, t, kfprA, kA)) | out(link2aCh, (lyr, t, kfprB, kB))
   646	      | out(possCh, (lyr, kA, t, ppfA)) | out(possCh, (lyr, kB, t, ppfB))
   647	      | out(bytesCh, (lyr, kA, sgA, fbA)) | out(bytesCh, (lyr, kB, sgB, fbB))
   648	      | out(link5Ch, (lyr, t, kA, fbA)) | out(link5Ch, (lyr, t, kB, fbB))
