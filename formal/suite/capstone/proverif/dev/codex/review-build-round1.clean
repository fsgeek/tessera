     1	#!/usr/bin/env bash
     2	# STATUS: PROPOSED - 2026-09-19 - produced by the AI collaborator (Claude Opus 5,
     3	# builder, directed by the owner instance); not adopted; the commit is the author's.
     4	#
     5	# The capstone ladder runner.  Pattern: s-standing/proverif/run_ladder.sh.
     6	# Exit 124 from `timeout` = the registered TIMEOUT outcome (a mechanism-viability
     7	# failure, evidence about the tool or the encoding and NEVER about the property;
     8	# disposed by PREDICTIONS.md §3's ablation order, never by raising the box).
     9	#
    10	# ORDERING RULE (PREDICTIONS.md §3): "C-Q1's links before every companion;
    11	# (a), (b), (d) before (c); C-Q7, C-Q8, C-Q9 before links 3 and 4 and before
    12	# C-Q6."  The last clause is a QUERY order and is honoured by the declaration
    13	# order inside capstone.pv.  The first two are RUN order and are honoured here:
    14	# the three correct-form runs complete (a barrier) before any companion starts,
    15	# and case (c) - which IS companion C-C1 - runs after them.
    16	#
    17	# TIMEBOXES (PREDICTIONS.md §3 "Timeboxes declared").  Each .pv here carries
    18	# EVERY registered query of its case, so each run is given the PER-CASE SUM of
    19	# the registered boxes: 1185 min for a strict case (27 entries), 1095 min for
    20	# the degraded case (which asserts neither C-Q1 link 1b nor C-Q2).  Because the
    21	# whole-model wall clock is an upper bound on every query's own time, a run that
    22	# finishes under 30 minutes is inside the smallest registered box for every
    23	# query it carries; run_ladder.sh records the seconds so that can be checked.
    24	# No companion carries a box of its own (§4, "The count"): it runs inside the
    25	# box of the query it is predicted to red, and a fortiori inside the sum.
    26	#
    27	# PARALLELISM (scheduling only; no box, model, query or prediction changes).
    28	# JOBS was 6 and is now 3, at the owner instance's instruction after the
    29	# 19:11:24 UTC memory event: 12 cores is not this machine's limit, 31 GB is.
    30	# A companion's ProVerif process grows to 3-9 GB -- eight concurrent runs took
    31	# the machine to 0 GB available and 5.4 GB of swap, and the kernel OOM killer
    32	# would have chosen a victim for us within minutes, at random and unrecorded.
    33	# Each run still gets its own process and its own `timeout`, so no run's box is
    34	# shortened by another's.
    35	#
    36	# KILLED RUNS ARE RERUN.  A ladder.log line whose rc is 137 (SIGKILL) or 143
    37	# (SIGTERM) records a run that was killed, not a result.  It STAYS in the log as
    38	# history, and the file is run again -- the skip guard below ignores such lines.
    39	# Any other logged rc means the run landed, and the file is skipped.
    40	#
    41	# PEAK MEMORY is recorded per run (`/usr/bin/time -f %M`, kB) so a reader can see
    42	# what each companion cost in memory as well as in seconds.
    43	
    44	cd "$(dirname "$0")"
    45	LIB=../../lib/tessera_theory.pvl
    46	JOBS=${JOBS:-3}
    47	BOX_STRICT=$((1185 * 60))
    48	BOX_DEGRADED=$((1095 * 60))
    49	
    50	# ladder.log is APPENDED to: a file whose run is already logged is skipped, so
    51	# the ladder can be resumed without re-running what has landed.
    52	touch ladder.log
    53	echo "# capstone ladder — $(date -u +%Y-%m-%dT%H:%M:%SZ) — ProVerif 2.05 — -lib $LIB" >> ladder.log
    54	echo "# model: capstone.pv blob $(git hash-object capstone.pv)" >> ladder.log
    55	
    56	box_for() { case "$1" in *_d.pv) echo $BOX_DEGRADED ;; *) echo $BOX_STRICT ;; esac; }
    57	
    58	TIMER=$(command -v /usr/bin/time || true)
    59	
    60	run() {
    61	  local f=$1 box; box=$(box_for "$f")
    62	  # A file marked as a MECHANISM FAILURE is not rerun unablated: section 3's
    63	  # ablation order applies to it instead, and that is a judgement recorded in
    64	  # RESULTS.md, not something this runner makes.
    65	  if [ -f "${f%.pv}.mechfail" ]; then
    66	    echo "${f%.pv} rc=MECHFAIL-MEMORY seconds=0 box=${box}s note=$(tr -d '\n' < "${f%.pv}.mechfail")" >> ladder.log
    67	    return 0
    68	  fi
    69	  # skip only if this file has a logged run that was NOT killed (137/143)
    70	  # Skip only if this file has at least one logged run that was NOT killed.
    71	  # (Written as three stages on purpose: `grep -qv` on EMPTY input returns 0 on
    72	  # this system, so the two-stage form would have skipped every unrun file.)
    73	  if grep -E "^${f%.pv} rc=" ladder.log | grep -vE "rc=(137|143) " | grep -q .; then
    74	    return 0
    75	  fi
    76	  local s=$(date +%s) rc rss="?"
    77	  if [ -n "$TIMER" ]; then
    78	    "$TIMER" -f %M -o "${f%.pv}.rss" timeout "$box" proverif -lib $LIB "$f" > "${f%.pv}.out" 2>&1
    79	    rc=$?
    80	    rss=$(tail -1 "${f%.pv}.rss" 2>/dev/null)
    81	  else
    82	    timeout "$box" proverif -lib $LIB "$f" > "${f%.pv}.out" 2>&1
    83	    rc=$?
    84	  fi
    85	  echo "${f%.pv} rc=$rc seconds=$(( $(date +%s) - s )) peakRSSkB=${rss:-?} box=${box}s blob=$(git hash-object "$f")" >> ladder.log
    86	}
    87	
    88	wave() {   # run the named files, at most $JOBS at a time, then wait for THIS
    89	           # wave's jobs only (a bare `wait` would also block on the case (c)
    90	           # and case (d) runs that deliberately proceed alongside).
    91	  local n=0; local pids=()
    92	  for f in "$@"; do
    93	    [ -f "$f" ] || { echo "${f%.pv} rc=MISSING seconds=0 box=0s" >> ladder.log; continue; }
    94	    # 2026-09-20 (owner instance, scheduling only): a file that has already landed
    95	    # is skipped HERE, before it is counted, so that JOBS counts RUNNING jobs.  Before
    96	    # this line the counter counted skipped files too, and on resume a big companion
    97	    # sitting beside two landed files ran alone; the first hour on ubuntu24 showed it.
    98	    if [ ! -f "${f%.pv}.mechfail" ] && grep -E "^${f%.pv} rc=" ladder.log | grep -vE "rc=(137|143) " | grep -q .; then continue; fi
    99	    run "$f" & pids+=($!)
   100	    n=$((n+1))
