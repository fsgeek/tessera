   544	
   545	# ---------------------------------------------------------------- C-C15 ----
   546	# D11's companion needs the ATTESTATION layer to behave differently when it is
   547	# reached THROUGH A WRAPPER, exactly as S-P7's Q6b/Q5c/Q6a companions mutate
   548	# the wrapped path and leave VerifierBase alone.  The capstone shares one
   549	# AttestStage between the base path and the innermost layer, so the mutant
   550	# SPLITS it: the correct stage keeps the cases the configuration does not
   551	# touch, and a copy, AttestStageW, carries the mutation for the wrapped ones.
   552	# This is a block duplication, not a line edit; it is the only companion that
   553	# needs one, and it is written out here so the delta can be read.
   554	ATT_START = "let AttestStage(pkDv: pkey, pkRv: pkey) ="
   555	ATT_START_D = "let AttestStage(pkSv: pkey) ="
   556	ATT_END = "(* ==================================================================== *)\n(* ==== THE WRAPPER LAYER"
   557	
   558	
   559	def _split_attest(t, guard_correct, guard_w, muts):
   560	    start = ATT_START if ATT_START in t else ATT_START_D
   561	    i = t.index(start)
   562	    j = t.index(ATT_END, i)
   563	    body = t[i:j]
   564	    # the point after the two input prefixes, where a guard may be inserted
   565	    anchor = "         kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));\n"
   566	    k = body.index(anchor) + len(anchor)
   567	    correct = body[:k] + guard_correct + body[k:]
   568	    w = body[:k] + guard_w + body[k:]
   569	    w = w.replace("let AttestStage(", "let AttestStageW(", 1)
   570	    applied = 0
   571	    for old, new in muts:
   572	        if old not in w:
   573	            continue          # mode-specific line (evD/evR vs ev, slot B, ...)
   574	        w = w.replace(old, new); applied += 1
   575	    if applied == 0:
   576	        raise SystemExit("derive.py C-C15: no mutation applied")
   577	    t = t[:i] + correct + "\n" + w + t[j:]
   578	    t = t.replace("  | !AttestStage(pk(skD), pk(skR))",
   579	                  "  | !AttestStage(pk(skD), pk(skR)) | !AttestStageW(pk(skD), pk(skR))")
   580	    t = t.replace("  | !AttestStage(pk(skS))",
   581	                  "  | !AttestStage(pk(skS)) | !AttestStageW(pk(skS))")
   582	    return t
   583	
   584	
   585	WCTX = ("  let wctx(kEncW: pkey, idEncW: bitstring, fbEncW: bitstring) = ctx in\n")
   586	
   587	# attribution rewrites shared by (i) and (ii): the layer reports the ENCLOSING
   588	# wrapper's key and identity in place of its own accepting key and identity.
   589	ATTRIB_BOTH = [
   590	  ("event ScopeReported(aid, lyr, kA, id);", "event ScopeReported(aid, lyr, kEncW, idEncW);"),
   591	  ("out(link6bCh, (aid, lyr, kA, id, fbA))", "out(link6bCh, (aid, lyr, kEncW, idEncW, fbA))"),
   592	  ("out(scopeCh, (ctx, kA, id, fbA))", "out(scopeCh, (ctx, kEncW, idEncW, fbA))"),
   593	  ("out(scopeCh, (ctx, kB, id, fbB))", "out(scopeCh, (ctx, kEncW, idEncW, fbB))"),
   594	  ("out(scopeEnvelope, (aid, lyr, kA, id))", "out(scopeEnvelope, (aid, lyr, kEncW, idEncW))"),
   595	]
   596	ATTRIB_ID = [
   597	  ("event ScopeReported(aid, lyr, kA, id);", "event ScopeReported(aid, lyr, kA, idEncW);"),
   598	  ("out(link6bCh, (aid, lyr, kA, id, fbA))", "out(link6bCh, (aid, lyr, kA, idEncW, fbA))"),
   599	  ("out(scopeCh, (ctx, kA, id, fbA))", "out(scopeCh, (ctx, kA, idEncW, fbA))"),
   600	  ("out(scopeCh, (ctx, kB, id, fbB))", "out(scopeCh, (ctx, kB, idEncW, fbB))"),
   601	  ("out(scopeEnvelope, (aid, lyr, kA, id))", "out(scopeEnvelope, (aid, lyr, kA, idEncW))"),
   602	]
   603	
   604	
   605	def cc15i(t):
   606	    # S-P7 Q6b transcribed: on the wrapped path the key and authority are read
   607	    # from the WRAPPER frame.  The inner signature is verified under kW; the
   608	    # presented inner tuple, evidence, possession proof and frame fields are
   609	    # read but NEVER MATCHED.  Under §1.3's report contract the acceptance
   610	    # carries the terms that layer's acceptance was ABOUT.
   611	    muts = [
   612	      ("  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in\n", ""),
   613	      ("  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in\n", ""),
   614	      ("  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in\n", ""),
   615	      ("if fp(kA) = kfprA then", "if true then"),
   616	      ("if fp(kB) = kfprB then", "if true then"),
   617	      ("let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in",
   618	       "let framed(otA, algxA, idxA, kfpxA, mhA, cvsA, plA) = fbA in"),
   619	      ("let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in",
   620	       "let framed(otB, algxB, idxB, kfpxB, mhB, cvsB, plB) = fbB in"),
   621	      ("if mhA = h(t) then", "if true then"),
   622	      ("if mhB = h(t) then", "if true then"),
   623	      ("let (=POSS, =t) = checksign(ppfA, kA) in", "if true then"),
   624	      ("let (=POSS, =t) = checksign(ppfB, kB) in", "if true then"),
   625	      ("let (=BYTES, =fbA) = checksign(sgA, kA) in",
   626	       "let (=BYTES, =fbA) = checksign(sgA, kEncW) in"),
   627	      ("let (=BYTES, =fbB) = checksign(sgB, kB) in",
   628	       "let (=BYTES, =fbB) = checksign(sgB, kEncW) in"),
   629	      ("out(sigCh, (ctx, kA, sgA))", "out(sigCh, (ctx, kEncW, sgA))"),
   630	      ("out(sigCh, (ctx, kB, sgB))", "out(sigCh, (ctx, kEncW, sgB))"),
   631	    ] + ATTRIB_BOTH
   632	    t = _split_attest(t, "  if ctx = BASE then\n", WCTX, muts)
   633	    # REPAIR 2026-10-01 (broken fixture BF-4, diagnosed in
   634	    # dev/divergences/DIAGNOSIS.md G3): the transcription above re-keyed only the
   635	    # scope reports (ATTRIB_BOTH) and sigCh to the wrapper key; every other event
   636	    # and report in AttestStageW (LayerAccepted, Accept, link2aCh, possCh,
   637	    # bytesCh, link5Ch, slotCh, setCh, acceptCh, acceptKeyCh, gsigCh, chainCh)
   638	    # still carried the PRESENTED inner kA/kB, which after the mutation no check
   639	    # touches.  That contradicts the registered report contract -- "the inner
   640	    # acceptance of this configuration reports the presented inner (kW, tI,
   641	    # ppfI)" (PREDICTIONS.md:2503, C-C15(i) Cases cell) -- and the family
   642	    # descent (cap25a_sp7_strict_q6b_sigjudges.pv:331-336 reports kW
   643	    # everywhere), and it redded seven out-of-set strict queries.  The repair
   644	    # replaces kA/kB by kEncW in AttestStageW's EVENTS AND REPORTS ONLY, never in
   645	    # a check -- exactly the change of dev/divergences/mk_cc15i_kw.py, whose
   646	    # diagnostic copies dv_cc15i_kw_{a,b,d} confirmed it.  The scope reports are
   647	    # already kEncW and are unchanged; the correct AttestStage is untouched.
   648	    return _report_wrapper_key(t)
   649	
   650	
   651	def _report_wrapper_key(t):
   652	    # BF-4 repair (see cc15i): inside AttestStageW only, kA/kB -> kEncW on every
   653	    # line that is an event or an output; lines that check are left alone.
   654	    i = t.index("let AttestStageW(")
   655	    j = t.index(ATT_END, i)
   656	    out = []
   657	    for ln in t[i:j].split("\n"):
   658	        s = ln.strip()
   659	        if s.startswith("event ") or "out(" in s:
   660	            ln = re.sub(r"\bkA\b", "kEncW", ln)
   661	            ln = re.sub(r"\bkB\b", "kEncW", ln)
   662	        out.append(ln)
   663	    return t[:i] + "\n".join(out) + t[j:]
   664	
   665	
   666	def cc15ii(t):
   667	    # S-P7 Q5c transcribed: at DEPTH 2 the scope is taken from the MIDDLE layer
   668	    # rather than the innermost.  ctx at L2 IS the middle wrapper.  Every
   669	    # verification is left alone.
   670	    return _split_attest(t, "  if lyr <> L2 then\n", WCTX + "  if lyr = L2 then\n",
   671	                         ATTRIB_BOTH)
