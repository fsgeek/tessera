   750	def header(name, mutates, serves, box, cs):
   751	    L = []
   752	    L.append("(* ==================================================================== *)")
   753	    L.append("(* STATUS: PROPOSED - 2026-09-19 - produced by the AI collaborator")
   754	    L.append("   (Claude Opus 5, builder, directed by the owner instance); not adopted;")
   755	    L.append("   the commit is the author's.  GENERATED by derive.py from capstone.pv;")
   756	    L.append("   do not edit by hand.")
   757	    L.append("   FILE:    " + name)
   758	    L.append("   CASE:    " + CASENAME[cs])
   759	    L.append("   MUTATES: " + mutates)
   760	    L.append("   SERVES:  " + serves)
   761	    L.append("   REGISTERED BOX: %d min - the box of the query this companion is" % box)
   762	    L.append("   predicted to red.  No companion carries a timebox of its own")
   763	    L.append("   (PREDICTIONS.md section 4, \"The count\").")
   764	    L.append("*)")
   765	    L.append("(* ==================================================================== *)")
   766	    return "\n".join(L) + "\n\n"
