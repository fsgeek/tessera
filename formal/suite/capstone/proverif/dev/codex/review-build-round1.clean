    48	 ("C-Q4-Rescoped", r"not event\(Rescoped\("),
    49	 ("C-Q4-InnerSig", r"InnerSigTransplanted\("),
    50	 ("C-Q5", r"SetAltered\("),
    51	 ("C-Q5w-1", r"verified1\(k1\)"),
    52	 ("C-Q5w-2", r"verified2\(k1,k2\)"),
    53	 ("C-Q10", r"TagConfused\("),
    54	 ("C-Q6-c1-unres", r"EstablishedWrapped\(aid,lyr,t,kX,co,ESTABLISHED\)"),
