     1	(* ==================================================================== *)
     2	(* tessera_theory.pvl — shared theory library for the symbolic suite.  *)
     3	(*                                                                      *)
     4	(* STATUS: PROPOSED (collaborator, 2026-09-04). Extracted from the      *)
     5	(* first-link spike models under formal/spike/first-link/proverif/,     *)
     6	(* per formal/suite/ENUMERATION.md §1: extraction, not invention.       *)
     7	(* Every divergence from the spike's declarations is recorded below.    *)
     8	(* A suite model includes this file (proverif -lib) and adds only its   *)
     9	(* own process structure, events, and queries; redeclaring a library    *)
    10	(* term is a build failure (ENUMERATION §1).                            *)
    11	(*                                                                      *)
    12	(* This library proves nothing. It fixes the vocabulary so that the    *)
    13	(* suite's ledger entries share terms by construction.                  *)
    14	(*                                                                      *)
    15	(* Extraction record (2026-09-04, against all 19 spike .pv files):      *)
    16	(*   identical in every model: c, skey/pkey/pk, sign/checksign, fp,     *)
    17	(*     POSS, BYTES, the five honest-world fixture values, and the       *)
    18	(*     events AuthorityPublishedDNS/Repo, IssuerPossession,             *)
    19	(*     IssuerSigned (Q4/Q6r/Q7 omit the four producer events because   *)
    20	(*     they model the adversary's objective only; omission, not         *)
    21	(*     redefinition).                                                   *)
    22	(*   h: declared in Q3, Q4, Q5, Q5r, Q6r, Q7; absent from Q1/Q2, which  *)
    23	(*     bind the tuple directly. Carried here with its idealization.     *)
    24	(*   Accept: 5-ary in Q1–Q5; the single-evidence models declare their   *)
    25	(*     own AcceptS (4-ary) / AcceptP; those remain model-local.         *)
    26	(*   Judge channels (accCh, accS, accP) and TwoWorlds* events are        *)
    27	(*     model-local by design (private-channel judges); not library.     *)
    28	(* Divergences from the spike, each deliberate and recorded:            *)
    29	(*   D-1  STMT is replaced by STMT_DIRECT and STMT_DIGEST, per the      *)
    30	(*        first-link DECISION.md construction ruling (distinct tags per *)
    31	(*        binding form). A suite model using the spike's single STMT   *)
    32	(*        is a build failure.                                           *)
    33	(*   D-2  The map-v1 authority-relevant tuple gets a named constructor, *)
    34	(*        authTuple, declared [data] so it is a transparent tuple       *)
    35	(*        (adversary can build and decompose it) — semantically the     *)
    36	(*        spike's native 5-tuple, with a name the ledger can cite.      *)
    37	(*   D-3  Possession is over the MANIFEST, not the fingerprint. The     *)
    38	(*        spike encoded proof-of-possession as sign((POSS, fp(pk)), sk);*)
    39	(*        A1 §A1.5 item 3 / P10 define it as the manifest self-         *)
    40	(*        signature, sign((POSS, <manifest>), sk). ENUMERATION note 2   *)
    41	(*        requires this file to record the divergence so the suite      *)
    42	(*        does not inherit the under-encoding (guide M7a/M7b). The      *)
    43	(*        library fixes the TAG; each model's possession object MUST    *)
    44	(*        be over its manifest term, and a model signing POSS over a    *)
    45	(*        fingerprint alone is a broken companion by definition.        *)
    46	(*   D-4  Key substitution (DSKS) is EXPRESSIBLE. The spike's signature *)
    47	(*        algebra made A1.3 item 3 unrepresentable (guide A2; note 1    *)
    48	(*        item 2(c)). This library adds an adversary-available          *)
    49	(*        constructor dsks(s, r) yielding a fresh private key whose     *)
    50	(*        public key verifies the one seen signature s. See the         *)
    51	(*        signature section for exactly what this does and does not     *)
    52	(*        grant. Every suite query therefore holds, if it holds, under  *)
    53	(*        an adversary with the registered DSKS capability.             *)
    54	(*   D-5  Object-type constants (2026-09-06, after the four suite plans *)
    55	(*        froze at 5188e7a). P7's enumerated signed-object set is       *)
    56	(*        declared here as constants OT_ATTEST, OT_WRAPPER,             *)
    57	(*        OT_MANIFEST, OT_AUTHEVID, OT_CONFVEC, OT_REVIEWREC, plus the   *)
    58	(*        two types Amendment 4 §A4.5 added, OT_TLR and OT_REFUSAL, so  *)
    59	(*        S-P1/S-P2/S-P7/S-STANDING and the capstone share the names.   *)
    60	(*        S-P3's models predate this and use a model-local free name    *)
    61	(*        objTypeH; they are not recut (no collision: different name).  *)
    62	(*   D-6  Domain-separation tags TLR and REFUSAL (Amendment 4 §A4.5):   *)
    63	(*        the terminal lineage record and the portable refusal record   *)
    64	(*        are signed-object kinds with their own tags, never parsing    *)
    65	(*        as any other kind.                                            *)
    66	(*        Note 2026-09-06 (cross-family falsification review,          *)
    67	(*        S-STANDING item 27; docs/reviews/2026-09-06-codex-suite-     *)
    68	(*        falsification-s-p1-s-p2-s-p7-s-standing.md): the TLR tag     *)
    69	(*        check is INERT in every single-family fixture (no honest     *)
    70	(*        signer emits another tag over a TLR-shaped body) and LOAD-   *)
    71	(*        BEARING under composition: with an honest REFUSAL-tagged     *)
    72	(*        signer over a TLR-shaped body added (reviewer fixture        *)
    73	(*        a_foreign_tag), removing only the tag check turns the strict *)
    74	(*        standing correspondence red. The tag's work is cross-        *)
    75	(*        protocol, invisible to any single-family model; carried,     *)
    76	(*        never removable on single-removal evidence.                  *)
    77	(*   NOT promoted — framed. The seven-field frame constructor stays     *)
    78	(*        model-local, copied verbatim from S-P3 into S-P1/S-P2         *)
    79	(*        (S-P2 plan, "framed into the library", disposition B7):       *)
    80	(*        promoting it would make S-P3's eight committed models         *)
    81	(*        redeclare a library term (a build failure by the rule above)  *)
    82	(*        and force a recut of results already reviewed. Shared by      *)
    83	(*        copy; the capstone, which transcribes this library, checks    *)
    84	(*        the copies agree.                                             *)
    85	(* ==================================================================== *)
    86	
    87	(* --- public channel ------------------------------------------------- *)
    88	free c: channel.
    89	
    90	(* --- signature primitives ------------------------------------------- *)
    91	(* Dolev–Yao signatures, deterministic, with message recovery, PLUS the  *)
    92	(* registered A1.3 item 3 capability (D-4): from any ONE seen signature  *)
    93	(* s = sign(m, k) and a fresh value r, the adversary derives a private   *)
    94	(* key dsks(s, r) it holds, whose public key verifies s to the same m.   *)
    95	(* What this grants: choosing a keypair AFTER seeing a valid signature   *)
    96	(* so that the existing message–signature pair verifies under it (the   *)
    97	(* registered P3 threat, exclusive-ownership failure).                   *)
    98	(* What it does not grant: forging a signature under a key the          *)
    99	(* adversary does not hold; making a derived key verify any OTHER        *)
   100	(* signature by k; key recovery. A derived key signs freely (possession  *)
   101	(* is free to the adversary, P10).                                       *)
   102	(* Modeled as a second rewrite rule tried when the honest rule does not  *)
   103	(* apply. Signatures are deterministic here: the judge pattern equates   *)
   104	(* more evidence than a byte-level judge would, so unreachability in the *)
   105	(* model is conservative for the real judge (guide A2).                  *)
   106	type skey.
   107	type pkey.
   108	fun pk(skey): pkey.
   109	fun sign(bitstring, skey): bitstring.
   110	fun dsks(bitstring, bitstring): skey.
   111	fun checksign(bitstring, pkey): bitstring
   112	  reduc forall m: bitstring, k: skey;
   113	          checksign(sign(m, k), pk(k)) = m
   114	  otherwise forall m: bitstring, k: skey, r: bitstring;
   115	          checksign(sign(m, k), pk(dsks(sign(m, k), r))) = m.
   116	
   117	(* --- key fingerprint -------------------------------------------------- *)
   118	(* IDEALIZATION (guide READ-AND-CHALLENGE A1 — the spike ledger named   *)
   119	(* h's residual and not fp's; this header closes that gap): fp is a     *)
   120	(* free constructor — injective, no collisions, no preimages. A model    *)
   121	(* check `fp(kX) = kfpr` is therefore equivalent to `kX = the key whose  *)
   122	(* fingerprint was published`. In the implementation it is a byte        *)
   123	(* comparison whose strength is the fingerprint function's collision     *)
   124	(* resistance and the P8 question of what bytes a fingerprint hashes.    *)
   125	(* Layer 2 residual; every ledger entry that consumes a fingerprint      *)
   126	(* match must cite it. What a concrete fingerprint hashes is P8's        *)
   127	(* business (spike fixture note).                                        *)
   128	fun fp(pkey): bitstring.
   129	
   130	(* --- hash ------------------------------------------------------------- *)
   131	(* IDEALIZATION (must be cited by every consumer ledger entry, spike     *)
   132	(* ledger entry 1/3 residual, DECISION.md remediation 5): h is a free    *)
   133	(* constructor — injective by construction, no collisions, no            *)
   134	(* preimages, no length or encoding structure. This erases (a) concrete *)
   135	(* collision behavior — collision resistance of the real digest is a    *)
   136	(* Layer 2 assumption discharged by cited external hardness results,    *)
   137	(* never by a model including this file; and (b) encoding ambiguity —   *)
   138	(* two byte-strings canonicalizing to one input, which is P8's          *)
   139	(* injectivity obligation, not this library's. Any query whose truth    *)
   140	(* depends on h being hard to invert or collide is proving a symbolic   *)
   141	(* fact about a perfect hash, and its ledger entry must say so.         *)
   142	fun h(bitstring): bitstring.
   143	
   144	(* --- domain-separation tags ------------------------------------------ *)
   145	(* One tag per signed-object kind; a signature over one kind never       *)
   146	(* parses as another. STMT_DIRECT / STMT_DIGEST distinguish the two     *)
   147	(* authority binding forms (D-1). POSS: manifest possession self-       *)
   148	(* signature. BYTES: attestation signature over the framed bytes.       *)
   149	const STMT_DIRECT: bitstring.
   150	const STMT_DIGEST: bitstring.
   151	const POSS: bitstring.
   152	const BYTES: bitstring.
