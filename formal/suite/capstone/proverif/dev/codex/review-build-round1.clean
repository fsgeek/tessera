    68	 ("W-HonestChainL2", r"HonestChain\(L2,"),
    69	 ("W-HonestAccepted", r"not event\(HonestAccepted\("),
    70	 ("W-HonestWrapped", r"HonestWrappedAccepted\("),
    71	 ("W-HonestStanding", r"HonestStandingEstablished\("),
    72	 ("W-Agreed", r"HonestWrappedStandingAgreed\("),
    73	 ("V-S1", r"StandingReport\(ESTABLISHED,TERMINAL_DISPOSITION_SHOWN"),
    74	 ("V-S2", r"StandingReport\(ABSENT,SUPERSEDED"),
    75	 ("V-S3", r"StandingReport\(ABSENT,NO_TERMINAL_DISPOSITION_EVIDENCE"),
