   686	def cc15iii(t):
   687	    # S-P7 Q6a transcribed, the ISOLATION configuration: the attributed ISSUER
   688	    # IDENTITY is read from the enclosing frame; the KEY and the whole key
   689	    # binding are RETAINED.
   690	    t = t.replace("(* ---- the REQUIRED retained queries", OBSQ + "\n(* ---- the REQUIRED retained queries", 1)
   691	    return _split_attest(t, "  if ctx = BASE then\n", WCTX, ATTRIB_ID)
