   158	    t = t.replace("t: bitstring, evD: bitstring, evR: bitstring,\n              kA: pkey",
   159	                  "t: bitstring, ev: bitstring,\n              kA: pkey")
   160	    t = t.replace("t: bitstring, evD: bitstring, evR: bitstring,\n              kX: pkey",
   161	                  "t: bitstring, ev: bitstring,\n              kX: pkey")
   162	    # --- the sole authority channel
   163	    t = t.replace(
   164	        "let AuthorityDNS(skDp: skey, t: bitstring) =\n"
   165	        "  event AuthorityPublishedDNS(t);\n"
   166	        "  out(c, sign((STMT_DIGEST, h(t)), skDp)).\n"
   167	        "\n"
   168	        "let AuthorityRepo(skRp: skey, t: bitstring) =\n"
   169	        "  event AuthorityPublishedRepo(t);\n"
   170	        "  out(c, sign((STMT_DIGEST, h(t)), skRp)).",
   171	        "let AuthorityS(skSp: skey, t: bitstring) =\n"
   172	        "  event AuthorityPublishedDNS(t);\n"
   173	        "  out(c, sign((STMT_DIGEST, h(t)), skSp)).", 1)
   174	    # --- the verifier: ONE evidence check, ev the sole term
   175	    t = t.replace("(pkDv: pkey, pkRv: pkey", "(pkSv: pkey")
   176	    t = t.replace(
   177	        "  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in\n"
   178	        "  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in",
   179	        "  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in")
   180	    t = t.replace(
   181	        "  event AuthorityEvidence(t, evD, pkDv);\n"
   182	        "  event AuthorityEvidence(t, evR, pkRv);",
   183	        "  event AuthorityEvidence(t, ev, pkSv);")
   184	    t = t.replace("  in(c, (t: bitstring, evD: bitstring, evR: bitstring,\n"
   185	                  "         kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));",
   186	                  "  in(c, (t: bitstring, ev: bitstring,\n"
   187	                  "         kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));")
   188	    t = t.replace("  in(c, (t: bitstring, evD: bitstring, evR: bitstring, kX: pkey,\n"
   189	                  "         ppfI: bitstring, core: bitstring, se: bitstring));",
   190	                  "  in(c, (t: bitstring, ev: bitstring, kX: pkey,\n"
   191	                  "         ppfI: bitstring, core: bitstring, se: bitstring));")
   192	    t = t.replace("t, (evD, evR),", "t, ev,")
   193	    t = t.replace("event Accept(evD, evR, t, kA, fbA);", "event AcceptS(ev, t, kA, fbA);")
   194	    t = t.replace("event Accept(evD, evR, t, kB, fbB);", "event AcceptS(ev, t, kB, fbB);")
   195	    t = t.replace("out(link1aCh, (lyr, t, evD, evR))", "out(link1aCh, (lyr, t, ev))")
   196	    t = t.replace("out(link1aCh, (lyrIn, t, evD, evR))", "out(link1aCh, (lyrIn, t, ev))")
   197	    t = t.replace("      | out(twoWorldsCh, (evD, evR, t))\n", "")
   198	    # --- link 1a's judge over the SOLE carried term
   199	    t = t.replace(
   200	        "let Link1aJudge(pkSv: pkey) =\n"
   201	        "  in(link1aCh, (lyr: bitstring, t: bitstring, evD: bitstring, evR: bitstring));\n"
   202	        "  ( ( let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in 0\n"
   203	        "      else ( let (=STMT_DIRECT, =t) = checksign(evD, pkDv) in 0\n"
   204	        "             else event ChainBroken(lyr, LINK_1A) ) )\n"
   205	        "  | ( let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in 0\n"
   206	        "      else ( let (=STMT_DIRECT, =t) = checksign(evR, pkRv) in 0\n"
   207	        "             else event ChainBroken(lyr, LINK_1A) ) ) ).",
   208	        "let Link1aJudge(pkSv: pkey) =\n"
   209	        "  in(link1aCh, (lyr: bitstring, t: bitstring, ev: bitstring));\n"
   210	        "  ( let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in 0\n"
   211	        "    else ( let (=STMT_DIRECT, =t) = checksign(ev, pkSv) in 0\n"
   212	        "           else event ChainBroken(lyr, LINK_1A) ) ).", 1)
   213	    # C-Q2's judge is not stated in (d); its channel loses its only writer too
   214	    t = t.replace(
   215	        "let TwoWorldsJudge =\n"
   216	        "  in(twoWorldsCh, (e1: bitstring, e2: bitstring, t1: bitstring));\n"
   217	        "  in(twoWorldsCh, (=e1, =e2, t2: bitstring));\n"
   218	        "  if t1 = t2 then 0 else event TwoWorldsBroken(e1, e2, t1, t2).",
   219	        "(* C-Q2 is stated for (a) and (b) only (§3); its judge is not built here. *)", 1)
   220	    t = t.replace("  | !TwoWorldsJudge | !ChainWitnessJudge", "  | !ChainWitnessJudge")
   221	    # --- the fixture: one channel
   222	    t = t.replace("  new skD: skey; new skR: skey; new skAdv: skey;",
   223	                  "  new skS: skey; new skAdv: skey;", 1)
   224	    t = t.replace("  out(c, pk(skD)); out(c, pk(skR));", "  out(c, pk(skS));", 1)
   225	    t = t.replace(LEAK_A,
   226	        "  (* CASE (d): DEGRADED, the SOLE authority channel compromised "
   227	        "— its signing key is public *)\n  out(c, skS);", 1)
   228	    t = t.replace(
   229	        "  | !AuthorityDNS(skD, M1) | !AuthorityDNS(skD, M2) | !AuthorityDNS(skD, MW)\n"
   230	        "  | !AuthorityRepo(skR, M1) | !AuthorityRepo(skR, M2) | !AuthorityRepo(skR, MW)",
   231	        "  | !AuthorityS(skS, M1) | !AuthorityS(skS, M2) | !AuthorityS(skS, MW)", 1)
   232	    t = t.replace("(pk(skD), pk(skR))", "(pk(skS))")
   233	    t = t.replace("!WrapStage(pk(skD), pk(skR), L0, L1) | !WrapStage(pk(skD), pk(skR), L1, L2)",
   234	                  "!WrapStage(pk(skS), L0, L1) | !WrapStage(pk(skS), L1, L2)")
   235	    # the enrolment rule in degraded: the sole channel is the compromised one
   236	    t = t.replace("insufficient for strict acceptance at L0", "the SOLE channel in (d), which is the A4.6 cost")
   237	    return t
   238	
   239	
   240	# ------------------------------------------------------- the companions -----
   241	# Each entry: (name, row/served, box minutes, cases, edit function).
   242	FPIN_A = "let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in"
   243	FPIN_B = "let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in"
   244	WFPIN_A = ("let framed(otA, =alg, =id, =fp(kA), mhA, cvsA,\n"
   245	           "                 wrap(cvIw: bitstring, (fbIA: bitstring, sgIA: bitstring,\n"
   246	           "                                        fbIB: bitstring, sgIB: bitstring))) = fbA in")
   247	
   248	SIGFRAME = """
   249	(* companion-local total accessors on the SIGNED payload (the mutation needs
   250	   the signed frame's own fields; a catch-all otherwise keeps them total). *)
   251	fun sigFrameKfp(bitstring, pkey): bitstring
   252	  reduc forall o: bitstring, a: bitstring, i: bitstring, kf: bitstring,
   253	               m: bitstring, cv: bitstring, p: bitstring, k: pkey;
   254	          sigFrameKfp(framed(o, a, i, kf, m, cv, p), k) = kf
   255	  otherwise forall x: bitstring, k: pkey; sigFrameKfp(x, k) = fp(k).
   256	fun sigFrameOt(bitstring): bitstring
   257	  reduc forall o: bitstring, a: bitstring, i: bitstring, kf: bitstring,
   258	               m: bitstring, cv: bitstring, p: bitstring;
   259	          sigFrameOt(framed(o, a, i, kf, m, cv, p)) = o
   260	  otherwise forall x: bitstring; sigFrameOt(x) = OT_ATTEST.
   261	"""
   262	
   263	
   264	def add_accessors(t):
   265	    anchor = "(* verifier-path context handed to the judges"
   266	    return t.replace(anchor, SIGFRAME + "\n" + anchor, 1)
   267	
   268	
   269	def unpin_frames(t, block):
   270	    t = edit(t, block, "=fp(kA), mhA", "kfpxA, mhA")
   271	    t = edit(t, block, "=fp(kB), mhB", "kfpxB, mhB")
   272	    return t
   273	
   274	
   275	def drop_mh(t, block):
   276	    t = drop(t, block, "if mhA = h(t) then")
   277	    t = drop(t, block, "if mhB = h(t) then")
   278	    return t
   279	
   280	
   281	def poss_fponly(t, block):
   282	    """The D-3 UNDER-ENCODING.  It is a mutation of the FIXTURE as well as of
   283	    the verifier, and the family source says so: S-P2's Q5-C2 companion changes
   284	    the honest signer's possession object at
   285	    `sp2_q5_c2_fponly_frame_nomh.pv:117` -- `sign((POSS, fp(pk(sk))), sk)` --
   286	    as well as the two verifier checks at `:133`, `:151-152`.  The library's D-3
   287	    note is the reason: possession is over the MANIFEST, and "a model signing
   288	    POSS over a fingerprint alone is a broken companion by definition".  Mutating
   289	    the verifier alone leaves the honest signers producing (POSS, m) that the
   290	    mutated verifier can never accept, so nothing is accepted at all and every
   291	    acceptance-dependent witness dies -- a BROKEN FIXTURE, not a severing.
   292	    (Diagnosed on the first cap_cc03_a run; see RESULTS.md, "Broken fixtures,
   293	    diagnosed and repaired".)"""
   294	    t = t.replace("let ppf = sign((POSS, m), sk) in",
   295	                  "let ppf = sign((POSS, fp(pk(sk))), sk) in")
   296	    t = edit(t, block, "let (=POSS, =t) = checksign(ppfA, kA) in",
   297	             "let (=POSS, =fp(kA)) = checksign(ppfA, kA) in")
   298	    t = edit(t, block, "let (=POSS, =t) = checksign(ppfB, kB) in",
   299	             "let (=POSS, =fp(kB)) = checksign(ppfB, kB) in")
   300	    return t
   301	
   302	
   303	def cond_unbind(t, cond_a, cond_b):
   304	    t = add_accessors(t)
   305	    for blk, A, B in (("ATTEST", "fbA", "fbB"), ("WRAP", "fbA", "fbB")):
   306	        t = edit(t, blk, "let (=BYTES, =%s) = checksign(sgA, kA) in" % A,
   307	                 "let (=BYTES, sbA: bitstring) = checksign(sgA, kA) in\n"
   308	                 "      if " + cond_a + " then")
   309	        t = edit(t, blk, "let (=BYTES, =%s) = checksign(sgB, kB) in" % B,
   310	                 "let (=BYTES, sbB: bitstring) = checksign(sgB, kB) in\n"
   311	                 "      if " + cond_b + " then")
   312	    return t
   313	
   314	
   315	def cc02(t):
   316	    # the multi-signer path, at every layer the composed verifier has one
   317	    t = unpin_frames(t, "ATTEST2"); t = drop_mh(t, "ATTEST2")
   318	    t = unpin_frames(t, "WRAP2")
   319	    t = drop(t, "WRAP2", "if mhA = h(t) then")
   320	    t = drop(t, "WRAP2", "if mhB = h(t) then")
   321	    return t
   322	
   323	
   324	def cc03(t):
   325	    t = drop_mh(t, "LAYERS"); t = poss_fponly(t, "LAYERS"); return t
   326	
   327	
   328	def cc04(t):
   329	    # "inside InnerCheck" — the attestation layer, shared by the base path and
   330	    # the innermost layer of a wrapped presentation, as S-P7's InnerCheck is.
   331	    t = edit(t, "ATTEST", "=fp(kA), mhA", "kfpxA, mhA")
   332	    t = edit(t, "ATTEST2", "=fp(kB), mhB", "kfpxB, mhB")
   333	    t = drop_mh(t, "ATTEST2")
   334	    t = drop(t, "ATTEST1", "if mhA = h(t) then")
   335	    return t
   336	
   337	
   338	def cc05(t):
   339	    t = edit(t, "ATTEST", "let (=BYTES, =fbA) = checksign(sgA, kA) in",
   340	             "let (=BYTES, anybA: bitstring) = checksign(sgA, kA) in")
   341	    t = edit(t, "ATTEST2", "let (=BYTES, =fbB) = checksign(sgB, kB) in",
   342	             "let (=BYTES, anybB: bitstring) = checksign(sgB, kB) in")
   343	    return t
   344	
   345	
   346	def cc06(t):
   347	    return cond_unbind(t, "sbA = fbA || sigFrameKfp(sbA, kA) <> fp(kA)",
   348	                          "sbB = fbB || sigFrameKfp(sbB, kB) <> fp(kB)")
   349	
   350	
   351	def cc07i(t):
   352	    t = add_accessors(t)
   353	    for blk in ("ATTEST", "WRAP"):
   354	        t = edit(t, blk, "let (=BYTES, =fbA) = checksign(sgA, kA) in",
   355	                 "let (=BYTES, sbA: bitstring) = checksign(sgA, kA) in\n"
   356	                 "      if sigFrameKfp(sbA, kA) = fp(kA) then")
   357	        t = edit(t, blk, "let (=BYTES, =fbB) = checksign(sgB, kB) in",
   358	                 "let (=BYTES, sbB: bitstring) = checksign(sgB, kB) in\n"
   359	                 "      if sigFrameKfp(sbB, kB) = fp(kB) then")
   360	    return t
   361	
   362	
   363	def cc07ii(t):
   364	    return cond_unbind(t, "sbA = fbA || sigFrameOt(sbA) <> OT_ATTEST",
   365	                          "sbB = fbB || sigFrameOt(sbB) <> OT_ATTEST")
   366	
   367	
   368	def cc08(t):
   369	    t = drop_mh(t, "LAYERS"); t = poss_fponly(t, "LAYERS"); return t
   370	
   371	
   372	def cc08i(t):
   373	    return drop_mh(t, "LAYERS")
   374	
   375	
   376	def cc08ii(t):
   377	    return poss_fponly(t, "LAYERS")
   378	
   379	
   380	def cc09(t):
   381	    # the required-set read dropped from the one-signer branch: a two-signer
   382	    # manifest now completes through it.  Every per-slot check is retained.
   383	    t = edit(t, "ATTEST1", "( if ss = signers0 then", "(")
   384	    t = edit(t, "WRAP1", "( if ss = signers0 then", "(")
   385	    return t
   386	
   387	
   388	def _drop_ev(t, which):
   389	    """which in {'D','R'}: delete that channel's evidence check everywhere."""
   390	    if which == "D":
   391	        return t.replace("  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in\n", "")
   392	    return t.replace("  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in\n", "")
   393	
   394	
   395	def cc10_a(t):   return _drop_ev(t, "R")   # (a): DNS leaked -> the HONEST check is repo's
   396	def cc10_b(t):   return _drop_ev(t, "D")   # (b): repo leaked -> the HONEST check is DNS's
   397	def cc10iso_a(t): return _drop_ev(t, "D")  # isolation control: the COMPROMISED check
   398	def cc10iso_b(t): return _drop_ev(t, "R")
   399	def cc10_d(t):
   400	    return t.replace("  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in\n", "")
   401	
   402	
   403	def cc11(t):
   404	    # the attempt identity is read from the bundle instead of derived: the
   405	    # front end forwards a declared label alongside the core and the standing
   406	    # evidence, and the standing path uses it in place of h(core).
   407	    t = t.replace("  in(standCore, (=intake, core: bitstring, se: bitstring));",
   408	                  "  in(standCore, (=intake, core: bitstring, se: bitstring));\n"
   409	                  "  in(c, aidDecl: bitstring);")
   410	    t = edit(t, "STAND", "let aidD = h(core) in", "let aidD = aidDecl in")
   411	    return t
   412	
   413	
   414	Q4BODY = [
   415	    'let StandingDecide(kT: pkey, t: bitstring, aidD: bitstring, d: bitstring,',
   416	    '                   terminal: bitstring, intake: bitstring, lyr: bitstring,',
   417	    '                   core: bitstring, idS: bitstring) =',
   418	    '  (* MUTATION (ALTERNATE Q4): the terminal disposition is IGNORED.  Membership',
   419	    '     of the derived identity in the lineage alone yields ESTABLISHED.  The',
   420	    '     parameters d and terminal are received and never read, so the SUPERSEDED',
   421	    '     (S2) and ISSUANCE_REFUSED (S4) branches no longer exist -- the registered',
   422	    '     vocabulary-witness consequence of this alternate (PREDICTIONS.md, C-C11 row). *)',
   423	    '  ( event Established(kT, t, aidD);',
   424	    '    event StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, kT, t, aidD);',
   425	    '    ( ( if lyr <> L0 then',
   426	    '          event EstablishedWrapped(intake, lyr, t, kT, core, ESTABLISHED) )',
   427	    '    | out(estCh, (intake, lyr, kT, t, aidD))',
   428	    '    | out(scopeStanding, (intake, lyr, kT, idS, aidD)) ) ).',
   429	]
   430	
   431	
   432	def cc11_q4(t):
   433	    """ALTERNATE Q4, S-STANDING's companion C transcribed: the terminal
   434	    disposition is IGNORED -- membership of the derived identity in the lineage
   435	    alone yields ESTABLISHED, and `d` and `terminal` are received and never read.
   436	    The family replaces the WHOLE StandingDecide body
   437	    (ss_q4_companionC_terminal_unchecked.pv:234-237), which is what makes the S2
   438	    (SUPERSEDED) and S4 (ISSUANCE_REFUSED) branches cease to exist -- the
   439	    registered vocabulary-witness consequence of section 4's C-C11 row.
   440	    Replacing less than the whole body would leave S4 alive and the registered
   441	    consequence unreproduced."""
   442	    a = t.index("let StandingDecide(kT: pkey")
   443	    b = t.index("\n\nlet StandingPath(", a)
   444	    return t[:a] + "\n".join(Q4BODY) + t[b:]
   445	
   446	
   447	def cc11_abl6(t):
   448	    return edit(t, "STAND",
   449	        "let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) =\n"
   450	        "                checksign(tlrSig, kT) in",
   451	        "(* ALTERNATE abl6: the TLR is taken UNSIGNED — no signature check. *)\n"
   452	        "          let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) =\n"
   453	        "                tlrSig in")
   454	
   455	
   456	def cc12(t):
   457	    t = edit(t, "STAND",
   458	        "      if fp(kT) = kfpr then\n        ( if kT = kX then",
   459	        "      (* C-C12: NO fp(kT) = kfpr check in the standing path; the TLR key\n"
   460	        "         equality kT = kX is RETAINED. *)\n        ( if kT = kX then")
   461	    t = edit(t, "STAND",
   462	        "            event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) )\n"
   463	        "      else\n"
   464	        "        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) ).",
   465	        "            event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) ) ).")
   466	    return t
   467	
   468	
   469	def cc13i(t):
   470	    t = drop(t, "ATTEST", "if otA = OT_ATTEST then")
   471	    t = drop(t, "ATTEST2", "if otB = OT_ATTEST then")
   472	    return t
   473	
   474	
   475	def cc13ii(t):
   476	    t = drop(t, "WRAP", "if otA = OT_WRAPPER then")
   477	    t = drop(t, "WRAP2", "if otB = OT_WRAPPER then")
   478	    return t
   479	
   480	
   481	def cc14(t):
   482	    t = t.replace(
   483	        "  event AuthorityPublishedDNS(t);\n"
   484	        "  out(c, sign((STMT_DIGEST, h(t)), skDp)).",
   485	        "  event AuthorityPublishedDNS(t);\n"
   486	        "  let authTuple(idE, kfprE, ssE, algE, verE) = t in\n"
   487	        "  out(c, sign((STMT_DIGEST, idE), skDp)).")
   488	    t = t.replace(
   489	        "  event AuthorityPublishedRepo(t);\n"
   490	        "  out(c, sign((STMT_DIGEST, h(t)), skRp)).",
   491	        "  event AuthorityPublishedRepo(t);\n"
   492	        "  let authTuple(idE, kfprE, ssE, algE, verE) = t in\n"
   493	        "  out(c, sign((STMT_DIGEST, idE), skRp)).")
   494	    t = t.replace(
   495	        "  event AuthorityPublishedDNS(t);\n"
   496	        "  out(c, sign((STMT_DIGEST, h(t)), skSp)).",
   497	        "  event AuthorityPublishedDNS(t);\n"
   498	        "  let authTuple(idE, kfprE, ssE, algE, verE) = t in\n"
   499	        "  out(c, sign((STMT_DIGEST, idE), skSp)).")
   500	    t = t.replace(
   501	        "  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in\n"
   502	        "  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in",
   503	        "  let authTuple(idE, kfprE, ssE, algE, verE) = t in\n"
   504	        "  let (=STMT_DIGEST, =idE) = checksign(evD, pkDv) in\n"
   505	        "  let (=STMT_DIGEST, =idE) = checksign(evR, pkRv) in")
   506	    t = t.replace(
   507	        "  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in",
   508	        "  let authTuple(idE, kfprE, ssE, algE, verE) = t in\n"
   509	        "  let (=STMT_DIGEST, =idE) = checksign(ev, pkSv) in")
   510	    return t
   511	
   512	
   513	def cc16(t):
   514	    for blk in ("ATTEST2",):
   515	        t = drop(t, blk, "if otA = otB then")
   516	        t = drop(t, blk, "if cvsA = cvsB then")
   517	        t = drop(t, blk, "if plA = plB then")
   518	    t = drop(t, "WRAP2", "if otA = otB then")
   519	    t = drop(t, "WRAP2", "if cvsA = cvsB then")
   520	    t = drop(t, "WRAP2", "if wrap(cvIw, (fbIA, sgIA, fbIB, sgIB)) = plB then")
   521	    return t
