   774	def main():
   775	    bases = {"a": case(BASE, "a"), "b": case(BASE, "b"), "c": case(BASE, "c"),
   776	             "d": degraded(BASE)}
   777	    # the correct-form runs, and case (c) which IS companion C-C1
   778	    # case (a) IS capstone.pv itself; no copy is written, so that the model the
   779	    # registration names is the file that runs and the blob hash is its own.
   780	    write("capstone_b.pv", bases["b"])
   781	    write("capstone_d.pv", bases["d"])
   782	    write("cap_cc01_c.pv",
   783	          bases["c"].replace("(* capstone.pv — THE COMPOSED MODEL",
   784	                             "(* cap_cc01_c.pv — COMPANION C-C1 (case (c)) — THE COMPOSED MODEL", 1))
   785	    # the companions
   786	    for name, fn, mutates, serves, box, cases in COMPANIONS:
   787	        for cs in cases:
   788	            if name == "cc10":
   789	                continue
   790	            t = fn(bases[cs])
   791	            fname = "cap_%s_%s.pv" % (name, cs)
   792	            write(fname, header(fname, mutates, serves, box, cs) + t)
   793	    # C-C10 and its isolation control are stated per mode (§4)
   794	    for cs, fn in (("a", cc10_a), ("b", cc10_b), ("d", cc10_d)):
   795	        fname = "cap_cc10_%s.pv" % cs
   796	        write(fname, header(fname,
   797	              "the HONEST channel's evidence check deleted (in (d): the sole channel's)",
   798	              "D4; set (1): link 1a; in strict also link 1b and Accept => IssuerSigned",
   799	              45, cs) + fn(bases[cs]))
   800	    for cs, fn in (("a", cc10iso_a), ("b", cc10iso_b)):
   801	        fname = "cap_cc10iso_%s.pv" % cs
   802	        write(fname, header(fname,
   803	              "ISOLATION CONTROL: the COMPROMISED channel's evidence check deleted instead",
   804	              "D4 isolation; required: link 1a RED, link 1b GREEN (the distinguishing signal)",
   805	              45, cs) + fn(bases[cs]))
   806	
   807	
   808	if __name__ == "__main__":
   809	    main()

