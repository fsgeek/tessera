   530	def cc18(t):
   531	    t = edit(t, "STAND",
   532	        "let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) =\n"
   533	        "                checksign(tlrSig, kT) in",
   534	        "(* C-C18: the D-6 TLR TAG CHECK UNBOUND.  The parsed tag is still\n"
