    63	 ("RET-Spliced", r"not event\(Spliced\("),
    64	 ("RET-TypeConfused", r"not event\(TypeConfused\("),
    65	 ("RET-VersionLied", r"not event\(VersionLied\("),
    66	 ("W-HonestChainL0", r"HonestChain\(L0,"),
