   216	
   217	(* ==== events (§1.3, exactly as LEDGER §6 fixes them) ================= *)
   218	event LayerAccepted(bitstring, bitstring, bitstring, bitstring,
   219	                    bitstring, pkey, bitstring, bitstring, bitstring).
   220	  (* aid, lyr, t, ev, slot, kX, ppf, sg, fb.  ev in STRICT is the PAIR   *)
   221	  (* of evidence terms, one per channel (§1.3 "ev IN STRICT IS THE       *)
   222	  (* PAIR"); the signature is unchanged.                                 *)
   223	event AcceptanceComplete(bitstring, bitstring, bitstring).   (* aid, lyr, t *)
   224	event AuthorityEvidence(bitstring, bitstring, pkey).         (* t, ev, channel key *)
   225	event ScopeReported(bitstring, bitstring, pkey, bitstring).  (* aid, lyr, kA, idA *)
   226	event ChainBroken(bitstring, bitstring).                     (* lyr, link name *)
   227	event HonestChain(bitstring, bitstring).                     (* lyr, t — witness *)
   228	event SlotSatisfied(bitstring, bitstring, bitstring, bitstring).
   229	  (* aid, lyr, t, slot — link 2b's permitted projection, RETAINING lyr   *)
   230	
   231	event AcceptS(bitstring, bitstring, pkey, bitstring).   (* degraded-form acceptance; unused in strict *)
   232	event AcceptedUnderHonestKey(pkey, bitstring).
   233	event HonestAccepted(pkey, bitstring).
   234	event ReattributedA(pkey, pkey, bitstring).
   235	event ReattributedB(pkey, pkey, bitstring).
   236	event Stripped(bitstring, bitstring).
   237	event SignerForged(bitstring, pkey).
   238	event SetAltered(pkey, bitstring, bitstring).
   239	event HonestComplete(bitstring, bitstring).
   240	event Spliced(bitstring, bitstring, bitstring).
   241	event TypeConfused(bitstring, bitstring, bitstring).
   242	event VersionLied(bitstring, bitstring, bitstring).
   243	event Rescoped(pkey, bitstring, pkey, bitstring, bitstring).
   244	event HonestWrappedAccepted(pkey, bitstring, pkey).
   245	event InnerSigTransplanted(pkey, bitstring).
   246	event SigTransplanted(pkey, bitstring).
   247	event SigBytesUnbound(pkey, bitstring, bitstring).
   248	event PossessionUnbound(pkey, bitstring, bitstring).
   249	event TwoWorldsBroken(bitstring, bitstring, bitstring, bitstring).
   250	event TagConfused(pkey, bitstring).
   251	
   252	(* standing *)
   253	event Designated(pkey, bitstring).
   254	event Established(pkey, bitstring, bitstring).
   255	event EstablishedWrapped(bitstring, bitstring, bitstring, pkey, bitstring, bitstring).
   256	  (* aid, lyr, t, kX, core, verdict *)
   257	event StandingReport(bitstring, bitstring, pkey, bitstring, bitstring).
   258	event StandingUnentitledWrapped(pkey, bitstring).
   259	event HonestStandingEstablished(pkey, bitstring).
   260	event ScopeMisreported(bitstring, bitstring, pkey, bitstring, pkey, bitstring).
   261	event HonestWrappedStandingAgreed(bitstring, bitstring).
   262	(* the TWO ISOLATION OBSERVERS (§3, C-Q6 (1)). Observers, not queries:   *)
   263	(* fired here, queried ONLY in the configuration that names them         *)
   264	(* (C-C15(iii)); never timeboxed, never a discharge.                     *)
   265	event ScopeKeyOnly(bitstring, bitstring, pkey, pkey).
   266	event ScopeIdentityOnly(bitstring, bitstring, bitstring, bitstring).
   267	
   268	(* ==================================================================== *)
   269	(* ==== THE REGISTERED QUERIES ======================================== *)
   270	(* Declaration order follows §3's ordering rule: C-Q1's links first,     *)
   271	(* then C-Q7, C-Q8, C-Q9 BEFORE links 3 and 4 and before C-Q6.           *)
   272	(* ==================================================================== *)
   273	
   274	(* ---- C-Q1 link 1a — evidence -> this acceptance --------------------- *)
   275	query l: bitstring; event(ChainBroken(l, LINK_1A)).
   276	
   277	(* ---- C-Q1 link 1b — authority -> tuple (correspondence, STRICT only) - *)
   278	query aid: bitstring, lyr: bitstring, t: bitstring, ev: bitstring,
   279	      slot: bitstring, kX: pkey, ppf: bitstring, sg: bitstring, fb: bitstring;
   280	  event(LayerAccepted(aid, lyr, t, ev, slot, kX, ppf, sg, fb))
   281	    ==> (event(AuthorityPublishedDNS(t)) || event(AuthorityPublishedRepo(t))).
   282	
   283	(* ---- C-Q1 link 2a — tuple -> slot ---------------------------------- *)
   284	query l: bitstring; event(ChainBroken(l, LINK_2A)).
   285	
   286	(* ---- C-Q1 link 2b — required set -> completeness (3 conjuncts) ------ *)
   287	query aid: bitstring, lyr: bitstring, id: bitstring, fpA: bitstring,
   288	      alg: bitstring, ver: bitstring;
   289	  event(AcceptanceComplete(aid, lyr, authTuple(id, fpA, signers0, alg, ver)))
   290	    ==> event(SlotSatisfied(aid, lyr, authTuple(id, fpA, signers0, alg, ver), fpA)).
   291	query aid: bitstring, lyr: bitstring, id: bitstring, fpA: bitstring,
   292	      fpB: bitstring, alg: bitstring, ver: bitstring;
   293	  event(AcceptanceComplete(aid, lyr, authTuple(id, fpA, signers1(fpB), alg, ver)))
   294	    ==> event(SlotSatisfied(aid, lyr, authTuple(id, fpA, signers1(fpB), alg, ver), fpA)).
   295	query aid: bitstring, lyr: bitstring, id: bitstring, fpA: bitstring,
   296	      fpB: bitstring, alg: bitstring, ver: bitstring;
   297	  event(AcceptanceComplete(aid, lyr, authTuple(id, fpA, signers1(fpB), alg, ver)))
   298	    ==> event(SlotSatisfied(aid, lyr, authTuple(id, fpA, signers1(fpB), alg, ver), fpB)).
   299	
   300	(* ---- C-Q7 — the signature-TERM judge (D5) --------------------------- *)
   301	query kX: pkey, s: bitstring; event(SigTransplanted(kX, s)).
   302	
   303	(* ---- C-Q8 — the signature/bytes judge, structural (D6) -------------- *)
   304	query kX: pkey, s: bitstring, fb: bitstring; event(SigBytesUnbound(kX, s, fb)).
   305	
   306	(* ---- C-Q9 — the possession/manifest judge (D10) --------------------- *)
   307	query kX: pkey, t: bitstring, ppf: bitstring; event(PossessionUnbound(kX, t, ppf)).
   308	
   309	(* ---- C-Q1 link 3 — slot -> possession ------------------------------- *)
   310	query l: bitstring; event(ChainBroken(l, LINK_3)).
   311	
   312	(* ---- C-Q1 link 4 — possession -> signing ---------------------------- *)
   313	query l: bitstring; event(ChainBroken(l, LINK_4)).
   314	
   315	(* ---- C-Q1 link 5 — signing -> bytes --------------------------------- *)
   316	query l: bitstring; event(ChainBroken(l, LINK_5)).
   317	
   318	(* ---- C-Q1 link 6a — bytes -> layer TYPE ----------------------------- *)
   319	query l: bitstring; event(ChainBroken(l, LINK_6A)).
   320	
   321	(* ---- C-Q1 link 6b — bytes -> innermost-issuer SCOPE ----------------- *)
   322	query l: bitstring; event(ChainBroken(l, LINK_6B)).
   323	
   324	(* ---- C-Q2 — the §A3.2.1 boundary judge, PAIR FORM (D9) -------------- *)
   325	query evD: bitstring, evR: bitstring, t1: bitstring, t2: bitstring;
   326	  event(TwoWorldsBroken(evD, evR, t1, t2)).
   327	
   328	(* ---- C-Q3 — the multi-signer key-binding judge, PER ROLE (D1) ------- *)
   329	query kX: pkey, kH: pkey, fb: bitstring; event(ReattributedA(kX, kH, fb)).
   330	query kX: pkey, kH: pkey, fb: bitstring; event(ReattributedB(kX, kH, fb)).
   331	
   332	(* ---- C-Q4 — the wrapped-attribution judges (D2, D5) ----------------- *)
   333	query kX: pkey, idX: bitstring, kH: pkey, idH: bitstring, fb: bitstring;
   334	  event(Rescoped(kX, idX, kH, idH, fb)).
   335	query kX: pkey, s: bitstring; event(InnerSigTransplanted(kX, s)).
   336	
   337	(* ---- C-Q5 — SetAltered (D10) ---------------------------------------- *)
   338	query kH: pkey, m: bitstring, t: bitstring; event(SetAltered(kH, m, t)).
   339	
   340	(* ---- C-Q5w — the honest-flow witness for C-Q5, one per set size ----- *)
   341	query k1: pkey;
   342	  event(HonestComplete(authTuple(issuerId, fp(pk(skI2)), signers0, algH, verH),
   343	                       verified1(k1))).
   344	query k1: pkey, k2: pkey;
   345	  event(HonestComplete(authTuple(issuerId2, fp(pk(skI)), signers1(fp(pk(skB2))), algH, verH),
   346	                       verified2(k1, k2))).
   347	
   348	(* ---- C-Q10 — the D-6 tag-separation judge --------------------------- *)
   349	query k: pkey, tg: bitstring; event(TagConfused(k, tg)).
   350	
   351	(* ---- C-Q6 — the wrapped-standing composition, formulation W --------- *)
   352	(* conjunct 1, the standing verdict (D12): unrestricted, then the two    *)
   353	(* honest-key forms (ENUM note 3's two-honest-values rule)               *)
   354	query aid: bitstring, lyr: bitstring, t: bitstring, kX: pkey, co: bitstring;
   355	  event(EstablishedWrapped(aid, lyr, t, kX, co, ESTABLISHED))
   356	    ==> event(Designated(kX, h(co))).
   357	query aid: bitstring, lyr: bitstring, t: bitstring, co: bitstring;
   358	  event(EstablishedWrapped(aid, lyr, t, pk(skI), co, ESTABLISHED))
   359	    ==> event(Designated(pk(skI), h(co))).
   360	query aid: bitstring, lyr: bitstring, t: bitstring, co: bitstring;
   361	  event(EstablishedWrapped(aid, lyr, t, pk(skI2), co, ESTABLISHED))
   362	    ==> event(Designated(pk(skI2), h(co))).
   363	(* conjunct 2, the entitled key (D13) *)
   364	query kX: pkey, t: bitstring; event(StandingUnentitledWrapped(kX, t)).
   365	(* conjunct 3, scope agreement (D11's conditional half) — the PAIR judge *)
   366	query a: bitstring, l: bitstring, k: pkey, ii: bitstring, ka: pkey, ia: bitstring;
   367	  event(ScopeMisreported(a, l, k, ii, ka, ia)).
   368	
   369	(* ---- the REQUIRED retained queries (LEDGER.md:1425-1447) ------------ *)
   370	query evD: bitstring, evR: bitstring, t: bitstring, k: pkey, fb: bitstring;
   371	  event(Accept(evD, evR, t, k, fb)) ==> event(IssuerSigned(k, fb)).
   372	query k: pkey, fb: bitstring;
   373	  event(AcceptedUnderHonestKey(k, fb)) ==> event(IssuerSigned(k, fb)).
   374	query t: bitstring, v: bitstring; event(Stripped(t, v)).
   375	query t: bitstring, k: pkey; event(SignerForged(t, k)).
   376	query t: bitstring, fa: bitstring, fb: bitstring; event(Spliced(t, fa, fb)).
   377	query otS: bitstring, otA: bitstring, fb: bitstring; event(TypeConfused(otS, otA, fb)).
   378	query fbq: bitstring, cvRec: bitstring, cvAct: bitstring;
   379	  event(VersionLied(fbq, cvRec, cvAct)).
   380	
   381	(* ---- C-N1 — the vacuity witnesses: must be REACHABLE ---------------- *)
   382	query t: bitstring; event(HonestChain(L0, t)).
   383	query t: bitstring; event(HonestChain(L1, t)).
   384	query t: bitstring; event(HonestChain(L2, t)).
   385	query k: pkey, fb: bitstring; event(HonestAccepted(k, fb)).
   386	query kH: pkey, fb: bitstring, kW: pkey; event(HonestWrappedAccepted(kH, fb, kW)).
   387	query k: pkey, aid: bitstring; event(HonestStandingEstablished(k, aid)).
   388	query a: bitstring, l: bitstring; event(HonestWrappedStandingAgreed(a, l)).
   389	
   390	(* ---- the five VOCABULARY witnesses (§3, C-N1's two kinds) ----------- *)
   391	query k: pkey, t: bitstring, a: bitstring;
   392	  event(StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, k, t, a)).
   393	query k: pkey, t: bitstring, a: bitstring;
   394	  event(StandingReport(ABSENT, SUPERSEDED, k, t, a)).
   395	query k: pkey, t: bitstring, a: bitstring;
   396	  event(StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, k, t, a)).
   397	query k: pkey, t: bitstring, a: bitstring;
   398	  event(StandingReport(ABSENT, ISSUANCE_REFUSED, k, t, a)).
   399	query k: pkey, t: bitstring, a: bitstring;
   400	  event(StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, k, t, a)).
   401	
   402	(* ==================================================================== *)
   403	(* ==== THE FIXTURE'S HONEST PROCESSES (§1.1) ========================= *)
   404	(* ==================================================================== *)
   405	
   406	(* --- the two authority channels, strict form (D-1, digest binding) --- *)
   407	let AuthorityDNS(skDp: skey, t: bitstring) =
   408	  event AuthorityPublishedDNS(t);
   409	  out(c, sign((STMT_DIGEST, h(t)), skDp)).
   410	
   411	let AuthorityRepo(skRp: skey, t: bitstring) =
   412	  event AuthorityPublishedRepo(t);
   413	  out(c, sign((STMT_DIGEST, h(t)), skRp)).
   414	
   415	(* --- an honest attester: ONE KEY, ONE MANIFEST (§1.1) ---------------- *)
   416	let Attester(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   417	  in(c, payload: bitstring);
   418	  event IssuerPossession(pk(sk));
   419	  let ppf = sign((POSS, m), sk) in
   420	  out(c, ppf);
   421	  let fb = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, payload) in
   422	  let sg = sign((BYTES, fb), sk) in
   423	  event IssuerSigned(pk(sk), fb);
   424	  ( out(honestTypeCh, (OT_ATTEST, fb))
   425	  | out(honestCh, (pk(sk), fb))
   426	  | out(honestInnerCh, (pk(sk), id, fb))
   427	  | out(honestSigCh, (pk(sk), sg))
   428	  | out(gsigHonCh, (pk(sk), sg))
   429	  | out(honestChainCh, (pk(sk), m, fb))
   430	  | out(c, sg) ).
   431	
   432	(* --- an honest issuer with a two-entry lineage: S-STANDING's          *)
   433	(* ShipIssuer, emitting the honest reports an Attester does for both    *)
   434	(* attempts, so the composed judges can pair with them.                 *)
   435	let ShipIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   436	  in(c, (p1: bitstring, p2: bitstring));
   437	  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
   438	  event IssuerPossession(pk(sk));
   439	  let ppf = sign((POSS, m), sk) in
   440	  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
   441	  let sg1 = sign((BYTES, fb1), sk) in
   442	  let core1 = attemptCore(m, ppf, sg1, decl1) in
   443	  event IssuerSigned(pk(sk), fb1);
   444	  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
   445	  let sg2 = sign((BYTES, fb2), sk) in
   446	  let core2 = attemptCore(m, ppf, sg2, decl2) in
   447	  event IssuerSigned(pk(sk), fb2);
   448	  event Designated(pk(sk), h(core2));
   449	  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_SHIPPED)),
   450	              TERM_SHIPPED(h(core2)), declT) in
   451	  ( out(c, ppf)
   452	  | out(c, (core1, fb1, sg1))
   453	  | out(c, (core2, fb2, sg2))
   454	  | out(designCh, (pk(sk), h(core2)))
   455	  | out(c, sign((TLR, body), sk))
   456	  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
   457	  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
   458	  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
   459	  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
   460	  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
   461	  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).
   462	
   463	(* --- the second terminal disposition: both attempts abandoned -------- *)
   464	let RefuseIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   465	  in(c, (p1: bitstring, p2: bitstring));
   466	  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
   467	  event IssuerPossession(pk(sk));
   468	  let ppf = sign((POSS, m), sk) in
   469	  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
   470	  let sg1 = sign((BYTES, fb1), sk) in
   471	  let core1 = attemptCore(m, ppf, sg1, decl1) in
   472	  event IssuerSigned(pk(sk), fb1);
   473	  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
   474	  let sg2 = sign((BYTES, fb2), sk) in
   475	  let core2 = attemptCore(m, ppf, sg2, decl2) in
   476	  event IssuerSigned(pk(sk), fb2);
   477	  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_ABANDONED)),
   478	              TERM_REFUSED, declT) in
   479	  ( out(c, ppf)
   480	  | out(c, (core1, fb1, sg1))
   481	  | out(c, (core2, fb2, sg2))
   482	  | out(c, sign((TLR, body), sk))
   483	  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
   484	  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
   485	  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
   486	  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
   487	  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
   488	  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).
   489	
   490	(* --- an honest wrapper: frames an adversary-chosen inner blob -------- *)
   491	let Wrapper(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   492	  in(c, (cvIw: bitstring, fbIA: bitstring, sgIA: bitstring,
   493	         fbIB: bitstring, sgIB: bitstring));
   494	  event IssuerPossession(pk(sk));
   495	  let ppf = sign((POSS, m), sk) in
   496	  out(c, ppf);
   497	  let fb = framed(OT_WRAPPER, algH, id, fp(pk(sk)), h(m), cv,
   498	                  wrap(cvIw, (fbIA, sgIA, fbIB, sgIB))) in
   499	  let sg = sign((BYTES, fb), sk) in
   500	  event IssuerSigned(pk(sk), fb);
   501	  ( out(honestTypeCh, (OT_WRAPPER, fb))
   502	  | out(honestCh, (pk(sk), fb))
   503	  | out(honestChainCh, (pk(sk), m, fb))
   504	  | out(gsigHonCh, (pk(sk), sg))
   505	  | out(c, sg) ).
   506	
   507	(* --- the FOREIGN-TAG SIGNER (§1.1, AMENDMENT 2026-09-18) ------------- *)
   508	(* The honest issuer key emits sign((REFUSAL, body), skI) for an         *)
   509	(* adversary-chosen core, body a TLR-shaped triple. It is a FOREIGN-TAG  *)
   510	(* SOURCE and nothing else: its body is opaque to every check while the  *)
   511	(* tag check stands, and chosen TLR-shaped as the worst case for         *)
   512	(* separation. It models NOTHING about the refusal record (A3 §A3.7.2,   *)
   513	(* L2-n, BAND0-EXIT E6). REFUSAL is exercised as a signing DOMAIN and    *)
   514	(* unexercised as a RECORD. Copied from the 2026-09-06 reviewer fixture  *)
   515	(* a_foreign_tag.pv:339-342.                                             *)
   516	let ForeignIssuer(sk: skey) =
   517	  in(c, foreignCore: bitstring);
   518	  let body = (lineage2(entry(h(foreignCore), DISP_SHIPPED), entry(fbH, DISP_ABANDONED)),
   519	              TERM_SHIPPED(h(foreignCore)), fbH) in
   520	  out(c, sign((REFUSAL, body), sk)).
   521	
   522	(* ==================================================================== *)
   523	(* ==== THE FRONT END: one fresh aid per PRESENTATION, at INTAKE ====== *)
   524	(* (§1.3). It reads the presented bundle once and forwards it on private *)
   525	(* channels to the envelope path and the standing path IN PARALLEL       *)
   526	(* (§1.2 "parallel to, never sequenced behind"; encoding rule (1)).      *)
   527	(* The name exists BEFORE any check runs, so a path may carry it without *)
   528	(* thereby asserting that the other path succeeded.                      *)
   529	(* ==================================================================== *)
   530	let Front =
   531	  (* ONE read of the presented bundle: the frames and signatures of the
   532	     outermost object, the per-layer verification material for L0, L1 and L2,
   533	     and the standing path's core and standing evidence.  Everything a path
   534	     uses below comes from THIS read.                                          *)
   535	  in(c, (fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring,
   536	         t0: bitstring, ev0D: bitstring, ev0R: bitstring,
   537	         kA0: pkey, ppfA0: bitstring, kB0: pkey, ppfB0: bitstring,
   538	         t1: bitstring, ev1D: bitstring, ev1R: bitstring,
   539	         kA1: pkey, ppfA1: bitstring, kB1: pkey, ppfB1: bitstring,
   540	         t2: bitstring, ev2D: bitstring, ev2R: bitstring,
   541	         kA2: pkey, ppfA2: bitstring, kB2: pkey, ppfB2: bitstring,
   542	         coreIn: bitstring, seIn: bitstring));
   543	  new aid: bitstring;
   544	  ( out(stageCh,  (aid, L0, BASE, kNone, idAdv, fbA, sgA, fbB, sgB))
   545	  | out(sStageCh, (aid, L0, fbA, sgA, fbB, sgB))
   546	  | !out(envMat, (aid, L0, t0, ev0D, ev0R, kA0, ppfA0, kB0, ppfB0))
   547	  | !out(envMat, (aid, L1, t1, ev1D, ev1R, kA1, ppfA1, kB1, ppfB1))
   548	  | !out(envMat, (aid, L2, t2, ev2D, ev2R, kA2, ppfA2, kB2, ppfB2))
   549	  | !out(stdMat, (aid, L0, t0, ev0D, ev0R, kA0, ppfA0, kB0, ppfB0))
   550	  | !out(stdMat, (aid, L1, t1, ev1D, ev1R, kA1, ppfA1, kB1, ppfB1))
   551	  | !out(stdMat, (aid, L2, t2, ev2D, ev2R, kA2, ppfA2, kB2, ppfB2))
   552	  | !out(standCore, (aid, coreIn, seIn)) ).
   553	
   554	(* ==================================================================== *)
   555	(* ==== THE ENVELOPE PATH: one acceptance path per layer (§1.2) ======= *)
   556	(*                                                                      *)
   557	(* AttestStage is the capstone's InnerCheck: it accepts ONE layer whose  *)
   558	(* object type is OT_ATTEST, with the layer index carried on stageCh.    *)
   559	(* It is SHARED by the base path (L0) and by the innermost layer of a    *)
   560	(* wrapped presentation (L1 at depth 1, L2 at depth 2), exactly as       *)
   561	(* S-P7's InnerCheck is shared by VerifierBase and VerifierWrapped.      *)
   562	(*                                                                      *)
   563	(* Checks, in §1.2's order:                                             *)
   564	(*  1 accepted authority evidence, per channel, checksign(ev,kCh) =     *)
   565	(*    (STMT_DIGEST, h(t))                            [S-P1 / first link] *)
   566	(*  2 key binding: the frame's kfp is fp(kX), and mh = h(t)     [S-P3]   *)
   567	(*  3 set logic: the signed t's required set names the slot,            *)
   568	(*    fp(kX) = kfpr, every required slot satisfied              [S-P2]   *)
   569	(*  4 common content: ota = otb, cva = cvb, pla = plb, plus alg, id     *)
   570	(*    pinned through t                                       [S-P2 Q6]   *)
   571	(*  5 type, opacity and recorded-version checks                 [S-P7]   *)
   572	(*  6 possession over the ACCEPTED MANIFEST under the ACCEPTING KEY,    *)
   573	(*    checksign(ppf,kX) = (POSS,t)                       [S-P3 / S-P2]   *)
   574	(* (7 is the standing path, which runs in parallel — below.)            *)
   575	(* ==================================================================== *)
   576	let AttestStage(pkDv: pkey, pkRv: pkey) =
   577	  in(stageCh, (aid: bitstring, lyr: bitstring, ctx: bitstring,
   578	               kEnc: pkey, idEnc: bitstring,
   579	               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
   580	  in(envMat, (=aid, =lyr, t: bitstring, evD: bitstring, evR: bitstring,
   581	              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
   582	  (* CHECK 1 *)
   583	  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in
   584	  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in
   585	  event AuthorityEvidence(t, evD, pkDv);
   586	  event AuthorityEvidence(t, evR, pkRv);
   587	  let authTuple(id, kfprA, ss, alg, ver) = t in
   588	  ( (* ---------------- the one-signer branch ---------------- *)
   589	    ( if ss = signers0 then
   590	      if fp(kA) = kfprA then                                            (* 3 *)
   591	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
   592	      if mhA = h(t) then                                                (* 2 *)
   593	      if otA = OT_ATTEST then                                           (* 5 *)
   594	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   595	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   596	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   597	      event SlotSatisfied(aid, lyr, t, kfprA);
   598	      event AcceptanceComplete(aid, lyr, t);
   599	      event Accept(evD, evR, t, kA, fbA);
   600	      event ScopeReported(aid, lyr, kA, id);
   601	      ( out(link1aCh, (lyr, t, evD, evR))
   602	      | out(link2aCh, (lyr, t, kfprA, kA))
   603	      | out(possCh, (lyr, kA, t, ppfA))
   604	      | out(bytesCh, (lyr, kA, sgA, fbA))
   605	      | out(link5Ch, (lyr, t, kA, fbA))
   606	      | out(link6aCh, (lyr, OT_ATTEST, fbA))
   607	      | out(link6bCh, (aid, lyr, kA, id, fbA))
   608	      | out(typeCh, (OT_ATTEST, fbA))
   609	      | out(slotCh, (t, kfprA, kA))
   610	      | out(setCh, (t, verified1(kA)))
   611	      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
   612	      | out(acceptKeyCh, (kA, fbA))
   613	      | out(scopeCh, (ctx, kA, id, fbA))
   614	      | out(sigCh, (ctx, kA, sgA))
   615	      | out(gsigCh, (kA, sgA))
   616	      | out(twoWorldsCh, (evD, evR, t))
   617	      | out(chainCh, (lyr, kA, t, fbA))
   618	      | out(scopeEnvelope, (aid, lyr, kA, id)) ) )
   619	  | (* ---------------- the two-signer branch ---------------- *)
   620	    ( let signers1(kfprB) = ss in
   621	      if fp(kA) = kfprA then                                            (* 3 *)
   622	      if fp(kB) = kfprB then                                            (* 3 *)
   623	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
   624	      if mhA = h(t) then                                                (* 2 *)
   625	      let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in      (* 2 *)
   626	      if mhB = h(t) then                                                (* 2 *)
   627	      if otA = OT_ATTEST then                                           (* 5 *)
   628	      if otB = OT_ATTEST then                                           (* 5 *)
   629	      if otA = otB then                                                 (* 4 *)
   630	      if cvsA = cvsB then                                               (* 4 *)
   631	      if plA = plB then                                                 (* 4 *)
   632	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   633	      let (=POSS, =t) = checksign(ppfB, kB) in                          (* 6 *)
   634	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   635	      let (=BYTES, =fbB) = checksign(sgB, kB) in
   636	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   637	      event LayerAccepted(aid, lyr, t, (evD, evR), kfprB, kB, ppfB, sgB, fbB);
   638	      event SlotSatisfied(aid, lyr, t, kfprA);
   639	      event SlotSatisfied(aid, lyr, t, kfprB);
   640	      event AcceptanceComplete(aid, lyr, t);
   641	      event Accept(evD, evR, t, kA, fbA);
   642	      event Accept(evD, evR, t, kB, fbB);
   643	      event ScopeReported(aid, lyr, kA, id);
   644	      ( out(link1aCh, (lyr, t, evD, evR))
   645	      | out(link2aCh, (lyr, t, kfprA, kA)) | out(link2aCh, (lyr, t, kfprB, kB))
   646	      | out(possCh, (lyr, kA, t, ppfA)) | out(possCh, (lyr, kB, t, ppfB))
   647	      | out(bytesCh, (lyr, kA, sgA, fbA)) | out(bytesCh, (lyr, kB, sgB, fbB))
   648	      | out(link5Ch, (lyr, t, kA, fbA)) | out(link5Ch, (lyr, t, kB, fbB))
   649	      | out(link5cCh, (lyr, fbA, fbB))
   650	      | out(link6aCh, (lyr, OT_ATTEST, fbA)) | out(link6aCh, (lyr, OT_ATTEST, fbB))
   651	      | out(link6bCh, (aid, lyr, kA, id, fbA))
   652	      | out(typeCh, (OT_ATTEST, fbA)) | out(typeCh, (OT_ATTEST, fbB))
   653	      | out(slotCh, (t, kfprA, kA)) | out(slotCh, (t, kfprB, kB))
   654	      | out(setCh, (t, verified2(kA, kB)))
   655	      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
   656	      | out(acceptCh, (ctx, SLOT_B, kB, id, fbB))
   657	      | out(acceptKeyCh, (kA, fbA)) | out(acceptKeyCh, (kB, fbB))
   658	      | out(scopeCh, (ctx, kA, id, fbA)) | out(scopeCh, (ctx, kB, id, fbB))
   659	      | out(sigCh, (ctx, kA, sgA)) | out(sigCh, (ctx, kB, sgB))
   660	      | out(gsigCh, (kA, sgA)) | out(gsigCh, (kB, sgB))
   661	      | out(twoWorldsCh, (evD, evR, t))
   662	      | out(chainCh, (lyr, kA, t, fbA)) | out(chainCh, (lyr, kB, t, fbB))
   663	      | out(contentCh, (t, fbA, fbB))
   664	      | out(scopeEnvelope, (aid, lyr, kA, id)) ) ) ).
   665	
   666	(* ==================================================================== *)
   667	(* ==== THE WRAPPER LAYER (S-P7's outer check, per layer) ============= *)
   668	(* Checks the outer object as the attestation path would, with          *)
   669	(* objType = OT_WRAPPER; checks the recorded inner canonicalization     *)
   670	(* version (A5.5); then hands the inner blob to the NEXT layer on       *)
   671	(* stageCh, with the context wctx(this wrapper's key, id, bytes).       *)
   672	(* Instantiated twice — (L0 -> L1) and (L1 -> L2) — which is what       *)
   673	(* bounds the depth at 2 (L-13's named scoping).                        *)
   674	(* ==================================================================== *)
   675	let WrapStage(pkDv: pkey, pkRv: pkey, lyrIn: bitstring, lyrOut: bitstring) =
   676	  in(stageCh, (aid: bitstring, =lyrIn, ctx: bitstring,
   677	               kEnc: pkey, idEnc: bitstring,
   678	               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
   679	  in(envMat, (=aid, =lyrIn, t: bitstring, evD: bitstring, evR: bitstring,
   680	              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
   681	  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in
   682	  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in
   683	  event AuthorityEvidence(t, evD, pkDv);
   684	  event AuthorityEvidence(t, evR, pkRv);
   685	  let authTuple(id, kfprA, ss, alg, ver) = t in
   686	  ( (* ---------------- the one-signer wrapper layer ---------------- *)
   687	    ( if ss = signers0 then
   688	      if fp(kA) = kfprA then
   689	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA,
   690	                 wrap(cvIw: bitstring, (fbIA: bitstring, sgIA: bitstring,
   691	                                        fbIB: bitstring, sgIB: bitstring))) = fbA in
   692	      if mhA = h(t) then
   693	      if otA = OT_WRAPPER then
   694	      let (=POSS, =t) = checksign(ppfA, kA) in
   695	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   696	      let framed(otIv, algIv, idIv, kfpIv, mhIv, =cvIw, plIv) = fbIA in
   697	      event LayerAccepted(aid, lyrIn, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   698	      event SlotSatisfied(aid, lyrIn, t, kfprA);
   699	      event AcceptanceComplete(aid, lyrIn, t);
   700	      event Accept(evD, evR, t, kA, fbA);
   701	      event ScopeReported(aid, lyrIn, kA, id);
   702	      ( out(link1aCh, (lyrIn, t, evD, evR))
   703	      | out(link2aCh, (lyrIn, t, kfprA, kA))
   704	      | out(possCh, (lyrIn, kA, t, ppfA))
   705	      | out(bytesCh, (lyrIn, kA, sgA, fbA))
   706	      | out(link5Ch, (lyrIn, t, kA, fbA))
   707	      | out(link6aCh, (lyrIn, OT_WRAPPER, fbA))
   708	      | out(link6bCh, (aid, lyrIn, kA, id, fbA))
   709	      | out(typeCh, (OT_WRAPPER, fbA))
   710	      | out(slotCh, (t, kfprA, kA))
   711	      | out(setCh, (t, verified1(kA)))
   712	      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
   713	      | out(acceptKeyCh, (kA, fbA))
   714	      | out(gsigCh, (kA, sgA))
   715	      | out(twoWorldsCh, (evD, evR, t))
   716	      | out(chainCh, (lyrIn, kA, t, fbA))
   717	      | out(versionCh, (fbA, cvIw, fbIA))
   718	      | out(scopeEnvelope, (aid, lyrIn, kA, id))
   719	      | out(stageCh, (aid, lyrOut, wctx(kA, id, fbA), kA, id,
   720	                      fbIA, sgIA, fbIB, sgIB)) ) )
   721	  | (* ---------------- the two-signer wrapper layer ---------------- *)
   722	    ( let signers1(kfprB) = ss in
   723	      if fp(kA) = kfprA then
   724	      if fp(kB) = kfprB then
   725	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA,
   726	                 wrap(cvIw: bitstring, (fbIA: bitstring, sgIA: bitstring,
   727	                                        fbIB: bitstring, sgIB: bitstring))) = fbA in
   728	      if mhA = h(t) then
   729	      let framed(otB, =alg, =id, =fp(kB), mhB, cvsB, plB) = fbB in
   730	      if mhB = h(t) then
   731	      if otA = OT_WRAPPER then
   732	      if otB = OT_WRAPPER then
   733	      if otA = otB then
   734	      if cvsA = cvsB then
   735	      if wrap(cvIw, (fbIA, sgIA, fbIB, sgIB)) = plB then
   736	      let (=POSS, =t) = checksign(ppfA, kA) in
   737	      let (=POSS, =t) = checksign(ppfB, kB) in
   738	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   739	      let (=BYTES, =fbB) = checksign(sgB, kB) in
   740	      let framed(otIv, algIv, idIv, kfpIv, mhIv, =cvIw, plIv) = fbIA in
   741	      event LayerAccepted(aid, lyrIn, t, (evD, evR), kfprA, kA, ppfA, sgA, fbA);
   742	      event LayerAccepted(aid, lyrIn, t, (evD, evR), kfprB, kB, ppfB, sgB, fbB);
   743	      event SlotSatisfied(aid, lyrIn, t, kfprA);
   744	      event SlotSatisfied(aid, lyrIn, t, kfprB);
   745	      event AcceptanceComplete(aid, lyrIn, t);
   746	      event Accept(evD, evR, t, kA, fbA);
   747	      event Accept(evD, evR, t, kB, fbB);
   748	      event ScopeReported(aid, lyrIn, kA, id);
   749	      ( out(link1aCh, (lyrIn, t, evD, evR))
   750	      | out(link2aCh, (lyrIn, t, kfprA, kA)) | out(link2aCh, (lyrIn, t, kfprB, kB))
   751	      | out(possCh, (lyrIn, kA, t, ppfA)) | out(possCh, (lyrIn, kB, t, ppfB))
   752	      | out(bytesCh, (lyrIn, kA, sgA, fbA)) | out(bytesCh, (lyrIn, kB, sgB, fbB))
   753	      | out(link5Ch, (lyrIn, t, kA, fbA)) | out(link5Ch, (lyrIn, t, kB, fbB))
   754	      | out(link5cCh, (lyrIn, fbA, fbB))
   755	      | out(link6aCh, (lyrIn, OT_WRAPPER, fbA)) | out(link6aCh, (lyrIn, OT_WRAPPER, fbB))
   756	      | out(link6bCh, (aid, lyrIn, kA, id, fbA))
   757	      | out(typeCh, (OT_WRAPPER, fbA)) | out(typeCh, (OT_WRAPPER, fbB))
   758	      | out(slotCh, (t, kfprA, kA)) | out(slotCh, (t, kfprB, kB))
   759	      | out(setCh, (t, verified2(kA, kB)))
   760	      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
   761	      | out(acceptCh, (ctx, SLOT_B, kB, id, fbB))
   762	      | out(acceptKeyCh, (kA, fbA)) | out(acceptKeyCh, (kB, fbB))
   763	      | out(gsigCh, (kA, sgA)) | out(gsigCh, (kB, sgB))
   764	      | out(twoWorldsCh, (evD, evR, t))
   765	      | out(chainCh, (lyrIn, kA, t, fbA)) | out(chainCh, (lyrIn, kB, t, fbB))
   766	      | out(contentCh, (t, fbA, fbB))
   767	      | out(versionCh, (fbA, cvIw, fbIA))
   768	      | out(scopeEnvelope, (aid, lyrIn, kA, id))
   769	      | out(stageCh, (aid, lyrOut, wctx(kA, id, fbA), kA, id,
   770	                      fbIA, sgIA, fbIB, sgIB)) ) ) ).
   771	
   772	(* ==================================================================== *)
   773	(* ==== THE STANDING PATH (check 7), PARALLEL to the envelope path ==== *)
   774	(*                                                                      *)
   775	(* (E1) SAME PRESENTATION: the standing path computes over the          *)
   776	(* innermost (t, ppf, sg, fb) that IT extracts STRUCTURALLY, ITSELF,    *)
   777	(* from the same bundle the front-end forwarded to it, under the same   *)
   778	(* intake aid. It neither waits for nor is conditioned on               *)
   779	(* LayerAccepted: no event of the envelope path, and no success of it,  *)
   780	(* is a precondition of EstablishedWrapped.                             *)
   781	(* (E2) SAME CORE: core = attemptCore(t, ppf, sg, decl) for exactly the *)
   782	(* t, ppf and sg of (E1) — the five term equalities of §3 C-Q6 (3),     *)
   783	(* which are IMMUTABLE and define the join.                             *)
   784	(* (E3) DERIVED IDENTITY: h(core), derived, never read from the bundle. *)
   785	(* (E4) WRAPPED: lyr <> L0, from the structural parse below.            *)
   786	(* (E5 was WITHDRAWN from the emission contract and lives only as       *)
   787	(* check 7's entitled-key comparison, which C-C12 removes.)             *)
   788	(* ==================================================================== *)
   789	
   790	(* the standing path's OWN structural unwrapping — no verifier check,   *)
   791	(* no signature, no authority: S-P7's wrap() destructuring performed on *)
   792	(* the standing path's own copy of the bundle.                          *)
   793	let SUnwrap(lyrIn: bitstring, lyrOut: bitstring) =
   794	  in(sStageCh, (aid: bitstring, =lyrIn, fbA: bitstring, sgA: bitstring,
   795	                fbB: bitstring, sgB: bitstring));
   796	  let framed(=OT_WRAPPER, awz, iwz, kwz, mwz, cwz,
   797	             wrap(cwi, (fbIA: bitstring, sgIA: bitstring,
   798	                        fbIB: bitstring, sgIB: bitstring))) = fbA in
   799	  out(sStageCh, (aid, lyrOut, fbIA, sgIA, fbIB, sgIB)).
   800	
   801	(* lineage lookup over the two-entry structure (S-STANDING, verbatim) *)
   802	fun lookup2(bitstring, bitstring): bitstring
   803	  reduc forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
   804	          lookup2(a, lineage2(entry(a, d1), entry(b, d2))) = d1
   805	  otherwise forall a: bitstring, d1: bitstring, b: bitstring, d2: bitstring;
   806	          lookup2(b, lineage2(entry(a, d1), entry(b, d2))) = d2.
   807	
   808	let StandingDecide(kT: pkey, t: bitstring, aidD: bitstring, d: bitstring,
   809	                   terminal: bitstring, intake: bitstring, lyr: bitstring,
   810	                   core: bitstring, idS: bitstring) =
   811	  if terminal = TERM_REFUSED then
   812	    ( event StandingReport(ABSENT, ISSUANCE_REFUSED, kT, t, aidD);       (* S4 *)
   813	      out(reasonCh, (PATH_S4, ISSUANCE_REFUSED)) )
   814	  else
   815	    ( let TERM_SHIPPED(shippedId) = terminal in
   816	      ( if shippedId = aidD then
   817	          ( if d = DISP_SHIPPED then
   818	              ( event Established(kT, t, aidD);
   819	                event StandingReport(ESTABLISHED, TERMINAL_DISPOSITION_SHOWN, kT, t, aidD);
   820	                ( ( if lyr <> L0 then
   821	                      event EstablishedWrapped(intake, lyr, t, kT, core, ESTABLISHED) )
   822	                | out(estCh, (intake, lyr, kT, t, aidD))
   823	                | out(scopeStanding, (intake, lyr, kT, idS, aidD)) ) )
   824	            else
   825	              event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aidD) )
   826	        else
   827	          ( event StandingReport(ABSENT, SUPERSEDED, kT, t, aidD);       (* S2 *)
   828	            out(reasonCh, (PATH_S2, SUPERSEDED)) ) )
   829	      else
   830	        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_MALFORMED, kT, t, aidD) ).
   831	
   832	let StandingPath(pkDv: pkey, pkRv: pkey) =
   833	  in(sStageCh, (intake: bitstring, lyr: bitstring, fbI: bitstring, sgI: bitstring,
   834	                fbIB: bitstring, sgIB: bitstring));
   835	  in(stdMat, (=intake, =lyr, t: bitstring, evD: bitstring, evR: bitstring,
   836	              kX: pkey, ppfI: bitstring, kBs: pkey, ppfBs: bitstring));
   837	  in(standCore, (=intake, core: bitstring, se: bitstring));
   838	  (* (E2), and the five immutable term equalities of §3 C-Q6 (3):
   839	     t = tI, ppf = ppfI, sg = sgI (a TERM equality, not a verification
   840	     equality — this is what denies the D-4 dsks route a second
   841	     (key, signature) pairing), fb = fbI, kX = kI.                       *)
   842	  let attemptCore(=t, =ppfI, =sgI, declS) = core in
   843	  let (=STMT_DIGEST, =h(t)) = checksign(evD, pkDv) in
   844	  let (=STMT_DIGEST, =h(t)) = checksign(evR, pkRv) in
   845	  let authTuple(idS, kfpr, ss, alg, ver) = t in
   846	  let aidD = h(core) in                                            (* (E3) *)
   847	  if se = noTLR then
   848	    ( event StandingReport(ABSENT, NO_TERMINAL_DISPOSITION_EVIDENCE, kX, t, aidD);
   849	      out(reasonCh, (PATH_S3, NO_TERMINAL_DISPOSITION_EVIDENCE)) )       (* S3 *)
   850	  else
   851	    ( let withTLR(kT, tlrSig, ap) = se in
   852	      (* CHECK 7, the entitled-key comparison: the TLR key is the key the
   853	         evidenced tuple names.  C-C12 removes `fp(kT) = kfpr` ONLY and
   854	         RETAINS `kT = kX`.                                              *)
   855	      if fp(kT) = kfpr then
   856	        ( if kT = kX then
   857	          (* the D-6 TLR TAG CHECK — the check C-C18 unbinds *)
   858	          let (=TLR, (lin: bitstring, terminal: bitstring, declT: bitstring)) =
   859	                checksign(tlrSig, kT) in
   860	            ( out(tagCh, (kT, TLR))
   861	            | ( let anchorProof(=h(tlrSig)) = ap in
   862	                  ( let d = lookup2(aidD, lin) in
   863	                      StandingDecide(kT, t, aidD, d, terminal, intake, lyr, core, idS)
   864	                    else
   865	                      event StandingReport(ABSENT, STANDING_EVIDENCE_MISMATCH, kT, t, aidD) )
   866	                else
   867	                  event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_TEMPORAL_MISMATCH, kT, t, aidD) ) )
   868	          else
   869	            event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) )
   870	      else
   871	        event StandingReport(UNVERIFIABLE, STANDING_EVIDENCE_SIGNATURE_INVALID, kT, t, aidD) ).
   872	
   873	(* ==================================================================== *)
   874	(* ==== THE JUDGES (private channels; never verifier checks) ========== *)
   875	(* ==================================================================== *)
   876	
   877	(* ---- C-Q1 link 1a: each carried evidence term verifies over the
   878	        consumed t under its OWN channel key, INCLUDING the case where a
   879	        carried term does not verify at all (the destructor's else).     *)
   880	let Link1aJudge(pkDv: pkey, pkRv: pkey) =
   881	  in(link1aCh, (lyr: bitstring, t: bitstring, evD: bitstring, evR: bitstring));
