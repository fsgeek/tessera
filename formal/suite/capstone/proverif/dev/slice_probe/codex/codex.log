   436	(* --- the two authority channels, strict form (D-1, digest binding) --- *)
   437	let AuthorityS(skSp: skey, t: bitstring) =
   438	  event AuthorityPublishedDNS(t);
   439	  out(c, sign((STMT_DIGEST, h(t)), skSp)).
   440	
   441	(* --- an honest attester: ONE KEY, ONE MANIFEST (§1.1) ---------------- *)
   442	let Attester(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   443	  in(c, payload: bitstring);
   444	  event IssuerPossession(pk(sk));
   445	  let ppf = sign((POSS, m), sk) in
   446	  out(c, ppf);
   447	  let fb = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, payload) in
   448	  let sg = sign((BYTES, fb), sk) in
   449	  event IssuerSigned(pk(sk), fb);
   450	  ( out(honestTypeCh, (OT_ATTEST, fb))
   451	  | out(honestCh, (pk(sk), fb))
   452	  | out(honestInnerCh, (pk(sk), id, fb))
   453	  | out(honestSigCh, (pk(sk), sg))
   454	  | out(gsigHonCh, (pk(sk), sg))
   455	  | out(honestChainCh, (pk(sk), m, fb))
   456	  | out(c, sg) ).
   457	
   458	(* --- an honest issuer with a two-entry lineage: S-STANDING's          *)
   459	(* ShipIssuer, emitting the honest reports an Attester does for both    *)
   460	(* attempts, so the composed judges can pair with them.                 *)
   461	let ShipIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   462	  in(c, (p1: bitstring, p2: bitstring));
   463	  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
   464	  event IssuerPossession(pk(sk));
   465	  let ppf = sign((POSS, m), sk) in
   466	  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
   467	  let sg1 = sign((BYTES, fb1), sk) in
   468	  let core1 = attemptCore(m, ppf, sg1, decl1) in
   469	  event IssuerSigned(pk(sk), fb1);
   470	  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
   471	  let sg2 = sign((BYTES, fb2), sk) in
   472	  let core2 = attemptCore(m, ppf, sg2, decl2) in
   473	  event IssuerSigned(pk(sk), fb2);
   474	  event Designated(pk(sk), h(core2));
   475	  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_SHIPPED)),
   476	              TERM_SHIPPED(h(core2)), declT) in
   477	  ( out(c, ppf)
   478	  | out(c, (core1, fb1, sg1))
   479	  | out(c, (core2, fb2, sg2))
   480	  | out(designCh, (pk(sk), h(core2)))
   481	  | out(c, sign((TLR, body), sk))
   482	  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
   483	  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
   484	  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
   485	  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
   486	  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
   487	  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).
   488	
   489	(* --- the second terminal disposition: both attempts abandoned -------- *)
   490	let RefuseIssuer(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   491	  in(c, (p1: bitstring, p2: bitstring));
   492	  new decl1: bitstring; new decl2: bitstring; new declT: bitstring;
   493	  event IssuerPossession(pk(sk));
   494	  let ppf = sign((POSS, m), sk) in
   495	  let fb1 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p1) in
   496	  let sg1 = sign((BYTES, fb1), sk) in
   497	  let core1 = attemptCore(m, ppf, sg1, decl1) in
   498	  event IssuerSigned(pk(sk), fb1);
   499	  let fb2 = framed(OT_ATTEST, algH, id, fp(pk(sk)), h(m), cv, p2) in
   500	  let sg2 = sign((BYTES, fb2), sk) in
   501	  let core2 = attemptCore(m, ppf, sg2, decl2) in
   502	  event IssuerSigned(pk(sk), fb2);
   503	  let body = (lineage2(entry(h(core1), DISP_ABANDONED), entry(h(core2), DISP_ABANDONED)),
   504	              TERM_REFUSED, declT) in
   505	  ( out(c, ppf)
   506	  | out(c, (core1, fb1, sg1))
   507	  | out(c, (core2, fb2, sg2))
   508	  | out(c, sign((TLR, body), sk))
   509	  | out(honestTypeCh, (OT_ATTEST, fb1)) | out(honestTypeCh, (OT_ATTEST, fb2))
   510	  | out(honestCh, (pk(sk), fb1)) | out(honestCh, (pk(sk), fb2))
   511	  | out(honestInnerCh, (pk(sk), id, fb1)) | out(honestInnerCh, (pk(sk), id, fb2))
   512	  | out(honestSigCh, (pk(sk), sg1)) | out(honestSigCh, (pk(sk), sg2))
   513	  | out(gsigHonCh, (pk(sk), sg1)) | out(gsigHonCh, (pk(sk), sg2))
   514	  | out(honestChainCh, (pk(sk), m, fb1)) | out(honestChainCh, (pk(sk), m, fb2)) ).
   515	
   516	(* --- an honest wrapper: frames an adversary-chosen inner blob -------- *)
   517	let Wrapper(sk: skey, id: bitstring, m: bitstring, cv: bitstring) =
   518	  in(c, (cvIw: bitstring, fbIA: bitstring, sgIA: bitstring,
   519	         fbIB: bitstring, sgIB: bitstring));
   520	  event IssuerPossession(pk(sk));
   521	  let ppf = sign((POSS, m), sk) in
   522	  out(c, ppf);
   523	  let fb = framed(OT_WRAPPER, algH, id, fp(pk(sk)), h(m), cv,
   524	                  wrap(cvIw, (fbIA, sgIA, fbIB, sgIB))) in
   525	  let sg = sign((BYTES, fb), sk) in
   526	  event IssuerSigned(pk(sk), fb);
   527	  ( out(honestTypeCh, (OT_WRAPPER, fb))
   528	  | out(honestCh, (pk(sk), fb))
   529	  | out(honestChainCh, (pk(sk), m, fb))
   530	  | out(gsigHonCh, (pk(sk), sg))
   531	  | out(c, sg) ).
