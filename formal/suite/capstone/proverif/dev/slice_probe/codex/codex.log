   533	(* --- the FOREIGN-TAG SIGNER (§1.1, AMENDMENT 2026-09-18) ------------- *)
   534	(* The honest issuer key emits sign((REFUSAL, body), skI) for an         *)
   535	(* adversary-chosen core, body a TLR-shaped triple. It is a FOREIGN-TAG  *)
   536	(* SOURCE and nothing else: its body is opaque to every check while the  *)
   537	(* tag check stands, and chosen TLR-shaped as the worst case for         *)
   538	(* separation. It models NOTHING about the refusal record (A3 §A3.7.2,   *)
   539	(* L2-n, BAND0-EXIT E6). REFUSAL is exercised as a signing DOMAIN and    *)
   540	(* unexercised as a RECORD. Copied from the 2026-09-06 reviewer fixture  *)
   541	(* a_foreign_tag.pv:339-342.                                             *)
   542	let ForeignIssuer(sk: skey) =
   543	  in(c, foreignCore: bitstring);
   544	  let body = (lineage2(entry(h(foreignCore), DISP_SHIPPED), entry(fbH, DISP_ABANDONED)),
   545	              TERM_SHIPPED(h(foreignCore)), fbH) in
   546	  out(c, sign((REFUSAL, body), sk)).
