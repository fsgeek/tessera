   548	(* ==================================================================== *)
   549	(* ==== THE FRONT END: one fresh aid per PRESENTATION, at INTAKE ====== *)
   550	(* (§1.3). It reads the presented bundle once and forwards it on private *)
   551	(* channels to the envelope path and the standing path IN PARALLEL       *)
   552	(* (§1.2 "parallel to, never sequenced behind"; encoding rule (1)).      *)
   553	(* The name exists BEFORE any check runs, so a path may carry it without *)
   554	(* thereby asserting that the other path succeeded.                      *)
   555	(* ==================================================================== *)
   556	let Front =
   557	  (* ONE read of the presented bundle: the frames and signatures of the
   558	     outermost object, the per-layer verification material for L0, L1 and L2,
   559	     and the standing path's core and standing evidence.  Everything a path
   560	     uses below comes from THIS read.                                          *)
   561	  in(c, (fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring,
   562	         t0: bitstring, ev0: bitstring,
   563	         kA0: pkey, ppfA0: bitstring, kB0: pkey, ppfB0: bitstring,
   564	         t1: bitstring, ev1: bitstring,
   565	         kA1: pkey, ppfA1: bitstring, kB1: pkey, ppfB1: bitstring,
   566	         t2: bitstring, ev2: bitstring,
   567	         kA2: pkey, ppfA2: bitstring, kB2: pkey, ppfB2: bitstring,
   568	         coreIn: bitstring, seIn: bitstring));
   569	  new aid: bitstring;
   570	  ( out(stageCh,  (aid, L0, BASE, kNone, idAdv, fbA, sgA, fbB, sgB))
   571	  | out(sStageCh, (aid, L0, fbA, sgA, fbB, sgB))
   572	  | !out(envMat, (aid, L0, t0, ev0, kA0, ppfA0, kB0, ppfB0))
   573	  | !out(envMat, (aid, L1, t1, ev1, kA1, ppfA1, kB1, ppfB1))
   574	  | !out(envMat, (aid, L2, t2, ev2, kA2, ppfA2, kB2, ppfB2))
   575	  | !out(stdMat, (aid, L0, t0, ev0, kA0, ppfA0, kB0, ppfB0))
   576	  | !out(stdMat, (aid, L1, t1, ev1, kA1, ppfA1, kB1, ppfB1))
   577	  | !out(stdMat, (aid, L2, t2, ev2, kA2, ppfA2, kB2, ppfB2))
   578	  | !out(standCore, (aid, coreIn, seIn)) ).
   579	
   580	(* ==================================================================== *)
   581	(* ==== THE ENVELOPE PATH: one acceptance path per layer (§1.2) ======= *)
   582	(*                                                                      *)
   583	(* AttestStage is the capstone's InnerCheck: it accepts ONE layer whose  *)
   584	(* object type is OT_ATTEST, with the layer index carried on stageCh.    *)
   585	(* It is SHARED by the base path (L0) and by the innermost layer of a    *)
   586	(* wrapped presentation (L1 at depth 1, L2 at depth 2), exactly as       *)
   587	(* S-P7's InnerCheck is shared by VerifierBase and VerifierWrapped.      *)
   588	(*                                                                      *)
   589	(* Checks, in §1.2's order:                                             *)
   590	(*  1 accepted authority evidence, per channel, checksign(ev,kCh) =     *)
   591	(*    (STMT_DIGEST, h(t))                            [S-P1 / first link] *)
   592	(*  2 key binding: the frame's kfp is fp(kX), and mh = h(t)     [S-P3]   *)
   593	(*  3 set logic: the signed t's required set names the slot,            *)
   594	(*    fp(kX) = kfpr, every required slot satisfied              [S-P2]   *)
   595	(*  4 common content: ota = otb, cva = cvb, pla = plb, plus alg, id     *)
   596	(*    pinned through t                                       [S-P2 Q6]   *)
   597	(*  5 type, opacity and recorded-version checks                 [S-P7]   *)
   598	(*  6 possession over the ACCEPTED MANIFEST under the ACCEPTING KEY,    *)
   599	(*    checksign(ppf,kX) = (POSS,t)                       [S-P3 / S-P2]   *)
   600	(* (7 is the standing path, which runs in parallel — below.)            *)
   601	(* ==================================================================== *)
   602	let AttestStage(pkSv: pkey) =
   603	  in(stageCh, (aid: bitstring, lyr: bitstring, ctx: bitstring,
   604	               kEnc: pkey, idEnc: bitstring,
   605	               fbA: bitstring, sgA: bitstring, fbB: bitstring, sgB: bitstring));
   606	  in(envMat, (=aid, =lyr, t: bitstring, ev: bitstring,
   607	              kA: pkey, ppfA: bitstring, kB: pkey, ppfB: bitstring));
   608	  (* CHECK 1 *)
   609	  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkSv) in
   610	  event AuthorityEvidence(t, ev, pkSv);
   611	  let authTuple(id, kfprA, ss, alg, ver) = t in
   612	  ( (* ---------------- the one-signer branch ---------------- *)
   613	    ( if ss = signers0 then
   614	      if fp(kA) = kfprA then                                            (* 3 *)
   615	      let framed(otA, =alg, =id, =fp(kA), mhA, cvsA, plA) = fbA in      (* 2 *)
   616	      if mhA = h(t) then                                                (* 2 *)
   617	      if otA = OT_ATTEST then                                           (* 5 *)
   618	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   619	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   620	      event LayerAccepted(aid, lyr, t, ev, kfprA, kA, ppfA, sgA, fbA);
   621	      event SlotSatisfied(aid, lyr, t, kfprA);
   622	      event AcceptanceComplete(aid, lyr, t);
   623	      event AcceptS(ev, t, kA, fbA);
   624	      event ScopeReported(aid, lyr, kA, id);
   625	      ( out(link1aCh, (lyr, t, ev))
   626	      | out(link2aCh, (lyr, t, kfprA, kA))
   627	      | out(possCh, (lyr, kA, t, ppfA))
   628	      | out(bytesCh, (lyr, kA, sgA, fbA))
   629	      | out(link5Ch, (lyr, t, kA, fbA))
   630	      | out(link6aCh, (lyr, OT_ATTEST, fbA))
   631	      | out(link6bCh, (aid, lyr, kA, id, fbA))
   632	      | out(typeCh, (OT_ATTEST, fbA))
   633	      | out(slotCh, (t, kfprA, kA))
   634	      | out(setCh, (t, verified1(kA)))
   635	      | out(acceptCh, (ctx, SLOT_A, kA, id, fbA))
   636	      | out(acceptKeyCh, (kA, fbA))
   637	      | out(scopeCh, (ctx, kA, id, fbA))
   638	      | out(sigCh, (ctx, kA, sgA))
   639	      | out(gsigCh, (kA, sgA))
   640	      | out(chainCh, (lyr, kA, t, fbA))
   641	      | out(scopeEnvelope, (aid, lyr, kA, id)) ) )
   642	  | (* ---------------- the two-signer branch ---------------- *)
   643	    ( let signers1(kfprB) = ss in
   644	      if fp(kA) = kfprA then                                            (* 3 *)
   645	      if fp(kB) = kfprB then                                            (* 3 *)
   646	      let framed(otA, =alg, =id, kfpxA, mhA, cvsA, plA) = fbA in      (* 2 *)
   647	      let framed(otB, =alg, =id, kfpxB, mhB, cvsB, plB) = fbB in      (* 2 *)
   648	      if otA = OT_ATTEST then                                           (* 5 *)
   649	      if otB = OT_ATTEST then                                           (* 5 *)
   650	      if otA = otB then                                                 (* 4 *)
   651	      if cvsA = cvsB then                                               (* 4 *)
   652	      if plA = plB then                                                 (* 4 *)
   653	      let (=POSS, =t) = checksign(ppfA, kA) in                          (* 6 *)
   654	      let (=POSS, =t) = checksign(ppfB, kB) in                          (* 6 *)
   655	      let (=BYTES, =fbA) = checksign(sgA, kA) in
   656	      let (=BYTES, =fbB) = checksign(sgB, kB) in
   657	      event LayerAccepted(aid, lyr, t, ev, kfprA, kA, ppfA, sgA, fbA);
   658	      event LayerAccepted(aid, lyr, t, ev, kfprB, kB, ppfB, sgB, fbB);
   659	      event SlotSatisfied(aid, lyr, t, kfprA);
   660	      event SlotSatisfied(aid, lyr, t, kfprB);
   661	      event AcceptanceComplete(aid, lyr, t);
   662	      event AcceptS(ev, t, kA, fbA);
   663	      event AcceptS(ev, t, kB, fbB);
