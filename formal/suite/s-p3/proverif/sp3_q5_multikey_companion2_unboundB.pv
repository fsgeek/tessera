(* ==================================================================== *)
(* S-P3.Q5 — multi-key manifest (A3.2 item 3; note 1 item 2(d)).       *)
(* Variant: BROKEN COMPANION 2 (unregistered): B's frame omits all bi                                                 *)
(*                                                                      *)
(* Registered prediction (PREDICTIONS.md, frozen fe1517c): correct     *)
(* model holds; companion red on exactly the second signer (p~0.55);   *)
(* encoding defect (p~0.2); timeout (p~0.25). Timebox: 30 min each.    *)
(*                                                                      *)
(* Two required signers A and B on ONE manifest: the tuple's signer-set *)
(* field carries B's fingerprint (sset = fp(pk(skB))); A's fingerprint  *)
(* is the tuple's kfp field. Each signature's frame binds ITS OWN       *)
(* signer's fingerprint; both keys give possession over the manifest.  *)
(* Degraded mode, sole channel compromised (the P3 hard case). Judges  *)
(* pair per signer by framed bytes, one judge per ROLE (recut 2).       *)
(* Exists to go RED on Reattributed for signer B only. Added after      *)
(* reading the Q3 trace: the manifest hash alone pins the tuple, so a   *)
(* frame lacking only the fingerprint may not be reachable; this        *)
(* companion mirrors Q3's mutation for B. Discharges nothing.           *)
(* Recut note: report outputs asynchronous (see Q1–Q4 headers).        *)
(* Theory: formal/suite/lib/tessera_theory.pvl. Fixture per note 3     *)
(* (N2): a second honest manifest with its own two signers; payloads   *)
(* adversary-chosen; N1 vacuity query on Accept2 included.             *)
(* Run: proverif -lib ../../lib/tessera_theory.pvl sp3_q5_multikey_companion2_unboundB.pv            *)
(* RECUT 3, 2026-09-05, after two blind falsification reviews (see        *)
(* RESULTS.md and docs/reviews/2026-09-05-blind-falsification-sp3-q2.md): *)
(* (a) the N1 witness is now HONEST-flow acceptance — the judge emits      *)
(*     HonestAccepted when the accepted key IS the signer's; a bare         *)
(*     acceptance witness was satisfiable by impersonation alone;           *)
(* (b) judge locals renamed (fbHon) to stop shadowing the library's fbH;    *)
(* (c) header claims narrowed: what these queries discharge is the          *)
(*     key-fingerprint binding (redundantly, manifest-hash) under a perfect  *)
(*     fingerprint; the result does not depend on signature security at    *)
(*     all — it holds even under total exclusive-ownership failure; the     *)
(*     authority-evidence check is inert here by construction (the sole     *)
(*     channel key is public); possession-not-transplanted is an A1.5/P10  *)
(*     result carried in S-P3, not a P3 result; identity, algorithm,        *)
(*     object type, canonicalization version and domain tags are included   *)
(*     in the signed bytes but unexercised by these two queries.            *)
(* Results were unchanged by (a) and (b).                                   *)
(* ==================================================================== *)

(* --- model-local declarations (library terms are not redeclared) ---- *)
fun framed(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring): bitstring [data].
  (* objType, alg, issuerId, kfp, manifestHash, canonVer, payload *)
fun framedU(bitstring, bitstring, bitstring, bitstring): bitstring [data].
  (* BROKEN COMPANION 2 (added 2026-09-04, unregistered): objType, alg, canonVer, payload — no id, kfp, or mh *)
free objTypeH: bitstring.
free canonVerH: bitstring.
free issuerId2: bitstring.

free honestChA: channel [private].     (* signer A -> judge : (signer key, framed bytes) *)
free honestChB: channel [private].     (* signer B -> judge *)
free acceptCh: channel [private].      (* verifier -> judge : (accepted key, id, framed bytes) *)
free honestPossCh: channel [private].
free possCh: channel [private].
event ReattributedA(pkey, pkey, bitstring).   (* signer A's honest bytes accepted under another key *)
event ReattributedB(pkey, pkey, bitstring).   (* signer B's *)
event PossessionTransplanted(pkey, bitstring).
event HonestAccepted(pkey, bitstring).
  (* N1 witness (recut 3): honest bytes accepted under their signer's key *)
event Accept2(bitstring, bitstring, pkey, pkey, bitstring, bitstring).
  (* evidence, tuple, key A, key B, bytes A, bytes B *)

query kX: pkey, kH: pkey, fb: bitstring;
  event(ReattributedA(kX, kH, fb)).
query kX: pkey, kH: pkey, fb: bitstring;
  event(ReattributedB(kX, kH, fb)).
query kX: pkey, p: bitstring;
  event(PossessionTransplanted(kX, p)).
(* N1 honest-flow witness: must be REACHABLE *)
query k: pkey, fb: bitstring;
  event(HonestAccepted(k, fb)).
(* N1 vacuity witness: must be REACHABLE *)
query ev: bitstring, t: bitstring, kA: pkey, kB: pkey, fa: bitstring, fb: bitstring;
  event(Accept2(ev, t, kA, kB, fa, fb)).

let AuthorityS(skS: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT_DIGEST, h(t)), skS)).

(* One signer of a two-signer manifest m: possession over m; frame     *)
(* binds this signer's own fingerprint. B's frame carries NO binding fields.                  *)
let SignerA(sk: skey, id: bitstring, m: bitstring) =
  in(c, payload: bitstring);
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, m), sk) in
  ( out(honestPossCh, (pk(sk), ppf))
  | out(c, ppf);
  let fb = framed(objTypeH, algH, id, fp(pk(sk)), h(m), canonVerH, payload) in
  event IssuerSigned(pk(sk), fb);
  ( out(honestChA, (pk(sk), fb))
  | out(c, sign((BYTES, fb), sk)) ) ).

let SignerB(sk: skey, id: bitstring, m: bitstring) =
  in(c, payload: bitstring);
  event IssuerPossession(pk(sk));
  let ppf = sign((POSS, m), sk) in
  ( out(honestPossCh, (pk(sk), ppf))
  | out(c, ppf);
  let fb = framedU(objTypeH, algH, canonVerH, payload) in
  event IssuerSigned(pk(sk), fb);
  ( out(honestChB, (pk(sk), fb))
  | out(c, sign((BYTES, fb), sk)) ) ).

let VerifierS(pkS: pkey) =
  in(c, (t: bitstring, ev: bitstring,
         kA: pkey, kB: pkey, ppfA: bitstring, ppfB: bitstring,
         sgA: bitstring, sgB: bitstring, fa: bitstring, fb: bitstring));
  let (=STMT_DIGEST, =h(t)) = checksign(ev, pkS) in
  (* signer-set field carries the second required fingerprint *)
  let authTuple(id, kfprA, kfprB, alg, ver) = t in
  if fp(kA) = kfprA then
  if fp(kB) = kfprB then
  let (=POSS, =t) = checksign(ppfA, kA) in
  let (=POSS, =t) = checksign(ppfB, kB) in
  let (=BYTES, =fa) = checksign(sgA, kA) in
  let (=BYTES, =fb) = checksign(sgB, kB) in
  let framed(ota, =alg, =id, =fp(kA), mha, cva, pla) = fa in
  if mha = h(t) then
  let framedU(otb, =alg, cvb, plb) = fb in
  event Accept2(ev, t, kA, kB, fa, fb);
  ( out(possCh, (kA, ppfA)) | out(possCh, (kB, ppfB))
  | out(acceptCh, (kA, id, fa)) | out(acceptCh, (kB, id, fb)) ).

let JudgeA =
  in(honestChA, (kH: pkey, fbHon: bitstring));
  in(acceptCh, (kX: pkey, id: bitstring, =fbHon));
  if kX = kH then event HonestAccepted(kX, fbHon)
  else event ReattributedA(kX, kH, fbHon).

let JudgeB =
  in(honestChB, (kH: pkey, fbHon: bitstring));
  in(acceptCh, (kX: pkey, id: bitstring, =fbHon));
  if kX = kH then event HonestAccepted(kX, fbHon)
  else event ReattributedB(kX, kH, fbHon).

let PossJudge =
  in(honestPossCh, (kH: pkey, p: bitstring));
  in(possCh, (kX: pkey, =p));
  if kX = kH then 0
  else event PossessionTransplanted(kX, p).

process
  new skS: skey;
  new skA: skey; new skB: skey; new skA2: skey; new skB2: skey;
  let m  = authTuple(issuerId,  fp(pk(skA)),  fp(pk(skB)),  algH, verH) in
  let m2 = authTuple(issuerId2, fp(pk(skA2)), fp(pk(skB2)), algH, verH) in
  out(c, pk(skS)); out(c, pk(skA)); out(c, pk(skB)); out(c, pk(skA2)); out(c, pk(skB2));
  out(c, m); out(c, m2);
  (* DEGRADED MODE, SOLE CHANNEL COMPROMISED: its signing key is public *)
  out(c, skS);
  ( !AuthorityS(skS, m) | !AuthorityS(skS, m2)
  | !SignerA(skA, issuerId, m)  | !SignerB(skB, issuerId, m)
  | !SignerA(skA2, issuerId2, m2) | !SignerB(skB2, issuerId2, m2)
  | !VerifierS(pk(skS))
  | !JudgeA | !JudgeB | !PossJudge )
