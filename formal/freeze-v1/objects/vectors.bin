def _ots_mut(name, fn):
    def f(c):
        c.ots[name] = fn(c, c.ots[name])
    return f


def _proof_mut(name, fn):
    def f(c):
        fn(c, c.proofs[name])
    return f


def _redundant_height(c, pr):
    for i, (ops, att) in enumerate(pr.paths):
        if att[1] == U.TAG_BTC:
            p = bytearray(att[2])
            p[-1] |= 0x80
            pr.paths[i] = (ops, (att[0], att[1], bytes(p) + b"\x00"))
            return


