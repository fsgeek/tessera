        (lambda p, v: lambda: I.issue(**_auth_keys("ii-" + v), adversarial=True, hooks=hk(dns_plan=p)))(_plan, _v),
        (lambda v: lambda: I.issue(**_auth_keys("ii-" + v)))(_v),
