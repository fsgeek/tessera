# ======================================================================================== signature profile
def _sig_case(hashed_fn=None, unhashed_fn=None, adversarial=True, **kw):
    def f(c):
        args = dict(kw)
        if hashed_fn:
            args["hashed"] = hashed_fn(c)
        if unhashed_fn:
            args["unhashed"] = unhashed_fn(c)
        resign("gpg", **args)(c)
    return lambda: I.issue(adversarial=adversarial, hooks=hk(sign=f))


