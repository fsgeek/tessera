def _poss(slot, **kw):
    def f(c):
        doc = kw.pop("doc", None) if "doc" in kw else None
        key = c.kms if slot == "kms" else c.gpg
        s = tc.pgp_sign(doc if doc is not None else c.F_manifest, key, c.sig_time, **kw)
        setattr(c, "P_" + slot, s)
    return f


