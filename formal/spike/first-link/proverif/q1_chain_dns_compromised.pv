(* ==================================================================== *)
(* Q1 — correct model, full-chain linkage correspondence.               *)
(* Variant: DNS channel COMPROMISED (skDNS leaked to the adversary).    *)
(*                                                                      *)
(* Registered prediction (PREDICTIONS.md, frozen): terminates,          *)
(* property holds (p~0.7); violation likely-encoding-defect requiring   *)
(* trace inspection (p~0.2); timeout (p~0.1). Timebox: 15 min.          *)
(*                                                                      *)
(* This model proves: in this n=2 DNS-compromise variant, strict        *)
(* acceptance validates both evidence objects and implies that at least*)
(* one uncompromised publication branch emitted the exact accepted     *)
(* statement, while the accepted key proves possession and signs the   *)
(* exact framed bytes.                                                  *)
(* This model does not prove: honest provenance for both presented     *)
(* objects; semantic truth or policy sufficiency of bound fields;       *)
(* real-world referent identity; concrete encoding; implementation     *)
(* fidelity; or arbitrary-channel generalization.                       *)
(*                                                                      *)
(* The five-event A3.2 correspondence, with two authority-publication  *)
(* branches, requires in strict mode                                    *)
(* BOTH channels' authority evidence binding the same exact authority   *)
(* statement (the A1.3 adversary controls a strict subset of channels,  *)
(* never all — the redundancy is the defense the "never all"            *)
(* assumption buys). Shared terms crossing the links, per the frozen    *)
(* registration: same authority statement (NOT the whole manifest —     *)
(* the non-authoritative label is adversary-controlled and ignored),    *)
(* the bound authority fields and accepted-key fingerprint match,       *)
(* same accepted key through possession and signature, same signed      *)
(* framed bytes.                                                        *)
(*                                                                      *)
(* Authority statement = the map-v1 authority-relevant tuple:           *)
(* (issuer identity, key fingerprint, signer-set, algorithm id,         *)
(* statement version). Anchor identity excluded by citation (A3.1       *)
(* coverage map: anchor identity -> A2.4).                              *)
(*                                                                      *)
(* Run: proverif q1_chain_dns_compromised.pv                            *)
(* ==================================================================== *)

free c: channel.

type skey.
type pkey.
fun pk(skey): pkey.

fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.
fun fp(pkey): bitstring.

(* Domain-separation tags: authority evidence, possession, framed bytes *)
const STMT: bitstring.
const POSS: bitstring.
const BYTES: bitstring.

(* Honest-world authority-relevant fields (public: the adversary knows  *)
(* the honest statement and may replay or recombine it)                 *)
free issuerId: bitstring.
free ssetH: bitstring.
free algH: bitstring.
free verH: bitstring.
free fbH: bitstring.

(* Five event kinds, with two authority-publication branches *)
event AuthorityPublishedDNS(bitstring).
event AuthorityPublishedRepo(bitstring).
event IssuerPossession(pkey).
event IssuerSigned(pkey, bitstring).
event Accept(bitstring, bitstring, bitstring, pkey, bitstring).
  (* evidenceDNS, evidenceRepo, authority tuple, accepted key, bytes *)

(* Q1 linkage correspondence: acceptance implies the chain, with the   *)
(* authority tuple, key, and bytes as the shared terms.                 *)
query t: bitstring, k: pkey, fb: bitstring, evD: bitstring, evR: bitstring;
  event(Accept(evD, evR, t, k, fb)) ==>
    ( (event(AuthorityPublishedDNS(t)) || event(AuthorityPublishedRepo(t)))
   && event(IssuerPossession(k))
   && event(IssuerSigned(k, fb)) ).
  (* Recut 2026-08-09 after Q1 run 1 (evidence: *_run1.out): the        *)
  (* conjunctive both-channels conclusion overclaimed — a compromised   *)
  (* channel's publication event is forgeable-around by definition.     *)
  (* The design's actual claim under A1.3 "never all" is: at least one  *)
  (* UNCOMPROMISED channel published this exact tuple. The disjunction  *)
  (* is that claim, variant-independent; possession and signature       *)
  (* links stay conjunctive.                                            *)

let AuthorityDNS(skD: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  out(c, sign((STMT, t), skD)).

let AuthorityRepo(skR: skey, t: bitstring) =
  event AuthorityPublishedRepo(t);
  out(c, sign((STMT, t), skR)).

let Issuer(skI: skey, fb: bitstring) =
  event IssuerPossession(pk(skI));
  out(c, sign((POSS, fp(pk(skI))), skI));
  event IssuerSigned(pk(skI), fb);
  out(c, sign((BYTES, fb), skI)).

let Verifier(pkD: pkey, pkR: pkey) =
  in(c, (t: bitstring, label: bitstring, evD: bitstring, evR: bitstring,
         kX: pkey, ppf: bitstring, sg: bitstring, fb: bitstring));
  (* first link, strict: both channels' evidence binds this exact tuple *)
  let (=STMT, =t) = checksign(evD, pkD) in
  let (=STMT, =t) = checksign(evR, pkR) in
  (* statement -> issuer identity and signing key (fingerprint match)   *)
  let (id: bitstring, kfpr: bitstring, ss: bitstring, alg: bitstring,
       ver: bitstring) = t in
  if fp(kX) = kfpr then
  (* possession by that same key (chain-internal, domain-separated)     *)
  let (=POSS, =fp(kX)) = checksign(ppf, kX) in
  (* accepted signature under that key -> the exact framed bytes        *)
  let (=BYTES, =fb) = checksign(sg, kX) in
  event Accept(evD, evR, t, kX, fb);
  0.
  (* label is received and ignored: non-authoritative variation is      *)
  (* permitted by construction, per map v1                              *)

process
  new skD: skey; new skR: skey; new skI: skey;
  let tH = (issuerId, fp(pk(skI)), ssetH, algH, verH) in
  out(c, pk(skD)); out(c, pk(skR)); out(c, pk(skI));
  (* VARIANT: DNS channel compromised — its signing key is public *)
  out(c, skD);
  ( !AuthorityDNS(skD, tH)
  | !AuthorityRepo(skR, tH)
  | !Issuer(skI, fbH)
  | !Verifier(pk(skD), pk(skR)) )
