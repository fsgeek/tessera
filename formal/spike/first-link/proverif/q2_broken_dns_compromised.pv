(* ==================================================================== *)
(* Q2 — two-worlds BROKEN COMPANION (binding weakened). DELIBERATELY    *)
(* BROKEN: authority evidence commits to a proper subset of map v1 —    *)
(* the issuer identity ONLY, not the key fingerprint, signer set,       *)
(* algorithm id, or statement version.                                  *)
(* Variant: DNS channel COMPROMISED (skDNS leaked to the adversary).    *)
(*                                                                      *)
(* This model proves: the registered queries are sensitive to the      *)
(* deliberate first-link defect — evidence binding issuer identity     *)
(* alone permits both a broken correspondence and a two-worlds witness.*)
(* This model does not prove a security guarantee; it is a negative    *)
(* control and does not establish semantic truth, concrete encoding,   *)
(* implementation fidelity, or arbitrary-channel generalization.       *)
(*                                                                      *)
(* Registered prediction (PREDICTIONS.md, frozen): violation found,     *)
(* trace readable (p~0.75); mutation needs one recut (p~0.15); only one *)
(* channel variant exhibits it (p~0.05, itself a ledger finding);       *)
(* timeout (p~0.05). Timebox: 15 min. REQUIRED result: the linkage      *)
(* query FAILS — one evidence object supports two manifests differing   *)
(* only in a map-v1 authority-relevant field. Per the Grok panel        *)
(* criterion, failure to produce this companion is an amendment         *)
(* trigger.                                                             *)
(*                                                                      *)
(* Identical to q1_chain_dns_compromised.pv except: (1) the evidence    *)
(* binding (issuerId instead of the full tuple) in both the authority   *)
(* processes and the verifier's first-link check; (2) the TwoWorlds     *)
(* judge — accepted records flow over a private channel to a judge      *)
(* that raises TwoWorldsBroken when the same evidence pair supports     *)
(* two different authority tuples.                                      *)
(*                                                                      *)
(* Run: proverif q2_broken_dns_compromised.pv                           *)
(* ==================================================================== *)

free c: channel.
free accCh: channel [private].

type skey.
type pkey.
fun pk(skey): pkey.

fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.
fun fp(pkey): bitstring.

const STMT: bitstring.
const POSS: bitstring.
const BYTES: bitstring.

free issuerId: bitstring.
free ssetH: bitstring.
free algH: bitstring.
free verH: bitstring.
free fbH: bitstring.

event AuthorityPublishedDNS(bitstring).
event AuthorityPublishedRepo(bitstring).
event IssuerPossession(pkey).
event IssuerSigned(pkey, bitstring).
event Accept(bitstring, bitstring, bitstring, pkey, bitstring).
event TwoWorldsBroken(bitstring, bitstring, bitstring, bitstring).
  (* evidenceDNS, evidenceRepo, tuple1, tuple2 *)

(* The linkage correspondence — REQUIRED TO FAIL in this companion *)
query t: bitstring, k: pkey, fb: bitstring, evD: bitstring, evR: bitstring;
  event(Accept(evD, evR, t, k, fb)) ==>
    ( (event(AuthorityPublishedDNS(t)) || event(AuthorityPublishedRepo(t)))
   && event(IssuerPossession(k))
   && event(IssuerSigned(k, fb)) ).
  (* Recut 2026-08-09 after Q1 run 1 (evidence: *_run1.out): the        *)
  (* conjunctive both-channels conclusion overclaimed — a compromised   *)
  (* channel's publication event is forgeable-around by definition.     *)
  (* The design's actual claim under A1.3 "never all" is: at least one  *)
  (* UNCOMPROMISED channel published this exact tuple. The disjunction  *)
  (* is that claim, variant-independent; possession and signature       *)
  (* links stay conjunctive.                                            *)

(* The boundary invariant made mechanical — REQUIRED TO BE REACHABLE   *)
(* in this companion: same evidence pair, two authority-distinct       *)
(* tuples.                                                             *)
query evD: bitstring, evR: bitstring, t1: bitstring, t2: bitstring;
  event(TwoWorldsBroken(evD, evR, t1, t2)).

let AuthorityDNS(skD: skey, t: bitstring) =
  event AuthorityPublishedDNS(t);
  (* BROKEN BINDING: evidence commits to the issuer identity only *)
  let (id: bitstring, kfpr: bitstring, ss: bitstring, alg: bitstring,
       ver: bitstring) = t in
  out(c, sign((STMT, id), skD)).

let AuthorityRepo(skR: skey, t: bitstring) =
  event AuthorityPublishedRepo(t);
  let (id: bitstring, kfpr: bitstring, ss: bitstring, alg: bitstring,
       ver: bitstring) = t in
  out(c, sign((STMT, id), skR)).

let Issuer(skI: skey, fb: bitstring) =
  event IssuerPossession(pk(skI));
  out(c, sign((POSS, fp(pk(skI))), skI));
  event IssuerSigned(pk(skI), fb);
  out(c, sign((BYTES, fb), skI)).

let Verifier(pkD: pkey, pkR: pkey) =
  in(c, (t: bitstring, label: bitstring, evD: bitstring, evR: bitstring,
         kX: pkey, ppf: bitstring, sg: bitstring, fb: bitstring));
  let (id: bitstring, kfpr: bitstring, ss: bitstring, alg: bitstring,
       ver: bitstring) = t in
  (* BROKEN first link: evidence checked against issuer identity only  *)
  let (=STMT, =id) = checksign(evD, pkD) in
  let (=STMT, =id) = checksign(evR, pkR) in
  if fp(kX) = kfpr then
  let (=POSS, =fp(kX)) = checksign(ppf, kX) in
  let (=BYTES, =fb) = checksign(sg, kX) in
  event Accept(evD, evR, t, kX, fb);
  out(accCh, (evD, evR, t)).

let Judge =
  in(accCh, (e1: bitstring, e2: bitstring, t1: bitstring));
  in(accCh, (=e1, =e2, t2: bitstring));
  if t1 = t2 then 0
  else event TwoWorldsBroken(e1, e2, t1, t2).

process
  new skD: skey; new skR: skey; new skI: skey;
  let tH = (issuerId, fp(pk(skI)), ssetH, algH, verH) in
  out(c, pk(skD)); out(c, pk(skR)); out(c, pk(skI));
  (* VARIANT: DNS channel compromised — its signing key is public *)
  out(c, skD);
  ( !AuthorityDNS(skD, tH)
  | !AuthorityRepo(skR, tH)
  | !Issuer(skI, fbH)
  | !Verifier(pk(skD), pk(skR))
  | !Judge )
